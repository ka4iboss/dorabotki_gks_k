#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроцессСсылка = Объект.БизнесПроцесс;
	
	Если ЗначениеЗаполнено(ПроцессСсылка) Тогда
		ЗаполнитьУчастниковИзПроцесса();
	КонецЕсли;
	
	Элементы.НазначитьУчастников.Видимость = НЕ Объект.Выполнена;
	Элементы.НачальникиСогласования.ТолькоПросмотр = Объект.Выполнена;
	Элементы.ПодчинённыеСогласования.ТолькоПросмотр = Объект.Выполнена;

	// Ссылка на бизнес-процесс: поле-надпись показывается гиперссылкой,
	// по нажатию открывается карточка процесса согласования.
	Элементы.ПроцессСсылка.Гиперссылка = Истина;

КонецПроцедуры

// Записывает участников в бизнес-процесс перед выполнением задачи.
// Обработчик нужен потому, что задачу можно выполнить не только кнопкой
// «Назначить участников», но и стандартной командой формы задачи: без записи
// участников процесс на следующей точке создаст нуль задач и остановится.
//
// Параметры:
//  Отказ - Булево - Истина отменяет выполнение задачи.
//
&НаКлиенте
Процедура ПередВыполнением(Отказ)
	
	Если НЕ ПроверитьУчастников() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписатьУчастниковВПроцесс() Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Открывает карточку бизнес-процесса, в рамках которого создана задача.
//
// Параметры:
//  Элемент              - ПолеФормы - поле-ссылка на бизнес-процесс.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&НаКлиенте
Процедура ПроцессСсылкаНажатие(Элемент, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(ПроцессСсылка) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ПараметрыОткрытия = Новый Структура("Ключ", ПроцессСсылка);
	ОткрытьФорму("БизнесПроцесс.ГКСИ_СогласованиеИнструкции.Форма.ФормаБизнесПроцесса", ПараметрыОткрытия);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНачальникиСогласования

// Добавляет в таблицу начальников отделов пользователей, выбранных в форме подбора.
//
// Параметры:
//  ВыбранноеЗначение    - СправочникСсылка.Пользователи, Массив из СправочникСсылка.Пользователи -
//                         выбранные пользователи.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&НаКлиенте
Процедура НачальникиСогласованияОбработкаВыбора(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДобавитьВыбранныхПользователей(НачальникиСогласования, ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодчинённыеСогласования

// Добавляет в таблицу подчинённых пользователей, выбранных в форме подбора.
//
// Параметры:
//  ВыбранноеЗначение    - СправочникСсылка.Пользователи, Массив из СправочникСсылка.Пользователи -
//                         выбранные пользователи.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&НаКлиенте
Процедура ПодчинённыеСогласованияОбработкаВыбора(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДобавитьВыбранныхПользователей(ПодчинённыеСогласования, ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НазначитьУчастников(Команда)
	
	Если НЕ ПроверитьУчастников() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписатьУчастниковВПроцесс() Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗадачуНаСервере();
	Закрыть();
	
КонецПроцедуры

// Открывает подбор начальников отделов: типовой подбор справочника пользователей
// в таблицу «Начальники отделов».
//
// Параметры:
//  Команда - КомандаФормы - команда формы «Подобрать».
//
&НаКлиенте
Процедура ПодобратьНачальников(Команда)
	
	ОткрытьПодборПользователей(Элементы.НачальникиСогласования);
	
КонецПроцедуры

// Открывает подбор подчинённых: типовой подбор справочника пользователей
// в таблицу «Подчинённые».
//
// Параметры:
//  Команда - КомандаФормы - команда формы «Подобрать».
//
&НаКлиенте
Процедура ПодобратьПодчинённых(Команда)
	
	ОткрытьПодборПользователей(Элементы.ПодчинённыеСогласования);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьУчастниковИзПроцесса()
	
	НачальникиСогласования.Очистить();
	ПодчинённыеСогласования.Очистить();
	
	ПроцессОбъект = ПроцессСсылка.ПолучитьОбъект();
	Если ПроцессОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПроцесса Из ПроцессОбъект.Начальники Цикл
		НоваяСтрока = НачальникиСогласования.Добавить();
		НоваяСтрока.Сотрудник = СтрокаПроцесса.Сотрудник;
	КонецЦикла;
	
	Для Каждого СтрокаПроцесса Из ПроцессОбъект.Подчинённые Цикл
		НоваяСтрока = ПодчинённыеСогласования.Добавить();
		НоваяСтрока.Сотрудник = СтрокаПроцесса.Сотрудник;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьУчастников()
	
	Если НачальникиСогласования.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите хотя бы одного начальника отдела'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗаписатьУчастниковВПроцесс()
	
	Если НЕ ЗначениеЗаполнено(ПроцессСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьДанныеДляРедактирования(ПроцессСсылка);
		
		ПроцессОбъект = ПроцессСсылка.ПолучитьОбъект();
		ПроцессОбъект.Начальники.Очистить();
		ПроцессОбъект.Подчинённые.Очистить();
		
		Для Каждого СтрокаТаблицы Из НачальникиСогласования Цикл
			НоваяСтрока = ПроцессОбъект.Начальники.Добавить();
			НоваяСтрока.Сотрудник = СтрокаТаблицы.Сотрудник;
		КонецЦикла;
		
		Для Каждого СтрокаТаблицы Из ПодчинённыеСогласования Цикл
			НоваяСтрока = ПроцессОбъект.Подчинённые.Добавить();
			НоваяСтрока.Сотрудник = СтрокаТаблицы.Сотрудник;
		КонецЦикла;
		
		УдалитьДублиУчастников(ПроцессОбъект.Начальники);
		УдалитьДублиУчастников(ПроцессОбъект.Подчинённые);
		
		ПроцессОбъект.Записать();
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Открывает типовой подбор справочника пользователей в указанную таблицу формы.
// Форма выбора открывается в режиме подбора: не закрывается после выбора,
// позволяет отметить несколько пользователей и добавляет их в таблицу.
//
// Параметры:
//  ТаблицаУчастников - ТаблицаФормы - таблица участников согласования.
//
&НаКлиенте
Процедура ОткрытьПодборПользователей(ТаблицаУчастников)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, ТаблицаУчастников);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗадачуНаСервере()
	
	БизнесПроцессыИЗадачиСервер.ВыполнитьЗадачу(Объект.Ссылка);
	
КонецПроцедуры

// Удаляет из табличной части процесса пустые строки и повторно добавленных сотрудников.
// Подбор пользователей позволяет добавить одного и того же сотрудника несколько раз,
// поэтому перед записью процесса список участников нормализуется.
// В параметр Участники передаётся табличная часть участников согласования
// (Начальники или Подчинённые бизнес-процесса).
//
&НаСервере
Процедура УдалитьДублиУчастников(Участники)
	
	УжеДобавленные = Новый Соответствие;
	
	Для Индекс = Участники.Количество() - 1 По 0 Цикл
		
		СтрокаУчастника = Участники[Индекс];
		
		Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Сотрудник) Тогда
			Участники.Удалить(Индекс);
			Продолжить;
		КонецЕсли;
		
		Если УжеДобавленные.Получить(СтрокаУчастника.Сотрудник) = Неопределено Тогда
			УжеДобавленные.Вставить(СтрокаУчастника.Сотрудник, Истина);
		Иначе
			Участники.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в таблицу участников выбранных в форме подбора пользователей.
// Повторно выбранные сотрудники и пустые значения пропускаются.
// Первый параметр — таблица участников согласования на форме (НачальникиСогласования
// или ПодчинённыеСогласования), второй — выбранное значение или массив выбранных.
//
&НаКлиенте
Процедура ДобавитьВыбранныхПользователей(ТаблицаУчастников, ВыбранноеЗначение)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		ВыбранныеЭлементы = ВыбранноеЗначение;
	Иначе
		ВыбранныеЭлементы = Новый Массив;
		ВыбранныеЭлементы.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	Для Каждого ВыбранныйЭлемент Из ВыбранныеЭлементы Цикл
		
		Пользователь = ПользовательИзВыбранногоЗначения(ВыбранныйЭлемент);
		Если Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПользовательУжеВТаблице(ТаблицаУчастников, Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаУчастников.Добавить();
		НоваяСтрока.Сотрудник = Пользователь;
		
	КонецЦикла;
	
КонецПроцедуры

// Приводит выбранное значение к ссылке на пользователя.
// Форма списка при выборе возвращает строку динамического списка, а не ссылку,
// поэтому из такой строки берётся поле «Ссылка».
//
&НаКлиенте
Функция ПользовательИзВыбранногоЗначения(ВыбранноеЗначение)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ВыбранноеЗначение);
	Пользователь = Неопределено;
	
	Если ТипЗначения = Тип("ДанныеФормыЭлементКоллекции")
		ИЛИ ТипЗначения = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("Ссылка", Пользователь);
	Иначе
		Пользователь = ВыбранноеЗначение;
	КонецЕсли;
	
	Если ТипЗнч(Пользователь) <> Тип("СправочникСсылка.Пользователи") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Пользователь;
	
КонецФункции

// Проверяет, добавлен ли пользователь в таблицу участников.
// Первый параметр — таблица участников согласования на форме, второй — проверяемый пользователь.
// Возвращает Истина, если пользователь уже есть в таблице.
//
&НаКлиенте
Функция ПользовательУжеВТаблице(ТаблицаУчастников, Пользователь)
	
	Для Каждого СтрокаТаблицы Из ТаблицаУчастников Цикл
		Если СтрокаТаблицы.Сотрудник = Пользователь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
