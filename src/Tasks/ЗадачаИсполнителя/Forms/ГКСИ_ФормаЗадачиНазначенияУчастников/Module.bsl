#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроцессСсылка = Объект.БизнесПроцесс;
	
	Если ЗначениеЗаполнено(ПроцессСсылка) Тогда
		ЗаполнитьУчастниковИзПроцесса();
	КонецЕсли;
	
	Элементы.НазначитьУчастников.Видимость = НЕ Объект.Выполнена;
	Элементы.НачальникиСогласования.ТолькоПросмотр = Объект.Выполнена;
	Элементы.ПодчинённыеСогласования.ТолькоПросмотр = Объект.Выполнена;
	
КонецПроцедуры

// Записывает участников в бизнес-процесс перед выполнением задачи.
// Обработчик нужен потому, что задачу можно выполнить не только кнопкой
// «Назначить участников», но и стандартной командой формы задачи: без записи
// участников процесс на следующей точке создаст нуль задач и остановится.
//
// Параметры:
//  Отказ - Булево - Истина отменяет выполнение задачи.
//
&НаКлиенте
Процедура ПередВыполнением(Отказ)
	
	Если НЕ ПроверитьУчастников() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписатьУчастниковВПроцесс() Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НазначитьУчастников(Команда)
	
	Если НЕ ПроверитьУчастников() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаписатьУчастниковВПроцесс() Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗадачуНаСервере();
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьУчастниковИзПроцесса()
	
	НачальникиСогласования.Очистить();
	ПодчинённыеСогласования.Очистить();
	
	ПроцессОбъект = ПроцессСсылка.ПолучитьОбъект();
	Если ПроцессОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПроцесса Из ПроцессОбъект.Начальники Цикл
		НоваяСтрока = НачальникиСогласования.Добавить();
		НоваяСтрока.Сотрудник = СтрокаПроцесса.Сотрудник;
	КонецЦикла;
	
	Для Каждого СтрокаПроцесса Из ПроцессОбъект.Подчинённые Цикл
		НоваяСтрока = ПодчинённыеСогласования.Добавить();
		НоваяСтрока.Сотрудник = СтрокаПроцесса.Сотрудник;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьУчастников()
	
	Если НачальникиСогласования.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите хотя бы одного начальника отдела'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗаписатьУчастниковВПроцесс()
	
	Если НЕ ЗначениеЗаполнено(ПроцессСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьДанныеДляРедактирования(ПроцессСсылка);
		
		ПроцессОбъект = ПроцессСсылка.ПолучитьОбъект();
		ПроцессОбъект.Начальники.Очистить();
		ПроцессОбъект.Подчинённые.Очистить();
		
		Для Каждого СтрокаТаблицы Из НачальникиСогласования Цикл
			НоваяСтрока = ПроцессОбъект.Начальники.Добавить();
			НоваяСтрока.Сотрудник = СтрокаТаблицы.Сотрудник;
		КонецЦикла;
		
		Для Каждого СтрокаТаблицы Из ПодчинённыеСогласования Цикл
			НоваяСтрока = ПроцессОбъект.Подчинённые.Добавить();
			НоваяСтрока.Сотрудник = СтрокаТаблицы.Сотрудник;
		КонецЦикла;
		
		ПроцессОбъект.Записать();
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
	// Участники зафиксированы — сообщаем им о запуске согласования по почте.
	ГКСИ_ПочтовыеУведомленияСервер.ЗапуститьОтправкуПриглашений(ПроцессСсылка);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ВыполнитьЗадачуНаСервере()
	
	БизнесПроцессыИЗадачиСервер.ВыполнитьЗадачу(Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти
