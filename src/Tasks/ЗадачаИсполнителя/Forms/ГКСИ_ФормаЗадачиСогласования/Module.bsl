#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроцессСсылка = Объект.БизнесПроцесс;
	ПредметИнструкции = Объект.Предмет;
	
	ЗаполнитьТекстСогласуемогоОбъекта();
	ЗаполнитьСравнениеВерсий();
	
	Если Объект.Выполнена Тогда
		Элементы.Согласовать.Видимость = Ложь;
		Элементы.Отклонить.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Согласовать(Команда)
	
	ЗафиксироватьРезультат(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	
	Если ПустаяСтрока(КомментарийСогласования) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите причину отклонения в комментарии'"));
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьРезультат(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗафиксироватьРезультат(Согласовано)
	
	ЗафиксироватьРезультатНаСервере(Согласовано, КомментарийСогласования);
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьРезультатНаСервере(Согласовано, Комментарий)
	
	РезультатСогласования = ?(Согласовано,
		Перечисления.ГКСИ_РезультатыСогласованияИнструкций.Согласовано,
		Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано);
	
	Если НЕ ЗначениеЗаполнено(ПроцессСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьДанныеДляРедактирования(ПроцессСсылка);
		
		ПроцессОбъект = ПроцессСсылка.ПолучитьОбъект();
		
		Исполнитель = Объект.Исполнитель;
		Если НЕ ЗначениеЗаполнено(Исполнитель) Тогда
			Исполнитель = Пользователи.ТекущийПользователь();
		КонецЕсли;
		
		ТаблицаУчастников = ТаблицаУчастниковПоТочке(ПроцессОбъект);
		СтрокаУчастника = НайтиСтрокуУчастника(ТаблицаУчастников, Исполнитель);
		
		Если СтрокаУчастника <> Неопределено Тогда
			СтрокаУчастника.РезультатСогласования = РезультатСогласования;
			СтрокаУчастника.Комментарий = Комментарий;
			СтрокаУчастника.ДатаСогласования = ТекущаяДатаСеанса();
			СтрокаУчастника.НомерВерсии = ГКСИ_СогласованиеИнструкцийСервер.НомерВерсииСогласуемогоУзла(ПроцессОбъект.Предмет);
		КонецЕсли;
		
		ПроцессОбъект.Записать();
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
	БизнесПроцессыИЗадачиСервер.ВыполнитьЗадачу(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаУчастниковПоТочке(ПроцессОбъект)
	
	Если Объект.ТочкаМаршрута = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ТочкиМаршрута.СогласованиеНачальниками Тогда
		Возврат ПроцессОбъект.Начальники;
	КонецЕсли;
	
	Возврат ПроцессОбъект.Подчинённые;
	
КонецФункции

&НаСервере
Функция НайтиСтрокуУчастника(ТаблицаУчастников, Сотрудник)
	
	Для Каждого СтрокаУчастника Из ТаблицаУчастников Цикл
		Если СтрокаУчастника.Сотрудник = Сотрудник Тогда
			Возврат СтрокаУчастника;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТекстСогласуемогоОбъекта()
	
	ТекстСогласуемогоОбъекта = "";
	
	Если НЕ ЗначениеЗаполнено(ПредметИнструкции) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидСогласованияПроцесса() = Перечисления.ГКСИ_ВидыСогласованияИнструкций.ВсяИнструкция Тогда
		ТекстСогласуемогоОбъекта = HTMLИнструкцииПроцесса();
	Иначе
		ТекстСогласуемогоОбъекта = ГКСИ_СогласованиеИнструкцийСервер.HTMLУзла(ПредметИнструкции);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция HTMLИнструкцииПроцесса()
	
	Если ЗначениеЗаполнено(ПроцессСсылка) Тогда
		
		HTML = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроцессСсылка, "ГКСИ_HTMLИнструкции");
		Если НЕ ПустаяСтрока(HTML) Тогда
			Возврат HTML;
		КонецЕсли;
		
		КорневаяИнструкция = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроцессСсылка, "КорневаяИнструкция");
		Если ЗначениеЗаполнено(КорневаяИнструкция) Тогда
			Возврат ГКСИ_СогласованиеИнструкцийСервер.HTMLИнструкции(КорневаяИнструкция);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ГКСИ_СогласованиеИнструкцийСервер.HTMLИнструкции(
		ГКСИ_СогласованиеИнструкцийСервер.ОпределитьКорневуюИнструкцию(ПредметИнструкции));
	
КонецФункции

&НаСервере
Функция ВидСогласованияПроцесса()
	
	Если НЕ ЗначениеЗаполнено(ПроцессСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроцессСсылка, "ВидСогласования");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСравнениеВерсий()
	
	ТекстПодписаннойВерсии = "";
	ТекстИзменений = "";
	
	Если НЕ ЗначениеЗаполнено(ПредметИнструкции) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидСогласованияПроцесса() = Перечисления.ГКСИ_ВидыСогласованияИнструкций.ВсяИнструкция Тогда
		Элементы.ТекстПодписаннойВерсии.Видимость = Ложь;
		Элементы.ТекстИзменений.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	НомерВерсии = ГКСИ_СогласованиеИнструкцийСервер.НомерПоследнейПодписаннойВерсии(ПредметИнструкции);
	
	Если НомерВерсии <= 0 Тогда
		Элементы.ТекстПодписаннойВерсии.Видимость = Ложь;
		ТекстИзменений = ДиагностикаСравнения(НомерВерсии, "", "")
			+ "<p style=""color:#666666;"">Ранее не согласовывался — сравнивать не с чем.</p>";
		Возврат;
	КонецЕсли;
	
	КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	
	ПрежнийТекст = ГКСИ_СогласованиеИнструкцийСервер.ТекстMarkdownПоКодуЯзыка(
		ГКСИ_СогласованиеИнструкцийСервер.ТекстMarkdownВерсии(ПредметИнструкции, НомерВерсии),
		КодЯзыка);
	НовыйТекст = ГКСИ_СогласованиеИнструкцийСервер.ТекстMarkdownПоКодуЯзыка(
		ГКСИ_СогласованиеИнструкцийСервер.ТекстMarkdownТекущий(ПредметИнструкции),
		КодЯзыка);
	
	ТекстПодписаннойВерсии = "<h3 style=""margin:4pt 0;"">Ранее подписанная версия "
		+ Формат(НомерВерсии, "ЧГ=0") + "</h3>"
		+ "<div style=""font-family:Consolas,monospace;font-size:9pt;white-space:pre-wrap;"">"
		+ ГКСИ_СогласованиеИнструкцийСервер.ЭкранироватьHTMLТекст(ПрежнийТекст)
		+ "</div>";
	
	Различия = ГКСИ_СогласованиеИнструкцийСервер.HTMLРазличийТекстов(ПрежнийТекст, НовыйТекст);
	
	Если ПустаяСтрока(Различия) Тогда
		ТекстИзменений = "<h3 style=""margin:4pt 0;"">Изменения текста</h3>"
			+ "<p style=""color:#666666;"">Изменений в тексте нет.</p>";
	Иначе
		ТекстИзменений = "<h3 style=""margin:4pt 0;"">Изменения текста</h3>" + Различия;
	КонецЕсли;
	
	ТекстИзменений = ТекстИзменений + ДиагностикаСравнения(НомерВерсии, ПрежнийТекст, НовыйТекст);
	
КонецПроцедуры

// ВРЕМЕННО (диагностика): выводит параметры сравнения версий мелким серым текстом.
&НаСервере
Функция ДиагностикаСравнения(НомерВерсии, ПрежнийТекст, НовыйТекст)
	
	Возврат "<p style=""color:#bbbbbb;font-size:8pt;"">вид=" + Строка(ВидСогласованияПроцесса())
		+ "; версия=" + Формат(НомерВерсии, "ЧГ=0")
		+ "; преж=" + Формат(СтрДлина(ПрежнийТекст), "ЧГ=0")
		+ "; нов=" + Формат(СтрДлина(НовыйТекст), "ЧГ=0") + "</p>";
	
КонецФункции

#КонецОбласти
