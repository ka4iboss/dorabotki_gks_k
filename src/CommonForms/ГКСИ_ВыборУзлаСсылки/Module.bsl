// Форма выбора группы или шага демонстрационного сценария.
//
// Используется из редактора Markdown для вставки вики-ссылки [[...]] на другой
// узел инструкции. В списке доступны и шаги, и группы. Форма возвращает готовый
// фрагмент ссылки:
//   * [[Наименование]]      - если наименование уникально в инструкции;
//   * [[Код|Наименование]]  - если наименование неоднозначно и нужен код.
//
// Параметры формы (см. ГКСИ_MarkdownКлиент.ОбработкаКомандыПоляКомментария):
//   СсылкаУзла - CatalogRef.ДемонстрационныеСценарии, Неопределено - узел, из описания
//                которого вставляется ссылка. Определяет инструкцию (корень),
//                в пределах которой предлагаются узлы. Если не заполнена (например,
//                элемент ещё не записан), предлагаются узлы всех инструкций,
//                а в списке показывается колонка «Инструкция».

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ТипЗнч(Параметры) = Тип("Структура") ИЛИ ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		ПараметрыОткрытия = Новый Структура("СсылкаУзла", Неопределено);
		ЗаполнитьЗначенияСвойств(ПараметрыОткрытия, Параметры);
		СсылкаУзла = ПараметрыОткрытия.СсылкаУзла;
	КонецЕсли;

	ЗаполнитьУзлыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)

	ЗаполнитьУзлыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУзлыТаблица

&НаКлиенте
Процедура УзлыТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ВыбраннаяСтрока <> Неопределено Тогда
		Закрыть(ФрагментСсылкиДляСтроки(ВыбраннаяСтрока));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)

	ТекущиеДанные = Элементы.УзлыТаблица.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПредупреждениеПользователю(НСтр("ru = 'Выберите группу или шаг из списка.'"));
		Возврат;
	КонецЕсли;

	Закрыть(ФрагментСсылкиДляСтроки(ТекущиеДанные));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает фрагмент вики-ссылки для выбранной строки списка узлов.
//
// Параметры:
//   СтрокаУзла - СтрокаТаблицыЗначений - строка реквизита формы Узлы.
//
// Возвращаемое значение:
//   Строка - фрагмент ссылки [[...]].
//
&НаКлиенте
Функция ФрагментСсылкиДляСтроки(СтрокаУзла)

	Если ПустаяСтрока(СтрокаУзла.Цель) Тогда
		Возврат "[[" + СтрокаУзла.Наименование + "]]";
	КонецЕсли;

	Возврат "[[" + СтрокаУзла.Цель + "|" + СтрокаУзла.Наименование + "]]";

КонецФункции

&НаКлиенте
Процедура ПредупреждениеПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУзлыНаСервере()

	Узлы.Очистить();

	КореньИнструкции = ГКСИ_СсылкиСценариев.КореньИнструкцииУзла(СсылкаУзла);
	ВсеУзлы = ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора(КореньИнструкции);
	КартаСсылок = ГКСИ_СсылкиСценариев.КартаСсылокСценариев(КореньИнструкции);

	// Без известной инструкции в списке смешаны узлы всех инструкций — тогда
	// колонка «Инструкция» нужна, чтобы автор выбрал узел своей инструкции.
	Элементы.УзлыТаблицаИнструкция.Видимость = Не ЗначениеЗаполнено(КореньИнструкции);

	СтрокаПоиска = НРег(СокрЛП(Фильтр));

	Для Каждого СтрокаУзла Из ВсеУзлы Цикл

		Если Не ПустаяСтрока(СтрокаПоиска)
			И СтрНайти(НРег(СтрокаУзла.Наименование), СтрокаПоиска) = 0
			И СтрНайти(НРег(СтрокаУзла.Код), СтрокаПоиска) = 0
			И СтрНайти(НРег(СтрокаУзла.Инструкция), СтрокаПоиска) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Узлы.Добавить();
		НоваяСтрока.Наименование = СтрокаУзла.Наименование;
		НоваяСтрока.Код          = СтрокаУзла.Код;
		НоваяСтрока.ЭтоГруппа    = СтрокаУзла.ЭтоГруппа;
		НоваяСтрока.Инструкция   = СтрокаУзла.Инструкция;

		// Наименование можно использовать как цель ссылки только если оно
		// уникально в инструкции, иначе требуется код в контексте.
		Если КартаСсылок.ПоИменам.Получить(ВРег(СтрокаУзла.Наименование)) = Неопределено Тогда
			НоваяСтрока.Цель = СтрокаУзла.Код;
		Иначе
			НоваяСтрока.Цель = "";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
