#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ГКСК_ТолькоДополнительныеРеквизитыПриИзменении(Элемент)
	
	ГКСК_ПереключитьДеревоОперандов();
	ГКСК_СохранитьНастройкуТолькоДопРеквизиты(ГКСК_ТолькоДополнительныеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_НачалоФормулыПриИзменении(Элемент)
	
	ГКСК_ПересобратьФормулу();
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_ФормулаПриИзменении(Элемент)
	
	Если Не ГКСК_КонструкторВидим() Тогда
		Возврат;
	КонецЕсли;
	
	// Формулу правили вручную: раскладываем её обратно в таблицу.
	// Если формула не в табличном виде, таблица и начало формулы очищаются,
	// а формула остаётся текстом в типовом поле.
	ГКСК_ЗаполнитьКонструкторИзФормулыКлиент();
	ГКСК_КонструкторИзменён = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГКСК_ТаблицаФормулы

&НаКлиенте
Процедура ГКСК_КолонкаУсловиеПриИзменении(Элемент)
	
	ГКСК_ПересобратьФормулу();
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_КолонкаЕслиЗаполненоПриИзменении(Элемент)
	
	ГКСК_ПересобратьФормулу();
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_КолонкаЕслиПустоПриИзменении(Элемент)
	
	ГКСК_ПересобратьФормулу();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГКСК_ВставитьУсловныйРазделитель(Команда)
	
	Конструкция = ГКСК_КонструкцияРазделительПробел();
	ВставитьТекстВФормулу(Конструкция);
	ГКСК_ВыделитьПлейсхолдерРеквизит(Конструкция);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// ГКС: доработка типового конструктора формул (расширение Доработки_ГКС_К).
//
// 1. Группа палитры "Условные разделители" с конструкциями вида
//    + ?(ЗначениеЗаполнено(<Реквизит>), " " + <Значение>, "")
//    для строковых формул (шаблоны наименований номенклатуры, характеристик, серий).
// 2. Флажок "Только дополнительные реквизиты" - фильтр дерева доступных полей
//    до дополнительных реквизитов и сведений.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ГКСК_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ГКСК_НастроитьТабличныйКонструктор();
	
	Если ПустаяСтрока(АдресДереваОперандов) Тогда
		Возврат;
	КонецЕсли;
	
	Дерево = ПолучитьИзВременногоХранилища(АдресДереваОперандов);
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ГКСК_НастроитьУсловныеРазделители();
	ГКСК_НастроитьФильтрДополнительныхРеквизитов(Дерево);
	
КонецПроцедуры

&НаКлиенте
&Вместо("ВставитьОператорВФормулу")
Процедура ГКСК_ВставитьОператорВФормулу()
	
	ТекущиеДанныеОператора = Элементы.Операторы.ТекущиеДанные;
	
	Если ТекущиеДанныеОператора <> Неопределено
		И НЕ ТекущиеДанныеОператора.ЭтоГруппа
		И Лев(ТекущиеДанныеОператора.Идентификатор, 5) = "ГКСК_" Тогда
		
		Конструкция = ТекущиеДанныеОператора.КонструкцияДляВставки;
		ВставитьТекстВФормулу(Конструкция);
		ГКСК_ВыделитьПлейсхолдерРеквизит(Конструкция);
		ВставитьОператорВФормулуФрагмент();
		Возврат;
		
	КонецЕсли;
	
	ПродолжитьВызов();
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_ВыделитьПлейсхолдерРеквизит(Знач Конструкция)
	
	Плейсхолдер = ГКСК_ТекстПлейсхолдераРеквизит();
	Позиция = СтрНайти(Конструкция, Плейсхолдер);
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаНач = 0;
	КолонкаНач = 0;
	СтрокаКон = 0;
	КолонкаКон = 0;
	Элементы.Формула.ПолучитьГраницыВыделения(СтрокаНач, КолонкаНач, СтрокаКон, КолонкаКон);
	
	НачалоВставки = КолонкаКон - СтрДлина(Конструкция);
	
	Элементы.Формула.УстановитьГраницыВыделения(
		СтрокаКон,
		НачалоВставки + Позиция - 1,
		СтрокаКон,
		НачалоВставки + Позиция - 1 + СтрДлина(Плейсхолдер));
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_НастроитьФильтрДополнительныхРеквизитов(Дерево)
	
	ЕстьДопРеквизиты = ГКСК_СтрокиСодержатДопРеквизиты(Дерево.Строки);
	Элементы.ГКСК_ТолькоДополнительныеРеквизиты.Видимость = ЕстьДопРеквизиты;
	
	Если НЕ ЕстьДопРеквизиты Тогда
		ГКСК_ТолькоДополнительныеРеквизиты = Ложь;
		Возврат;
	КонецЕсли;
	
	ГКСК_ТолькоДополнительныеРеквизиты = (ГКСК_НастройкаТолькоДопРеквизиты() = Истина);
	Если ГКСК_ТолькоДополнительныеРеквизиты Тогда
		ГКСК_ПереключитьДеревоОперандов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_ПереключитьДеревоОперандов()
	
	Дерево = ПолучитьИзВременногоХранилища(АдресДереваОперандов);
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ГКСК_ТолькоДополнительныеРеквизиты Тогда
		Дерево = ГКСК_ДеревоТолькоДопРеквизиты(Дерево);
	КонецЕсли;
	
	// Разрешенные операнды не пересчитываются: проверка формулы выполняется по полному списку операндов.
	РаботаСФормулами.ЗагрузитьДеревоОперандовВДеревоФормы(ДеревоОперандов, Дерево);
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_НастроитьУсловныеРазделители()
	
	// Кнопка вставляла конструкцию в скрытое поле формулы, поэтому заменена табличным конструктором.
	Элементы.ГКСК_ВставитьУсловныйРазделитель.Видимость = Ложь;
	
	Если НЕ ГКСК_ЭтоСтроковаяФормула() Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоОператоров = РеквизитФормыВЗначение("Операторы");
	
	Группа = РаботаСФормулами.ДобавитьГруппуОператоров(
		ДеревоОператоров,
		"ГКСК_УсловныеРазделители",
		НСтр("ru = 'Условные разделители'"));
	
	КонструкцияПробел = ГКСК_КонструкцияРазделительПробел();
	РаботаСФормулами.ДобавитьОператор(
		Группа,
		"ГКСК_РазделительПробел",
		КонструкцияПробел,
		НСтр("ru = 'Условный разделитель (пробел)'"),
		ГКСК_ПояснениеРазделителя(),
		ГКСК_СдвигКурсораНаПлейсхолдер(КонструкцияПробел));
	
	КонструкцияВложенный = ГКСК_КонструкцияРазделительВложенный();
	РаботаСФормулами.ДобавитьОператор(
		Группа,
		"ГКСК_РазделительВложенный",
		КонструкцияВложенный,
		НСтр("ru = 'Условный разделитель (вложенный)'"),
		ГКСК_ПояснениеРазделителя(),
		ГКСК_СдвигКурсораНаПлейсхолдер(КонструкцияВложенный));
	
	ЗначениеВРеквизитФормы(ДеревоОператоров, "Операторы");
	
КонецПроцедуры

// Формирует дерево операндов только из дополнительных реквизитов и сведений.
//
// Параметры:
//  ДеревоИсточник - ДеревоЗначений - полное дерево операндов,
//                   см. РаботаСФормулами.ПолучитьПустоеДеревоОперандов.
//
// Возвращаемое значение:
//  ДеревоЗначений - дерево, содержащее дополнительные реквизиты и сведения вместе с их свойствами.
//
&НаСервере
Функция ГКСК_ДеревоТолькоДопРеквизиты(ДеревоИсточник)
	
	ДеревоРезультат = РаботаСФормулами.ПолучитьПустоеДеревоОперандов();
	ГКСК_ПеренестиДопРеквизиты(ДеревоИсточник.Строки, ДеревоРезультат.Строки);
	
	Возврат ДеревоРезультат;
	
КонецФункции

&НаСервере
Процедура ГКСК_ПеренестиДопРеквизиты(СтрокиИсточника, СтрокиПриемника)
	
	Для Каждого СтрокаДерева Из СтрокиИсточника Цикл
		
		Если ГКСК_ЭтоДопРеквизитИлиСведение(СтрокаДерева.ТипЭлементаДерева) Тогда
			
			СтрокаПриемника = СтрокиПриемника.Добавить();
			ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаДерева);
			ГКСК_ПеренестиВсеПодчиненныеСтроки(СтрокаДерева.Строки, СтрокаПриемника.Строки);
			
		ИначеЕсли ГКСК_СтрокиСодержатДопРеквизиты(СтрокаДерева.Строки) Тогда
			
			СтрокаПриемника = СтрокиПриемника.Добавить();
			ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаДерева);
			ГКСК_ПеренестиДопРеквизиты(СтрокаДерева.Строки, СтрокаПриемника.Строки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_ПеренестиВсеПодчиненныеСтроки(СтрокиИсточника, СтрокиПриемника)
	
	Для Каждого СтрокаДерева Из СтрокиИсточника Цикл
		СтрокаПриемника = СтрокиПриемника.Добавить();
		ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаДерева);
		ГКСК_ПеренестиВсеПодчиненныеСтроки(СтрокаДерева.Строки, СтрокаПриемника.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаИсточника)
	
	СтрокаПриемника.Идентификатор            = СтрокаИсточника.Идентификатор;
	СтрокаПриемника.Представление            = СтрокаИсточника.Представление;
	СтрокаПриемника.ТипЭлементаДерева        = СтрокаИсточника.ТипЭлементаДерева;
	СтрокаПриемника.РазрешаетсяВыборОперанда = СтрокаИсточника.РазрешаетсяВыборОперанда;
	СтрокаПриемника.ВключаетсяВИдентификатор = СтрокаИсточника.ВключаетсяВИдентификатор;
	СтрокаПриемника.ТипЗначения              = СтрокаИсточника.ТипЗначения;
	СтрокаПриемника.РазворачиватьДоРеквизитов = СтрокаИсточника.РазворачиватьДоРеквизитов;
	СтрокаПриемника.Значение                 = СтрокаИсточника.Значение;
	СтрокаПриемника.СодержитЗначение         = СтрокаИсточника.СодержитЗначение;
	СтрокаПриемника.ПометкаУдаления          = СтрокаИсточника.ПометкаУдаления;
	
КонецПроцедуры

&НаСервере
Функция ГКСК_СтрокиСодержатДопРеквизиты(Строки)
	
	Для Каждого СтрокаДерева Из Строки Цикл
		Если ГКСК_ЭтоДопРеквизитИлиСведение(СтрокаДерева.ТипЭлементаДерева)
			ИЛИ ГКСК_СтрокиСодержатДопРеквизиты(СтрокаДерева.Строки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ЭтоДопРеквизитИлиСведение(ТипЭлементаДерева)
	
	Возврат ТипЭлементаДерева = "ДополнительныйРеквизит"
		ИЛИ ТипЭлементаДерева = "ДополнительноеСведение";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ТекстПлейсхолдераРеквизит()
	
	Возврат НСтр("ru = '<Реквизит>'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ТекстПлейсхолдераЗначение()
	
	Возврат НСтр("ru = '<Значение>'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_КонструкцияРазделительПробел()
	
	Возврат "+ ?(ЗначениеЗаполнено(" + ГКСК_ТекстПлейсхолдераРеквизит() + "), "" "" + "
		+ ГКСК_ТекстПлейсхолдераЗначение() + ", """")";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_КонструкцияРазделительВложенный()
	
	Возврат "+ ?(ЗначениеЗаполнено(" + ГКСК_ТекстПлейсхолдераРеквизит()
		+ "), ?(ЗначениеЗаполнено(" + ГКСК_ТекстПлейсхолдераРеквизит()
		+ "), """" + " + ГКСК_ТекстПлейсхолдераЗначение() + ", ""), """")";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ПояснениеРазделителя()
	
	Возврат НСтр("ru = 'Замените заполнители в угловых скобках на операнды из дерева'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_СдвигКурсораНаПлейсхолдер(Конструкция)
	
	Позиция = СтрНайти(Конструкция, ГКСК_ТекстПлейсхолдераРеквизит());
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат СтрДлина(Конструкция) - (Позиция - 1);
	
КонецФункции

&НаСервере
Функция ГКСК_КлючНастроекКонструктораФормул()
	
	Возврат "ГКСК.КонструкторФормул";
	
КонецФункции

&НаСервере
Функция ГКСК_НастройкаТолькоДопРеквизиты()
	
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		ГКСК_КлючНастроекКонструктораФормул(),
		"ТолькоДополнительныеРеквизиты");
	
КонецФункции

&НаСервере
Процедура ГКСК_СохранитьНастройкуТолькоДопРеквизиты(Значение)
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		ГКСК_КлючНастроекКонструктораФормул(),
		"ТолькоДополнительныеРеквизиты",
		Значение);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Табличный конструктор формулы (строковые формулы).
//
// Формула собирается из начала формулы и строк таблицы:
//   "<Начало>"
//   +?(ЗначениеЗаполнено(<Условие>), <ЕслиЗаполнено>, <ЕслиПусто>)
// Результат записывается в типовой реквизит Формула, поэтому типовые ОК, Проверить,
// ПередЗакрытием и ОперандыФормулы продолжают работать без изменений.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Функция ГКСК_ЭтоСтроковаяФормула()
	
	Возврат ТипЗнч(ТипРезультата) = Тип("ОписаниеТипов")
		И ТипРезультата.СодержитТип(Тип("Строка"));
	
КонецФункции

&НаСервере
Процедура ГКСК_НастроитьТабличныйКонструктор()
	
	ПоказыватьКонструктор = Ложь;
	
	Если ГКСК_ЭтоСтроковаяФормула() Тогда
		ГКСК_ЗаполнитьКонструкторИзФормулы(Формула);
		ПоказыватьКонструктор = Истина;
	КонецЕсли;
	
	Элементы.ГКСК_НачалоФормулы.Видимость = ПоказыватьКонструктор;
	Элементы.ГКСК_ТаблицаФормулы.Видимость = ПоказыватьКонструктор;
	Элементы.ГКСК_Предпросмотр.Видимость = ПоказыватьКонструктор;
	// Типовое поле "Формула" всегда доступно: его можно править вручную,
	// таблица при этом пересобирается по тексту (см. ГКСК_ФормулаПриИзменении).
	Элементы.Формула.Видимость = Истина;
	
	Если Не ПоказыватьКонструктор Тогда
		Возврат;
	КонецЕсли;
	
	ГКСК_Предпросмотр = Формула;
	
КонецПроцедуры

// Разбирает формулу в структуру табличного конструктора.
//
// Параметры:
//  ТекстФормулы - Строка - текст формулы.
//
// Возвращаемое значение:
//  Структура, Неопределено - ключи Начало (Строка) и Строки (Массив структур с ключами
//   Условие, ЕслиЗаполнено, ЕслиПусто); Неопределено, если формула не в табличном виде.
//
&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_РазобратьФормулу(ТекстФормулы)
	
	Если ПустаяСтрока(ТекстФормулы) Тогда
		Возврат Новый Структура("Начало, Строки", "", Новый Массив);
	КонецЕсли;
	
	Текст = СтрЗаменить(ТекстФормулы, Символы.ВК, "");
	Слагаемые = ГКСК_РазделитьПоСлагаемым(Текст);
	
	Если Слагаемые.Количество() = 0 Тогда
		Возврат Новый Структура("Начало, Строки", "", Новый Массив);
	КонецЕсли;
	
	// Формула может быть записана как одной строкой, так и с переносами -
	// разбор идёт по слагаемым верхнего уровня, а не по строкам текста.
	Если Не ГКСК_ЭтоУсловнаяКонструкция(Слагаемые[0])
		И Не ГКСК_ЭтоСтроковыйЛитералЦеликом(Слагаемые[0]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НачалоТекста = "";
	Индекс = 0;
	
	// Начало формулы - все подряд идущие строковые литералы до первого условия.
	Пока Индекс < Слагаемые.Количество()
		И Не ГКСК_ЭтоУсловнаяКонструкция(Слагаемые[Индекс])
		И ГКСК_ЭтоСтроковыйЛитералЦеликом(Слагаемые[Индекс]) Цикл
		
		НачалоТекста = НачалоТекста + ГКСК_ЗначениеСтроковогоЛитерала(Слагаемые[Индекс]);
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Строки = Новый Массив;
	Пока Индекс < Слагаемые.Количество() Цикл
		
		ПараметрыСтроки = ГКСК_РазобратьСтрокуУсловия(Слагаемые[Индекс]);
		Если ПараметрыСтроки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Строки.Добавить(ПараметрыСтроки);
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Возврат Новый Структура("Начало, Строки", НачалоТекста, Строки);
	
КонецФункции

// Заполняет реквизиты табличного конструктора по тексту формулы.
//
// Параметры:
//  ТекстФормулы - Строка - текст формулы.
//
// Возвращаемое значение:
//  Булево - Истина, если формула пуста или разобрана; Ложь - формула не в табличном виде
//           (таблица и начало формулы очищаются).
//
&НаСервере
Функция ГКСК_ЗаполнитьКонструкторИзФормулы(ТекстФормулы)
	
	ГКСК_СтрокиФормулы.Очистить();
	ГКСК_НачалоФормулы = "";
	
	Разбор = ГКСК_РазобратьФормулу(ТекстФормулы);
	Если Разбор = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ГКСК_НачалоФормулы = Разбор.Начало;
	Для Каждого ПараметрыСтроки Из Разбор.Строки Цикл
		НоваяСтрока = ГКСК_СтрокиФормулы.Добавить();
		НоваяСтрока.Условие = ПараметрыСтроки.Условие;
		НоваяСтрока.ЕслиЗаполнено = ПараметрыСтроки.ЕслиЗаполнено;
		НоваяСтрока.ЕслиПусто = ПараметрыСтроки.ЕслиПусто;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Заполняет реквизиты конструктора по текущему значению типового поля "Формула".
// Клиентская версия - без вызова сервера, чтобы не сбрасывать каретку в поле "Формула".
//
&НаКлиенте
Процедура ГКСК_ЗаполнитьКонструкторИзФормулыКлиент()
	
	ГКСК_СтрокиФормулы.Очистить();
	ГКСК_НачалоФормулы = "";
	ГКСК_Предпросмотр = Формула;
	
	Разбор = ГКСК_РазобратьФормулу(Формула);
	Если Разбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГКСК_НачалоФормулы = Разбор.Начало;
	Для Каждого ПараметрыСтроки Из Разбор.Строки Цикл
		НоваяСтрока = ГКСК_СтрокиФормулы.Добавить();
		НоваяСтрока.Условие = ПараметрыСтроки.Условие;
		НоваяСтрока.ЕслиЗаполнено = ПараметрыСтроки.ЕслиЗаполнено;
		НоваяСтрока.ЕслиПусто = ПараметрыСтроки.ЕслиПусто;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ЭтоСтроковыйЛитералЦеликом(Текст)
	
	Если СтрДлина(Текст) < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Лев(Текст, 1) <> """" ИЛИ Прав(Текст, 1) <> """" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Внутри = Сред(Текст, 2, СтрДлина(Текст) - 2);
	Внутри = СтрЗаменить(Внутри, """""", "");
	
	Возврат СтрНайти(Внутри, """") = 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ЗначениеСтроковогоЛитерала(Текст)
	
	Внутри = Сред(Текст, 2, СтрДлина(Текст) - 2);
	Возврат СтрЗаменить(Внутри, """""", """");
	
КонецФункции

// Разбирает строку вида +?(ЗначениеЗаполнено(<Условие>), <ЕслиЗаполнено>, <ЕслиПусто>).
//
// Параметры:
//  Текст - Строка - одна строка формулы.
//
// Возвращаемое значение:
//  Структура - ключи Условие, ЕслиЗаполнено, ЕслиПусто; Неопределено, если строка
//              не соответствует табличному виду.
//
&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_РазобратьСтрокуУсловия(Текст)
	
	Работа = СокрЛП(Текст);
	Если Лев(Работа, 1) = "+" Тогда
		Работа = СокрЛП(Сред(Работа, 2));
	КонецЕсли;
	
	Если Лев(Работа, 2) <> "?(" ИЛИ Прав(Работа, 1) <> ")" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Аргументы = ГКСК_АргументыВызова(Сред(Работа, 3, СтрДлина(Работа) - 3));
	Если Аргументы.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Префикс = "ЗначениеЗаполнено(";
	Условие = СокрЛП(Аргументы[0]);
	Если Лев(Условие, СтрДлина(Префикс)) <> Префикс ИЛИ Прав(Условие, 1) <> ")" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеУсловия = СокрЛП(Сред(Условие, СтрДлина(Префикс) + 1,
		СтрДлина(Условие) - СтрДлина(Префикс) - 1));
	Если ПустаяСтрока(ЗначениеУсловия) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("Условие, ЕслиЗаполнено, ЕслиПусто");
	Результат.Условие = ЗначениеУсловия;
	Результат.ЕслиЗаполнено = СокрЛП(Аргументы[1]);
	Результат.ЕслиПусто = СокрЛП(Аргументы[2]);
	
	Возврат Результат;
	
КонецФункции

// Делит текст формулы на слагаемые верхнего уровня (по знаку "+" вне скобок и строковых литералов).
// Переносы строк вне литералов заменяются пробелом - формула может быть записана одной строкой.
//
&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_РазделитьПоСлагаемым(Текст)
	
	Слагаемые = Новый Массив;
	ТекущееСлагаемое = "";
	ГлубинаСкобок = 0;
	ВКавычках = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Текст);
	
	Пока Позиция <= Длина Цикл
		
		Символ = Сред(Текст, Позиция, 1);
		
		Если Символ = """" Тогда
			Если ВКавычках И Позиция < Длина И Сред(Текст, Позиция + 1, 1) = """" Тогда
				ТекущееСлагаемое = ТекущееСлагаемое + """""";
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВКавычках = Не ВКавычках;
			ТекущееСлагаемое = ТекущееСлагаемое + Символ;
		ИначеЕсли ВКавычках Тогда
			ТекущееСлагаемое = ТекущееСлагаемое + Символ;
		ИначеЕсли Символ = "(" Тогда
			ГлубинаСкобок = ГлубинаСкобок + 1;
			ТекущееСлагаемое = ТекущееСлагаемое + Символ;
		ИначеЕсли Символ = ")" Тогда
			ГлубинаСкобок = ГлубинаСкобок - 1;
			ТекущееСлагаемое = ТекущееСлагаемое + Символ;
		ИначеЕсли Символ = "+" И ГлубинаСкобок = 0 Тогда
			ГКСК_ДобавитьСлагаемое(Слагаемые, ТекущееСлагаемое);
			ТекущееСлагаемое = "";
		ИначеЕсли Символ = Символы.ПС ИЛИ Символ = Символы.ВК ИЛИ Символ = Символы.Таб Тогда
			ТекущееСлагаемое = ТекущееСлагаемое + " ";
		Иначе
			ТекущееСлагаемое = ТекущееСлагаемое + Символ;
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	ГКСК_ДобавитьСлагаемое(Слагаемые, ТекущееСлагаемое);
	
	Возврат Слагаемые;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ГКСК_ДобавитьСлагаемое(Слагаемые, Знач Текст)
	
	Текст = СокрЛП(Текст);
	Если Текст <> "" Тогда
		Слагаемые.Добавить(Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ЭтоУсловнаяКонструкция(Текст)
	
	Возврат Лев(СокрЛП(Текст), 2) = "?(";
	
КонецФункции

// Делит текст вызова на аргументы верхнего уровня (по запятым вне скобок и строковых литералов).
//
&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_АргументыВызова(Текст)
	
	Аргументы = Новый Массив;
	ТекущийАргумент = "";
	ГлубинаСкобок = 0;
	ВКавычках = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Текст);
	
	Пока Позиция <= Длина Цикл
		
		Символ = Сред(Текст, Позиция, 1);
		
		Если Символ = """" Тогда
			Если ВКавычках И Позиция < Длина И Сред(Текст, Позиция + 1, 1) = """" Тогда
				ТекущийАргумент = ТекущийАргумент + """""";
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВКавычках = Не ВКавычках;
			ТекущийАргумент = ТекущийАргумент + Символ;
		ИначеЕсли ВКавычках Тогда
			ТекущийАргумент = ТекущийАргумент + Символ;
		ИначеЕсли Символ = "(" Тогда
			ГлубинаСкобок = ГлубинаСкобок + 1;
			ТекущийАргумент = ТекущийАргумент + Символ;
		ИначеЕсли Символ = ")" Тогда
			ГлубинаСкобок = ГлубинаСкобок - 1;
			ТекущийАргумент = ТекущийАргумент + Символ;
		ИначеЕсли Символ = "," И ГлубинаСкобок = 0 Тогда
			Аргументы.Добавить(ТекущийАргумент);
			ТекущийАргумент = "";
		Иначе
			ТекущийАргумент = ТекущийАргумент + Символ;
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Аргументы.Добавить(ТекущийАргумент);
	
	Возврат Аргументы;
	
КонецФункции

&НаКлиенте
Функция ГКСК_КонструкторВидим()
	
	Возврат Элементы.ГКСК_ТаблицаФормулы.Видимость;
	
КонецФункции

&НаКлиенте
Процедура ГКСК_ПересобратьФормулу()
	
	ГКСК_КонструкторИзменён = Истина;
	Формула = ГКСК_СобратьФормулу(ГКСК_НачалоФормулы, ГКСК_СтрокиФормулы);
	ГКСК_Предпросмотр = Формула;
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_ПересобратьФормулуПередПроверкой()
	
	Если Не ГКСК_КонструкторВидим() Тогда
		Возврат;
	КонецЕсли;
	
	// Пересобираем только если таблицу/начало формулы действительно меняли:
	// формула, введённая вручную, при сохранении не перезаписывается.
	Если Не ГКСК_КонструкторИзменён Тогда
		Возврат;
	КонецЕсли;
	
	Формула = ГКСК_СобратьФормулу(ГКСК_НачалоФормулы, ГКСК_СтрокиФормулы);
	ГКСК_Предпросмотр = Формула;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_СобратьФормулу(НачалоФормулы, СтрокиФормулы)
	
	ЧастиФормулы = Новый Массив;
	
	Начало = СокрЛП(НачалоФормулы);
	Если Начало <> "" Тогда
		ЧастиФормулы.Добавить("""" + Начало + """");
	КонецЕсли;
	
	Для Каждого СтрокаФормулы Из СтрокиФормулы Цикл
		
		Условие = СокрЛП(СтрокаФормулы.Условие);
		Если Условие = "" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЕслиЗаполнено = ГКСК_ТекстВеткиФормулы(СтрокаФормулы.ЕслиЗаполнено);
		ТекстЕслиПусто = ГКСК_ТекстВеткиФормулы(СтрокаФормулы.ЕслиПусто);
		
		ЧастиФормулы.Добавить("?(ЗначениеЗаполнено(" + Условие + "), "
			+ ТекстЕслиЗаполнено + ", " + ТекстЕслиПусто + ")");
		
	КонецЦикла;
	
	// Знак "+" ставится только перед второй и последующими частями: если начало формулы пустое,
	// первая часть - это условное выражение, и ведущий "+" сделал бы формулу синтаксически неверной.
	ТекстФормулы = "";
	Для Индекс = 0 По ЧастиФормулы.Количество() - 1 Цикл
		
		Если Индекс > 0 Тогда
			ТекстФормулы = ТекстФормулы + Символы.ПС + "+";
		КонецЕсли;
		
		ТекстФормулы = ТекстФормулы + ЧастиФормулы[Индекс];
		
	КонецЦикла;
	
	Возврат ТекстФормулы;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ТекстВеткиФормулы(Знач Текст)
	
	Текст = СокрЛП(Текст);
	Если Текст = "" Тогда
		Возврат """""";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Процедура ГКСК_ОбновитьТаблицуИзФормулы()
	
	Если Не ГКСК_КонструкторВидим() Тогда
		Возврат;
	КонецЕсли;
	
	// Формула правится в типовом поле: раскладываем текст обратно в таблицу.
	ГКСК_ЗаполнитьКонструкторИзФормулыКлиент();
	ГКСК_КонструкторИзменён = Ложь;
	
КонецПроцедуры

&НаКлиенте
&Вместо("ДеревоОперандовВыбор")
Процедура ГКСК_ДеревоОперандовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Типовая вставка операнда идёт в поле "Формула" в позицию курсора
	// (с заменой выделенного текста) - таблица синхронизируется после вставки.
	ПродолжитьВызов(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	ГКСК_ОбновитьТаблицуИзФормулы();
	
КонецПроцедуры

&НаКлиенте
&Вместо("ОператорыВыбор")
Процедура ГКСК_ОператорыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПродолжитьВызов(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	ГКСК_ОбновитьТаблицуИзФормулы();
	
КонецПроцедуры

&НаКлиенте
&Перед("ОК")
Процедура ГКСК_ОКПеред(Команда)
	
	ГКСК_ПересобратьФормулуПередПроверкой();
	
КонецПроцедуры

&НаКлиенте
&Перед("Проверить")
Процедура ГКСК_ПроверитьПеред(Команда)
	
	ГКСК_ПересобратьФормулуПередПроверкой();
	
КонецПроцедуры

&НаКлиенте
&Перед("ПередЗакрытием")
Процедура ГКСК_ПередЗакрытиемПеред(Отказ, СтандартнаяОбработка)
	
	ГКСК_ПересобратьФормулуПередПроверкой();
	
КонецПроцедуры

#КонецОбласти
