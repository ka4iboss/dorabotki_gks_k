#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ГКСК_ТолькоДополнительныеРеквизитыПриИзменении(Элемент)
	
	ГКСК_ПереключитьДеревоОперандов();
	ГКСК_СохранитьНастройкуТолькоДопРеквизиты(ГКСК_ТолькоДополнительныеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГКСК_ВставитьУсловныйРазделитель(Команда)
	
	Конструкция = ГКСК_КонструкцияРазделительПробел();
	ВставитьТекстВФормулу(Конструкция);
	ГКСК_ВыделитьПлейсхолдерРеквизит(Конструкция);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// ГКС: доработка типового конструктора формул (расширение Доработки_ГКС_К).
//
// 1. Группа палитры "Условные разделители" с конструкциями вида
//    + ?(ЗначениеЗаполнено(<Реквизит>), " " + <Значение>, "")
//    для строковых формул (шаблоны наименований номенклатуры, характеристик, серий).
// 2. Флажок "Только дополнительные реквизиты" - фильтр дерева доступных полей
//    до дополнительных реквизитов и сведений.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ГКСК_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ПустаяСтрока(АдресДереваОперандов) Тогда
		Возврат;
	КонецЕсли;
	
	Дерево = ПолучитьИзВременногоХранилища(АдресДереваОперандов);
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ГКСК_НастроитьУсловныеРазделители();
	ГКСК_НастроитьФильтрДополнительныхРеквизитов(Дерево);
	
КонецПроцедуры

&НаКлиенте
&Вместо("ВставитьОператорВФормулу")
Процедура ГКСК_ВставитьОператорВФормулу()
	
	ТекущиеДанныеОператора = Элементы.Операторы.ТекущиеДанные;
	
	Если ТекущиеДанныеОператора <> Неопределено
		И НЕ ТекущиеДанныеОператора.ЭтоГруппа
		И Лев(ТекущиеДанныеОператора.Идентификатор, 5) = "ГКСК_" Тогда
		
		Конструкция = ТекущиеДанныеОператора.КонструкцияДляВставки;
		ВставитьТекстВФормулу(Конструкция);
		ГКСК_ВыделитьПлейсхолдерРеквизит(Конструкция);
		ВставитьОператорВФормулуФрагмент();
		Возврат;
		
	КонецЕсли;
	
	ПродолжитьВызов();
	
КонецПроцедуры

&НаКлиенте
Процедура ГКСК_ВыделитьПлейсхолдерРеквизит(Знач Конструкция)
	
	Плейсхолдер = ГКСК_ТекстПлейсхолдераРеквизит();
	Позиция = СтрНайти(Конструкция, Плейсхолдер);
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаНач = 0;
	КолонкаНач = 0;
	СтрокаКон = 0;
	КолонкаКон = 0;
	Элементы.Формула.ПолучитьГраницыВыделения(СтрокаНач, КолонкаНач, СтрокаКон, КолонкаКон);
	
	НачалоВставки = КолонкаКон - СтрДлина(Конструкция);
	
	Элементы.Формула.УстановитьГраницыВыделения(
		СтрокаКон,
		НачалоВставки + Позиция - 1,
		СтрокаКон,
		НачалоВставки + Позиция - 1 + СтрДлина(Плейсхолдер));
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_НастроитьФильтрДополнительныхРеквизитов(Дерево)
	
	ЕстьДопРеквизиты = ГКСК_СтрокиСодержатДопРеквизиты(Дерево.Строки);
	Элементы.ГКСК_ТолькоДополнительныеРеквизиты.Видимость = ЕстьДопРеквизиты;
	
	Если НЕ ЕстьДопРеквизиты Тогда
		ГКСК_ТолькоДополнительныеРеквизиты = Ложь;
		Возврат;
	КонецЕсли;
	
	ГКСК_ТолькоДополнительныеРеквизиты = (ГКСК_НастройкаТолькоДопРеквизиты() = Истина);
	Если ГКСК_ТолькоДополнительныеРеквизиты Тогда
		ГКСК_ПереключитьДеревоОперандов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_ПереключитьДеревоОперандов()
	
	Дерево = ПолучитьИзВременногоХранилища(АдресДереваОперандов);
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ГКСК_ТолькоДополнительныеРеквизиты Тогда
		Дерево = ГКСК_ДеревоТолькоДопРеквизиты(Дерево);
	КонецЕсли;
	
	// Разрешенные операнды не пересчитываются: проверка формулы выполняется по полному списку операндов.
	РаботаСФормулами.ЗагрузитьДеревоОперандовВДеревоФормы(ДеревоОперандов, Дерево);
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_НастроитьУсловныеРазделители()
	
	// Конструкции условных разделителей имеют смысл только для строковых формул.
	ЭтоСтроковаяФормула = ТипЗнч(ТипРезультата) = Тип("ОписаниеТипов")
		И ТипРезультата.СодержитТип(Тип("Строка"));
	
	Элементы.ГКСК_ВставитьУсловныйРазделитель.Видимость = ЭтоСтроковаяФормула;
	
	Если НЕ ЭтоСтроковаяФормула Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоОператоров = РеквизитФормыВЗначение("Операторы");
	
	Группа = РаботаСФормулами.ДобавитьГруппуОператоров(
		ДеревоОператоров,
		"ГКСК_УсловныеРазделители",
		НСтр("ru = 'Условные разделители'"));
	
	КонструкцияПробел = ГКСК_КонструкцияРазделительПробел();
	РаботаСФормулами.ДобавитьОператор(
		Группа,
		"ГКСК_РазделительПробел",
		КонструкцияПробел,
		НСтр("ru = 'Условный разделитель (пробел)'"),
		ГКСК_ПояснениеРазделителя(),
		ГКСК_СдвигКурсораНаПлейсхолдер(КонструкцияПробел));
	
	КонструкцияВложенный = ГКСК_КонструкцияРазделительВложенный();
	РаботаСФормулами.ДобавитьОператор(
		Группа,
		"ГКСК_РазделительВложенный",
		КонструкцияВложенный,
		НСтр("ru = 'Условный разделитель (вложенный)'"),
		ГКСК_ПояснениеРазделителя(),
		ГКСК_СдвигКурсораНаПлейсхолдер(КонструкцияВложенный));
	
	ЗначениеВРеквизитФормы(ДеревоОператоров, "Операторы");
	
КонецПроцедуры

// Формирует дерево операндов только из дополнительных реквизитов и сведений.
//
// Параметры:
//  ДеревоИсточник - ДеревоЗначений - полное дерево операндов,
//                   см. РаботаСФормулами.ПолучитьПустоеДеревоОперандов.
//
// Возвращаемое значение:
//  ДеревоЗначений - дерево, содержащее дополнительные реквизиты и сведения вместе с их свойствами.
//
&НаСервере
Функция ГКСК_ДеревоТолькоДопРеквизиты(ДеревоИсточник)
	
	ДеревоРезультат = РаботаСФормулами.ПолучитьПустоеДеревоОперандов();
	ГКСК_ПеренестиДопРеквизиты(ДеревоИсточник.Строки, ДеревоРезультат.Строки);
	
	Возврат ДеревоРезультат;
	
КонецФункции

&НаСервере
Процедура ГКСК_ПеренестиДопРеквизиты(СтрокиИсточника, СтрокиПриемника)
	
	Для Каждого СтрокаДерева Из СтрокиИсточника Цикл
		
		Если ГКСК_ЭтоДопРеквизитИлиСведение(СтрокаДерева.ТипЭлементаДерева) Тогда
			
			СтрокаПриемника = СтрокиПриемника.Добавить();
			ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаДерева);
			ГКСК_ПеренестиВсеПодчиненныеСтроки(СтрокаДерева.Строки, СтрокаПриемника.Строки);
			
		ИначеЕсли ГКСК_СтрокиСодержатДопРеквизиты(СтрокаДерева.Строки) Тогда
			
			СтрокаПриемника = СтрокиПриемника.Добавить();
			ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаДерева);
			ГКСК_ПеренестиДопРеквизиты(СтрокаДерева.Строки, СтрокаПриемника.Строки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_ПеренестиВсеПодчиненныеСтроки(СтрокиИсточника, СтрокиПриемника)
	
	Для Каждого СтрокаДерева Из СтрокиИсточника Цикл
		СтрокаПриемника = СтрокиПриемника.Добавить();
		ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаДерева);
		ГКСК_ПеренестиВсеПодчиненныеСтроки(СтрокаДерева.Строки, СтрокаПриемника.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ГКСК_ЗаполнитьСтрокуОперанда(СтрокаПриемника, СтрокаИсточника)
	
	СтрокаПриемника.Идентификатор            = СтрокаИсточника.Идентификатор;
	СтрокаПриемника.Представление            = СтрокаИсточника.Представление;
	СтрокаПриемника.ТипЭлементаДерева        = СтрокаИсточника.ТипЭлементаДерева;
	СтрокаПриемника.РазрешаетсяВыборОперанда = СтрокаИсточника.РазрешаетсяВыборОперанда;
	СтрокаПриемника.ВключаетсяВИдентификатор = СтрокаИсточника.ВключаетсяВИдентификатор;
	СтрокаПриемника.ТипЗначения              = СтрокаИсточника.ТипЗначения;
	СтрокаПриемника.РазворачиватьДоРеквизитов = СтрокаИсточника.РазворачиватьДоРеквизитов;
	СтрокаПриемника.Значение                 = СтрокаИсточника.Значение;
	СтрокаПриемника.СодержитЗначение         = СтрокаИсточника.СодержитЗначение;
	СтрокаПриемника.ПометкаУдаления          = СтрокаИсточника.ПометкаУдаления;
	
КонецПроцедуры

&НаСервере
Функция ГКСК_СтрокиСодержатДопРеквизиты(Строки)
	
	Для Каждого СтрокаДерева Из Строки Цикл
		Если ГКСК_ЭтоДопРеквизитИлиСведение(СтрокаДерева.ТипЭлементаДерева)
			ИЛИ ГКСК_СтрокиСодержатДопРеквизиты(СтрокаДерева.Строки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ЭтоДопРеквизитИлиСведение(ТипЭлементаДерева)
	
	Возврат ТипЭлементаДерева = "ДополнительныйРеквизит"
		ИЛИ ТипЭлементаДерева = "ДополнительноеСведение";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ТекстПлейсхолдераРеквизит()
	
	Возврат НСтр("ru = '<Реквизит>'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ТекстПлейсхолдераЗначение()
	
	Возврат НСтр("ru = '<Значение>'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_КонструкцияРазделительПробел()
	
	Возврат "+ ?(ЗначениеЗаполнено(" + ГКСК_ТекстПлейсхолдераРеквизит() + "), "" "" + "
		+ ГКСК_ТекстПлейсхолдераЗначение() + ", """")";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_КонструкцияРазделительВложенный()
	
	Возврат "+ ?(ЗначениеЗаполнено(" + ГКСК_ТекстПлейсхолдераРеквизит()
		+ "), ?(ЗначениеЗаполнено(" + ГКСК_ТекстПлейсхолдераРеквизит()
		+ "), """" + " + ГКСК_ТекстПлейсхолдераЗначение() + ", ""), """")";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_ПояснениеРазделителя()
	
	Возврат НСтр("ru = 'Замените заполнители в угловых скобках на операнды из дерева'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_СдвигКурсораНаПлейсхолдер(Конструкция)
	
	Позиция = СтрНайти(Конструкция, ГКСК_ТекстПлейсхолдераРеквизит());
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат СтрДлина(Конструкция) - (Позиция - 1);
	
КонецФункции

&НаСервере
Функция ГКСК_КлючНастроекКонструктораФормул()
	
	Возврат "ГКСК.КонструкторФормул";
	
КонецФункции

&НаСервере
Функция ГКСК_НастройкаТолькоДопРеквизиты()
	
	Возврат ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		ГКСК_КлючНастроекКонструктораФормул(),
		"ТолькоДополнительныеРеквизиты");
	
КонецФункции

&НаСервере
Процедура ГКСК_СохранитьНастройкуТолькоДопРеквизиты(Значение)
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
		ГКСК_КлючНастроекКонструктораФормул(),
		"ТолькоДополнительныеРеквизиты",
		Значение);
	
КонецПроцедуры

#КонецОбласти
