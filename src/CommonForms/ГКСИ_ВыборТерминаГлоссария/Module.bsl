// Форма выбора термина глоссария.
// Используется из редактора Markdown как альтернатива ручной вставке ссылки.
//
// Параметры формы (см. ГКСИ_ГлоссарийКлиентСервер.ОткрытьВыборТермина):
//   МассивОбъектовКонфигурации - Массив - отбор терминов по привязке к объектам
//                                       метаданных. Необязательный.

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьКоманда(Команда)

	ТекущиеДанные = Элементы.ТерминыТаблица.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Выберите термин из списка.";
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;

	ВыбраннаяСсылка = ТекущиеДанные.Ссылка;
	Закрыть(ВыбраннаяСсылка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПараметрыОткрытия = Новый Структура("МассивОбъектовКонфигурации", Неопределено);
	Если ТипЗнч(Параметры) = Тип("Структура")
		ИЛИ ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыОткрытия, Параметры);
	КонецЕсли;

	ЗаполнитьТаблицуТерминов(ПараметрыОткрытия.МассивОбъектовКонфигурации);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Элементы.Фильтр.УстановитьДействие("ПриИзменении", "ФильтрПриИзменении");
	Элементы.ТерминыТаблица.УстановитьДействие("Выбор", "ТерминыТаблицаВыбор");

КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)

	ПрименитьФильтрНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТерминыТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ВыбраннаяСтрока <> Неопределено Тогда
		ВыбраннаяСсылка = ВыбраннаяСтрока.Ссылка;
		Закрыть(ВыбраннаяСсылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуТерминов(МассивОбъектов)

	КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	ВсеТермины = ГКСИ_Глоссарий.ТерминыПоОбъектамМетаданных(МассивОбъектов, КодЯзыка);
	ПеренестиВФорму(ВсеТермины);

КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрНаСервере()

	Термины.Очистить();
	КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	ВсеТермины = ГКСИ_Глоссарий.ТерминыПоОбъектамМетаданных(Неопределено, КодЯзыка);

	ДлинаФильтра = СтрДлина(Фильтр);
	ФильтрНижнийРегистр = НРег(Фильтр);
	Для Каждого Строка Из ВсеТермины Цикл
		Если ДлинаФильтра > 0 Тогда
			Если НРег(Лев(Строка.Наименование, ДлинаФильтра)) <> ФильтрНижнийРегистр Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока = Термины.Добавить();
		НоваяСтрока.Ссылка = XMLСтрока(Строка.Ссылка);
		НоваяСтрока.Наименование = Строка.Наименование;
		НоваяСтрока.Описание = Строка.Описание;
	КонецЦикла;

КонецПроцедуры

// Копирует серверную таблицу терминов (ТаблицаЗначений) в реквизит формы Термины.
&НаСервере
Процедура ПеренестиВФорму(ТаблицаИсточник)

	Для Каждого Строка Из ТаблицаИсточник Цикл
		НоваяСтрока = Термины.Добавить();
		НоваяСтрока.Ссылка = XMLСтрока(Строка.Ссылка);
		НоваяСтрока.Наименование = Строка.Наименование;
		НоваяСтрока.Описание = Строка.Описание;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
