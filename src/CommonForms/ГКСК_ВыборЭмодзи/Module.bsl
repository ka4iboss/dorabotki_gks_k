#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ИдентификаторОбсуждения") Тогда
		ИдентификаторОбсуждения = Параметры["ИдентификаторОбсуждения"];
	КонецЕсли;

	ЗаполнитьНабор();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеПоискаПриИзменении(Элемент)

	ОбновитьНаборНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаЭмодзи

&НаКлиенте
Процедура ТаблицаЭмодзиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ОтправитьВыбранныйЭмодзи();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьЭмодзи(Команда)

	ОтправитьВыбранныйЭмодзи();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОтправитьВыбранныйЭмодзи()

	Если Элементы.ТаблицаЭмодзи.ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите эмодзи.'"));
		Возврат;
	КонецЕсли;

	Символ = Элементы.ТаблицаЭмодзи.ТекущиеДанные.Символ;
	ОтправитьЭмодзиНаСервере(Символ);
	Закрыть();

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаборНаСервере()

	ЗаполнитьНабор(СтрокаПоиска);

КонецПроцедуры

&НаСервере
Процедура ОтправитьЭмодзиНаСервере(Символ)

	Если Не ЗначениеЗаполнено(ИдентификаторОбсуждения) Тогда
		Возврат;
	КонецЕсли;

	ГКСК_ЭмодзиОбсужденийВызовСервера.ОтправитьЭмодзи(ИдентификаторОбсуждения, Символ);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНабор(Поиск = "")

	ЭмодзиНабор.Очистить();

	Искомое = ВРег(СокрЛП(Поиск));

	Для Каждого Данные Из ДанныеЭмодзи() Цикл
		Если ЗначениеЗаполнено(Искомое)
			И СтрНайти(ВРег(Данные.Название), Искомое) = 0
			И СтрНайти(ВРег(Данные.Категория), Искомое) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ЭмодзиНабор.Добавить();
		НоваяСтрока.Символ = Данные.Символ;
		НоваяСтрока.Название = Данные.Название;
		НоваяСтрока.Категория = Данные.Категория;
	КонецЦикла;

КонецПроцедуры

