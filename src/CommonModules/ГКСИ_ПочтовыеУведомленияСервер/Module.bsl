#Область ПрограммныйИнтерфейс

// Отправляет участникам согласования письмо о запуске бизнес-процесса.
// Выполняется в фоновом задании: отправка письма не должна блокировать
// выполнение задачи «Назначить участников».
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - запущенный процесс согласования.
//
Процедура ОтправитьПриглашенияУчастникам(ПроцессСсылка) Экспорт
	
	// Процедура выполняется в фоновом задании от имени автора запуска:
	// чтение контактной информации пользователей и отправка письма
	// не должны зависеть от его прав.
	УстановитьПривилегированныйРежим(Истина);
	
	Процесс = ПроцессСсылка.ПолучитьОбъект();
	Если Процесс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Участники = ЭтапыУчастников(Процесс);
	Если Участники.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОтправкаПочтыДоступна() Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			НСтр("ru = 'Письма участникам согласования не отправлены: отправка электронной почты не настроена.'"));
		Возврат;
	КонецЕсли;
	
	Адреса = АдресаЭлектроннойПочты(Участники);
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	УчетнаяЗапись = МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ТемаПисьма = СтрШаблон(НСтр("ru = 'Согласование инструкции: %1'"), Процесс.Наименование);
	
	Для Каждого Участник Из Участники Цикл
		
		Адрес = Адреса.Получить(Участник.Ключ);
		
		Если ПустаяСтрока(Адрес) Тогда
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
				СтрШаблон(НСтр("ru = 'Письмо участнику %1 не отправлено: не заполнен адрес электронной почты.'"),
					ОбщегоНазначения.ПредметСтрокой(Участник.Ключ)));
			Продолжить;
		КонецЕсли;
		
		ПараметрыПисьма = Новый Структура;
		ПараметрыПисьма.Вставить("Кому", Адрес);
		ПараметрыПисьма.Вставить("Тема", ТемаПисьма);
		ПараметрыПисьма.Вставить("Тело", ТекстПисьма(Процесс, Участник.Значение));
		
		Попытка
			Письмо = МодульРаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
			МодульРаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
		Исключение
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
				СтрШаблон(НСтр("ru = 'Письмо участнику %1 не отправлено: %2'"),
					ОбщегоНазначения.ПредметСтрокой(Участник.Ключ),
					ИнформацияОбОшибке().ПодробноеПредставлениеОшибки()));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Запускает отправку писем участникам согласования в фоновом задании.
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - запущенный процесс согласования.
//
Процедура ЗапуститьОтправкуПриглашений(ПроцессСсылка) Экспорт
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПроцессСсылка);
	
	ФоновыеЗадания.Выполнить(
		"ГКСИ_ПочтовыеУведомленияСервер.ОтправитьПриглашенияУчастникам",
		ПараметрыЗадания,
		,
		НСтр("ru = 'Письма участникам согласования инструкции'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает соответствие «участник - этапы участия» по табличным частям процесса.
//
// Параметры:
//  Процесс - БизнесПроцессОбъект.ГКСИ_СогласованиеИнструкции - процесс согласования.
//
// Возвращаемое значение:
//  Соответствие из СправочникСсылка.Пользователи - ключ, Строка - перечень этапов участия.
//
Функция ЭтапыУчастников(Процесс)
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрокаУчастника Из Процесс.Начальники Цикл
		ДобавитьЭтап(Результат, СтрокаУчастника.Сотрудник, НСтр("ru = 'начальник отдела'"));
	КонецЦикла;
	
	Для Каждого СтрокаУчастника Из Процесс.Подчинённые Цикл
		ДобавитьЭтап(Результат, СтрокаУчастника.Сотрудник, НСтр("ru = 'подчинённый'"));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет этап участия сотрудника в соответствие этапов.
//
// Параметры:
//  Этапы - Соответствие из СправочникСсылка.Пользователи, Строка - соответствие «участник - этапы участия».
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования.
//  Этап - Строка - название этапа участия.
//
Процедура ДобавитьЭтап(Этапы, Сотрудник, Этап)
	
	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапыУчастника = Этапы.Получить(Сотрудник);
	Если ЭтапыУчастника = Неопределено Тогда
		Этапы.Вставить(Сотрудник, Этап);
	Иначе
		Этапы.Вставить(Сотрудник, ЭтапыУчастника + ", " + Этап);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает соответствие «участник - адрес электронной почты».
// Адрес берётся из контактной информации пользователя (вид EmailПользователя).
//
// Параметры:
//  Участники - Соответствие из СправочникСсылка.Пользователи, Строка - соответствие «участник - этапы участия».
//
// Возвращаемое значение:
//  Соответствие из СправочникСсылка.Пользователи - ключ, Строка - адрес электронной почты.
//
Функция АдресаЭлектроннойПочты(Участники)
	
	Результат = Новый Соответствие;
	
	СписокПользователей = Новый Массив;
	Для Каждого Участник Из Участники Цикл
		СписокПользователей.Добавить(Участник.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Ссылка КАК Пользователь,
		|	КонтактнаяИнформация.АдресЭП КАК АдресЭП
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка В (&Пользователи)
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя)
		|	И НЕ КонтактнаяИнформация.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Пользователи", СписокПользователей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Пользователь) = Неопределено Тогда
			Результат.Вставить(Выборка.Пользователь, Выборка.АдресЭП);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, настроена ли системная учётная запись для отправки почты.
//
// Возвращаемое значение:
//  Булево - Истина, если письма можно отправлять.
//
Функция ОтправкаПочтыДоступна()
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	
	Возврат МодульРаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(
		МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), Истина, Ложь);
	
КонецФункции

// Формирует текст письма участнику согласования.
//
// Параметры:
//  Процесс - БизнесПроцессОбъект.ГКСИ_СогласованиеИнструкции - процесс согласования.
//  Этапы - Строка - перечень этапов участия получателя.
//
// Возвращаемое значение:
//  Строка - текст письма.
//
Функция ТекстПисьма(Процесс, Этапы)
	
	Инструкция = ?(ЗначениеЗаполнено(Процесс.КорневаяИнструкция), Процесс.КорневаяИнструкция, Процесс.Предмет);
	
	Части = Новый Массив;
	Части.Добавить(НСтр("ru = 'Запущено согласование инструкции.'"));
	Части.Добавить("");
	Части.Добавить(СтрШаблон(НСтр("ru = 'Инструкция: %1'"), ПредставлениеОбъекта(Инструкция)));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Инициатор: %1'"), ПредставлениеОбъекта(Процесс.Автор)));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Ваше участие: %1'"), Этапы));
	Части.Добавить("");
	Части.Добавить(НСтр("ru = 'Задача на согласование появится в списке задач в 1С:Предприятие.'"));
	
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

// Возвращает представление объекта по ссылке.
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка - ссылка на объект.
//
// Возвращаемое значение:
//  Строка - представление объекта.
//
Функция ПредставлениеОбъекта(Ссылка)
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование");
	
КонецФункции

// Записывает сообщение в журнал регистрации.
//
// Параметры:
//  Уровень - УровеньЖурналаРегистрации - уровень важности сообщения.
//  Текст - Строка - текст сообщения.
//
Процедура ЗаписатьВЖурнал(Уровень, Текст)
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Согласование инструкций.Почтовые уведомления'"),
		Уровень, , , Текст);
	
КонецПроцедуры

#КонецОбласти
