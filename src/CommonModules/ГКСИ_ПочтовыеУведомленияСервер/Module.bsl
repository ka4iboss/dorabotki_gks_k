#Область ПрограммныйИнтерфейс

// Отправляет участнику согласования письмо с навигационной ссылкой на его задачу.
// Вызывается в фоновом задании после создания задачи: до записи задачи ссылки ещё нет.
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - процесс согласования.
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования, которому адресовано письмо.
//  Этап - Строка - название этапа участия (например, «начальник отдела»).
//  БазоваяНавигационнаяСсылка - Строка - базовая часть навигационной ссылки информационной базы,
//                                полученная в контексте клиентского вызова. В фоновом задании
//                                её получить нельзя, поэтому она передаётся параметром.
//
Процедура ОтправитьПриглашениеУчастнику(ПроцессСсылка, Сотрудник, Этап, БазоваяНавигационнаяСсылка) Экспорт
	
	// Процедура выполняется в фоновом задании от имени автора запуска:
	// чтение контактной информации и отправка письма не должны зависеть от его прав.
	УстановитьПривилегированныйРежим(Истина);
	
	ЗадачаСсылка = НайтиОткрытуюЗадачуУчастника(ПроцессСсылка, Сотрудник);
	Если НЕ ЗначениеЗаполнено(ЗадачаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = АдресЭлектроннойПочты(Сотрудник);
	Если ПустаяСтрока(Адрес) Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			СтрШаблон(НСтр("ru = 'Письмо участнику %1 не отправлено: не заполнен адрес электронной почты.'"),
				ОбщегоНазначения.ПредметСтрокой(Сотрудник)));
		Возврат;
	КонецЕсли;
	
	Если НЕ ОтправкаПочтыДоступна() Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			НСтр("ru = 'Письма участникам согласования не отправлены: отправка электронной почты не настроена.'"));
		Возврат;
	КонецЕсли;
	
	Процесс = ПроцессСсылка.ПолучитьОбъект();
	Если Процесс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	УчетнаяЗапись = МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", Адрес);
	ПараметрыПисьма.Вставить("Тема",
		СтрШаблон(НСтр("ru = 'Согласование инструкции: %1'"), Процесс.Наименование));
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма(Процесс, Этап, ЗадачаСсылка, БазоваяНавигационнаяСсылка));
	ПараметрыПисьма.Вставить("ТипТекста", "HTML");
	
	Попытка
		Письмо = МодульРаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
		МодульРаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
			СтрШаблон(НСтр("ru = 'Письмо участнику %1 не отправлено: %2'"),
				ОбщегоНазначения.ПредметСтрокой(Сотрудник),
				ИнформацияОбОшибке().ПодробноеПредставлениеОшибки()));
	КонецПопытки;
	
КонецПроцедуры

// Запускает отправку письма участнику в фоновом задании.
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - процесс согласования.
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования.
//  Этап - Строка - название этапа участия.
//  БазоваяНавигационнаяСсылка - Строка - базовая часть навигационной ссылки информационной базы.
//
Процедура ЗапуститьОтправкуПриглашения(ПроцессСсылка, Сотрудник, Этап, БазоваяНавигационнаяСсылка) Экспорт

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПроцессСсылка);
	ПараметрыЗадания.Добавить(Сотрудник);
	ПараметрыЗадания.Добавить(Этап);
	ПараметрыЗадания.Добавить(БазоваяНавигационнаяСсылка);

	ФоновыеЗадания.Выполнить(
		"ГКСИ_ПочтовыеУведомленияСервер.ОтправитьПриглашениеУчастнику",
		ПараметрыЗадания,
		,
		НСтр("ru = 'Письмо участнику согласования инструкции'"));

КонецПроцедуры

// Повторно запускает отправку писем участникам, чьи задачи в процессе ещё не выполнены.
// Используется командой формы бизнес-процесса: письмо уходит каждому участнику
// с незавершённой задачей этапа согласования (начальники или подчинённые).
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - процесс согласования.
//
// Возвращаемое значение:
//  Число - количество участников, которым запущена отправка писем; -1, если почта не настроена.
//
Функция ОтправитьПисьмаПоНезавершеннымЗадачам(ПроцессСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(ПроцессСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ ОтправкаПочтыДоступна() Тогда
		Возврат -1;
	КонецЕсли;

	ТочкиМаршрута = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ТочкиМаршрута;

	ТочкиСогласования = Новый Массив;
	ТочкиСогласования.Добавить(ТочкиМаршрута.СогласованиеНачальниками);
	ТочкиСогласования.Добавить(ТочкиМаршрута.СогласованиеПодчинёнными);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Задачи.Исполнитель КАК Исполнитель,
		|	Задачи.ТочкаМаршрута КАК ТочкаМаршрута
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.БизнесПроцесс = &БизнесПроцесс
		|	И НЕ Задачи.Выполнена
		|	И НЕ Задачи.ПометкаУдаления
		|	И Задачи.ТочкаМаршрута В (&ТочкиСогласования)";

	Запрос.УстановитьПараметр("БизнесПроцесс", ПроцессСсылка);
	Запрос.УстановитьПараметр("ТочкиСогласования", ТочкиСогласования);

	// Участник может иметь несколько открытых задач — письмо отправляем одно.
	Получатели = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если НЕ ЗначениеЗаполнено(Выборка.Исполнитель)
			Или Получатели.Получить(Выборка.Исполнитель) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Этап = ?(Выборка.ТочкаМаршрута = ТочкиМаршрута.СогласованиеНачальниками,
			НСтр("ru = 'начальник отдела'"),
			НСтр("ru = 'подчинённый'"));

		Получатели.Вставить(Выборка.Исполнитель, Этап);

	КонецЦикла;

	Если Получатели.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	// Базовая часть навигационной ссылки доступна только в контексте вызова из формы,
	// поэтому получаем её здесь и передаём в фоновые задания параметром.
	БазоваяНавигационнаяСсылка = ПолучитьНавигационнуюСсылкуИнформационнойБазы();

	Для Каждого ЭлементПолучателя Из Получатели Цикл
		ЗапуститьОтправкуПриглашения(ПроцессСсылка, ЭлементПолучателя.Ключ,
			ЭлементПолучателя.Значение, БазоваяНавигационнаяСсылка);
	КонецЦикла;

	Возврат Получатели.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Находит открытую (невыполненную) задачу участника в указанном процессе.
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - процесс согласования.
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования.
//
// Возвращаемое значение:
//  ЗадачаСсылка.ЗадачаИсполнителя - задача участника; пустая ссылка, если задача не найдена.
//
Функция НайтиОткрытуюЗадачуУчастника(ПроцессСсылка, Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя.ЗадачиПоИсполнителю(&Исполнитель) КАК Задачи
		|ГДЕ
		|	Задачи.БизнесПроцесс = &БизнесПроцесс
		|	И НЕ Задачи.Выполнена
		|УПОРЯДОЧИТЬ ПО
		|	Задачи.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Исполнитель", Сотрудник);
	Запрос.УстановитьПараметр("БизнесПроцесс", ПроцессСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Задачи.ЗадачаИсполнителя.ПустаяСсылка();
	
КонецФункции

// Возвращает адрес электронной почты пользователя из его контактной информации.
//
// Параметры:
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования.
//
// Возвращаемое значение:
//  Строка - адрес электронной почты; пустая строка, если адрес не заполнен.
//
Функция АдресЭлектроннойПочты(Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.АдресЭП КАК АдресЭП
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Пользователь
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя)";
	
	Запрос.УстановитьПараметр("Пользователь", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.АдресЭП);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Проверяет, настроена ли системная учётная запись для отправки почты.
//
// Возвращаемое значение:
//  Булево - Истина, если письма можно отправлять.
//
Функция ОтправкаПочтыДоступна()
	
	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	
	Возврат МодульРаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(
		МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), Истина, Ложь);
	
КонецФункции

// Формирует HTML-текст письма с навигационной ссылкой на задачу участника.
//
// Параметры:
//  Процесс - БизнесПроцессОбъект.ГКСИ_СогласованиеИнструкции - процесс согласования.
//  Этап - Строка - название этапа участия получателя.
//  ЗадачаСсылка - ЗадачаСсылка.ЗадачаИсполнителя - задача получателя.
//  БазоваяНавигационнаяСсылка - Строка - базовая часть навигационной ссылки информационной базы.
//
// Возвращаемое значение:
//  Строка - HTML-текст письма.
//
Функция ТекстПисьма(Процесс, Этап, ЗадачаСсылка, БазоваяНавигационнаяСсылка)
	
	Инструкция = ?(ЗначениеЗаполнено(Процесс.КорневаяИнструкция), Процесс.КорневаяИнструкция, Процесс.Предмет);
	СсылкаНаЗадачу = СсылкаНаЗадачуДляПисьма(ЗадачаСсылка, БазоваяНавигационнаяСсылка);
	
	Части = Новый Массив;
	Части.Добавить("<html><body>");
	Части.Добавить("<p>" + НСтр("ru = 'Запущено согласование инструкции.'") + "</p>");
	Части.Добавить("<p>" + СтрШаблон(НСтр("ru = 'Инструкция: %1'"),
		ГКСИ_СогласованиеИнструкцийСервер.ЭкранироватьHTMLТекст(ПредставлениеОбъекта(Инструкция))) + "</p>");
	Части.Добавить("<p>" + СтрШаблон(НСтр("ru = 'Инициатор: %1'"),
		ГКСИ_СогласованиеИнструкцийСервер.ЭкранироватьHTMLТекст(ПредставлениеОбъекта(Процесс.Автор))) + "</p>");
	Части.Добавить("<p>" + СтрШаблон(НСтр("ru = 'Ваше участие: %1'"),
		ГКСИ_СогласованиеИнструкцийСервер.ЭкранироватьHTMLТекст(Этап)) + "</p>");
	Части.Добавить("<p><a href=""" + СсылкаНаЗадачу + """>" + НСтр("ru = 'Открыть задачу'") + "</a></p>");
	Части.Добавить("<p>" + НСтр("ru = 'Если ссылка не открывается, скопируйте её в адресную строку 1С:Предприятие:'") + "</p>");
	Части.Добавить("<p>" + СсылкаНаЗадачу + "</p>");
	Части.Добавить("</body></html>");
	
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

// Возвращает ссылку на задачу для письма: абсолютную, если известна базовая часть
// навигационной ссылки информационной базы, иначе относительную.
//
// Параметры:
//  ЗадачаСсылка - ЗадачаСсылка.ЗадачаИсполнителя - задача получателя.
//  БазоваяНавигационнаяСсылка - Строка - базовая часть навигационной ссылки информационной базы.
//
// Возвращаемое значение:
//  Строка - ссылка на задачу.
//
Функция СсылкаНаЗадачуДляПисьма(ЗадачаСсылка, БазоваяНавигационнаяСсылка)
	
	ОтносительнаяСсылка = ПолучитьНавигационнуюСсылку(ЗадачаСсылка);
	
	Если НЕ ЗначениеЗаполнено(БазоваяНавигационнаяСсылка) Тогда
		Возврат ОтносительнаяСсылка;
	КонецЕсли;
	
	АбсолютнаяСсылка = ПолучитьВнешнююНавигационнуюСсылку(БазоваяНавигационнаяСсылка, ОтносительнаяСсылка);
	
	Возврат ?(ЗначениеЗаполнено(АбсолютнаяСсылка), АбсолютнаяСсылка, ОтносительнаяСсылка);
	
КонецФункции

// Возвращает представление объекта по ссылке.
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка - ссылка на объект.
//
// Возвращаемое значение:
//  Строка - представление объекта.
//
Функция ПредставлениеОбъекта(Ссылка)
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование");
	
КонецФункции

// Записывает сообщение в журнал регистрации.
//
// Параметры:
//  Уровень - УровеньЖурналаРегистрации - уровень важности сообщения.
//  Текст - Строка - текст сообщения.
//
Процедура ЗаписатьВЖурнал(Уровень, Текст)
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Согласование инструкций.Почтовые уведомления'"),
		Уровень, , , Текст);
	
КонецПроцедуры

#КонецОбласти
