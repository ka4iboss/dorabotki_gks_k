// Обновляет CSS-правило max-width для изображений во всех iframe
// просмотра Markdown на форме. Вызывается из обработчика
// изменения реквизита ШиринаКартинок.
//
// Параметры:
//   Форма - Произвольный - управляемая форма
//   ШиринаКартинок - Строка - CSS-значение max-width (например, "100%", "600px")
//
Процедура ОбновитьШиринуИзображений(Форма, ШиринаКартинок) Экспорт

	Если НЕ ЗначениеЗаполнено(ШиринаКартинок) Тогда
		ШиринаКартинок = "100%";
	КонецЕсли;

	ОбновитьШиринуИзображенийВКоллекции(Форма.Элементы, ШиринаКартинок);

КонецПроцедуры

// Рекурсивно обновляет CSS-правило max-width у полей HTML-документа,
// вложенных в группы формы на любом уровне.
//
// Параметры:
//   Элементы - ВсеЭлементыФормы, ЭлементыФормы - элементы формы или подчинённые элементы группы.
//   ШиринаКартинок - Строка - CSS-значение max-width.
//
Процедура ОбновитьШиринуИзображенийВКоллекции(Элементы, ШиринаКартинок)

	Для Каждого Элемент Из Элементы Цикл

		Если ТипЗнч(Элемент) = Тип("ПолеФормы") И Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
			Попытка
				ОкноДокумента = ДокументHTMLДляЭлементаHTML(Элемент);
				ОкноДокумента.setImageMaxWidth(ШиринаКартинок);
			Исключение
				// iframe ещё не сформирован — следующий вызов после ДокументСформирован обработает
				Продолжить;
			КонецПопытки;
		КонецЕсли;

		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			ОбновитьШиринуИзображенийВКоллекции(Элемент.ПодчиненныеЭлементы, ШиринаКартинок);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Возвращает адрес ссылки из данных события нажатия поля HTML-документа.
//
// Свойство Href содержит адрес, разрешённый браузером относительно тэга base
// (то есть абсолютный адрес веб-клиента), поэтому при наличии элемента ссылки
// берётся исходное значение атрибута href.
//
// Параметры:
//   ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля HTML-документа.
//
// Возвращаемое значение:
//   Строка - адрес ссылки.
Функция АдресСсылкиИзДанныхСобытия(ДанныеСобытия)

	Адрес = "";

	Попытка
		Если ДанныеСобытия.Anchor <> Неопределено Тогда
			Адрес = ДанныеСобытия.Anchor.getAttribute("href");
		КонецЕсли;
	Исключение
		Адрес = "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Адрес = ДанныеСобытия.Href;
	КонецЕсли;

	Возврат Адрес;

КонецФункции

Функция ДокументHTMLДляЭлементаHTML(Элемент)
	Возврат Элемент.Документ.defaultView;
КонецФункции

// Разбирает имя команды присоединённого файла вида <Префикс><Идентификатор>_<ПутьКДанным>.
// Идентификатор и путь разделяются первым символом «_» после префикса, поэтому путь
// может сам содержать «_».
//
// Параметры:
//   ИмяКоманды - Строка - имя команды формы.
//   Префикс    - Строка - префикс имени команды с завершающим разделителем «_».
//
// Возвращаемое значение:
//   Массив из Строка, Число, Строка - позиции: текст идентификатора строки, идентификатор
//       строки как число, путь к данным без префикса; Неопределено, если имя команды
//       не соответствует формату.
//
Функция РазобратьИмяКомандыПрисоединенногоФайла(ИмяКоманды, Префикс)

	ОстатокИмени = СтрЗаменить(ИмяКоманды, Префикс, "");
	Если ОстатокИмени = ИмяКоманды Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(ОстатокИмени, "_");
	Если ПозицияРазделителя <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстИдентификатора = Лев(ОстатокИмени, ПозицияРазделителя - 1);
	ПутьКДанным = Сред(ОстатокИмени, ПозицияРазделителя + 1);
	Если ПустаяСтрока(ПутьКДанным) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ИдентификаторСтроки = Число(ТекстИдентификатора);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Результат = Новый Массив;
	Результат.Добавить(ТекстИдентификатора);
	Результат.Добавить(ИдентификаторСтроки);
	Результат.Добавить(ПутьКДанным);

	Возврат Результат;

КонецФункции

Функция ТекстКомментария(Форма, ПутьКДанным)
	МассивПути=СтрРазделить(ПутьКДанным, ".", Ложь);
	Если МассивПути.Количество() = 1 Тогда
		ТекстКомментария=Форма[МассивПути[0]];
	ИначеЕсли МассивПути.Количество() = 2 Тогда
		ТекстКомментария=Форма[МассивПути[0]][МассивПути[1]];
	Иначе
		ТекстКомментария="";
	КонецЕсли;
	
	Возврат ТекстКомментария;
КонецФункции

Процедура УстановитьТекстКомментария(Форма, ПутьКДанным, ТекстКомментария)
	МассивПути=СтрРазделить(ПутьКДанным, ".", Ложь);
	Если МассивПути.Количество() = 1 Тогда
		Форма[МассивПути[0]]=ТекстКомментария;
	ИначеЕсли МассивПути.Количество() = 2 Тогда
		Форма[МассивПути[0]][МассивПути[1]]=ТекстКомментария;
	Иначе
		
	КонецЕсли;	
КонецПроцедуры

Функция ТекущаяСтраницаПанелиРедактированияКомментария(Форма, ПутьКДанным)
	Возврат Форма.Элементы[ГКСИ_MarkdownКлиентСервер.ПолучитьИмяЭлементаПанелиСтраницРедактированияКомментария(ПутьКДанным)].ТекущаяСтраница;
КонецФункции

Процедура ОткрытьФормуСинтаксиса() Экспорт
	ОткрытьФорму("ОбщаяФорма.ГКСИ_MarkdownСинтаксис");
КонецПроцедуры

