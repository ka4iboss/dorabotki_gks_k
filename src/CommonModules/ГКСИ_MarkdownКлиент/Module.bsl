// Обновляет CSS-правило max-width для изображений во всех iframe
// просмотра Markdown на форме. Вызывается из обработчика
// изменения реквизита ШиринаКартинок.
//
// Параметры:
//   Форма - Произвольный - управляемая форма
//   ШиринаКартинок - Строка - CSS-значение max-width (например, "100%", "600px")
//
Процедура ОбновитьШиринуИзображений(Форма, ШиринаКартинок) Экспорт

	Если НЕ ЗначениеЗаполнено(ШиринаКартинок) Тогда
		ШиринаКартинок = "100%";
	КонецЕсли;

	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") И Элемент.Вид = ВидПоляФормы.ПолеHTMLДокумента Тогда
			Попытка
				ОкноДокумента = ДокументHTMLДляЭлементаHTML(Элемент);
				ОкноДокумента.setImageMaxWidth(ШиринаКартинок);
			Исключение
				// iframe ещё не сформирован — следующий вызов после ДокументСформирован обработает
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает адрес ссылки из данных события нажатия поля HTML-документа.
//
// Свойство Href содержит адрес, разрешённый браузером относительно тэга base
// (то есть абсолютный адрес веб-клиента), поэтому при наличии элемента ссылки
// берётся исходное значение атрибута href.
//
// Параметры:
//   ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля HTML-документа.
//
// Возвращаемое значение:
//   Строка - адрес ссылки.
Функция АдресСсылкиИзДанныхСобытия(ДанныеСобытия)

	Адрес = "";

	Попытка
		Если ДанныеСобытия.Anchor <> Неопределено Тогда
			Адрес = ДанныеСобытия.Anchor.getAttribute("href");
		КонецЕсли;
	Исключение
		Адрес = "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Адрес = ДанныеСобытия.Href;
	КонецЕсли;

	Возврат Адрес;

КонецФункции

Функция ДокументHTMLДляЭлементаHTML(Элемент)
	Возврат Элемент.Документ.defaultView;
КонецФункции

Функция ТекстКомментария(Форма, ПутьКДанным)
	МассивПути=СтрРазделить(ПутьКДанным, ".", Ложь);
	Если МассивПути.Количество() = 1 Тогда
		ТекстКомментария=Форма[МассивПути[0]];
	ИначеЕсли МассивПути.Количество() = 2 Тогда
		ТекстКомментария=Форма[МассивПути[0]][МассивПути[1]];
	Иначе
		ТекстКомментария="";
	КонецЕсли;
	
	Возврат ТекстКомментария;
КонецФункции

Процедура УстановитьТекстКомментария(Форма, ПутьКДанным, ТекстКомментария)
	МассивПути=СтрРазделить(ПутьКДанным, ".", Ложь);
	Если МассивПути.Количество() = 1 Тогда
		Форма[МассивПути[0]]=ТекстКомментария;
	ИначеЕсли МассивПути.Количество() = 2 Тогда
		Форма[МассивПути[0]][МассивПути[1]]=ТекстКомментария;
	Иначе
		
	КонецЕсли;	
КонецПроцедуры

