#Область ПрограммныйИнтерфейс

// Обработчик смены страницы панели редактирования комментария.
//
// Параметры:
//   Форма - Произвольный - форма
//   Элемент - Произвольный - элемент формы
//   ТекущаяСтраница - Произвольный - текущая страница
Процедура ПриСменеСтраницыПоляКомментария(Форма, Элемент, ТекущаяСтраница) Экспорт
	ПутьКДанным=ГКСИ_MarkdownКлиентСервер.ПолучитьПутьКДаннымПоИмениПанелиСтраниц(Элемент.Имя);
	
	ОбновитьПолеПросмотраПоляКомментария(Форма, ПутьКДанным);
КонецПроцедуры

// Обработчик команды поля комментария.
//
// Параметры:
//   Форма - Произвольный - форма
//   Команда - Произвольный - команда формы
Процедура ОбработкаКомандыПоляКомментария(Форма, Команда) Экспорт
	СтруктураСтрокMD=Новый Структура;
	СтруктураСтрокMD.Вставить("ТекстMDНачалоВыделения", "");
	СтруктураСтрокMD.Вставить("ТекстMDКонцаВыделения", "");
	СтруктураСтрокMD.Вставить("ТекстMDНачалоСтроки", "");
	СтруктураСтрокMD.Вставить("ТекстMDСтрокаДо", "");
	СтруктураСтрокMD.Вставить("ТекстMDСтрокаПосле", "");
	СтруктураСтрокMD.Вставить("ТекстЗамены", "");

	Если СтрНайти(Команда.Имя, "РМ_КомандаMDЖирный") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоВыделения = "**";
		СтруктураСтрокMD.ТекстMDКонцаВыделения = "**";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDЖирный_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDКурсив") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоВыделения = "*";
		СтруктураСтрокMD.ТекстMDКонцаВыделения = "*";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDКурсив_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDЗачеркнутый") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоВыделения = "~~";
		СтруктураСтрокMD.ТекстMDКонцаВыделения = "~~";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDЗачеркнутый_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDМаркерыСписок") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="* ";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDМаркерыСписок_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDНумерованныйСписок") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="1. ";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDНумерованныйСписок_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDЗаголовок1") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="# ";
		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDЗаголовок1_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDЗаголовок2") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="## ";
		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDЗаголовок2_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDЗаголовок3") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="### ";
		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDЗаголовок3_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDЦитата") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="> ";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDЦитата_";
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDСписокЗадач") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоСтроки="* [ ] ";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDСписокЗадач_";

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDСсылкаНаУзел") = 1 Тогда

		// Ветка обязана идти ДО общей ветки "РМ_КомандаMDСсылка": СтрНайти
		// проверяет только начало имени, поэтому общая ветка перехватывала бы
		// команду "РМ_КомандаMDСсылкаНаУзел_<ПутьКДанным>" и отрезала от имени
		// лишние символы — элемент формы искался бы под неверным именем.
		ПутьКДаннымБезЛишнего = СтрЗаменить(Команда.Имя, "РМ_КомандаMDСсылкаНаУзел_", "");

		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Форма", Форма);
		ПараметрыОткрытия.Вставить("ПутьКДаннымРедактирования", ПутьКДаннымБезЛишнего);
		ОбработчикЗавершения = Новый ОписаниеОповещения(
			"ГКСИ_Ссылки_ПослеВыбораУзла", ЭтотОбъект, ПараметрыОткрытия);

		// Форма выбора узла не принимает параметров открытия: параметры формы
		// объявляются в редакторе формы, а объявить их инструментами нельзя,
		// поэтому переданные значения до формы не доходят. Список всегда содержит
		// узлы всех инструкций, а фрагмент ссылки форма возвращает в результате.
		ОткрытьФорму("Catalog.ДемонстрационныеСценарии.Form.ГКСИ_ФормаВыбораГруппы",
			, Форма, , , , ОбработчикЗавершения);
		Возврат;

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDСсылка") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоВыделения = "[](";
		СтруктураСтрокMD.ТекстMDКонцаВыделения = ")";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDСсылка_";

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDВидео") = 1 Тогда
		// Вставка видео: !video(<путь>). На тонком клиенте путь выбирается
		// диалогом выбора файла, в веб-клиенте диалог недоступен - вставляется
		// пустой шаблон !video(), путь пользователь дописывает вручную.
		СтруктураСтрокMD.ТекстЗамены = "РМ_КомандаMDВидео_";

		#Если Не ВебКлиент Тогда
			ДиалогВыбораВидео = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
			ДиалогВыбораВидео.Заголовок = НСтр("ru = 'Выбор видеофайла'");
			ДиалогВыбораВидео.Фильтр = НСтр("ru = 'Видеофайлы (*.mp4,*.webm,*.ogg,*.mov,*.avi)|*.mp4;*.webm;*.ogg;*.mov;*.avi|Все файлы (*.*)|*.*'");
			Если Не ДиалогВыбораВидео.Выбрать() Тогда
				Возврат;
			КонецЕсли;
			СтруктураСтрокMD.ТекстMDНачалоВыделения = СтрШаблон("!video(%1)", ДиалогВыбораВидео.ПолноеИмяФайла);
		#Иначе
			СтруктураСтрокMD.ТекстMDНачалоВыделения = "!video(";
			СтруктураСтрокMD.ТекстMDКонцаВыделения = ")";
		#КонецЕсли

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDПрограммныйКод") = 1 Тогда
		СтруктураСтрокMD.ТекстMDНачалоВыделения = "```" + Символы.ПС;
		СтруктураСтрокMD.ТекстMDКонцаВыделения = Символы.ПС + "```";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDПрограммныйКод_";

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDТаблица") = 1 Тогда
		СтруктураСтрокMD.ТекстMDСтрокаПосле = "
											  || Заголовок колонки 1 | Заголовок колонки 2 |
											  || ------ | ------ |
											  || Текст ячейки | Текст ячейки |
											  || Текст ячейки | Текст ячейки |";

		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDТаблица_";

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDВставитьИзображениеИзБуфераОбмена") = 1 Тогда
		СтруктураСтрокMD.ТекстЗамены= "РМ_КомандаMDВставитьИзображениеИзБуфераОбмена_";
		
		ПутьКДаннымБезЛишнего=СтрЗаменить(Команда.Имя, СтруктураСтрокMD.ТекстЗамены, "");
		#Если Не ВебКлиент Тогда
			ДопПараметры=Новый Структура;
			ДопПараметры.Вставить("Форма",Форма);
			ДопПараметры.Вставить("Команда",Команда);
			ДопПараметры.Вставить("ПутьКДаннымБезЛишнего",ПутьКДаннымБезЛишнего);
			ДопПараметры.Вставить("СтруктураСтрокMD",СтруктураСтрокMD);
			ГКСИ_БуферОбменаКлиент.НачатьПолучениеКартинкиИзБуфера(Новый ОписаниеОповещения("КомандаMDВставитьИзображениеИзБуфераОбменаЗавершение",ЭтотОбъект,ДопПараметры),"ДвоичныеДанные");
			Возврат;	
		#КонецЕсли
	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDДобавитьФайл") = 1 Тогда

		ПараметрыВыполнения = Новый Структура;
		ПараметрыВыполнения.Вставить("ФормаВладелец", Форма);
		ПараметрыВыполнения.Вставить("ПутьКДаннымБезЛишнего", СтрЗаменить(Команда.Имя, "РМ_КомандаMDДобавитьФайл_", ""));
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Обработчик = Новый ОписаниеОповещения("ДобавитьИзФайловойСистемыБезРасширенияПослеЗагрузкиФайла", ЭтотОбъект,
			ПараметрыВыполнения);
		//@skip-warning НачатьПомещениеФайла помечен платформой как устаревший,
		//актуальный аналог ПоместитьФайлНаСерверАсинх требует переделки сигнатуры обработчика
		//и переноса точки вызова в async-контекст.
		НачатьПомещениеФайла(Обработчик, , ДиалогВыбора, , Форма.УникальныйИдентификатор);

		Возврат;

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_ВставитьПрисоединенныйФайл") = 1 Тогда
		ПараметрыКоманды = РазобратьИмяКомандыПрисоединенногоФайла(Команда.Имя, "РМ_ВставитьПрисоединенныйФайл_");
		Если ПараметрыКоманды = Неопределено Тогда
			Возврат;
		КонецЕсли;

		СтруктураСтрокMD.ТекстЗамены = "РМ_ВставитьПрисоединенныйФайл_" + ПараметрыКоманды[0] + "_";

		ИмяТаблицыФайлов = ГКСИ_MarkdownКлиентСервер.ИмяТаблицыПрисоединенныхФайлов(ПараметрыКоманды[2]);

		СтрокаФайла = Форма[ИмяТаблицыФайлов].НайтиПоИдентификатору(ПараметрыКоманды[1]);
		Если СтрокаФайла = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ИмяФайла = СтрокаФайла.ИмяФайла;

		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			СтруктураСтрокMD.ТекстMDНачалоВыделения = СтрШаблон("![](%1)", ИмяФайла);
		КонецЕсли;

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDОткрытьСинтаксис") = 1 Тогда
		ОткрытьФормуСинтаксиса();
		Возврат;

	ИначеЕсли СтрНайти(Команда.Имя, "РМ_КомандаMDГлоссарий") = 1 Тогда
		ПутьКДаннымБезЛишнего = СтрЗаменить(Команда.Имя, "РМ_КомандаMDГлоссарий_", "");
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ПутьКДаннымРедактирования", ПутьКДаннымБезЛишнего);
		ОбработчикЗавершения = Новый ОписаниеОповещения(
			"ГКСИ_Глоссарий_ПослеВыбораТермина", ЭтотОбъект, ПараметрыОткрытия);
		ОткрытьФорму("CommonForm.ГКСИ_ВыборТерминаГлоссария",
			Новый Структура("МассивОбъектовКонфигурации", Неопределено),
			Форма, , , , ОбработчикЗавершения);
		Возврат;

	Иначе
		Возврат;
	КонецЕсли;

	ВыполнитьЗаменуВТекстеКомментарияПоСтруктуреЗамены(Форма, Команда.Имя,СтруктураСтрокMD);
КонецПроцедуры

// Обработчик завершения выбора термина глоссария из формы CommonForm.ГКСИ_ВыборТерминаГлоссария.
// Подставляет markdown-ссылку на термин в позицию курсора поля редактирования.
//
// Параметры:
//   Результат - Строка - выбранный термин глоссария.
//   ПараметрыВыполнения - Структура - параметры вызова: Форма, ПутьКДаннымРедактирования.
Процедура ГКСИ_Глоссарий_ПослеВыбораТермина(Результат, ПараметрыВыполнения) Экспорт

	Если ТипЗнч(Результат) <> Тип("Строка") ИЛИ ПустаяСтрока(Результат) Тогда
		Возврат;
	КонецЕсли;

	Форма = ПараметрыВыполнения.Форма;
	ПутьКДаннымБезЛишнего = ПараметрыВыполнения.ПутьКДаннымРедактирования;
	ИмяЭлемента = ГКСИ_MarkdownКлиентСервер.ПрефиксЭлементовФормы() + ПутьКДаннымБезЛишнего;
	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вставка = ГКСИ_MarkdownСерверВызовСервера.ФрагментСсылкиНаТерминГлоссария(Результат);
	Если ПустаяСтрока(Вставка) Тогда
		Возврат;
	КонецЕсли;

	Форма.ТекущийЭлемент = Элемент;
	Элемент.ВыделенныйТекст = Вставка;

КонецПроцедуры

// Обработчик завершения выбора узла для вики-ссылки [[...]].
// Подставляет фрагмент ссылки в позицию курсора поля редактирования.
//
// Параметры:
//   Результат - Структура, Неопределено - результат формы
//               Catalog.ДемонстрационныеСценарии.Form.ГКСИ_ФормаВыбораГруппы
//               (Ссылка, ЭтоГруппа, Фрагмент) или Неопределено при отказе от выбора.
//   ПараметрыВыполнения - Структура - параметры вызова: Форма, ПутьКДаннымРедактирования.
Процедура ГКСИ_Ссылки_ПослеВыбораУзла(Результат, ПараметрыВыполнения) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		// Форма закрыта без выбора — подставлять нечего.
		Возврат;
	КонецЕсли;

	ФрагментСсылки = "";
	Результат.Свойство("Фрагмент", ФрагментСсылки);
	Если ПустаяСтрока(ФрагментСсылки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для выбранного узла ссылку сформировать не удалось.'"));
		Возврат;
	КонецЕсли;

	Форма = ПараметрыВыполнения.Форма;
	ПутьКДаннымБезЛишнего = ПараметрыВыполнения.ПутьКДаннымРедактирования;
	ИмяЭлемента = ГКСИ_MarkdownКлиентСервер.ПрефиксЭлементовФормы() + ПутьКДаннымБезЛишнего;
	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Форма.ТекущийЭлемент = Элемент;
	Элемент.ВыделенныйТекст = ФрагментСсылки;

КонецПроцедуры

// Обработчик нажатия в поле просмотра комментария: открывает присоединённый файл или внешнюю ссылку.
//
// Параметры:
//   Форма - Произвольный - форма.
//   Элемент - Произвольный - элемент формы (поле HTML).
//   ДанныеСобытия - Произвольный - данные события нажатия.
//   СтандартнаяОбработка - Булево - признак стандартной обработки.
Процедура ПриНажатииПоляПросмотраКомментария(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка=Ложь;

	ПутьКВидео = ПутьВидеоИзДанныхСобытия(ДанныеСобытия);
	Если Не ПустаяСтрока(ПутьКВидео) Тогда
		// Запасная ссылка под HTML5-плеером: встроенное воспроизведение
		// недоступно — открываем файл системным проигрывателем.
		НачатьЗапускПриложения(ПустоеОписаниеОповещенияДляЗапускаПриложения(), ПутьКВидео);
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеСобытия.Href) Тогда
		Адрес = АдресСсылкиИзДанныхСобытия(ДанныеСобытия);
		Если СтрНачинаетсяС(НРег(Адрес), "e1cib") Тогда
			// Вики-ссылка [[Имя]] на группу или шаг демонстрационного сценария:
			// открываем объект штатным переходом по навигационной ссылке.
			ПерейтиПоНавигационнойСсылке(Адрес);
		ИначеЕсли НЕ ОткрытьШагИзДанныхСобытия(ДанныеСобытия, Форма.УникальныйИдентификатор) Тогда
			// НачатьЗапускПриложения принимает строку команды ОС: адрес file://
			// нужно вернуть к обычному пути, иначе платформа сообщает
			// «Неверно задана навигационная ссылка».
			НачатьЗапускПриложения(ПустоеОписаниеОповещенияДляЗапускаПриложения(),
				ПутьДляЗапускаПриложения(Адрес));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Возвращает путь к видеофайлу из данных события нажатия по запасной ссылке
// видеоплеера (атрибут data-gksi-video, формируется в модуле ГКСИ_Видео).
//
// Параметры:
//   ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля
//                   HTML-документа.
//
// Возвращаемое значение:
//   Строка - путь к видеофайлу; пустая строка, если нажатие не по ссылке видео.
//
Функция ПутьВидеоИзДанныхСобытия(ДанныеСобытия) Экспорт

	Если ДанныеСобытия = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Если ДанныеСобытия.Anchor <> Неопределено Тогда
			ЗначениеАтрибута = ДанныеСобытия.Anchor.getAttribute("data-gksi-video");
			Если ТипЗнч(ЗначениеАтрибута) = Тип("Строка") Тогда
				Возврат СокрЛП(ЗначениеАтрибута);
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Поле Anchor недоступно в данных события - считаем, что нажатия по видео нет.
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

//
// НачатьЗапускПриложения принимает строку команды ОС, а не URL: адрес file://
// нужно вернуть к обычному пути (R:\… или \\server\share\…). Прочие адреса
// (http(s), относительные) возвращаются как есть.
//
// Параметры:
//   Адрес - Строка - адрес из атрибута href ссылки.
//
// Возвращаемое значение:
//   Строка - путь для запуска приложения.
//
Функция ПутьДляЗапускаПриложения(Адрес) Экспорт

	Результат = СокрЛП(Адрес);
	НРегАдрес = НРег(Результат);

	Если СтрНачинаетсяС(НРегАдрес, "file:///") Тогда
		// file:///R:/a.mp4 -> R:\a.mp4
		Результат = Сред(Результат, СтрДлина("file:///") + 1);
	ИначеЕсли СтрНачинаетсяС(НРегАдрес, "file://") Тогда
		// file://server/share/a.html -> \\server\share\a.html
		Результат = "\\" + Сред(Результат, СтрДлина("file://") + 1);
	Иначе
		Возврат Результат;
	КонецЕсли;

	Возврат СтрЗаменить(Результат, "/", "\");

КонецФункции

// Открывает файл по ссылке поля HTML-документа системным приложением.
//
// Нужна для типовых HTML-полей (ТекстСценария / ТекстСценарияЧтение): их
// стандартная обработка пытается перейти по href как по навигационной ссылке и
// на адресе file:// выдаёт «Неверно задана навигационная ссылка». Ссылки
// http(s) и e1cib этой функцией не обрабатываются — их отдаём платформе.
//
// Параметры:
//   ДанныеСобытия                 - ФиксированнаяСтруктура - данные события ПриНажатии поля
//                                   HTML-документа.
//   УникальныйИдентификаторФормы - УникальныйИдентификатор, Неопределено -
//                                   идентификатор формы для временного хранилища.
//
// Возвращаемое значение:
//   Булево - Истина, если нажатие обработано.
//
Функция ОткрытьФайлИзДанныхСобытия(ДанныеСобытия, УникальныйИдентификаторФормы = Неопределено) Экспорт

	Если ДанныеСобытия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Адрес = АдресСсылкиИзДанныхСобытия(ДанныеСобытия);
	Если ЗначениеЗаполнено(Адрес) И СтрНачинаетсяС(НРег(СокрЛП(Адрес)), "file:") Тогда
		НачатьЗапускПриложения(ПустоеОписаниеОповещенияДляЗапускаПриложения(),
			ПутьДляЗапускаПриложения(Адрес));
		Возврат Истина;
	КонецЕсли;

	// Файл описания шага может лежать в информационной базе или в томе,
	// недоступном клиенту: скачиваем его во временный каталог и открываем копию.
	Возврат ОткрытьШагИзДанныхСобытия(ДанныеСобытия, УникальныйИдентификаторФормы);

КонецФункции

// Открывает шаг инструкции по ссылке «Открыть в браузере» под плеером видео.
//
// Файл шага может лежать в информационной базе или в томе, недоступном клиенту,
// поэтому он скачивается во временный каталог клиента и открывается локальной
// копией. Идентификатор файла берётся из атрибута data-gksi-step-file, который
// пишет ГКСИ_Видео.ПодставитьСсылкуНаФайлОписания.
//
// Параметры:
//   ДанныеСобытия                 - ФиксированнаяСтруктура - данные события нажатия
//                                   поля HTML-документа.
//   УникальныйИдентификаторФормы - УникальныйИдентификатор, Неопределено -
//                                   идентификатор формы для временного хранилища.
//
// Возвращаемое значение:
//   Булево - Истина, если нажатие обработано.
//
Функция ОткрытьШагИзДанныхСобытия(ДанныеСобытия, УникальныйИдентификаторФормы = Неопределено) Экспорт

	ИдентификаторФайла = АтрибутСсылкиИзДанныхСобытия(ДанныеСобытия, "data-gksi-step-file");
	Если ПустаяСтрока(ИдентификаторФайла) Тогда
		Возврат Ложь;
	КонецЕсли;

	СведенияОФайле = ГКСИ_MarkdownСерверВызовСервера.АдресФайлаОписанияДляОткрытия(
		ИдентификаторФайла, УникальныйИдентификаторФормы);
	Если СведенияОФайле = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось прочитать файл описания шага.'"));
		Возврат Истина;
	КонецЕсли;

	АдресФайла = СведенияОФайле[0];
	ИмяФайла   = СведенияОФайле[1];

	Каталог = КаталогВременныхФайлов();
	ПутьКФайлу = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + ИмяФайла;

	ДополнительныеПараметры = Новый Структура("ПутьКФайлу", ПутьКФайлу);
	Оповещение = Новый ОписаниеОповещения("ПолучениеФайлаШагаЗавершение", ЭтотОбъект,
		ДополнительныеПараметры);
	НачатьПолучениеФайлаССервера(Оповещение, АдресФайла, ПутьКФайлу);

	Возврат Истина;

КонецФункции

// Открывает скачанный файл шага системным приложением.
//
// Параметры:
//   ПолученныйФайл           - ОписаниеПереданногоФайла, Неопределено - результат скачивания.
//   ДополнительныеПараметры  - Структура - ПутьКФайлу - путь локальной копии файла.
//
Процедура ПолучениеФайлаШагаЗавершение(ПолученныйФайл, ДополнительныеПараметры) Экспорт

	Если ПолученныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачатьЗапускПриложения(ПустоеОписаниеОповещенияДляЗапускаПриложения(),
		ДополнительныеПараметры.ПутьКФайлу);

КонецПроцедуры

// Открывает присоединённый файл по команде формы.
//
// Параметры:
//   Форма - Произвольный - форма.
//   Команда - Произвольный - команда формы.
Процедура ОткрытьПрисоединенныйФайл(Форма, Команда) Экспорт

	ПараметрыКоманды = РазобратьИмяКомандыПрисоединенногоФайла(Команда.Имя, "РМ_ОткрытьПрисоединенныйФайл_");
	Если ПараметрыКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяТаблицыФайлов = ГКСИ_MarkdownКлиентСервер.ИмяТаблицыПрисоединенныхФайлов(ПараметрыКоманды[2]);
	СтрокаФайла = Форма[ИмяТаблицыФайлов].НайтиПоИдентификатору(ПараметрыКоманды[1]);
	Если СтрокаФайла = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаФайла.ПутьКФайлу) Тогда
		Возврат;
	КонецЕсли;

	НачатьЗапускПриложения(ПустоеОписаниеОповещенияДляЗапускаПриложения(), СтрокаФайла.ПутьКФайлу);

КонецПроцедуры

// Удаляет строку нового присоединённого файла и скрывает связанные элементы формы.
//
// Параметры:
//   Форма - Произвольный - форма.
//   Команда - Произвольный - команда формы.
Процедура УдалитьНовыйПрисоединенныйФайл(Форма, Команда) Экспорт

	ПараметрыКоманды = РазобратьИмяКомандыПрисоединенногоФайла(Команда.Имя, "РМ_УдалитьПрисоединенныйФайл_");
	Если ПараметрыКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = ПараметрыКоманды[1];
	ПутьКДаннымБезЛишнего = ПараметрыКоманды[2];

	Элементы = Форма.Элементы;

	ИмяГруппыФайла=ГКСИ_MarkdownКлиентСервер.ИмяГруппыНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего,
		ИдентификаторСтроки);
	ГруппаПрисоединенногоФайла = Элементы.Найти(ИмяГруппыФайла);
	Если ГруппаПрисоединенногоФайла <> Неопределено Тогда
		ГруппаПрисоединенногоФайла.Видимость = Ложь;
	КонецЕсли;

	ИмяТаблицыПрисоединенныхФайлов=ГКСИ_MarkdownКлиентСервер.ИмяТаблицыПрисоединенныхФайлов(ПутьКДаннымБезЛишнего);
	СтрокаФайла = Форма[ИмяТаблицыПрисоединенныхФайлов].НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаФайла <> Неопределено Тогда
		СтрокаФайла.ПутьКФайлу = "";
		СтрокаФайла.ИмяФайла = "";
		СтрокаФайла.Адрес = "";
	КонецЕсли;
	
	//Делаем невидимым кнопку вставить
	ИмяКомандыВставить=ГКСИ_MarkdownКлиентСервер.ИмяКомандыВставитьНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего,
		ИдентификаторСтроки);
	КнопкаВставить=Элементы.Найти(ИмяКомандыВставить);
	Если КнопкаВставить <> Неопределено Тогда
		КнопкаВставить.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

// Обработчик завершения формирования документа поля просмотра комментария.
//
// Параметры:
//   Форма - Произвольный - форма
//   Элемент - Произвольный - элемент формы
Процедура ДокументСформированПоляПросмотраКомментария(Форма, Элемент) Экспорт
	//Устанавливаем ссылку на текущую базу для возможности всегда использовать
	УстановитьНавигационнуюСсылкуВТэгBaseПоляHTML(Элемент);
	
	ПутьКДанным=ГКСИ_MarkdownКлиентСервер.ПолучитьПутьКДаннымПоИмениПоляПросмотра(Элемент.Имя);
	
	ОбновитьПолеПросмотраПоляКомментария(Форма, ПутьКДанным);
КонецПроцедуры

// Заменяет коды файлов на base64 data URI, используя реквизит формы "ФайлыBase64".
//
// Параметры:
//   Текст - Строка - исходный текст Markdown
//   Форма - Произвольный - форма, содержащая реквизит ФайлыBase64 (ТаблицаЗначений с колонками Код и Base64)
//
// Возвращаемое значение:
//   Строка - текст Markdown с заменёнными кодами файлов на base64 data URI
Функция ЗаменитьКодыФайловНаBase64(Текст, Форма) Экспорт

	Попытка
		ФайлыBase64 = Форма.ФайлыBase64;
	Исключение
		// Форма без реквизита ФайлыBase64 - заменять нечего.
		Возврат Текст;
	КонецПопытки;

	Для Каждого СтрокаФайла Из ФайлыBase64 Цикл
		Код = СтрокаФайла.Код;
		Base64Data = СтрокаФайла.Base64;
		// Поддержка обоих форматов вставки: "(Код)" и "![](Код)"
		Текст = СтрЗаменить(Текст, "(" + Код + ")", "(" + Base64Data + ")");
		Текст = СтрЗаменить(Текст, "![](" + Код + ")", "![](" + Base64Data + ")");
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Обновляет поле просмотра комментария: подставляет текст и присоединённые файлы.
//
// Параметры:
//   Форма - Произвольный - форма.
//   ПутьКДанным - Строка - путь к данным поля комментария.
Процедура ОбновитьПолеПросмотраПоляКомментария(Форма, ПутьКДанным) Экспорт
	ПутьКДаннымБезЛишнего=ГКСИ_MarkdownКлиентСервер.ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным);
	ТекущаяСтраница=ТекущаяСтраницаПанелиРедактированияКомментария(Форма, ПутьКДанным);
	
	Если ТекущаяСтраница = Форма.Элементы[ГКСИ_MarkdownКлиентСервер.ПолучитьИмяСтраницыПросмотраКомментария(ПутьКДанным)] Тогда

		ТекстДляПросмотра = ТекстКомментария(Форма, ПутьКДанным);

		ДанныеПрисоединенныхФайлов = ГКСИ_MarkdownКлиентСервер.ДанныеПрисоединенныхФайлов(Форма, ПутьКДаннымБезЛишнего);

		ТекстДляПросмотра = ГКСИ_MarkdownКлиентСервер.СконвертироватьИменаПрисоединенныхФайловВТексте(ДанныеПрисоединенныхФайлов,
    ТекстДляПросмотра);
		ТекстДляПросмотра = ЗаменитьКодыФайловНаBase64(ТекстДляПросмотра, Форма);	
			
		ЭлементПросмотраКомментария=Форма.Элементы[ГКСИ_MarkdownКлиентСервер.ПолучитьИмяЭлементаПросмотраКомментария(ПутьКДанным)];
		
		ОчиститьТекстыПоляHTML(ЭлементПросмотраКомментария);
		ДобавитьТекстВТекстыПоляHTML(ЭлементПросмотраКомментария,"preview",ТекстДляПросмотра);
		СконвертироватьТекстыВHTML(ЭлементПросмотраКомментария);
	КонецЕсли;
КонецПроцедуры

// Добавляет текст в поле HTML под указанным ключом.
//
// Параметры:
//   Элемент - Произвольный - элемент формы (поле HTML).
//   Ключ - Строка - ключ текста.
//   Текст - Строка - добавляемый текст.
Процедура ДобавитьТекстВТекстыПоляHTML(Элемент, Ключ, Текст) Экспорт
	Документ=ДокументHTMLДляЭлементаHTML(Элемент);
	Документ.addText(Ключ, Текст);
КонецПроцедуры

// Удаляет текст из поля HTML по ключу.
//
// Параметры:
//   Элемент - Произвольный - элемент формы (поле HTML).
//   Ключ - Строка - ключ текста.
Процедура УдалитьТекстПоляКомментария(Элемент, Ключ) Экспорт
	Документ=ДокументHTMLДляЭлементаHTML(Элемент);
	Документ.deleteText(Ключ);
	
КонецПроцедуры

// Очищает все тексты поля HTML.
//
// Параметры:
//   Элемент - Произвольный - элемент формы (поле HTML).
Процедура ОчиститьТекстыПоляHTML(Элемент) Экспорт
	Документ=ДокументHTMLДляЭлементаHTML(Элемент);
	Документ.clearTexts();
КонецПроцедуры

// Конвертирует тексты поля HTML в HTML.
//
// Параметры:
//   Элемент - Произвольный - элемент формы (поле HTML).
Процедура СконвертироватьТекстыВHTML(Элемент) Экспорт
	Документ=ДокументHTMLДляЭлементаHTML(Элемент);
	Документ.markdownConvert();
КонецПроцедуры

// Добавляет новый присоединённый файл в таблицу файлов формы.
//
// Параметры:
//   ИмяФайла - Строка - имя файла.
//   ПутьКФайлу - Строка - путь к файлу.
//   Форма - Произвольный - форма.
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без служебных префиксов.
//   Адрес - Строка, Неопределено - адрес файла во временном хранилище.
Процедура ДобавитьНовыйПрисоединенныйФайл(ИмяФайла, ПутьКФайлу, Форма, ПутьКДаннымБезЛишнего, Адрес = Неопределено) Экспорт

	Если Адрес = Неопределено Тогда
		Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу), Форма.УникальныйИдентификатор);
	КонецЕсли;

	ИмяТаблицыФайлов=ГКСИ_MarkdownКлиентСервер.ИмяТаблицыПрисоединенныхФайлов(ПутьКДаннымБезЛишнего);

	СтрокаПрисоединенногоФайла = Форма[ИмяТаблицыФайлов].Добавить();
	СтрокаПрисоединенногоФайла.ПутьКФайлу = ПутьКФайлу;
	СтрокаПрисоединенногоФайла.ИмяФайла = ИмяФайла;
	СтрокаПрисоединенногоФайла.Адрес = Адрес;
	СтрокаПрисоединенногоФайла.ЭтоНовый = Истина;

	Форма.РМ_Подключаемый_ПриДобавленииПрисоединенногоФайла(ИмяФайла, СтрокаПрисоединенногоФайла.ПолучитьИдентификатор(),
		ПутьКДаннымБезЛишнего);

КонецПроцедуры

// Возвращает HTML по тексту Markdown через поле HTML.
//
// Параметры:
