// Общий модуль ГКСИ_ВыгрузкаСценариевВMarkdownДлительныеОперации.
//
// Серверная точка входа для запуска длительной операции подготовки файлов
// выгрузки сценариев в Markdown в фоновом задании.
//
// Контракт вызова задается библиотекой ДлительныеОперации:
// при вызове ДлительныеОперации.ВыполнитьВФоне(ИмяПроцедуры, ПараметрыПроцедуры, ...)
// БСП оборачивает переданное ПараметрыПроцедуры в массив первым элементом
// и добавляет вторым элементом АдресРезультата. Поэтому фактическая сигнатура
// вызываемой процедуры всегда:
//
//     ПодготовитьФайлыФоново(ПараметрыЗадания, АдресРезультата)
//
// Первый аргумент — это ровно то значение, которое было передано вторым
// параметром в ВыполнитьВФоне (например, Структура с полями).
// Второй аргумент — служебный адрес ВХ, которым управляет БСП.

#Область СлужебныйПрограммныйИнтерфейс

// Готовит файлы выгрузки сценариев в фоновом задании.
//
// Параметры:
//  ПараметрыЗадания - Структура - входные данные:
//    * МассивКорней          - Массив из СправочникСсылка.ДемонстрационныеСценарии.
//    * КодЯзыка              - Строка - код выгружаемого языка (например, "ru").
//    * АдресПрогресса        - Строка - адрес ВХ прогресса
//                                     (см. ГКСИ_ЗагрузкаСценариевИзMarkdown.ИнициализироватьПрогресс).
//    * АдресРезультатаВыгрузки - Строка - адрес ВХ, по которому будет размещен результат
//                                     (см. ГКСИ_ВыгрузкаСценариевВMarkdown.ПодготовитьФайлыКВыгрузке).
//  АдресРезультата  - Строка - служебный адрес ВХ, дорисованный БСП.
//                              В этой схеме не используется, результат читается
//                              клиентом по адресу из АдресРезультатаВыгрузки,
//                              но параметр обязателен по контракту.
//
Процедура ПодготовитьФайлыФоново(ПараметрыЗадания, АдресРезультата) Экспорт

	АдресПрогресса = "";

	Попытка

		Если ТипЗнч(ПараметрыЗадания) <> Тип("Структура") Тогда
			ВызватьИсключение "Неожиданный тип параметров: "
				+ ТипЗнч(ПараметрыЗадания) + ", ожидалась Структура";
		КонецЕсли;

		АдресПрогресса = ПараметрыЗадания.АдресПрогресса;

		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса, 1, 0, 1,
			НСтр("ru = 'Запуск выгрузки сценариев'"));

		РезультатВыгрузки = ГКСИ_ВыгрузкаСценариевВMarkdown.ПодготовитьФайлыКВыгрузке(
			ПараметрыЗадания.МассивКорней,
			ПараметрыЗадания.КодЯзыка,
			АдресПрогресса);

		ПоместитьВоВременноеХранилище(РезультатВыгрузки,
			ПараметрыЗадания.АдресРезультатаВыгрузки);

		// Этап 4 завершает прогресс (см. ПроцентГотовности в модуле загрузки).
		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса, 4, 1, 1,
			НСтр("ru = 'Выгрузка завершена'"));

	Исключение

		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ГКСИ.ВыгрузкаСценариевВMarkdown.ФоновоеЗадание",
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса, 0, 0, 0,
			НСтр("ru = 'Ошибка выполнения'"), Истина, ТекстОшибки);

	КонецПопытки;

КонецПроцедуры

#КонецОбласти
