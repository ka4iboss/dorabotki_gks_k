#Область ПрограммныйИнтерфейс

// Возвращает список типов объектов, для которых доступен просмотр версий.
// В список включаются типы обоих механизмов версионирования:
//  - типы, для которых включено версионирование объектов (регистр сведений НастройкиВерсионированияОбъектов)
//    и которые поддерживаются измерением "Объект" регистра сведений ВерсииОбъектов;
//  - типы, для которых в метаданных включена платформенная история данных
//    (свойство "История данных" = Использовать).
// Учитываются типы как основной конфигурации, так и расширений конфигурации.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * ТипОбъекта    - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                     СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных;
//   * ПолноеИмя     - Строка - полное имя объекта метаданных, например "Справочник.Номенклатура";
//   * Представление - Строка - представление типа объекта для выбора пользователем.
//
Функция ВерсионируемыеОбъекты() Экспорт
	
	Результат = НоваяТаблицаТиповОбъектов();
	
	ЗаполнитьТипыВерсионированияОбъектов(Результат);
	ЗаполнитьТипыИсторииДанных(Результат);
	
	Результат.Сортировать("ПолноеИмя");
	
	Возврат Результат;
	
КонецФункции

// Возвращает вид списка данных для типа объекта.
//
// Параметры:
//  ТипОбъекта - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//               СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных.
//
// Возвращаемое значение:
//  Строка - вид списка данных: "Ссылки" - список ссылок на объекты (динамический список формы),
//           "ЗаписиРегистра" - список записей регистра сведений (таблица значений формы),
//           "" - тип не распознан или просмотр версий для него не поддерживается.
//
Функция ВидСпискаТипаОбъекта(ТипОбъекта) Экспорт
	
	ПолноеИмя = ПолноеИмяТипаОбъекта(ТипОбъекта);
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрНачинаетсяС(ПолноеИмя, "РегистрСведений.") Тогда
		Возврат "ЗаписиРегистра";
	КонецЕсли;
	
	Возврат "Ссылки";
	
КонецФункции

// Возвращает список записей регистра сведений, для которых сохранены версии истории данных.
//
// Параметры:
//  ТипОбъекта   - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                 СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных;
//  СтрокаПоиска - Строка - подстрока для поиска по представлению записи, пустая строка - без отбора;
//  Максимум     - Число - максимальное количество просматриваемых версий истории данных, 0 - без ограничения.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Отметка      - Булево - признак отметки записи для пакетной обработки (заполняется на форме);
//   * Запись       - Строка - значения ключа записи, упакованные ЗначениеВСтрокуВнутр;
//   * Наименование - Строка - представление записи регистра.
//
Функция СписокЗаписейРегистра(ТипОбъекта, СтрокаПоиска = "", Максимум = 0) Экспорт
	
	Результат = НоваяТаблицаЗаписейРегистра();
	
	ОбъектМетаданных = ОбъектМетаданныхВерсионируемогоТипа(ТипОбъекта);
	Если Не ЭтоРегистрСведений(ОбъектМетаданных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Версии = ВерсииИсторииДанныхПоМетаданным(ОбъектМетаданных, "Данные, ПредставлениеДанных", "Дата Убыв, НомерВерсии Убыв", Максимум);
	Если Версии = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НайденныеЗаписи = Новый Соответствие;
	
	Для Каждого СтрокаВерсии Из Версии Цикл
		
		КлючЗаписи = СтрокаВерсии.Данные;
		Если КлючЗаписи = Неопределено Или КлючЗаписи = Null Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьСтрокой = ЗаписьСтрокойКлючаЗаписи(ОбъектМетаданных, КлючЗаписи);
		Если ПустаяСтрока(ЗаписьСтрокой) Или НайденныеЗаписи.Получить(ЗаписьСтрокой) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Представление = СокрЛП(Строка(СтрокаВерсии.ПредставлениеДанных));
		Если Не ПустаяСтрока(СтрокаПоиска) И СтрНайти(ВРег(Представление), ВРег(СтрокаПоиска)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденныеЗаписи.Вставить(ЗаписьСтрокой, Истина);
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Отметка = Ложь;
		НоваяСтрока.Запись = ЗаписьСтрокой;
		НоваяСтрока.Наименование = Лев(Представление, 200);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Восстанавливает ключ записи регистра сведений по строке, полученной функцией СписокЗаписейРегистра.
//
// Параметры:
//  ТипОбъекта     - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                   СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных;
//  ЗаписьСтрокой  - Строка - значения ключа записи, упакованные ЗначениеВСтрокуВнутр.
//
// Возвращаемое значение:
//  Произвольный - ключ записи регистра сведений; Неопределено - ключ не восстановлен.
//                                                                    Неопределено - ключ не восстановлен.
//
Функция ДанныеПоЗаписиСтрокой(ТипОбъекта, ЗаписьСтрокой) Экспорт
	
	Если ПустаяСтрока(ЗаписьСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектМетаданных = ОбъектМетаданныхВерсионируемогоТипа(ТипОбъекта);
	Если Не ЭтоРегистрСведений(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЗначенияКлюча = ЗначениеИзСтрокиВнутр(ЗаписьСтрокой);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ЗначенияКлюча) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МенеджерРегистра = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СокрЛП(ОбъектМетаданных.ПолноеИмя()));
	Если МенеджерРегистра = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат МенеджерРегистра.СоздатьКлючЗаписи(ЗначенияКлюча);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Возвращает номера версий истории данных для записей регистра сведений.
//
// Параметры:
//  ТипОбъекта     - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                   СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных;
//  СписокЗаписей  - Массив из Строка - значения ключей записей, упакованные ЗначениеВСтрокуВнутр;
//  ТипВерсии      - Строка - вид версии: "Текущая", "Прошлая" или "Первая".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - Строка - значения ключа записи, упакованные ЗначениеВСтрокуВнутр;
//   * Значение - Число, Неопределено - номер версии, Неопределено - версия не найдена.
//
Функция НомераВерсийЗаписейПоТипу(ТипОбъекта, СписокЗаписей, ТипВерсии) Экспорт
	
	Результат = Новый Соответствие;
	
	Если СписокЗаписей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ОбъектМетаданныхВерсионируемогоТипа(ТипОбъекта);
	Если Не ЭтоРегистрСведений(ОбъектМетаданных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Версии = ВерсииИсторииДанныхПоМетаданным(ОбъектМетаданных, "Данные, НомерВерсии", "НомерВерсии");
	Если Версии = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	НомераПоЗаписям = Новый Соответствие;
	
	Для Каждого СтрокаВерсии Из Версии Цикл
		
		КлючЗаписи = СтрокаВерсии.Данные;
		Если КлючЗаписи = Неопределено Или КлючЗаписи = Null Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьСтрокой = ЗаписьСтрокойКлючаЗаписи(ОбъектМетаданных, КлючЗаписи);
		Если ПустаяСтрока(ЗаписьСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НомераПоЗаписям.Получить(ЗаписьСтрокой) = Неопределено Тогда
			НомераПоЗаписям.Вставить(ЗаписьСтрокой, Новый Массив);
		КонецЕсли;
		НомераПоЗаписям[ЗаписьСтрокой].Добавить(СтрокаВерсии.НомерВерсии);
		
	КонецЦикла;
	
	Для Каждого ЗаписьСтрокой Из СписокЗаписей Цикл
		Результат.Вставить(ЗаписьСтрокой, НомерВерсииИзСписка(НомераПоЗаписям.Получить(ЗаписьСтрокой), ТипВерсии));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает список объектов указанного типа с количеством сохранённых версий.
//
// Параметры:
//  ТипОбъекта      - СправочникСсылка.ИдентификаторыОбъектовМетаданных - тип объекта метаданных;
//  СтрокаПоиска    - Строка - подстрока для поиска по наименованию или коду объекта, пустая строка - без отбора;
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры, Неопределено - вид номенклатуры для отбора;
//                    пустая ссылка или Неопределено - без отбора; учитывается, только если у типа объекта
//                    есть реквизит "ВидНоменклатуры";
//  Максимум        - Число - максимальное количество возвращаемых объектов, 0 - без ограничения.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Отметка          - Булево - признак отметки объекта для пакетной обработки;
//   * Объект           - СправочникСсылка - ссылка на объект;
//   * Наименование     - Строка - наименование (или код) объекта;
//   * КоличествоВерсий - Число - количество версий, изменённых пользователем.
//
Функция СписокОбъектовТипа(ТипОбъекта, СтрокаПоиска = "", ВидНоменклатуры = Неопределено, Максимум = 0) Экспорт
	
	Результат = НоваяТаблицаОбъектов();
	
	Если Не ЗначениеЗаполнено(ТипОбъекта) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяТаблицы = ПолноеИмяТипаОбъекта(ТипОбъекта);
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВыражениеНаименование = ВыражениеНаименованиеОбъекта(ИмяТаблицы);
	ВыражениеПометкиУдаления = ВыражениеПометкиУдаленияОбъекта(ИмяТаблицы);
	
	ЕстьОтборПоВиду = ЗначениеЗаполнено(ВидНоменклатуры) И ЕстьРеквизитВидНоменклатуры(ТипОбъекта);
	
	Условия = Новый Массив;
	Если Не ПустаяСтрока(ВыражениеПометкиУдаления) Тогда
		Условия.Добавить("НЕ " + ВыражениеПометкиУдаления);
	КонецЕсли;
	
	Если ЕстьОтборПоВиду Тогда
		Условия.Добавить("Объекты.ВидНоменклатуры = &ВидНоменклатуры");
	КонецЕсли;
	
	ЕстьПоиск = Не ПустаяСтрока(СтрокаПоиска) И Не ПустаяСтрока(ВыражениеНаименование);
	Если ЕстьПоиск Тогда
		Условия.Добавить(ВыражениеНаименование + " ПОДОБНО &ШаблонПоиска");
	КонецЕсли;
	
	ТекстОтбора = "";
	Если Условия.Количество() > 0 Тогда
		ТекстОтбора = Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + "И ");
	КонецЕсли;
	
	Если ПустаяСтрока(ВыражениеНаименование) Тогда
		ВыражениеНаименование = "Объекты.Ссылка";
	КонецЕсли;
	
	Первые = "";
	Если Максимум > 0 Тогда
		Первые = " ПЕРВЫЕ " + Формат(Максимум, "ЧГ=0");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ" + Первые + "
	|	Объекты.Ссылка КАК Объект,
	|	" + ВыражениеНаименование + " КАК Наименование
	|ИЗ
	|	" + ИмяТаблицы + " КАК Объекты" + ТекстОтбора + "
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Если ЕстьПоиск Тогда
		Запрос.УстановитьПараметр("ШаблонПоиска", "%" + СтрокаПоиска + "%");
	КонецЕсли;
	Если ЕстьОтборПоВиду Тогда
		Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Объект = Выборка.Объект;
		НоваяСтрока.Наименование = Лев(СокрЛП(Строка(Выборка.Наименование)), 200);
		
	КонецЦикла;
	
	ЗаполнитьКоличествоВерсий(Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает сведения о трёх ключевых версиях данных: текущей, прошлой и первой.
// Сначала версии ищутся в регистре сведений ВерсииОбъектов (механизм версионирования объектов),
// если их там нет - в платформенной истории данных.
//
// Параметры:
//  Данные - Произвольный - ссылка на объект или ключ записи регистра сведений, для которых
//           запрашиваются версии.
//
// Возвращаемое значение:
//  Структура - сведения о версиях:
//   * Текущая  - Структура, Неопределено - сведения о последней версии;
//   * Прошлая  - Структура, Неопределено - сведения о предыдущей версии;
//   * Первая   - Структура, Неопределено - сведения о самой ранней версии;
//   * Источник - Строка - механизм версионирования, в котором найдены версии:
//                "ВерсионированиеОбъектов", "ИсторияДанных" или "" (версии не найдены).
//  Состав структуры сведений о версии - см. функции СведенияОЗаписиВерсии и СведенияОЗаписиВерсииИсторииДанных.
//
Функция СведенияОВерсиях(Данные) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Текущая", Неопределено);
	Результат.Вставить("Прошлая", Неопределено);
	Результат.Вставить("Первая", Неопределено);
	Результат.Вставить("Источник", "");
	
	Если ЗначениеЗаполнено(Данные) Тогда
		
		Номера = НомераВерсийОбъектов(Данные);
		
		Если Номера <> Неопределено И Номера.Количество() > 0 Тогда
			
			Результат.Вставить("Текущая", СведенияОЗаписиВерсии(Данные, НомерВерсииИзСписка(Номера, "Текущая")));
			Результат.Вставить("Прошлая", СведенияОЗаписиВерсии(Данные, НомерВерсииИзСписка(Номера, "Прошлая")));
			Результат.Вставить("Первая", СведенияОЗаписиВерсии(Данные, НомерВерсииИзСписка(Номера, "Первая")));
			Результат.Вставить("Источник", "ВерсионированиеОбъектов");
			
		Иначе
			
			ЗаполнитьСведенияОВерсияхИсторииДанных(Результат, Данные);
			Результат.Вставить("Источник", "ИсторияДанных");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, поддерживает ли тип объекта отбор по виду номенклатуры.
//
// Параметры:
//  ТипОбъекта - СправочникСсылка.ИдентификаторыОбъектовМетаданных - тип объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если у объекта метаданных есть реквизит "ВидНоменклатуры".
//
Функция ЕстьРеквизитВидНоменклатуры(ТипОбъекта) Экспорт
	
	ИмяТаблицы = ПолноеИмяТипаОбъекта(ТипОбъекта);
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат МетаданныеОбъекта.Реквизиты.Найти("ВидНоменклатуры") <> Неопределено;
	
КонецФункции

// Возвращает таблицу различий реквизитов между текущей, прошлой и первой версиями данных.
// Реквизиты версий читаются тем механизмом, в котором найдены версии: регистр сведений ВерсииОбъектов
// или платформенная история данных.
//
// Параметры:
//  Данные - Произвольный - ссылка на объект или ключ записи регистра сведений,
//           для которых запрашиваются версии.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Реквизит     - Строка - имя реквизита;
//   * Текущая      - Строка - представление значения реквизита в текущей версии;
//   * Прошлая      - Строка - представление значения реквизита в прошлой версии;
//   * Первая       - Строка - представление значения реквизита в первой версии;
//   * ЕстьРазличие - Булево - признак того, что значения реквизита в версиях различаются.
//
Функция ТаблицаРазличийВерсий(Данные) Экспорт
	
	Результат = НоваяТаблицаРазличий();
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Сведения = СведенияОВерсиях(Данные);
	
	ИменаВерсий = Новый Массив;
	ИменаВерсий.Добавить("Текущая");
	ИменаВерсий.Добавить("Прошлая");
	ИменаВерсий.Добавить("Первая");
	
	Карты = Новый Соответствие;
	ПорядокРеквизитов = Новый Массив;
	
	Для Каждого ИмяВерсии Из ИменаВерсий Цикл
		
		Карта = Новый Соответствие;
		Карты.Вставить(ИмяВерсии, Карта);
		
		СведенияОВерсии = Сведения[ИмяВерсии];
		Если СведенияОВерсии = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРеквизитов = РеквизитыВерсииПоИсточнику(Данные, СведенияОВерсии.НомерВерсии, Сведения.Источник);
		Для Каждого Реквизит Из ТаблицаРеквизитов Цикл
			
			ИмяРеквизита = СокрЛП(Строка(Реквизит.НаименованиеРеквизита));
			Если ПустаяСтрока(ИмяРеквизита) Тогда
				Продолжить;
			КонецЕсли;
			
			Карта.Вставить(ИмяРеквизита, ПредставлениеЗначенияРеквизита(Реквизит.ЗначениеРеквизита));
			Если ПорядокРеквизитов.Найти(ИмяРеквизита) = Неопределено Тогда
				ПорядокРеквизитов.Добавить(ИмяРеквизита);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ИмяРеквизита Из ПорядокРеквизитов Цикл
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Реквизит = Лев(ИмяРеквизита, 200);
		
		Значения = Новый Массив;
		Для Каждого ИмяВерсии Из ИменаВерсий Цикл
			ЗначениеИзКарты = Карты[ИмяВерсии].Получить(ИмяРеквизита);
			Представление = Лев(?(ЗначениеИзКарты = Неопределено, "", ЗначениеИзКарты), 500);
			НоваяСтрока[ИмяВерсии] = Представление;
			Значения.Добавить(Представление);
		КонецЦикла;
		
		НоваяСтрока.ЕстьРазличие = Не ВсеЗначенияРавны(Значения);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие номеров версий указанного вида для списка объектов.
// Сначала номера ищутся в регистре сведений ВерсииОбъектов, для объектов без версий в нём -
// в платформенной истории данных.
//
// Параметры:
//  СписокОбъектов - Массив из ЛюбаяСсылка - ссылки на версионируемые объекты;
//  ТипВерсии      - Строка - вид версии: "Текущая", "Прошлая" или "Первая".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - номера версий объектов:
//   * Ключ     - ЛюбаяСсылка - ссылка на объект;
//   * Значение - Число, Неопределено - номер версии, Неопределено - версия не найдена.
//
Функция НомераВерсийПоТипу(СписокОбъектов, ТипВерсии) Экспорт
	
	Результат = Новый Соответствие;
	
	НомераПоОбъектам = НомераВерсийПользователя(СписокОбъектов);
	НомераИсторииДанных = Неопределено;
	
	Для Каждого Ссылка Из СписокОбъектов Цикл
		
		Номера = НомераПоОбъектам.Получить(Ссылка);
		
		Если (Номера = Неопределено Или Номера.Количество() = 0)
			И ОбщегоНазначения.ЗначениеСсылочногоТипа(Ссылка) Тогда
			
			Если НомераИсторииДанных = Неопределено Тогда
				НомераИсторииДанных = НомераВерсийИсторииДанных(СписокОбъектов);
			КонецЕсли;
			Номера = НомераИсторииДанных.Получить(Ссылка);
			
		КонецЕсли;
		
		Результат.Вставить(Ссылка, НомерВерсииИзСписка(Номера, ТипВерсии));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает номер версии указанного вида.
// Сначала версия ищется в регистре сведений ВерсииОбъектов, если её там нет - в платформенной истории данных.
//
// Параметры:
//  Данные    - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  ТипВерсии - Строка - вид версии: "Текущая", "Прошлая" или "Первая".
//
// Возвращаемое значение:
//  Число, Неопределено - номер версии, Неопределено - версия не найдена.
//
Функция НомерВерсииПоТипу(Данные, ТипВерсии) Экспорт
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сведения = СведенияОВерсиях(Данные);
	СведенияОВерсии = Сведения[ТипВерсии];
	Если СведенияОВерсии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СведенияОВерсии.НомерВерсии;
	
КонецФункции

// Выполняет переход данных на указанную версию.
//
// Параметры:
//  Данные                 - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии            - Число - номер версии, на которую выполняется переход;
//  ТекстСообщенияОбОшибке - Строка - текст ошибки, если переход не выполнен;
//  Источник               - Строка - механизм версионирования, в котором найдена версия:
//                           "ВерсионированиеОбъектов" или "ИсторияДанных", см. функцию СведенияОВерсиях.
//
// Возвращаемое значение:
//  Строка - результат перехода: "ВосстановлениеВыполнено", "ОшибкаВосстановления" или "ОшибкаПроведения".
//
Функция ПерейтиНаВерсию(Данные, НомерВерсии, ТекстСообщенияОбОшибке, Источник) Экспорт
	
	ТекстСообщенияОбОшибке = "";
	
	Если Не ЗначениеЗаполнено(Данные) Тогда
		ТекстСообщенияОбОшибке = НСтр("ru = 'Не указан объект для перехода на версию.'");
		Возврат "ОшибкаВосстановления";
	КонецЕсли;
	
	Если НомерВерсии = Неопределено Или НомерВерсии <= 0 Тогда
		ТекстСообщенияОбОшибке = НСтр("ru = 'Не указан номер версии для перехода.'");
		Возврат "ОшибкаВосстановления";
	КонецЕсли;
	
	Если Источник = "ВерсионированиеОбъектов" Тогда
		Возврат ВерсионированиеОбъектов.ПерейтиНаВерсиюСервер(Данные, НомерВерсии, ТекстСообщенияОбОшибке);
	КонецЕсли;
	
	Возврат ВосстановитьВерсиюИсторииДанных(Данные, НомерВерсии, ТекстСообщенияОбОшибке);
	
КонецФункции

// Формирует печатную форму данных по указанной версии.
// Для версий регистра сведений ВерсииОбъектов используется печатная форма версионирования объектов,
// для версий истории данных - таблица реквизитов версии.
//
// Параметры:
//  Данные      - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии - Число, Неопределено - номер версии, Неопределено - текущее состояние данных.
//
// Возвращаемое значение:
//  ТабличныйДокумент - печатная форма данных версии.
//
Функция ОтчетПоВерсии(Данные, НомерВерсии) Экспорт
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Данные)
		И (НомерВерсии = Неопределено Или НомерВерсии <= 0
			Или ВерсияВВерсияхОбъектов(Данные, НомерВерсии)) Тогда
		
		Если НомерВерсии = Неопределено Или НомерВерсии <= 0 Тогда
			Возврат ВерсионированиеОбъектов.ОтчетПоВерсииОбъекта(Данные);
		КонецЕсли;
		
		Возврат ВерсионированиеОбъектов.ОтчетПоВерсииОбъекта(Данные, НомерВерсии);
		
	КонецЕсли;
	
	Возврат ОтчетПоВерсииИсторииДанных(Данные, НомерВерсии);
	
КонецФункции

// Определяет, доступен ли текущему пользователю переход на версию объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если переход разрешён.
//
Функция ЕстьПравоПереходаНаВерсию() Экспорт
	
	Возврат Пользователи.ЭтоПолноправныйПользователь()
		И ВерсионированиеОбъектов.ЕстьПравоЧтенияИнформацииОВерсияхОбъектов();
	
КонецФункции

// Выполняет пакетный переход отмеченных объектов или записей регистра на их версии указанного вида.
// Предназначена для выполнения в фоновом задании через механизм длительных операций.
//
// Параметры:
//  Параметры       - Структура - параметры выполнения:
//     * СписокОбъектов - Массив из ЛюбаяСсылка - ссылки на объекты, для которых выполняется переход;
//     * ТипОбъекта     - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                        СправочникСсылка.ИдентификаторыОбъектовРасширений, Неопределено -
//                        тип объектов списка при переходе по записям регистра сведений;
//     * СписокЗаписей  - Массив из Строка - значения ключей записей регистра сведений,
//                        упакованные ЗначениеВСтрокуВнутр;
//     * ТипВерсии      - Строка - вид версии: "Текущая", "Прошлая" или "Первая";
//  АдресРезультата - Строка - адрес во временном хранилище для помещения результата.
//
Процедура ВыполнитьПереходНаВерсииДляОтмеченных(Параметры, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выполнено", 0);
	Результат.Вставить("Ошибки", Новый Массив);
	
	ВыполнитьПереходНаВерсииОбъектов(Параметры, Результат);
	ВыполнитьПереходНаВерсииЗаписейРегистра(Параметры, Результат);
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Формирует настройки динамического списка объектов указанного типа: основную таблицу,
// текст запроса и значения параметров отбора.
//
// Параметры:
//  ТипОбъекта      - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//                    СправочникСсылка.ИдентификаторыОбъектовРасширений - тип объекта метаданных;
//  СтрокаПоиска    - Строка - подстрока для поиска по наименованию или коду объекта,
//                    пустая строка - без отбора;
//  ВидНоменклатуры - СправочникСсылка.ВидыНоменклатуры, Неопределено - вид номенклатуры для отбора;
//                    учитывается, только если у типа объекта есть реквизит "ВидНоменклатуры".
//
// Возвращаемое значение:
//  Структура:
//   * ПолноеИмя    - Строка - полное имя основной таблицы динамического списка; пустая строка -
//                    если тип объекта не поддерживает хранение версий (остальные поля не заполняются);
//   * ТекстЗапроса - Строка - текст запроса динамического списка с полями "Ссылка", "Наименование" и "Отметка";
//   * Параметры    - Соответствие из КлючИЗначение - значения параметров запроса: ключ - имя параметра,
//                    значение - значение параметра. Параметр "Отмеченные" - Массив из ЛюбаяСсылка -
//                    отмеченные объекты; по нему вычисляется поле "Отметка"
//                    (Истина для отмеченных объектов, Иначе Ложь).
//
Функция НастройкиДинамическогоСпискаОбъектов(ТипОбъекта, СтрокаПоиска = "", ВидНоменклатуры = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПолноеИмя", "");
	Результат.Вставить("ТекстЗапроса", "");
	Результат.Вставить("Параметры", Новый Соответствие);
	
	ИмяТаблицы = ПолноеИмяТипаОбъекта(ТипОбъекта);
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВыражениеНаименование = ВыражениеНаименованиеОбъекта(ИмяТаблицы);
	Если ПустаяСтрока(ВыражениеНаименование) Тогда
		ВыражениеНаименование = "ПРЕДСТАВЛЕНИЕ(Объекты.Ссылка)";
	КонецЕсли;
	
	ВыражениеПометкиУдаления = ВыражениеПометкиУдаленияОбъекта(ИмяТаблицы);
	
	Условия = Новый Массив;
	Если Не ПустаяСтрока(ВыражениеПометкиУдаления) Тогда
		Условия.Добавить("НЕ " + ВыражениеПометкиУдаления);
	КонецЕсли;
	
	Если Не ПустаяСтрока(СтрокаПоиска) Тогда
		Условия.Добавить(ВыражениеНаименование + " ПОДОБНО &ШаблонПоиска");
		Результат.Параметры.Вставить("ШаблонПоиска", "%" + СтрокаПоиска + "%");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидНоменклатуры) И ЕстьРеквизитВидНоменклатуры(ТипОбъекта) Тогда
		Условия.Добавить("Объекты.ВидНоменклатуры = &ВидНоменклатуры");
		Результат.Параметры.Вставить("ВидНоменклатуры", ВидНоменклатуры);
	КонецЕсли;
	
	ТекстОтбора = "";
	Если Условия.Количество() > 0 Тогда
		ТекстОтбора = Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + "И ");
	КонецЕсли;
	
	Результат.ПолноеИмя = ИмяТаблицы;
	Результат.ТекстЗапроса =
		"ВЫБРАТЬ
		|	Объекты.Ссылка КАК Ссылка,
		|	" + ВыражениеНаименование + " КАК Наименование,
		|	ВЫБОР
		|		КОГДА Объекты.Ссылка В (&Отмеченные)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Отметка
		|ИЗ
		|	" + ИмяТаблицы + " КАК Объекты" + ТекстОтбора;
	
	Результат.Параметры.Вставить("Отмеченные", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает таблицу типов версионируемых объектов.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию ВерсионируемыеОбъекты.
//
Функция НоваяТаблицаТиповОбъектов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТипОбъекта");
	Результат.Колонки.Добавить("ПолноеИмя");
	Результат.Колонки.Добавить("Представление");
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу объектов для формы обработки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию СписокОбъектовТипа.
//
Функция НоваяТаблицаОбъектов()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Отметка");
	Результат.Колонки.Добавить("Объект");
	Результат.Колонки.Добавить("Наименование");
	Результат.Колонки.Добавить("КоличествоВерсий");
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу записей регистра сведений для формы обработки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию СписокЗаписейРегистра.
//
Функция НоваяТаблицаЗаписейРегистра()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Отметка");
	Результат.Колонки.Добавить("Запись");
	Результат.Колонки.Добавить("Наименование");
	
	Возврат Результат;
	
КонецФункции

// Заполняет типы версионируемых объектов по настройкам версионирования объектов.
//
// Параметры:
//  Результат - ТаблицаЗначений - таблица типов объектов, см. функцию ВерсионируемыеОбъекты.
//
Процедура ЗаполнитьТипыВерсионированияОбъектов(Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиВерсионированияОбъектов.ТипОбъекта КАК ТипОбъекта
	|ИЗ
	|	РегистрСведений.НастройкиВерсионированияОбъектов КАК НастройкиВерсионированияОбъектов
	|ГДЕ
	|	НастройкиВерсионированияОбъектов.Использовать = ИСТИНА";
	
	Идентификаторы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Идентификаторы.Добавить(Выборка.ТипОбъекта);
	КонецЦикла;
	
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыМетаданных = ОбщегоНазначения.ОбъектыМетаданныхПоИдентификаторам(Идентификаторы, Ложь);
	
	Для Каждого Идентификатор Из Идентификаторы Цикл
		
		ОбъектМетаданных = ОбъектыМетаданных.Получить(Идентификатор);
		Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных = Null Тогда
			Продолжить;
		КонецЕсли;
		
		ПолноеИмя = СокрЛП(ОбъектМетаданных.ПолноеИмя());
		Если Не ЭтоВерсионируемыйТипОбъекта(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ТипОбъекта = Идентификатор;
		НоваяСтрока.ПолноеИмя = ПолноеИмя;
		НоваяСтрока.Представление = ПредставлениеТипаОбъекта(ОбъектМетаданных);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет типы версионируемых объектов по объектам метаданных с включённой историей данных.
//
// Параметры:
//  Результат - ТаблицаЗначений - таблица типов объектов, см. функцию ВерсионируемыеОбъекты.
//
Процедура ЗаполнитьТипыИсторииДанных(Результат)
	
	Для Каждого ОбъектМетаданных Из ОбъектыМетаданныхСИсториейДанных() Цикл
		
		ПолноеИмя = СокрЛП(ОбъектМетаданных.ПолноеИмя());
		Если Результат.Найти(ПолноеИмя, "ПолноеИмя") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОбъектМетаданных, Ложь);
		Если ТипОбъекта = Неопределено Или ТипОбъекта = Null Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ТипОбъекта = ТипОбъекта;
		НоваяСтрока.ПолноеИмя = ПолноеИмя;
		НоваяСтрока.Представление = ПредставлениеТипаОбъекта(ОбъектМетаданных);
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает объекты метаданных, для которых включена платформенная история данных.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - объекты метаданных поддерживаемых видов.
//
Функция ОбъектыМетаданныхСИсториейДанных()
	
	Результат = Новый Массив;
	
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.Справочники);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.Документы);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.РегистрыСведений);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.БизнесПроцессы);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.Задачи);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.ПланыВидовХарактеристик);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.ПланыСчетов);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.ПланыВидовРасчета);
	ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, Метаданные.ПланыОбмена);
	
	Возврат Результат;
	
КонецФункции

// Добавляет в массив объекты метаданных коллекции, для которых включена платформенная история данных.
//
// Параметры:
//  Результат                   - Массив из ОбъектМетаданных - объекты метаданных с историей данных;
//  КоллекцияОбъектовМетаданных - КоллекцияОбъектовМетаданных - коллекция объектов метаданных.
//
Процедура ДобавитьОбъектыМетаданныхСИсториейДанных(Результат, КоллекцияОбъектовМетаданных)
	
	Для Каждого ОбъектМетаданных Из КоллекцияОбъектовМетаданных Цикл
		Если ЭтоТипСИсториейДанных(ОбъектМетаданных) Тогда
			Результат.Добавить(ОбъектМетаданных);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Определяет, включена ли у объекта метаданных платформенная история данных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если история данных включена.
//
Функция ЭтоТипСИсториейДанных(ОбъектМетаданных)
	
	Если Не ЭтоОбъектМетаданныхСИсториейДанных(ОбъектМетаданных) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ОбъектМетаданных.ИсторияДанных = Метаданные.СвойстваОбъектов.ИспользованиеИсторииДанных.Использовать;
	
КонецФункции

// Определяет, поддерживает ли вид объекта метаданных платформенную историю данных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если у объектов этого вида есть свойство "История данных".
//
Функция ЭтоОбъектМетаданныхСИсториейДанных(ОбъектМетаданных)
	
	Возврат Метаданные.Справочники.Содержит(ОбъектМетаданных)
		Или Метаданные.Документы.Содержит(ОбъектМетаданных)
		Или Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных)
		Или Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных)
		Или Метаданные.Задачи.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных)
		Или Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных);
	
КонецФункции

// Возвращает версии истории данных по объекту метаданных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных с включённой историей данных;
//  Колонки          - Строка - имена колонок версий истории данных, разделённые запятыми;
//  Порядок          - Строка - порядок сортировки версий;
//  Максимум         - Число, Неопределено - максимальное количество версий;
//                     Неопределено или 0 - без ограничения.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - версии истории данных;
//                                 Неопределено - история данных недоступна.
//
Функция ВерсииИсторииДанныхПоМетаданным(ОбъектМетаданных, Колонки, Порядок, Максимум = 0)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Метаданные", ОбъектМетаданных);
	
	МаксимальноеКоличество = ?(Максимум = Неопределено Или Максимум <= 0, Неопределено, Максимум);
	
	Попытка
		Возврат ИсторияДанных.ВыбратьВерсии(Отбор, Колонки, Порядок, МаксимальноеКоличество);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Возвращает версии истории данных по данным (ссылке или ключу записи регистра сведений).
//
// Параметры:
//  Данные - Произвольный - ссылка на объект или ключ записи регистра сведений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - версии истории данных по возрастанию номеров версий.
//
Функция ВерсииИсторииДанныхПоДанным(Данные)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Данные", Данные);
	
	Колонки = "Данные, НомерВерсии, Дата, ИмяПользователя, ПолноеИмяПользователя, Комментарий, ВидИзмененияДанных";
	
	Попытка
		Возврат ИсторияДанных.ВыбратьВерсии(Отбор, Колонки, "НомерВерсии");
	Исключение
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;
	
КонецФункции

// Заполняет сведения о версиях данных по платформенной истории данных.
//
// Параметры:
//  Результат - Структура - сведения о версиях, см. функцию СведенияОВерсиях;
//  Данные    - Произвольный - ссылка на объект или ключ записи регистра сведений.
//
Процедура ЗаполнитьСведенияОВерсияхИсторииДанных(Результат, Данные)
	
	Версии = ВерсииИсторииДанныхПоДанным(Данные);
	Если Версии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("Текущая", СведенияОЗаписиВерсииИсторииДанных(Версии[Версии.Количество() - 1]));
	Результат.Вставить("Первая", СведенияОЗаписиВерсииИсторииДанных(Версии[0]));
	Если Версии.Количество() >= 2 Тогда
		Результат.Вставить("Прошлая", СведенияОЗаписиВерсииИсторииДанных(Версии[Версии.Количество() - 2]));
	КонецЕсли;
	
КонецПроцедуры

// Возвращает сведения о записи версии истории данных.
//
// Параметры:
//  СтрокаВерсии - СтрокаТаблицыЗначений - запись таблицы версий истории данных.
//
// Возвращаемое значение:
//  Структура - сведения о версии: номер версии, дата версии, автор изменения,
//              комментарий к версии, представление версии для вывода пользователю.
//
Функция СведенияОЗаписиВерсииИсторииДанных(СтрокаВерсии)
	
	АвторВерсии = СокрЛП(Строка(СтрокаВерсии.ПолноеИмяПользователя));
	Если ПустаяСтрока(АвторВерсии) Тогда
		АвторВерсии = СокрЛП(Строка(СтрокаВерсии.ИмяПользователя));
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НомерВерсии", СтрокаВерсии.НомерВерсии);
	Результат.Вставить("ДатаВерсии", СтрокаВерсии.Дата);
	Результат.Вставить("АвторВерсии", АвторВерсии);
	Результат.Вставить("Комментарий", СтрокаВерсии.Комментарий);
	Результат.Вставить("Представление", ПредставлениеВерсииИсторииДанных(СтрокаВерсии, АвторВерсии));
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление версии истории данных для вывода пользователю.
//
// Параметры:
//  СтрокаВерсии - СтрокаТаблицыЗначений - запись таблицы версий истории данных;
//  АвторВерсии  - Строка - представление автора изменения.
//
// Возвращаемое значение:
//  Строка - представление версии.
//
Функция ПредставлениеВерсииИсторииДанных(СтрокаВерсии, АвторВерсии)
	
	Представление = НСтр("ru = '№'") + " " + Формат(СтрокаВерсии.НомерВерсии, "ЧГ=0");
	
	Если ЗначениеЗаполнено(СтрокаВерсии.Дата) Тогда
		Представление = Представление + " " + НСтр("ru = 'от'") + " " + Формат(СтрокаВерсии.Дата, "ДЛФ=DT");
	КонецЕсли;
	
	Если Не ПустаяСтрока(АвторВерсии) Тогда
		Представление = Представление + ", " + АвторВерсии;
	КонецЕсли;
	
	Представление = Представление + ", " + НСтр("ru = 'история данных'");
	
	Возврат Представление;
	
КонецФункции

// Возвращает значения ключа записи регистра сведений в виде структуры.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистра сведений;
//  КлючЗаписи       - Произвольный - ключ записи регистра сведений.
//
// Возвращаемое значение:
//  Структура - значения измерений, периода и регистратора записи.
//
Функция ЗначенияКлючаЗаписи(ОбъектМетаданных, КлючЗаписи)
	
	Значения = Новый Структура;
	
	Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл
		Значения.Вставить(Измерение.Имя, КлючЗаписи[Измерение.Имя]);
	КонецЦикла;
	
	Если ОбъектМетаданных.ПериодичностьРегистраСведений
		<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Значения.Вставить("Период", КлючЗаписи.Период);
	КонецЕсли;
	
	Если ОбъектМетаданных.РежимЗаписи
		= Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Значения.Вставить("Регистратор", КлючЗаписи.Регистратор);
	КонецЕсли;
	
	Возврат Значения;
	
КонецФункции

// Возвращает строку с значениями ключа записи регистра сведений.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных регистра сведений;
//  КлючЗаписи       - Произвольный - ключ записи регистра сведений.
//
// Возвращаемое значение:
//  Строка - значения ключа записи, упакованные ЗначениеВСтрокуВнутр.
//
Функция ЗаписьСтрокойКлючаЗаписи(ОбъектМетаданных, КлючЗаписи)
	
	Попытка
		Возврат ЗначениеВСтрокуВнутр(ЗначенияКлючаЗаписи(ОбъектМетаданных, КлючЗаписи));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Выполняет переход на версии для отмеченных ссылочных объектов.
//
// Параметры:
//  Параметры - Структура - см. процедуру ВыполнитьПереходНаВерсииДляОтмеченных;
//  Результат - Структура - результат выполнения:
//     * Выполнено - Число - количество успешно выполненных переходов;
//     * Ошибки    - Массив из Строка - описания ошибок.
//
Процедура ВыполнитьПереходНаВерсииОбъектов(Параметры, Результат)
	
	Если Параметры.СписокОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомераВерсий = НомераВерсийПоТипу(Параметры.СписокОбъектов, Параметры.ТипВерсии);
	Источники = ИсточникиВерсийОбъектов(Параметры.СписокОбъектов, НомераВерсий);
	
	Для Каждого Ссылка Из Параметры.СписокОбъектов Цикл
		
		НомерВерсии = НомераВерсий.Получить(Ссылка);
		Если НомерВерсии = Неопределено Тогда
			Результат.Ошибки.Добавить(Строка(Ссылка) + НСтр("ru = ': версия не найдена.'"));
			Продолжить;
		КонецЕсли;
		
		ТекстСообщенияОбОшибке = "";
		СтатусПерехода = ПерейтиНаВерсию(Ссылка, НомерВерсии, ТекстСообщенияОбОшибке, Источники.Получить(Ссылка));
		Если СтатусПерехода = "ВосстановлениеВыполнено" Тогда
			Результат.Выполнено = Результат.Выполнено + 1;
		Иначе
			Результат.Ошибки.Добавить(Строка(Ссылка) + ": " + ?(ПустаяСтрока(ТекстСообщенияОбОшибке), СтатусПерехода, ТекстСообщенияОбОшибке));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Выполняет переход на версии для отмеченных записей регистра сведений.
// Версии записей регистра сведений хранятся только в платформенной истории данных.
//
// Параметры:
//  Параметры - Структура - см. процедуру ВыполнитьПереходНаВерсииДляОтмеченных;
//  Результат - Структура - результат выполнения, см. процедуру ВыполнитьПереходНаВерсииОбъектов.
//
Процедура ВыполнитьПереходНаВерсииЗаписейРегистра(Параметры, Результат)
	
	Если Параметры.СписокЗаписей.Количество() = 0 Или Параметры.ТипОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомераВерсий = НомераВерсийЗаписейПоТипу(Параметры.ТипОбъекта, Параметры.СписокЗаписей, Параметры.ТипВерсии);
	
	Для Каждого ЗаписьСтрокой Из Параметры.СписокЗаписей Цикл
		
		Данные = ДанныеПоЗаписиСтрокой(Параметры.ТипОбъекта, ЗаписьСтрокой);
		Если Данные = Неопределено Тогда
			Результат.Ошибки.Добавить(НСтр("ru = 'Запись регистра не распознана.'"));
			Продолжить;
		КонецЕсли;
		
		НомерВерсии = НомераВерсий.Получить(ЗаписьСтрокой);
		Если НомерВерсии = Неопределено Тогда
			Результат.Ошибки.Добавить(СокрЛП(Строка(Данные)) + НСтр("ru = ': версия не найдена.'"));
			Продолжить;
		КонецЕсли;
		
		ТекстСообщенияОбОшибке = "";
		СтатусПерехода = ПерейтиНаВерсию(Данные, НомерВерсии, ТекстСообщенияОбОшибке, "ИсторияДанных");
		Если СтатусПерехода = "ВосстановлениеВыполнено" Тогда
			Результат.Выполнено = Результат.Выполнено + 1;
		Иначе
			Результат.Ошибки.Добавить(СокрЛП(Строка(Данные)) + ": " + ?(ПустаяСтрока(ТекстСообщенияОбОшибке), СтатусПерехода, ТекстСообщенияОбОшибке));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает источники версий для списка ссылочных объектов.
// Источник определяется по номеру версии: если версия есть в регистре сведений ВерсииОбъектов,
// используется версионирование объектов, иначе - платформенная история данных.
//
// Параметры:
//  СписокОбъектов - Массив из ЛюбаяСсылка - ссылки на версионируемые объекты;
//  НомераВерсий   - Соответствие из КлючИЗначение - номера версий объектов, см. функцию НомераВерсийПоТипу.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - источники версий объектов:
//   * Ключ     - ЛюбаяСсылка - ссылка на объект;
//   * Значение - Строка - "ВерсионированиеОбъектов" или "ИсторияДанных".
//
Функция ИсточникиВерсийОбъектов(СписокОбъектов, НомераВерсий)
	
	Результат = Новый Соответствие;
	НомераБСП = НомераВерсийПользователя(СписокОбъектов);
	
	Для Каждого Ссылка Из СписокОбъектов Цикл
		
		Номера = НомераБСП.Получить(Ссылка);
		НомерВерсии = НомераВерсий.Получить(Ссылка);
		
		Если Номера <> Неопределено И Номера.Найти(НомерВерсии) <> Неопределено Тогда
			Результат.Вставить(Ссылка, "ВерсионированиеОбъектов");
		Иначе
			Результат.Вставить(Ссылка, "ИсторияДанных");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает номера версий истории данных для списка ссылок.
//
// Параметры:
//  СписокОбъектов - Массив из ЛюбаяСсылка - ссылки на версионируемые объекты.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - номера версий объектов:
//   * Ключ     - ЛюбаяСсылка - ссылка на объект;
//   * Значение - Массив из Число, Неопределено - номера версий объекта по возрастанию.
//
Функция НомераВерсийИсторииДанных(СписокОбъектов)
	
	Результат = Новый Соответствие;
	СсылкиПоТипам = Новый Соответствие;
	
	Для Каждого Ссылка Из СписокОбъектов Цикл
		
		Если Не ОбщегоНазначения.ЗначениеСсылочногоТипа(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипСсылки = ТипЗнч(Ссылка);
		Если СсылкиПоТипам.Получить(ТипСсылки) = Неопределено Тогда
			СсылкиПоТипам.Вставить(ТипСсылки, Новый Массив);
		КонецЕсли;
		СсылкиПоТипам[ТипСсылки].Добавить(Ссылка);
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из СсылкиПоТипам Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(КлючИЗначение.Ключ);
		Если ОбъектМетаданных = Неопределено Или Не ЭтоТипСИсториейДанных(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		Версии = ВерсииИсторииДанныхПоМетаданным(ОбъектМетаданных, "Данные, НомерВерсии", "НомерВерсии");
		Если Версии = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомераПоСсылкам = Новый Соответствие;
		
		Для Каждого СтрокаВерсии Из Версии Цикл
			
			Если СтрокаВерсии.Данные = Неопределено Или СтрокаВерсии.Данные = Null Тогда
				Продолжить;
			КонецЕсли;
			
			Если НомераПоСсылкам.Получить(СтрокаВерсии.Данные) = Неопределено Тогда
				НомераПоСсылкам.Вставить(СтрокаВерсии.Данные, Новый Массив);
			КонецЕсли;
			НомераПоСсылкам[СтрокаВерсии.Данные].Добавить(СтрокаВерсии.НомерВерсии);
			
		КонецЦикла;
		
		Для Каждого Ссылка Из КлючИЗначение.Значение Цикл
			Результат.Вставить(Ссылка, НомераПоСсылкам.Получить(Ссылка));
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает номера версий объекта из регистра сведений ВерсииОбъектов.
//
// Параметры:
//  Данные - ЛюбаяСсылка - ссылка на версионируемый объект.
//
// Возвращаемое значение:
//  Массив из Число, Неопределено - номера версий, изменённых пользователем;
//                                 Неопределено - объект не версионируется средствами версионирования объектов.
//
Функция НомераВерсийОбъектов(Данные)
	
	Если Не ОбщегоНазначения.ЗначениеСсылочногоТипа(Данные) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СписокОбъектов = Новый Массив;
	СписокОбъектов.Добавить(Данные);
	
	Возврат НомераВерсийПользователя(СписокОбъектов).Получить(Данные);
	
КонецФункции

// Определяет, есть ли версия с указанным номером в регистре сведений ВерсииОбъектов.
//
// Параметры:
//  Данные      - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии - Число - номер версии.
//
// Возвращаемое значение:
//  Булево - Истина, если версия найдена в регистре сведений ВерсииОбъектов.
//
Функция ВерсияВВерсияхОбъектов(Данные, НомерВерсии)
	
	Если Не ОбщегоНазначения.ЗначениеСсылочногоТипа(Данные)
		Или НомерВерсии = Неопределено Или НомерВерсии <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Данные
	|	И ВерсииОбъектов.НомерВерсии = &НомерВерсии";
	Запрос.УстановитьПараметр("Данные", Данные);
	Запрос.УстановитьПараметр("НомерВерсии", НомерВерсии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции

// Восстанавливает данные по версии платформенной истории данных.
//
// Параметры:
//  Данные                 - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии            - Число - номер версии, на которую выполняется переход;
//  ТекстСообщенияОбОшибке - Строка - текст ошибки, если переход не выполнен.
//
// Возвращаемое значение:
//  Строка - результат перехода: "ВосстановлениеВыполнено" или "ОшибкаВосстановления".
//
Функция ВосстановитьВерсиюИсторииДанных(Данные, НомерВерсии, ТекстСообщенияОбОшибке)
	
	Попытка
		ДанныеВерсии = ИсторияДанных.СформироватьПоВерсии(Данные, НомерВерсии);
	Исключение
		ТекстСообщенияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат "ОшибкаВосстановления";
	КонецПопытки;
	
	Если ДанныеВерсии = Неопределено Тогда
		ТекстСообщенияОбОшибке = НСтр("ru = 'Версия истории данных не найдена.'");
		Возврат "ОшибкаВосстановления";
	КонецЕсли;
	
	Попытка
		ДанныеВерсии.Записать();
	Исключение
		ТекстСообщенияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат "ОшибкаВосстановления";
	КонецПопытки;
	
	Возврат "ВосстановлениеВыполнено";
	
КонецФункции

// Возвращает таблицу реквизитов версии из указанного механизма версионирования.
//
// Параметры:
//  Данные      - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии - Число - номер версии;
//  Источник    - Строка - механизм версионирования, в котором найдена версия:
//                "ВерсионированиеОбъектов" или "ИсторияДанных", см. функцию СведенияОВерсиях.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * НаименованиеРеквизита - Строка - имя реквизита;
//   * ЗначениеРеквизита     - Произвольный - значение реквизита.
//
Функция РеквизитыВерсииПоИсточнику(Данные, НомерВерсии, Источник)
	
	Если Источник = "ВерсионированиеОбъектов" Тогда
		Возврат РеквизитыВерсии(Данные, НомерВерсии);
	КонецЕсли;
	
	Возврат РеквизитыВерсииИсторииДанных(Данные, НомерВерсии);
	
КонецФункции

// Возвращает таблицу реквизитов, сохранённых в указанной версии истории данных.
//
// Параметры:
//  Данные      - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии - Число - номер версии.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * НаименованиеРеквизита - Строка - имя реквизита;
//   * ЗначениеРеквизита     - Произвольный - значение реквизита.
//
Функция РеквизитыВерсииИсторииДанных(Данные, НомерВерсии)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НаименованиеРеквизита");
	Результат.Колонки.Добавить("ЗначениеРеквизита");
	
	Если НомерВерсии = Неопределено Или НомерВерсии <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДанныеВерсии = ИсторияДанных.ПолучитьДанныеВерсии(Данные, НомерВерсии);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеВерсии) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из ДанныеВерсии Цикл
		
		Значение = КлючИЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Представление") Тогда
			Значение = Значение.Представление;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.НаименованиеРеквизита = КлючИЗначение.Ключ;
		НоваяСтрока.ЗначениеРеквизита = Значение;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует табличный документ с данными указанной версии истории данных.
//
// Параметры:
//  Данные      - Произвольный - ссылка на объект или ключ записи регистра сведений;
//  НомерВерсии - Число, Неопределено - номер версии.
//
// Возвращаемое значение:
//  ТабличныйДокумент - данные версии.
//
Функция ОтчетПоВерсииИсторииДанных(Данные, НомерВерсии)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	
	НомерСтроки = 1;
	
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст =
		НСтр("ru = 'Данные версии'") + " " + Формат(?(НомерВерсии = Неопределено, 0, НомерВерсии), "ЧГ=0");
	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = СокрЛП(Строка(Данные));
	НомерСтроки = НомерСтроки + 2;
	
	ТабличныйДокумент.Область(НомерСтроки, 1).Текст = НСтр("ru = 'Реквизит'");
	ТабличныйДокумент.Область(НомерСтроки, 2).Текст = НСтр("ru = 'Значение'");
	
	Для Каждого Реквизит Из РеквизитыВерсииИсторииДанных(Данные, НомерВерсии) Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ТабличныйДокумент.Область(НомерСтроки, 1).Текст = СокрЛП(Строка(Реквизит.НаименованиеРеквизита));
		ТабличныйДокумент.Область(НомерСтроки, 2).Текст = ПредставлениеЗначенияРеквизита(Реквизит.ЗначениеРеквизита);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Возвращает таблицу различий версий для формы обработки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию ТаблицаРазличийВерсий.
//
Функция НоваяТаблицаРазличий()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Реквизит");
	Результат.Колонки.Добавить("Текущая");
	Результат.Колонки.Добавить("Прошлая");
	Результат.Колонки.Добавить("Первая");
	Результат.Колонки.Добавить("ЕстьРазличие");
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие "ссылка на объект - номера версий, изменённых пользователем".
//
// Параметры:
//  СписокОбъектов - Массив из ЛюбаяСсылка - ссылки на версионируемые объекты.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - номера версий объектов:
//   * Ключ     - ЛюбаяСсылка - ссылка на объект;
//   * Значение - Массив из Число - номера версий объекта по возрастанию.
//
Функция НомераВерсийПользователя(СписокОбъектов)
	
	Результат = Новый Соответствие;
	
	Если СписокОбъектов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсииОбъектов.Объект КАК Объект,
	|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект В (&СписокОбъектов)
	|	И ВерсииОбъектов.ТипВерсииОбъекта = ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ИзмененоПользователем)
	|УПОРЯДОЧИТЬ ПО
	|	Объект,
	|	НомерВерсии";
	Запрос.УстановитьПараметр("СписокОбъектов", СписокОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Номера = Результат.Получить(Выборка.Объект);
		Если Номера = Неопределено Тогда
			Номера = Новый Массив;
			Результат.Вставить(Выборка.Объект, Номера);
		КонецЕсли;
		Номера.Добавить(Выборка.НомерВерсии);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает номер версии из списка номеров по виду версии.
//
// Параметры:
//  Номера    - Массив из Число, Неопределено - номера версий объекта по возрастанию;
//  ТипВерсии - Строка - вид версии: "Текущая", "Прошлая" или "Первая".
//
// Возвращаемое значение:
//  Число, Неопределено - номер версии, Неопределено - версия не найдена.
//
Функция НомерВерсииИзСписка(Номера, ТипВерсии)
	
	Если Номера = Неопределено Или Номера.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипВерсии = "Первая" Тогда
		Возврат Номера[0];
	КонецЕсли;
	
	Если ТипВерсии = "Текущая" Тогда
		Возврат Номера[Номера.Количество() - 1];
	КонецЕсли;
	
	Если ТипВерсии = "Прошлая" И Номера.Количество() >= 2 Тогда
		Возврат Номера[Номера.Количество() - 2];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Определяет, является ли объект метаданных регистром сведений.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если объект метаданных - регистр сведений.
//
Функция ЭтоРегистрСведений(ОбъектМетаданных)
	
	Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных = Null Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтрНачинаетсяС(СокрЛП(ОбъектМетаданных.ПолноеИмя()), "РегистрСведений.");
	
КонецФункции

// Определяет, поддерживает ли тип объекта метаданных хранение версий.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если для типа доступен просмотр версий: включена платформенная
//           история данных (в том числе у регистров сведений и планов обмена) или тип
//           входит в состав типов измерения "Объект" регистра сведений ВерсииОбъектов.
//
Функция ЭтоВерсионируемыйТипОбъекта(ОбъектМетаданных)
	
	Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных = Null Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Регистры сведений показываются списком записей, а не ссылок: наличие версий
	// определяется запросом истории данных, поэтому вид объекта сам по себе не отсекается.
	Если ЭтоРегистрСведений(ОбъектМетаданных) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Свойство "История данных" есть не у всех видов объектов метаданных,
	// поэтому обращение к нему защищено.
	ИспользованиеИстории = Метаданные.СвойстваОбъектов.ИспользованиеИсторииДанных;
	Попытка
		ЭтоИсторияДанных = ОбъектМетаданных.ИсторияДанных = ИспользованиеИстории.Использовать;
	Исключение
		ЭтоИсторияДанных = Ложь;
	КонецПопытки;
	
	Если ЭтоИсторияДанных Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПолноеИмя = СокрЛП(ОбъектМетаданных.ПолноеИмя());
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПрефиксыТипов = Новый Массив;
	ПрефиксыТипов.Добавить("Справочник.");
	ПрефиксыТипов.Добавить("Документ.");
	ПрефиксыТипов.Добавить("БизнесПроцесс.");
	ПрефиксыТипов.Добавить("Задача.");
	ПрефиксыТипов.Добавить("ПланВидовХарактеристик.");
	ПрефиксыТипов.Добавить("ПланСчетов.");
	ПрефиксыТипов.Добавить("ПланВидовРасчета.");
	
	Для Каждого Префикс Из ПрефиксыТипов Цикл
		Если СтрНачинаетсяС(ПолноеИмя, Префикс) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает объект метаданных по идентификатору типа объекта.
// Идентификатор может относиться как к основной конфигурации, так и к расширению конфигурации.
//
// Параметры:
//  ТипОбъекта - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//               СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - объект метаданных,
//                                   Неопределено - идентификатор не распознан.
//
Функция ОбъектМетаданныхПоТипуОбъекта(ТипОбъекта)
	
	Если Не ЗначениеЗаполнено(ТипОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ТипОбъекта, Ложь);
	Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбъектМетаданных;
	
КонецФункции

// Возвращает объект метаданных по идентификатору типа объекта, если тип поддерживает хранение версий.
//
// Параметры:
//  ТипОбъекта - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//               СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - объект метаданных версионируемого типа,
//                                   Неопределено - тип не распознан или не поддерживает хранение версий.
//
Функция ОбъектМетаданныхВерсионируемогоТипа(ТипОбъекта)
	
	ОбъектМетаданных = ОбъектМетаданныхПоТипуОбъекта(ТипОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЭтоВерсионируемыйТипОбъекта(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОбъектМетаданных;
	
КонецФункции

// Возвращает представление типа объекта метаданных для выбора пользователем.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных.
//
// Возвращаемое значение:
//  Строка - синоним объекта метаданных, при его отсутствии - имя объекта.
//
Функция ПредставлениеТипаОбъекта(ОбъектМетаданных)
	
	Представление = СокрЛП(ОбъектМетаданных.Синоним);
	Если ПустаяСтрока(Представление) Тогда
		Представление = ОбъектМетаданных.Имя;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Возвращает полное имя объекта метаданных по идентификатору типа объекта.
// Учитываются идентификаторы как основной конфигурации, так и расширений конфигурации.
//
// Параметры:
//  ТипОбъекта - СправочникСсылка.ИдентификаторыОбъектовМетаданных,
//               СправочникСсылка.ИдентификаторыОбъектовРасширений - идентификатор типа объекта метаданных.
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных, например "Справочник.Номенклатура";
//           пустая строка - если тип объекта не распознан или не поддерживает хранение версий.
//
Функция ПолноеИмяТипаОбъекта(ТипОбъекта)
	
	ОбъектМетаданных = ОбъектМетаданныхВерсионируемогоТипа(ТипОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(ОбъектМетаданных.ПолноеИмя());
	
КонецФункции

// Возвращает выражение запроса для получения наименования объекта, если оно есть у типа объекта.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы объекта метаданных.
//
// Возвращаемое значение:
//  Строка - выражение запроса, пустая строка - если у объекта нет ни наименования, ни кода.
//
Функция ВыражениеНаименованиеОбъекта(ИмяТаблицы)
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ВозможныеИменаНаименования = Новый Массив;
	ВозможныеИменаНаименования.Добавить("НАИМЕНОВАНИЕ");
	ВозможныеИменаНаименования.Добавить("DESCRIPTION");
	
	ИмяНаименования = ИмяСтандартногоРеквизита(МетаданныеОбъекта, ВозможныеИменаНаименования);
	Если Не ПустаяСтрока(ИмяНаименования) Тогда
		Возврат "Объекты." + ИмяНаименования;
	КонецЕсли;
	
	ВозможныеИменаКода = Новый Массив;
	ВозможныеИменаКода.Добавить("КОД");
	ВозможныеИменаКода.Добавить("CODE");
	
	ИмяКода = ИмяСтандартногоРеквизита(МетаданныеОбъекта, ВозможныеИменаКода);
	Если Не ПустаяСтрока(ИмяКода) Тогда
		Возврат "Объекты." + ИмяКода;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает имя стандартного реквизита объекта метаданных по списку возможных имён.
// У заимствованных объектов стандартные реквизиты могут называться как по-русски,
// так и по-английски, поэтому имя определяется по фактическому составу коллекции.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - объект метаданных;
//  ВозможныеИмена    - Массив из Строка - имена реквизита в верхнем регистре.
//
// Возвращаемое значение:
//  Строка - фактическое имя реквизита, пустая строка - реквизит не найден.
//
Функция ИмяСтандартногоРеквизита(МетаданныеОбъекта, ВозможныеИмена)
	
	Для Каждого ОписаниеРеквизита Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если ВозможныеИмена.Найти(ВРег(СокрЛП(ОписаниеРеквизита.Имя))) <> Неопределено Тогда
			Возврат ОписаниеРеквизита.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Возвращает выражение запроса для отбора неудалённых объектов.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя таблицы объекта метаданных.
//
// Возвращаемое значение:
//  Строка - выражение запроса, пустая строка - если у объекта нет реквизита пометки удаления.
//
Функция ВыражениеПометкиУдаленияОбъекта(ИмяТаблицы)
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ВозможныеИмена = Новый Массив;
	ВозможныеИмена.Добавить("ПОМЕТКАУДАЛЕНИЯ");
	ВозможныеИмена.Добавить("DELETIONMARK");
	
	ИмяРеквизита = ИмяСтандартногоРеквизита(МетаданныеОбъекта, ВозможныеИмена);
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "Объекты." + ИмяРеквизита;
	
КонецФункции

// Заполняет количество версий объектов, изменённых пользователем, одним запросом.
//
// Параметры:
//  ТаблицаОбъектов - ТаблицаЗначений - таблица объектов, см. функцию СписокОбъектовТипа.
//
Процедура ЗаполнитьКоличествоВерсий(ТаблицаОбъектов)
	
	Если ТаблицаОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокОбъектов = Новый Массив;
	Для Каждого СтрокаОбъекта Из ТаблицаОбъектов Цикл
		СписокОбъектов.Добавить(СтрокаОбъекта.Объект);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВерсииОбъектов.Объект КАК Объект,
	|	КОЛИЧЕСТВО(*) КАК КоличествоВерсий
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект В (&СписокОбъектов)
	|	И ВерсииОбъектов.ТипВерсииОбъекта = ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ИзмененоПользователем)
	|СГРУППИРОВАТЬ ПО
	|	ВерсииОбъектов.Объект";
	Запрос.УстановитьПараметр("СписокОбъектов", СписокОбъектов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаОбъекта Из ТаблицаОбъектов.НайтиСтроки(Новый Структура("Объект", Выборка.Объект)) Цикл
			СтрокаОбъекта.КоличествоВерсий = Выборка.КоличествоВерсий;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает сведения о записи версии объекта.
//
// Параметры:
//  Ссылка      - ЛюбаяСсылка - ссылка на версионируемый объект;
//  НомерВерсии - Число, Неопределено - номер версии.
//
// Возвращаемое значение:
//  Структура, Неопределено - сведения о версии: номер версии, дата версии, автор изменения,
//                             комментарий к версии, представление версии для вывода пользователю;
//                             Неопределено - если версия не найдена.
//
Функция СведенияОЗаписиВерсии(Ссылка, НомерВерсии)
	
	Если НомерВерсии = Неопределено Или НомерВерсии <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии,
	|	ВерсииОбъектов.АвторВерсии КАК АвторВерсии,
	|	ВерсииОбъектов.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка
	|	И ВерсииОбъектов.НомерВерсии = &НомерВерсии";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерВерсии", НомерВерсии);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НомерВерсии", НомерВерсии);
	Результат.Вставить("ДатаВерсии", Выборка.ДатаВерсии);
	Результат.Вставить("АвторВерсии", Выборка.АвторВерсии);
	Результат.Вставить("Комментарий", Выборка.Комментарий);
	Результат.Вставить("Представление", ПредставлениеВерсии(НомерВерсии, Выборка.ДатаВерсии, Выборка.АвторВерсии));
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление версии объекта для вывода пользователю.
//
// Параметры:
//  НомерВерсии - Число - номер версии;
//  ДатаВерсии  - Дата - дата записи версии;
//  АвторВерсии - СправочникСсылка.Пользователи, СправочникСсылка.ВнешниеПользователи - автор изменения.
//
// Возвращаемое значение:
//  Строка - представление версии.
//
Функция ПредставлениеВерсии(НомерВерсии, ДатаВерсии, АвторВерсии)
	
	Представление = НСтр("ru = '№'") + " " + Формат(НомерВерсии, "ЧГ=0");
	
	Если ЗначениеЗаполнено(ДатаВерсии) Тогда
		Представление = Представление + " " + НСтр("ru = 'от'") + " " + Формат(ДатаВерсии, "ДЛФ=DT");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АвторВерсии) Тогда
		Представление = Представление + ", " + Строка(АвторВерсии);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Возвращает таблицу реквизитов объекта, сохранённых в указанной версии.
//
// Параметры:
//  Ссылка      - ЛюбаяСсылка - ссылка на версионируемый объект;
//  НомерВерсии - Число - номер версии.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * НаименованиеРеквизита - Строка - имя реквизита;
//   * ЗначениеРеквизита     - Произвольный - значение реквизита.
//
Функция РеквизитыВерсии(Ссылка, НомерВерсии)
	
	Попытка
		ОписаниеВерсии = ВерсионированиеОбъектов.РазборВерсии(Ссылка, НомерВерсии);
	Исключение
		Возврат Новый ТаблицаЗначений;
	КонецПопытки;
	
	Если ОписаниеВерсии.Свойство("Реквизиты") И ОписаниеВерсии.Реквизиты <> Неопределено Тогда
		Возврат ОписаниеВерсии.Реквизиты;
	КонецЕсли;
	
	Возврат Новый ТаблицаЗначений;
	
КонецФункции

// Возвращает представление значения реквизита для вывода в таблице различий.
//
// Параметры:
//  Значение - Произвольный - значение реквизита.
//
// Возвращаемое значение:
//  Строка - представление значения.
//
Функция ПредставлениеЗначенияРеквизита(Значение)
	
	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

// Определяет, все ли значения в массиве одинаковы.
//
// Параметры:
//  Значения - Массив из Строка - значения для сравнения.
//
// Возвращаемое значение:
//  Булево - Истина, если все значения одинаковы.
//
Функция ВсеЗначенияРавны(Значения)
	
	Если Значения.Количество() <= 1 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПервоеЗначение = Значения[0];
	Для Индекс = 1 По Значения.Количество() - 1 Цикл
		Если Значения[Индекс] <> ПервоеЗначение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
