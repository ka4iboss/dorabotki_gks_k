// Общий модуль ГКСИ_ГруппыСценариевСервер.
#Область СлужебныйПрограммныйИнтерфейс

// Добавляет сценарий в указанную группу. Идемпотентно: повторный вызов с теми же
// аргументами не создаёт дубль. Проверяет отсутствие цикла в иерархии групп.
//
// Добавляет Сценарий в Группу: создаёт/обновляет запись регистра и проверяет,
// что в иерархии групп не возникает цикла (это защита от ошибок данных,
// которые привели бы к бесконечной рекурсии в ПолныйКодГруппыГрафа).
//
// Допускает самоссылку только для корневой обёртки инструкции через отдельную
// процедуру ЗарегистрироватьКорневуюГруппуИнструкции. Здесь — без неё.
//
// Параметры:
//  Сценарий         - CatalogRef.ДемонстрационныеСценарии - добавляемый элемент.
//  Группа           - CatalogRef.ДемонстрационныеСценарии - целевая группа.
//  КореньИнструкции - CatalogRef.ДемонстрационныеСценарии - корень инструкции,
//                     к которой относятся оба (для оптимизации пересчёта по
//                     поддереву). Если не передан - старая логика (без корня).
//
Процедура ДобавитьСценарийВГруппу(Сценарий, Группа, КореньИнструкции = Неопределено) Экспорт


	Если Не ЗначениеЗаполнено(Сценарий)
		Или Не ЗначениеЗаполнено(Группа)
		Или Сценарий = Группа Тогда
		Возврат;
	КонецЕсли;

	Если ЕстьЦиклВГруппах(Сценарий, Группа) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Невозможно добавить ""%1"" в группу ""%2"": обнаружен цикл в иерархии групп.'"),
			Сценарий,
			Группа);
	КонецЕсли;

	// Сначала записываем связь в регистр с пустым кодом: без этого шага граф,
	// который строится следующим вызовом, ещё не содержит новой связи, и
	// ГКСИ_ПозицияСиблингаГрафа вернёт пустую строку. Итоговый ПолныйКод будет
	// состоять только из кодов групп-предков (например, "<код корня>.") и не
	// будет содержать позицию самого сценария.
	ГКСИ_ЗаписатьПолныйКодКонтекстный(Сценарий, Группа, "", КореньИнструкции);

	// Теперь связь уже в регистре, и пересчёт найдёт сценарий среди членов
	// группы и присвоит ему корректную позицию (ЧЦ=3; ЧВН=).
	ЗаписатьПолныйКодКонтекстный(Сценарий, Группа, КореньИнструкции);

КонецПроцедуры

// Регистрирует корневую группу-обёртку инструкции (Уровень = 1) в регистре
// ГКСИ_ГруппыСценариев как самоссылку (Сценарий = Группа = КореньИнструкции).
//
// Форма ФормаСпискаДеревоГрупп находит запись по КодВКонтексте = "<КодСправочника>"
// и берёт реальное имя обёртки из КэшПоСсылке (см. ГКСИ_ПостроитьДерево /
// ГКСИ_СоздатьСтрокуДерева, блок 1) - иначе рисует фиктивный узел
// Наименование = КодВКонтексте (блок 2).
//
// Самоссылка разрешена только для корневых групп инструкций; в общем случае
// ДобавитьСценарийВГруппу отвергает самоссылку (там же проверка
// "Сценарий = Группа" → Возврат).
//
// Код справочника берётся прямым запросом, потому что:
//   - ОбщегоНазначения.ЗначениеРеквизитаОбъекта() может вернуть пустую строку для
//     группы справочника (по историческим багам БСП);
//   - обращение через ссылку на группу в некоторых сценариях даёт Неопределено.
//
// Запись идемпотентна: повторный вызов с теми же аргументами не плодит дублей
// (используется отбор по всем трём измерениям).
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии - ссылка на группу-обёртку.
//
Процедура ЗарегистрироватьКорневуюГруппуИнструкции(Сценарий) Экспорт

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат;
	КонецЕсли;

	КодСценария = ГКСИ_ПолучитьКодСправочникаНапрямую(Сценарий);
	Если Не ЗначениеЗаполнено(КодСценария) Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ГКСИ_ГруппыСценариев.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Сценарий.Установить(Сценарий);
	НаборЗаписей.Отбор.Группа.Установить(Сценарий);
	НаборЗаписей.Отбор.КореньИнструкции.Установить(Сценарий);

	Запись = НаборЗаписей.Добавить();
	Запись.Сценарий             = Сценарий;
	Запись.Группа               = Сценарий;
	Запись.КореньИнструкции     = Сценарий;
	Запись.ПолныйКодКонтекстный = "";
	Запись.КодВКонтексте        = КодСценария;

	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает следующий по порядку код для новой корневой группы-обёртки инструкции.
//
// Корневые обёртки нумеруются последовательно среди служебных групп с самоссылкой
// в РС (Сценарий = Группа = КореньИнструкции). При первой загрузке возвращает "001",
// при второй - "002" и т.д. Это обеспечивает читаемую иерархию в форме списка и
// отличает корневые обёртки инструкций от обычных групп (коды которых назначаются
// платформой автоматически как MAX(Код)+1 по всему справочнику и могут идти
// вперемешку с кодами элементов дочерних инструкций).
//
// Тип Код справочника ДемонстрационныеСценарии в ERP - Строка (переменной длины).
// EDT статически не может разрешить тип заимствованного реквизита и предполагает
// Число по умолчанию, поэтому в коде ниже используется явное приведение через
// Строка()/Число() с защитой от исключений.
//
// Алгоритм: один запрос к регистру (фильтр по самоссылкам) + один запрос к
// справочнику за кодами. Два запроса вместо одного объединённого - для ясности
// и для исключения проблем с RLS на справочник.
//
// Возвращаемое значение:
//  Строка - следующий код в формате "ЧЦ=3; ЧВН=" (например, "001", "017", "142").
//           Если корневых обёрток ещё нет - возвращается "001".
//
Функция ГКСИ_ПолучитьСледующийКодКорневойОбёртки() Экспорт

	// Собираем все корни инструкций (ссылки на группы-обёртки) через РС -
	// это служебный маркер "корневая обёртка", отличающий её от обычных групп.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.Сценарий = ГКСИ_ГруппыСценариев.Группа
	|	И ГКСИ_ГруппыСценариев.Сценарий = ГКСИ_ГруппыСценариев.КореньИнструкции");
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "001";
	КонецЕсли;

	МассивКорней = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивКорней.Добавить(Выборка.КореньИнструкции);
	КонецЦикла;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Спр.Код КАК Код
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр
	|ГДЕ
	|	Спр.Ссылка В(&МассивКорней)");
	Запрос.УстановитьПараметр("МассивКорней", МассивКорней);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "001";
	КонецЕсли;

	// Код в БД может быть строкой ("001", "017"), числом или пустым (не заполнен).
	// Приводим к числу явно - если не парсится (мусор, NULL, пустая строка),
	// пропускаем такую запись. Иначе "Если Код > МаксКод" упадёт на runtime:
	// "Операции сравнения на больше-меньше допустимы только для значений
	// совпадающих примитивных типов" (это наблюдалось в продакшне при первой
	// загрузке инструкции, где у одной из существующих корневых обёрток код был
	// в неожиданном формате).
	МаксЧисловойКод = 0;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ЧисловойКод = Число(Строка(Выборка.Код));
		Исключение
			Продолжить;
		КонецПопытки;
		Если ЧисловойКод > МаксЧисловойКод Тогда
			МаксЧисловойКод = ЧисловойКод;
		КонецЕсли;
	КонецЦикла;

	Возврат Формат(МаксЧисловойКод + 1, "ЧЦ=3; ЧВН=");

КонецФункции

// Возвращает строковый код справочника ДемонстрационныеСценарии по ссылке.
// Работает и для групп, и для элементов: один запрос с ГДЕ Ссылка = &Ссылка.
// Возвращает пустую строку, если ссылка пустая или элемент не найден.
//
// Параметры:
//   Ссылка - CatalogRef.ДемонстрационныеСценарии - ссылка на группу или элемент.
//
// Возвращаемое значение:
//   Строка - код справочника, или "" если элемент не найден.
//
Функция ГКСИ_ПолучитьКодСправочникаНапрямую(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Спр.Код КАК Код
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр
	|ГДЕ
	|	Спр.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Строка(Выборка.Код);

КонецФункции

// Удаляет связь сценария с группой. Если такой связи нет - без ошибок.
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии
//  Группа   - CatalogRef.ДемонстрационныеСценарии
//
Процедура УдалитьСценарийИзГруппы(Сценарий, Группа) Экспорт

	Если Не ЗначениеЗаполнено(Сценарий) Или Не ЗначениеЗаполнено(Группа) Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ГКСИ_ГруппыСценариев.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Сценарий.Установить(Сценарий);
	НаборЗаписей.Отбор.Группа.Установить(Группа);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает массив групп, в которые непосредственно входит сценарий.
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии
//  Граф     - Структура - см. ГКСИ_ГрафГрупп().
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии
//
Функция ПолучитьГруппыСценарияГрафа(Сценарий, Граф)

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Результат;
	КонецЕсли;

	Родители = Граф.РодителиГрупп.Получить(Сценарий);
	Если Родители <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Родители Цикл
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает массив групп, в которые непосредственно входит сценарий.
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии
//
Функция ПолучитьГруппыСценария(Сценарий) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат Результат;
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();
	Родители = Граф.РодителиГрупп.Получить(Сценарий);
	Если Родители <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Родители Цикл
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает массив элементов (не групп), непосредственно входящих в указанную группу.
//
// Параметры:
//  Группа - CatalogRef.ДемонстрационныеСценарии
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии
//
Функция ПолучитьСценарииГруппы(Группа) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Результат;
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();
	ЧленыГруппы = Граф.ЧленыГрупп.Получить(Группа);
	Если ЧленыГруппы <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ЧленыГруппы Цикл
			ЧленГруппы = КлючИЗначение.Ключ;
			ЭтоГруппаЧлена = Граф.ЭтоГруппа.Получить(ЧленГруппы);
			Если ЭтоГруппаЧлена = Ложь ИЛИ ЭтоГруппаЧлена = Неопределено Тогда
				Результат.Добавить(ЧленГруппы);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает массив всех членов группы (элементов и подгрупп), для которых
// Группа указана как непосредственный родитель.
//
// Параметры:
//  Группа - CatalogRef.ДемонстрационныеСценарии
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии
//
Функция ПолучитьЧленовГруппы(Группа) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Результат;
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();
	ЧленыГруппы = Граф.ЧленыГрупп.Получить(Группа);
	Если ЧленыГруппы <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ЧленыГруппы Цикл
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает массив групп, транзитивно вложенных в указанную группу
// (включая саму группу как первый элемент).
//
// Параметры:
//  Группа - CatalogRef.ДемонстрационныеСценарии
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии
//
Функция ПолучитьПотомковГруппы(Группа) Экспорт

	Результат = Новый Массив;

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Результат;
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();
	ГКСИ_СобратьПотомковРекурсивно(Группа, Результат, Граф, Новый Соответствие);

	Возврат Результат;

КонецФункции

// Возвращает непосредственную родительскую группу для указанной группы
// или пустую ссылку, если группа является корневой.
//
// Параметры:
//  Группа - CatalogRef.ДемонстрационныеСценарии
//
// Возвращаемое значение:
//  CatalogRef.ДемонстрационныеСценарии
//
Функция ПолучитьРодительскуюГруппу(Группа) Экспорт

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Справочники.ДемонстрационныеСценарии.ПустаяСсылка();
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();
	Родители = Граф.РодителиГрупп.Получить(Группа);
	Если Родители <> Неопределено И Родители.Количество() > 0 Тогда
		Для Каждого КлючИЗначение Из Родители Цикл
			Возврат КлючИЗначение.Ключ;
		КонецЦикла;
	КонецЕсли;

	Возврат Справочники.ДемонстрационныеСценарии.ПустаяСсылка();

КонецФункции

// Проверяет, что добавление Сценария как члена Группа не приведёт к циклу
// в иерархии групп. Цикл возникает, если Сценарий уже встречается в цепочке
// предков Группа.
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии - кандидат на включение в Группа.
//  Группа   - CatalogRef.ДемонстрационныеСценарии - родительская группа.
//
// Возвращаемое значение:
//  Булево - Истина, если добавление создаст цикл.
//
Функция ЕстьЦиклВГруппах(Сценарий, Группа) Экспорт

	Граф = ГКСИ_ГрафГрупп();
	ТекущаяГруппа = Группа;
	Обработанные = Новый Соответствие;

	Пока ЗначениеЗаполнено(ТекущаяГруппа) Цикл

		Если ТекущаяГруппа = Сценарий Тогда
			Возврат Истина;
		КонецЕсли;

		Если Обработанные[ТекущаяГруппа] = Истина Тогда
			Возврат Истина;
		КонецЕсли;
		Обработанные.Вставить(ТекущаяГруппа, Истина);

		Родители = Граф.РодителиГрупп.Получить(ТекущаяГруппа);
		Если Родители = Неопределено ИЛИ Родители.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Для Каждого КлючИЗначение Из Родители Цикл
			ТекущаяГруппа = КлючИЗначение.Ключ;
			Прервать;
		КонецЦикла;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает позицию элемента среди прямых сиблингов родительской группы,
// отсортированных по системному Коду. Используется для построения
// контекстного кода, где вторая и последующие позиции обозначают место
// члена внутри его родительской группы, а не системный код.
//
// Параметры:
//  ЧленГруппы - CatalogRef.ДемонстрационныеСценарии - элемент или группа,
//               для которого нужно вычислить позицию.
//  Родитель   - CatalogRef.ДемонстрационныеСценарии - группа, среди прямых
//               членов которой ищется позиция.
//  Граф       - Структура - см. ГКСИ_ГрафГрупп().
//
// Возвращаемое значение:
//  Строка - позиция в формате "ЧЦ=3; ЧВН=" (например, "001", "017").
//           Пустая строка, если ЧленГруппы не найден среди прямых членов
//           Родителя или параметры не заполнены.
//
Функция ГКСИ_ПозицияСиблингаГрафа(ЧленГруппы, Родитель, Граф)

	Если Не ЗначениеЗаполнено(ЧленГруппы) Или Не ЗначениеЗаполнено(Родитель) Тогда
		Возврат "";
	КонецЕсли;

	ЧленыГруппы = Граф.ЧленыГрупп.Получить(Родитель);
	Если ЧленыГруппы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ЧленыГруппы.Получить(ЧленГруппы) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	СписокЧленов = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из ЧленыГруппы Цикл
		ТекущийЧлен = КлючИЗначение.Ключ;
		СписокЧленов.Добавить(ТекущийЧлен, Строка(Граф.КодыПоСсылкам.Получить(ТекущийЧлен)));
	КонецЦикла;
	СписокЧленов.СортироватьПоПредставлению();

	// НайтиПоЗначению возвращает ЭлементСпискаЗначений, а не индекс, поэтому
	// перебираем список вручную.
	Индекс = -1;
	Для Сч = 0 По СписокЧленов.Количество() - 1 Цикл
		Если СписокЧленов[Сч].Значение = ЧленГруппы Тогда
			Индекс = Сч;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Индекс = -1 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Индекс + 1, "ЧЦ=3; ЧВН=");

КонецФункции

// Возвращает полный код сценария в контексте конкретной группы.
//
// Алгоритм — простая рекурсия по парам (Сценарий, Группа), как в регистре:
//   ПолныйКод(S, G) = ПолныйКодГруппы(G) + "." + ПозицияСиблинга(S, G)
//   ПолныйКодГруппы(G) = СистемныйКод(G), если G — корень;
//                       иначе ПолныйКодГруппы(РодительG) + "." + ПозицияСиблинга(G, РодительG).
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии
//  Группа   - CatalogRef.ДемонстрационныеСценарии - контекстная группа; если
//             не заполнена, возвращается только собственный код Сценария.
//  Граф     - Структура - см. ГКСИ_ГрафГрупп().
//
// Возвращаемое значение:
//  Строка - путь вида "Корневая.Промежуточная.Группа.Сценарий".
//
Функция ПолныйПолныйКодКонтекстныйГрафа(Сценарий, Группа, Граф)

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат "";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат Формат(Граф.КодыПоСсылкам.Получить(Сценарий), "ЧЦ=3; ЧВН=; ЧГ=");
	КонецЕсли;

	ПозицияСиблинга = ГКСИ_ПозицияСиблингаГрафа(Сценарий, Группа, Граф);
	КодГруппы       = ПолныйКодГруппыГрафа(Группа, Граф);

	Возврат КодГруппы + "." + ПозицияСиблинга;

КонецФункции

// Собирает собственный код Группы рекурсивно: для корня — её системный код,
// для вложенной — код родителя плюс её позиция среди сиблингов родителя.
// У иерархического узла берётся первый встреченный родитель (один родитель
// на группу в текущей модели данных).
//
Функция ПолныйКодГруппыГрафа(Группа, Граф)

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат "";
	КонецЕсли;

	Родители = Граф.РодителиГрупп.Получить(Группа);

	Если Родители = Неопределено ИЛИ Родители.Количество() = 0 Тогда
		Возврат Формат(Граф.КодыПоСсылкам.Получить(Группа), "ЧЦ=3; ЧВН=; ЧГ=");
	КонецЕсли;

	Родитель = Неопределено;
	Для Каждого КлючИЗначение Из Родители Цикл
		Родитель = КлючИЗначение.Ключ;
		Прервать;
	КонецЦикла;

	// Самоссылка корневой обёртки инструкции (Сценарий = Группа = КореньИнструкции):
	// в графе она отфильтрована в ГКСИ_ГрафГрупп, но на всякий случай — защита:
	// возвращаем собственный системный код, иначе рекурсия уходит в переполнение стека.
	Если Родитель = Группа Тогда
		Возврат Формат(Граф.КодыПоСсылкам.Получить(Группа), "ЧЦ=3; ЧВН=; ЧГ=");
	КонецЕсли;

	КодРодителя = ПолныйКодГруппыГрафа(Родитель, Граф);
	Позиция     = ГКСИ_ПозицияСиблингаГрафа(Группа, Родитель, Граф);

	Возврат КодРодителя + "." + Позиция;

КонецФункции

// Строит графы по списку корней инструкций без запроса в цикле
// (для соблюдения SU95). Используется из нескольких функций пересчёта
// кодов (ПересчитатьПолныйКодКонтекстныйДляСценария,
// ПересчитатьПолныйКодДляПоддерева), которым нужно получить графы
// конкретных корней.
//
// Внутри - один пакетный запрос к РС (фильтр по списку корней) и один
// запрос к справочнику кодов. Графы собираются через
// ГКСИ_СобратьГрафГруппПоСвязям без обращения к СУБД.
//
// Параметры:
//  МассивКорней - Массив из CatalogRef.ДемонстрационныеСценарии - корни,
//                 для которых нужно построить графы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ CatalogRef.ДемонстрационныеСценарии
//                  (корень), значение Структура (граф, см. ГКСИ_ГрафГрупп()).
//
//@skip-warning SU95
Функция ГКСИ_ПостроитьГрафыПоКорнямБезЗапросаВЦикле(МассивКорней)

	ГрафыПоКорням = Новый Соответствие;

	Если МассивКорней.Количество() = 0 Тогда
		Возврат ГрафыПоКорням;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Корни", МассивКорней);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.КореньИнструкции В(&Корни)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр";

	РезультатПакета = Запрос.ВыполнитьПакет();

	КодыПоСсылкам = Новый Соответствие;
	ЭтоГруппа     = Новый Соответствие;
	ВыборкаСпр = РезультатПакета[1].Выбрать();
	Пока ВыборкаСпр.Следующий() Цикл
		КодыПоСсылкам.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.Код);
		ЭтоГруппа.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.ЭтоГруппа);
	КонецЦикла;

	СвязиПоКорням = Новый Соответствие;
	Выборка = РезультатПакета[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Связи = СвязиПоКорням.Получить(Выборка.КореньИнструкции);
		Если Связи = Неопределено Тогда
			Связи = Новый Массив;
			СвязиПоКорням.Вставить(Выборка.КореньИнструкции, Связи);
		КонецЕсли;
		Связи.Добавить(Новый Структура("Сценарий, Группа",
			Выборка.Сценарий, Выборка.Группа));
	КонецЦикла;

	Для Каждого КлючИЗначение Из СвязиПоКорням Цикл
		ГрафыПоКорням.Вставить(КлючИЗначение.Ключ,
			ГКСИ_СобратьГрафГруппПоСвязям(КлючИЗначение.Значение, КодыПоСсылкам, ЭтоГруппа));
	КонецЦикла;

	Возврат ГрафыПоКорням;

КонецФункции

// Возвращает полный код сценария в контексте конкретной группы с учётом
// иерархии групп через цепочку родительских групп в регистре.
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии
//  Группа   - CatalogRef.ДемонстрационныеСценарии - контекстная группа; если
//             не заполнена, возвращается только код сценария.
//
// Возвращаемое значение:
//  Строка - путь вида "Корневая.Промежуточная.Группа.Сценарий".
//
//@skip-warning SU95
Функция ПолныйПолныйКодКонтекстный(Сценарий, Группа) Экспорт

	Возврат ПолныйПолныйКодКонтекстныйГрафа(Сценарий, Группа, ГКСИ_ГрафГрупп());

КонецФункции

// Пересчитывает ресурс ПолныйКодКонтекстный для всех записей регистра,
// в которых Сценарий равен указанному.
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии
//
Процедура ПересчитатьПолныйКодКонтекстныйДляСценария(Сценарий) Экспорт

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат;
	КонецЕсли;

	// Первый запрос: записи по сценарию.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.Сценарий = &Сценарий";

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Группируем записи по корню инструкции, чтобы для каждой записи
	// пересчёт шёл на графе своего корня. Без этой фильтрации общий граф
	// содержит обоих родителей общих узлов (ДМТО и ГИП), и ПолныйКодГруппыГрафа
	// через "Для Каждого ... Прервать" берёт первого попавшегося - в
	// результате для ГИП-записи в ГИП-контексте возвращался ДМТО-родитель
	// и код формировался как "001.007.xxx" вместо корректного "018.003.xxx".
	ВсеЗаписи    = Новый Массив;
	КорниСценария = Новый Массив;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		// Самоссылка корневой обёртки инструкции (Сценарий = Группа) не пересчитывается:
		// её ПолныйКодКонтекстный всегда "" и КодВКонтексте = системный код корня
		// (см. ЗарегистрироватьКорневуюГруппуИнструкции). Без пропуска
		// ПолныйПолныйКодКонтекстныйГрафа через ПолныйКодГруппыГрафа возвращает
		// "001." (с хвостовой точкой), и КодВКонтексте перетирается на "001.001." —
		// форма списка перестаёт находить корни (ГКСИ_ПостроитьДерево).
		Если Выборка.Группа = Сценарий Тогда
			Продолжить;
		КонецЕсли;
		ВсеЗаписи.Добавить(Новый Структура("Группа, КореньИнструкции",
			Выборка.Группа, Выборка.КореньИнструкции));
		Если ЗначениеЗаполнено(Выборка.КореньИнструкции)
				И КорниСценария.Найти(Выборка.КореньИнструкции) = Неопределено Тогда
			КорниСценария.Добавить(Выборка.КореньИнструкции);
		КонецЕсли;
	КонецЦикла;

	ГрафыПоКорням = ГКСИ_ПостроитьГрафыПоКорнямБезЗапросаВЦикле(КорниСценария);
	ГрафОбщий = ГКСИ_ГрафГрупп();

	Для Каждого Запись Из ВсеЗаписи Цикл
		Граф = ГрафОбщий;
		Если ЗначениеЗаполнено(Запись.КореньИнструкции) Тогда
			ГрафДляКорня = ГрафыПоКорням.Получить(Запись.КореньИнструкции);
			Если ГрафДляКорня <> Неопределено Тогда
				Граф = ГрафДляКорня;
			КонецЕсли;
		КонецЕсли;
		ПолныйКод = ГКСИ_ПолныйКодПоГрафу(Сценарий, Запись.Группа, Граф);
		ГКСИ_ЗаписатьПолныйКодКонтекстный(Сценарий, Запись.Группа, ПолныйКод, Запись.КореньИнструкции);
	КонецЦикла;

КонецПроцедуры

// Пересчитывает ресурс ПолныйКодКонтекстный для всех записей регистра,
// затрагиваемых изменением группы (сама группа и всё её поддерево).
// Принимает уже загруженный граф - для безопасного вызова в циклах.
//
// Параметры:
//  Группа - CatalogRef.ДемонстрационныеСценарии
//  Граф   - Структура - см. ГКСИ_ГрафГрупп().
//
//@skip-warning SU95
// Запрос внутри допустим: вызывается из СинхронизироватьГруппыСценария в цикле
// по управляемому списку групп одного элемента (не по записям регистра), и
// запрос здесь обязателен — нужны актуальные КореньИнструкции из БД.
//
Процедура ПересчитатьПолныйКодДляПоддереваГрафа(Группа, Граф)

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат;
	КонецЕсли;

	МассивГруппПоддерева = Новый Массив;
	ГКСИ_СобратьПотомковРекурсивно(Группа, МассивГруппПоддерева, Граф, Новый Соответствие);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивГрупп", МассивГруппПоддерева);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.Группа В(&МассивГрупп)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Самоссылка корневой обёртки инструкции (Сценарий = Группа) — служебная
		// запись для формы списка; её КодВКонтексте задаётся отдельно в
		// ЗарегистрироватьКорневуюГруппуИнструкции и здесь не пересчитывается.
		// Без пропуска пересчёт выдаёт "001." (пустая позиция сиблинга), а
		// ГКСИ_ЗаписатьПолныйКодКонтекстный добавляет префикс КодКорня — получается
		// "001.001.", что порождает лишний узел в дереве формы.
		Если Выборка.Сценарий = Выборка.Группа Тогда
			Продолжить;
		КонецЕсли;
		ПолныйКод = ГКСИ_ПолныйКодПоГрафу(Выборка.Сценарий, Выборка.Группа, Граф);
		ГКСИ_ЗаписатьПолныйКодКонтекстный(Выборка.Сценарий, Выборка.Группа, ПолныйКод, Выборка.КореньИнструкции);
	КонецЦикла;

КонецПроцедуры

// Пересчитывает ресурс ПолныйКодКонтекстный для всех записей регистра,
// затрагиваемых изменением группы (сама группа и всё её поддерево).
//
// Параметры:
//  Группа - CatalogRef.ДемонстрационныеСценарии
//
// Пересчитывает ресурс ПолныйКодКонтекстный для всех записей регистра,
// затрагиваемых изменением группы (сама группа и всё её поддерево).
//
// Алгоритм: собираем поддерево через общий граф (один раз, без запросов в
// цикле), затем одним пакетным запросом получаем все записи РС для этого
// поддерева и список корней. Графы по корням строятся через
// ГКСИ_ПостроитьГрафыПоКорнямБезЗапросаВЦикле, и для каждой записи
// пересчёт идёт на графе своего корня. Без этого общий граф содержит оба
// корня для общих узлов, и ПолныйКодГруппыГрафа через "Для Каждого ...
// Прервать" берёт первого попавшегося родителя - в результате для ГИП-
// записи в ГИП-контексте возвращался ДМТО-родитель и код формировался как
// "001.007.xxx" вместо корректного "018.003.xxx".
//
//@skip-warning SU95
Процедура ПересчитатьПолныйКодДляПоддерева(Группа) Экспорт

	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат;
	КонецЕсли;

	ГрафОбщий = ГКСИ_ГрафГрупп();

	// Собираем всех потомков группы (только группы) через общий граф.
	// Поддерево одинаково по всем корням, потому что общий граф содержит
	// все связи; разделение по корням происходит уже в запросе ниже.
	МассивГруппПоддерева = Новый Массив;
	ГКСИ_СобратьПотомковРекурсивно(Группа, МассивГруппПоддерева, ГрафОбщий, Новый Соответствие);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивГрупп", МассивГруппПоддерева);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции,
	|	ГКСИ_ГруппыСценариев.ПолныйКодКонтекстный КАК ПолныйКодКонтекстный,
	|	ГКСИ_ГруппыСценариев.КодВКонтексте КАК КодВКонтексте
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.Группа В(&МассивГрупп)";

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	ВсеЗаписи   = Новый Массив;
	КорниГруппы = Новый Массив;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Сценарий", Выборка.Сценарий);
		Запись.Вставить("Группа", Выборка.Группа);
		Запись.Вставить("КореньИнструкции", Выборка.КореньИнструкции);
		Запись.Вставить("ПолныйКодКонтекстный", Выборка.ПолныйКодКонтекстный);
		Запись.Вставить("КодВКонтексте", Выборка.КодВКонтексте);
		ВсеЗаписи.Добавить(Запись);
		// Самоссылка корневой обёртки (Сценарий = Группа = КореньИнструкции)
		// не пересчитывается: её ПолныйКодКонтекстный всегда "" и КодВКонтексте
		// = системный код корня (см. ЗарегистрироватьКорневуюГруппуИнструкции).
		// Без пропуска ПолныйКодКонтекстный перетирается на "<Код>." (с хвостовой
		// точкой) — форма списка ФормаСпискаДеревоГрупп может потерять корень.
		Если Выборка.Сценарий <> Выборка.Группа
				И ЗначениеЗаполнено(Выборка.КореньИнструкции)
				И КорниГруппы.Найти(Выборка.КореньИнструкции) = Неопределено Тогда
			КорниГруппы.Добавить(Выборка.КореньИнструкции);
		КонецЕсли;
	КонецЦикла;

	ГрафыПоКорням = ГКСИ_ПостроитьГрафыПоКорнямБезЗапросаВЦикле(КорниГруппы);

	// Все записи поддерева пишутся одним набором: отдельная запись на каждый узел
	// держала транзакцию и блокировки и вешала базу при сохранении группы.
	НаборЗаписей = РегистрыСведений.ГКСИ_ГруппыСценариев.СоздатьНаборЗаписей();

	Для Каждого Запись Из ВсеЗаписи Цикл

		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Сценарий         = Запись.Сценарий;
		НоваяЗапись.Группа           = Запись.Группа;
		НоваяЗапись.КореньИнструкции = Запись.КореньИнструкции;

		Если Запись.Сценарий = Запись.Группа Тогда
			// Самоссылку корневой обёртки оставляем без изменений (см. выше).
			НоваяЗапись.ПолныйКодКонтекстный = Запись.ПолныйКодКонтекстный;
			НоваяЗапись.КодВКонтексте        = Запись.КодВКонтексте;
			Продолжить;
		КонецЕсли;

		Граф = ГрафОбщий;
		Если ЗначениеЗаполнено(Запись.КореньИнструкции) Тогда
			ГрафДляКорня = ГрафыПоКорням.Получить(Запись.КореньИнструкции);
			Если ГрафДляКорня <> Неопределено Тогда
				Граф = ГрафДляКорня;
			КонецЕсли;
		КонецЕсли;

		ПолныйКод = ГКСИ_ПолныйКодПоГрафу(Запись.Сценарий, Запись.Группа, Граф);
		НоваяЗапись.ПолныйКодКонтекстный = ПолныйКод;

		// В ресурс КодВКонтексте пишется полный путь узла от корня инструкции
		// (см. комментарии в ГКСИ_ЗаписатьПолныйКодКонтекстный).
		Если ЗначениеЗаполнено(Запись.КореньИнструкции) Тогда
			НоваяЗапись.КодВКонтексте = ПолныйКод;
		Иначе
			НоваяЗапись.КодВКонтексте = Запись.КодВКонтексте;
		КонецЕсли;

	КонецЦикла;

	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Записать(РежимЗамещения.Слияние);
	КонецЕсли;

КонецПроцедуры

// Полностью пересчитывает ресурс ПолныйКодКонтекстный для всех пар
// (Сценарий, Группа), уже записанных в регистре. Используется для
// восстановления кодов после смены алгоритма нумерации или ручного
// изменения системных Кодов справочника.
//
// Пересчёт выполняется от корня к листьям через рекурсивный обход
// (ПолныйПолныйКодКонтекстныйГрафа → ПолныйКодГруппыГрафа), поэтому результат
// корректен даже если часть записей содержит устаревшие значения.
//
// Важно: записи группируются по измерению КореньИнструкции и пересчитываются
// на отдельных графах, собранных через ГКСИ_СобратьГрафГруппПоСвязям.
// Без этой фильтрации общий граф содержит оба корня для общих узлов
// (например, "Согласование ТКП" лежит и в ДМТО, и в ГИП), и
// ПолныйКодГруппыГрафа через "Для Каждого ... Прервать" берёт первого
// попавшегося родителя - в результате для ГИП-записи в ГИП-контексте
// возвращался ДМТО-родитель и код формировался как "001.007.xxx"
// вместо корректного "018.003.xxx".
//
// Все запросы вынесены наружу, чтобы не дёргать СУБД из циклов (SU95):
// один запрос к регистру + один запрос к справочнику, дальше работа
// только с уже загруженными коллекциями.
//
//@skip-warning SU95
Процедура ГКСИ_ПересчитатьВсеКодыВРегистре() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр";

	РезультатПакета = Запрос.ВыполнитьПакет();

	Если РезультатПакета[0].Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Загружаем справочник кодов/признака группы один раз.
	КодыПоСсылкам = Новый Соответствие;
	ЭтоГруппа     = Новый Соответствие;
	ВыборкаСпр = РезультатПакета[1].Выбрать();
	Пока ВыборкаСпр.Следующий() Цикл
		КодыПоСсылкам.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.Код);
		ЭтоГруппа.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.ЭтоГруппа);
	КонецЦикла;

	// Группируем записи по корню: отдельно все записи (для иттерации)
	// и отдельно связи по корню (для построения графов по корням).
	ВсеЗаписи     = Новый Массив;
	СвязиПоКорням = Новый Соответствие;
	Выборка = РезультатПакета[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		// Самоссылка корневой обёртки инструкции (Сценарий = Группа = КореньИнструкции)
		// не пересчитывается: её ПолныйКодКонтекстный всегда "" и КодВКонтексте = системный
		// код корня (см. ЗарегистрироватьКорневуюГруппуИнструкции). Без этого пропуска
		// ПолныйПолныйКодКонтекстныйГрафа через ПолныйКодГруппыГрафа возвращает
		// "001." (с хвостовой точкой), и КодВКонтексте перетирается на "001.001." —
		// форма списка перестаёт находить корни (ГКСИ_ПостроитьДерево).
		Если Выборка.Сценарий = Выборка.Группа Тогда
			Продолжить;
		КонецЕсли;
		ВсеЗаписи.Добавить(Новый Структура("Сценарий, Группа, КореньИнструкции",
			Выборка.Сценарий, Выборка.Группа, Выборка.КореньИнструкции));
		Если ЗначениеЗаполнено(Выборка.КореньИнструкции) Тогда
			Связи = СвязиПоКорням.Получить(Выборка.КореньИнструкции);
			Если Связи = Неопределено Тогда
				Связи = Новый Массив;
				СвязиПоКорням.Вставить(Выборка.КореньИнструкции, Связи);
			КонецЕсли;
			Связи.Добавить(Новый Структура("Сценарий, Группа",
				Выборка.Сценарий, Выборка.Группа));
		КонецЕсли;
	КонецЦикла;

	// Строим граф по каждому корню заранее - внутри ГКСИ_СобратьГрафГруппПоСвязям
	// запросов нет, только работа с переданными данными.
	ГрафыПоКорням = Новый Соответствие;
	Для Каждого КлючИЗначение Из СвязиПоКорням Цикл
		ГрафыПоКорням.Вставить(КлючИЗначение.Ключ,
			ГКСИ_СобратьГрафГруппПоСвязям(КлючИЗначение.Значение, КодыПоСсылкам, ЭтоГруппа));
	КонецЦикла;
	// Общий граф используется для записей без КорняИнструкции (старая логика,
	// до миграции на измерение КореньИнструкции) - у них иерархия берётся
	// как была, без фильтрации по инструкции.
	ГрафОбщий = ГКСИ_ГрафГрупп();

	Для Каждого Запись Из ВсеЗаписи Цикл
		Граф = ГрафОбщий;
		Если ЗначениеЗаполнено(Запись.КореньИнструкции) Тогда
			ГрафДляКорня = ГрафыПоКорням.Получить(Запись.КореньИнструкции);
			Если ГрафДляКорня <> Неопределено Тогда
				Граф = ГрафДляКорня;
			КонецЕсли;
		КонецЕсли;
		ПолныйКод = ПолныйПолныйКодКонтекстныйГрафа(Запись.Сценарий, Запись.Группа, Граф);
		ГКСИ_ЗаписатьПолныйКодКонтекстный(Запись.Сценарий, Запись.Группа, ПолныйКод, Запись.КореньИнструкции);
	КонецЦикла;

КонецПроцедуры

// Собирает граф связей групп из готового набора связей без обращения к СУБД.
// Используется в ГКСИ_ПересчитатьВсеКодыВРегистре, чтобы один раз загрузить
// все данные пакетами запросов, а затем формировать по ним отдельные графы
// по корням (фильтрованные по измерению КореньИнструкции). Без этой функции
// пришлось бы строить каждый граф через свой запрос, что привело бы к
// запросам в цикле (SU95).
//
// Параметры:
//  Связи         - Массив из Структура - массив элементов с полями
//                  "Сценарий" и "Группа"; можно передать все записи
//                  регистра, фильтрация по корню уже сделана на этапе
//                  формирования массива.
//  КодыПоСсылкам - Соответствие из КлючИЗначение - общий кэш системных
//                  кодов справочника (одинаков для всех корней).
//  ЭтоГруппа     - Соответствие из КлючИЗначение - общий кэш признака
//                  "это группа" из справочника.
//
// Возвращаемое значение:
//  Структура - аналог ГКСИ_ГрафГрупп() по составу полей:
//   * ЧленыГрупп    - Соответствие из КлючИЗначение;
//   * РодителиГрупп - Соответствие из КлючИЗначение;
//   * ЭтоГруппа     - Соответствие из КлючИЗначение;
//   * КодыПоСсылкам - Соответствие из КлючИЗначение.
//
//@skip-warning SU95
Функция ГКСИ_СобратьГрафГруппПоСвязям(Связи, КодыПоСсылкам, ЭтоГруппа)

	ЧленыГрупп    = Новый Соответствие;
	РодителиГрупп = Новый Соответствие;

	Для Каждого Связь Из Связи Цикл
		Сценарий = Связь.Сценарий;
		Группа   = Связь.Группа;

		// Самоссылка корневой обёртки инструкции в граф не попадает -
		// иначе ПолныйКодГруппыГрафа уйдёт в переполнение стека.
		Если Сценарий = Группа Тогда
			Продолжить;
		КонецЕсли;

		ЧленыГруппы = ЧленыГрупп.Получить(Группа);
		Если ЧленыГруппы = Неопределено Тогда
			ЧленыГруппы = Новый Соответствие;
			ЧленыГрупп.Вставить(Группа, ЧленыГруппы);
		КонецЕсли;
		ЧленыГруппы.Вставить(Сценарий, Истина);

		Родители = РодителиГрупп.Получить(Сценарий);
		Если Родители = Неопределено Тогда
			Родители = Новый Соответствие;
			РодителиГрупп.Вставить(Сценарий, Родители);
		КонецЕсли;
		Родители.Вставить(Группа, Истина);
	КонецЦикла;

	Граф = Новый Структура;
	Граф.Вставить("ЧленыГрупп",    ЧленыГрупп);
	Граф.Вставить("РодителиГрупп", РодителиГрупп);
	Граф.Вставить("ЭтоГруппа",     ЭтоГруппа);
	Граф.Вставить("КодыПоСсылкам", КодыПоСсылкам);

	Возврат Граф;

КонецФункции

// Формирует имя файла (без расширения) для HTML-описания сценария на заданном
// языке. Имя строится по ссылке сценария и не зависит от групп принадлежности,
// что гарантирует стабильность имени при перемещении сценария между группами.
//
// Формат: "<УникальныйИдентификатор(Сценарий)>_<КодЯзыка>".
//
// Параметры:
//  Сценарий - CatalogRef.ДемонстрационныеСценарии - сценарий, для которого
//             нужно сформировать имя файла.
//  КодЯзыка - Строка - код языка (например, "ru", "en").
//
// Возвращаемое значение:
//  Строка - имя файла без расширения.
//
Функция ИмяФайлаОписанияСценария(Сценарий, КодЯзыка) Экспорт

	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Возврат "";
	КонецЕсли;

	КодЯзыкаСтрокой = СокрЛП(КодЯзыка);

	Возврат Строка(Сценарий.УникальныйИдентификатор())
		+ "_"
		+ КодЯзыкаСтрокой;

КонецФункции

// Скрывает типовое поле "Родитель" на форме сценария.
//
// Панель "Входит в группы" (группа ГКСИ_ГруппыСценарияГруппа, команды и кнопки
// ГКСИ_ДобавитьГруппу/ГКСИ_УдалитьГруппу, таблица ГКСИ_ГруппыСценария с колонками
// ГКСИ_ГруппыСценарияКолонкаГруппа и ГКСИ_ГруппыСценарияКолонкаПолныйКод) объявлена
// декларативно в конструкторе форм ФормаЭлемента и ФормаГруппы, поэтому программно
// элементы не создаются. Данные панели заполняет ЗаполнитьГруппыСценария.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента или формы группы справочника
//             ДемонстрационныеСценарии.
//
Процедура ДобавитьПанельГруппСценария(Форма) Экспорт

	ПолеРодитель = Форма.Элементы.Найти("Родитель");
	Если ПолеРодитель <> Неопределено Тогда
		ПолеРодитель.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

// Заполняет реквизит формы ГКСИ_ГруппыСценария из регистра сведений
// ГКСИ_ГруппыСценариев. Вызывается при создании формы, чтении объекта
// и после добавления/удаления связи пользователем.
//
// Параметры:
//  Форма - УправляемаяФорма - форма элемента или форма группы, в реквизит
//             ГКСИ_ГруппыСценария которой загружаются данные регистра.
//
//@skip-warning SU95
Процедура ЗаполнитьГруппыСценария(Форма) Экспорт

	Форма.ГКСИ_ГруппыСценария.Очистить();

	Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	МассивГрупп = ПолучитьГруппыСценария(Форма.Объект.Ссылка);
	Если МассивГрупп.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();

	Для Каждого Группа Из МассивГрупп Цикл
		Строка = Форма.ГКСИ_ГруппыСценария.Добавить();
		Строка.Группа               = Группа;
		Строка.ПолныйКодКонтекстный = ПолныйПолныйКодКонтекстныйГрафа(Форма.Объект.Ссылка, Группа, Граф);
	КонецЦикла;

КонецПроцедуры
// Синхронизирует регистр ГКСИ_ГруппыСценариев с содержимым таблицы формы.
// Удаляет связи, которых больше нет в таблице, добавляет новые. После
// каждого добавления/удаления пересчитывает ПолныйКодКонтекстный
// у поддеревьев затронутых родителей, чтобы кеш оставался актуальным.
//
// Параметры:
//  Форма         - УправляемаяФорма - форма элемента или группа, в которой
//                  идёт синхронизация.
//  ТекущийОбъект - СправочникОбъект.ДемонстрационныеСценарии - записываемый
//                  объект.
//  Отказ         - Булево - флаг отказа от записи.
//
//@skip-warning
Процедура СинхронизироватьГруппыСценария(Форма, ТекущийОбъект, Отказ) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Граф = ГКСИ_ГрафГрупп();
	МассивТекущихГрупп = ПолучитьГруппыСценарияГрафа(ТекущийОбъект.Ссылка, Граф);

	МассивНовыхГрупп = Новый Массив;
	Для Каждого СтрокаГруппы Из Форма.ГКСИ_ГруппыСценария Цикл
		МассивНовыхГрупп.Добавить(СтрокаГруппы.Группа);
	КонецЦикла;

	Для Каждого Группа Из МассивТекущихГрупп Цикл
		Если МассивНовыхГрупп.Найти(Группа) = Неопределено Тогда
			УдалитьСценарийИзГруппы(ТекущийОбъект.Ссылка, Группа);
			//@skip-warning SU95
			ПересчитатьПолныйКодДляПоддереваГрафа(ТекущийОбъект.Ссылка, Граф);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Группа Из МассивНовыхГрупп Цикл
		Если МассивТекущихГрупп.Найти(Группа) = Неопределено Тогда
			Попытка
				ДобавитьСценарийВГруппу(ТекущийОбъект.Ссылка, Группа);
				//@skip-warning SU95
				ПересчитатьПолныйКодДляПоддереваГрафа(Группа, Граф);
			Исключение
				Отказ = Истина;
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				СообщениеПользователю.Сообщить();
				Возврат;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Перенумеровать корневые группы справочника ДемонстрационныеСценарии
// последовательными кодами 001, 002, 003, ... и пересчитать коды всех
// членов их поддеревьев в регистре сведений ГКСИ_ГруппыСценариев.
//
// Корневыми считаются группы справочника, для которых нет записи в
// регистре ГКСИ_ГруппыСценариев с Группа = Ссылка (т.е. они сами не
// входят ни в какую другую группу). Иерархия в проекте управляется
// через регистр, а не через платформенный реквизит Родитель справочника.
//
// Вызывается из обработки загрузки сценариев после записи всего дерева,
// чтобы устранить эффект автонумерации: после полной очистки справочника
// первая инструкция получает код 001, но внутренние элементы сценария
// (подгруппы, шаги) тоже запрашивают коды из автонумератора, и вторая
// инструкция уезжает на 029, 103 и т.п. После перенумерации у первой
// инструкции код 001, у второй — 002 и т.д., а коды членов в регистре
// пересчитываются под новые коды корней.
//
// Изменения кода корневой группы триггером &После("ПриЗаписи") в
// ObjectModule справочника сами по себе вызывают
// ПересчитатьПолныйКодДляПоддерева, поэтому явный пересчёт после
// Объект.Записать() не требуется — пересчёт произойдёт автоматически.
//
Процедура ПеренумероватьКорневыеГруппы() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр
	|ГДЕ
	|	Спр.ЭтоГруппа = ИСТИНА
	|	И НЕ Спр.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ГКСИ_ГруппыСценариев.Группа КАК Группа
	|			ИЗ
	|				РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев)
	|УПОРЯДОЧИТЬ ПО
	|	Спр.Код");

	Выборка = Запрос.Выполнить().Выбрать();
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		НовыйКод = Формат(Счетчик, "ЧЦ=3; ЧВН=");
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект.Код = НовыйКод Тогда
			Продолжить;
		КонецЕсли;
		Объект.Код = НовыйКод;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

// Дозаполняет измерение КореньИнструкции для существующих записей регистра,
// у которых оно пустое (записи, созданные до введения фичи измерения или
// до bugfix 1.94 в ОбработатьУзелРекурсивно).
//
// Алгоритм:
//  1. Найти все записи регистра с пустым КореньИнструкции.
//  2. Для каждой такой записи подняться по графу РС вверх по цепочке
//     Группа -> Сценарий до первой корневой группы (та, у которой нет
//     родителя в графе). Корневая группа считается инструкцией.
//  3. Обновить КореньИнструкции в найденных записях.
//  4. Вызвать ГКСИ_ПересчитатьВсеКодыВРегистре, чтобы ПолныйКодКонтекстный
//     и КодВКонтексте получили правильный префикс с системным кодом корня.
//
// Разовая операция восстановления. После её выполнения рекомендуется
// перезагрузить конфигурацию или хотя бы обновить форму списка —
// кеши форм могут хранить старые значения.
//
Процедура ГКСИ_ДозаполнитьКореньИнструкции() Экспорт

	Граф = ГКСИ_ГрафГрупп();

	// Выбираем записи с пустым корнем ИЛИ с самоссылкой КореньИнструкции = Сценарий
	// (последнее — артефакт bugfix 1.94: #-заголовок верхнего уровня записывал
	// самого себя как корень из-за неправильной передачи ИнструкцияИсточник).
	// После bugfix 1.95 таких новых самоссылок не появится, но старые надо
	// привести к корректному виду.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|ГКСИ_ГруппыСценариев.КореньИнструкции = &ПустойКорень
	|ИЛИ ГКСИ_ГруппыСценариев.КореньИнструкции = ГКСИ_ГруппыСценариев.Сценарий");
	Запрос.УстановитьПараметр("ПустойКорень",
		Справочники.ДемонстрационныеСценарии.ПустаяСсылка());

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Кеш вычисленных корней для узлов — на одну запись родителя
	// приходится много детей, и без кеша повторный подъём по графу
	// для каждого ребёнка даёт O(N×M), где M — глубина иерархии.
	КешКорней = Новый Соответствие;
	ПустаяСсылка = Справочники.ДемонстрационныеСценарии.ПустаяСсылка();

	Обработано = 0;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл

		КореньИнструкции = ГКСИ_ПолучитьКореньУзлаСКешем(
			Выборка.Сценарий, Граф, КешКорней);

		// КореньИнструкции = Неопределено, если у узла несколько корней
		// (общий узел) или ноль (узел сам корневой). В обоих случаях
		// КореньИнструкции в РС остаётся пустым.

		// Прочитать существующие записи по паре (Сценарий, Группа) и
		// дозаполнить КореньИнструкции только у тех, где он пуст или
		// содержит самоссылку (артефакт bugfix 1.94).
		НаборЗаписей = РегистрыСведений.ГКСИ_ГруппыСценариев.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Сценарий.Установить(Выборка.Сценарий);
		НаборЗаписей.Отбор.Группа.Установить(Выборка.Группа);
		НаборЗаписей.Прочитать();

		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		НовоеЗначение = ?(КореньИнструкции <> Неопределено,
			КореньИнструкции, ПустаяСсылка);

		Для Каждого Зап Из НаборЗаписей Цикл
			ЭтоПусто      = НЕ ЗначениеЗаполнено(Зап.КореньИнструкции);
			ЭтоСамоссылка = (Зап.КореньИнструкции = Зап.Сценарий);
			Если НЕ ЭтоПусто И НЕ ЭтоСамоссылка Тогда
				// Уже корректно заполнено — не трогаем.
				Продолжить;
			КонецЕсли;
			Если Зап.КореньИнструкции = НовоеЗначение Тогда
				// Уже нужное значение (например, самоссылка, но узел реально
				// корневой — записывать пустую ссылку не нужно).
				Продолжить;
			КонецЕсли;
			Зап.КореньИнструкции = НовоеЗначение;
			Обработано = Обработано + 1;
		КонецЦикла;

		НаборЗаписей.Записать();

	КонецЦикла;

	// Пересчитать ПолныйКодКонтекстный и КодВКонтексте с правильным
	// префиксом системного кода корня. ГКСИ_ПересчитатьВсеКодыВРегистре
	// перечитывает записи и записывает их с обновлёнными ресурсами.
	Если Обработано > 0 Тогда
		ГКСИ_ПересчитатьВсеКодыВРегистре();
	КонецЕсли;

КонецПроцедуры

// Записывает одну запись регистра. Пишет в два ресурса:
//  - ПолныйКодКонтекстный — старый, путь сценария в контексте группы
//    (например "001.005.001");
//  - КодВКонтексте — новый, добавлен в v1.85 для понимания принадлежности
//    узла к конкретной инструкции (корню). Формат —
//    "<КодКорня>.<ПолныйКод>", например "001.001.005.001" для ГИП-корня
//    с кодом "001" и того же узла. Первая часть значения (до первой точки)
//    однозначно указывает на корень-инструкцию и совпадает с системным
//    Кодом корневой группы в справочнике ДемонстрационныеСценарии.
//
// Код корня запрашивается через ОбщегоНазначения.ЗначениеРеквизитаОбъекта
// (без загрузки объекта целиком). При загрузке большого количества
// записей имеет смысл кешировать, но для разовой перезагрузки MD-файлов
// производительность приемлема.
//
// Используется из публичных пересчётов, чтобы исключить повторный запрос графа
// внутри цикла по записям.
//
// Параметры:
//  Сценарий          - CatalogRef.ДемонстрационныеСценарии
//  Группа            - CatalogRef.ДемонстрационныеСценарии
//  ПолныйКод         - Строка - полный код сценария в контексте группы.
//                      Для общих групп может быть приближённым
//                      (см. ограничения ПолныйКодВКонтекстеГрафа).
//  КореньИнструкции  - CatalogRef.ДемонстрационныеСценарии - необяз.
//                      корневая группа-инструкция, к которой относится
//                      эта связь. Если не заполнен - старая логика
//                      (без указания корня). После миграции все
//                      новые записи пишутся с заполненным корнем.
//
Процедура ГКСИ_ЗаписатьПолныйКодКонтекстный(Сценарий, Группа, ПолныйКод, КореньИнструкции = Неопределено)

	НаборЗаписей = РегистрыСведений.ГКСИ_ГруппыСценариев.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Сценарий.Установить(Сценарий);
	НаборЗаписей.Отбор.Группа.Установить(Группа);
	// Измерение КореньИнструкции участвует в отборе, чтобы для одной пары
	// (Сценарий, Группа) можно было хранить несколько записей — по одной на
	// каждый корень. Без отбора по корню вызов Записать() стирал бы все записи
	// с другими корнями для этой пары и оставлял одну — что ломало изоляцию
	// общих узлов по инструкциям.
	Если КореньИнструкции <> Неопределено Тогда
		НаборЗаписей.Отбор.КореньИнструкции.Установить(КореньИнструкции);
	КонецЕсли;

	Запись = НаборЗаписей.Добавить();
	Запись.Сценарий             = Сценарий;
	Запись.Группа               = Группа;
	Запись.ПолныйКодКонтекстный = ПолныйКод;
	Если КореньИнструкции <> Неопределено Тогда
		Запись.КореньИнструкции = КореньИнструкции;
		// В ресурс КодВКонтексте пишем полный путь узла от корня инструкции.
		// По первой части значения (до первой точки) однозначно определяется
		// инструкция, к которой относится узел.
		//
		// ПолныйКод, возвращаемый ПолныйПолныйКодКонтекстныйГрафа, уже включает
		// собственный системный код корневой группы-обёртки как первый сегмент
		// (потому что ПолныйКодГруппыГрафа для корневой обёртки возвращает её
		// собственный код — самоссылка отфильтрована в графе). Поэтому добавлять
		// префикс КодКорня ещё раз НЕ нужно — это даёт лишний сегмент "001.001.001"
		// вместо правильного "001.001" для #-заголовка верхнего уровня
		// (см. отчёт/ОТЧЁТ_ПустыеКорниВДеревГрупп.md).
		//
		// Для самоссылки корневой обёртки ПолныйКод имеет вид "<Код>." с хвостовой
		// точкой (ПозицияСиблинга для самоссылки пустая). Без отдельной ветки
		// КодВКонтексте получился бы "<Код>." — форма списка
		// ФормаСпискаДеревоГрупп не нашла бы корень и нарисовала пустое дерево
		// (см. отчёт/ОТЧЁТ_ПрикрепитьИАльбомПоПоддереву.md строки 715-781).
		КодКорня = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КореньИнструкции, "Код");
		Если Сценарий = Группа Тогда
			Запись.КодВКонтексте = Строка(КодКорня);
		Иначе
			Запись.КодВКонтексте = ПолныйКод;
		КонецЕсли;
	КонецЕсли;

	НаборЗаписей.Записать();

КонецПроцедуры

// Записывает одну запись регистра с пересчитанным ПолныйКодКонтекстный.
// Используется из ДобавитьСценарийВГруппу (вызов вне цикла).
//
// Особенность: вызов идёт сразу после ГКСИ_ЗаписатьПолныйКодКонтекстный(.., .., ""),
// в той же транзакции. Запрос внутри ГКСИ_ГрафГруппПоКорню видит только зафиксированные
// записи регистра, поэтому только что записанная пара (Сценарий, Группа) в нём
// отсутствует — без подкладки ГКСИ_ПозицияСиблингаГрафа вернёт "" и ПолныйКод
// получится битым ("001." или ".005"). Добавляем пару в граф вручную.
//
// Граф строится ТОЛЬКО по нужному корню инструкции. Без этого фильтра общий
// граф содержит обоих родителей общих узлов (например, "Согласование ТКП"
// лежит и в ДМТО, и в ГИП), и ПолныйКодГруппыГрафа через "Для Каждого ...
// Прервать" берёт первого попавшегося - в результате для ГИП-записи
// возвращался ДМТО-родитель и код формировался как "001.007.xxx" вместо
// корректного "018.003.xxx".
//
Процедура ЗаписатьПолныйКодКонтекстный(Сценарий, Группа, КореньИнструкции = Неопределено)

	Если ЗначениеЗаполнено(КореньИнструкции) Тогда
		Граф = ГКСИ_ГрафГруппПоКорню(КореньИнструкции);
	Иначе
		Граф = ГКСИ_ГрафГрупп();
	КонецЕсли;

	Если ЗначениеЗаполнено(Группа) Тогда
		ЧленыГруппы = Граф.ЧленыГрупп.Получить(Группа);
		Если ЧленыГруппы = Неопределено Тогда
			ЧленыГруппы = Новый Соответствие;
			Граф.ЧленыГрупп.Вставить(Группа, ЧленыГруппы);
		КонецЕсли;
		ЧленыГруппы.Вставить(Сценарий, Истина);

		Родители = Граф.РодителиГрупп.Получить(Сценарий);
		Если Родители = Неопределено Тогда
			Родители = Новый Соответствие;
			Граф.РодителиГрупп.Вставить(Сценарий, Родители);
		КонецЕсли;
		Родители.Вставить(Группа, Истина);
	КонецЕсли;

	ПолныйКод = ГКСИ_ПолныйКодПоГрафу(Сценарий, Группа, Граф);
	// КореньИнструкции обязательно передаётся — без него ГКСИ_ЗаписатьПолныйКодКонтекстный
	// создаст набор с отбором только по (Сценарий, Группа), что сотрёт запись с
	// указанным корнем, созданную первой частью ДобавитьСценарийВГруппу.
	ГКСИ_ЗаписатьПолныйКодКонтекстный(Сценарий, Группа, ПолныйКод, КореньИнструкции);

КонецПроцедуры

// Строит полный код сценария в контексте группы, используя готовый граф.
// Используется из пересчётов, чтобы не ходить в запрос графа из цикла.
// Тонкая обёртка над ПолныйПолныйКодКонтекстныйГрафа: формат кода и алгоритм
// позиции описаны там.
//
Функция ГКСИ_ПолныйКодПоГрафу(Сценарий, Группа, Граф)

	Возврат ПолныйПолныйКодКонтекстныйГрафа(Сценарий, Группа, Граф);

КонецФункции

// Рекурсивный обход поддерева по предзагруженному графу.
//
Процедура ГКСИ_СобратьПотомковРекурсивно(Группа, Результат, Граф, Обработанные)

	Если Обработанные[Группа] = Истина Тогда
		Возврат;
	КонецЕсли;
	Обработанные.Вставить(Группа, Истина);
	Результат.Добавить(Группа);

	ЧленыГруппы = Граф.ЧленыГрупп.Получить(Группа);
	Если ЧленыГруппы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючИЗначение Из ЧленыГруппы Цикл
		Кандидат = КлючИЗначение.Ключ;
		Если Граф.ЭтоГруппа.Получить(Кандидат) = Истина Тогда
			ГКСИ_СобратьПотомковРекурсивно(Кандидат, Результат, Граф, Обработанные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает граф групп (связи ЧленыГрупп, РодителиГрупп, признаки
// ЭтоГруппа и системные КодыПоСсылкам).
//
// Экспорт - функция используется из других общих модулей расширения
// (например, ГКСИ_АльбомПроцессов для быстрой проверки ЭтоГруппа).
//
// Каждый вызов выполняет запрос к БД. Кеширование на уровне общего
// модуля невозможно (Перем в общих модулях запрещена, см. SU225),
// а ПовторноИспользуемыеЗначения даёт ложные срабатывания SU95
// в линтере. Эмпирически это приемлемо: граф запрашивается не в
// горячем цикле, а на границах записи (ДобавитьСценарийВГруппу,
// СинхронизироватьГруппыСценария, ПеренумероватьКорневыеГруппы),
// где стоимость лишнего запроса несущественна по сравнению с
// записью в регистр.
//
// Возвращаемое значение:
//  Структура:
//   * ЧленыГрупп    - Соответствие из КлючИЗначение - ключ CatalogRef.ДемонстрационныеСценарии
//                     (группа), значение Соответствие из КлючИЗначение - ключ
//                     CatalogRef.ДемонстрационныеСценарии (член), значение Булево.
//   * РодителиГрупп - Соответствие из КлючИЗначение - ключ CatalogRef.ДемонстрационныеСценарии
//                     (сценарий), значение Соответствие из КлючИЗначение - ключ
//                     CatalogRef.ДемонстрационныеСценарии (родитель), значение Булево.
//   * ЭтоГруппа     - Соответствие из КлючИЗначение - ключ CatalogRef.ДемонстрационныеСценарии,
//                     значение Булево.
//   * КодыПоСсылкам - Соответствие из КлючИЗначение - ключ CatalogRef.ДемонстрационныеСценарии,
//                     значение Строка.
//
Функция ГКСИ_ГрафГрупп() Экспорт

	ЧленыГрупп    = Новый Соответствие;
	РодителиГрупп = Новый Соответствие;
	ЭтоГруппа     = Новый Соответствие;
	КодыПоСсылкам = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр";

	РезультатПакета = Запрос.ВыполнитьПакет();

	ВыборкаСвязей = РезультатПакета[0].Выбрать();
	Пока ВыборкаСвязей.Следующий() Цикл

		// Самоссылка корневой обёртки инструкции (Сценарий = Группа = КореньИнструкции)
		// не участвует в иерархии групп — она нужна только форме списка, чтобы найти
		// обёртку по её системному коду. В граф (ЧленыГрупп / РодителиГрупп) она не
		// должна попадать, иначе обход иерархии в ПолныйКодГруппыГрафа /
		// ЕстьЦиклВГруппах уходит в переполнение стека из-за самоссылки на себя.
		Если ВыборкаСвязей.Сценарий = ВыборкаСвязей.Группа Тогда
			Продолжить;
		КонецЕсли;

		ЧленыГруппы = ЧленыГрупп.Получить(ВыборкаСвязей.Группа);
		Если ЧленыГруппы = Неопределено Тогда
			ЧленыГруппы = Новый Соответствие;
			ЧленыГрупп.Вставить(ВыборкаСвязей.Группа, ЧленыГруппы);
		КонецЕсли;
		ЧленыГруппы.Вставить(ВыборкаСвязей.Сценарий, Истина);

		Родители = РодителиГрупп.Получить(ВыборкаСвязей.Сценарий);
		Если Родители = Неопределено Тогда
			Родители = Новый Соответствие;
			РодителиГрупп.Вставить(ВыборкаСвязей.Сценарий, Родители);
		КонецЕсли;
		Родители.Вставить(ВыборкаСвязей.Группа, Истина);
	КонецЦикла;

	ВыборкаСпр = РезультатПакета[1].Выбрать();
	Пока ВыборкаСпр.Следующий() Цикл
		ЭтоГруппа.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.ЭтоГруппа);
		КодыПоСсылкам.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.Код);
	КонецЦикла;

	Граф = Новый Структура;
	Граф.Вставить("ЧленыГрупп",    ЧленыГрупп);
	Граф.Вставить("РодителиГрупп", РодителиГрупп);
	Граф.Вставить("ЭтоГруппа",     ЭтоГруппа);
	Граф.Вставить("КодыПоСсылкам", КодыПоСсылкам);

	Возврат Граф;

КонецФункции

// Строит граф связей групп, отфильтрованный по измерению КореньИнструкции.
// Используется в ГКСИ_ПересчитатьВсеКодыВРегистре и других местах, где
// ПолныйПолныйКодКонтекстныйГрафа через общий граф может взять не того
// родителя (например, для общего узла "Согласование ТКП" в общем графе
// зарегистрированы оба корня - ДМТО и ГИП, и ПолныйКодГруппыГрафа через
// "Для Каждого ... Прервать" берёт первого попавшегося, из-за чего для
// ГИП-узла в ГИП-контексте возвращался ДМТО-родитель и код формировался
// как "001.007.xxx" вместо правильного "018.003.xxx").
//
// Структура возвращаемого графа полностью совпадает со структурой
// обычного ГКСИ_ГрафГрупп(), отличие только в наборе связей - в графе
// по корню остаются только записи с указанным КореньИнструкции.
//
// Параметры:
//  КореньИнструкции - CatalogRef.ДемонстрационныеСценарии - корень
//                     инструкции, по которому фильтруется граф.
//
// Возвращаемое значение:
//  Структура - аналог ГКСИ_ГрафГрупп() по составу полей:
//   * ЧленыГрупп    - Соответствие из КлючИЗначение;
//   * РодителиГрупп - Соответствие из КлючИЗначение;
//   * ЭтоГруппа     - Соответствие из КлючИЗначение;
//   * КодыПоСсылкам - Соответствие из КлючИЗначение.
//
//@skip-warning SU95
Функция ГКСИ_ГрафГруппПоКорню(КореньИнструкции) Экспорт

	ЧленыГрупп    = Новый Соответствие;
	РодителиГрупп = Новый Соответствие;
	ЭтоГруппа     = Новый Соответствие;
	КодыПоСсылкам = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КореньИнструкции", КореньИнструкции);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.КореньИнструкции = &КореньИнструкции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр";

	РезультатПакета = Запрос.ВыполнитьПакет();

	ВыборкаСвязей = РезультатПакета[0].Выбрать();
	Пока ВыборкаСвязей.Следующий() Цикл

		Если ВыборкаСвязей.Сценарий = ВыборкаСвязей.Группа Тогда
			Продолжить;
		КонецЕсли;

		ЧленыГруппы = ЧленыГрупп.Получить(ВыборкаСвязей.Группа);
		Если ЧленыГруппы = Неопределено Тогда
			ЧленыГруппы = Новый Соответствие;
			ЧленыГрупп.Вставить(ВыборкаСвязей.Группа, ЧленыГруппы);
		КонецЕсли;
		ЧленыГруппы.Вставить(ВыборкаСвязей.Сценарий, Истина);

		Родители = РодителиГрупп.Получить(ВыборкаСвязей.Сценарий);
		Если Родители = Неопределено Тогда
			Родители = Новый Соответствие;
			РодителиГрупп.Вставить(ВыборкаСвязей.Сценарий, Родители);
		КонецЕсли;
		Родители.Вставить(ВыборкаСвязей.Группа, Истина);

	КонецЦикла;

	ВыборкаСпр = РезультатПакета[1].Выбрать();
	Пока ВыборкаСпр.Следующий() Цикл
		ЭтоГруппа.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.ЭтоГруппа);
		КодыПоСсылкам.Вставить(ВыборкаСпр.Ссылка, ВыборкаСпр.Код);
	КонецЦикла;

	Граф = Новый Структура;
	Граф.Вставить("ЧленыГрупп",    ЧленыГрупп);
	Граф.Вставить("РодителиГрупп", РодителиГрупп);
	Граф.Вставить("ЭтоГруппа",     ЭтоГруппа);
	Граф.Вставить("КодыПоСсылкам", КодыПоСсылкам);

	Возврат Граф;

КонецФункции


// Полностью очищает справочники ДемонстрационныеСценарии,
// ДемонстрационныеСценарииПрисоединенныеФайлы, ГКСИ_ФайлыИнструкций
// и регистр сведений ГКСИ_ГруппыСценариев. Используется для сброса
// данных перед повторным импортом из Markdown (тестирование, отладка).
//
// ВНИМАНИЕ: удаляет все данные без возможности восстановления.
// Для скорости использует ОбменДанными.Загрузка = Истина
// (отключает контроль ссылок и прав).
//
Процедура ОчиститьВсеСправочникиИРегистры() Экспорт

	НачатьТранзакцию();
	Попытка
		// Регистр связей - очищаем через пустой набор.
		НаборЗаписей = РегистрыСведений.ГКСИ_ГруппыСценариев.СоздатьНаборЗаписей();
		НаборЗаписей.Записать();

		УдалитьВсеЭлементыСправочника("Справочник.ДемонстрационныеСценарииПрисоединенныеФайлы");
		УдалитьВсеЭлементыСправочника("Справочник.ГКСИ_ФайлыИнструкций");
		УдалитьВсеЭлементыСправочника("Справочник.ДемонстрационныеСценарии");

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Удаляет все элементы переданного справочника в правильном порядке
// (сначала элементы, потом группы) и с ОбменДанными.Загрузка = Истина.
// Если справочник не иерархический - удаляется в один проход.
//
Процедура УдалитьВсеЭлементыСправочника(ПолноеИмяСправочника)

	МетаданныеСправочника = Метаданные.НайтиПоПолномуИмени(ПолноеИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;

	Если МетаданныеСправочника.Иерархический Тогда
		// Иерархический справочник: сначала удаляем элементы (ЭтоГруппа = Ложь),
		// потом - группы, чтобы не упереться в наличие подчинённых.
		// У неиерархических справочников реквизита ЭтоГруппа нет.
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка
		|ИЗ
		|	" + ПолноеИмяСправочника + " КАК Спр
		|ГДЕ
		|	Спр.ЭтоГруппа = ЛОЖЬ";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Удалить();
			КонецЕсли;
		КонецЦикла;

		Запрос.Текст =
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка
		|ИЗ
		|	" + ПолноеИмяСправочника + " КАК Спр
		|ГДЕ
		|	Спр.ЭтоГруппа = ИСТИНА";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Удалить();
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Неиерархический справочник - один проход.
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка
		|ИЗ
		|	" + ПолноеИмяСправочника + " КАК Спр";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Удалить();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Пересчитывает реквизит ГКСИ_ИнструкцияИсточник у всех узлов справочника
// на основе реальной структуры РС ГКСИ_ГруппыСценариев:
// - если узел связан ровно с одной корневой инструкцией (через цепочку
//   родителей в РС) - реквизит приводится к этой инструкции;
// - если узел связан с несколькими корневыми инструкциями (общий узел)
//   - реквизит очищается (признак "общий", показывать везде).
//
// Используется для исправления данных после операции "обновить всё",
// когда узлы могли получить неверный источник из-за переиспользования.
//
Процедура ГКСИ_ИсправитьИнструкцииИсточников() Экспорт

	Граф = ГКСИ_ГрафГрупп();

	ВсеУзлы = Новый Соответствие;
	Для Каждого КлючИЗначение Из Граф.РодителиГрупп Цикл
		ВсеУзлы.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из Граф.ЧленыГрупп Цикл
		ВсеУзлы.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;

	Обработано = 0;
	Изменено   = 0;

	Для Каждого КлючИЗначение Из ВсеУзлы Цикл

		Узел = КлючИЗначение.Ключ;
		Обработано = Обработано + 1;

		Корневые = Новый Соответствие;
		ГКСИ_СобратьКорневыеИнструкцииУзла(Узел, Граф, Корневые, Новый Соответствие);

		НовоеЗначение = Справочники.ДемонстрационныеСценарии.ПустаяСсылка();
		Если Корневые.Количество() = 1 Тогда
			Для Каждого Корень Из Корневые Цикл
				НовоеЗначение = Корень.Ключ;
			КонецЦикла;
		КонецЕсли;

		Объект = Узел.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Поле ГКСИ_ИнструкцияИсточник в метаданных справочника доступно только
		// для элементов (не групп). Поэтому пишем реквизит только для шагов
		// (не групп). Группы определяют свою принадлежность через РС
		// ГКСИ_ГруппыСценариев: если группа связана с несколькими корневыми
		// инструкциями - она общая (показывать везде); иначе привязана к одной
		// инструкции через РС, источник не нужен.
		Если НЕ Объект.ЭтоГруппа
				И Объект.ГКСИ_ИнструкцияИсточник <> НовоеЗначение Тогда
			Объект.ГКСИ_ИнструкцияИсточник = НовоеЗначение;
			Объект.Записать();
			Изменено = Изменено + 1;
		КонецЕсли;

	КонецЦикла;

	ЗаписьЖурналаРегистрации("ГКСИ.ГруппыСценариевСервер",
		УровеньЖурналаРегистрации.Информация, , ,
		"ГКСИ_ИсправитьИнструкцииИсточников: обработано "
		+ Обработано + " узлов, изменено " + Изменено);

КонецПроцедуры

// Рекурсивно собирает множество корневых инструкций, к которым принадлежит
// узел, через подъём по цепочке родителей в графе. Защищена от циклов.
//
// Для самого узла (без родителей в графе) множество остаётся пустым:
// он сам является корнем инструкции, его собственный КореньИнструкции
// в регистре должен быть пустым, а не указывать на самого себя.
//
// Параметры:
//  Узел       - CatalogRef.ДемонстрационныеСценарии
//  Граф       - Структура - см. ГКСИ_ГрафГрупп().
//  Корневые   - Соответствие из КлючИЗначение - заполняемое множество корневых узлов.
//  Посещённые - Соответствие из КлючИЗначение - защита от зацикливания.
//
Процедура ГКСИ_СобратьКорневыеИнструкцииУзла(Узел, Граф, Корневые, Посещённые) Экспорт

	Если Посещённые.Получить(Узел) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Посещённые.Вставить(Узел, Истина);

	Родители = Граф.РодителиГрупп.Получить(Узел);
	Если Родители = Неопределено ИЛИ Родители.Количество() = 0 Тогда
		// У узла нет родителей — он сам корневой, его собственный корень
		// в регистре должен остаться пустым. Корневые не пополняем.
		Возврат;
	Иначе
		Для Каждого КлючИЗначение Из Родители Цикл
			ГКСИ_СобратьКорневыеИнструкцииУзла(
				КлючИЗначение.Ключ, Граф, Корневые, Посещённые);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Возвращает единственный корень-инструкцию для узла или Неопределено,
// если узел общий (несколько корней) или сам корневой.
//
// Использует уже существующую ГКСИ_СобратьКорневыеИнструкцииУзла,
// которая рекурсивно поднимается по графу РС до корневых узлов.
// Для ускорения на больших деревьях результаты кешируются в КешКорней.
//
// Параметры:
//  Узел       - CatalogRef.ДемонстрационныеСценарии
//  Граф       - Структура - см. ГКСИ_ГрафГрупп().
//  КешКорней  - Соответствие из КлючИЗначение - кеш {Узел -> Неопределено/Корень}.
//
// Возвращаемое значение:
//  CatalogRef.ДемонстрационныеСценарии - единственный корень, или
//  Неопределено - если узел общий/корневой.
//
Функция ГКСИ_ПолучитьКореньУзлаСКешем(Узел, Граф, КешКорней)

	Если КешКорней[Узел] <> Неопределено Тогда
		Возврат КешКорней[Узел];
	КонецЕсли;

	Корневые = Новый Соответствие;
	ГКСИ_СобратьКорневыеИнструкцииУзла(Узел, Граф, Корневые, Новый Соответствие);

	Результат = Неопределено;
	Если Корневые.Количество() = 1 Тогда
		Для Каждого Корень Из Корневые Цикл
			Результат = Корень.Ключ;
		КонецЦикла;
	КонецЕсли;

	// Сохраняем в кеш даже Неопределено, чтобы не обходить граф заново.
	КешКорней.Вставить(Узел, Результат);

	Возврат Результат;

КонецФункции

#КонецОбласти
