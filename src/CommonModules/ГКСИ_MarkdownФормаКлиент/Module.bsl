// Клиентский модуль форм с Markdown-редактором.
// Содержит клиентские процедуры работы с формой:
// миграция HTML->Markdown, добавление кнопки тумблера, переключение режима,
// формирование HTML из Markdown по языкам.
// Используется в формах элемента и группы справочника ДемонстрационныеСценарии.

#Область ПрограммныйИнтерфейс

// При записи объекта обходим все коды языков из ГКСИ_ТекстMarkdown
// и для каждого конвертируем сегмент Markdown в HTML. Результат
// помещается в ПараметрыЗаписи под ключом КлючАдресаHTMLПоЯзыкам().
//
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения - форма элемента/группы.
//  Отказ           - Булево - признак отказа от записи.
//  ПараметрыЗаписи - Структура - параметры записи формы.
//
Процедура ЗаписатьHTMLИзMarkdown(Форма, Отказ, ПараметрыЗаписи) Экспорт

	Если НЕ ЗначениеЗаполнено(Форма.Объект.ГКСИ_ТекстMarkdown) Тогда
		Возврат;
	КонецЕсли;

	ПолеHTMLПросмотра = Форма.Элементы.Найти("РМ_ПолеПросмотра_ТекстMarkdownСтрока");
	Если ПолеHTMLПросмотра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Сначала фиксируем в объекте текущий сегмент Markdown из редактора.
	// Раньше это делалось в конце процедуры, уже после конвертации, поэтому HTML
	// собирался по ещё не обновлённому ГКСИ_ТекстMarkdown: присоединённый файл
	// (и поле «Текст сценария (чтение)») отставали на одну запись.
	ГКСИ_MarkdownФормаКлиентСервер.СохранитьСегментMarkdownТекущегоЯзыка(Форма);

	КодыЯзыков = ГКСИ_MarkdownФормаКлиентСервер.ПолучитьКодыЯзыковИзMarkdown(Форма.Объект.ГКСИ_ТекстMarkdown);
	Если КодыЯзыков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	HTMLПоЯзыкам = Новый Соответствие;
	Для Каждого КодЯзыка Из КодыЯзыков Цикл

		СегментMarkdown = ГКСИ_MarkdownФормаКлиентСервер.ПолучитьСегментMarkdown(Форма.Объект.ГКСИ_ТекстMarkdown, КодЯзыка);
		Если НЕ ЗначениеЗаполнено(СегментMarkdown) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ТекстДляКонвертации = ГКСИ_MarkdownКлиент.ЗаменитьКодыФайловНаBase64(СегментMarkdown, Форма);
			ФрагментHTML = ГКСИ_MarkdownКлиент.ТекстHTMLПоТекстуMarkdown(ПолеHTMLПросмотра, ТекстДляКонвертации);
			ДемонстрационныеСценарииКлиентСервер.ДобавитьТегиТелаЕслиНеобходимо(ФрагментHTML);
			// Картинка и текст в одной строке: без своего CSS браузер выравнивает
			// текст по базовой линии (низ картинки). В предпросмотре формы текст
			// уже центрируется правилом div.wiki img, а в сохранённом файле CSS
			// нет — задаём выравнивание явно, чтобы файл выглядел так же.
			ФрагментHTML = СтрЗаменить(ФрагментHTML, "<body>",
				"<body><style>img { vertical-align: middle; }</style>");
		Исключение
			Продолжить;
		КонецПопытки;

		HTMLПоЯзыкам.Вставить(КодЯзыка, ФрагментHTML);

	КонецЦикла;

	Если HTMLПоЯзыкам.Количество() > 0 Тогда
		АдресВХ = ПоместитьВоВременноеХранилище(HTMLПоЯзыкам, Форма.УникальныйИдентификатор);
		ПараметрыЗаписи.Вставить(ГКСИ_MarkdownФормаКлиентСервер.КлючАдресаHTMLПоЯзыкам(), АдресВХ);
	КонецЕсли;

КонецПроцедуры

// Миграция HTML->Markdown при первом открытии формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ВыполнитьМиграциюHTMLВMarkdown(Форма) Экспорт

	Если Форма.Объект.ГКСИ_MarkdownСформирован Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Форма.ТекстMarkdownСтрока) Тогда
		Форма.Объект.ГКСИ_MarkdownСформирован = Истина;
		Возврат;
	КонецЕсли;

	HTMLТекущегоЯзыка = Форма.ТекстСценария;
	Если НЕ ЗначениеЗаполнено(HTMLТекущегоЯзыка) Тогда
		Возврат;
	КонецЕсли;

	ПолеПросмотра = Форма.Элементы.Найти("РМ_ПолеПросмотра_ТекстMarkdownСтрока");
	Если ПолеПросмотра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Форма.ТекстMarkdownСтрока = СокрЛП(ГКСИ_MarkdownКлиент.ТекстMarkdownПоТекстуHTML(ПолеПросмотра, HTMLТекущегоЯзыка));
		Форма.Объект.ГКСИ_MarkdownСформирован = Истина;
		Форма.Объект.ГКСИ_ТекстMarkdown = ГКСИ_MarkdownФормаКлиентСервер.ЗаменитьСегментMarkdown(
			Форма.Объект.ГКСИ_ТекстMarkdown, Форма.ЯзыкСценария, Форма.ТекстMarkdownСтрока);
	Исключение
		// Миграция не удалась - оставляем как есть, но информируем пользователя.
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Не удалось выполнить миграцию HTML в Markdown. Подробности:"
			+ Символы.ПС + ОписаниеОшибки();
		СообщениеПользователю.Сообщить();
	КонецПопытки;

КонецПроцедуры

// Добавляет кнопку тумблера режима в командную панель формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ДобавитьКнопкуТумблера(Форма) Экспорт

	ИмяКнопки = "ГКСИ_ПереключитьРежим";

	Если Форма.Элементы.Найти(ИмяКнопки) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	РодительскаяГруппа = Форма.Элементы.Найти("ГруппаКомментарийРодитель");
	Если РодительскаяГруппа = Неопределено Тогда
		РодительскаяГруппа = Форма;
	КонецЕсли;

	НоваяКнопка = Форма.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), РодительскаяГруппа);
	НоваяКнопка.ИмяКоманды = ИмяКнопки;
	НоваяКнопка.Видимость = Истина;

КонецПроцедуры

// Обновляет заголовок кнопки тумблера в соответствии с текущим режимом формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ОбновитьЗаголовокТумблера(Форма) Экспорт

	Кнопка = Форма.Элементы.Найти("ГКСИ_ПереключитьРежим");
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Форма.ВариантОтображенияФормы = "Редактирование" Тогда
		Кнопка.Заголовок = НСтр("ru = 'Режим: Редактирование — Просмотр'");
	Иначе
		Кнопка.Заголовок = НСтр("ru = 'Режим: Просмотр — Редактирование'");
	КонецЕсли;

КонецПроцедуры

// Тумблер режима отображения формы (Просмотр <-> Редактирование).
// Заменяет три отдельные типовые команды УстановитьВариантПросмотр/Редактирование/Перевод
// одной кнопкой с динамическим заголовком. Циклит между Просмотр и Редактирование.
//
// Параметры:
//  Форма  - ФормаКлиентскогоПриложения - форма элемента/группы.
//  Команда - КомандаФормы - команда формы, инициировавшая обработку.
//
Процедура ПереключитьРежим(Форма, Команда) Экспорт

	Если Форма.ВариантОтображенияФормы = "Редактирование" Тогда
		// Вызываем экспортную обёртку, добавленную в модуле формы расширения.
		// Она внутри дёргает типовой обработчик УстановитьВариантПросмотр(Команда).
		Форма.ГКСИ_УстановитьВариантПросмотр(Команда);
	Иначе
		Форма.ГКСИ_УстановитьВариантРедактирование(Команда);
	КонецЕсли;

	ОбновитьЗаголовокТумблера(Форма);

КонецПроцедуры

#КонецОбласти
