// Проверки прав доступа и настройка элементов форм справочника
// ДемонстрационныеСценарии (инструкций) в соответствии с правами пользователя.
//
// Механизм единый для форм элемента, группы и списка-дерева: если у пользователя
// есть только право просмотра инструкций (роль ГКСИ_ЧтениеИнструкций даёт
// Read и View, но не Update), форма открывается в режиме просмотра и не
// показывает элементы, меняющие данные.

#Область ПрограммныйИнтерфейс

// Возвращает признак наличия у текущего пользователя права изменения инструкций.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь может изменять инструкции.
//
Функция ЕстьПравоРедактированияИнструкций() Экспорт

	Возврат ПравоДоступа("Изменение", Метаданные.Справочники.ДемонстрационныеСценарии);

КонецФункции

// Возвращает признак наличия у текущего пользователя права добавления инструкций.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователь может добавлять инструкции.
//
Функция ЕстьПравоДобавленияИнструкций() Экспорт

	Возврат ПравоДоступа("Добавление", Метаданные.Справочники.ДемонстрационныеСценарии);

КонецФункции

// Переводит форму инструкции в режим просмотра и убирает элементы,
// меняющие данные: страницу «Описание», команду отправки на согласование,
// кнопки на странице «Связи».
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента или группы справочника
//          ДемонстрационныеСценарии.
//
Процедура ОграничитьФормуИнструкцииПросмотром(Форма) Экспорт

	Форма.ВариантОтображенияФормы = "Просмотр";

	СтраницыШапки     = Форма.Элементы.Найти("СтраницыШапкаВариантыОтображения");
	СтраницаПросмотра = Форма.Элементы.Найти("СтраницаВариантОтображенияПросмотр");
	Если СтраницыШапки <> Неопределено И СтраницаПросмотра <> Неопределено Тогда
		СтраницыШапки.ТекущаяСтраница = СтраницаПросмотра;
	КонецЕсли;

	СкрытьЭлемент(Форма, "СтраницаОписание");
	СкрытьЭлемент(Форма, "ГКСИ_ОтправитьНаСогласование");

	ОтключитьКнопки(Форма, "СтраницаСвязи");

КонецПроцедуры

// Скрывает элемент формы, если он есть на форме.
//
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - управляемая форма.
//  ИмяЭлемента  - Строка - имя элемента формы.
//
Процедура СкрытьЭлемент(Форма, ИмяЭлемента) Экспорт

	Элемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

// Делает недоступными все кнопки внутри указанного элемента формы
// (страницы, группы, командной панели).
//
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - управляемая форма.
//  ИмяЭлемента  - Строка - имя элемента формы, внутри которого отключаются кнопки.
//
Процедура ОтключитьКнопки(Форма, ИмяЭлемента) Экспорт

	КорневойЭлемент = Форма.Элементы.Найти(ИмяЭлемента);
	Если КорневойЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Форма.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("КнопкаФормы")
			И ЭлементВходитВ(Элемент, КорневойЭлемент) Тогда
			Элемент.Доступность = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет, находится ли элемент формы внутри указанного элемента
// (на любой глубине вложенности).
Функция ЭлементВходитВ(Элемент, КорневойЭлемент)

	ТекущийЭлемент = Элемент;
	Пока ТекущийЭлемент <> Неопределено Цикл
		Если ТекущийЭлемент = КорневойЭлемент Тогда
			Возврат Истина;
		КонецЕсли;
		ТекущийЭлемент = ТекущийЭлемент.Родитель;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
