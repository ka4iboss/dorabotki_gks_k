////////////////////////////////////////////////////////////////////////////////
// Серверные функции обработки «Объединение элементов».
//
// Объединение выполняется средствами БСП:
//   * поиск мест использования — ОбщегоНазначения.МестаИспользования();
//   * замена ссылок          — ОбщегоНазначения.ЗаменитьСсылки().
// Тяжёлые операции вызываются только из фоновых заданий (см. *Фон).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает список объектов метаданных, доступных для объединения.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * ПолноеИмя      - Строка - полное имя объекта метаданных;
//   * Представление  - Строка - представление списка для пользователя.
//
Функция ОбъектыДляВыбора() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ПолноеИмя", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	ДобавитьОбъектыВСписок(Результат, Метаданные.Справочники);
	ДобавитьОбъектыВСписок(Результат, Метаданные.ПланыВидовХарактеристик);
	ДобавитьОбъектыВСписок(Результат, Метаданные.ПланыСчетов);
	ДобавитьОбъектыВСписок(Результат, Метаданные.ПланыВидовРасчета);
	
	Результат.Сортировать("Представление");
	Возврат Результат;
	
КонецФункции

// Формирует текст запроса динамического списка для указанного объекта метаданных.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных, например "Справочник.Номенклатура".
//
// Возвращаемое значение:
//  Строка - текст запроса динамического списка.
//
Функция ТекстЗапросаСписка(Знач ПолноеИмяОбъекта) Экспорт
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Характеристики = ХарактеристикиОбъекта(ОбъектМетаданных);
	
	ПолеКод = ?(Характеристики.ЕстьКод, "Таблица.Код КАК Код,", "НЕОПРЕДЕЛЕНО КАК Код,");
	ПолеНаименование = ?(Характеристики.ЕстьНаименование,
		"Таблица.Наименование КАК Наименование,", "Таблица.Ссылка КАК Наименование,");
	
	Шаблон =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Ссылка КАК ЭлементСсылка,
	|	#ПолеКод
	|	#ПолеНаименование
	|	Таблица.ПометкаУдаления КАК ПометкаУдаления,
	|	ВЫБОР КОГДА Таблица.Ссылка = &Оригинал ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоОригинал,
	|	ВЫБОР КОГДА Таблица.Ссылка В (&ОтмеченныеДубли) ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК ЭтоДубль,
	|	ВЫБОР КОГДА Таблица.Ссылка В (&ОтмеченныеДубли) ТОГДА &Оригинал КОНЕЦ КАК КудаОбъединять
	|ИЗ
	|	#Таблица КАК Таблица";
	
	ТекстЗапроса = СтрЗаменить(Шаблон, "#Таблица", ОбъектМетаданных.ПолноеИмя());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ПолеКод", ПолеКод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ПолеНаименование", ПолеНаименование);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Проверяет набор ссылок перед объединением: один тип, один владелец, не группы, есть права.
//
// Параметры:
//  НаборСсылок - Массив из ЛюбаяСсылка - оригинал и дубли.
//
// Возвращаемое значение:
//  Структура:
//   * Успех             - Булево - Истина, если объединение возможно;
//   * ТекстОшибки       - Строка - причина отказа;
//   * ПолноеИмяОбъекта  - Строка - полное имя объекта метаданных набора.
//
Функция ПроверитьНабор(Знач НаборСсылок) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ПолноеИмяОбъекта", "");
	
	МинимальноеКоличествоЭлементов = 2; // Оригинал и хотя бы один дубль.
	Если НаборСсылок = Неопределено Или НаборСсылок.Количество() < МинимальноеКоличествоЭлементов Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Укажите оригинал и хотя бы один дубль.'");
		Возврат Результат;
	КонецЕсли;
	
	ПервыйЭлемент = НаборСсылок[0];
	Если Не ЗначениеЗаполнено(ПервыйЭлемент) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не указан оригинал.'");
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ПервыйЭлемент.Метаданные();
	Результат.ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	Для Каждого Ссылка Из НаборСсылок Цикл
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Если Ссылка.Метаданные() <> ОбъектМетаданных Тогда
			Результат.ТекстОшибки = НСтр("ru = 'Все объединяемые элементы должны быть одного типа.'");
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПравоДоступа("Изменение", ОбъектМетаданных) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Недостаточно прав на изменение элементов выбранного типа.'");
		Возврат Результат;
	КонецЕсли;
	
	Характеристики = ХарактеристикиОбъекта(ОбъектМетаданных);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Владелец) КАК КоличествоВладельцев,
	|	МАКСИМУМ(ЭтоГруппа) КАК ЕстьГруппы,
	|	КОЛИЧЕСТВО(Ссылка) КАК КоличествоСсылок
	|ИЗ
	|	#Таблица
	|ГДЕ
	|	Ссылка В (&НаборСсылок)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Таблица", ОбъектМетаданных.ПолноеИмя());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Владелец",
		?(Характеристики.ЕстьВладелец, "Владелец", "НЕОПРЕДЕЛЕНО"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЭтоГруппа",
		?(Характеристики.ЕстьГруппы, "ЭтоГруппа", "ЛОЖЬ"));
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НаборСсылок", НаборСсылок);
	Контроль = Запрос.Выполнить().Выгрузить()[0];
	
	Если Контроль.ЕстьГруппы Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Один из выбранных элементов является группой. Группы не объединяются.'");
		Возврат Результат;
	КонецЕсли;
	
	Если Контроль.КоличествоВладельцев > 1 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'У выбранных элементов различные владельцы. Такие элементы не объединяются.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

// Фоновое задание: определяет количество мест использования для каждой ссылки набора.
//
// Параметры:
//  Параметры - Структура:
//   * НаборСсылок  - Массив из ЛюбаяСсылка - анализируемые ссылки;
//   * ПараметрыПоиска - см. ОбщегоНазначения.ПараметрыПоискаМестИспользования.
//  АдресРезультата - Строка - адрес во временном хранилище для результата.
//
// Результат в хранилище - ТаблицаЗначений:
//  * Ссылка           - ЛюбаяСсылка - анализируемая ссылка;
//  * Вхождения        - Число - количество мест использования;
//  * Вспомогательных  - Число - количество вспомогательных мест использования (ведущие измерения).
//
Процедура ОпределитьМестаИспользованияФон(Параметры, Знач АдресРезультата) Экспорт
	
	ТаблицаПоиска = ОбщегоНазначения.МестаИспользования(Параметры.НаборСсылок, ,
		Параметры.ПараметрыПоиска);
	
	АктуальныеСтроки = ТаблицаПоиска.НайтиСтроки(Новый Структура("ЭтоСлужебныеДанные", Ложь));
	Результат = ТаблицаПоиска.Скопировать(АктуальныеСтроки, "Ссылка, ВспомогательныеДанные");
	
	Результат.Колонки.Добавить("Вхождения", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Вспомогательных", Новый ОписаниеТипов("Число"));
	Результат.ЗаполнитьЗначения(1, "Вхождения");
	Результат.ЗаполнитьЗначения(0, "Вспомогательных");
	Для Каждого СтрокаТаблицы Из Результат Цикл
		СтрокаТаблицы.Вспомогательных = ?(СтрокаТаблицы.ВспомогательныеДанные, 1, 0);
	КонецЦикла;
	
	Результат.Индексы.Добавить("Ссылка");
	Результат.Свернуть("Ссылка", "Вхождения, Вспомогательных");
	
	Для Каждого Ссылка Из Параметры.НаборСсылок Цикл
		Если Результат.Найти(Ссылка, "Ссылка") = Неопределено Тогда
			СтрокаРезультата = Результат.Добавить();
			СтрокаРезультата.Ссылка = Ссылка;
			СтрокаРезультата.Вхождения = 0;
			СтрокаРезультата.Вспомогательных = 0;
		КонецЕсли;
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Проверяет возможность замены по прикладным правилам объекта.
//
// Параметры:
//  ПарыЗамен      - Соответствие из КлючИЗначение - см. ОбщегоНазначения.ЗаменитьСсылки;
//  СпособУдаления - Строка - "" | "Пометка" | "Непосредственно".
//
// Возвращаемое значение:
//  Строка - описание причин запрета; пустая строка, если замена возможна.
//
Функция ПроверитьВозможностьЗамены(Знач ПарыЗамен, Знач СпособУдаления) Экспорт
	
	ПараметрыЗамены = ОбщегоНазначения.ПараметрыЗаменыСсылок();
	ПараметрыЗамены.СпособУдаления = СпособУдаления;
	
	Возврат ПоискИУдалениеДублей.ПроверитьВозможностьЗаменыЭлементовСтрока(ПарыЗамен, ПараметрыЗамены);
	
КонецФункции

// Фоновое задание: заменяет ссылки дублей на оригинал.
//
// Параметры:
//  Параметры - Структура:
//   * ПарыЗамен      - Соответствие из КлючИЗначение - дубль -> оригинал;
//   * СпособУдаления - Строка - "" | "Пометка" | "Непосредственно".
//  АдресРезультата - Строка - адрес во временном хранилище для результата.
//
// Результат в хранилище - ТаблицаЗначений - ошибки замены, см. ОбщегоНазначения.ЗаменитьСсылки.
//
Процедура ЗаменитьСсылкиФон(Параметры, Знач АдресРезультата) Экспорт
	
	ПараметрыЗамены = ОбщегоНазначения.ПараметрыЗаменыСсылок();
	ПараметрыЗамены.СпособУдаления = Параметры.СпособУдаления;
	ПараметрыЗамены.УчитыватьПрикладныеПравила = Истина;
	ПараметрыЗамены.ВключатьБизнесЛогику = Истина;
	ПараметрыЗамены.ЗаменаПарыВТранзакции = Ложь;
	
	ОшибкиЗамены = ОбщегоНазначения.ЗаменитьСсылки(Параметры.ПарыЗамен, ПараметрыЗамены);
	ПоместитьВоВременноеХранилище(ОшибкиЗамены, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет объекты метаданных коллекции в таблицу доступных объектов.
//
// Параметры:
//  Таблица           - ТаблицаЗначений - см. ОбъектыДляВыбора;
//  КоллекцияМетаданных - КоллекцияОбъектовМетаданных - справочники, планы и т.п.
//
Процедура ДобавитьОбъектыВСписок(Таблица, КоллекцияМетаданных)
	
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Если Не ПравоДоступа("Просмотр", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ОбщегоНазначения.ОбъектМетаданныхДоступенПоФункциональнымОпциям(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		СтрокаТаблицы.Представление = ОбъектМетаданных.Представление();
	КонецЦикла;
	
КонецПроцедуры

// Возвращает характеристики объекта метаданных, влияющие на формирование запроса и проверок.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - справочник, план видов характеристик, план счетов, план видов расчета.
//
// Возвращаемое значение:
//  Структура:
//   * ЕстьКод          - Булево
//   * ЕстьНаименование - Булево
//   * ЕстьВладелец     - Булево
//   * ЕстьГруппы       - Булево
//
Функция ХарактеристикиОбъекта(ОбъектМетаданных)
	
	Результат = Новый Структура;
	Результат.Вставить("ДлинаКода", 0);
	Результат.Вставить("ДлинаНаименования", 0);
	Результат.Вставить("Иерархический", Ложь);
	Результат.Вставить("ВидИерархии", Неопределено);
	Результат.Вставить("Владельцы", Новый Массив);
	ЗаполнитьЗначенияСвойств(Результат, ОбъектМетаданных);
	
	ЕстьГруппы = Результат.Иерархический
		И Результат.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	
	Результат.Вставить("ЕстьКод", Результат.ДлинаКода > 0);
	Результат.Вставить("ЕстьНаименование", Результат.ДлинаНаименования > 0);
	Результат.Вставить("ЕстьВладелец", Результат.Владельцы.Количество() > 0);
	Результат.Вставить("ЕстьГруппы", ЕстьГруппы);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
