// Реализация чтения двоичных данных изображений для встраивания в HTML/Markdown.
//
// Модуль без признака повторного использования возвращаемых значений, потому что
// вызывается как из обычного сеанса (через кеш-модуль
// ГКСИ_ДанныеИзображенийMarkdownПовтИсп), так и напрямую из фонового задания
// (через ГКСИ_MarkdownПереопределяемый, см. СоответствиеКодДанныеИзображений).
//
// Почему нельзя звать только кеш-модуль:
//   платформа разрешает передавать в экспортную функцию модуля с
//   ПовторноеИспользованиеВозвращаемыхЗначений только примитивные типы,
//   ссылки и Структуру. Параметр МассивКодов имеет тип Массив, поэтому
//   при вызове из фонового задания (ДлительныеОперации.ВыполнитьВФоне ->
//   ЗаписатьДеревоФоново -> MarkdownВHTML -> ЗаменитьКодыИзображенийНаDataURI
//   -> СоответствиеКодДанныеИзображений -> кеш-модуль) платформа отвечает
//   "Несоответствие типов (параметр номер 1)" и запись узла падает.
//
// Контракт "кеш или прямое чтение" реализован в ГКСИ_MarkdownПереопределяемый:
//   - в основном сеансе - через кеш-модуль (быстро, повторные альбомы бесплатны);
//   - в фоновом задании - напрямую сюда (обходит ограничения типов параметров
//     модуля с повторным использованием).

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает соответствие Код -> {Base64, Mime} для файлов из
// справочника ГКСИ_ФайлыИнструкций. Несуществующие коды в соответствие
// не попадают.
//
// Если задана МаксимальнаяШиринаПикселей > 0, выполняется пропорциональный
// ресайз: исходные картинки шире заданной границы уменьшаются до неё.
// JPEG/фотографии переводятся в JPEG; PNG/GIF - остаются в PNG.
// Это снижает размер base64 в 5-20 раз при незначительной потере качества.
//
// Параметры:
//   МассивКодов - Массив из Строка - коды (GUID) файлов инструкций.
//   МаксимальнаяШиринаПикселей - Число - целевая ширина в пикселях.
//       0 - не сжимать (для других потребителей, кроме альбома).
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - Ключ: Строка (Код), Значение: Структура {Base64, Mime}.
//
Функция СоответствиеКодДанные(МассивКодов, МаксимальнаяШиринаПикселей = 0) Экспорт

	Результат = Новый Соответствие;
	Если МассивКодов = Неопределено ИЛИ МассивКодов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ФайлыИнструкций.Код КАК Код,
	|	ГКСИ_ФайлыИнструкций.Файл КАК Файл,
	|	ГКСИ_ФайлыИнструкций.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ГКСИ_ФайлыИнструкций КАК ГКСИ_ФайлыИнструкций
	|ГДЕ
	|	ГКСИ_ФайлыИнструкций.Код В (&МассивКодов)
	|	И НЕ ГКСИ_ФайлыИнструкций.ПометкаУдаления";
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДвоичныеДанные = Выборка.Файл.Получить();
		Если ДвоичныеДанные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДанныеКартинки = ПодготовитьДанныеКартинки(
			ДвоичныеДанные,
			Выборка.Расширение,
			МаксимальнаяШиринаПикселей);

		Результат.Вставить(Выборка.Код, ДанныеКартинки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вспомогательная экспортная функция для кеш-модуля
// ГКСИ_ДанныеИзображенийMarkdownПовтИсп: тот же контракт, но параметр -
// строка-ключ. Это позволяет обойти ограничение платформы на типы
// параметров экспортной функции с ПовторноеИспользованиеВозвращаемыхЗначений
// (допустимы только примитивы, ссылки и Структура; Массив не подходит).
//
// Формат ключа: "<Код1>|<Код2>|...|<КодN>#<Ширина>", где Ширина -
// XMLСтрока(Число). Разделитель между кодами и шириной - символ "#".
// Такой разделитель безопасен: GUID-ы его не содержат, XMLСтрока от числа
// его тоже не выдаёт.
//
// Из фонового задания эту функцию звать нельзя - платформа всё равно
// зарежет. Поэтому в фоне вызывающий код должен идти напрямую через
// СоответствиеКодДанные (без кеш-модуля).
//
// Параметры:
//   КлючКеша - Строка - составной ключ. Пустая строка или строка без "#"
//       трактуется как пустой запрос.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - Ключ: Строка (Код), Значение: Структура {Base64, Mime}.
//
Функция СоответствиеКодДанныеПоКлючу(КлючКеша) Экспорт

	МассивКодов = Новый Массив;
	Ширина = 0;

	Если НЕ ПустаяСтрока(КлючКеша) Тогда
		ПозицияРазделителя = СтрНайти(КлючКеша, "#");
		Если ПозицияРазделителя > 0 Тогда
			СтрокаКодов = Лев(КлючКеша, ПозицияРазделителя - 1);
			СтрокаШирины = Сред(КлючКеша, ПозицияРазделителя + 1);
			Если НЕ ПустаяСтрока(СтрокаШирины) Тогда
				Попытка
					Ширина = Число(СтрокаШирины);
				Исключение
					Ширина = 0;
				КонецПопытки;
			КонецЕсли;
		Иначе
			СтрокаКодов = КлючКеша;
		КонецЕсли;

		Если НЕ ПустаяСтрока(СтрокаКодов) Тогда
			МассивКодов = СтрРазделить(СтрокаКодов, "|", Ложь);
		КонецЕсли;
	КонецЕсли;

	Возврат СоответствиеКодДанные(МассивКодов, Ширина);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Применяет сжатие к двоичным данным изображения и возвращает
// структуру {Base64, Mime} для встраивания в HTML.
//
// Если сжатие не требуется (ширина 0, формат не поддерживается,
// исходник уже меньше целевой ширины) - возвращает base64 исходника.
//
// Параметры:
//   ДвоичныеДанные - ДвоичныеДанные - исходные двоичные данные изображения.
//   Расширение - Строка - расширение файла без точки (png, jpg, ...).
//   МаксимальнаяШиринаПикселей - Число - целевая ширина. 0 - без сжатия.
//
// Возвращаемое значение:
//   Структура - {Base64: Строка, Mime: Строка}.
//
Функция ПодготовитьДанныеКартинки(ДвоичныеДанные, Расширение, МаксимальнаяШиринаПикселей)

	Результат = Новый Структура;
	Результат.Вставить("Base64", Base64Строка(ДвоичныеДанные));
	Результат.Вставить("Mime", ПолучитьMimeТипИзображения(Расширение));

	Если МаксимальнаяШиринаПикселей <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// SVG - векторный, не сжимаем.
	Если НРег(Расширение) = "svg" Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		ИсходнаяКартинка = Новый Картинка(ДвоичныеДанные, Ложь);
	Исключение
		// Не удалось распознать формат - отдаём как есть.
		Возврат Результат;
	КонецПопытки;

	ШиринаИсходника = ИсходнаяКартинка.Ширина();
	ВысотаИсходника = ИсходнаяКартинка.Высота();
	Если ШиринаИсходника = Неопределено ИЛИ ВысотаИсходника = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// Исходник уже меньше целевой ширины - сжимать нечего.
	Если ШиринаИсходника <= МаксимальнаяШиринаПикселей Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Обработка = Новый ОбрабатываемаяКартинка(ИсходнаяКартинка);
		Обработка.УстановитьРазмер(МаксимальнаяШиринаПикселей, 0);

		РасширениеНРег = НРег(Расширение);
		Если РасширениеНРег = "jpg" ИЛИ РасширениеНРег = "jpeg"
				ИЛИ РасширениеНРег = "bmp" Тогда
			Обработка.УстановитьФормат(ФорматКартинки.JPEG);
		Иначе
			// PNG/GIF - оставляем PNG (сохраняем альфа-канал,
			// для GIF теряется анимация - допустимо для инструкций).
			Обработка.УстановитьФормат(ФорматКартинки.PNG);
		КонецЕсли;

		ГотоваяКартинка = Обработка.ПолучитьКартинку();
		ГотовыеДвоичныеДанные = ГотоваяКартинка.ПолучитьДвоичныеДанные();
	Исключение
		// Не получилось сжать - отдаём исходник.
		Возврат Результат;
	КонецПопытки;

	Если ГотовыеДвоичныеДанные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Вставить("Base64", Base64Строка(ГотовыеДвоичныеДанные));
	Если РасширениеНРег = "jpg" ИЛИ РасширениеНРег = "jpeg"
			ИЛИ РасширениеНРег = "bmp" Тогда
		Результат.Вставить("Mime", "image/jpeg");
	Иначе
		Результат.Вставить("Mime", "image/png");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает MIME-тип по расширению файла изображения.
// Зеркало функции из ГКСИ_MarkdownПереопределяемый.ПолучитьMimeТип -
// нужно здесь, чтобы модуль реализации был самодостаточным (если
// ГКСИ_MarkdownПереопределяемый когда-то перестанет её экспортировать,
// кеш продолжит работать).
//
Функция ПолучитьMimeТипИзображения(Расширение)

	Если Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "jpg" ИЛИ Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "svg" Тогда
		Возврат "image/svg+xml";
	Иначе
		Возврат "application/octet-stream";
	КонецЕсли;

КонецФункции

#КонецОбласти
