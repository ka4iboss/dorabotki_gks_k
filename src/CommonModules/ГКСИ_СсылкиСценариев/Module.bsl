// Общий модуль ГКСИ_СсылкиСценариев.
//
// Разрешение и подстановка «вики-ссылок» вида [[Имя]] и [[Имя|Отображаемый текст]]
// на группы и шаги демонстрационных сценариев.
//
// Ссылки используются в Markdown-текстах описаний сценариев и должны быть
// кликабельными:
//   * на форме элемента/группы (предпросмотр Markdown и режим просмотра);
//   * в альбоме процессов (прокрутка к разделу внутри документа).
//
// Разрешение цели:
//   * сначала цель сопоставляется с кодом в контексте (ресурс КодВКонтексте
//     регистра ГКСИ_ГруппыСценариев) — этот код уникален и однозначен;
//   * затем — с наименованием узла, но только если такое наименование
//     уникально в пределах карты. Неоднозначное наименование не разрешается:
//     ссылка отображается как «битая» и требует указания кода.
//
// Формат HTML, который формируют ПодставитьСсылкиВТекст и JS-предобработчик
// предпросмотра, должен совпадать по порядку атрибутов:
//   <a class="gksi-link" href="<адрес>" data-gksi-anchor="<якорь>">текст</a>
// На этот формат опирается ПереписатьСсылкиНаЯкоряВHTML.

#Область ПрограммныйИнтерфейс

// Возвращает карту узлов демонстрационных сценариев для разрешения вики-ссылок.
//
// Карта строится пакетом из двух запросов (без обращений к БД в цикле):
// связи регистра ГКСИ_ГруппыСценариев и реквизиты узлов, встречающихся в связях.
//
// Параметры:
//  КорниИнструкций - CatalogRef.ДемонстрационныеСценарии,
//                    Массив из CatalogRef.ДемонстрационныеСценарии, Неопределено -
//                    корень инструкции, массив корней или Неопределено (тогда
//                    карта строится по всему справочнику). В карту попадают
//                    только узлы перечисленных инструкций; уникальность
//                    наименований считается в пределах всей карты.
//
// Возвращаемое значение:
//  Структура:
//   * ПоИменам   - Соответствие из КлючИЗначение - наименование в верхнем
//                  регистре -> ссылка узла. Содержит только уникальные
//                  наименования; дубли из карты исключаются.
//   * ПоКодам    - Соответствие из КлючИЗначение - КодВКонтексте -> ссылка узла.
//   * ПоСсылкам  - Соответствие из КлючИЗначение - ссылка узла ->
//                  Структура("Наименование, Код, ЭтоГруппа").
//   * Пустая     - Булево - Истина, если в карте нет ни одного узла.
//
Функция КартаСсылокСценариев(КорниИнструкций = Неопределено) Экспорт

	Карта = Новый Структура;
	Карта.Вставить("ПоИменам",  Новый Соответствие);
	Карта.Вставить("ПоКодам",   Новый Соответствие);
	Карта.Вставить("ПоСсылкам", Новый Соответствие);
	Карта.Вставить("Пустая",    Истина);

	МассивКорней = МассивКорнейИнструкций(КорниИнструкций);
	Если МассивКорней <> Неопределено И МассивКорней.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	// Пакет 1: связи регистра. Собираем множество ссылок узлов и коды
	// в контексте по каждой ссылке.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
	|	ГКСИ_ГруппыСценариев.КодВКонтексте КАК КодВКонтексте
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев";
	Если МассивКорней <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
			|ГДЕ
			|	ГКСИ_ГруппыСценариев.КореньИнструкции В (&Корни)";
		Запрос.УстановитьПараметр("Корни", МассивКорней);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	МножествоСсылок   = Новый Соответствие;
	КодыПоСсылкам    = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		МножествоСсылок.Вставить(Выборка.Сценарий, Истина);
		МножествоСсылок.Вставить(Выборка.Группа, Истина);

		Если Не ПустаяСтрока(Выборка.КодВКонтексте) Тогда
			КодыСсылки = КодыПоСсылкам.Получить(Выборка.Сценарий);
			Если КодыСсылки = Неопределено Тогда
				КодыСсылки = Новый Массив;
				КодыПоСсылкам.Вставить(Выборка.Сценарий, КодыСсылки);
			КонецЕсли;
			Если КодыСсылки.Найти(Выборка.КодВКонтексте) = Неопределено Тогда
				КодыСсылки.Добавить(Выборка.КодВКонтексте);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	МассивСсылок = Новый Массив;
	Для Каждого КлючИЗначение Из МножествоСсылок Цикл
		Если ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
			МассивСсылок.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	// Пакет 2: реквизиты узлов одним запросом.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДемонстрационныеСценарии.Ссылка КАК Ссылка,
	|	ДемонстрационныеСценарии.Наименование КАК Наименование,
	|	ДемонстрационныеСценарии.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
	|ГДЕ
	|	ДемонстрационныеСценарии.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);

	НаименованияПоСсылкам = Новый Соответствие;
	ЭтоГруппыПоСсылкам    = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаименованияПоСсылкам.Вставить(Выборка.Ссылка, СокрЛП(Выборка.Наименование));
		ЭтоГруппыПоСсылкам.Вставить(Выборка.Ссылка, Выборка.ЭтоГруппа = Истина);
	КонецЦикла;

	// Индексы наименований и кодов.
	СчётчикиИмён = Новый Соответствие;
	Для Каждого КлючИЗначение Из НаименованияПоСсылкам Цикл
		КлючИмени = ВРег(КлючИЗначение.Значение);
		Если ПустаяСтрока(КлючИмени) Тогда
			Продолжить;
		КонецЕсли;
		СчётчикиИмён.Вставить(КлючИмени,
			?(СчётчикиИмён.Получить(КлючИмени) = Неопределено, 1,
				СчётчикиИмён.Получить(КлючИмени) + 1));
	КонецЦикла;

	Для Каждого КлючИЗначение Из НаименованияПоСсылкам Цикл

		Ссылка      = КлючИЗначение.Ключ;
		Наименование = КлючИЗначение.Значение;
		КлючИмени   = ВРег(Наименование);

		КодыСсылки = КодыПоСсылкам.Получить(Ссылка);
		КодСсылки  = ?(КодыСсылки = Неопределено ИЛИ КодыСсылки.Количество() = 0,
			"", КодыСсылки[0]);

		Карта.ПоСсылкам.Вставить(Ссылка, Новый Структура(
			"Наименование, Код, ЭтоГруппа",
			Наименование, КодСсылки, ЭтоГруппыПоСсылкам.Получить(Ссылка)));

		Если Не ПустаяСтрока(КлючИмени)
				И СчётчикиИмён.Получить(КлючИмени) = 1 Тогда
			Карта.ПоИменам.Вставить(КлючИмени, Ссылка);
		КонецЕсли;

		Если КодыСсылки <> Неопределено Тогда
			Для Каждого Код Из КодыСсылки Цикл
				Если Карта.ПоКодам.Получить(Код) = Неопределено Тогда
					Карта.ПоКодам.Вставить(Код, Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Карта.Пустая = (Карта.ПоСсылкам.Количество() = 0);

	Возврат Карта;

КонецФункции

// Разрешает цель вики-ссылки в ссылку узла справочника.
//
// Параметры:
//  Цель - Строка - содержимое ссылки до символа "|" (имя узла или его код
//         в контексте).
//  Карта - Структура - см. КартаСсылокСценариев().
//
// Возвращаемое значение:
//  CatalogRef.ДемонстрационныеСценарии, Неопределено - ссылка узла или
//  Неопределено, если цель не разрешена.
//
Функция РазрешитьЦель(Цель, Карта) Экспорт

	Если Карта = Неопределено ИЛИ ПустаяСтрока(Цель) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = СокрЛП(Цель);

	// Код в контексте — однозначный идентификатор, проверяем первым.
	Ссылка = Карта.ПоКодам.Получить(Ключ);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Карта.ПоИменам.Получить(ВРег(Ключ));

КонецФункции

// Возвращает навигационную ссылку на узел демонстрационного сценария.
//
// Параметры:
//  Ссылка - CatalogRef.ДемонстрационныеСценарии - узел сценария.
//
// Возвращаемое значение:
//  Строка - навигационная ссылка вида e1cib/data/... или пустая строка,
//  если ссылку получить не удалось.
//
Функция НавигационнаяСсылкаУзла(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ПолучитьНавигационнуюСсылку(Ссылка);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Возвращает имя HTML-якоря узла для внутренних переходов внутри альбома.
//
// Параметры:
//  Ссылка - CatalogRef.ДемонстрационныеСценарии - узел сценария.
//
// Возвращаемое значение:
//  Строка - имя якоря вида "gksi-node-<uuid>".
//
Функция ИмяЯкоряУзла(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "gksi-node-" + Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

// Экранирует спецсимволы HTML в строке.
//
// Параметры:
//  Значение - Произвольный - значение, приводимое к строке.
//
// Возвращаемое значение:
//  Строка - экранированная строка.
//
Функция ЭкранироватьHTMLСтроку(Знач Значение) Экспорт

	Результат = Строка(Значение);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");

	Возврат Результат;

КонецФункции

// Проверяет, содержит ли текст хотя бы одну вики-ссылку [[...]].
//
// Синтаксис картинок ![[...]] ссылкой не считается.
//
// Параметры:
//  Текст - Строка - проверяемый текст.
//
// Возвращаемое значение:
//  Булево - Истина, если в тексте есть вики-ссылка.
//
Функция ЕстьВикиСсылки(Текст) Экспорт

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Позиция = СтрНайти(Текст, "[[");
	Пока Позиция > 0 Цикл
		Если Позиция = 1 ИЛИ Сред(Текст, Позиция - 1, 1) <> "!" Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Текст, "[[", , Позиция + 2);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Заменяет вики-ссылки [[...]] в тексте на HTML-разметку.
//
// Синтаксис:
//  [[Цель]]              - отображается сама цель;
//  [[Цель|Текст]]        - отображается указанный текст;
//  ![[...]]              - картинка, не обрабатывается.
//
// Неразрешённые цели превращаются в <span class="gksi-link-broken"> с
// подсказкой — это сигнал автору текста, что ссылка указана неверно.
//
// Параметры:
//  Текст            - Строка - исходный Markdown или HTML-фрагмент.
//  Карта            - Структура - см. КартаСсылокСценариев().
//  РежимПодстановки - Строка - "Навигация" (по умолчанию) - в href попадает
//                     навигационная ссылка 1С; "Якорь" - в href попадает
//                     внутренний якорь #gksi-node-<uuid>.
//
// Возвращаемое значение:
//  Строка - текст с подставленной HTML-разметкой ссылок.
//
Функция ПодставитьСсылкиВТекст(Текст, Карта, РежимПодстановки = "Навигация") Экспорт

	Если Не ЗначениеЗаполнено(Текст) ИЛИ Карта = Неопределено ИЛИ Карта.Пустая Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	Позиция   = 1;
	Длина     = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл

		НачалоСсылки = СтрНайти(Текст, "[[", , Позиция);
		Если НачалоСсылки = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;

		// Картинка ![[...]] — не ссылка: переносим открывающие скобки как текст.
		ПредыдущийСимвол = ?(НачалоСсылки > 1, Сред(Текст, НачалоСсылки - 1, 1), "");
		Если ПредыдущийСимвол = "!" Тогда
			Результат = Результат + Сред(Текст, Позиция, НачалоСсылки + 1 - Позиция);
			Позиция = НачалоСсылки + 2;
			Продолжить;
		КонецЕсли;

		КонецСсылки = СтрНайти(Текст, "]]", , НачалоСсылки + 2);
		Если КонецСсылки = 0 Тогда
			Результат = Результат + Сред(Текст, Позиция);
			Прервать;
		КонецЕсли;

		Содержимое = Сред(Текст, НачалоСсылки + 2, КонецСсылки - НачалоСсылки - 2);

		// Внутри цели недопустимы вложенные скобки и переводы строк —
		// такие конструкции оставляем как обычный текст.
		Если СтрНайти(Содержимое, "[") > 0
				ИЛИ СтрНайти(Содержимое, Символы.ПС) > 0
				ИЛИ СтрНайти(Содержимое, Символы.ВК) > 0 Тогда
			Результат = Результат + Сред(Текст, Позиция, КонецСсылки + 2 - Позиция);
			Позиция = КонецСсылки + 2;
			Продолжить;
		КонецЕсли;

		Части = СтрРазделить(Содержимое, "|", Ложь);
		Цель  = СокрЛП(Части[0]);
		ТекстОтображения = ?(Части.Количество() > 1, СокрЛП(Части[1]), Цель);
		Если ПустаяСтрока(ТекстОтображения) Тогда
			ТекстОтображения = Цель;
		КонецЕсли;

		Результат = Результат + Сред(Текст, Позиция, НачалоСсылки - Позиция);

		Ссылка = РазрешитьЦель(Цель, Карта);
		Если Ссылка = Неопределено Тогда
			ЗаголовокБитойСсылки = СтрШаблон(
				НСтр("ru = 'Ссылка не найдена: %1'"), Цель);
			Результат = Результат
				+ "<span class=""gksi-link-broken"" title="""
				+ ЭкранироватьHTMLСтроку(ЗаголовокБитойСсылки) + """>"
				+ ЭкранироватьHTMLСтроку(ТекстОтображения) + "</span>";
		Иначе
			Якорь = ИмяЯкоряУзла(Ссылка);
			Если РежимПодстановки = "Якорь" Тогда
				Адрес = "#" + Якорь;
			Иначе
				Адрес = НавигационнаяСсылкаУзла(Ссылка);
				Если ПустаяСтрока(Адрес) Тогда
					Адрес = "#" + Якорь;
				КонецЕсли;
			КонецЕсли;
			Результат = Результат
				+ "<a class=""gksi-link"" href=""" + ЭкранироватьHTMLСтроку(Адрес)
				+ """ data-gksi-anchor=""" + Якорь + """>"
				+ ЭкранироватьHTMLСтроку(ТекстОтображения) + "</a>";
		КонецЕсли;

		Позиция = КонецСсылки + 2;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает карту ссылок в формате JSON для JS-предобработки предпросмотра Markdown.
//
// Формат элемента: {"name":"...","code":"...","href":"...","anchor":"..."}.
// Массив упорядочен по убыванию длины наименования — так же, как термины
// глоссария, чтобы при поиске по имени первыми проверялись длинные варианты.
//
// Параметры:
//  Карта - Структура - см. КартаСсылокСценариев().
//
// Возвращаемое значение:
//  Строка - JSON-массив; "[]", если ссылок нет.
//
Функция СсылкиJSONДляКлиента(Карта) Экспорт

	Если Карта = Неопределено ИЛИ Карта.Пустая Тогда
		Возврат "[]";
	КонецЕсли;

	МассивУзлов = Новый Массив;
	Для Каждого КлючИЗначение Из Карта.ПоСсылкам Цикл
		МассивУзлов.Добавить(КлючИЗначение);
	КонецЦикла;

	Для Внешний = 0 По МассивУзлов.Количество() - 2 Цикл
		Для Внутренний = 0 По МассивУзлов.Количество() - Внешний - 2 Цикл
			Левый  = МассивУзлов[Внутренний];
			Правый = МассивУзлов[Внутренний + 1];
			Если СтрДлина(Левый.Значение.Наименование) < СтрДлина(Правый.Значение.Наименование) Тогда
				МассивУзлов[Внутренний]     = Правый;
				МассивУзлов[Внутренний + 1] = Левый;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого Элемент Из МассивУзлов Цикл
		Ссылка       = Элемент.Ключ;
		Представление = Элемент.Значение;
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("name");
		ЗаписьJSON.ЗаписатьЗначение(Представление.Наименование);
		ЗаписьJSON.ЗаписатьИмяСвойства("code");
		ЗаписьJSON.ЗаписатьЗначение(Представление.Код);
		ЗаписьJSON.ЗаписатьИмяСвойства("href");
		ЗаписьJSON.ЗаписатьЗначение(НавигационнаяСсылкаУзла(Ссылка));
		ЗаписьJSON.ЗаписатьИмяСвойства("anchor");
		ЗаписьJSON.ЗаписатьЗначение(ИмяЯкоряУзла(Ссылка));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Переписывает ссылки на узлы в HTML-описании альбома на внутренние якоря.
//
// Ссылки, ведущие на узлы, которых нет в альбоме, остаются навигационными
// (открывают объект). Ссылки на узлы альбома превращаются в #gksi-node-<uuid>,
// чтобы браузер прокрутил документ к нужному разделу.
//
// Формат обрабатываемой разметки должен совпадать с выдаваемым функцией
// ПодставитьСсылкиВТекст: атрибуты идут в порядке class, href, data-gksi-anchor.
//
// Параметры:
//  HTML            - Строка - HTML-описание из присоединённого файла.
//  МножествоЯкорей - Соответствие из КлючИЗначение - имя якоря -> Истина
//                    для узлов, присутствующих в альбоме.
//
// Возвращаемое значение:
//  Строка - HTML с переписанными ссылками.
//
Функция ПереписатьСсылкиНаЯкоряВHTML(HTML, МножествоЯкорей) Экспорт

	Если Не ЗначениеЗаполнено(HTML) ИЛИ МножествоЯкорей = Неопределено
			ИЛИ МножествоЯкорей.Количество() = 0 Тогда
		Возврат HTML;
	КонецЕсли;

	НачалоТега   = "<a class=""gksi-link"" href=""";
	Разделитель  = """ data-gksi-anchor=""";
	Позиция = СтрНайти(HTML, НачалоТега);

	Пока Позиция > 0 Цикл

		НачалоАдреса = Позиция + СтрДлина(НачалоТега);
		КонецАдреса  = СтрНайти(HTML, Разделитель, , НачалоАдреса);
		Если КонецАдреса = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоЯкоря = КонецАдреса + СтрДлина(Разделитель);
		КонецЯкоря  = СтрНайти(HTML, """", , НачалоЯкоря);
		Если КонецЯкоря = 0 Тогда
			Прервать;
		КонецЕсли;

		Якорь = Сред(HTML, НачалоЯкоря, КонецЯкоря - НачалоЯкоря);

		Если МножествоЯкорей.Получить(Якорь) <> Неопределено Тогда
			HTML = Лев(HTML, НачалоАдреса - 1) + "#" + Якорь
				+ Сред(HTML, КонецАдреса);
			Позиция = НачалоАдреса;
		Иначе
			Позиция = КонецЯкоря;
		КонецЕсли;

		Позиция = СтрНайти(HTML, НачалоТега, , Позиция);

	КонецЦикла;

	Возврат HTML;

КонецФункции

// Возвращает корни инструкций для набора узлов демонстрационных сценариев.
//
// Параметры:
//  Узлы - Массив из CatalogRef.ДемонстрационныеСценарии - ссылки узлов.
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии - корни инструкций (без повторов).
//
Функция КорниИнструкцийУзлов(Узлы) Экспорт

	Результат = Новый Массив;
	Если Узлы = Неопределено ИЛИ Узлы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.Сценарий В (&Узлы)
	|	ИЛИ ГКСИ_ГруппыСценариев.Группа В (&Узлы)");
	Запрос.УстановитьПараметр("Узлы", Узлы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.КореньИнструкции) Тогда
			Результат.Добавить(Выборка.КореньИнструкции);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает корень инструкции, к которой относится узел демонстрационного сценария.
//
// Параметры:
//  Ссылка - CatalogRef.ДемонстрационныеСценарии - узел сценария.
//
// Возвращаемое значение:
//  CatalogRef.ДемонстрационныеСценарии - корень инструкции; сама ссылка,
//  если узел не найден в регистре связей.
//
Функция КореньИнструкцииУзла(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.Сценарий = &Ссылка
	|	ИЛИ ГКСИ_ГруппыСценариев.Группа = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.КореньИнструкции) Тогда
		Возврат Выборка.КореньИнструкции;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Возвращает карту вики-ссылок для узла демонстрационного сценария.
//
// Карта строится по инструкции, которой принадлежит узел.
//
// Параметры:
//  Ссылка - CatalogRef.ДемонстрационныеСценарии - узел сценария.
//
// Возвращаемое значение:
//  Структура:
//   * ПоИменам   - Соответствие из КлючИЗначение - наименование в верхнем
//                  регистре -> ссылка узла. Содержит только уникальные
//                  наименования; дубли из карты исключаются.
//   * ПоКодам    - Соответствие из КлючИЗначение - КодВКонтексте -> ссылка узла.
//   * ПоСсылкам  - Соответствие из КлючИЗначение - ссылка узла ->
//                  Структура("Наименование, Код, ЭтоГруппа").
//   * Пустая     - Булево - Истина, если в карте нет ни одного узла.
//
Функция КартаСсылокДляУзла(Ссылка) Экспорт

	Возврат КартаСсылокСценариев(КореньИнструкцииУзла(Ссылка));

КонецФункции

// Возвращает узлы инструкции для выбора в форме вставки вики-ссылки.
//
// Узлом считается сценарий (Сценарий = узел) либо группа-обёртка инструкции.
// Код узла — минимальный код в контексте среди всех записей регистра по этому
// узлу: он однозначно разрешается в ссылку (см. РазрешитьЦель).
//
// Параметры:
//  КореньИнструкции - CatalogRef.ДемонстрационныеСценарии - корень инструкции.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Ссылка       - CatalogRef.ДемонстрационныеСценарии - узел.
//   * Наименование - Строка - наименование узла.
//   * Код          - Строка - код узла в контексте инструкции.
//   * ЭтоГруппа    - Булево - признак группы.
//
Функция УзлыИнструкцииДляВыбора(КореньИнструкции) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка",
		Новый ОписаниеТипов("СправочникСсылка.ДемонстрационныеСценарии"));
	Таблица.Колонки.Добавить("Наименование",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("Код",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));

	Если Не ЗначениеЗаполнено(КореньИнструкции) Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Узел,
	|	МИНИМУМ(ГКСИ_ГруппыСценариев.КодВКонтексте) КАК Код
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.КореньИнструкции = &КореньИнструкции
	|СГРУППИРОВАТЬ ПО
	|	ГКСИ_ГруппыСценариев.Сценарий");
	Запрос.УстановитьПараметр("КореньИнструкции", КореньИнструкции);

	КодыПоУзлам = Новый Соответствие;
	МассивУзлов = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Узел) Тогда
			Продолжить;
		КонецЕсли;
		КодыПоУзлам.Вставить(Выборка.Узел, СокрЛП(Выборка.Код));
		МассивУзлов.Добавить(Выборка.Узел);
	КонецЦикла;

	Если МассивУзлов.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДемонстрационныеСценарии.Ссылка КАК Ссылка,
	|	ДемонстрационныеСценарии.Наименование КАК Наименование,
	|	ДемонстрационныеСценарии.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
	|ГДЕ
	|	ДемонстрационныеСценарии.Ссылка В (&Узлы)");
	Запрос.УстановитьПараметр("Узлы", МассивУзлов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Ссылка       = Выборка.Ссылка;
		СтрокаТаблицы.Наименование = СокрЛП(Выборка.Наименование);
		СтрокаТаблицы.Код          = КодыПоУзлам.Получить(Выборка.Ссылка);
		СтрокаТаблицы.ЭтоГруппа    = (Выборка.ЭтоГруппа = Истина);
	КонецЦикла;

	Таблица.Сортировать("Код Возр");

	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит параметр корней инструкций к массиву ссылок.
//
// Параметры:
//  КорниИнструкций - CatalogRef.ДемонстрационныеСценарии,
//                    Массив из CatalogRef.ДемонстрационныеСценарии, Неопределено -
//                    одиночная ссылка, массив ссылок или Неопределено.
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии, Неопределено - массив непустых
//  ссылок или Неопределено, если фильтр по корням не задан.
//
Функция МассивКорнейИнструкций(КорниИнструкций)

	Если КорниИнструкций = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;
	Если ТипЗнч(КорниИнструкций) = Тип("Массив") Тогда
		Для Каждого Элемент Из КорниИнструкций Цикл
			Если ЗначениеЗаполнено(Элемент) Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(КорниИнструкций) Тогда
		Результат.Добавить(КорниИнструкций);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
