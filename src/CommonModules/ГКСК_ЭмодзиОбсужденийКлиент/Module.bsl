#Область ПрограммныйИнтерфейс

// Формирует команды системы взаимодействия: типовые команды БСП плюс подменю с эмодзи.
//
// Параметры:
//  ПараметрыКоманд - ПараметрыФормированияКомандСистемыВзаимодействия - параметры формирования команд.
//  Команды - Массив из ОписаниеКомандыСистемыВзаимодействия - формируемый список команд.
//  КомандаПоУмолчанию - ОписаниеКомандыСистемыВзаимодействия, Булево - команда по умолчанию.
//  ДополнительныеПараметры - Произвольный - дополнительные параметры обработчика.
//
Процедура ПриФормированииКомандСистемыВзаимодействий(ПараметрыКоманд, Команды, КомандаПоУмолчанию,
	ДополнительныеПараметры) Экспорт

	ОбсужденияСлужебныйКлиент.ПриФормированииКомандСистемыВзаимодействий(
		ПараметрыКоманд, Команды, КомандаПоУмолчанию, ДополнительныеПараметры);

	ДобавитьКомандыЭмодзи(ПараметрыКоманд, Команды);

КонецПроцедуры

// Добавляет в список команд подменю с эмодзи для отправки в обсуждение.
//
// Параметры:
//  ПараметрыКоманд - ПараметрыФормированияКомандСистемыВзаимодействия - параметры формирования команд.
//  Команды - Массив из ОписаниеКомандыСистемыВзаимодействия - формируемый список команд.
//
Процедура ДобавитьКомандыЭмодзи(ПараметрыКоманд, Команды) Экспорт

	Если ПараметрыКоманд.Сообщение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Обсуждение = ПараметрыКоманд.Сообщение.Обсуждение;
	Если Обсуждение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОбсуждения = Строка(Обсуждение.Идентификатор);

	КомандыЭмодзи = Новый Массив;

	ПараметрыПикера = Новый Структура("ИдентификаторОбсуждения", ИдентификаторОбсуждения);
	ОповещениеПикера = Новый ОписаниеОповещения("ОткрытьПикер", ЭтотОбъект, ПараметрыПикера);
	КомандыЭмодзи.Добавить(Новый ОписаниеКомандыСистемыВзаимодействия(ОповещениеПикера,
		НСтр("ru = 'Выбрать из набора…'")));
	КомандыЭмодзи.Добавить(Новый ОписаниеКомандыСистемыВзаимодействия(Неопределено));

	Для Каждого Символ Из ЭмодзиДляОтправки() Цикл
		ПараметрыКоманды = Новый Структура("ИдентификаторОбсуждения, Эмодзи", ИдентификаторОбсуждения, Символ);
		Оповещение = Новый ОписаниеОповещения("ОтправитьЭмодзиЗавершение", ЭтотОбъект, ПараметрыКоманды);
		КомандыЭмодзи.Добавить(Новый ОписаниеКомандыСистемыВзаимодействия(Оповещение, Символ));
	КонецЦикла;

	Команды.Добавить(Новый ОписаниеКомандыСистемыВзаимодействия(КомандыЭмодзи, НСтр("ru = 'Эмодзи'")));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Открывает форму выбора эмодзи из полного набора.
//
// Параметры:
//  ПараметрыКоманды - Структура - содержит:
//   * ИдентификаторОбсуждения - Строка - строковое представление идентификатора обсуждения.
//
Процедура ОткрытьПикер(ПараметрыКоманды) Экспорт

	ПараметрыФормы = Новый Структура("ИдентификаторОбсуждения", ПараметрыКоманды.ИдентификаторОбсуждения);
	ОткрытьФорму("ОбщаяФорма.ГКСК_ВыборЭмодзи", ПараметрыФормы);

КонецПроцедуры

// Отправляет выбранный эмодзи в обсуждение.
//
// Параметры:
//  ПараметрыКоманды - Структура - содержит:
//   * ИдентификаторОбсуждения - Строка - строковое представление идентификатора обсуждения.
//   * Эмодзи - Строка - символ эмодзи.
//
Процедура ОтправитьЭмодзиЗавершение(ПараметрыКоманды) Экспорт

	ГКСК_ЭмодзиОбсужденийВызовСервера.ОтправитьЭмодзи(ПараметрыКоманды.ИдентификаторОбсуждения,
		ПараметрыКоманды.Эмодзи);

КонецПроцедуры

