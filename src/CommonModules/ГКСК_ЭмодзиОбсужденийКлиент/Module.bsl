#Область ПрограммныйИнтерфейс

// Добавляет в список команд подменю с эмодзи для отправки в обсуждение.
//
// Параметры:
//  ПараметрыКоманд - ПараметрыФормированияКомандСистемыВзаимодействия - параметры формирования команд.
//  Команды - Массив из ОписаниеКомандыСистемыВзаимодействия - формируемый список команд.
//
Процедура ДобавитьКомандыЭмодзи(ПараметрыКоманд, Команды) Экспорт

	Если ПараметрыКоманд.Сообщение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОбсуждения = ПараметрыКоманд.Сообщение.Обсуждение;
	Если ИдентификаторОбсуждения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КомандыЭмодзи = Новый Массив;

	Для Каждого Символ Из ЭмодзиДляОтправки() Цикл
		ПараметрыКоманды = Новый Структура("ИдентификаторОбсуждения, Эмодзи", ИдентификаторОбсуждения, Символ);
		Оповещение = Новый ОписаниеОповещения("ОтправитьЭмодзиЗавершение", ЭтотОбъект, ПараметрыКоманды);
		КомандыЭмодзи.Добавить(Новый ОписаниеКомандыСистемыВзаимодействия(Оповещение, Символ));
	КонецЦикла;

	Команды.Добавить(Новый ОписаниеКомандыСистемыВзаимодействия(КомандыЭмодзи, НСтр("ru = 'Эмодзи'")));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отправляет выбранный эмодзи в обсуждение.
//
// Параметры:
//  ПараметрыКоманды - Структура - содержит:
//   * ИдентификаторОбсуждения - ИдентификаторОбсужденияСистемыВзаимодействия - обсуждение.
//   * Эмодзи - Строка - символ эмодзи.
//
Процедура ОтправитьЭмодзиЗавершение(ПараметрыКоманды) Экспорт

	ГКСК_ЭмодзиОбсужденийВызовСервера.ОтправитьЭмодзи(ПараметрыКоманды.ИдентификаторОбсуждения,
		ПараметрыКоманды.Эмодзи);

КонецПроцедуры

