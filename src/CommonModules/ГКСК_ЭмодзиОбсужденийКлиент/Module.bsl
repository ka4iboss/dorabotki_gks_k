	Эмодзи.Добавить("😱");
	Эмодзи.Добавить("🤔");
	Эмодзи.Добавить("👏");
	Эмодзи.Добавить("🙏");
	Эмодзи.Добавить("🔥");
	Эмодзи.Добавить("✅");
	Эмодзи.Добавить("❌");
