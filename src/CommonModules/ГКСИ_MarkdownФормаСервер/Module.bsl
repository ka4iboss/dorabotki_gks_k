// Серверный модуль форм с Markdown-редактором.
// Содержит серверные процедуры работы с формой:
// заполнение ФайлыBase64, сборка Markdown-сегмента, создание присоединённых файлов,
// добавление панели редактора и панели глоссария, управление шириной картинок.
// Используется в формах элемента и группы справочника ДемонстрационныеСценарии.

#Область ПрограммныйИнтерфейс

// Заполняет таблицу ФайлыBase64 данными из справочника ГКСИ_ФайлыИнструкций,
// используемую Markdown-редактором для подстановки картинок и вложений.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ЗаполнитьФайлыBase64(Форма) Экспорт

	Форма.ФайлыBase64.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Код, Файл, Расширение ИЗ Справочник.ГКСИ_ФайлыИнструкций";
	Результат = Запрос.Выполнить().Выбрать();

	Пока Результат.Следующий() Цикл
		Строка = Форма.ФайлыBase64.Добавить();
		Строка.Код = Результат.Код;
		ДвоичныеДанные = Результат.Файл.Получить();
		Base64 = Base64Строка(ДвоичныеДанные);
		Mime = ГКСИ_MarkdownПереопределяемый.ПолучитьMimeТип(Результат.Расширение);
		Строка.Base64 = "data:" + Mime + ";base64," + Base64;
	КонецЦикла;

КонецПроцедуры

// Собирает в реквизит ТекущийОбъект.ГКСИ_ТекстMarkdown финальный сегмент
// текущего языка из формы. Используется серверным ПередЗаписьюНаСервере.
//
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения - форма элемента/группы.
//  ТекущийОбъект   - СправочникОбъект.ДемонстрационныеСценарии - записываемый объект.
//
Процедура СобратьТекстMarkdown(Форма, ТекущийОбъект) Экспорт

	ТекущийОбъект.ГКСИ_ТекстMarkdown = ГКСИ_MarkdownФормаКлиентСервер.ЗаменитьСегментMarkdown(
		ТекущийОбъект.ГКСИ_ТекстMarkdown, Форма.ЯзыкСценария, Форма.ТекстMarkdownСтрока);
	ТекущийОбъект.ГКСИ_MarkdownСформирован = Истина;

КонецПроцедуры

// Для каждого кода языка из ПараметрыЗаписи[<КлючАдресаHTMLПоЯзыкам()>] находит
// или создаёт строку ТЧ объекта ТекущийОбъект.ОписанияСценария и для каждой:
//
//   - если ПрисоединенныйФайл уже есть — обновляет его содержимое через
//     ДемонстрационныеСценарии.РезультатОбновленияПрисоединенногоФайла;
//   - если ПрисоединенныйФайл ещё нет — создаёт новый файл через
//     РаботаСФайлами.ДобавитьФайл.
//
// Структура хранения:
//   Объект.ОписанияСценария — ТЧ объекта: КодЯзыка, ПрисоединенныйФайл, ХэшДанныхПоставщика.
//
// Вызывается из &Перед("ПередЗаписьюНаСервере") ДО типового обработчика.
//
// Логика проверена: полностью соответствует бэкапу, в котором перезапись
// гарантированно работает (см. R:\EDTProjects\GGKKSS\ГКС_Инструкции бэкап).
//
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения - форма-источник уникального идентификатора.
//  ТекущийОбъект   - СправочникОбъект.ДемонстрационныеСценарии - записываемый объект.
//  ПараметрыЗаписи - Структура - параметры записи формы (содержит ГКСИ_АдресHTMLПоЯзыкам).
//  Отказ           - Булево - признак отказа от записи.
//
Процедура СоздатьПрисоединенныеФайлыИзДопСвойств(Форма, ТекущийОбъект, ПараметрыЗаписи, Отказ) Экспорт

	КлючАдреса = ГКСИ_MarkdownФормаКлиентСервер.КлючАдресаHTMLПоЯзыкам();

	Если НЕ ПараметрыЗаписи.Свойство(КлючАдреса) Тогда
		Возврат;
	КонецЕсли;

	АдресВХ = ПараметрыЗаписи[КлючАдреса];
	Если НЕ ЗначениеЗаполнено(АдресВХ) Тогда
		Возврат;
	КонецЕсли;

	HTMLПоЯзыкам = ПолучитьИзВременногоХранилища(АдресВХ);
	Если HTMLПоЯзыкам = Неопределено ИЛИ HTMLПоЯзыкам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СсылкаНаСценарий = ТекущийОбъект.Ссылка;
	Если НЕ ЗначениеЗаполнено(СсылкаНаСценарий) Тогда
		СсылкаНового = Справочники.ДемонстрационныеСценарии.ПолучитьСсылку(Форма.УникальныйИдентификатор);
		ТекущийОбъект.УстановитьСсылкуНового(СсылкаНового);
		СсылкаНаСценарий = ТекущийОбъект.ПолучитьСсылкуНового();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СсылкаНаСценарий) Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяФайла = ТекущийОбъект.ПолныйКод;

	// Карта вики-ссылок на группы и шаги строится один раз на запись: ссылки
	// [[Имя]] разбираются до сохранения HTML в присоединённый файл (см. ниже).
	КартаСсылок = ГКСИ_СсылкиСценариев.КартаСсылокСценариев();

	Для Каждого КлючЗначение Из HTMLПоЯзыкам Цикл

		КодЯзыка  = КлючЗначение.Ключ;
		ТекстHTML = КлючЗначение.Значение;

		Если НЕ ЗначениеЗаполнено(КодЯзыка) ИЛИ НЕ ЗначениеЗаполнено(ТекстHTML) Тогда
			Продолжить;
		КонецЕсли;

		// Ссылки [[Имя]] на группы и шаги разбираются на сервере. Сохранённый HTML
		// читают типовые поля формы («Текст сценария» / «Текст сценария (чтение)»),
		// альбом процессов и внешние потребители файла — им нужны готовые <a>,
		// независимо от того, сработал ли JS-предобработчик предпросмотра.
		// Подстановка идемпотентна: если JS уже заменил ссылки, конструкций [[…]]
		// в HTML не остаётся.
		ТекстHTML = ГКСИ_СсылкиСценариев.ПодставитьСсылкиВТекст(ТекстHTML, КартаСсылок, "Навигация");

		// Видео !video(<путь>) -> HTML5-плеер. Как и ссылки, разбирается на
		// сервере: сохранённый HTML читают типовые поля формы и альбом
		// процессов. Идемпотентно.
		ТекстHTML = ГКСИ_Видео.РазметкуВидеоВHTML(ТекстHTML);

		СтруктураПоиска = Новый Структура("КодЯзыка", КодЯзыка);
		НайденныеСтроки = ТекущийОбъект.ОписанияСценария.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаОписания = НайденныеСтроки[0];
		Иначе
			СтрокаОписания = ТекущийОбъект.ОписанияСценария.Добавить();
			СтрокаОписания.КодЯзыка = КодЯзыка;
		КонецЕсли;

		Попытка
			Если ЗначениеЗаполнено(СтрокаОписания.ПрисоединенныйФайл) Тогда
				// Прогоняем HTML через ОбработатьАлертыВHTML наравне с созданием
				// нового файла в СоздатьПрисоединенныйФайлСценария - иначе inline-стили
				// GitHub Alerts будут только у впервые созданных файлов, а при
				// перезаписи алерты останутся без оформления.
				ДемонстрационныеСценарии.РезультатОбновленияПрисоединенногоФайла(
					СтрокаОписания.ПрисоединенныйФайл, Форма.УникальныйИдентификатор,
					ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ТекстHTML));
			Иначе
				СтрокаОписания.ПрисоединенныйФайл = СоздатьПрисоединенныйФайлСценария(
					СсылкаНаСценарий, Форма, ПолноеИмяФайла, КодЯзыка, ТекстHTML);
			КонецЕсли;
		Исключение
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Создаёт присоединённый HTML-файл сценария через РаботаСФайлами.
// Используется, когда у строки ТЧ ОписанияСценария ещё нет ПрисоединенногоФайла.
//
// Параметры:
//   ВладелецФайла - СправочникСсылка.ДемонстрационныеСценарии - владелец файла.
//   Форма         - ФормаКлиентскогоПриложения - форма-источник уникального идентификатора.
//   ПолныйКод     - Строка - полный код сценария (используется в имени файла).
//   КодЯзыка      - Строка - код языка (используется в имени файла).
//   ДанныеHTML       - Строка, ДвоичныеДанные - содержимое файла. Если Строка -
//                   прогоняется через ОбработатьАлертыВHTML (idempotentно). Если
//                   ДвоичныеДанные - используется как есть (считается, что backfill
//                   уже выполнен вызывающим кодом, чтобы не делать двойное
//                   преобразование Строка → ДвоичныеДанные → Строка → ДвоичныеДанные
//                   и не нарваться на падение типовой функции сохранения
//                   РезультатОбновленияПрисоединенногоФайла, если она тоже получит
//                   строку, у которой внутри мутируется СведенияОФайле).
//
// Возвращаемое значение:
//   СправочникСсылка.ДемонстрационныеСценарииПрисоединенныеФайлы, Неопределено - ссылка на созданный файл.
//
Функция СоздатьПрисоединенныйФайлСценария(ВладелецФайла, Форма, ПолныйКод, КодЯзыка, ДанныеHTML) Экспорт

	Если ТипЗнч(ДанныеHTML) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанныеФайла = ДанныеHTML;
	Иначе
		// GitHub Alerts: добавляем inline-стили на случай вызова из обходных
		// путей (например, РМ_СоздатьПрисоединенныйФайлСценария из ФормаГруппы),
		// которые не прогоняют HTML через ОбработатьАлертыВHTML.
		// Идемпотентно - повторный вызов не ломает уже стилизованный HTML.
		ДанныеHTML = ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ДанныеHTML);
		// Ссылки [[Имя]] на группы и шаги: сохранённый HTML читают типовые поля
		// формы, альбом процессов и внешние потребители файла, поэтому ссылки
		// разбираются на сервере. Идемпотентно: если JS-предобработчик
		// предпросмотра уже заменил ссылки, конструкций [[…]] не остаётся.
		ДанныеHTML = ГКСИ_СсылкиСценариев.ПодставитьСсылкиВТекст(ДанныеHTML,
			ГКСИ_СсылкиСценариев.КартаСсылокСценариев(), "Навигация");
		// Видео !video(<путь>) -> HTML5-плеер (см. СоздатьПрисоединенныеФайлыИзДопСвойств).
		ДанныеHTML = ГКСИ_Видео.РазметкуВидеоВHTML(ДанныеHTML);
		ДвоичныеДанныеФайла = ПолучитьДвоичныеДанныеИзСтроки(ДанныеHTML);
	КонецЕсли;

	АдресВоВременномХранилище  = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Форма.УникальныйИдентификатор);

	ПараметрыЗаписиФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыЗаписиФайла.ВладелецФайлов     = ВладелецФайла;
	ПараметрыЗаписиФайла.ИмяБезРасширения   = ДемонстрационныеСценарииКлиентСервер.ИмяФайлаОписанияСценария(
		ПолныйКод, КодЯзыка);
	ПараметрыЗаписиФайла.РасширениеБезТочки = "HTML";

	Возврат РаботаСФайлами.ДобавитьФайл(ПараметрыЗаписиФайла, АдресВоВременномХранилище, "");

КонецФункции

// Добавляет в форму программную панель Markdown-редактора (страницы
// «Редактирование/Просмотр» и таблицу присоединённых файлов). При наличии
// на форме страницы «СтраницаВариантОтображенияРедактирование» панель
// встраивается в неё, иначе — на верхний уровень формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ДобавитьПанельРедактора(Форма) Экспорт

	ДобавитьПолеШиринаКартинок(Форма);

	РодительскаяСтраница = Форма.Элементы.Найти("СтраницаВариантОтображенияРедактирование");
	Если РодительскаяСтраница <> Неопределено Тогда
		ГКСИ_MarkdownСерверВызовСервера.ВставитьПолеРедактированияТекстаНаФорму(Форма, РодительскаяСтраница, "ТекстMarkdownСтрока", Истина, , , Форма.ШиринаКартинок);
	Иначе
		ГКСИ_MarkdownСерверВызовСервера.ВставитьПолеРедактированияТекстаНаФорму(Форма, Форма, "ТекстMarkdownСтрока", Истина, , , Форма.ШиринаКартинок);
	КонецЕсли;

	ДобавитьПанельГлоссария(Форма);

КонецПроцедуры

// Добавляет поле ввода ШиринаКартинок рядом с панелью редактора Markdown.
// Сам реквизит формы объявлен декларативно в Form.form.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ДобавитьПолеШиринаКартинок(Форма) Экспорт

	Если Форма.Элементы.Найти("ШиринаКартинок") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Родитель = Форма.Элементы.Найти("СтраницаВариантОтображенияРедактирование");
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
	КонецЕсли;

	ПолеВвода = Форма.Элементы.Добавить("ШиринаКартинок", Тип("ПолеФормы"), Родитель);
	ПолеВвода.Заголовок = "Ширина картинок и видео";
	ПолеВвода.Подсказка = "CSS-значение, например 100%, 600px, 40em. Управляет размером картинок и видео";
	ПолеВвода.ПутьКДанным = "ШиринаКартинок";
	//@skip-warning SU80 - имя обработчика соответствует имени процедуры в формах;
	// переименование будет выполнено отдельным этапом.
	ПолеВвода.УстановитьДействие("ПриИзменении", "РМ_Подключаемый_ШиринаКартинокПриИзменении");

КонецПроцедуры

// Программно добавляет на форму страницу "Глоссарий" с таблицей терминов,
// отфильтрованных по объекту метаданных текущего элемента.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ДобавитьПанельГлоссария(Форма) Экспорт

	Если Форма.Элементы.Найти("ГКСИ_СтраницаГлоссарий") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяСтраница = Форма.Элементы.Добавить("ГКСИ_СтраницаГлоссарий", Тип("ГруппаФормы"));
	НоваяСтраница.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяСтраница.Заголовок = "Глоссарий";
	НоваяСтраница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	ТаблицаГлоссария = Форма.Элементы.Добавить("ГКСИ_ТаблицаГлоссария", Тип("ТаблицаФормы"), НоваяСтраница);
	ТаблицаГлоссария.ПутьКДанным = "ГКСИ_ТерминыГлоссария";
	КолонкаНаименованиеЭлемент = Форма.Элементы.Добавить("ГКСИ_ТерминНаименование", Тип("ПолеФормы"), ТаблицаГлоссария);
	КолонкаНаименованиеЭлемент.ПутьКДанным = "ГКСИ_ТерминыГлоссария.Наименование";
	КолонкаНаименованиеЭлемент.Заголовок = "Термин";
	КолонкаОписаниеЭлемент = Форма.Элементы.Добавить("ГКСИ_ТерминОписание", Тип("ПолеФормы"), ТаблицаГлоссария);
	КолонкаОписаниеЭлемент.ПутьКДанным = "ГКСИ_ТерминыГлоссария.Описание";
	КолонкаОписаниеЭлемент.Заголовок = "Описание";

	ОбновитьТаблицуГлоссария(Форма);

КонецПроцедуры

// Заполняет таблицу ГКСИ_ТерминыГлоссария по объекту метаданных
// текущего элемента.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ОбновитьТаблицуГлоссария(Форма) Экспорт

	Форма.ГКСИ_ТерминыГлоссария.Очистить();
	Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОбъекта = ГКСИ_Глоссарий.ИдентификаторОбъектаМетаданных(Форма.Объект.Ссылка);
	МассивОбъектов = Новый Массив;
	Если ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		МассивОбъектов.Добавить(ИдентификаторОбъекта);
	КонецЕсли;

	КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	Термины = ГКСИ_Глоссарий.ТерминыПоОбъектамМетаданных(МассивОбъектов, КодЯзыка);
	Для Каждого Строка Из Термины Цикл
		НоваяСтрока = Форма.ГКСИ_ТерминыГлоссария.Добавить();
		НоваяСтрока.Ссылка = XMLСтрока(Строка.Ссылка);
		НоваяСтрока.Наименование = Строка.Наименование;
		НоваяСтрока.Описание = Строка.Описание;
	КонецЦикла;

КонецПроцедуры

// Перечитывает ТЧ ОписанияСценария и реквизиты ТекстСценария/ТекстСценарияЧтение
// из базы сразу после записи. Платформа после ПослеЗаписиНаСервере НЕ вызывает
// ПриЧтенииНаСервере, поэтому данные формы устаревают до переоткрытия —
// здесь принудительно обновляем их, чтобы пользователь видел актуальный
// HTML в режиме просмотра без переоткрытия.
//
// Использует типовую ДемонстрационныеСценарии.ЗаполнитьОписанияСценариев,
// которая перечитывает строки ТЧ ОписанияСценария по ссылке объекта
// (с сохранением GUID существующих строк).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма элемента/группы.
//
Процедура ОбновитьОписанияПослеЗаписиНаСервере(Форма) Экспорт

	Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Форма.ОписанияСценария.Очистить();
	ДемонстрационныеСценарии.ЗаполнитьОписанияСценариев(Форма.Объект, Форма.ОписанияСценария);

	Форма.ТекстСценария       = ПолучитьОписаниеНаЯзыке(Форма, Форма.ЯзыкСценария);
	Форма.ТекстСценарияЧтение = ПолучитьОписаниеНаЯзыке(Форма, Форма.ЯзыкСценарияЧтение);

КонецПроцедуры

// Получает описание сценария на указанном языке (типовая функция формы).
//
// Параметры:
//  Форма    - ФормаКлиентскогоПриложения - форма элемента/группы.
//  КодЯзыка - Строка - код языка.
//
// Возвращаемое значение:
//  Строка - HTML-описание сценария на указанном языке.
//
Функция ПолучитьОписаниеНаЯзыке(Форма, КодЯзыка) Экспорт

	// Делегируем к типовой функции формы (определяется в Form.form).
	ТекстHTML = Форма.ПолучитьОписаниеНаЯзыке(КодЯзыка);
	// Прогоняем через серверную обработку алертов, чтобы в форме элемента/группы
	// GitHub Alerts ([!NOTE]/[!WARNING]/[!TIP]/[!IMPORTANT]/[!CAUTION]) отображались
	// с правильным CSS-классом: HTMLDocumentField 1С не выполняет JS-зеркало
	// gksiPostprocessAlerts, поэтому единственный надёжный путь — обработка
	// уже после того, как типовая функция вернула готовый HTML.
	Возврат ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ТекстHTML);

КонецФункции

#КонецОбласти
