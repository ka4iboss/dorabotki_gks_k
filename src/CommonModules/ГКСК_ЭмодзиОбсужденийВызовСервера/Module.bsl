#Область ПрограммныйИнтерфейс

// Отправляет сообщение с эмодзи в указанное обсуждение.
//
// Параметры:
//  ИдентификаторОбсуждения - Строка - строковое представление идентификатора обсуждения
//                           (результат Строка(Обсуждение.Идентификатор)).
//  Эмодзи - Строка - символ эмодзи.
//
Процедура ОтправитьЭмодзи(ИдентификаторОбсуждения, Эмодзи) Экспорт

	Если Не ЗначениеЗаполнено(ИдентификаторОбсуждения) Или Не ЗначениеЗаполнено(Эмодзи) Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = Новый ИдентификаторОбсужденияСистемыВзаимодействия(ИдентификаторОбсуждения);
	Сообщение = Обсуждения.ОписаниеСообщения(Эмодзи);
	Обсуждения.ОтправитьСообщение(Пользователи.ТекущийПользователь(), Новый Массив, Сообщение,
		Идентификатор);

КонецПроцедуры

#КонецОбласти
