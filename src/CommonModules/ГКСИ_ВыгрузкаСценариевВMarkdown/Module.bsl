////////////////////////////////////////////////////////////////////////////////
// Выгрузка демонстрационных сценариев (инструкций) в Markdown.
//
// Обратная операция к ГКСИ_ЗагрузкаСценариевИзMarkdown. Источник текста —
// реквизит ГКСИ_ТекстMarkdown справочника ДемонстрационныеСценарии
// (мультиязычный формат с маркерами <!--md:lang:КОД-->).
// Картинки хранятся в справочнике ГКСИ_ФайлыИнструкций, в тексте — ![](КОД).
//
// Результат — массив файлов (структур {ИмяФайла, ДвоичныеДанные, ЭтоКартинка}),
// готовых к сохранению на диск клиента.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает массив корневых оберток инструкций.
//
// Корневая обертка — техническая группа уровня 1: самоссылка в регистре
// ГКСИ_ГруппыСценариев (Сценарий = Группа = КореньИнструкции). Ее имя задает
// имя выгружаемого файла, а прямые дети становятся заголовками "#".
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДемонстрационныеСценарии - упорядочен по коду.
//
Функция ПолучитьКорневыеОберткиИнструкций() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
		|ИЗ
		|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
		|ГДЕ
		|	ГКСИ_ГруппыСценариев.Сценарий = ГКСИ_ГруппыСценариев.Группа
		|	И ГКСИ_ГруппыСценариев.Сценарий = ГКСИ_ГруппыСценариев.КореньИнструкции
		|УПОРЯДОЧИТЬ ПО
		|	КореньИнструкции.Код";

	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.КореньИнструкции);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает корневую обертку инструкции для произвольного узла дерева.
//
// Параметры:
//  Ссылка - СправочникСсылка.ДемонстрационныеСценарии - узел (группа или элемент).
//
// Возвращаемое значение:
//  СправочникСсылка.ДемонстрационныеСценарии - корневая обертка или пустая ссылка.
//
Функция ПолучитьКорневуюОберткуИнструкции(Ссылка) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Справочники.ДемонстрационныеСценарии.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции
		|ИЗ
		|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
		|ГДЕ
		|	ГКСИ_ГруппыСценариев.Сценарий = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	КореньИнструкции.Код";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КореньИнструкции;
	КонецЕсли;

	Возврат Справочники.ДемонстрационныеСценарии.ПустаяСсылка();

КонецФункции

// Готовит файлы для выгрузки указанных инструкций.
//
// Параметры:
//  МассивКорней  - Массив из СправочникСсылка.ДемонстрационныеСценарии - корневые обертки.
//  КодЯзыка      - Строка - код языка, сегмент которого выгружается (например, "ru").
//  АдресПрогресса - Строка - адрес структуры прогресса (см. ГКСИ_ЗагрузкаСценариевИзMarkdown).
//
// Возвращаемое значение:
//  Структура:
//   * Файлы                - Массив из Структура - {ИмяФайла, ДвоичныеДанные, ЭтоКартинка}.
//   * Ошибки               - Массив из Строка.
//   * ОбработаноИнструкций - Число.
//
Функция ПодготовитьФайлыКВыгрузке(МассивКорней, КодЯзыка, АдресПрогресса = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Файлы", Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("ОбработаноИнструкций", 0);

	Если МассивКорней.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	СвязиПоКорням = СвязиГруппПоКорням();

	// Этап 1. Собираем узлы всех инструкций (без обращений к базе).
	МассивИнструкций = Новый Массив;
	ВсеСсылки = Новый Соответствие;
	ВсегоИнструкций = МассивКорней.Количество();
	Обработано = 0;

	Для Каждого Корень Из МассивКорней Цикл

		Обработано = Обработано + 1;
		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса,
			1, Обработано, ВсегоИнструкций,
			СтрШаблон(НСтр("ru = 'Сбор инструкции: %1'"), Строка(Корень)));

		Попытка
			ДанныеКорня = СвязиПоКорням.Получить(Корень);
			Узлы = Новый Массив;
			Если ДанныеКорня = Неопределено Тогда
				Узлы.Добавить(Новый Структура("Ссылка, Уровень", Корень, 1));
			Иначе
				СобратьУзлыРекурсивно(Корень, 1, ДанныеКорня, Новый Соответствие, Узлы);
			КонецЕсли;

			МассивИнструкций.Добавить(Новый Структура("Корень, Узлы", Корень, Узлы));
			Для Каждого Узел Из Узлы Цикл
				ВсеСсылки.Вставить(Узел.Ссылка, Истина);
			КонецЦикла;
		Исключение
			Результат.Ошибки.Добавить(Строка(Корень) + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	// Один запрос текстов и наименований на все узлы всех инструкций.
	МассивВсехСсылок = Новый Массив;
	Для Каждого КлючИЗначение Из ВсеСсылки Цикл
		МассивВсехСсылок.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	ДанныеУзлов = ТекстыИНаименованияПоСсылкам(МассивВсехСсылок);

	// Этап 2. Формируем тексты инструкций и собираем коды картинок.
	МассивТекстов = Новый Массив;
	ВсеКодыКартинок = Новый Соответствие;

	Для Каждого ДанныеИнструкции Из МассивИнструкций Цикл
		ТекстИнструкции = СобратьТекстИнструкции(ДанныеИнструкции, ДанныеУзлов, КодЯзыка);
		МассивТекстов.Добавить(ТекстИнструкции);

		Для Каждого Код Из СобратьКодыКартинокИзТекста(ТекстИнструкции) Цикл
			ВсеКодыКартинок.Вставить(Код, Истина);
		КонецЦикла;
	КонецЦикла;

	КартаКартинок = ПодготовитьКартинки(ВсеКодыКартинок, АдресПрогресса);

	// Разворачиваем ссылки ![](КОД) обратно в ![[имя файла]].
	Для Индекс = 0 По МассивТекстов.ВГраница() Цикл
		МассивТекстов[Индекс] = РазвернутьСсылкиНаКартинки(МассивТекстов[Индекс], КартаКартинок);
	КонецЦикла;

	// Этап 3. Формируем файлы (сначала .md, затем картинки).
	ЗанятыеИмена = Новый Соответствие;
	ВсегоФайлов = МассивИнструкций.Количество() + КартаКартинок.Количество();
	Обработано = 0;

	Для Индекс = 0 По МассивИнструкций.ВГраница() Цикл

		ДанныеИнструкции = МассивИнструкций[Индекс];
		ДанныеКорня = ДанныеУзлов.Получить(ДанныеИнструкции.Корень);
		НаименованиеИнструкции = ?(ДанныеКорня = Неопределено,
			Строка(ДанныеИнструкции.Корень), ДанныеКорня.Наименование);

		ИмяФайла = УникальноеИмяФайла(
			ОчиститьИмяФайла(НаименованиеИнструкции), "md", ЗанятыеИмена);

		Результат.Файлы.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные, ЭтоКартинка",
			ИмяФайла,
			ПолучитьДвоичныеДанныеИзСтроки(МассивТекстов[Индекс], КодировкаТекста.UTF8, Ложь),
			Ложь));

		Обработано = Обработано + 1;
		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса,
			3, Обработано, ВсегоФайлов,
			СтрШаблон(НСтр("ru = 'Формирование файла: %1'"), ИмяФайла));

	КонецЦикла;

	Для Каждого КлючИЗначение Из КартаКартинок Цикл

		ДанныеКартинки = КлючИЗначение.Значение;
		Результат.Файлы.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные, ЭтоКартинка",
			ДанныеКартинки.ИмяФайла, ДанныеКартинки.ДвоичныеДанные, Истина));

		Обработано = Обработано + 1;
		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса,
			3, Обработано, ВсегоФайлов,
			СтрШаблон(НСтр("ru = 'Чтение картинки: %1'"), ДанныеКартинки.ИмяФайла));

	КонецЦикла;

	Результат.ОбработаноИнструкций = МассивИнструкций.Количество();

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строит связи групп по корням инструкций одним запросом.
//
// Узел может входить сразу в несколько инструкций, поэтому связи группируются
// по измерению КореньИнструкции — иначе при обходе был бы выбран случайный
// родитель общего узла.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - корневая обертка -> данные корня:
//   * Ключ     - СправочникСсылка.ДемонстрационныеСценарии - корневая обертка.
//   * Значение - Структура - карты "родитель -> дети" и "узел -> код".
//
Функция СвязиГруппПоКорням()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГКСИ_ГруппыСценариев.КореньИнструкции КАК КореньИнструкции,
		|	ГКСИ_ГруппыСценариев.Группа КАК Группа,
		|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
		|	ГКСИ_ГруппыСценариев.ПолныйКодКонтекстный КАК ПолныйКодКонтекстный
		|ИЗ
		|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
		|ГДЕ
		|	ГКСИ_ГруппыСценариев.Сценарий <> ГКСИ_ГруппыСценариев.Группа
		|УПОРЯДОЧИТЬ ПО
		|	ПолныйКодКонтекстный";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ДанныеКорня = Результат.Получить(Выборка.КореньИнструкции);
		Если ДанныеКорня = Неопределено Тогда
			ДанныеКорня = Новый Структура("ДетиПоРодителю, КодыПоСсылкам",
				Новый Соответствие, Новый Соответствие);
			Результат.Вставить(Выборка.КореньИнструкции, ДанныеКорня);
		КонецЕсли;

		Дети = ДанныеКорня.ДетиПоРодителю.Получить(Выборка.Группа);
		Если Дети = Неопределено Тогда
			Дети = Новый Массив;
			ДанныеКорня.ДетиПоРодителю.Вставить(Выборка.Группа, Дети);
		КонецЕсли;
		Дети.Добавить(Выборка.Сценарий);

		ДанныеКорня.КодыПоСсылкам.Вставить(Выборка.Сценарий, Выборка.ПолныйКодКонтекстный);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собирает узлы поддерева инструкции в порядке обхода (обертки -> дети).
//
// Параметры:
//  Ссылка       - СправочникСсылка.ДемонстрационныеСценарии.
//  Уровень      - Число - уровень узла (корневая обертка = 1).
//  ДанныеКорня  - Структура - данные корня из СвязиГруппПоКорням.
//  Посещенные   - Соответствие из СправочникСсылка.ДемонстрационныеСценарии - защита от циклов.
//  Узлы         - Массив из Структура - пополняемый массив структур {Ссылка, Уровень}.
//
Процедура СобратьУзлыРекурсивно(Ссылка, Уровень, ДанныеКорня, Посещенные, Узлы)

	Если Посещенные.Получить(Ссылка) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Посещенные.Вставить(Ссылка, Истина);

	Узлы.Добавить(Новый Структура("Ссылка, Уровень", Ссылка, Уровень));

	Дети = ДанныеКорня.ДетиПоРодителю.Получить(Ссылка);
	Если Дети = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Ребенок Из СортироватьПоКоду(Дети, ДанныеКорня.КодыПоСсылкам) Цикл
		СобратьУзлыРекурсивно(Ребенок, Уровень + 1, ДанныеКорня, Посещенные, Узлы);
	КонецЦикла;

КонецПроцедуры

// Сортирует ссылки по коду контекста (восстанавливает исходный порядок).
//
// Параметры:
//  МассивСсылок  - Массив из СправочникСсылка.ДемонстрационныеСценарии.
//  КодыПоСсылкам - Соответствие из КлючИЗначение - узел -> код.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДемонстрационныеСценарии.
//
Функция СортироватьПоКоду(МассивСсылок, КодыПоСсылкам)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("Код");

	Для Каждого Ссылка Из МассивСсылок Цикл
		Строка = Таблица.Добавить();
		Строка.Ссылка = Ссылка;
		Строка.Код = КодыПоСсылкам.Получить(Ссылка);
	КонецЦикла;

	Таблица.Сортировать("Код");

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Читает наименования и тексты узлов одним запросом.
//
// Параметры:
//  МассивСсылок - Массив из СправочникСсылка.ДемонстрационныеСценарии.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - узел -> Структура {Наименование, ТекстMarkdown}.
//
Функция ТекстыИНаименованияПоСсылкам(МассивСсылок)

	Результат = Новый Соответствие;
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДемонстрационныеСценарии.Ссылка КАК Ссылка,
		|	ДемонстрационныеСценарии.Наименование КАК Наименование,
		|	ДемонстрационныеСценарии.ГКСИ_ТекстMarkdown КАК ТекстMarkdown
		|ИЗ
		|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
		|ГДЕ
		|	ДемонстрационныеСценарии.Ссылка В (&Ссылки)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка,
			Новый Структура("Наименование, ТекстMarkdown",
				Выборка.Наименование, Выборка.ТекстMarkdown));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует Markdown-текст инструкции из ее узлов.
//
// Параметры:
//  ДанныеИнструкции - Структура - {Корень, Узлы}.
//  ДанныеУзлов      - Соответствие из КлючИЗначение - данные узлов, см. ТекстыИНаименованияПоСсылкам.
//  КодЯзыка         - Строка - код выгружаемого языка.
//
// Возвращаемое значение:
//  Строка.
//
Функция СобратьТекстИнструкции(ДанныеИнструкции, ДанныеУзлов, КодЯзыка)

	Части = Новый Массив;

	Для Каждого Узел Из ДанныеИнструкции.Узлы Цикл

		ДанныеУзла = ДанныеУзлов.Получить(Узел.Ссылка);
		Если ДанныеУзла = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Корневая обертка (уровень 1) задает только имя файла, заголовком
		// не выводится. Ее прямые дети — "#", внуки — "##" и так далее.
		Если Узел.Уровень > 1 Тогда
			Части.Добавить(РешеткиПоУровню(Узел.Уровень) + " " + ДанныеУзла.Наименование);
		КонецЕсли;

		ТекстУзла = ГКСИ_MarkdownФормаКлиентСервер.ПолучитьСегментMarkdown(
			ДанныеУзла.ТекстMarkdown, КодЯзыка);
		Если ЗначениеЗаполнено(ТекстУзла) Тогда
			Части.Добавить(ТекстУзла);
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Возвращает последовательность решеток для заголовка заданного уровня.
//
// Параметры:
//  Уровень - Число - уровень узла (2 -> "#", 3 -> "##").
//
// Возвращаемое значение:
//  Строка.
//
Функция РешеткиПоУровню(Уровень)

	Результат = "";
	Для Счетчик = 1 По Уровень - 1 Цикл
		Результат = Результат + "#";
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает уникальные коды файлов картинок из текста Markdown.
//
// Параметры:
//  Текст - Строка.
//
// Возвращаемое значение:
//  Массив из Строка - коды (GUID) файлов ГКСИ_ФайлыИнструкций.
//
Функция СобратьКодыКартинокИзТекста(Текст)

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
		Текст, "!\[[^\]]*\]\(([^)]+)\)", Истина);

	Уникальные = Новый Соответствие;
	Для Каждого Совпадение Из Совпадения Цикл
		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() = 0
			ИЛИ Группы[0] = Неопределено
			ИЛИ Группы[0].Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Код = Группы[0].Значение;
		Если ЭтоКодФайла(Код) И Уникальные.Получить(Код) = Неопределено Тогда
			Уникальные.Вставить(Код, Истина);
			Результат.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, похоже ли значение на код файла (GUID).
//
// Параметры:
//  Значение - Произвольный.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКодФайла(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрДлина(Значение) = 36
		И СтрПодобнаПоРегулярномуВыражению(Значение,
			"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$");

КонецФункции

// Читает бинарные данные картинок и присваивает им уникальные имена файлов.
//
// Параметры:
//  ВсеКодыКартинок - Соответствие из КлючИЗначение - множество кодов.
//  АдресПрогресса  - Строка - адрес структуры прогресса.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - код -> Структура {ИмяФайла, ДвоичныеДанные}.
//
Функция ПодготовитьКартинки(ВсеКодыКартинок, АдресПрогресса)

	Карта = Новый Соответствие;
	Если ВсеКодыКартинок.Количество() = 0 Тогда
		Возврат Карта;
	КонецЕсли;

	МассивКодов = Новый Массив;
	Для Каждого КлючИЗначение Из ВсеКодыКартинок Цикл
		МассивКодов.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", МассивКодов);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГКСИ_ФайлыИнструкций.Код КАК Код,
		|	ГКСИ_ФайлыИнструкций.Наименование КАК Наименование,
		|	ГКСИ_ФайлыИнструкций.Расширение КАК Расширение,
		|	ГКСИ_ФайлыИнструкций.Файл КАК Файл
		|ИЗ
		|	Справочник.ГКСИ_ФайлыИнструкций КАК ГКСИ_ФайлыИнструкций
		|ГДЕ
		|	ГКСИ_ФайлыИнструкций.Код В (&Коды)";

	ЗанятыеИмена = Новый Соответствие;
	Обработано = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Обработано = Обработано + 1;
		ДвоичныеДанные = Выборка.Файл.Получить();
		Если ДвоичныеДанные = Неопределено Тогда
			ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса,
				2, Обработано, МассивКодов.Количество(),
				СтрШаблон(НСтр("ru = 'Картинка без данных: %1'"), Выборка.Код));
			Продолжить;
		КонецЕсли;

		РасширениеКартинки = Выборка.Расширение;
		ИмяФайла = УникальноеИмяФайла(
			ОчиститьИмяФайла(Выборка.Наименование), РасширениеКартинки, ЗанятыеИмена);

		Карта.Вставить(Выборка.Код, Новый Структура("ИмяФайла, ДвоичныеДанные",
			ИмяФайла, ДвоичныеДанные));

		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса,
			2, Обработано, МассивКодов.Количество(),
			СтрШаблон(НСтр("ru = 'Чтение картинки: %1'"), ИмяФайла));

	КонецЦикла;

	Возврат Карта;

КонецФункции

// Заменяет в тексте ссылки ![](КОД) на ![[имя файла]] по карте картинок.
//
// Параметры:
//  Текст         - Строка.
//  КартаКартинок - Соответствие из КлючИЗначение - код -> Структура {ИмяФайла, ДвоичныеДанные}.
//
// Возвращаемое значение:
//  Строка - текст с развернутыми ссылками.
//
Функция РазвернутьСсылкиНаКартинки(Текст, КартаКартинок)

	Если НЕ ЗначениеЗаполнено(Текст) ИЛИ КартаКартинок.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
		Текст, "!\[[^\]]*\]\(([^)]+)\)", Истина);

	Замены = Новый Массив;
	Для Каждого Совпадение Из Совпадения Цикл

		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() = 0
			ИЛИ Группы[0] = Неопределено
			ИЛИ Группы[0].Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДанныеКартинки = КартаКартинок.Получить(Группы[0].Значение);
		Если ДанныеКартинки = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Замены.Добавить(Новый Структура("Позиция, Длина, Текст",
			Совпадение.НачальнаяПозиция,
			Совпадение.Длина,
			"![[" + ДанныеКартинки.ИмяФайла + "]]"));

	КонецЦикла;

	// Применяем с конца, чтобы не сбивать позиции остальных замен.
	Результат = Текст;
	Для Счетчик = 0 По Замены.ВГраница() Цикл
		Замена = Замены[Замены.ВГраница() - Счетчик];
		Результат = Лев(Результат, Замена.Позиция - 1)
			+ Замена.Текст
			+ Сред(Результат, Замена.Позиция + Замена.Длина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает уникальное имя файла и помечает его как занятое.
//
// Параметры:
//  ЖелаемоеИмя     - Строка - имя без расширения.
//  РасширениеФайла - Строка - расширение без точки.
//  ЗанятыеИмена    - Соответствие из КлючИЗначение - множество уже занятых имен (в нижнем регистре).
//
// Возвращаемое значение:
//  Строка - имя файла с расширением.
//
Функция УникальноеИмяФайла(ЖелаемоеИмя, РасширениеФайла, ЗанятыеИмена)

	БазовоеИмя = СокрЛП(ЖелаемоеИмя);
	Если НЕ ЗначениеЗаполнено(БазовоеИмя) Тогда
		БазовоеИмя = НСтр("ru = 'file'");
	КонецЕсли;

	Суффикс = ?(ЗначениеЗаполнено(РасширениеФайла), "." + СокрЛП(РасширениеФайла), "");

	ИмяФайла = БазовоеИмя + Суффикс;
	Счетчик = 1;
	Пока ЗанятыеИмена.Получить(НРег(ИмяФайла)) <> Неопределено Цикл
		ИмяФайла = БазовоеИмя + " (" + Формат(Счетчик, "ЧН=0; ЧГ=0") + ")" + Суффикс;
		Счетчик = Счетчик + 1;
	КонецЦикла;

	ЗанятыеИмена.Вставить(НРег(ИмяФайла), Истина);

	Возврат ИмяФайла;

КонецФункции

// Удаляет из имени файла символы, недопустимые в файловых системах.
//
// Параметры:
//  Наименование - Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОчиститьИмяФайла(Наименование)

	Результат = СокрЛП(Наименование);

	ЗапрещенныеСимволы = Новый Массив;
	ЗапрещенныеСимволы.Добавить("\");
	ЗапрещенныеСимволы.Добавить("/");
	ЗапрещенныеСимволы.Добавить(":");
	ЗапрещенныеСимволы.Добавить("*");
	ЗапрещенныеСимволы.Добавить("?");
	ЗапрещенныеСимволы.Добавить("""");
	ЗапрещенныеСимволы.Добавить("<");
	ЗапрещенныеСимволы.Добавить(">");
	ЗапрещенныеСимволы.Добавить("|");

	Для Каждого Символ Из ЗапрещенныеСимволы Цикл
		Результат = СтрЗаменить(Результат, Символ, "_");
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
