#Область ПрограммныйИнтерфейс

// Возвращает версию подсистемы редактора Markdown.
//
// Возвращаемое значение:
//   Строка - версия подсистемы
Функция ВерсияПодсистемы() Экспорт
	Возврат "1.0.2.0";
КонецФункции

// Возвращает префикс имен элементов формы, добавляемых подсистемой редактора Markdown.
//
// Возвращаемое значение:
//   Строка - префикс имен элементов формы
Функция ПрефиксЭлементовФормы() Экспорт
	Возврат "РМ_";
КонецФункции

// Заменяет точки в пути к данным на подчеркивания.
//
// Параметры:
//   ПутьКДанным - Строка - путь к данным
//
// Возвращаемое значение:
//   Строка - путь к данным без точек
Функция ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным) Экспорт
	Возврат СтрЗаменить(ПутьКДанным,".","_");
КонецФункции

// Заменяет подчеркивания в пути к данным на точки.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//
// Возвращаемое значение:
//   Строка - путь к данным
Функция ПолучитьПутьКДаннымИЗПутиБезЛишнего(ПутьКДаннымБезЛишнего) Экспорт
	Возврат СтрЗаменить(ПутьКДаннымБезЛишнего,"_",".");
КонецФункции

// Возвращает имя элемента панели страниц редактирования комментария.
//
// Параметры:
//   ПутьКДанным - Строка - путь к данным
//
// Возвращаемое значение:
//   Строка - имя элемента панели страниц
Функция ПолучитьИмяЭлементаПанелиСтраницРедактированияКомментария(ПутьКДанным) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Страницы_"+ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным);
КонецФункции

// Возвращает имя страницы редактирования комментария.
//
// Параметры:
//   ПутьКДанным - Строка - путь к данным
//
// Возвращаемое значение:
//   Строка - имя страницы редактирования
Функция ПолучитьИмяСтраницыРедактированияКомментария(ПутьКДанным) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Страница_Редактирование_"+ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным);
КонецФункции

// Возвращает имя страницы просмотра комментария.
//
// Параметры:
//   ПутьКДанным - Строка - путь к данным
//
// Возвращаемое значение:
//   Строка - имя страницы просмотра
Функция ПолучитьИмяСтраницыПросмотраКомментария(ПутьКДанным) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Страница_Просмотр_"+ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным);
КонецФункции

// Возвращает имя элемента редактирования комментария.
//
// Параметры:
//   ПутьКДанным - Строка - путь к данным
//
// Возвращаемое значение:
//   Строка - имя элемента редактирования
Функция ПолучитьИмяЭлементаРедактированияКомментария(ПутьКДанным) Экспорт
	Возврат ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным);
КонецФункции

// Возвращает имя элемента просмотра комментария.
//
// Параметры:
//   ПутьКДанным - Строка - путь к данным
//
// Возвращаемое значение:
//   Строка - имя элемента просмотра
Функция ПолучитьИмяЭлементаПросмотраКомментария(ПутьКДанным) Экспорт
	Возврат ПрефиксЭлементовФормы()+"ПолеПросмотра_"+ПолучитьПутьКДаннымБезЛишнего(ПутьКДанным);
КонецФункции

// Восстанавливает путь к данным из имени панели страниц.
//
// Параметры:
//   ИмяПанели - Строка - имя панели страниц
//
// Возвращаемое значение:
//   Строка - путь к данным
Функция ПолучитьПутьКДаннымПоИмениПанелиСтраниц(ИмяПанели) Экспорт
	ПутьКДаннымБезЛишнего=СтрЗаменить(ИмяПанели,"РМ_Страницы_","");
	Возврат ПолучитьПутьКДаннымИЗПутиБезЛишнего(ПутьКДаннымБезЛишнего);
КонецФункции

// Восстанавливает путь к данным из имени поля просмотра.
//
// Параметры:
//   ИмяПанели - Строка - имя поля просмотра
//
// Возвращаемое значение:
//   Строка - путь к данным
Функция ПолучитьПутьКДаннымПоИмениПоляПросмотра(ИмяПанели) Экспорт
	СтрокаЗамены=ПрефиксЭлементовФормы()+"ПолеПросмотра_";
	ПутьКДаннымБезЛишнего=СтрЗаменить(ИмяПанели,СтрокаЗамены,"");
	Возврат ПолучитьПутьКДаннымИЗПутиБезЛишнего(ПутьКДаннымБезЛишнего);
КонецФункции

// Возвращает имя таблицы присоединенных файлов.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//
// Возвращаемое значение:
//   Строка - имя таблицы присоединенных файлов
Функция ИмяТаблицыПрисоединенныхФайлов(ПутьКДаннымБезЛишнего) Экспорт
	Возврат ПрефиксЭлементовФормы()+"ТаблицаПрисоединенныхФайлов_"+ПутьКДаннымБезЛишнего;
КонецФункции

// Возвращает имя группы новых присоединенных файлов.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//
// Возвращаемое значение:
//   Строка - имя группы новых присоединенных файлов
Функция ИмяГруппыНовыхПрисоединенныхФайлов(ПутьКДаннымБезЛишнего) Экспорт
	Возврат ПрефиксЭлементовФормы()+"НовыеПрисоединенныеФайлы_"+ПутьКДаннымБезЛишнего;
КонецФункции

// Возвращает имя элемента надписи нового присоединенного файла.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя элемента надписи
Функция ИмяЭлементаНадписиНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат ПрефиксЭлементовФормы()+ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки);
КонецФункции

// Возвращает имя элемента надписи нового присоединенного файла без префикса.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя элемента надписи без префикса
Функция ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат "ПрисоединенныйФайл_" + Формат(ИдентификаторСтроки,"ЧН=0; ЧГ=0;")+"_"+ПутьКДаннымБезЛишнего;
КонецФункции

// Возвращает имя группы нового присоединенного файла.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя группы нового файла
Функция ИмяГруппыНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Группа_"+ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки);
КонецФункции

// Возвращает имя группы команд нового присоединенного файла.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя группы команд
Функция ИмяГруппыКомандНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат ПрефиксЭлементовФормы()+"ГруппаКоманд_"+ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки);
КонецФункции

// Возвращает имя команды удаления нового присоединенного файла.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя команды удаления
Функция ИмяКомандыУдалитьНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Удалить"+ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки);
КонецФункции

// Возвращает имя команды открытия нового присоединенного файла.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя команды открытия
Функция ИмяКомандыОткрытьНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Открыть"+ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки);
КонецФункции

// Возвращает имя команды вставки нового присоединенного файла.
//
// Параметры:
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//   ИдентификаторСтроки - Число - идентификатор строки
//
// Возвращаемое значение:
//   Строка - имя команды вставки
Функция ИмяКомандыВставитьНовогоПрисоединеногоФайла(ПутьКДаннымБезЛишнего, ИдентификаторСтроки) Экспорт
	Возврат ПрефиксЭлементовФормы()+"Вставить"+ИмяЭлементаНадписиНовогоПрисоединеногоФайлаБезПрефикса(ПутьКДаннымБезЛишнего, ИдентификаторСтроки);
КонецФункции

// Заменяет имя присоединенного файла в тексте на его адрес.
//
// Параметры:
//   Текст - Строка - исходный текст
//   ИмяФайла - Строка - имя файла для поиска
//   Адрес - Строка - адрес для замены
//
// Возвращаемое значение:
//   Строка - текст с заменой
Функция СконвертироватьИмяПрисоединенногоФайлаВТексте(Текст, ИмяФайла, Адрес) Экспорт
    СтрокаПоиска = СтрШаблон("![](%1)", ИмяФайла);
    СтрокаЗамены = СтрШаблон("![](%1)", Адрес);

    Возврат СтрЗаменить(Текст, СтрокаПоиска, СтрокаЗамены);
КонецФункции

// Заменяет имена присоединенных файлов в тексте на их адреса.
//
// Параметры:
//   ДанныеПрисоединенныхФайлов - Массив из Структура - данные файлов с полями ИмяФайла и Адрес
//   Текст - Строка - исходный текст
//
// Возвращаемое значение:
//   Строка - текст с заменами
Функция СконвертироватьИменаПрисоединенныхФайловВТексте(ДанныеПрисоединенныхФайлов, Текст) Экспорт
    Для Каждого ДанныеФайла Из ДанныеПрисоединенныхФайлов Цикл
        Текст = СконвертироватьИмяПрисоединенногоФайлаВТексте(Текст, ДанныеФайла.ИмяФайла, ДанныеФайла.Адрес);
    КонецЦикла;

    Возврат Текст;
КонецФункции

// Раскладывает полное имя файла на составляющие.
//
// Параметры:
//  ПолноеИмяФайла - Строка - полный путь к файлу.
//  ЭтоПапка - Булево - признак того, что требуется разложить полное имя папки, а не файла.
//
// Возвращаемое значение:
//   Структура - имя файла, разложенное на составные части (аналогично свойствам объекта Файл):
//   * ПолноеИмя - Строка - полный путь к файлу
//   * Путь - Строка - путь к каталогу
//   * Имя - Строка - имя файла с расширением
//   * Расширение - Строка - расширение файла
//   * ИмяБезРасширения - Строка - имя файла без расширения
//
Функция РазложитьПолноеИмяФайла(Знач ПолноеИмяФайла, ЭтоПапка = Ложь) Экспорт

	СтруктураИмениФайла = Новый Структура;
	СтруктураИмениФайла.Вставить("ПолноеИмя", "");
	СтруктураИмениФайла.Вставить("Путь", "");
	СтруктураИмениФайла.Вставить("Имя", "");
	СтруктураИмениФайла.Вставить("Расширение", "");
	СтруктураИмениФайла.Вставить("ИмяБезРасширения", "");

	Если ЭтоПапка Тогда
		Если Прав(ПолноеИмяФайла, 1) = "/" Или Прав(ПолноеИмяФайла, 1) = "\" Тогда
			ПолноеИмяФайла = Сред(ПолноеИмяФайла, 1, СтрДлина(ПолноеИмяФайла) - 1);
		КонецЕсли;
	Иначе
		// Если путь к файлу заканчивается слешем, то у файла нет имени.
		Если Прав(ПолноеИмяФайла, 1) = "/" Или Прав(ПолноеИмяФайла, 1) = "\" Тогда
			//@skip-warning SU24 EDT не отслеживает ключи, добавленные через Вставить, поэтому
			//не видит декларацию свойств структуры, заполняемой динамически.
			Возврат СтруктураИмениФайла;
		КонецЕсли;
	КонецЕсли;
	СтруктураИмениФайла.ПолноеИмя = ПолноеИмяФайла;

	// Если полное имя файла оказалось пустым, то остальные параметры структуры возвращаем пустыми.
	Если СтрДлина(ПолноеИмяФайла) = 0 Тогда
		//@skip-warning SU24 EDT не отслеживает ключи, добавленные через Вставить, поэтому
		//не видит декларацию свойств структуры, заполняемой динамически.
		Возврат СтруктураИмениФайла;
	КонецЕсли;

	// Выделяем путь к файлу и имя файла.
	Если СтрНайти(ПолноеИмяФайла, "/") > 0 Тогда
		ПозицияРазделителя = СтрНайти(ПолноеИмяФайла, "/", НаправлениеПоиска.СКонца);
	ИначеЕсли СтрНайти(ПолноеИмяФайла, "\") > 0 Тогда
		ПозицияРазделителя = СтрНайти(ПолноеИмяФайла, "\", НаправлениеПоиска.СКонца);
	Иначе
		ПозицияРазделителя = 0;
	КонецЕсли;
	СтруктураИмениФайла.Путь = Лев(ПолноеИмяФайла, ПозицияРазделителя);
	СтруктураИмениФайла.Имя = Сред(ПолноеИмяФайла, ПозицияРазделителя + 1);

	// Папки не имеют расширений, а для файла выделяем расширение.
	Если ЭтоПапка Тогда
		СтруктураИмениФайла.ИмяБезРасширения = СтруктураИмениФайла.Имя;
	Иначе
		ПозицияТочки = СтрНайти(СтруктураИмениФайла.Имя, ".", НаправлениеПоиска.СКонца);
		Если ПозицияТочки = 0 Тогда
			СтруктураИмениФайла.ИмяБезРасширения = СтруктураИмениФайла.Имя;
		Иначе
			СтруктураИмениФайла.Расширение = Сред(СтруктураИмениФайла.Имя, ПозицияТочки);
			СтруктураИмениФайла.ИмяБезРасширения = Лев(СтруктураИмениФайла.Имя, ПозицияТочки - 1);
		КонецЕсли;
	КонецЕсли;

	//@skip-warning SU24 EDT не отслеживает ключи, добавленные через Вставить, поэтому
	//не видит декларацию свойств структуры, заполняемой динамически.
	Возврат СтруктураИмениФайла;

КонецФункции

// Собирает данные присоединенных файлов из таблицы формы в массив структур.
//
// Параметры:
//   Форма - Произвольный - форма, содержащая таблицу присоединенных файлов
//   ПутьКДаннымБезЛишнего - Строка - путь к данным без точек
//
// Возвращаемое значение:
//   Массив из Структура - данные файлов:
//     * ИмяФайла - Строка - имя файла
//     * Адрес - Строка - адрес файла
//     * Ссылка - Произвольный - ссылка на файл
//     * ПутьКФайлу - Строка - путь к файлу
//     * ЭтоНовый - Булево - признак нового файла
Функция ДанныеПрисоединенныхФайлов(Форма,ПутьКДаннымБезЛишнего) Экспорт
	ИмяТаблицыПрисоединенныхФайлов=ИмяТаблицыПрисоединенныхФайлов(ПутьКДаннымБезЛишнего);

	ДанныеПрисоединенныхФайлов = Новый Массив;
	Для Каждого СтрокаФайла Из Форма[ИмяТаблицыПрисоединенныхФайлов] Цикл
		ДанныеФайла = Новый Структура;
		ДанныеФайла.Вставить("ИмяФайла", СтрокаФайла.ИмяФайла);
		ДанныеФайла.Вставить("Адрес", СтрокаФайла.Адрес);
		ДанныеФайла.Вставить("Ссылка", СтрокаФайла.Ссылка);
		ДанныеФайла.Вставить("ПутьКФайлу", СтрокаФайла.ПутьКФайлу);
		ДанныеФайла.Вставить("ЭтоНовый", СтрокаФайла.ЭтоНовый);
		ДанныеПрисоединенныхФайлов.Добавить(ДанныеФайла);
	КонецЦикла;

	Возврат ДанныеПрисоединенныхФайлов;

КонецФункции

#КонецОбласти
