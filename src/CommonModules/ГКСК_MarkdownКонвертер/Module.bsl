////////////////////////////////////////////////////////////////////////////////
// Единый конвертер Markdown -> HTML подсистемы ГКСИ.
//
// Назначение: одна точка преобразования Markdown в HTML для всех сценариев
// подсистемы, чтобы результат не зависел от способа ввода текста:
//   - запись элемента и группы справочника ДемонстрационныеСценарии;
//   - загрузка сценариев из .md (ГКСИ_ЗагрузкаСценариевИзMarkdown);
//   - показ текста в задаче согласования (ГКСИ_СогласованиеИнструкцийСервер).
//
// Конвейер Markdown -> HTML:
//   1. разметка видео !video(<путь>) в HTML5-плеер;
//   2. подстановка вики-ссылок [[Имя]] по карте ссылок сценариев;
//   3. разбор Markdown: блоки кода, заголовки, горизонтальные линии, таблицы,
//      цитаты и GitHub Alerts, списки (в том числе с чекбоксами), абзацы,
//      инлайн-разметка (картинки, ссылки, жирный, зачёркнутый, курсив, код);
//   4. замена кодов картинок на data:URI;
//   5. постобработка GitHub Alerts (классы и inline-стили markdown-alert-*);
//   6. при необходимости - обёртка <html><body>.
//
// Обратное направление (HTML -> Markdown) выполняется showdown.js в поле
// HTML-документа; единственная точка входа - ГКСИ_MarkdownКлиент
// .ТекстMarkdownПоТекстуHTML (используется миграцией HTML->Markdown в формах
// элемента и группы через ГКСИ_MarkdownФормаКлиент.ВыполнитьМиграциюHTMLВMarkdown).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Преобразует Markdown в HTML по единому конвейеру подсистемы ГКСИ.
//
// Параметры:
//  ТекстMarkdown    - Строка - исходный текст Markdown.
//  РазбиратьСсылки  - Булево - Истина, если вики-ссылки [[Имя]] на группы и шаги
//                     сценариев нужно разобрать в готовые <a>.
//  ДобавлятьТегиТела - Булево - Истина, если результат нужно обернуть в
//                     <html><body> (сохраняемый HTML-файл описания сценария).
//  КартаСсылок      - Соответствие из КлючИЗначение, Неопределено - заранее построенная карта
//                     вики-ссылок (ГКСИ_СсылкиСценариев.КартаСсылокСценариев).
//                     Неопределено - карта строится внутри (один запрос).
//
// Возвращаемое значение:
//  Строка - HTML-представление текста.
//
Функция ТекстHTMLПоМаркдауну(ТекстMarkdown, РазбиратьСсылки = Ложь, ДобавлятьТегиТела = Ложь,
	КартаСсылок = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстMarkdown) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ТекстMarkdown;

	Если РазбиратьСсылки Тогда
		Если КартаСсылок = Неопределено Тогда
			КартаСсылок = ГКСИ_СсылкиСценариев.КартаСсылокСценариев();
		КонецЕсли;
		// Подстановка идемпотентна: если ссылки уже заменены, конструкций [[…]]
		// в тексте не остаётся и повторный вызов ничего не меняет.
		Текст = ГКСИ_СсылкиСценариев.ПодставитьСсылкиВТекст(Текст, КартаСсылок, "Навигация");
	КонецЕсли;

	ТекстHTML = ФрагментHTMLПоМаркдауну(Текст);

	// GitHub Alerts: [!NOTE]/[!TIP]/[!IMPORTANT]/[!WARNING]/[!CAUTION] ->
	// <div class="markdown-alert markdown-alert-{type}"> с inline-стилями.
	// Основной разбор делает ФрагментHTMLПоМаркдауну (СобратьАлерт); этот вызов —
	// страховка для HTML, пришедшего НЕ из конвертера (старые сохранённые файлы,
	// вывод showdown.js). Функция идемпотентна: готовый блок повторно не меняется.
	ТекстHTML = ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ТекстHTML);

	Если ДобавлятьТегиТела Тогда
		ДемонстрационныеСценарииКлиентСервер.ДобавитьТегиТелаЕслиНеобходимо(ТекстHTML);
	КонецЕсли;

	Возврат ТекстHTML;

КонецФункции

// Преобразует Markdown в HTML-фрагмент без обёртки <html><body>.
//
// Используется там, где HTML вставляется в готовый документ (показ текста
// в форме, сборка альбома, импорт из .md).
//
// Параметры:
//  ТекстMarkdown - Строка - исходный текст Markdown.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция ФрагментHTMLПоМаркдауну(ТекстMarkdown) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстMarkdown) Тогда
		Возврат "";
	КонецЕсли;

	// Видео размечается до разбора абзацев, чтобы готовый блок плеера не попал
	// внутрь <p> (разметка плеера многострочная, разбор её не трогает).
	Текст = ГКСИ_Видео.РазметкуВидеоВHTML(ТекстMarkdown);
	Текст = СтрЗаменить(Текст, Символы.ВК, "");

	// Пустые строки обязательны: на них завершаются абзацы, тела алертов и
	// сохраняются пустые строки внутри блоков кода. Третий параметр СтрРазделить
	// (<ВключатьПустые>) по умолчанию Истина, поэтому передаём его явно.
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);

	Фрагменты = Новый Массив;
	БуферАбзаца = Новый Массив;
	ГлубинаHTML = 0;

	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл

		Строка = Строки[Индекс];

		// Продолжение ранее начатого HTML-блока (например, плеера видео):
		// строки выводятся как есть, пока не закроются все открытые контейнеры.
		Если ГлубинаHTML > 0 Тогда
			Фрагменты.Добавить(Строка);
			ГлубинаHTML = ГлубинаHTML + БалансHTMLКонтейнеров(Строка);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(Строка) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ЭтоНачалоБлокаКода(Строка) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = СобратьБлокКода(Строки, Индекс, Фрагменты);
			Продолжить;
		КонецЕсли;

		Если ЭтоНачалоГотовогоБлока(Строка) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Фрагменты.Добавить(Строка);
			ГлубинаHTML = БалансHTMLКонтейнеров(Строка);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Уровень = УровеньЗаголовка(Строка);
		Если Уровень > 0 Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Фрагменты.Добавить("<h" + Уровень + ">"
				+ ВстроеннаяРазметка(ТекстЗаголовка(Строка, Уровень))
				+ "</h" + Уровень + ">");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ЭтоГоризонтальнаяЛиния(Строка) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Фрагменты.Добавить("<hr>");
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Если ЭтоТаблица(Строки, Индекс) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = СобратьТаблицу(Строки, Индекс, Фрагменты);
			Продолжить;
		КонецЕсли;

		// GitHub Alerts разбираются здесь же, до общей обработки цитат и абзацев:
		// готовый блок markdown-alert не зависит от постобработки HTML.
		Если ЭтоНачалоАлерта(Строка, Истина) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = СобратьАлерт(Строки, Индекс, Фрагменты, Истина);
			Продолжить;
		КонецЕсли;

		Если ЭтоЦитата(Строка) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = СобратьЦитату(Строки, Индекс, Фрагменты);
			Продолжить;
		КонецЕсли;

		Если ЭтоЭлементСписка(Строка) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = СобратьСписок(Строки, Индекс, Фрагменты);
			Продолжить;
		КонецЕсли;

		Если ЭтоНачалоАлерта(Строка, Ложь) Тогда
			ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);
			Индекс = СобратьАлерт(Строки, Индекс, Фрагменты, Ложь);
			Продолжить;
		КонецЕсли;

		БуферАбзаца.Добавить(ВстроеннаяРазметка(Строка));
		Индекс = Индекс + 1;

	КонецЦикла;

	ВывестиБуферАбзаца(Фрагменты, БуферАбзаца);

	ТекстHTML = СтрСоединить(Фрагменты, Символы.ПС);

	// Картинки в Markdown ссылаются на код файла справочника ГКСИ_ФайлыИнструкций;
	// в готовом HTML подставляется data:URI (один пакетный запрос, без цикла по БД).
	ТекстHTML = ГКСИ_MarkdownПереопределяемый.ЗаменитьКодыИзображенийНаDataURI(ТекстHTML);

	Возврат ТекстHTML;

КонецФункции

// Преобразует инлайн-разметку Markdown в HTML без обёртки в блоки.
//
// Нужна там, где текст выводится внутри готовой HTML-конструкции: заголовок
// группы и наименование шага в альбоме процессов. Символы «<», «>», «&»
// в обычном тексте экранируются, готовые теги и угловые автоссылки сохраняются.
//
// Параметры:
//  Текст - Строка - текст с инлайн-разметкой Markdown.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент строки.
//
Функция HTMLСтрокиПоМаркдауну(Текст) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ВстроеннаяРазметка(Текст);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит накопленные строки абзаца как один параграф.
//
// Параметры:
//  Фрагменты    - Массив из Строка - уже собранные фрагменты HTML.
//  БуферАбзаца  - Массив из Строка - строки текущего абзаца.
//
Процедура ВывестиБуферАбзаца(Фрагменты, БуферАбзаца)

	Если БуферАбзаца.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Фрагменты.Добавить("<p>" + СтрСоединить(БуферАбзаца, "<br>") + "</p>");
	БуферАбзаца.Очистить();

КонецПроцедуры

// Возвращает уровень заголовка Markdown в строке (1..6) либо 0.
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Число - уровень заголовка.
//
Функция УровеньЗаголовка(Строка)

	Текст = СокрЛ(СтрЗаменить(Строка, Символы.Таб, "    "));

	Уровень = 0;
	Пока Уровень < 6 И Сред(Текст, Уровень + 1, 1) = "#" Цикл
		Уровень = Уровень + 1;
	КонецЦикла;

	Если Уровень = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если Сред(Текст, Уровень + 1, 1) <> " " Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Уровень;

КонецФункции

// Возвращает текст заголовка без ведущих решёток.
//
// Параметры:
//  Строка  - Строка - строка исходного текста.
//  Уровень - Число - уровень заголовка.
//
// Возвращаемое значение:
//  Строка - текст заголовка.
//
Функция ТекстЗаголовка(Строка, Уровень)

	Текст = СокрЛ(СтрЗаменить(Строка, Символы.Таб, "    "));
	Возврат СокрЛП(Сред(Текст, Уровень + 2));

КонецФункции

// Проверяет, является ли строка горизонтальной линией (---, ***, ___).
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Булево - Истина, если строка является горизонтальной линией.
//
Функция ЭтоГоризонтальнаяЛиния(Строка)

	Текст = СокрЛП(Строка);
	Если СтрДлина(Текст) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Проверка = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), "*", ""), "_", "");
	Возврат ПустаяСтрока(Проверка);

КонецФункции

// Проверяет, начинается ли строка блоком кода (```).
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Булево - Истина, если строка открывает или закрывает блок кода.
//
Функция ЭтоНачалоБлокаКода(Строка)

	Возврат СтрНачинаетсяС(СокрЛП(Строка), "```");

КонецФункции

// Проверяет, является ли строка готовым HTML-блоком (например, плеером видео).
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Булево - Истина, если строка начинается с тега и заканчивается тегом.
//
Функция ЭтоНачалоГотовогоБлока(Строка)

	Текст = СокрЛП(Строка);
	Если НЕ (СтрНачинаетсяС(Текст, "<") И СтрЗаканчиваетсяНа(Текст, ">")) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Угловые автоссылки Markdown (<https://its.1c.ru>, <mail@host.ru>) тоже
	// начинаются с "<" и заканчиваются ">", но HTML-блоком не являются: их
	// должна превратить в <a> встроенная разметка. Иначе строка попадала
	// в результат как есть и браузер молча выбрасывал её как неизвестный тег.
	// Признак автоссылки — нет пробелов внутри и есть "://" или "@".
	Внутри = Сред(Текст, 2, СтрДлина(Текст) - 2);
	Если СтрНайти(Внутри, " ") = 0
			И (СтрНайти(Внутри, "://") > 0 ИЛИ СтрНайти(Внутри, "@") > 0) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Считает баланс открытых и закрытых HTML-контейнеров в строке.
//
// Нужен, чтобы многострочные HTML-блоки (плеер видео, вставленный пользователем
// HTML) не разбирались построчно как Markdown.
//
// Параметры:
//  Строка - Строка - строка HTML.
//
// Возвращаемое значение:
//  Число - количество незакрытых контейнеров (может быть отрицательным).
//
Функция БалансHTMLКонтейнеров(Строка)

	Теги = Новый Массив;
	Теги.Добавить("div");
	Теги.Добавить("table");
	Теги.Добавить("pre");
	Теги.Добавить("blockquote");
	Теги.Добавить("ul");
	Теги.Добавить("ol");
	Теги.Добавить("video");

	ТекстВРег = НРег(Строка);
	Баланс = 0;
	Для Каждого Тег Из Теги Цикл
		Баланс = Баланс + СтрЧислоВхождений(ТекстВРег, "<" + Тег)
			- СтрЧислоВхождений(ТекстВРег, "</" + Тег);
	КонецЦикла;

	Возврат Баланс;

КонецФункции

// Собирает блок кода в <pre><code>.
//
// Параметры:
//  Строки     - Массив из Строка - строки исходного текста.
//  Индекс     - Число - индекс строки с открывающими ```.
//  Фрагменты  - Массив из Строка - уже собранные фрагменты HTML.
//
// Возвращаемое значение:
//  Число - индекс строки, следующей за блоком кода.
//
Функция СобратьБлокКода(Строки, Индекс, Фрагменты)

	Открывающая = СокрЛП(Строки[Индекс]);
	Язык = СокрЛП(Сред(Открывающая, 4));

	Содержимое = Новый Массив;
	Индекс = Индекс + 1;

	Пока Индекс < Строки.Количество() Цикл
		Если ЭтоНачалоБлокаКода(Строки[Индекс]) Тогда
			Индекс = Индекс + 1;
			Прервать;
		КонецЕсли;
		Содержимое.Добавить(Строки[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;

	Класс = "";
	Если ЗначениеЗаполнено(Язык) Тогда
		Класс = " class=""language-" + Язык + """";
	КонецЕсли;

	// Оформление блока кода — inline-стилями, как у алертов: поле HTML-документа 1С
	// не применяет внешние стили к загруженному документу, поэтому рамка, фон и
	// моноширинный шрифт должны ехать вместе с тегом.
	СтильБлока = "margin:8px 0;padding:8px;background-color:#fafafa;border:1px solid #e2e2e2;"
		+ "border-radius:3px;overflow-x:auto;white-space:pre-wrap;"
		+ "font-family:Consolas,'Courier New',monospace;font-size:9pt;";
	СтильКода = "font-family:Consolas,'Courier New',monospace;font-size:9pt;";

	Фрагменты.Добавить("<pre style=""" + СтильБлока + """><code" + Класс
		+ " style=""" + СтильКода + """>"
		+ ЭкранироватьHTML(СтрСоединить(Содержимое, Символы.ПС))
		+ "</code></pre>");

	Возврат Индекс;

КонецФункции

// Проверяет, является ли строка цитатой (GitHub Alerts оформляются так же).
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Булево - Истина, если строка начинается с ">".
//
Функция ЭтоЦитата(Строка)

	Возврат СтрНачинаетсяС(СокрЛ(СтрЗаменить(Строка, Символы.Таб, "    ")), ">");

КонецФункции

// Собирает цитату в <blockquote>.
//
// Строки цитаты объединяются через <br> в один параграф (так же поступает
// showdown.js). Это важно для GitHub Alerts: постобработка ищет блок
// <p>[!TYPE…</p> и переносит его содержимое в <div class="markdown-alert">.
//
// Параметры:
//  Строки     - Массив из Строка - строки исходного текста.
//  Индекс     - Число - индекс первой строки цитаты.
//  Фрагменты  - Массив из Строка - уже собранные фрагменты HTML.
//
// Возвращаемое значение:
//  Число - индекс строки, следующей за цитатой.
//
Функция СобратьЦитату(Строки, Индекс, Фрагменты)

	СтрокиЦитаты = Новый Массив;

	Пока Индекс < Строки.Количество() Цикл
		Если НЕ ЭтоЦитата(Строки[Индекс]) Тогда
			Прервать;
		КонецЕсли;
		СтрокиЦитаты.Добавить(СодержимоеЦитаты(Строки[Индекс]));
		Индекс = Индекс + 1;
	КонецЦикла;

	// Если внутри цитаты есть блочные конструкции (вложенная цитата, список,
	// заголовок, блок кода, горизонтальная линия), содержимое разбирается тем же
	// конвейером: «> > текст» даёт вложенный <blockquote>, «> - пункт» — список.
	Если ЕстьБлочныеКонструкцииВЦитате(СтрокиЦитаты) Тогда
		Фрагменты.Добавить("<blockquote>"
			+ ФрагментHTMLПоМаркдауну(СтрСоединить(СтрокиЦитаты, Символы.ПС))
			+ "</blockquote>");
		Возврат Индекс;
	КонецЕсли;

	Абзацы = Новый Массив;
	Буфер = Новый Массив;

	Для Каждого Содержимое Из СтрокиЦитаты Цикл

		Если ПустаяСтрока(Содержимое) Тогда
			Если Буфер.Количество() > 0 Тогда
				Абзацы.Добавить("<p>" + СтрСоединить(Буфер, "<br>") + "</p>");
				Буфер.Очистить();
			КонецЕсли;
		Иначе
			Буфер.Добавить(ВстроеннаяРазметка(Содержимое));
		КонецЕсли;

	КонецЦикла;

	Если Буфер.Количество() > 0 Тогда
		Абзацы.Добавить("<p>" + СтрСоединить(Буфер, "<br>") + "</p>");
	КонецЕсли;

	Фрагменты.Добавить("<blockquote>" + СтрСоединить(Абзацы, "") + "</blockquote>");

	Возврат Индекс;

КонецФункции

// Проверяет, есть ли среди строк цитаты блочные конструкции Markdown.
//
// Нужно, чтобы выбрать способ сборки: простой текст собирается абзацами через <br>
// (так же поступает showdown.js и этого ждёт постобработка алертов), а вложенные
// цитаты, списки, заголовки и блоки кода — полноценным разбором.
//
// Параметры:
//  СтрокиЦитаты - Массив из Строка - строки цитаты без ведущего ">".
//
// Возвращаемое значение:
//  Булево - Истина, если есть блочная конструкция.
//
Функция ЕстьБлочныеКонструкцииВЦитате(СтрокиЦитаты)

	Для Каждого Строка Из СтрокиЦитаты Цикл

		Если ЭтоЦитата(Строка)
			ИЛИ ЭтоНачалоБлокаКода(Строка)
			ИЛИ УровеньЗаголовка(Строка) > 0
			ИЛИ ЭтоГоризонтальнаяЛиния(Строка)
			ИЛИ ЭтоЭлементСписка(Строка) Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает содержимое строки цитаты без ведущего ">".
//
// Параметры:
//  Строка - Строка - строка исходного текста, начинающаяся с ">".
//
// Возвращаемое значение:
//  Строка - текст строки цитаты.
//
Функция СодержимоеЦитаты(Строка)

	Возврат СокрЛП(Сред(СокрЛ(СтрЗаменить(Строка, Символы.Таб, "    ")), 2));

КонецФункции

// Проверяет, является ли строка началом блока GitHub Alerts.
//
// Параметры:
//  Строка         - Строка - строка исходного текста.
//  ВнутриЦитаты   - Булево - Истина, если строка должна быть строкой цитаты
//                   ("> [!TIP|Заголовок]").
//
// Возвращаемое значение:
//  Булево - Истина, если строка открывает алерт.
//
Функция ЭтоНачалоАлерта(Строка, ВнутриЦитаты)

	Если ВнутриЦитаты Тогда
		Если НЕ ЭтоЦитата(Строка) Тогда
			Возврат Ложь;
		КонецЕсли;
		Содержимое = СодержимоеЦитаты(Строка);
	Иначе
		Содержимое = Строка;
	КонецЕсли;

	Возврат РазобратьМаркерАлерта(Содержимое) <> Неопределено;

КонецФункции

// Проверяет, что имя типа относится к GitHub Alerts.
//
// Параметры:
//  ИмяТипа - Строка - имя типа в верхнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если тип поддерживается.
//
Функция ЭтоТипАлерта(ИмяТипа)

	Возврат ИмяТипа = "NOTE" ИЛИ ИмяТипа = "TIP" ИЛИ ИмяТипа = "IMPORTANT"
		ИЛИ ИмяТипа = "WARNING" ИЛИ ИмяТипа = "CAUTION";

КонецФункции

// Разбирает маркер алерта "[!TYPE]", "[!TYPE|Заголовок]" или "[!TYPE Заголовок]".
//
// Параметры:
//  Содержимое - Строка - строка, которая может начинаться с маркера.
//
// Возвращаемое значение:
//  Структура, Неопределено - {ИмяТипа, Заголовок, Остаток} либо Неопределено,
//  если маркер не найден.
//
Функция РазобратьМаркерАлерта(Содержимое)

	Текст = СокрЛП(Содержимое);
	Если НЕ СтрНачинаетсяС(Текст, "[!") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПозЗакрытия = СтрНайти(Текст, "]");
	Если ПозЗакрытия = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Внутри = Сред(Текст, 3, ПозЗакрытия - 3);

	// Разделитель заголовка — "|" (GitHub) или пробел (как в JS-предпросмотре).
	ПозицияРазделителя = 0;
	ПозВертикали = СтрНайти(Внутри, "|");
	Если ПозВертикали > 0 Тогда
		ПозицияРазделителя = ПозВертикали;
	КонецЕсли;
	ПозПробела = СтрНайти(Внутри, " ");
	Если ПозПробела > 0
		И (ПозицияРазделителя = 0 ИЛИ ПозПробела < ПозицияРазделителя) Тогда
		ПозицияРазделителя = ПозПробела;
	КонецЕсли;

	Если ПозицияРазделителя > 0 Тогда
		ИмяТипа = Лев(Внутри, ПозицияРазделителя - 1);
		Заголовок = СокрЛП(Сред(Внутри, ПозицияРазделителя + 1));
	Иначе
		ИмяТипа = Внутри;
		Заголовок = "";
	КонецЕсли;

	ИмяТипа = ВРег(СокрЛП(ИмяТипа));
	Если НЕ ЭтоТипАлерта(ИмяТипа) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Маркер = Новый Структура;
	Маркер.Вставить("ИмяТипа", ИмяТипа);
	Маркер.Вставить("Заголовок", Заголовок);
	Маркер.Вставить("Остаток", СокрЛП(Сред(Текст, ПозЗакрытия + 1)));

	Возврат Маркер;

КонецФункции

// Собирает блок GitHub Alerts в готовый HTML.
//
// Параметры:
//  Строки        - Массив из Строка - строки исходного текста.
//  Индекс        - Число - индекс строки с маркером алерта.
//  Фрагменты     - Массив из Строка - уже собранные фрагменты HTML.
//  ВнутриЦитаты  - Булево - Истина, если алерт записан строками цитаты ("> …").
//
// Возвращаемое значение:
//  Число - индекс строки, следующей за блоком алерта.
//
Функция СобратьАлерт(Строки, Индекс, Фрагменты, ВнутриЦитаты)

	Содержимое = ?(ВнутриЦитаты, СодержимоеЦитаты(Строки[Индекс]), Строки[Индекс]);
	Маркер = РазобратьМаркерАлерта(Содержимое);

	Абзацы = Новый Массив;
	Буфер = Новый Массив;
	Если ЗначениеЗаполнено(Маркер.Остаток) Тогда
		Буфер.Добавить(ВстроеннаяРазметка(Маркер.Остаток));
	КонецЕсли;

	Индекс = Индекс + 1;

	Пока Индекс < Строки.Количество() Цикл

		// Следующий блок алерта (в т.ч. без пустой строки между блоками)
		// относится уже к новому алерту — иначе он попадёт в тело текущего
		// и выведется сырым текстом "[!TIP|…]". Маркер может быть записан
		// как строкой цитаты, так и без ">" — проверяются оба варианта.
		Если ЭтоНачалоАлерта(Строки[Индекс], ВнутриЦитаты)
			ИЛИ ЭтоНачалоАлерта(Строки[Индекс], Ложь) Тогда
			Прервать;
		КонецЕсли;

		СодержимоеСтроки = СтрокаТелААлерта(Строки[Индекс], ВнутриЦитаты);
		Если СодержимоеСтроки = Неопределено Тогда
			// Пустая строка цитаты (">") внутри блока разделяет абзацы,
			// но только если следом идёт продолжение тела — очередная
			// непустая строка цитаты.
			Если ВнутриЦитаты
				И ЭтоЦитата(Строки[Индекс])
				И ЭтоПродолжениеТелААлерта(Строки, Индекс + 1) Тогда
				ЗакрытьАбзацАлерта(Абзацы, Буфер);
				Индекс = Индекс + 1;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Буфер.Добавить(ВстроеннаяРазметка(СодержимоеСтроки));
		Индекс = Индекс + 1;
	КонецЦикла;

	ЗакрытьАбзацАлерта(Абзацы, Буфер);

	Индекс = ИндексПослеПустойСтрокиЦитаты(Строки, Индекс, ВнутриЦитаты);

	Фрагменты.Добавить(ГКСИ_MarkdownСерверВызовСервера.HTMLБлокаАлерта(
		Маркер.ИмяТипа, Маркер.Заголовок, СтрСоединить(Абзацы, "")));

	Возврат Индекс;

КонецФункции

// Переносит накопленный буфер строк тела алерта в готовый абзац.
//
// Параметры:
//  Абзацы - Массив из Строка - готовые абзацы HTML.
//  Буфер  - Массив из Строка - накопленные строки текущего абзаца.
//
Процедура ЗакрытьАбзацАлерта(Абзацы, Буфер)

	Если Буфер.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Абзацы.Добавить("<p>" + СтрСоединить(Буфер, "<br>") + "</p>");
	Буфер.Очистить();

КонецПроцедуры

// Проверяет, продолжается ли тело алерта с указанной строки.
//
// Параметры:
//  Строки  - Массив из Строка - строки исходного текста.
//  Индекс  - Число - индекс проверяемой строки.
//
// Возвращаемое значение:
//  Булево - Истина, если строка продолжает тело алерта.
//
Функция ЭтоПродолжениеТелААлерта(Строки, Индекс)

	Если Индекс >= Строки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЭтоЦитата(Строки[Индекс]) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоНачалоАлерта(Строки[Индекс], Истина) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ ПустаяСтрока(СодержимоеЦитаты(Строки[Индекс]));

КонецФункции

// Возвращает содержимое строки тела алерта либо Неопределено, если тело закончилось.
//
// Тело алерта собирается только из подряд идущих строк того же вида, что и
// строка-маркер:
//  - алерт, начатый цитатой ("> [!TYPE]"), продолжается только строками цитаты
//    ("> текст"). Первая строка без ">" завершает блок — иначе в блок попадал
//    обычный текст, идущий после алерта;
//  - алерт без ">" продолжается обычными непустыми строками до пустой строки
//    или до следующего маркера [!TYPE].
//
// Параметры:
//  Строка        - Строка - очередная строка исходного текста.
//  ВнутриЦитаты  - Булево - Истина, если алерт начат строкой цитаты ("> [!TYPE]").
//
// Возвращаемое значение:
//  Строка, Неопределено - содержимое строки тела либо Неопределено.
//
Функция СтрокаТелААлерта(Строка, ВнутриЦитаты)

	Если ВнутриЦитаты Тогда
		Если НЕ ЭтоЦитата(Строка) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Содержимое = СодержимоеЦитаты(Строка);
		Если ПустаяСтрока(Содержимое) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Содержимое;
	КонецЕсли;

	Если ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Строка;

КонецФункции

// Пропускает пустую строку цитаты, завершившую тело алерта.
//
// Параметры:
//  Строки        - Массив из Строка - строки исходного текста.
//  Индекс        - Число - индекс строки, на которой остановился разбор тела.
//  ВнутриЦитаты  - Булево - Истина, если алерт записан строками цитаты ("> …").
//
// Возвращаемое значение:
//  Число - индекс строки, с которой продолжается разбор.
//
Функция ИндексПослеПустойСтрокиЦитаты(Строки, Индекс, ВнутриЦитаты)

	Если НЕ ВнутриЦитаты ИЛИ Индекс >= Строки.Количество() Тогда
		Возврат Индекс;
	КонецЕсли;

	Если ЭтоЦитата(Строки[Индекс]) И ПустаяСтрока(СодержимоеЦитаты(Строки[Индекс])) Тогда
		Возврат Индекс + 1;
	КонецЕсли;

	Возврат Индекс;

КонецФункции

// Проверяет, является ли строка элементом маркированного или нумерованного списка.
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Булево - Истина, если строка является элементом списка.
//
Функция ЭтоЭлементСписка(Строка)

	Текст = СокрЛ(СтрЗаменить(Строка, Символы.Таб, "    "));

	Возврат СтрНачинаетсяС(Текст, "- ")
		ИЛИ СтрНачинаетсяС(Текст, "* ")
		ИЛИ СтрНачинаетсяС(Текст, "+ ")
		ИЛИ ЭтоНумерованныйЭлемент(Текст);

КонецФункции

// Проверяет, является ли строка элементом нумерованного списка ("1. текст").
//
// Параметры:
//  Строка - Строка - строка исходного текста без ведущих пробелов.
//
// Возвращаемое значение:
//  Булево - Истина, если строка является элементом нумерованного списка.
//
Функция ЭтоНумерованныйЭлемент(Строка)

	Текст = СокрЛП(Строка);
	ПозицияТочки = СтрНайти(Текст, ".");
	Если ПозицияТочки <= 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Номер = Лев(Текст, ПозицияТочки - 1);
	Для Индекс = 1 По СтрДлина(Номер) Цикл
		Если СтрНайти("0123456789", Сред(Номер, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат (Сред(Текст, ПозицияТочки + 1, 1) = " ");

КонецФункции

// Возвращает величину отступа строки (табуляция считается за 4 пробела).
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Число - количество ведущих пробелов.
//
Функция ОтступСтроки(Строка)

	Текст = СтрЗаменить(Строка, Символы.Таб, "    ");
	Возврат СтрДлина(Текст) - СтрДлина(СокрЛ(Текст));

КонецФункции

// Возвращает текст элемента списка без маркера.
//
// Параметры:
//  Строка - Строка - строка исходного текста.
//
// Возвращаемое значение:
//  Строка - текст элемента списка.
//
Функция ТекстЭлементаСписка(Строка)

	Текст = СокрЛ(СтрЗаменить(Строка, Символы.Таб, "    "));

	Если ЭтоНумерованныйЭлемент(Текст) Тогда
		Возврат СокрЛП(Сред(Текст, СтрНайти(Текст, ".") + 1));
	КонецЕсли;

	Возврат СокрЛП(Сред(Текст, 2));

КонецФункции

// Собирает список (маркированный или нумерованный) с поддержкой вложенности.
//
// Параметры:
//  Строки     - Массив из Строка - строки исходного текста.
//  Индекс     - Число - индекс первого элемента списка.
//  Фрагменты  - Массив из Строка - уже собранные фрагменты HTML.
//
// Возвращаемое значение:
//  Число - индекс строки, следующей за списком.
//
Функция СобратьСписок(Строки, Индекс, Фрагменты)

	ПервыйОтступ = ОтступСтроки(Строки[Индекс]);
	ЭтоНумерованный = ЭтоНумерованныйЭлемент(СокрЛ(Строки[Индекс]));
	Тег = ?(ЭтоНумерованный, "ol", "ul");

	Фрагменты.Добавить("<" + Тег + ">");

	Пока Индекс < Строки.Количество() Цикл

		Строка = Строки[Индекс];
		Если НЕ ЭтоЭлементСписка(Строка) Тогда
			Прервать;
		КонецЕсли;

		Отступ = ОтступСтроки(Строка);
		Если Отступ < ПервыйОтступ Тогда
			Прервать;
		КонецЕсли;

		Если Отступ > ПервыйОтступ Тогда
			Вложенные = Новый Массив;
			Индекс = СобратьСписок(Строки, Индекс, Вложенные);
			ДобавитьВложенныйСписок(Фрагменты, Вложенные);
			Продолжить;
		КонецЕсли;

		Фрагменты.Добавить("<li>" + ЭлементСпискаHTML(ТекстЭлементаСписка(Строка)) + "</li>");
		Индекс = Индекс + 1;

	КонецЦикла;

	Фрагменты.Добавить("</" + Тег + ">");

	Возврат Индекс;

КонецФункции

// Добавляет вложенный список внутрь последнего элемента родительского списка.
//
// Параметры:
//  Фрагменты - Массив из Строка - фрагменты родительского списка.
//  Вложенные - Массив из Строка - фрагменты вложенного списка.
//
Процедура ДобавитьВложенныйСписок(Фрагменты, Вложенные)

	Если Вложенные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВложенныйHTML = СтрСоединить(Вложенные, "");

	Если Фрагменты.Количество() = 0 Тогда
		Фрагменты.Добавить(ВложенныйHTML);
		Возврат;
	КонецЕсли;

	Последний = Фрагменты[Фрагменты.Количество() - 1];
	Если СтрЗаканчиваетсяНа(Последний, "</li>") Тогда
		Фрагменты[Фрагменты.Количество() - 1] =
			Лев(Последний, СтрДлина(Последний) - 5) + ВложенныйHTML + "</li>";
	Иначе
		Фрагменты.Добавить(ВложенныйHTML);
	КонецЕсли;

КонецПроцедуры

// Формирует HTML элемента списка, включая чекбоксы списка задач.
//
// Параметры:
//  Текст - Строка - текст элемента списка без маркера.
//
// Возвращаемое значение:
//  Строка - HTML элемента списка.
//
Функция ЭлементСпискаHTML(Текст)

	// Чекбокс рисуется inline-стилями: поле HTML-документа 1С показывает
	// <input type="checkbox" disabled> серым квадратом без состояния, поэтому
	// состояние передаётся символом галочки внутри рамки.
	СтильФлажка = "display:inline-block;width:9pt;height:9pt;line-height:9pt;text-align:center;"
		+ "border:1px solid #8a949e;border-radius:2pt;margin-right:4pt;vertical-align:-1pt;font-size:9pt;";

	Если СтрНачинаетсяС(Текст, "[ ] ") Тогда
		Возврат "<span style=""" + СтильФлажка + """>&nbsp;</span> "
			+ ВстроеннаяРазметка(Сред(Текст, 5));
	КонецЕсли;

	Если СтрНачинаетсяС(НРег(Текст), "[x] ") Тогда
		Возврат "<span style=""" + СтильФлажка + "color:#1a7f37;"">&#10003;</span> "
			+ ВстроеннаяРазметка(Сред(Текст, 5));
	КонецЕсли;

	Возврат ВстроеннаяРазметка(Текст);

КонецФункции

// Проверяет, начинается ли с указанной строки таблица Markdown.
//
// Параметры:
//  Строки - Массив из Строка - строки исходного текста.
//  Индекс - Число - индекс проверяемой строки.
//
// Возвращаемое значение:
//  Булево - Истина, если строка является заголовком таблицы.
//
Функция ЭтоТаблица(Строки, Индекс)

	Если Индекс + 1 >= Строки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаЗаголовка = Строки[Индекс];
	СтрокаРазделителя = Строки[Индекс + 1];

	Если СтрНайти(СтрокаЗаголовка, "|") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Проверка = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(
		СтрЗаменить(СтрокаРазделителя, "|", ""), "-", ""), ":", ""), " ", ""), Символы.Таб, "");

	Возврат СтрНайти(СтрокаРазделителя, "-") > 0 И ПустаяСтрока(Проверка);

КонецФункции

// Собирает таблицу Markdown в HTML.
//
// Параметры:
//  Строки     - Массив из Строка - строки исходного текста.
//  Индекс     - Число - индекс строки заголовка таблицы.
//  Фрагменты  - Массив из Строка - уже собранные фрагменты HTML.
//
// Возвращаемое значение:
//  Число - индекс строки, следующей за таблицей.
//
Функция СобратьТаблицу(Строки, Индекс, Фрагменты)

	Заголовки = ЯчейкиТаблицы(Строки[Индекс]);
	Индекс = Индекс + 2;

	Фрагменты.Добавить("<table>");
	Фрагменты.Добавить("<thead><tr>");
	Для Каждого Заголовок Из Заголовки Цикл
		Фрагменты.Добавить("<th>" + ВстроеннаяРазметка(Заголовок) + "</th>");
	КонецЦикла;
	Фрагменты.Добавить("</tr></thead>");
	Фрагменты.Добавить("<tbody>");

	Пока Индекс < Строки.Количество()
		И НЕ ПустаяСтрока(Строки[Индекс])
		И СтрНайти(Строки[Индекс], "|") > 0 Цикл

		Фрагменты.Добавить("<tr>");
		Для Каждого Ячейка Из ЯчейкиТаблицы(Строки[Индекс]) Цикл
			Фрагменты.Добавить("<td>" + ВстроеннаяРазметка(Ячейка) + "</td>");
		КонецЦикла;
		Фрагменты.Добавить("</tr>");

		Индекс = Индекс + 1;

	КонецЦикла;

	Фрагменты.Добавить("</tbody>");
	Фрагменты.Добавить("</table>");

	Возврат Индекс;

КонецФункции

// Разбирает строку таблицы на ячейки.
//
// Параметры:
//  Строка - Строка - строка таблицы.
//
// Возвращаемое значение:
//  Массив из Строка - тексты ячеек.
//
Функция ЯчейкиТаблицы(Строка)

	Текст = СокрЛП(Строка);

	Если СтрНачинаетсяС(Текст, "|") Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Если СтрЗаканчиваетсяНа(Текст, "|") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;

	Результат = Новый Массив;
	// Пустые ячейки обязательны: при записи «| a || c |» пустая ячейка не должна
	// исчезать, иначе значения сдвигаются влево относительно заголовка.
	Для Каждого Ячейка Из СтрРазделить(Текст, "|", Истина) Цикл
		Результат.Добавить(СокрЛП(Ячейка));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Преобразует инлайн-разметку строки в HTML.
//
// Содержимое `кода` защищается от дальнейших замен, чтобы звёздочки и ссылки
// внутри него остались как есть.
//
// Параметры:
//  Строка - Строка - строка Markdown.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент строки.
//
Функция ВстроеннаяРазметка(Строка)

	КодовыеФрагменты = Новый Массив;
	// Экранируем «опасные» символы до разбора разметки: готовые теги (вики-ссылки,
	// плеер видео) сохраняются как есть, а знаки «<», «>», «&» в обычном тексте
	// больше не ломают HTML и не съедают остаток строки.
	Результат = ЭкранироватьТекстСтроки(Строка);
	Результат = ЗащититьКодВСтроке(Результат, КодовыеФрагменты);

	Результат = ЗаменитьКартинкиMarkdown(Результат);
	Результат = ЗаменитьСсылкиMarkdown(Результат);
	Результат = ЗаменитьАвтоСсылки(Результат);
	Результат = ЗаменитьПарнуюРазметку(Результат, "**", "strong");
	Результат = ЗаменитьПарнуюРазметку(Результат, "__", "strong");
	Результат = ЗаменитьПарнуюРазметку(Результат, "~~", "s");
	// Курсив оформляется тегом i: поле HTML-документа 1С не наклоняет текст
	// внутри em (собственный стиль движка), а i отображается курсивом всегда.
	Результат = ЗаменитьПарнуюРазметку(Результат, "*", "i");
	Результат = ЗаменитьКурсивПодчеркиванием(Результат);

	Возврат ВосстановитьКодВСтроке(Результат, КодовыеФрагменты);

КонецФункции

// Заменяет `код` на маркеры и складывает готовые <code> в массив.
//
// Параметры:
//  Строка           - Строка - строка Markdown.
//  КодовыеФрагменты - Массив из Строка - сюда складываются готовые <code>.
//
// Возвращаемое значение:
//  Строка - строка с маркерами вместо кода.
//
Функция ЗащититьКодВСтроке(Строка, КодовыеФрагменты)

	Результат = "";
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиСТекста(Строка, "`", Позиция);
		Если Начало = 0 Тогда
			Результат = Результат + Сред(Строка, Позиция);
			Прервать;
		КонецЕсли;

		Конец = НайтиСТекста(Строка, "`", Начало + 1);
		Если Конец = 0 Тогда
			Результат = Результат + Сред(Строка, Позиция);
			Прервать;
		КонецЕсли;

		Содержимое = Сред(Строка, Начало + 1, Конец - Начало - 1);
		Результат = Результат + Сред(Строка, Позиция, Начало - Позиция)
			+ "@@КОД" + Строка(КодовыеФрагменты.Количество()) + "@@";
		// Текст строки уже экранирован в ЭкранироватьТекстСтроки, повторно не экранируем.
		// Оформление — inline-стилями: внешние стили до поля HTML-документа не доезжают.
		КодовыеФрагменты.Добавить("<code style=""font-family:Consolas,'Courier New',monospace;"
			+ "font-size:9pt;background-color:#f0f0f0;border-radius:2px;padding:1px 3px;"">"
			+ Содержимое + "</code>");

		Позиция = Конец + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает защищённые фрагменты кода на их места.
//
// Параметры:
//  Строка           - Строка - строка с маркерами кода.
//  КодовыеФрагменты - Массив из Строка - готовые <code>.
//
// Возвращаемое значение:
//  Строка - строка с восстановленным кодом.
//
Функция ВосстановитьКодВСтроке(Строка, КодовыеФрагменты)

	Результат = Строка;
	Для Индекс = 0 По КодовыеФрагменты.Количество() - 1 Цикл
		Результат = СтрЗаменить(Результат, "@@КОД" + Строка(Индекс) + "@@", КодовыеФрагменты[Индекс]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Безопасный СтрНайти по начальной позиции.
//
// Платформа бросает "Недопустимое значение параметра (параметр номер '4')",
// если начальная позиция больше длины строки, - а в разборе Markdown позиция
// законно уходит за конец текста (конструкция в конце строки, пустая строка).
//
// Параметры:
//  Текст     - Строка - строка поиска.
//  Подстрока - Строка - искомая подстрока.
//  Позиция   - Число - начальная позиция поиска (1 и больше).
//
// Возвращаемое значение:
//  Число - позиция первого вхождения начиная с Позиция либо 0, если вхождения нет.
//
Функция НайтиСТекста(Текст, Подстрока, Позиция)

	Если Позиция < 1 ИЛИ Позиция > СтрДлина(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат СтрНайти(Текст, Подстрока, , Позиция);

КонецФункции

// Заменяет парную инлайн-разметку на HTML-тег.
//
// Параметры:
//  Текст         - Строка - текст с разметкой.
//  Разметка      - Строка - открывающая и закрывающая последовательность.
//  ИмяТега       - Строка - имя HTML-тега.
//
// Возвращаемое значение:
//  Строка - текст с HTML-тегами.
//
Функция ЗаменитьПарнуюРазметку(Текст, Разметка, ИмяТега)

	Результат = Текст;
	ДлинаРазметки = СтрДлина(Разметка);
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиСТекста(Результат, Разметка, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		// Разметка внутри готового тега (например, «_» в href или alt) не
		// является Markdown-разметкой: иначе подчёркивания в адресе рвут ссылку.
		Если ЭтоВнутриHTMLТега(Результат, Начало) Тогда
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		Конец = НайтиСТекста(Результат, Разметка, Начало + ДлинаРазметки);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;

		Содержимое = Сред(Результат, Начало + ДлинаРазметки,
			Конец - Начало - ДлинаРазметки);

		Если ПустаяСтрока(Содержимое) Тогда
			Позиция = Конец + ДлинаРазметки;
			Продолжить;
		КонецЕсли;

		// По правилам Markdown открывающий маркер не может стоять перед пробелом,
		// а закрывающий — после пробела: «текст * и ещё * и третья *» — не курсив,
		// звёздочки должны остаться как есть.
		Если ЭтоПробельныйСимвол(Лев(Содержимое, 1))
			ИЛИ ЭтоПробельныйСимвол(Прав(Содержимое, 1)) Тогда
			Позиция = Начало + ДлинаРазметки;
			Продолжить;
		КонецЕсли;

		Замена = "<" + ИмяТега + ">" + Содержимое + "</" + ИмяТега + ">";
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + ДлинаРазметки);
		Позиция = Начало + СтрДлина(Замена);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, является ли символ пробельным (пробел, табуляция, неразрывный пробел).
//
// Параметры:
//  Символ - Строка - один символ (может быть пустой строкой).
//
// Возвращаемое значение:
//  Булево - Истина, если символ пробельный или строка пустая.
//
Функция ЭтоПробельныйСимвол(Символ)

	Если ПустаяСтрока(Символ) Тогда
		Возврат Истина;
	КонецЕсли;

	Код = КодСимвола(Символ);
	Возврат Код = 32 ИЛИ Код = 9 ИЛИ Код = 160;

КонецФункции

// Заменяет картинки Markdown (![alt](адрес)) на тег img.
//
// Параметры:
//  Текст - Строка - текст с разметкой картинок.
//
// Возвращаемое значение:
//  Строка - текст с тегами img.
//
Функция ЗаменитьКартинкиMarkdown(Текст)

	Результат = Текст;
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиСТекста(Результат, "![", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Середина = НайтиСТекста(Результат, "](", Начало + 2);
		Если Середина = 0 Тогда
			Прервать;
		КонецЕсли;

		Конец = НайтиСТекста(Результат, ")", Середина + 2);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;

		Альт = Сред(Результат, Начало + 2, Середина - Начало - 2);
		Адрес = Сред(Результат, Середина + 2, Конец - Середина - 2);

		Замена = "<img src=""" + ЭкранироватьАтрибут(Адрес) + """ alt="""
			+ ЭкранироватьАтрибут(Альт) + """>";
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 1);
		Позиция = Начало + СтрДлина(Замена);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет ссылки Markdown ([текст](адрес)) на тег a.
//
// Параметры:
//  Текст - Строка - текст с разметкой ссылок.
//
// Возвращаемое значение:
//  Строка - текст с тегами a.
//
Функция ЗаменитьСсылкиMarkdown(Текст)

	Результат = Текст;
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиСТекста(Результат, "[", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		// Конструкции [[…]] (вики-ссылки) и уже готовые теги не разбираются.
		Если Сред(Результат, Начало + 1, 1) = "[" Тогда
			Позиция = Начало + 2;
			Продолжить;
		КонецЕсли;

		Середина = НайтиСТекста(Результат, "](", Начало + 1);
		Если Середина = 0 Тогда
			Прервать;
		КонецЕсли;

		Конец = НайтиСТекста(Результат, ")", Середина + 2);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;

		ТекстСсылки = Сред(Результат, Начало + 1, Середина - Начало - 1);
		Адрес = Сред(Результат, Середина + 2, Конец - Середина - 2);

		Замена = "<a href=""" + ЭкранироватьАтрибут(Адрес) + """>" + ТекстСсылки + "</a>";
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 1);
		Позиция = Начало + СтрДлина(Замена);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет автоссылки: голые http(s):// и www., угловые (<адрес>)
// и «голые» адреса почты на тег a.
//
// Параметры:
//  Текст - Строка - текст после разбора обычных Markdown-ссылок.
//
// Возвращаемое значение:
//  Строка - текст с тегами a.
//
Функция ЗаменитьАвтоСсылки(Текст)

	// URL обрабатывается до почты: адрес вида https://user@host иначе
	// разрежется обработчиком адресов почты.
	Результат = ЗаменитьГолыеАдресаURL(Текст);
	Результат = ЗаменитьУгловыеАвтоСсылки(Результат);
	Результат = ЗаменитьГолыеАдресаПочты(Результат);

	Возврат Результат;

КонецФункции

// Заменяет <адрес> на ссылку (email, http/https, mailto).
//
// Параметры:
//  Текст - Строка - текст с разметкой.
//
// Возвращаемое значение:
//  Строка - текст с тегами a.
//
Функция ЗаменитьУгловыеАвтоСсылки(Текст)

	Результат = Текст;
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиСТекста(Результат, "<", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Конец = НайтиСТекста(Результат, ">", Начало + 1);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;

		Адрес = СокрЛП(Сред(Результат, Начало + 1, Конец - Начало - 1));
		Ссылка = HTMLАвтоСсылки(Адрес);
		Если Ссылка = "" Тогда
			Позиция = Конец + 1;
			Продолжить;
		КонецЕсли;

		Результат = Лев(Результат, Начало - 1) + Ссылка + Сред(Результат, Конец + 1);
		Позиция = Начало + СтрДлина(Ссылка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает HTML-ссылку для адреса либо пустую строку, если это не адрес.
//
// Параметры:
//  Адрес - Строка - проверяемый адрес.
//
// Возвращаемое значение:
//  Строка - тег a либо пустая строка.
//
Функция HTMLАвтоСсылки(Адрес)

	Адрес = СокрЛП(Адрес);
	Если Адрес = "" ИЛИ СтрНайти(Адрес, " ") > 0 ИЛИ СтрНайти(Адрес, """") > 0 Тогда
		Возврат "";
	КонецЕсли;

	АдресВРег = НРег(Адрес);
	Если СтрНачинаетсяС(АдресВРег, "http://") ИЛИ СтрНачинаетсяС(АдресВРег, "https://") Тогда
		Возврат "<a href=""" + ЭкранироватьАтрибут(Адрес) + """>" + Адрес + "</a>";
	КонецЕсли;

	Если СтрНачинаетсяС(АдресВРег, "mailto:") Тогда
		Возврат "<a href=""" + ЭкранироватьАтрибут(Адрес) + """>" + Сред(Адрес, 8) + "</a>";
	КонецЕсли;

	Если ЭтоАдресПочты(Адрес) Тогда
		Возврат "<a href=""mailto:" + ЭкранироватьАтрибут(Адрес) + """>" + Адрес + "</a>";
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет, похоже ли значение на адрес электронной почты.
//
// Параметры:
//  Значение - Строка - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если это адрес почты.
//
Функция ЭтоАдресПочты(Значение)

	ПозСобаки = СтрНайти(Значение, "@");
	Если ПозСобаки <= 1 ИЛИ ПозСобаки = СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Домен = Сред(Значение, ПозСобаки + 1);
	Если СтрНайти(Домен, ".") = 0 ИЛИ СтрНайти(Домен, " ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Прав(Домен, 1) <> ".";

КонецФункции

// Заменяет «голые» адреса почты на ссылки mailto.
//
// Параметры:
//  Текст - Строка - текст с адресами.
//
// Возвращаемое значение:
//  Строка - текст с тегами a.
//
Функция ЗаменитьГолыеАдресаПочты(Текст)

	Результат = Текст;
	Позиция = 1;

	Пока Истина Цикл

		Собака = НайтиСТекста(Результат, "@", Позиция);
		Если Собака = 0 Тогда
			Прервать;
		КонецЕсли;

		Начало = Собака - 1;
		Пока Начало >= 1 И ЭтоСимволАдресаПочты(Сред(Результат, Начало, 1)) Цикл
			Начало = Начало - 1;
		КонецЦикла;
		Начало = Начало + 1;

		Конец = Собака + 1;
		Пока Конец <= СтрДлина(Результат) И ЭтоСимволДомена(Сред(Результат, Конец, 1)) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Конец = Конец - 1;

		Адрес = Сред(Результат, Начало, Конец - Начало + 1);

		Если Начало < Собака И Конец > Собака
			И ЭтоАдресПочты(Адрес)
			И НЕ ЭтоУжеГиперссылка(Результат, Начало) Тогда

			Замена = "<a href=""mailto:" + ЭкранироватьАтрибут(Адрес) + """>" + Адрес + "</a>";
			Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 1);
			Позиция = Начало + СтрДлина(Замена);
		Иначе
			Позиция = Конец + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет «голые» адреса http://, https:// и www. на ссылки — так же,
// как это делает showdown в режиме GitHub (simplifiedAutoLink).
//
// Параметры:
//  Текст - Строка - текст с разметкой.
//
// Возвращаемое значение:
//  Строка - текст с тегами a.
//
Функция ЗаменитьГолыеАдресаURL(Текст)

	Результат = Текст;
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиНачалоГологоАдреса(Результат, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		// Адрес внутри слова («awww.example.com», «текстwww.example.com») ссылкой не
		// считается: без границы слова автолинк разрывает обычный текст.
		Если НЕ ЭтоНачалоАдресаНаГраницеСлова(Результат, Начало) Тогда
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		Конец = НайтиКонецГологоАдреса(Результат, Начало);
		Адрес = Сред(Результат, Начало, Конец - Начало + 1);

		Если НЕ ЭтоКорректныйАдресURL(Адрес) ИЛИ ЭтоУжеВРазметке(Результат, Начало) Тогда
			Позиция = Конец + 1;
			Продолжить;
		КонецЕсли;

		АдресВРег = НРег(Адрес);
		Если СтрНачинаетсяС(АдресВРег, "http://") ИЛИ СтрНачинаетсяС(АдресВРег, "https://") Тогда
			Ссылка = "<a href=""" + ЭкранироватьАтрибут(Адрес) + """>" + Адрес + "</a>";
		Иначе
			// Как в GitHub: www. без схемы получает http://.
			Ссылка = "<a href=""http://" + ЭкранироватьАтрибут(Адрес) + """>" + Адрес + "</a>";
		КонецЕсли;

		Результат = Лев(Результат, Начало - 1) + Ссылка + Сред(Результат, Конец + 1);
		Позиция = Начало + СтрДлина(Ссылка);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ищет ближайшее начало голого адреса (http://, https://, www.) начиная с позиции.
//
// Параметры:
//  Текст   - Строка - текст с разметкой.
//  Позиция - Число - позиция, с которой начинается поиск.
//
// Возвращаемое значение:
//  Число - позиция начала адреса либо 0, если адресов больше нет.
//
Функция НайтиНачалоГологоАдреса(Текст, Позиция)

	ТекстВРег = НРег(Текст);
	Начало = 0;

	ПозHTTP = НайтиСТекста(ТекстВРег, "http://", Позиция);
	Если ПозHTTP > 0 Тогда
		Начало = ПозHTTP;
	КонецЕсли;

	ПозHTTPS = НайтиСТекста(ТекстВРег, "https://", Позиция);
	Если ПозHTTPS > 0 И (Начало = 0 ИЛИ ПозHTTPS < Начало) Тогда
		Начало = ПозHTTPS;
	КонецЕсли;

	ПозWWW = НайтиСТекста(ТекстВРег, "www.", Позиция);
	Если ПозWWW > 0 И (Начало = 0 ИЛИ ПозWWW < Начало) Тогда
		Начало = ПозWWW;
	КонецЕсли;

	Возврат Начало;

КонецФункции

// Проверяет, что найденное начало адреса стоит на границе слова: перед ним нет
// буквы, цифры, подчёркивания, косой черты или «@». Иначе «awww.example.com»
// и «текстwww.example.com» превращаются в ссылки внутри обычного слова.
//
// Параметры:
//  Текст  - Строка - текст с разметкой.
//  Начало - Число - позиция найденного начала адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если перед адресом граница слова.
//
Функция ЭтоНачалоАдресаНаГраницеСлова(Текст, Начало)

	Если Начало <= 1 Тогда
		Возврат Истина;
	КонецЕсли;

	Предыдущий = Сред(Текст, Начало - 1, 1);
	Код = КодСимвола(Предыдущий);

	// Неразрывный пробел тоже разделитель.
	Если Код = 160 Тогда
		Возврат Истина;
	КонецЕсли;

	// Разделители, после которых адрес начинается законно (пробел, скобки, знаки
	// препинания, маркеры разметки). Всё остальное — буква или цифра любого алфавита.
	Разделители = " " + Символ(9) + "([{<""'«*>=,;:!?|.-+)]}";

	Возврат СтрНайти(Разделители, Предыдущий) > 0;

КонецФункции

// Определяет последнюю позицию адреса, не выходя за пределы строки.
//
// Параметры:
//  Текст   - Строка - текст с разметкой.
//  Начало  - Число - позиция начала адреса.
//
// Возвращаемое значение:
//  Число - позиция последнего символа адреса (хвостовая пунктуация отброшена).
//
Функция НайтиКонецГологоАдреса(Текст, Начало)

	Длина = СтрДлина(Текст);
	Конец = Начало;

	Пока Конец <= Длина И ЭтоСимволАдресаURL(Сред(Текст, Конец, 1)) Цикл
		Конец = Конец + 1;
	КонецЦикла;
	Конец = Конец - 1;

	// Точка, запятая и закрывающие скобки в конце предложения не входят в адрес.
	Пока Конец >= Начало И СтрНайти(".,;:!?)]}»*_'", Сред(Текст, Конец, 1)) > 0 Цикл
		Конец = Конец - 1;
	КонецЦикла;

	Возврат Конец;

КонецФункции

// Проверяет, допустим ли символ в «голом» адресе URL.
//
// Параметры:
//  Символ - Строка - один символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ допустим.
//
Функция ЭтоСимволАдресаURL(Символ)

	Код = КодСимвола(Символ);
	Если (Код >= 48 И Код <= 57)
		ИЛИ (Код >= 65 И Код <= 90)
		ИЛИ (Код >= 97 И Код <= 122) Тогда
		Возврат Истина;
	КонецЕсли;

	// Кириллица в адрес не включается: иначе адрес «съест» следующий за ним текст.
	// Звёздочка тоже исключена — она относится к **жирному** вокруг адреса.
	Возврат СтрНайти("/:.-_~%?#&=+@$,;!()", Символ) > 0;

КонецФункции

// Проверяет, что найденный адрес похож на URL: есть домен с точкой.
//
// Параметры:
//  Адрес - Строка - найденный адрес.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес корректен.
//
Функция ЭтоКорректныйАдресURL(Адрес)

	АдресВРег = НРег(Адрес);

	Если СтрНачинаетсяС(АдресВРег, "https://") Тогда
		Остаток = Сред(Адрес, 9);
	ИначеЕсли СтрНачинаетсяС(АдресВРег, "http://") Тогда
		Остаток = Сред(Адрес, 8);
	ИначеЕсли СтрНачинаетсяС(АдресВРег, "www.") Тогда
		Остаток = Сред(Адрес, 5);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	ПозицияСлэша = СтрНайти(Остаток, "/");
	Если ПозицияСлэша > 0 Тогда
		Домен = Лев(Остаток, ПозицияСлэша - 1);
	Иначе
		Домен = Остаток;
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Домен, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Домен = Лев(Домен, ПозицияДвоеточия - 1);
	КонецЕсли;

	Возврат СтрДлина(Домен) >= 3
		И СтрНайти(Домен, ".") > 0
		И НЕ СтрЗаканчиваетсяНа(Домен, ".");

КонецФункции

// Проверяет, что позиция находится внутри HTML-тега или тела готовой ссылки.
//
// Параметры:
//  Текст  - Строка - текст с разметкой.
//  Начало - Число - проверяемая позиция.
//
// Возвращаемое значение:
//  Булево - Истина, если позиция внутри тега или ссылки.
//
Функция ЭтоУжеВРазметке(Текст, Начало)

	ЛевыйФрагмент = Лев(Текст, Начало - 1);

	ПозицияОткрытия = ПозицияПоследнегоВхождения(ЛевыйФрагмент, "<");
	ПозицияЗакрытия = ПозицияПоследнегоВхождения(ЛевыйФрагмент, ">");
	Если ПозицияОткрытия > ПозицияЗакрытия Тогда
		Возврат Истина;
	КонецЕсли;

	ЛевыйФрагментВРег = НРег(ЛевыйФрагмент);
	ПозицияСсылки = ПозицияПоследнегоВхождения(ЛевыйФрагментВРег, "<a ");
	ПозицияКонцаСсылки = ПозицияПоследнегоВхождения(ЛевыйФрагментВРег, "</a>");

	Возврат ПозицияСсылки > 0 И ПозицияСсылки > ПозицияКонцаСсылки;

КонецФункции

// Проверяет, находится ли позиция внутри углового HTML-тега («<a href="…">»).
//
// Нужно, чтобы инлайн-разметка Markdown не меняла содержимое атрибутов уже
// собранных тегов: подчёркивание в href не должно превращаться в курсив.
//
// Параметры:
//  Текст   - Строка - текст с разметкой.
//  Позиция - Число - проверяемая позиция (1 и больше).
//
// Возвращаемое значение:
//  Булево - Истина, если позиция между последними "<" и ">".
//
Функция ЭтоВнутриHTMLТега(Текст, Позиция)

	Если Позиция <= 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Префикс = Лев(Текст, Позиция - 1);
	Возврат ПозицияПоследнегоВхождения(Префикс, "<")
		> ПозицияПоследнегоВхождения(Префикс, ">");

КонецФункции

// Возвращает позицию последнего вхождения подстроки до указанной позиции.
//
// Параметры:
//  Текст     - Строка - строка поиска.
//  Подстрока - Строка - искомая подстрока.
//
// Возвращаемое значение:
//  Число - позиция последнего вхождения либо 0, если вхождений нет.
//
Функция ПозицияПоследнегоВхождения(Текст, Подстрока)

	Результат = 0;
	Поиск = 1;

	Пока Истина Цикл

		Найдено = НайтиСТекста(Текст, Подстрока, Поиск);
		Если Найдено = 0 Тогда
			Прервать;
		КонецЕсли;

		Результат = Найдено;
		Поиск = Найдено + СтрДлина(Подстрока);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, что адрес уже находится внутри готовой ссылки.
//
// Параметры:
//  Текст  - Строка - текст.
//  Начало - Число - позиция начала адреса.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес уже часть ссылки.
//
Функция ЭтоУжеГиперссылка(Текст, Начало)

	Если ЭтоУжеВРазметке(Текст, Начало) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Начало > 7 Тогда
		Возврат НРег(Сред(Текст, Начало - 7, 7)) = "mailto:";
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Проверяет, допустим ли символ в левой части адреса почты.
//
// Параметры:
//  Символ - Строка - один символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ допустим.
//
Функция ЭтоСимволАдресаПочты(Символ)

	Если ЭтоБукваИлиЦифра(Символ) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Символ = "." ИЛИ Символ = "_" ИЛИ Символ = "%" ИЛИ Символ = "+" ИЛИ Символ = "-";

КонецФункции

// Проверяет, допустим ли символ в доменной части адреса почты.
//
// Параметры:
//  Символ - Строка - один символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ допустим.
//
Функция ЭтоСимволДомена(Символ)

	Возврат ЭтоБукваИлиЦифра(Символ) ИЛИ Символ = "." ИЛИ Символ = "-";

КонецФункции

// Проверяет, является ли символ буквой или цифрой.
//
// Параметры:
//  Символ - Строка - один символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ буквенный или цифровой.
//
Функция ЭтоБукваИлиЦифра(Символ)

	Если ПустаяСтрока(Символ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Код = КодСимвола(Символ);
	Возврат (Код >= 48 И Код <= 57)
		ИЛИ (Код >= 65 И Код <= 90)
		ИЛИ (Код >= 97 И Код <= 122)
		ИЛИ (Код >= 1040 И Код <= 1103)
		ИЛИ Код = 1025 ИЛИ Код = 1105;

КонецФункции

// Заменяет _курсив_ на em. Подчеркивания внутри слов (snake_case) не трогаются.
//
// Параметры:
//  Текст - Строка - текст с разметкой.
//
// Возвращаемое значение:
//  Строка - текст с тегами em.
//
Функция ЗаменитьКурсивПодчеркиванием(Текст)

	Результат = Текст;
	Позиция = 1;

	Пока Истина Цикл

		Начало = НайтиСТекста(Результат, "_", Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		// Подчёркивание внутри готового тега (href, alt, src) не является
		// Markdown-курсивом.
		Если ЭтоВнутриHTMLТега(Результат, Начало) Тогда
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		Если Начало > 1 И ЭтоБукваИлиЦифра(Сред(Результат, Начало - 1, 1)) Тогда
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		Конец = НайтиСТекста(Результат, "_", Начало + 1);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;

		Если Конец < СтрДлина(Результат)
			И ЭтоБукваИлиЦифра(Сред(Результат, Конец + 1, 1)) Тогда
			Позиция = Конец + 1;
			Продолжить;
		КонецЕсли;

		Содержимое = Сред(Результат, Начало + 1, Конец - Начало - 1);
		Если ПустаяСтрока(Содержимое) Тогда
			Позиция = Конец + 1;
			Продолжить;
		КонецЕсли;

		Замена = "<i>" + Содержимое + "</i>";
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 1);
		Позиция = Начало + СтрДлина(Замена);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Экранирует «опасные» символы HTML в тексте строки, сохраняя готовые теги.
//
// Готовые теги (вики-ссылки [[…]], плеер видео, ранее собранные <a>/<img>/<code>)
// должны остаться разметкой, а знаки «<», «>», «&» в обычном тексте — превратиться
// в сущности. Иначе «цена < 100» браузер выбрасывает как неизвестный тег.
//
// Функция идемпотентна: уже экранированные сущности (&amp;, &lt;, &#…;) повторно
// не экранируются, поэтому повторный проход по готовому HTML его не портит.
//
// Параметры:
//  Текст - Строка - строка Markdown.
//
// Возвращаемое значение:
//  Строка - строка с экранированными «опасными» символами.
//
Функция ЭкранироватьТекстСтроки(Текст)

	// Быстрый выход: в обычной строке без спецсимволов делать нечего.
	Если СтрНайти(Текст, "<") = 0 И СтрНайти(Текст, ">") = 0
		И СтрНайти(Текст, "&") = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = "";
	Позиция = 1;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Символ = "<" Тогда
			КонецТега = КонецИзвестногоТега(Текст, Позиция);
			Если КонецТега = 0 Тогда
				// Угловая автоссылка Markdown (<https://…>, <mail@…>) не HTML-тег:
				// её оставляем как есть, иначе автолинк перестанет работать.
				КонецТега = КонецУгловойАвтоссылки(Текст, Позиция);
			КонецЕсли;
			Если КонецТега > 0 Тогда
				Результат = Результат + Сред(Текст, Позиция, КонецТега - Позиция + 1);
				Позиция = КонецТега + 1;
				Продолжить;
			КонецЕсли;
			Результат = Результат + "&lt;";
		ИначеЕсли Символ = ">" Тогда
			Результат = Результат + "&gt;";
		ИначеЕсли Символ = "&" Тогда
			Если ЭтоНачалоСущностиHTML(Текст, Позиция) Тогда
				Результат = Результат + Символ;
			Иначе
				Результат = Результат + "&amp;";
			КонецЕсли;
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает позицию закрывающей ">" известного HTML-тега, начинающегося в позиции.
//
// Параметры:
//  Текст   - Строка - строка с разметкой.
//  Позиция - Число - позиция символа "<".
//
// Возвращаемое значение:
//  Число - позиция ">" либо 0, если это не известный тег.
//
Функция КонецИзвестногоТега(Текст, Позиция)

	Остаток = Сред(Текст, Позиция + 1);
	Смещение = 1;
	Если СтрНачинаетсяС(Остаток, "/") Тогда
		Смещение = 2;
	КонецЕсли;

	Имя = "";
	Индекс = Смещение;
	Пока Индекс <= СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Код = КодСимвола(Символ);
		Если (Код >= 48 И Код <= 57)
			ИЛИ (Код >= 65 И Код <= 90)
			ИЛИ (Код >= 97 И Код <= 122) Тогда
			Имя = Имя + Символ;
		Иначе
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Если НЕ ЭтоИзвестныйТег(НРег(Имя)) Тогда
		Возврат 0;
	КонецЕсли;

	ПозицияКонца = НайтиСТекста(Остаток, ">", Индекс);
	Если ПозицияКонца = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Позиция + ПозицияКонца;

КонецФункции

// Возвращает позицию закрывающей ">" угловой автоссылки Markdown (<адрес>).
//
// Параметры:
//  Текст   - Строка - строка с разметкой.
//  Позиция - Число - позиция символа "<".
//
// Возвращаемое значение:
//  Число - позиция ">" либо 0, если это не угловая автоссылка.
//
Функция КонецУгловойАвтоссылки(Текст, Позиция)

	Конец = НайтиСТекста(Текст, ">", Позиция + 1);
	Если Конец = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Внутри = Сред(Текст, Позиция + 1, Конец - Позиция - 1);
	Если СтрНайти(Внутри, " ") > 0 ИЛИ ПустаяСтрока(Внутри) Тогда
		Возврат 0;
	КонецЕсли;

	Если СтрНайти(Внутри, "://") = 0 И СтрНайти(Внутри, "@") = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Конец;

КонецФункции

// Проверяет, входит ли имя тега в белый список тегов конвертера.
//
// Параметры:
//  ИмяТега - Строка - имя тега в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если тег допустим в тексте инструкции.
//
Функция ЭтоИзвестныйТег(ИмяТега)

	Если ПустаяСтрока(ИмяТега) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(" a abbr b big blockquote br code dd del div dl dt em figcaption figure"
		+ " font h1 h2 h3 h4 h5 h6 hr i iframe img input ins li mark ol p pre s small source"
		+ " span strong sub sup table tbody td th thead tr u ul video ", " " + ИмяТега + " ") > 0;

КонецФункции

// Проверяет, начинается ли в позиции уже готовая HTML-сущность (&amp;, &#123; …).
//
// Параметры:
//  Текст   - Строка - строка с разметкой.
//  Позиция - Число - позиция символа "&".
//
// Возвращаемое значение:
//  Булево - Истина, если это начало сущности (повторно экранировать не нужно).
//
Функция ЭтоНачалоСущностиHTML(Текст, Позиция)

	Остаток = НРег(Сред(Текст, Позиция, 12));

	Если СтрНачинаетсяС(Остаток, "&amp;")
		ИЛИ СтрНачинаетсяС(Остаток, "&lt;")
		ИЛИ СтрНачинаетсяС(Остаток, "&gt;")
		ИЛИ СтрНачинаетсяС(Остаток, "&quot;")
		ИЛИ СтрНачинаетсяС(Остаток, "&apos;")
		ИЛИ СтрНачинаетсяС(Остаток, "&nbsp;") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Остаток, "&#");

КонецФункции

// Экранирует спецсимволы HTML (используется внутри блоков кода).
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML.
//
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");

	Возврат Результат;

КонецФункции

// Экранирует значение, вставляемое в HTML-атрибут (href, src, alt, title).
//
// Параметры:
//  Значение - Строка - значение атрибута.
//
// Возвращаемое значение:
//  Строка - значение, безопасное внутри двойных кавычек атрибута.
//
Функция ЭкранироватьАтрибут(Значение)

	// Значение обычно уже прошло ЭкранироватьТекстСтроки, поэтому «&» экранируем
	// только вне готовых сущностей — иначе получилось бы «&amp;amp;».
	Если СтрНайти(Значение, """") = 0 И СтрНайти(Значение, "&") = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	Результат = "";
	Позиция = 1;
	Длина = СтрДлина(Значение);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Символ = """" Тогда
			Результат = Результат + "&quot;";
		ИначеЕсли Символ = "&" И НЕ ЭтоНачалоСущностиHTML(Значение, Позиция) Тогда
			Результат = Результат + "&amp;";
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
