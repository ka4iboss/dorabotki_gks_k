////////////////////////////////////////////////////////////////////////////////
// Сопоставление оплат с заявками на расходование денежных средств.
//
// Обработка выполняется построчно: каждая выделенная строка «оплата - заявка»
// проходит полный цикл независимо от остальных строк. Ошибка по одной строке
// не прерывает обработку: она записывается в результат с указанием оплаты,
// заявки и заказа, а обработка переходит к следующей строке. Документы одного
// заказа поставщику обрабатываются один раз за запуск.
//
// Перед сопоставлением при необходимости приводит договор заказа поставщику
// к детализации расчётов «По заказам» и перезаполняет связанные документы.
//
// Заявка, участвующая в сопоставлении, переводится в статус «К оплате»: иначе
// типовой контроль (ДенежныеСредстваСервер.ПроверитьЗаявкуНаРасходованиеДенежныхСредств)
// не даёт провести документ оплаты, ссылающийся на такую заявку.

#Область ПрограммныйИнтерфейс

// Подготавливает задание для фонового выполнения: проверяет выделенные строки,
// собирает цепочку «заказ поставщику - заявки - оплаты» и определяет,
// требуется ли приведение договоров к детализации расчётов «По заказам».
//
// Строки с ошибками подготовки не блокируют обработку остальных строк:
// они возвращаются в «Ошибки» и попадают в итоговый отчёт.
//
// Параметры:
//  ДанныеСтрок - Массив из Структура - выделенные строки таблицы:
//   * Оплата - ДокументСсылка.СписаниеБезналичныхДенежныхСредств
//   * Заявка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств
//
// Возвращаемое значение:
//  Структура - результат подготовки задания:
//   * Строки - Массив из Структура - строки для сопоставления (Оплата, Заявка, Заказ);
//   * ТребуетсяПриведение - Булево - Истина, если требуется изменить детализацию расчётов;
//   * ОписаниеПриведения - Строка - описание предстоящих действий;
//   * Ошибки - Массив из Строка - ошибки подготовки.
//
Функция ПодготовитьЗадание(ДанныеСтрок) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ТребуетсяПриведение", Ложь);
	Результат.Вставить("ОписаниеПриведения", "");
	Результат.Вставить("Ошибки", Новый Массив);
	
	Заказы = Новый Массив;
	Договоры = Новый Массив;
	ОбработанныеОплаты = Новый Соответствие;
	
	Для Каждого ДанныеСтроки Из ДанныеСтрок Цикл
		
		ОплатаСсылка = ДанныеСтроки.Оплата;
		ЗаявкаСсылка = ДанныеСтроки.Заявка;
		Если НЕ ЗначениеЗаполнено(ОплатаСсылка) ИЛИ НЕ ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
			Результат.Ошибки.Добавить("Строка пропущена: не заполнена оплата или заявка.");
			Продолжить;
		КонецЕсли;
		Если ОбработанныеОплаты.Получить(ОплатаСсылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеОплаты.Вставить(ОплатаСсылка, Истина);
		
		ЗаказСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "ДокументОснование");
		Если ТипЗнч(ЗаказСсылка) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Заявка %1: документ-основание не является заказом поставщику.",
				Строка(ЗаявкаСсылка)));
			Продолжить;
		КонецЕсли;
		
		СтрокаЗадания = Новый Структура;
		СтрокаЗадания.Вставить("Оплата", ОплатаСсылка);
		СтрокаЗадания.Вставить("Заявка", ЗаявкаСсылка);
		СтрокаЗадания.Вставить("Заказ", ЗаказСсылка);
		Результат.Строки.Добавить(СтрокаЗадания);
		
		Если Заказы.Найти(ЗаказСсылка) = Неопределено Тогда
			Заказы.Добавить(ЗаказСсылка);
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеДоговоров = Новый Массив;
	Для Каждого ЗаказСсылка Из Заказы Цикл
		
		ДоговорСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Договор");
		Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Заказ поставщику %1: не заполнен договор.", Строка(ЗаказСсылка)));
			Продолжить;
		КонецЕсли;
		
		Если Договоры.Найти(ДоговорСсылка) = Неопределено Тогда
			Договоры.Добавить(ДоговорСсылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ДоговорСсылка Из Договоры Цикл
		ПорядокРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "ПорядокРасчетов");
		Если ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
			Результат.ТребуетсяПриведение = Истина;
			ОписаниеДоговоров.Добавить(Строка(ДоговорСсылка));
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.ТребуетсяПриведение Тогда
		Результат.ОписаниеПриведения =
			"У договоров (" + СтрСоединить(ОписаниеДоговоров, ", ") + ") детализация расчётов отличается от «По заказам»."
			+ Символы.ПС
			+ "Будут распроведены и повторно проведены: заказ поставщику, заявки на расходование денежных средств"
			+ " и оплаты по ним. Затем оплаты будут сопоставлены с заявками."
			+ Символы.ПС + "Продолжить?";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Фоновая процедура: построчное сопоставление оплат с заявками
// с приведением договоров к детализации расчётов «По заказам».
//
// Параметры:
//  ПараметрыЗадания - Структура - параметры задания:
//   * Строки - Массив из Структура - строки для сопоставления (Оплата, Заявка, Заказ);
//   * ОшибкиПодготовки - Массив из Строка - ошибки, найденные при подготовке задания.
//  АдресРезультата - Строка - адрес результата во временном хранилище (формируется БСП).
//
Процедура ВыполнитьЗадание(ПараметрыЗадания, АдресРезультата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("ОшибкиСтрок", Новый Массив);
	Результат.Вставить("Этап", "");
	Результат.Вставить("ПриведениеВыполнено", Ложь);
	Результат.Вставить("СопоставленоОплат", 0);
	Результат.Вставить("ОбработаноСтрок", 0);
	Результат.Вставить("ВсегоСтрок", 0);
	
	Если ТипЗнч(ПараметрыЗадания.Строки) = Тип("Массив") Тогда
		Результат.ВсегоСтрок = ПараметрыЗадания.Строки.Количество();
	КонецЕсли;
	
	Если ПараметрыЗадания.Свойство("ОшибкиПодготовки")
		И ТипЗнч(ПараметрыЗадания.ОшибкиПодготовки) = Тип("Массив") Тогда
		
		Для Каждого ТекстОшибки Из ПараметрыЗадания.ОшибкиПодготовки Цикл
			ДобавитьОшибкуСтроки(Результат, Неопределено, Неопределено, Неопределено, "Подготовка задания", ТекстОшибки);
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		
		СостояниеЗаказов = Новый Соответствие;
		ВсегоСтрок = Результат.ВсегоСтрок;
		
		Для Индекс = 0 По ВсегоСтрок - 1 Цикл
			
			СтрокаЗадания = ПараметрыЗадания.Строки[Индекс];
			НомерСтроки = Индекс + 1;
			
			Попытка
				
				ОбработатьСтроку(СтрокаЗадания, НомерСтроки, ВсегоСтрок, СостояниеЗаказов, Результат);
				Результат.ОбработаноСтрок = Результат.ОбработаноСтрок + 1;
				
			Исключение
				
				ДанныеОшибки = ИнформацияОбОшибке();
				ДобавитьОшибкуСтроки(Результат,
					СтрокаЗадания.Оплата, СтрокаЗадания.Заявка, СтрокаЗадания.Заказ,
					Результат.Этап, ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
				ЗаписьЖурналаРегистрации("ГКСК.СопоставлениеОплатПоЗаявкам",
					УровеньЖурналаРегистрации.Ошибка, , ,
					СтрШаблон("Строка %1 из %2: этап «%3»: %4",
						НомерСтроки, ВсегоСтрок, Результат.Этап,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки)));
				
			КонецПопытки;
			
		КонецЦикла;
		
		Результат.Этап = "";
		ДлительныеОперации.СообщитьПрогресс(100, "Готово");
		
	Исключение
		
		ДанныеОшибки = ИнформацияОбОшибке();
		ДобавитьОшибкуСтроки(Результат, Неопределено, Неопределено, Неопределено,
			Результат.Этап, ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
		ЗаписьЖурналаРегистрации("ГКСК.СопоставлениеОплатПоЗаявкам",
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("Этап «%1»: %2", Результат.Этап,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки)));
		
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает одну строку задания: приводит цепочку заказа (один раз за запуск)
// и сопоставляет оплату с заявкой.
//
// Параметры:
//  СтрокаЗадания - Структура - строка задания (Оплата, Заявка, Заказ).
//  НомерСтроки - Число - номер строки в задании (с единицы).
//  ВсегоСтрок - Число - количество строк в задании.
//  СостояниеЗаказов - Соответствие - состояние обработки заказов за запуск.
//  Результат - Структура - результат выполнения задания, см. ВыполнитьЗадание.
//
Процедура ОбработатьСтроку(СтрокаЗадания, НомерСтроки, ВсегоСтрок, СостояниеЗаказов, Результат)
	
	ПривестиЦепочкуЗаказаОднократно(СтрокаЗадания.Заказ, НомерСтроки, ВсегоСтрок, СостояниеЗаказов, Результат);
	
	Результат.Этап = СтрШаблон("Сопоставление оплаты с заявкой (строка %1 из %2)", НомерСтроки, ВсегоСтрок);
	ДлительныеОперации.СообщитьПрогресс(ПрогрессСтроки(НомерСтроки, ВсегоСтрок), Результат.Этап);
	
	СопоставитьОднуОплату(СтрокаЗадания.Оплата, СтрокаЗадания.Заявка);
	Результат.СопоставленоОплат = Результат.СопоставленоОплат + 1;
	
КонецПроцедуры

// Приводит цепочку заказа к детализации расчётов «По заказам» не более одного раза
// за запуск. Повторное обращение к заказу, обработка которого завершилась ошибкой,
// повторяет ту же ошибку без повторной обработки документов.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//  НомерСтроки - Число - номер строки в задании (с единицы).
//  ВсегоСтрок - Число - количество строк в задании.
//  СостояниеЗаказов - Соответствие - состояние обработки заказов за запуск:
//   ключ - заказ поставщику, значение - Структура (Успешно, ТекстОшибки).
//  Результат - Структура - результат выполнения задания, см. ВыполнитьЗадание.
//
Процедура ПривестиЦепочкуЗаказаОднократно(ЗаказСсылка, НомерСтроки, ВсегоСтрок, СостояниеЗаказов, Результат)
	
	Состояние = СостояниеЗаказов.Получить(ЗаказСсылка);
	Если Состояние <> Неопределено Тогда
		Если НЕ Состояние.Успешно Тогда
			ВызватьИсключение СтрШаблон(
				"Договор по заказу %1 не приведён из-за ошибки в предыдущей строке: %2",
				Строка(ЗаказСсылка), Состояние.ТекстОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Состояние = Новый Структура;
	Состояние.Вставить("Успешно", Ложь);
	Состояние.Вставить("ТекстОшибки", "");
	СостояниеЗаказов.Вставить(ЗаказСсылка, Состояние);
	
	Попытка
		
		Результат.Этап = СтрШаблон(
			"Приведение договора к детализации «По заказам» (строка %1 из %2, заказ %3)",
			НомерСтроки, ВсегоСтрок, Строка(ЗаказСсылка));
		ДлительныеОперации.СообщитьПрогресс(ПрогрессСтроки(НомерСтроки, ВсегоСтрок), Результат.Этап);
		
		Если ПривестиЦепочкуЗаказа(ЗаказСсылка) Тогда
			Результат.ПриведениеВыполнено = Истина;
		КонецЕсли;
		
		Состояние.Успешно = Истина;
		
	Исключение
		Состояние.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Приводит договор заказа к детализации расчётов «По заказам» и перезаполняет
// связанные документы. Если договор уже приведён, ничего не делает.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//
// Возвращаемое значение:
//  Булево - Истина, если документы цепочки были распроведены и перезаполнены.
//
Функция ПривестиЦепочкуЗаказа(ЗаказСсылка)
	
	ДоговорСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Договор");
	Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
		ВызватьИсключение СтрШаблон(
			"Заказ поставщику %1: не заполнен договор.", Строка(ЗаказСсылка));
	КонецЕсли;
	
	ПорядокРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "ПорядокРасчетов");
	Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Цепочка = СобратьЦепочкуПоЗаказу(ЗаказСсылка, ДоговорСсылка);
	
	РаспровестиДокументы(Цепочка);
	ПривестиДоговор(ДоговорСсылка);
	ПерезаполнитьЗаказ(ЗаказСсылка, ДоговорСсылка);
	ПерезаполнитьЗаявки(Цепочка);
	ПерезаполнитьОплаты(Цепочка);
	
	Возврат Истина;
	
КонецФункции

// Собирает цепочку документов одного заказа поставщику: заявки по нему
// и оплаты по этим заявкам.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//  ДоговорСсылка - СправочникСсылка.ДоговорыКонтрагентов - договор заказа.
//
// Возвращаемое значение:
//  Структура - цепочка документов. Ключи: Заказ, Договор, Заявки, Оплаты (массивы ссылок),
//  ЗаявкиПоОплате (Соответствие - оплата -> массив заявок).
//
Функция СобратьЦепочкуПоЗаказу(ЗаказСсылка, ДоговорСсылка)
	
	Цепочка = Новый Структура;
	Цепочка.Вставить("Заказ", ЗаказСсылка);
	Цепочка.Вставить("Договор", ДоговорСсылка);
	Цепочка.Вставить("Заявки", Новый Массив);
	Цепочка.Вставить("Оплаты", Новый Массив);
	Цепочка.Вставить("ЗаявкиПоОплате", Новый Соответствие);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Заявка.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
		|ГДЕ
		|	Заявка.ДокументОснование = &Заказ
		|	И НЕ Заявка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цепочка.Заявки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если Цепочка.Заявки.Количество() = 0 Тогда
		Возврат Цепочка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧ.Ссылка КАК Ссылка,
		|	ТЧ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
		|ИЗ
		|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ТЧ
		|ГДЕ
		|	ТЧ.ЗаявкаНаРасходованиеДенежныхСредств В (&Заявки)
		|	И НЕ ТЧ.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Заявки", Цепочка.Заявки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Цепочка.Оплаты.Найти(Выборка.Ссылка) = Неопределено Тогда
			Цепочка.Оплаты.Добавить(Выборка.Ссылка);
		КонецЕсли;
		
		ЗаявкиОплаты = Цепочка.ЗаявкиПоОплате.Получить(Выборка.Ссылка);
		Если ЗаявкиОплаты = Неопределено Тогда
			ЗаявкиОплаты = Новый Массив;
			Цепочка.ЗаявкиПоОплате.Вставить(Выборка.Ссылка, ЗаявкиОплаты);
		КонецЕсли;
		Если ЗаявкиОплаты.Найти(Выборка.Заявка) = Неопределено Тогда
			ЗаявкиОплаты.Добавить(Выборка.Заявка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Цепочка;
	
КонецФункции

// Распроводит документы цепочки: оплаты, заявки, заказ поставщику.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочкуПоЗаказу.
//
Процедура РаспровестиДокументы(Цепочка)
	
	Для Каждого ОплатаСсылка Из Цепочка.Оплаты Цикл
		ОтменитьПроведениеДокумента(ОплатаСсылка);
	КонецЦикла;
	
	Для Каждого ЗаявкаСсылка Из Цепочка.Заявки Цикл
		ОтменитьПроведениеДокумента(ЗаявкаСсылка);
	КонецЦикла;
	
	ОтменитьПроведениеДокумента(Цепочка.Заказ);
	
КонецПроцедуры

// Отменяет проведение документа, если он проведён.
//
// Параметры:
//  Ссылка - ДокументСсылка - документ цепочки.
//
Процедура ОтменитьПроведениеДокумента(Ссылка)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ НЕ Объект.Проведен Тогда
		Возврат;
	КонецЕсли;
	Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
КонецПроцедуры

// Устанавливает договору детализацию расчётов «По заказам».
//
// Параметры:
//  ДоговорСсылка - СправочникСсылка.ДоговорыКонтрагентов - договор заказа.
//
Процедура ПривестиДоговор(ДоговорСсылка)
	
	ДоговорОбъект = ДоговорСсылка.ПолучитьОбъект();
	Если ДоговорОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ДоговорОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
		Возврат;
	КонецЕсли;
	
	ДоговорОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
	ДоговорОбъект.Записать();
	
КонецПроцедуры

// Перезаполняет договор в заказе поставщику и проводит заказ.
//
// При смене детализации расчётов типовой механизм очищает объект расчётов
// (ВзаиморасчетыСервер.ФормаПриИзмененииРеквизитов → ОчиститьОбъектРасчетов),
// а новый объект расчётов подбирается и создаётся уже при проведении документа
// (ОбъектыРасчетовСервер.ПроверитьОбъектыРасчетовПередЗаписью). Если оставить
// ссылку на объект расчётов прежнего договора, проведение падает с ошибкой
// «Не удалось найти объект расчетов для договора ...».
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//  ДоговорСсылка - СправочникСсылка.ДоговорыКонтрагентов - договор заказа.
//
Процедура ПерезаполнитьЗаказ(ЗаказСсылка, ДоговорСсылка)
	
	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
		ВызватьИсключение СтрШаблон(
			"Заказ поставщику %1: не заполнен договор.", Строка(ЗаказСсылка));
	КонецЕсли;
	ЗаказОбъект.Договор = ДоговорСсылка;
	
	// При записи и проведении документа ПорядокРасчетов заполняется только если он пуст
	// (ВзаиморасчетыСервер.ПередЗаписью → ПроверитьЗаполнитьРеквизит), поэтому после смены
	// детализации расчётов договора его нужно проставить явно: иначе заказ остаётся
	// «по договорам», и механизм взаиморасчётов снова подставляет в шапку объект расчётов
	// по договору — а он после смены порядка расчётов уже недействителен.
	ЗаказОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
	
	// Объект расчётов очищается, чтобы механизм взаиморасчётов подобрал или создал объект
	// расчётов по заказу — как это делает типовая форма через ОчиститьОбъектРасчетов.
	ЗаказОбъект.ОбъектРасчетов = Справочники.ОбъектыРасчетов.ПустаяСсылка();
	
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Перезаполняет объекты расчётов в заявках цепочки, приводит договор заявки
// к договору заказа, переводит заявку в статус «К оплате» и проводит заявки.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочкуПоЗаказу.
//
Процедура ПерезаполнитьЗаявки(Цепочка)
	
	Для Каждого ЗаявкаСсылка Из Цепочка.Заявки Цикл
		
		ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
		Если ЗаявкаОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектРасчетов = НайтиОбъектРасчетовПоЗаказу(Цепочка.Заказ, ЗаявкаОбъект.Организация);
		Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
			ВызватьИсключение СтрШаблон(
				"Заявка %1: не найден объект расчётов по заказу поставщику %2.",
				Строка(ЗаявкаСсылка), Строка(Цепочка.Заказ));
		КонецЕсли;
		
		Для Каждого СтрокаТЧ Из ЗаявкаОбъект.РасшифровкаПлатежа Цикл
			СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
		КонецЦикла;
		
		Если ЗаявкаОбъект.Договор <> Цепочка.Договор Тогда
			ЗаявкаОбъект.Договор = Цепочка.Договор;
		КонецЕсли;
		
		// Оплата по заявке проводится только для заявки в статусе «К оплате»
		// (ДенежныеСредстваСервер.ПроверитьЗаявкуНаРасходованиеДенежныхСредств),
		// поэтому после распроведения заявка переводится в этот статус.
		Если ЗаявкаОбъект.Статус <> Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате Тогда
			ЗаявкаОбъект.Статус = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате;
		КонецЕсли;
		
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецПроцедуры

// Перезаполняет объекты расчётов в строках расшифровки платежа оплат цепочки
// и проводит изменившиеся оплаты.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочкуПоЗаказу.
//
Процедура ПерезаполнитьОплаты(Цепочка)
	
	Для Каждого ОплатаСсылка Из Цепочка.Оплаты Цикл
		
		ЗаявкиОплаты = Цепочка.ЗаявкиПоОплате.Получить(ОплатаСсылка);
		Если ЗаявкиОплаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОплатаОбъект = ОплатаСсылка.ПолучитьОбъект();
		Если ОплатаОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектРасчетов = НайтиОбъектРасчетовПоЗаказу(Цепочка.Заказ, ОплатаОбъект.Организация);
		Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
			Продолжить;
		КонецЕсли;
		
		Изменено = Ложь;
		Для Каждого СтрокаТЧ Из ОплатаОбъект.РасшифровкаПлатежа Цикл
			
			ЗаявкаСсылка = СтрокаТЧ.ЗаявкаНаРасходованиеДенежныхСредств;
			Если НЕ ЗначениеЗаполнено(ЗаявкаСсылка) ИЛИ ЗаявкиОплаты.Найти(ЗаявкаСсылка) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТЧ.ОбъектРасчетов <> ОбъектРасчетов Тогда
				СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
				Изменено = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Изменено Тогда
			ОплатаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Сопоставляет одну оплату с заявкой: переводит заявки оплаты в статус «К оплате»,
// устанавливает признак оплаты по заявкам, заявку в шапке и в первой строке
// расшифровки платежа, объект расчётов и статью движения денежных средств
// из договора заявки.
//
// Параметры:
//  ОплатаСсылка - ДокументСсылка.СписаниеБезналичныхДенежныхСредств - оплата.
//  ЗаявкаСсылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - заявка.
//
Процедура СопоставитьОднуОплату(ОплатаСсылка, ЗаявкаСсылка)
	
	ОплатаОбъект = ОплатаСсылка.ПолучитьОбъект();
	Если ОплатаОбъект = Неопределено Тогда
		ВызватьИсключение "Документ оплаты не найден.";
	КонецЕсли;
	
	ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
	Если ЗаявкаОбъект = Неопределено Тогда
		ВызватьИсключение "Заявка не найдена.";
	КонецЕсли;
	
	// Все заявки, на которые ссылается оплата, должны быть в статусе «К оплате»:
	// иначе типовой контроль не даст провести оплату.
	Для Каждого СтрокаТЧ Из ОплатаОбъект.РасшифровкаПлатежа Цикл
		ЗаявкаТЧ = СтрокаТЧ.ЗаявкаНаРасходованиеДенежныхСредств;
		Если ЗначениеЗаполнено(ЗаявкаТЧ) И ЗаявкаТЧ <> ЗаявкаСсылка Тогда
			ОбеспечитьСтатусКОплате(ЗаявкаТЧ);
		КонецЕсли;
	КонецЦикла;
	
	ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(
		ЗаявкаОбъект.ДокументОснование, ОплатаОбъект.Организация);
	Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		ШаблонСообщения = "Не найден объект расчетов для документа-основания заявки %1.";
		ВызватьИсключение СтрШаблон(ШаблонСообщения, Строка(ЗаявкаОбъект.ДокументОснование));
	КонецЕсли;
	
	Если ЗаявкаОбъект.Статус <> Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате Тогда
		ЗаявкаОбъект.Статус = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате;
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	ОплатаОбъект.ОплатаПоЗаявкам = Истина;
	ОплатаОбъект.ЗаявкаНаРасходованиеДенежныхСредств = ЗаявкаСсылка;
	
	Если ОплатаОбъект.РасшифровкаПлатежа.Количество() > 0 Тогда
		СтрокаТЧ = ОплатаОбъект.РасшифровкаПлатежа[0];
		СтрокаТЧ.ЗаявкаНаРасходованиеДенежныхСредств = ЗаявкаСсылка;
		СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
		
		ДоговорЗаявки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "Договор");
		СтатьяДвиженияДенежныхСредств = Неопределено;
		Если ЗначениеЗаполнено(ДоговорЗаявки) Тогда
			СтатьяДвиженияДенежныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ДоговорЗаявки, "СтатьяДвиженияДенежныхСредств");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтатьяДвиженияДенежныхСредств) Тогда
			СтрокаТЧ.СтатьяДвиженияДенежныхСредств = СтатьяДвиженияДенежныхСредств;
		КонецЕсли;
	КонецЕсли;
	
	ОплатаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Переводит заявку в статус «К оплате», если она в другом статусе.
//
// Параметры:
//  ЗаявкаСсылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - заявка.
//
Процедура ОбеспечитьСтатусКОплате(ЗаявкаСсылка)
	
	Статус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "Статус");
	Если Статус = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате Тогда
		Возврат;
	КонецЕсли;
	
	ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
	Если ЗаявкаОбъект = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Заявка %1 не найдена.", Строка(ЗаявкаСсылка));
	КонецЕсли;
	
	ЗаявкаОбъект.Статус = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.КОплате;
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

// Находит объект расчётов, созданный по заказу поставщику.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//  Организация - СправочникСсылка.Организации - организация оплаты или заявки.
//
// Возвращаемое значение:
//  СправочникСсылка.ОбъектыРасчетов - найденный объект расчётов, либо пустая ссылка.
//
Функция НайтиОбъектРасчетовПоЗаказу(ЗаказСсылка, Организация)
	
	Возврат ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(
		ЗаказСсылка, Организация, Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком);
	
КонецФункции

// Добавляет описание ошибки строки в результат задания.
//
// Параметры:
//  Результат - Структура - результат выполнения задания, см. ВыполнитьЗадание.
//  ОплатаСсылка - ДокументСсылка.СписаниеБезналичныхДенежныхСредств - оплата (может быть Неопределено).
//  ЗаявкаСсылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - заявка (может быть Неопределено).
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику (может быть Неопределено).
//  Этап - Строка - этап обработки, на котором произошла ошибка.
//  ТекстОшибки - Строка - краткое описание ошибки.
//
Процедура ДобавитьОшибкуСтроки(Результат, ОплатаСсылка, ЗаявкаСсылка, ЗаказСсылка, Этап, ТекстОшибки)
	
	Описание = Новый Структура;
	Описание.Вставить("Оплата", ОплатаСсылка);
	Описание.Вставить("Заявка", ЗаявкаСсылка);
	Описание.Вставить("Заказ", ЗаказСсылка);
	Описание.Вставить("Этап", Этап);
	Описание.Вставить("ТекстОшибки", ТекстОшибки);
	Результат.ОшибкиСтрок.Добавить(Описание);
	
	Части = Новый Массив;
	Если ЗначениеЗаполнено(ОплатаСсылка) Тогда
		Части.Добавить(СтрШаблон("оплата %1", Строка(ОплатаСсылка)));
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
		Части.Добавить(СтрШаблон("заявка %1", Строка(ЗаявкаСсылка)));
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Части.Добавить(СтрШаблон("заказ %1", Строка(ЗаказСсылка)));
	КонецЕсли;
	
	Заголовок = "";
	Если Части.Количество() > 0 Тогда
		Заголовок = СтрСоединить(Части, ", ") + ": ";
	КонецЕсли;
	ЭтапТекст = "";
	Если НЕ ПустаяСтрока(Этап) Тогда
		ЭтапТекст = "этап «" + Этап + "»: ";
	КонецЕсли;
	
	Результат.Ошибки.Добавить(Заголовок + ЭтапТекст + ТекстОшибки);
	
КонецПроцедуры

// Возвращает процент выполнения задания для строки.
//
// Параметры:
//  НомерСтроки - Число - номер строки в задании (с единицы).
//  ВсегоСтрок - Число - количество строк в задании.
//
// Возвращаемое значение:
//  Число - процент выполнения (0..99).
//
Функция ПрогрессСтроки(НомерСтроки, ВсегоСтрок)
	
	Если ВсегоСтрок <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Мин(99, Цел(НомерСтроки * 100 / ВсегоСтрок));
	
КонецФункции

#КонецОбласти
