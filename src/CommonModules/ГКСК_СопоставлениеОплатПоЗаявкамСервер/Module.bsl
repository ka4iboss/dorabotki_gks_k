////////////////////////////////////////////////////////////////////////////////
// Сопоставление оплат с заявками на расходование денежных средств.
//
// Перед сопоставлением при необходимости приводит договор заказа поставщику
// к детализации расчётов «По заказам» и перезаполняет связанные документы.

#Область ПрограммныйИнтерфейс

// Подготавливает задание для фонового выполнения: проверяет выделенные строки,
// собирает цепочку «заказ поставщику - заявки - оплаты» и определяет,
// требуется ли приведение договоров к детализации расчётов «По заказам».
//
// Параметры:
//  ДанныеСтрок - Массив из Структура - выделенные строки таблицы:
//   * Оплата - ДокументСсылка.СписаниеБезналичныхДенежныхСредств;
//   * Заявка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств.
//
// Возвращаемое значение:
//  Структура - результат подготовки задания:
//   * Строки - Массив из Структура - строки для сопоставления (Оплата, Заявка, Заказ);
//   * ТребуетсяПриведение - Булево - Истина, если требуется изменить детализацию расчётов;
//   * ОписаниеПриведения - Строка - описание предстоящих действий;
//   * Ошибки - Массив из Строка - ошибки подготовки.
//
Функция ПодготовитьЗадание(ДанныеСтрок) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Строки", Новый Массив);
	Результат.Вставить("ТребуетсяПриведение", Ложь);
	Результат.Вставить("ОписаниеПриведения", "");
	Результат.Вставить("Ошибки", Новый Массив);
	
	Заказы = Новый Массив;
	Договоры = Новый Массив;
	ОбработанныеОплаты = Новый Соответствие;
	
	Для Каждого ДанныеСтроки Из ДанныеСтрок Цикл
		
		ОплатаСсылка = ДанныеСтроки.Оплата;
		ЗаявкаСсылка = ДанныеСтроки.Заявка;
		Если НЕ ЗначениеЗаполнено(ОплатаСсылка) ИЛИ НЕ ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
			Продолжить;
		КонецЕсли;
		Если ОбработанныеОплаты.Получить(ОплатаСсылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеОплаты.Вставить(ОплатаСсылка, Истина);
		
		ЗаказСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "ДокументОснование");
		Если ТипЗнч(ЗаказСсылка) <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Заявка %1: документ-основание не является заказом поставщику.",
				Строка(ЗаявкаСсылка)));
			Продолжить;
		КонецЕсли;
		
		Результат.Строки.Добавить(Новый Структура("Оплата, Заявка, Заказ",
			ОплатаСсылка, ЗаявкаСсылка, ЗаказСсылка));
		
		Если Заказы.Найти(ЗаказСсылка) = Неопределено Тогда
			Заказы.Добавить(ЗаказСсылка);
		КонецЕсли;
		
	КонецЦикла;
	
	ОписаниеДоговоров = Новый Массив;
	Для Каждого ЗаказСсылка Из Заказы Цикл
		
		ДоговорСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Договор");
		Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Заказ поставщику %1: не заполнен договор.", Строка(ЗаказСсылка)));
			Продолжить;
		КонецЕсли;
		
		Если Договоры.Найти(ДоговорСсылка) = Неопределено Тогда
			Договоры.Добавить(ДоговорСсылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ДоговорСсылка Из Договоры Цикл
		ПорядокРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "ПорядокРасчетов");
		Если ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
			Результат.ТребуетсяПриведение = Истина;
			ОписаниеДоговоров.Добавить(Строка(ДоговорСсылка));
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.ТребуетсяПриведение Тогда
		Результат.ОписаниеПриведения =
			"У договоров (" + СтрСоединить(ОписаниеДоговоров, ", ") + ") детализация расчётов отличается от «По заказам»."
			+ Символы.ПС
			+ "Будут распроведены и повторно проведены: заказ поставщику, заявки на расходование денежных средств"
			+ " и оплаты по ним. Затем оплаты будут сопоставлены с заявками."
			+ Символы.ПС + "Продолжить?";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Фоновая процедура: приведение договоров к детализации расчётов «По заказам»
// и сопоставление оплат с заявками.
//
// Параметры:
//  ПараметрыЗадания - Структура - параметры задания:
//   * Строки - Массив из Структура - строки для сопоставления (Оплата, Заявка, Заказ);
//   * ТребуетсяПриведение - Булево - выполнять ли приведение договоров.
//  АдресРезультата - Строка - адрес результата во временном хранилище (формируется БСП).
//
Процедура ВыполнитьЗадание(ПараметрыЗадания, АдресРезультата) Экспорт
	
	Результат = Новый Структура("Ошибки, Этап, ПриведениеВыполнено, СопоставленоОплат");
	Результат.Ошибки = Новый Массив;
	Результат.Этап = "";
	Результат.ПриведениеВыполнено = Ложь;
	Результат.СопоставленоОплат = 0;
	
	Попытка
		
		Результат.Этап = "Сбор связанных документов";
		ДлительныеОперации.СообщитьПрогресс(5, Результат.Этап);
		Цепочка = СобратьЦепочку(ПараметрыЗадания.Строки);
		
		Если ПараметрыЗадания.ТребуетсяПриведение Тогда
			
			Результат.Этап = "Распроведение документов";
			ДлительныеОперации.СообщитьПрогресс(15, Результат.Этап);
			РаспровестиДокументы(Цепочка);
			
			Результат.Этап = "Изменение детализации расчётов договоров";
			ДлительныеОперации.СообщитьПрогресс(30, Результат.Этап);
			ПривестиДоговоры(Цепочка);
			
			Результат.Этап = "Перезаполнение заказов поставщику";
			ДлительныеОперации.СообщитьПрогресс(45, Результат.Этап);
			ПерезаполнитьЗаказы(Цепочка);
			
			Результат.Этап = "Перезаполнение заявок на расходование денежных средств";
			ДлительныеОперации.СообщитьПрогресс(60, Результат.Этап);
			ПерезаполнитьЗаявки(Цепочка);
			
			Результат.Этап = "Перезаполнение оплат";
			ДлительныеОперации.СообщитьПрогресс(75, Результат.Этап);
			ПерезаполнитьОплаты(Цепочка);
			
			Результат.ПриведениеВыполнено = Истина;
			
		КонецЕсли;
		
		Результат.Этап = "Сопоставление оплат с заявками";
		ДлительныеОперации.СообщитьПрогресс(85, Результат.Этап);
		Результат.СопоставленоОплат = СопоставитьОплаты(Цепочка);
		
		Результат.Этап = "";
		ДлительныеОперации.СообщитьПрогресс(100, "Готово");
		
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки);
		Результат.Ошибки.Добавить(ПредставлениеОшибки);
		ЗаписьЖурналаРегистрации("ГКСК.СопоставлениеОплатПоЗаявкам",
			УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон("Этап «%1»: %2", Результат.Этап, ПредставлениеОшибки));
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает цепочку связанных документов: заказы поставщику, заявки по ним
// и оплаты по этим заявкам, включая оплаты из задания.
//
// Параметры:
//  Строки - Массив из Структура - строки задания (Оплата, Заявка, Заказ).
//
// Возвращаемое значение:
//  Структура - цепочка документов. Ключи: Строки (строки задания), Заказы, Заявки, Оплаты,
//  Договоры (массивы ссылок), ЗаказПоЗаявке (Соответствие - заявка -> заказ поставщику),
//  ЗаявкиПоОплате (Соответствие - оплата -> массив заявок).
//
Функция СобратьЦепочку(Строки)
	
	Цепочка = Новый Структура("Строки, Заказы, Заявки, Оплаты, Договоры, ЗаказПоЗаявке, ЗаявкиПоОплате");
	Цепочка.Строки = Строки;
	Цепочка.Заказы = Новый Массив;
	Цепочка.Заявки = Новый Массив;
	Цепочка.Оплаты = Новый Массив;
	Цепочка.Договоры = Новый Массив;
	Цепочка.ЗаказПоЗаявке = Новый Соответствие;
	Цепочка.ЗаявкиПоОплате = Новый Соответствие;
	
	Для Каждого Строка Из Строки Цикл
		
		Если Цепочка.Заказы.Найти(Строка.Заказ) = Неопределено Тогда
			Цепочка.Заказы.Добавить(Строка.Заказ);
		КонецЕсли;
		Цепочка.ЗаказПоЗаявке.Вставить(Строка.Заявка, Строка.Заказ);
		
		// Оплата из задания обрабатывается всегда, даже если она ещё не связана с заявкой.
		Если Цепочка.Оплаты.Найти(Строка.Оплата) = Неопределено Тогда
			Цепочка.Оплаты.Добавить(Строка.Оплата);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Заявка.Ссылка КАК Ссылка,
		|	Заявка.ДокументОснование КАК Заказ
		|ИЗ
		|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
		|ГДЕ
		|	Заявка.ДокументОснование В (&Заказы)
		|	И НЕ Заявка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Заказы", Цепочка.Заказы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Цепочка.Заявки.Найти(Выборка.Ссылка) = Неопределено Тогда
			Цепочка.Заявки.Добавить(Выборка.Ссылка);
		КонецЕсли;
		Цепочка.ЗаказПоЗаявке.Вставить(Выборка.Ссылка, Выборка.Заказ);
	КонецЦикла;
	
	Если Цепочка.Заявки.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ТЧ.Ссылка КАК Ссылка,
			|	ТЧ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
			|ИЗ
			|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ТЧ
			|ГДЕ
			|	ТЧ.ЗаявкаНаРасходованиеДенежныхСредств В (&Заявки)
			|	И НЕ ТЧ.Ссылка.ПометкаУдаления";
		Запрос.УстановитьПараметр("Заявки", Цепочка.Заявки);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Цепочка.Оплаты.Найти(Выборка.Ссылка) = Неопределено Тогда
				Цепочка.Оплаты.Добавить(Выборка.Ссылка);
			КонецЕсли;
			ЗаявкиОплаты = Цепочка.ЗаявкиПоОплате.Получить(Выборка.Ссылка);
			Если ЗаявкиОплаты = Неопределено Тогда
				ЗаявкиОплаты = Новый Массив;
				Цепочка.ЗаявкиПоОплате.Вставить(Выборка.Ссылка, ЗаявкиОплаты);
			КонецЕсли;
			Если ЗаявкиОплаты.Найти(Выборка.Заявка) = Неопределено Тогда
				ЗаявкиОплаты.Добавить(Выборка.Заявка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ЗаказСсылка Из Цепочка.Заказы Цикл
		ДоговорСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Договор");
		Если ЗначениеЗаполнено(ДоговорСсылка) И Цепочка.Договоры.Найти(ДоговорСсылка) = Неопределено Тогда
			Цепочка.Договоры.Добавить(ДоговорСсылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Цепочка;
	
КонецФункции

// Распроводит все документы цепочки: оплаты, заявки, заказы поставщику.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочку.
//
Процедура РаспровестиДокументы(Цепочка)
	
	Коллекции = Новый Массив;
	Коллекции.Добавить(Цепочка.Оплаты);
	Коллекции.Добавить(Цепочка.Заявки);
	Коллекции.Добавить(Цепочка.Заказы);
	
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Ссылка Из Коллекция Цикл
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено ИЛИ НЕ Объект.Проведен Тогда
				Продолжить;
			КонецЕсли;
			Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает договорам детализацию расчётов «По заказам».
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочку.
//
Процедура ПривестиДоговоры(Цепочка)
	
	Для Каждого ДоговорСсылка Из Цепочка.Договоры Цикл
		
		ДоговорОбъект = ДоговорСсылка.ПолучитьОбъект();
		Если ДоговорОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ДоговорОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам Тогда
			Продолжить;
		КонецЕсли;
		
		ДоговорОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		ДоговорОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Перезаполняет договор в заказах поставщику и проводит заказы.
//
// При смене детализации расчётов типовой механизм очищает объект расчётов
// (ВзаиморасчетыСервер.ФормаПриИзмененииРеквизитов → ОчиститьОбъектРасчетов),
// а новый объект расчётов подбирается и создаётся уже при проведении документа
// (ОбъектыРасчетовСервер.ПроверитьОбъектыРасчетовПередЗаписью). Если оставить
// ссылку на объект расчётов прежнего договора, проведение падает с ошибкой
// «Не удалось найти объект расчетов для договора ...».
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочку.
//
Процедура ПерезаполнитьЗаказы(Цепочка)
	
	Для Каждого ЗаказСсылка Из Цепочка.Заказы Цикл
		
		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
		Если ЗаказОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДоговорСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Договор");
		Если НЕ ЗначениеЗаполнено(ДоговорСсылка) Тогда
			ВызватьИсключение СтрШаблон(
				"Заказ поставщику %1: не заполнен договор.", Строка(ЗаказСсылка));
		КонецЕсли;
		ЗаказОбъект.Договор = ДоговорСсылка;
		
		// При записи и проведении документа ПорядокРасчетов заполняется только если он пуст
		// (ВзаиморасчетыСервер.ПередЗаписью → ПроверитьЗаполнитьРеквизит), поэтому после смены
		// детализации расчётов договора его нужно проставить явно: иначе заказ остаётся
		// «по договорам», и механизм взаиморасчётов снова подставляет в шапку объект расчётов
		// по договору — а он после смены порядка расчётов уже недействителен.
		ЗаказОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		
		// Объект расчётов очищается, чтобы механизм взаиморасчётов подобрал или создал объект
		// расчётов по заказу — как это делает типовая форма через ОчиститьОбъектРасчетов.
		ЗаказОбъект.ОбъектРасчетов = Справочники.ОбъектыРасчетов.ПустаяСсылка();
		
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецПроцедуры

// Перезаполняет объекты расчётов в заявках на расходование денежных средств
// и проводит заявки.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочку.
//
Процедура ПерезаполнитьЗаявки(Цепочка)
	
	Для Каждого ЗаявкаСсылка Из Цепочка.Заявки Цикл
		
		ЗаказСсылка = Цепочка.ЗаказПоЗаявке.Получить(ЗаявкаСсылка);
		Если ЗаказСсылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
		Если ЗаявкаОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектРасчетов = НайтиОбъектРасчетовПоЗаказу(ЗаказСсылка, ЗаявкаОбъект.Организация);
		Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
			ВызватьИсключение СтрШаблон(
				"Заявка %1: не найден объект расчётов по заказу поставщику %2.",
				Строка(ЗаявкаСсылка), Строка(ЗаказСсылка));
		КонецЕсли;
		
		Для Каждого СтрокаТЧ Из ЗаявкаОбъект.РасшифровкаПлатежа Цикл
			СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
		КонецЦикла;
		
		ДоговорЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Договор");
		Если ЗаявкаОбъект.Договор <> ДоговорЗаказа Тогда
			ЗаявкаОбъект.Договор = ДоговорЗаказа;
		КонецЕсли;
		
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецПроцедуры

// Перезаполняет объекты расчётов в строках расшифровки платежа оплат,
// связанных с заявками цепочки, и проводит изменившиеся оплаты.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочку.
//
Процедура ПерезаполнитьОплаты(Цепочка)
	
	Для Каждого ОплатаСсылка Из Цепочка.Оплаты Цикл
		
		ЗаявкиОплаты = Цепочка.ЗаявкиПоОплате.Получить(ОплатаСсылка);
		Если ЗаявкиОплаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОплатаОбъект = ОплатаСсылка.ПолучитьОбъект();
		Если ОплатаОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Изменено = Ложь;
		Для Каждого СтрокаТЧ Из ОплатаОбъект.РасшифровкаПлатежа Цикл
			
			ЗаявкаСсылка = СтрокаТЧ.ЗаявкаНаРасходованиеДенежныхСредств;
			Если НЕ ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаказСсылка = Цепочка.ЗаказПоЗаявке.Получить(ЗаявкаСсылка);
			Если ЗаказСсылка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектРасчетов = НайтиОбъектРасчетовПоЗаказу(ЗаказСсылка, ОплатаОбъект.Организация);
			Если ЗначениеЗаполнено(ОбъектРасчетов) И СтрокаТЧ.ОбъектРасчетов <> ОбъектРасчетов Тогда
				СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
				Изменено = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Изменено Тогда
			ОплатаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Сопоставляет оплаты из задания с заявками.
//
// Параметры:
//  Цепочка - Структура - цепочка документов, см. СобратьЦепочку.
//
// Возвращаемое значение:
//  Число - количество сопоставленных оплат.
//
Функция СопоставитьОплаты(Цепочка)
	
	ОбработанныеОплаты = Новый Соответствие;
	Сопоставлено = 0;
	
	Для Каждого Строка Из Цепочка.Строки Цикл
		
		Если ОбработанныеОплаты.Получить(Строка.Оплата) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеОплаты.Вставить(Строка.Оплата, Истина);
		
		СопоставитьОднуОплату(Строка.Оплата, Строка.Заявка);
		Сопоставлено = Сопоставлено + 1;
		
	КонецЦикла;
	
	Возврат Сопоставлено;
	
КонецФункции

// Сопоставляет одну оплату с заявкой: устанавливает признак оплаты по заявкам,
// заявку в шапке и в первой строке расшифровки платежа, объект расчётов
// и статью движения денежных средств из договора заявки.
//
// Параметры:
//  ОплатаСсылка - ДокументСсылка.СписаниеБезналичныхДенежныхСредств - оплата.
//  ЗаявкаСсылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - заявка.
//
Процедура СопоставитьОднуОплату(ОплатаСсылка, ЗаявкаСсылка)
	
	ОплатаОбъект = ОплатаСсылка.ПолучитьОбъект();
	Если ОплатаОбъект = Неопределено Тогда
		ВызватьИсключение "Документ оплаты не найден.";
	КонецЕсли;
	
	ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
	Если ЗаявкаОбъект = Неопределено Тогда
		ВызватьИсключение "Заявка не найдена.";
	КонецЕсли;
	
	ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(
		ЗаявкаОбъект.ДокументОснование, ОплатаОбъект.Организация);
	Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		ШаблонСообщения = "Не найден объект расчетов для документа-основания заявки %1.";
		ВызватьИсключение СтрШаблон(ШаблонСообщения, Строка(ЗаявкаОбъект.ДокументОснование));
	КонецЕсли;
	
	ОплатаОбъект.ОплатаПоЗаявкам = Истина;
	ОплатаОбъект.ЗаявкаНаРасходованиеДенежныхСредств = ЗаявкаСсылка;
	
	Если ОплатаОбъект.РасшифровкаПлатежа.Количество() > 0 Тогда
		СтрокаТЧ = ОплатаОбъект.РасшифровкаПлатежа[0];
		СтрокаТЧ.ЗаявкаНаРасходованиеДенежныхСредств = ЗаявкаСсылка;
		СтрокаТЧ.ОбъектРасчетов = ОбъектРасчетов;
		
		ДоговорЗаявки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаявкаСсылка, "Договор");
		СтатьяДвиженияДенежныхСредств = Неопределено;
		Если ЗначениеЗаполнено(ДоговорЗаявки) Тогда
			СтатьяДвиженияДенежныхСредств = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				ДоговорЗаявки, "СтатьяДвиженияДенежныхСредств");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтатьяДвиженияДенежныхСредств) Тогда
			СтрокаТЧ.СтатьяДвиженияДенежныхСредств = СтатьяДвиженияДенежныхСредств;
		КонецЕсли;
	КонецЕсли;
	
	ОплатаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Находит объект расчётов, созданный по заказу поставщику.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//  Организация - СправочникСсылка.Организации - организация оплаты или заявки.
//
// Возвращаемое значение:
//  СправочникСсылка.ОбъектыРасчетов - найденный объект расчётов, либо пустая ссылка.
//
Функция НайтиОбъектРасчетовПоЗаказу(ЗаказСсылка, Организация)
	
	Возврат ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(
		ЗаказСсылка, Организация, Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком);
	
КонецФункции

#КонецОбласти
