#Область ПрограммныйИнтерфейс

// Анализирует тексты модулей и заполняет регистр сведений "ППГД_ПоляВЗапросахМодулей":
// какие поля объектов метаданных используются в текстах запросов модулей.
// Предназначена для выполнения в фоновом задании длительной операции.
//
// Параметры:
//  КаталогМодулей - Строка - каталог с текстами модулей (например, каталог выгрузки
//                   Конфигуратора в пакетном режиме с ключом -Module). Каталог обходится
//                   рекурсивно, обрабатываются файлы с расширениями bsl и txt;
//  ОчищатьРегистр - Булево - Истина: перед анализом очистить регистр сведений.
//
// Возвращаемое значение:
//  Структура - итоги анализа:
//   * Модулей            - Число - количество обработанных файлов модулей;
//   * Запросов           - Число - количество разобранных текстов запросов;
//   * ПропущенноЗапросов - Число - количество запросов, текст которых собрать не удалось;
//   * Полей              - Число - количество записей, записанных в регистр;
//   * ФайловНайдено      - Число - количество найденных файлов с текстами модулей;
//   * Причина            - Строка - причина, по которой анализ не выполнен (пустая строка, если анализ выполнен).
//
Функция ПроанализироватьМодули(Знач КаталогМодулей, Знач ОчищатьРегистр = Истина) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Модулей", 0);
	Результат.Вставить("Запросов", 0);
	Результат.Вставить("ПропущенноЗапросов", 0);
	Результат.Вставить("Полей", 0);
	Результат.Вставить("ФайловНайдено", 0);
	Результат.Вставить("Причина", "");
	
	КаталогМодулей = НормализоватьПутьКаталога(КаталогМодулей);
	Если ПустаяСтрока(КаталогМодулей) Тогда
		Результат.Причина = НСтр("ru = 'Каталог с текстами модулей не указан.'");
		Возврат Результат;
	КонецЕсли;
	
	ЭлементыВКорне = ЭлементыКаталога(КаталогМодулей);
	Если ЭлементыВКорне = Неопределено Или ЭлементыВКорне.Количество() = 0 Тогда
		Результат.Причина = СтрШаблон(
			НСтр("ru = 'Каталог не найден или недоступен для программы: %1. Обратите внимание: фоновое задание выполняется на сервере 1С, которому не видны отображенные сетевые диски (R:, Z: и т.п.), а права на каталог проверяются для учетной записи сервера. Укажите путь UNC (\\сервер\ресурс\каталог) либо локальный путь сервера.'"),
			КаталогМодулей);
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Анализ запросов модулей.Каталог'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			Результат.Причина);
		Возврат Результат;
	КонецЕсли;
	
	ФайлыМодулей = ФайлыТекстовМодулей(КаталогМодулей);
	ВсегоФайлов = ФайлыМодулей.Количество();
	Результат.ФайловНайдено = ВсегоФайлов;
	
	Если ВсегоФайлов = 0 Тогда
		Результат.Причина = СтрШаблон(
			НСтр("ru = 'В каталоге %1 не найдено ни одного файла с текстами модулей (bsl, txt). Убедитесь, что выгрузка сделана с ключом -Module.'"),
			КаталогМодулей);
		Возврат Результат;
	КонецЕсли;
	
	Если ОчищатьРегистр Тогда
		ОчиститьРегистрПолей();
	КонецЕсли;
	
	ОбработаноФайлов = 0;
	ПоследнийОтчет = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ПоляРегистра = Новый Соответствие;
	ОшибкиЧтения = Новый Массив;
	
	Для Каждого ПутьКФайлу Из ФайлыМодулей Цикл
		
		ТекстМодуля = ПрочитатьТекстФайла(ПутьКФайлу);
		Если ТекстМодуля = Неопределено Тогда
			ОшибкиЧтения.Добавить(ПутьКФайлу);
			Продолжить;
		КонецЕсли;
		
		ПоляЗапросовМодуля(ТекстМодуля, ОтносительныйПутьМодуля(ПутьКФайлу, КаталогМодулей), ПоляРегистра, Результат);
		
		Результат.Модулей = Результат.Модулей + 1;
		ОбработаноФайлов = ОбработаноФайлов + 1;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ПоследнийОтчет > 3000 Тогда
			СообщитьПрогрессАнализа(ОбработаноФайлов, ВсегоФайлов, "Анализ модулей: обработано файлов");
			ПоследнийОтчет = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьПоляВРегистр(ПоляРегистра, Результат);
	
	Для Каждого ПутьКФайлу Из ОшибкиЧтения Цикл
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Анализ запросов модулей.Чтение файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон(НСтр("ru = 'Не удалось прочитать файл: %1'", ОбщегоНазначения.КодОсновногоЯзыка()), ПутьКФайлу));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Диагностика каталога с текстами модулей: показывает, что именно видит процесс, в котором
// выполняется анализ (сервер 1С), и сколько в каталоге файлов модулей. Позволяет отличить
// недоступный для программы каталог от выгрузки без текстов модулей.
//
// Параметры:
//  КаталогМодулей - Строка - каталог с текстами модулей.
//
// Возвращаемое значение:
//  Структура - результаты проверки:
//   * Каталог         - Строка - нормализованный путь к каталогу;
//   * Доступен        - Булево - удалось ли прочитать каталог;
//   * ЭлементовВКорне - Число - количество элементов в корне каталога;
//   * КаталоговВКорне - Число - количество подкаталогов в корне;
//   * ФайловВКорне    - Число - количество файлов в корне;
//   * ФайловМодулей   - Число - количество найденных файлов bsl и txt во всем каталоге;
//   * НеПрочитаноКаталогов - Число - количество каталогов, которые не удалось прочитать при обходе;
//   * ПримерыФайлов   - Строка - первые встреченные файлы с их расширением и признаком ЭтоФайл;
//   * Примеры         - Строка - первые элементы корня с указанием вида;
//   * ТекстОшибки     - Строка - причина, по которой каталог недоступен.
//
Функция ПроверитьДоступностьКаталога(Знач КаталогМодулей) Экспорт
	
	КаталогМодулей = НормализоватьПутьКаталога(КаталогМодулей);
	
	Результат = Новый Структура;
	Результат.Вставить("Каталог", КаталогМодулей);
	Результат.Вставить("Доступен", Ложь);
	Результат.Вставить("ЭлементовВКорне", 0);
	Результат.Вставить("КаталоговВКорне", 0);
	Результат.Вставить("ФайловВКорне", 0);
	Результат.Вставить("ФайловМодулей", 0);
	Результат.Вставить("Примеры", "");
	Результат.Вставить("НеПрочитаноКаталогов", 0);
	Результат.Вставить("ПримерыФайлов", "");
	Результат.Вставить("ТекстОшибки", "");
	
	Если ПустаяСтрока(КаталогМодулей) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Каталог не указан.'");
		Возврат Результат;
	КонецЕсли;
	
	ЭлементыВКорне = ЭлементыКаталога(КаталогМодулей);
	Если ЭлементыВКорне = Неопределено Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Каталог недоступен: прочитать его не удалось.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Доступен = Истина;
	Результат.ЭлементовВКорне = ЭлементыВКорне.Количество();
	
	Примеры = Новый Массив;
	Для Каждого ЭлементВКорне Из ЭлементыВКорне Цикл
		Если ЭлементВКорне.ЭтоКаталог() Тогда
			Результат.КаталоговВКорне = Результат.КаталоговВКорне + 1;
			ВидЭлемента = НСтр("ru = 'каталог'");
		Иначе
			Результат.ФайловВКорне = Результат.ФайловВКорне + 1;
			ВидЭлемента = НСтр("ru = 'файл'");
		КонецЕсли;
		Если Примеры.Количество() < 10 Тогда
			Примеры.Добавить(СтрШаблон("%1 (%2)", ЭлементВКорне.Имя, ВидЭлемента));
		КонецЕсли;
	КонецЦикла;
	Результат.Примеры = СтрСоединить(Примеры, ", ");
	
	ДиагностикаОбхода = Новый Структура;
	ДиагностикаОбхода.Вставить("НеПрочитаноКаталогов", 0);
	ДиагностикаОбхода.Вставить("ПримерыФайлов", Новый Массив);
	
	Результат.ФайловМодулей = ФайлыТекстовМодулей(КаталогМодулей, ДиагностикаОбхода).Количество();
	Результат.НеПрочитаноКаталогов = ДиагностикаОбхода.НеПрочитаноКаталогов;
	Результат.ПримерыФайлов = СтрСоединить(ДиагностикаОбхода.ПримерыФайлов, "; ");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Анализирует текст одного модуля и накапливает используемые в запросах поля.
//
// Параметры:
//  ТекстМодуля  - Строка - текст модуля;
//  ИмяМодуля    - Строка - путь модуля относительно корня выгрузки;
//  ПоляРегистра - Соответствие из КлючИЗначение - накопитель полей;
//  Результат    - Структура - счетчики анализа.
//
Процедура ПоляЗапросовМодуля(Знач ТекстМодуля, Знач ИмяМодуля, ПоляРегистра, Результат)
	
	ТекстМодуляБезКомментариев = ТекстБезКомментариев(ТекстМодуля);
	
	Для Каждого Выражение Из ВыраженияЗапросов(ТекстМодуляБезКомментариев) Цикл
		
		ТекстЗапроса = ТекстЗапросаИзВыражения(Выражение, ТекстМодуляБезКомментариев);
		Если ТекстЗапроса = Неопределено Или ПустаяСтрока(ТекстЗапроса) Тогда
			Результат.ПропущенноЗапросов = Результат.ПропущенноЗапросов + 1;
			Продолжить;
		КонецЕсли;
		
		Результат.Запросов = Результат.Запросов + 1;
		ПоляТекстаЗапроса(ТекстЗапроса, ИмяМодуля, ПоляРегистра);
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает список файлов с текстами модулей в каталоге.
// Обход выполняется вручную (по одному каталогу за вызов НайтиФайлы), так как
// рекурсивный поиск с маской не гарантирует полный обход большого дерева выгрузки.
// Признак файла модуля определяется по окончанию имени (bsl, txt), а не только по
// свойству Расширение, значение которого у объекта Файл может отличаться.
//
// Параметры:
//  КаталогМодулей - Строка - каталог для поиска;
//  Диагностика    - Структура, Неопределено - необязательный приемник диагностики:
//                   * НеПрочитаноКаталогов - Число - количество каталогов, которые не удалось прочитать;
//                   * ПримерыФайлов        - Массив из Строка - первые встреченные файлы с их
//                                            расширением и признаком ЭтоФайл.
//
// Возвращаемое значение:
//  Массив из Строка - полные пути к файлам с расширением bsl или txt.
//
Функция ФайлыТекстовМодулей(Знач КаталогМодулей, Диагностика = Неопределено)
	
	ФайлыМодулей = Новый Массив;
	КаталогиДляОбхода = Новый Массив;
	КаталогиДляОбхода.Добавить(КаталогМодулей);
	
	Пока КаталогиДляОбхода.Количество() > 0 Цикл
		
		ИндексКаталога = КаталогиДляОбхода.Количество() - 1;
		ТекущийКаталог = КаталогиДляОбхода[ИндексКаталога];
		КаталогиДляОбхода.Удалить(ИндексКаталога);
		
		ЭлементыТекущегоКаталога = ЭлементыКаталога(ТекущийКаталог);
		Если ЭлементыТекущегоКаталога = Неопределено Тогда
			Если Диагностика <> Неопределено Тогда
				Диагностика.НеПрочитаноКаталогов = Диагностика.НеПрочитаноКаталогов + 1;
			КонецЕсли;
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Анализ запросов модулей.Обход каталога'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				СтрШаблон(НСтр("ru = 'Не удалось прочитать каталог: %1'", ОбщегоНазначения.КодОсновногоЯзыка()), ТекущийКаталог));
			Продолжить;
		КонецЕсли;
		
		Для Каждого ЭлементТекущегоКаталога Из ЭлементыТекущегоКаталога Цикл
			
			Если ЭлементТекущегоКаталога.ЭтоКаталог() Тогда
				КаталогиДляОбхода.Добавить(ТекущийКаталог + "\" + ЭлементТекущегоКаталога.Имя);
				Продолжить;
			КонецЕсли;
			
			ИмяФайла = ЭлементТекущегоКаталога.Имя;
			Расширение = НРег(ЭлементТекущегоКаталога.Расширение);
			
			Если Диагностика <> Неопределено И Диагностика.ПримерыФайлов.Количество() < 3 Тогда
				Диагностика.ПримерыФайлов.Добавить(СтрШаблон("%1: расширение '%2', ЭтоФайл=%3",
					ИмяФайла, Расширение,
					?(ЭлементТекущегоКаталога.ЭтоФайл(), НСтр("ru = 'да'"), НСтр("ru = 'нет'"))));
			КонецЕсли;
			
			ИмяФайлаНРег = НРег(ИмяФайла);
			Если СтрЗаканчиваетсяНа(ИмяФайлаНРег, ".bsl") Или СтрЗаканчиваетсяНа(ИмяФайлаНРег, ".txt")
				Или Расширение = "bsl" Или Расширение = "txt" Тогда
				ФайлыМодулей.Добавить(ЭлементТекущегоКаталога.ПолноеИмя);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ФайлыМодулей;
	
КонецФункции

// Приводит введенный пользователем путь к каталогу к виду, пригодному для работы с файлами.
// Убирает кавычки и пробелы по краям, отбрасывает завершающие разделители каталогов.
//
// Параметры:
//  ПутьКаталога - Строка - путь, введенный пользователем.
//
// Возвращаемое значение:
//  Строка - нормализованный путь.
//
Функция НормализоватьПутьКаталога(Знач ПутьКаталога)
	
	Путь = СокрЛП(ПутьКаталога);
	Путь = СокрЛП(СтрЗаменить(Путь, """", ""));
	
	Пока Прав(Путь, 1) = "\" Или Прав(Путь, 1) = "/" Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	
	Возврат СокрЛП(Путь);
	
КонецФункции

// Возвращает элементы одного каталога без обхода подкаталогов.
//
// Параметры:
//  ПутьКаталога - Строка - путь к каталогу.
//
// Возвращаемое значение:
//  Массив из Файл, Неопределено - элементы каталога или Неопределено, если каталог недоступен.
//
Функция ЭлементыКаталога(Знач ПутьКаталога)
	
	Попытка
		Возврат НайтиФайлы(ПутьКаталога, "*", Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Читает текст файла модуля.
//
// Параметры:
//  ПутьКФайлу - Строка - полный путь к файлу.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст файла или Неопределено, если файл прочитать не удалось.
//
Функция ПрочитатьТекстФайла(Знач ПутьКФайлу)
	
	Текст = ПрочитатьФайлВКодировке(ПутьКФайлу, КодировкаТекста.UTF8);
	Если Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Выгрузка конфигурации делается в UTF-8. Если кириллицы в тексте нет, значит файл записан
	// в ANSI: байты кириллицы в UTF-8 не декодируются и превращаются в мусор, из-за чего имена
	// объектов и полей перестают находиться. Для чисто английских модулей перечитывание
	// безвредно - ASCII в обеих кодировках совпадает.
	Если Не ЕстьКириллица(Текст) Тогда
		ТекстВAnsi = ПрочитатьФайлВКодировке(ПутьКФайлу, КодировкаТекста.ANSI);
		Если ТекстВAnsi <> Неопределено И ЕстьКириллица(ТекстВAnsi) Тогда
			Возврат ТекстВAnsi;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Читает текстовый файл в указанной кодировке.
//
// Параметры:
//  ПутьКФайлу - Строка - полный путь к файлу;
//  Кодировка  - КодировкаТекста - кодировка чтения.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст файла или Неопределено, если прочитать файл не удалось.
//
Функция ПрочитатьФайлВКодировке(Знач ПутьКФайлу, Знач Кодировка)
	
	Текст = Новый ТекстовыйДокумент;
	Попытка
		Текст.Прочитать(ПутьКФайлу, Кодировка);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Текст.ПолучитьТекст();
	
КонецФункции

// Проверяет, есть ли в тексте хотя бы одна буква кириллицы.
//
// Параметры:
//  Текст - Строка - проверяемый текст.
//
// Возвращаемое значение:
//  Булево - Истина, если кириллица найдена.
//
Функция ЕстьКириллица(Знач Текст)
	
	Возврат СтрНайтиПоРегулярномуВыражению(Текст, "[А-Яа-яЁё]").НачальнаяПозиция > 0;
	
КонецФункции

// Возвращает путь модуля относительно корня выгрузки, с прямыми слешами.
// Путь используется как признак того, какому объекту метаданных принадлежит модуль:
// например, "Documents/ЗаказПокупателя/Forms/ФормаДокумента/Ext/Form/Module.bsl".
//
// Параметры:
//  ПутьКФайлу     - Строка - полный путь к файлу модуля;
//  КаталогМодулей - Строка - корневой каталог выгрузки.
//
// Возвращаемое значение:
//  Строка - путь модуля относительно корня выгрузки.
//
Функция ОтносительныйПутьМодуля(Знач ПутьКФайлу, Знач КаталогМодулей)
	
	ОтносительныйПуть = ПутьКФайлу;
	Если СтрНачинаетсяС(НРег(ОтносительныйПуть), НРег(КаталогМодулей)) Тогда
		ОтносительныйПуть = Сред(ОтносительныйПуть, СтрДлина(КаталогМодулей) + 1);
	КонецЕсли;
	
	ОтносительныйПуть = СтрЗаменить(ОтносительныйПуть, "\", "/");
	Пока СтрНачинаетсяС(ОтносительныйПуть, "/") Цикл
		ОтносительныйПуть = Сред(ОтносительныйПуть, 2);
	КонецЦикла;
	
	Возврат ОтносительныйПуть;
	
КонецФункции

// Очищает регистр сведений с полями запросов.
//
Процедура ОчиститьРегистрПолей()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Поля.Метаданные КАК Метаданные,
		|	Поля.Поле КАК Поле
		|ИЗ
		|	РегистрСведений.ППГД_ПоляВЗапросахМодулей КАК Поля");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ППГД_ПоляВЗапросахМодулей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Метаданные.Установить(Выборка.Метаданные);
		НаборЗаписей.Отбор.Поле.Установить(Выборка.Поле);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Записывает накопленные поля в регистр сведений порциями.
//
// Параметры:
//  ПоляРегистра - Соответствие из КлючИЗначение - накопитель полей;
//  Результат    - Структура - счетчики анализа.
//
Процедура ЗаписатьПоляВРегистр(ПоляРегистра, Результат)
	
	НаборЗаписей = РегистрыСведений.ППГД_ПоляВЗапросахМодулей.СоздатьНаборЗаписей();
	ЗаписейВНаборе = 0;
	
	Для Каждого КлючИЗначение Из ПоляРегистра Цикл
		
		ПолеЗапроса = КлючИЗначение.Значение;
		
		Запись = НаборЗаписей.Добавить();
		Запись.Метаданные = ПолеЗапроса.Метаданные;
		Запись.Поле = ПолеЗапроса.Поле;
		Запись.КоличествоЗапросов = ПолеЗапроса.КоличествоЗапросов;
		Запись.СписокМодулей = СтрСоединить(ПолеЗапроса.Модули, "; ");
		
		ЗаписейВНаборе = ЗаписейВНаборе + 1;
		Результат.Полей = Результат.Полей + 1;
		
		Если ЗаписейВНаборе >= 500 Тогда
			ЗаписатьНаборЗаписей(НаборЗаписей);
			НаборЗаписей = РегистрыСведений.ППГД_ПоляВЗапросахМодулей.СоздатьНаборЗаписей();
			ЗаписейВНаборе = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗаписейВНаборе > 0 Тогда
		ЗаписатьНаборЗаписей(НаборЗаписей);
	КонецЕсли;
	
КонецПроцедуры

// Записывает набор записей регистра. Если набор не записывается целиком (например, из-за
// невидимого дублирования ключевых полей), записи пишутся по одной - так длительный анализ
// не теряет уже собранный результат.
//
// Параметры:
//  НаборЗаписей - РегистрСведенийНаборЗаписей.ППГД_ПоляВЗапросахМодулей - записываемый набор записей.
//
Процедура ЗаписатьНаборЗаписей(НаборЗаписей)
	
	Попытка
		НаборЗаписей.Записать();
		Возврат;
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Анализ запросов модулей.Запись регистра'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			ОписаниеОшибки());
	КонецПопытки;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		ЕдиничныйНабор = РегистрыСведений.ППГД_ПоляВЗапросахМодулей.СоздатьНаборЗаписей();
		ЕдиничныйНабор.Отбор.Метаданные.Установить(Запись.Метаданные);
		ЕдиничныйНабор.Отбор.Поле.Установить(Запись.Поле);
		НоваяЗапись = ЕдиничныйНабор.Добавить();
		НоваяЗапись.КоличествоЗапросов = Запись.КоличествоЗапросов;
		НоваяЗапись.СписокМодулей = Запись.СписокМодулей;
		ЕдиничныйНабор.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Накапливает поле объекта метаданных, используемое в запросе модуля.
//
// Параметры:
//  ПолноеИмяМетаданного - Строка - полное имя объекта метаданных;
//  Поле                 - Строка - имя поля;
//  ИмяМодуля            - Строка - путь модуля относительно корня выгрузки, в котором найдено поле;
//  ПоляРегистра         - Соответствие из КлючИЗначение - накопитель полей.
//
Процедура ЗаписатьПоле(Знач ПолноеИмяМетаданного, Знач Поле, Знач ИмяМодуля, ПоляРегистра)
	
	ПолноеИмяМетаданного = СокрЛП(ПолноеИмяМетаданного);
	Поле = СокрЛП(Поле);
	Если ПустаяСтрока(ПолноеИмяМетаданного) Или ПустаяСтрока(Поле) Тогда
		Возврат;
	КонецЕсли;
	
	// Ключ нормализован по регистру символов и конечным пробелам: при записи в регистр платформа
	// сравнивает строки именно так, поэтому имена, различающиеся только этим, обязаны попадать
	// в одну запись - иначе набор записей не запишется с ошибкой о дублировании ключевых полей.
	Ключ = ВРег(ПолноеИмяМетаданного) + "|" + ВРег(Поле);
	ПолеЗапроса = ПоляРегистра.Получить(Ключ);
	
	Если ПолеЗапроса = Неопределено Тогда
		ПолеЗапроса = Новый Структура;
		ПолеЗапроса.Вставить("Метаданные", ПолноеИмяМетаданного);
		ПолеЗапроса.Вставить("Поле", Поле);
		ПолеЗапроса.Вставить("КоличествоЗапросов", 0);
		ПолеЗапроса.Вставить("Модули", Новый Массив);
		ПоляРегистра.Вставить(Ключ, ПолеЗапроса);
	КонецЕсли;
	
	ПолеЗапроса.КоличествоЗапросов = ПолеЗапроса.КоличествоЗапросов + 1;
	
	Если ПолеЗапроса.Модули.Количество() < 20 И ПолеЗапроса.Модули.Найти(ИмяМодуля) = Неопределено Тогда
		ПолеЗапроса.Модули.Добавить(ИмяМодуля);
	КонецЕсли;
	
КонецПроцедуры

// Выводит прогресс анализа в состояние длительной операции.
//
// Параметры:
//  Обработано   - Число - количество обработанных файлов;
//  Всего        - Число - всего файлов;
//  ШаблонТекста - Строка - шаблон текста прогресса.
//
Процедура СообщитьПрогрессАнализа(Знач Обработано, Знач Всего, Знач ШаблонТекста)
	
	Если Всего = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Процент = Цел(Обработано * 100 / Всего);
	Сообщение = СтрШаблон(НСтр("ru = '%1: %2 из %3'", ОбщегоНазначения.КодОсновногоЯзыка()), ШаблонТекста, Обработано, Всего);
	ДлительныеОперации.СообщитьПрогресс(Процент, Сообщение);
	
КонецПроцедуры

// Удаляет из текста модуля однострочные комментарии, не затрагивая содержимое строковых литералов.
//
// Параметры:
//  Текст - Строка - текст модуля.
//
// Возвращаемое значение:
//  Строка - текст без комментариев.
//
Функция ТекстБезКомментариев(Знач Текст)
	
	СтрокиТекста = СтрРазделить(Текст, Символы.ПС, Ложь);
	Результат = Новый Массив;
	ВСтроке = Ложь;
	
	Для Каждого Строка Из СтрокиТекста Цикл
		Результат.Добавить(СтрокаБезКомментария(Строка, ВСтроке));
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, Символы.ПС);
	
КонецФункции

// Удаляет однострочный комментарий из строки текста модуля.
//
// Параметры:
//  Строка  - Строка - строка текста модуля;
//  ВСтроке - Булево - признак того, что строка началась внутри строкового литерала.
//
// Возвращаемое значение:
//  Строка - строка без комментария.
//
Функция СтрокаБезКомментария(Знач Строка, ВСтроке)
	
	Позиция = 1;
	ДлинаСтроки = СтрДлина(Строка);
	
	Пока Позиция <= ДлинаСтроки Цикл
		
		Символ = Сред(Строка, Позиция, 1);
		
		Если Символ = """" Тогда
			Если ВСтроке И Позиция < ДлинаСтроки И Сред(Строка, Позиция + 1, 1) = """" Тогда
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВСтроке = Не ВСтроке;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		
		Если Не ВСтроке И Символ = "/" И Позиция < ДлинаСтроки И Сред(Строка, Позиция + 1, 1) = "/" Тогда
			Возврат Лев(Строка, Позиция - 1);
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции

// Возвращает выражения, в которых может быть задан текст запроса.
//
// Параметры:
//  ТекстМодуля - Строка - текст модуля без комментариев.
//
// Возвращаемое значение:
//  Массив из Строка - строки выражений: аргумент конструктора "Новый Запрос(...)" и правая часть "....Текст = ...".
//
Функция ВыраженияЗапросов(Знач ТекстМодуля)
	
	Выражения = Новый Массив;
	
	// Конструктор: Новый Запрос("...").
	Для Каждого Найденное Из СтрНайтиВсеПоРегулярномуВыражению(ТекстМодуля, "новый[ \t\n\r]+запрос[ \t\n\r]*[(]", Истина) Цикл
		НачалоСкобки = Найденное.НачальнаяПозиция + Найденное.Длина - 1;
		Выражение = ВыражениеВСкобках(ТекстМодуля, НачалоСкобки);
		Если Не ПустаяСтрока(Выражение) Тогда
			Выражения.Добавить(Выражение);
		КонецЕсли;
	КонецЦикла;
	
	// Присваивание текста: Запрос.Текст = "...".
	Для Каждого Найденное Из СтрНайтиВсеПоРегулярномуВыражению(ТекстМодуля, "[.]текст[ \t\n\r]*=", Истина) Цикл
		Выражение = ВыражениеДоКонцаОператора(ТекстМодуля, Найденное.НачальнаяПозиция + Найденное.Длина);
		Если Не ПустаяСтрока(Выражение) Тогда
			Выражения.Добавить(Выражение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Выражения;
	
КонецФункции

// Возвращает содержимое скобки вместе с вложенными скобками.
//
// Параметры:
//  Текст         - Строка - текст модуля;
//  ПозицияСкобки - Число - позиция открывающей скобки (нумерация с 1).
//
// Возвращаемое значение:
//  Строка - текст внутри скобок.
//
Функция ВыражениеВСкобках(Знач Текст, Знач ПозицияСкобки)
	
	Позиция = ПозицияСкобки + 1;
	Глубина = 1;
	ДлинаТекста = СтрДлина(Текст);
	
	Пока Позиция <= ДлинаТекста Цикл
		
		Символ = Сред(Текст, Позиция, 1);
		
		Если Символ = """" Тогда
			Позиция = ПропуститьЛитерал(Текст, Позиция);
			Продолжить;
		КонецЕсли;
		
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Сред(Текст, ПозицияСкобки + 1, Позиция - ПозицияСкобки - 1);
			КонецЕсли;
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Возвращает выражение от указанной позиции до конца оператора (точки с запятой).
//
// Параметры:
//  Текст  - Строка - текст модуля;
//  Начало - Число - позиция начала выражения (нумерация с 1).
//
// Возвращаемое значение:
//  Строка - выражение без завершающей точки с запятой.
//
Функция ВыражениеДоКонцаОператора(Знач Текст, Знач Начало)
	
	Позиция = Начало;
	ДлинаТекста = СтрДлина(Текст);
	
	Пока Позиция <= ДлинаТекста Цикл
		
		Символ = Сред(Текст, Позиция, 1);
		
		Если Символ = """" Тогда
			Позиция = ПропуститьЛитерал(Текст, Позиция);
			Продолжить;
		КонецЕсли;
		
		Если Символ = ";" Тогда
			Возврат Сред(Текст, Начало, Позиция - Начало);
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат Сред(Текст, Начало);
	
КонецФункции

// Возвращает позицию за строковым литералом, начинающимся в указанной позиции.
//
// Параметры:
//  Текст   - Строка - текст;
//  Позиция - Число - позиция открывающей кавычки (нумерация с 1).
//
// Возвращаемое значение:
//  Число - позиция за закрывающей кавычкой литерала.
//
Функция ПропуститьЛитерал(Знач Текст, Знач Позиция)
	
	ДлинаТекста = СтрДлина(Текст);
	Позиция = Позиция + 1;
	
	Пока Позиция <= ДлинаТекста Цикл
		Если Сред(Текст, Позиция, 1) = """" Тогда
			Если Позиция < ДлинаТекста И Сред(Текст, Позиция + 1, 1) = """" Тогда
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			Возврат Позиция + 1;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Возврат ДлинаТекста + 1;
	
КонецФункции

// Возвращает текст запроса из выражения модуля.
//
// Параметры:
//  Выражение   - Строка - выражение из модуля;
//  ТекстМодуля - Строка - текст модуля без комментариев.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст запроса или Неопределено, если собрать текст не удалось.
//
Функция ТекстЗапросаИзВыражения(Знач Выражение, Знач ТекстМодуля)
	
	ВыражениеОчищенное = СокрЛП(Выражение);
	Если ПустаяСтрока(ВыражениеОчищенное) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧастиВыражения = ЧастиСложения(ВыражениеОчищенное);
	Если ЧастиВыражения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧастиТекста = Новый Массив;
	Для Каждого Часть Из ЧастиВыражения Цикл
		ЗначениеЧасти = ЗначениеЧастиТекста(Часть, ТекстМодуля);
		Если ЗначениеЧасти = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЧастиТекста.Добавить(ЗначениеЧасти);
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиТекста, "");
	
КонецФункции

// Разбивает выражение на части по знакам "+" верхнего уровня (вне строковых литералов и скобок).
//
// Параметры:
//  Выражение - Строка - выражение модуля.
//
// Возвращаемое значение:
//  Массив из Строка - части выражения.
//
Функция ЧастиСложения(Знач Выражение)
	
	Части = Новый Массив;
	НачалоЧасти = 1;
	Позиция = 1;
	Глубина = 0;
	ДлинаВыражения = СтрДлина(Выражение);
	
	Пока Позиция <= ДлинаВыражения Цикл
		
		Символ = Сред(Выражение, Позиция, 1);
		
		Если Символ = """" Тогда
			Позиция = ПропуститьЛитерал(Выражение, Позиция);
			Продолжить;
		КонецЕсли;
		
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		КонецЕсли;
		
		Если Символ = ")" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		
		Если Символ = "+" И Глубина = 0 Тогда
			Части.Добавить(Сред(Выражение, НачалоЧасти, Позиция - НачалоЧасти));
			НачалоЧасти = Позиция + 1;
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Части.Добавить(Сред(Выражение, НачалоЧасти));
	
	Возврат Части;
	
КонецФункции

// Возвращает значение одной части выражения с текстом запроса.
//
// Параметры:
//  Часть       - Строка - часть выражения между знаками "+";
//  ТекстМодуля - Строка - текст модуля без комментариев.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение части или Неопределено, если часть разобрать не удалось.
//
Функция ЗначениеЧастиТекста(Знач Часть, Знач ТекстМодуля)
	
	ЧастьОчищенная = СокрЛП(Часть);
	Если ПустаяСтрока(ЧастьОчищенная) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Строковый литерал.
	Если СтрПодобнаПоРегулярномуВыражению(ЧастьОчищенная, "^" + РегулярноеВыражениеЛитерала() + "$") Тогда
		Возврат ЗначениеЛитерала(ЧастьОчищенная);
	КонецЕсли;
	
	// Служебные символы: Символы.ПС, Символы.Таб, Символы.ВК.
	Если СтрПодобнаПоРегулярномуВыражению(ЧастьОчищенная, "^символы[ \t\n\r]*[.][ \t\n\r]*[А-Яа-яЁёA-Za-z]+$", Истина) Тогда
		Возврат ЗначениеСимвола(ЧастьОчищенная);
	КонецЕсли;
	
	// СтрШаблон("...", ...): берется текст шаблона.
	Если СтрПодобнаПоРегулярномуВыражению(ЧастьОчищенная, "^стршаблон[ \t\n\r]*[(]", Истина) Тогда
		Литералы = ЛитералыВыражения(ЧастьОчищенная);
		Возврат ?(Литералы.Количество() > 0, Литералы[0], Неопределено);
	КонецЕсли;
	
	// Имя переменной: ищется присваивание переменной строкового литерала.
	Если ЭтоИмяПеременной(ЧастьОчищенная) Тогда
		Возврат ЛитералПеременной(ЧастьОчищенная, ТекстМодуля);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает значение служебного символа по его имени в тексте модуля.
//
// Параметры:
//  ИмяСимвола - Строка - имя символа, например "Символы.ПС".
//
// Возвращаемое значение:
//  Строка - значение символа; пустая строка - если имя не распознано.
//
Функция ЗначениеСимвола(Знач ИмяСимвола)
	
	ИмяВНижнемРегистре = НРег(СтрЗаменить(ИмяСимвола, " ", ""));
	
	Если СтрНайти(ИмяВНижнемРегистре, "пс") > 0 Тогда
		Возврат Символы.ПС;
	КонецЕсли;
	
	Если СтрНайти(ИмяВНижнемРегистре, "таб") > 0 Тогда
		Возврат Символы.Таб;
	КонецЕсли;
	
	Если СтрНайти(ИмяВНижнемРегистре, "вк") > 0 Тогда
		Возврат Символы.ВК;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает значения строковых литералов выражения.
//
// Параметры:
//  Выражение - Строка - выражение из модуля.
//
// Возвращаемое значение:
//  Массив из Строка - значения строковых литералов.
//
Функция ЛитералыВыражения(Знач Выражение)
	
	Литералы = Новый Массив;
	
	Для Каждого Найденное Из СтрНайтиВсеПоРегулярномуВыражению(Выражение, РегулярноеВыражениеЛитерала()) Цикл
		Литералы.Добавить(ЗначениеЛитерала(Найденное.Значение));
	КонецЦикла;
	
	Возврат Литералы;
	
КонецФункции

// Возвращает значение строкового литерала без кавычек и символов продолжения строки.
//
// Параметры:
//  ЛитералСКавычками - Строка - литерал вместе с обрамляющими кавычками.
//
// Возвращаемое значение:
//  Строка - значение литерала.
//
Функция ЗначениеЛитерала(Знач ЛитералСКавычками)
	
	Значение = Сред(ЛитералСКавычками, 2, СтрДлина(ЛитералСКавычками) - 2);
	Значение = СтрЗаменить(Значение, """""", """");
	
	СтрокиЗначения = СтрРазделить(Значение, Символы.ПС, Ложь);
	Результат = Новый Массив;
	Для Каждого Строка Из СтрокиЗначения Цикл
		Результат.Добавить(СтрЗаменитьПоРегулярномуВыражению(Строка, "^[ \t]*[|]", ""));
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, Символы.ПС);
	
КонецФункции

// Возвращает литерал переменной по ее имени.
//
// Параметры:
//  ИмяПеременной - Строка - имя переменной;
//  ТекстМодуля   - Строка - текст модуля без комментариев.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение переменной или Неопределено.
//
Функция ЛитералПеременной(Знач ИмяПеременной, Знач ТекстМодуля)
	
	РегВыражение = "(^|[^А-Яа-яЁёA-Za-z0-9_])" + ИмяПеременной + "[ \t\n\r]*=";
	
	Найденное = СтрНайтиПоРегулярномуВыражению(ТекстМодуля, РегВыражение, , , , Истина);
	Если Найденное.НачальнаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выражение = ВыражениеДоКонцаОператора(ТекстМодуля, Найденное.НачальнаяПозиция + Найденное.Длина);
	Литералы = ЛитералыВыражения(Выражение);
	
	Если Литералы.Количество() > 0 Тогда
		Остаток = СтрЗаменитьПоРегулярномуВыражению(Выражение, РегулярноеВыражениеЛитерала(), "");
		Если СтрПодобнаПоРегулярномуВыражению(Остаток, "^[ \t\n\r+]*$") Тогда
			Возврат СтрСоединить(Литералы, "");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Проверяет, является ли строка именем переменной.
//
// Параметры:
//  Строка - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка является именем переменной.
//
Функция ЭтоИмяПеременной(Знач Строка)
	
	Возврат СтрПодобнаПоРегулярномуВыражению(Строка, "^[А-Яа-яЁёA-Za-z_][А-Яа-яЁёA-Za-z0-9_]*$");
	
КонецФункции

// Возвращает регулярное выражение строкового литерала.
//
// Возвращаемое значение:
//  Строка - регулярное выражение.
//
Функция РегулярноеВыражениеЛитерала()
	
	Возврат """" + "([^""]|"""""")*" + """";
	
КонецФункции

// Возвращает регулярное выражение обращения к полю через псевдоним таблицы: "Псевдоним.Поле".
//
// Возвращаемое значение:
//  Строка - регулярное выражение.
//
Функция РегулярноеВыражениеОбращенияКПолю()
	
	Возврат "[А-Яа-яЁёA-Za-z_][А-Яа-яЁёA-Za-z0-9_]*([.][А-Яа-яЁёA-Za-z0-9_*]+)+";
	
КонецФункции

// Извлекает поля объектов метаданных из текста запроса.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса;
//  ИмяМодуля    - Строка - имя модуля, в котором найден запрос;
//  ПоляРегистра - Соответствие из КлючИЗначение - накопитель полей.
//
Процедура ПоляТекстаЗапроса(Знач ТекстЗапроса, Знач ИмяМодуля, ПоляРегистра)
	
	ТекстЗапросаБезКомментариев = ТекстБезКомментариев(ТекстЗапроса);
	ТекстЗапросаБезСтрок = ТекстБезСтроковыхЛитералов(ТекстЗапросаБезКомментариев);
	
	Псевдонимы = ПсевдонимыТаблиц(ТекстЗапросаБезСтрок);
	Если Псевдонимы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СсылкиНаПоля = Новый Массив;
	НайтиСсылкиНаПоля(ТекстЗапросаБезСтрок, Псевдонимы, СсылкиНаПоля);
	НайтиСсылкиНаГолыеПоля(ТекстЗапросаБезСтрок, Псевдонимы, СсылкиНаПоля);
	
	Для Каждого Ссылка Из СсылкиНаПоля Цикл
		ЗаписатьПоле(Ссылка.Метаданные, Ссылка.Поле, ИмяМодуля, ПоляРегистра);
	КонецЦикла;
	
КонецПроцедуры

// Заменяет строковые литералы текста, чтобы их содержимое не разбиралось как код запроса.
//
// Параметры:
//  Текст - Строка - текст запроса.
//
// Возвращаемое значение:
//  Строка - текст запроса без содержимого строковых литералов.
//
Функция ТекстБезСтроковыхЛитералов(Знач Текст)
	
	Возврат СтрЗаменитьПоРегулярномуВыражению(Текст, РегулярноеВыражениеЛитерала(), "''");
	
КонецФункции

// Возвращает псевдонимы таблиц запроса.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса без строковых литералов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ - имя псевдонима (в нижнем регистре), значение - Структура("Метаданные, ИмяТаблицы, ТипКоллекции"):
//   * Метаданные   - Строка - полное имя объекта метаданных таблицы;
//   * ИмяТаблицы   - Строка - имя таблицы (или имя табличной части);
//   * ТипКоллекции - Строка - "РеквизитыТабличнойЧасти" для табличной части, иначе пустая строка.
//
Функция ПсевдонимыТаблиц(Знач ТекстЗапроса)
	
	Псевдонимы = Новый Соответствие;
	
	РегВыражение = "(из|соединение)[ \t\n\r]+[А-Яа-яЁёA-Za-z0-9_.]+([ \t\n\r]+как[ \t\n\r]+[А-Яа-яЁёA-Za-z0-9_]+)?";
	
	Для Каждого Найденное Из СтрНайтиВсеПоРегулярномуВыражению(ТекстЗапроса, РегВыражение, Истина) Цикл
		
		Имена = СтрНайтиВсеПоРегулярномуВыражению(Найденное.Значение, "[А-Яа-яЁёA-Za-z0-9_.]+", Истина);
		Если Имена.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяТаблицы = Имена[1].Значение;
		Псевдоним = "";
		Если Имена.Количество() >= 4 Тогда
			Псевдоним = Имена[3].Значение;
		КонецЕсли;
		
		СведенияОТаблице = СведенияОбОбъектеТаблицы(ИмяТаблицы);
		Если СведенияОТаблице = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(Псевдоним) Тогда
			ЧастиИмени = СтрРазделить(ИмяТаблицы, ".", Ложь);
			Псевдоним = ЧастиИмени[1];
		КонецЕсли;
		
		Псевдонимы.Вставить(НРег(Псевдоним), СведенияОТаблице);
		
	КонецЦикла;
	
	Возврат Псевдонимы;
	
КонецФункции

// Возвращает сведения об объекте метаданных, которому принадлежит таблица запроса.
//
// Параметры:
//  ИмяТаблицы - Строка - имя таблицы в тексте запроса.
//
// Возвращаемое значение:
//  Структура, Неопределено - сведения о таблице или Неопределено, если объект метаданных не найден.
//
Функция СведенияОбОбъектеТаблицы(Знач ИмяТаблицы)
	
	Части = СтрРазделить(ИмяТаблицы, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолноеИмяОбъекта = Части[0] + "." + Части[1];
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сведения = Новый Структура("Метаданные, ИмяТаблицы, ТипКоллекции", ПолноеИмяОбъекта, ИмяТаблицы, "");
	
	// Табличная часть: Документ.ПриходТовара.Товары.
	Если Части.Количество() >= 3 Тогда
		ТабличнаяЧасть = ТабличнаяЧастьОбъектаПоИмени(ОбъектМетаданных, Части[2]);
		Если ТабличнаяЧасть <> Неопределено Тогда
			Сведения.Метаданные = ПолноеИмяОбъекта + ".ТабличнаяЧасть." + ТабличнаяЧасть.Имя;
			Сведения.ИмяТаблицы = Части[2];
			Сведения.ТипКоллекции = "РеквизитыТабличнойЧасти";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции

// Находит в тексте запроса обращения к полям через псевдонимы таблиц.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса без строковых литералов;
//  Псевдонимы   - Соответствие из КлючИЗначение - псевдонимы таблиц запроса;
//  СсылкиНаПоля - Массив из Структура - накопитель ссылок на поля.
//
Процедура НайтиСсылкиНаПоля(Знач ТекстЗапроса, Псевдонимы, СсылкиНаПоля)
	
	РегВыражение = РегулярноеВыражениеОбращенияКПолю();
	
	Для Каждого Найденное Из СтрНайтиВсеПоРегулярномуВыражению(ТекстЗапроса, РегВыражение) Цикл
		
		Части = СтрРазделить(Найденное.Значение, ".", Ложь);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		СведенияОТаблице = Псевдонимы.Получить(НРег(Части[0]));
		Если СведенияОТаблице = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		РазобратьЦепочкуПолей(СведенияОТаблице, Части, 1, СсылкиНаПоля);
		
	КонецЦикла;
	
	// Поле "*" без псевдонима: нужны права на все поля всех таблиц запроса.
	Если СтрНайтиПоРегулярномуВыражению(ТекстЗапроса, "(^|[ \t\n\r,])[*]").НачальнаяПозиция > 0 Тогда
		Для Каждого КлючИЗначение Из Псевдонимы Цикл
			ДобавитьСсылкуНаПоле(КлючИЗначение.Значение.Метаданные, "*", СсылкиНаПоля);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Находит в тексте запроса поля, записанные без псевдонима таблицы ("Наименование", "Сумма").
// Такое поле относится к таблице запроса, у которой есть поле с этим именем; если имя есть
// у нескольких таблиц, ссылка добавляется по каждой из них - иначе право на поле могло бы
// не попасть в профиль.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса без строковых литералов;
//  Псевдонимы   - Соответствие из КлючИЗначение - псевдонимы таблиц запроса;
//  СсылкиНаПоля - Массив из Структура - накопитель ссылок на поля.
//
Процедура НайтиСсылкиНаГолыеПоля(Знач ТекстЗапроса, Псевдонимы, СсылкиНаПоля)
	
	// Из текста убираются уже разобранные обращения вида "Псевдоним.Поле".
	ТекстБезОбращений = СтрЗаменитьПоРегулярномуВыражению(ТекстЗапроса, РегулярноеВыражениеОбращенияКПолю(), "");
	
	ИменаВТексте = Новый Соответствие;
	РегВыражениеИмени = "[А-Яа-яЁёA-Za-z_][А-Яа-яЁёA-Za-z0-9_]*";
	НайденныеИмена = СтрНайтиВсеПоРегулярномуВыражению(ТекстБезОбращений, РегВыражениеИмени);
	Для Каждого Найденное Из НайденныеИмена Цикл
		ИменаВТексте.Вставить(НРег(Найденное.Значение), Истина);
	КонецЦикла;
	
	Если ИменаВТексте.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Псевдонимы Цикл
		
		СведенияОТаблице = КлючИЗначение.Значение;
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СведенияОТаблице.Метаданные);
		Если ОбъектМетаданных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаПолей = ИменаПолейОбъекта(ОбъектМетаданных);
		
		Для Каждого ИмяВТексте Из ИменаВТексте Цикл
			
			ИмяПоля = ИмяВТексте.Ключ;
			
			Если ИменаПолей.Получить(ИмяПоля) <> Неопределено
				Или СтандартныйРеквизитПоИмени(СведенияОТаблице, ИмяПоля) <> Неопределено Тогда
				ДобавитьСсылкуНаПоле(СведенияОТаблице.Метаданные, ИмяПоля, СсылкиНаПоля);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает имена полей объекта метаданных, доступных в запросе: реквизиты, измерения,
// ресурсы, графы и реквизиты адресации. Имена приводятся к нижнему регистру.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных таблицы запроса.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - имена полей:
//   * Ключ     - Строка - имя поля в нижнем регистре;
//   * Значение - Булево - Истина.
//
Функция ИменаПолейОбъекта(ОбъектМетаданных)
	
	Имена = Новый Соответствие;
	
	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("Реквизиты");
	ИменаКоллекций.Добавить("Измерения");
	ИменаКоллекций.Добавить("Ресурсы");
	ИменаКоллекций.Добавить("Графы");
	ИменаКоллекций.Добавить("РеквизитыАдресации");
	
	Для Каждого ИмяКоллекции Из ИменаКоллекций Цикл
		
		Попытка
			Коллекция = ОбъектМетаданных[ИмяКоллекции];
		Исключение
			Продолжить;
		КонецПопытки;
		
		Для Каждого Реквизит Из Коллекция Цикл
			Имена.Вставить(НРег(Реквизит.Имя), Истина);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Разбирает цепочку полей запроса и накапливает ссылки на поля объектов метаданных.
//
// Параметры:
//  СведенияОТаблице - Структура - сведения о таблице, которой принадлежит поле;
//  Части            - Массив из Строка - части цепочки полей;
//  НомерЧасти       - Число - номер разбираемой части;
//  СсылкиНаПоля     - Массив из Структура - накопитель ссылок на поля.
//
Процедура РазобратьЦепочкуПолей(СведенияОТаблице, Части, Знач НомерЧасти, СсылкиНаПоля)
	
	Если НомерЧасти >= Части.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = Части[НомерЧасти];
	
	Если ИмяПоля = "*" Тогда
		ДобавитьСсылкуНаПоле(СведенияОТаблице.Метаданные, "*", СсылкиНаПоля);
		Возврат;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СведенияОТаблице.Метаданные);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МетаданноеПоля = МетаданноеПоляПоИмени(ОбъектМетаданных, ИмяПоля);
	
	Если МетаданноеПоля = Неопределено Тогда
		// Возможно, это стандартный реквизит таблицы запроса.
		МетаданноеПоля = СтандартныйРеквизитПоИмени(СведенияОТаблице, ИмяПоля);
	КонецЕсли;
	
	Если МетаданноеПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСсылкуНаПоле(СведенияОТаблице.Метаданные, ИмяПоля, СсылкиНаПоля);
	
	Если НомерЧасти = Части.Количество() - 1 Тогда
		Возврат;
	КонецЕсли;
	
	МетаданноеТипаСсылки = МетаданноеСсылочногоТипа(МетаданноеПоля);
	Если МетаданноеТипаСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СведенияСледующейТаблицы = Новый Структура("Метаданные, ИмяТаблицы, ТипКоллекции",
		МетаданноеТипаСсылки.ПолноеИмя(), МетаданноеТипаСсылки.Имя, "");
	РазобратьЦепочкуПолей(СведенияСледующейТаблицы, Части, НомерЧасти + 1, СсылкиНаПоля);
	
КонецПроцедуры

// Возвращает метаданное поля объекта метаданных по имени.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных таблицы запроса;
//  ИмяПоля          - Строка - имя поля.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - метаданное поля.
//
Функция МетаданноеПоляПоИмени(ОбъектМетаданных, Знач ИмяПоля)
	
	Результат = РеквизитВКоллекции(ОбъектМетаданных, "Реквизиты", ИмяПоля);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = РеквизитВКоллекции(ОбъектМетаданных, "Измерения", ИмяПоля);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = РеквизитВКоллекции(ОбъектМетаданных, "Ресурсы", ИмяПоля);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = РеквизитВКоллекции(ОбъектМетаданных, "Графы", ИмяПоля);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат РеквизитВКоллекции(ОбъектМетаданных, "РеквизитыАдресации", ИмяПоля);
	
КонецФункции

// Ищет реквизит по имени в коллекции реквизитов объекта метаданных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - объект метаданных;
//  ИмяКоллекции     - Строка - имя коллекции реквизитов;
//  ИмяРеквизита     - Строка - имя реквизита.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - найденный реквизит.
//
Функция РеквизитВКоллекции(ОбъектМетаданных, Знач ИмяКоллекции, Знач ИмяРеквизита)
	
	Если ИмяКоллекции = "Реквизиты" Тогда
		Попытка
			Коллекция = ОбъектМетаданных.Реквизиты;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ИмяКоллекции = "Измерения" Тогда
		Попытка
			Коллекция = ОбъектМетаданных.Измерения;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ИмяКоллекции = "Ресурсы" Тогда
		Попытка
			Коллекция = ОбъектМетаданных.Ресурсы;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	ИначеЕсли ИмяКоллекции = "Графы" Тогда
		Попытка
			Коллекция = ОбъектМетаданных.Графы;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	Иначе
		Попытка
			Коллекция = ОбъектМетаданных.РеквизитыАдресации;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Для Каждого Реквизит Из Коллекция Цикл
		Если НРег(Реквизит.Имя) = НРег(ИмяРеквизита) Тогда
			Возврат Реквизит;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Добавляет ссылку на поле объекта метаданных в накопитель.
//
// Параметры:
//  ПолноеИмяМетаданного - Строка - полное имя объекта метаданных;
//  Поле                 - Строка - имя поля;
//  СсылкиНаПоля         - Массив из Структура - накопитель ссылок на поля.
//
Процедура ДобавитьСсылкуНаПоле(Знач ПолноеИмяМетаданного, Знач Поле, СсылкиНаПоля)
	
	Если ПустаяСтрока(ПолноеИмяМетаданного) Или ПустаяСтрока(Поле) Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Новый Структура("Метаданные, Поле", ПолноеИмяМетаданного, Поле);
	СсылкиНаПоля.Добавить(Ссылка);
	
КонецПроцедуры

// Возвращает табличную часть объекта метаданных по имени.
//
// Параметры:
//  ОбъектМетаданных  - ОбъектМетаданных - объект метаданных;
//  ИмяТабличнойЧасти - Строка - имя табличной части.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - табличная часть объекта метаданных.
//
Функция ТабличнаяЧастьОбъектаПоИмени(ОбъектМетаданных, Знач ИмяТабличнойЧасти)
	
	Попытка
		ТабличныеЧасти = ОбъектМетаданных.ТабличныеЧасти;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Если НРег(ТабличнаяЧасть.Имя) = НРег(ИмяТабличнойЧасти) Тогда
			Возврат ТабличнаяЧасть;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает стандартный реквизит таблицы запроса по имени.
//
// Параметры:
//  СведенияОТаблице - Структура - сведения о таблице;
//  ИмяПоля          - Строка - имя поля.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание стандартного реквизита:
//   * Имя - Строка - имя поля в тексте запроса.
//
Функция СтандартныйРеквизитПоИмени(СведенияОТаблице, Знач ИмяПоля)
	
	Если СведенияОТаблице.ТипКоллекции = "РеквизитыТабличнойЧасти" Тогда
		// У табличной части стандартных реквизитов, доступных в запросе, нет.
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяВНижнемРегистре = НРег(ИмяПоля);
	
	Если ИмяВНижнемРегистре = "ссылка"
		Или ИмяВНижнемРегистре = "пометкаудаления"
		Или ИмяВНижнемРегистре = "предопределенный"
		Или ИмяВНижнемРегистре = "этогруппа"
		Или ИмяВНижнемРегистре = "родитель"
		Или ИмяВНижнемРегистре = "владелец"
		Или ИмяВНижнемРегистре = "наименование"
		Или ИмяВНижнемРегистре = "код"
		Или ИмяВНижнемРегистре = "номер"
		Или ИмяВНижнемРегистре = "дата"
		Или ИмяВНижнемРегистре = "проведен"
		Или ИмяВНижнемРегистре = "активность"
		Или ИмяВНижнемРегистре = "регистратор"
		Или ИмяВНижнемРегистре = "период"
		Или ИмяВНижнемРегистре = "номерстроки"
		Или ИмяВНижнемРегистре = "ключ"
		Или ИмяВНижнемРегистре = "счет"
		Или ИмяВНижнемРегистре = "корсчет" Тогда
		Возврат Новый Структура("Имя", ИмяПоля);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает метаданное ссылочного типа реквизита.
//
// Параметры:
//  МетаданноеПоля - ОбъектМетаданных, Структура - метаданное поля.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - метаданное ссылочного типа или Неопределено.
//
Функция МетаданноеСсылочногоТипа(МетаданноеПоля)
	
	Если МетаданноеПоля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(МетаданноеПоля) = Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ТипыЗначения = МетаданноеПоля.Тип.Типы();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипыЗначения.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Метаданные.НайтиПоТипу(ТипыЗначения[0]);
	
КонецФункции

#КонецОбласти
