////////////////////////////////////////////////////////////////////////////////
// Перезаполнение поступлений по заказам поставщику.
//
// Обработка находит документы «Приобретение товаров и услуг», у которых не
// установлен признак «Поступление по заказам», и подбирает к ним заказ
// поставщику с точным совпадением партнёра, суммы документа и склада.
// Перезаполнение выполняется построчно: ошибка по одному документу не
// прерывает обработку остальных.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подготавливает задание: находит поступления и однозначно соответствующие
// им заказы поставщику.
//
// Возвращаемое значение:
//  Структура - задание на перезаполнение:
//   * Строки - Массив из Структура - пары «поступление - заказ»:
//      ** Поступление - ДокументСсылка.ПриобретениеТоваровУслуг - перезаполняемый документ
//      ** Заказ - ДокументСсылка.ЗаказПоставщику - заказ-основание
//   * ВсегоСтрок - Число - количество найденных пар
//
Функция ПодготовитьЗадание() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриобретениеТоваровУслуг.Ссылка КАК Поступление,
	|	МАКСИМУМ(Заказ.Ссылка) КАК Заказ
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказ
	|		ПО ПриобретениеТоваровУслуг.Партнер = Заказ.Партнер
	|			И ПриобретениеТоваровУслуг.СуммаДокумента = Заказ.СуммаДокумента
	|			И ПриобретениеТоваровУслуг.Склад = Заказ.Склад
	|ГДЕ
	|	НЕ ПриобретениеТоваровУслуг.ПоступлениеПоЗаказам
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриобретениеТоваровУслуг.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Заказ.Ссылка) = 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступление";

	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокаЗадания = Новый Структура;
		СтрокаЗадания.Вставить("Поступление", Выборка.Поступление);
		СтрокаЗадания.Вставить("Заказ", Выборка.Заказ);
		Строки.Добавить(СтрокаЗадания);
	КонецЦикла;

	Задание = Новый Структура;
	Задание.Вставить("Строки", Строки);
	Задание.Вставить("ВсегоСтрок", Строки.Количество());

	Возврат Задание;

КонецФункции

// Возвращает товары документа для вывода на форме обработки.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПриобретениеТоваровУслуг, ДокументСсылка.ЗаказПоставщику - документ,
//                 товары которого нужно получить.
//
// Возвращаемое значение:
//  ТаблицаЗначений - товары документа:
//   * Номенклатура - СправочникСсылка.Номенклатура - товар
//   * Количество - Число - количество
//   * Цена - Число - цена
//   * Сумма - Число - сумма
//
Функция ТоварыДокумента(ДокументСсылка) Экспорт

	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Товары.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Товары.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Товары.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Товары;
	КонецЕсли;

	Запрос = Новый Запрос;

	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
	Иначе
		Возврат Товары;
	КонецЕсли;

	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Перезаполняет документ «Приобретение товаров и услуг» по заказу поставщику
// и записывает его в режиме проведения.
//
// Ошибка не выбрасывается наружу: она записывается в журнал регистрации и
// возвращается в результате.
//
// Параметры:
//  ПоступлениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - перезаполняемый документ.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//
// Возвращаемое значение:
//  Структура - результат перезаполнения:
//   * Успешно - Булево - Истина, если документ перезаполнен и записан
//   * ТекстОшибки - Строка - краткое представление ошибки, пустая строка при успехе
//
Функция ПерезаполнитьПоступление(ПоступлениеСсылка, ЗаказСсылка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ ЗначениеЗаполнено(ПоступлениеСсылка) ИЛИ НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнено поступление или заказ.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПоступлениеОбъект = ПоступлениеСсылка.ПолучитьОбъект();
		Если ТипЗнч(ПоступлениеОбъект) <> Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ %1 недоступен для изменения.'"), ПоступлениеСсылка);
		КонецЕсли;

		ПоступлениеОбъект.Товары.Очистить();
		ПоступлениеОбъект.Заполнить(ЗаказСсылка);
		ПровестиДокумент(ПоступлениеОбъект);

		Результат.Успешно = Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписатьОшибкуВЖурнал(ПоступлениеСсылка, Результат.ТекстОшибки, ИнформацияОбОшибке);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет пакетное перезаполнение по всем поступлениям с точным совпадением.
//
// Обработка построчная: ошибка по одному документу попадает в результат,
// после чего обработка переходит к следующему документу.
//
// Возвращаемое значение:
//  Структура - результат обработки:
//   * Всего - Число - количество найденных пар
//   * Обработано - Число - количество успешно перезаполненных документов
//   * Ошибки - Массив из Структура - ошибки по документам:
//      ** Поступление - ДокументСсылка.ПриобретениеТоваровУслуг
//      ** Заказ - ДокументСсылка.ЗаказПоставщику
//      ** ТекстОшибки - Строка
//
Функция ПерезаполнитьТочныеСовпадения() Экспорт

	Задание = ПодготовитьЗадание();

	Результат = Новый Структура;
	Результат.Вставить("Всего", Задание.ВсегоСтрок);
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Ошибки", Новый Массив);

	Для Каждого СтрокаЗадания Из Задание.Строки Цикл

		РезультатСтроки = ПерезаполнитьПоступление(СтрокаЗадания.Поступление, СтрокаЗадания.Заказ);
		Если РезультатСтроки.Успешно Тогда
			Результат.Обработано = Результат.Обработано + 1;
			Продолжить;
		КонецЕсли;

		ОшибкаСтроки = Новый Структура;
		ОшибкаСтроки.Вставить("Поступление", СтрокаЗадания.Поступление);
		ОшибкаСтроки.Вставить("Заказ", СтрокаЗадания.Заказ);
		ОшибкаСтроки.Вставить("ТекстОшибки", РезультатСтроки.ТекстОшибки);
		Результат.Ошибки.Добавить(ОшибкаСтроки);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Оценивает объём предстоящей автопривязки документов.
//
// Параметры:
//  Этап - Строка - «ПоЗаказам» (заказы поставщику) или «ПоДокументам»
//                 (бесхозные поступления и приходные ордера).
//
// Возвращаемое значение:
//  Структура - объём задания:
//   * Всего - Число - количество документов, которые будут обработаны
//   * Описание - Строка - текстовое описание объёма для пользователя
//
Функция ПодготовитьЗаданиеАвтопривязки(Этап) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Всего", 0);
	Результат.Вставить("Описание", "");

	Если Этап = "ПоЗаказам" Тогда
		Заказы = ЗаказыДляАвтопривязки();
		Результат.Всего = Заказы.Количество();
		Результат.Описание = СтрШаблон(
			НСтр("ru = 'Заказов поставщику без привязанных поступлений: %1. Для каждого будет подобрано поступление и приходный ордер; если поступление не найдено — ордер привяжется прямо к заказу.'"),
			Результат.Всего);
	Иначе
		Поступления = БесхозныеПоступления();
		Ордера = БесхозныеОрдера();
		Результат.Всего = Поступления.Количество() + Ордера.Количество();
		Результат.Описание = СтрШаблон(
			НСтр("ru = 'Поступлений без заказа: %1, приходных ордеров без основания: %2.'"),
			Поступления.Количество(), Ордера.Количество());
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Фоновая процедура автопривязки документов.
//
// Параметры:
//  ПараметрыЗадания - Структура - параметры задания:
//   * Этап - Строка - «ПоЗаказам» или «ПоДокументам».
//  АдресРезультата - Строка - адрес результата во временном хранилище (формируется БСП).
//
Процедура ВыполнитьЗаданиеАвтопривязки(ПараметрыЗадания, АдресРезультата) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Лог", ЖурналАвтопривязки());
	Результат.Вставить("Этап", ПараметрыЗадания.Этап);
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Успешно", 0);
	Результат.Вставить("Ошибок", 0);

	Счетчики = Новый Структура;
	Счетчики.Вставить("Обработано", 0);
	Счетчики.Вставить("Успешно", 0);
	Счетчики.Вставить("Ошибок", 0);

	Попытка
		Если ПараметрыЗадания.Этап = "ПоЗаказам" Тогда
			ЭтапПоЗаказам(Результат.Лог, Счетчики);
		Иначе
			ЭтапПоДокументам(Результат.Лог, Счетчики);
		КонецЕсли;
		ДлительныеОперации.СообщитьПрогресс(100, НСтр("ru = 'Готово'"));
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ДобавитьСтрокуЖурнала(Результат.Лог, ПараметрыЗадания.Этап, Документы.ПриобретениеТоваровУслуг.ПустаяСсылка(),
			НСтр("ru = 'Выполнение задания'"), НСтр("ru = 'Ошибка'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		ЗаписьЖурналаРегистрации("ГКСК.АвтопривязкаДокументов",
			УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		Счетчики.Ошибок = Счетчики.Ошибок + 1;
	КонецПопытки;

	Результат.Обработано = Счетчики.Обработано;
	Результат.Успешно = Счетчики.Успешно;
	Результат.Ошибок = Счетчики.Ошибок;

	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает ошибку перезаполнения документа в журнал регистрации.
//
// Параметры:
//  ПоступлениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - документ, при обработке которого возникла ошибка.
//  ТекстОшибки - Строка - краткое представление ошибки.
//  ИнформацияОбОшибке - ИнформацияОбОшибке - сведения об ошибке.
//
Процедура ЗаписатьОшибкуВЖурнал(ПоступлениеСсылка, ТекстОшибки, ИнформацияОбОшибке)

	ЗаписьЖурналаРегистрации(
		"Перезаполнение поступлений.Перезаполнение документа",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Документы.ПриобретениеТоваровУслуг,
		ПоступлениеСсылка,
		ТекстОшибки + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

// Возвращает пустой журнал автопривязки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - журнал:
//   * Дата - Дата - момент выполнения операции
//   * Этап - Строка - этап автопривязки
//   * Объект - Строка - представление обрабатываемого документа
//   * Операция - Строка - что выполнялось
//   * Результат - Строка - «Успех», «Ошибка» или «Пропуск»
//   * Комментарий - Строка - подробности
//
Функция ЖурналАвтопривязки() Экспорт

	Журнал = Новый ТаблицаЗначений;
	Журнал.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Журнал.Колонки.Добавить("Этап", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(60)));
	Журнал.Колонки.Добавить("Объект", Новый ОписаниеТипов(
		"ДокументСсылка.ПриобретениеТоваровУслуг, ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ПриходныйОрдерНаТовары"));
	Журнал.Колонки.Добавить("Операция", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Журнал.Колонки.Добавить("Результат", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Журнал.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка"));

	Возврат Журнал;

КонецФункции

// Добавляет запись в журнал автопривязки и в журнал регистрации.
//
// Параметры:
//  Журнал - ТаблицаЗначений - журнал автопривязки, см. ЖурналАвтопривязки.
//  Этап - Строка - этап автопривязки.
//  ОбъектСсылка - ДокументСсылка - документ, к которому относится запись.
//  Операция - Строка - выполняемое действие.
//  Результат - Строка - «Успех», «Ошибка», «Пропуск» или «Информация».
//  Комментарий - Строка - подробности.
//
Процедура ДобавитьСтрокуЖурнала(Журнал, Этап, ОбъектСсылка, Операция, Результат, Комментарий)

	Строка = Журнал.Добавить();
	Строка.Дата = ТекущаяДатаСеанса();
	Строка.Этап = Этап;
	Строка.Объект = ОбъектСсылка;
	Строка.Операция = Операция;
	Строка.Результат = Результат;
	Строка.Комментарий = Комментарий;

	Уровень = ?(Результат = "Ошибка", УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	ЗаписьЖурналаРегистрации("ГКСК.АвтопривязкаДокументов", Уровень, , ,
		СтрШаблон("[%1] %2 | %3: %4", Этап, Строка(ОбъектСсылка), Операция, Комментарий));

КонецПроцедуры

// Сохраняет журнал автопривязки в регистр сведений. Форма показывает журнал
// из регистра в любой момент, в том числе во время задания и после его отмены:
// временное хранилище для этого не подходит, так как данные фонового задания
// видны родительскому сеансу только после завершения задания.
//
// Запись идемпотентна: журнал записывается целиком, номер строки - её позиция
// в журнале, поэтому повторное сохранение перезаписывает те же записи.
//
// Параметры:
//  Журнал - ТаблицаЗначений - журнал автопривязки, см. ЖурналАвтопривязки.
//
Процедура СохранитьЖурналВРегистр(Журнал)

	Если Журнал.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.ГКСК_ЖурналАвтопривязки.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();

	Порядок = 0;
	Для Каждого СтрокаЖурнала Из Журнал Цикл
		Порядок = Порядок + 1;
		Запись = НаборЗаписей.Добавить();
		Запись.Порядок = Порядок;
		Запись.Дата = СтрокаЖурнала.Дата;
		Запись.Этап = СтрокаЖурнала.Этап;
		Запись.Объект = СтрокаЖурнала.Объект;
		Запись.Операция = СтрокаЖурнала.Операция;
		Запись.Результат = СтрокаЖурнала.Результат;
		Запись.Комментарий = СтрокаЖурнала.Комментарий;
	КонецЦикла;

	Попытка
		НаборЗаписей.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ГКСК.АвтопривязкаДокументов", УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон("Не удалось записать журнал в регистр: %1",
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Очищает журнал автопривязки в регистре сведений.
//
Процедура ОчиститьЖурналАвтопривязки() Экспорт

	НаборЗаписей = РегистрыСведений.ГКСК_ЖурналАвтопривязки.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает журнал автопривязки из регистра сведений в порядке добавления строк.
//
// Возвращаемое значение:
//  ТаблицаЗначений - журнал с колонками реквизита формы «ЖурналДиагностики»:
//   * Дата - Дата - момент выполнения операции
//   * Этап - Строка - этап автопривязки
//   * Объект - ДокументСсылка - обрабатываемый документ
//   * Операция - Строка - что выполнялось
//   * Результат - Строка - «Успех», «Ошибка», «Пропуск» или «Информация»
//   * Комментарий - Строка - подробности
//
Функция ЖурналАвтопривязкиИзРегистра() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Журнал.Дата КАК Дата,
		|	Журнал.Этап КАК Этап,
		|	Журнал.Объект КАК Объект,
		|	Журнал.Операция КАК Операция,
		|	Журнал.Результат КАК Результат,
		|	Журнал.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ГКСК_ЖурналАвтопривязки КАК Журнал
		|
		|УПОРЯДОЧИТЬ ПО
		|	Журнал.Порядок";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает заказы поставщику, к которым ещё не привязано ни одного поступления.
//
// Остаток регистра «Заказы поставщикам» здесь не используется: его списывают
// приходные ордера, в том числе оформленные без распоряжения. Такой заказ
// формально закрыт, но его документы остаются безхозными и требуют привязки.
// Заказы, к которым уже привязано поступление, в обработку не попадают —
// их нельзя перезаполнять.
//
// Возвращаемое значение:
//  ТаблицаЗначений - заказы:
//   * Ссылка - ДокументСсылка.ЗаказПоставщику
//   * Партнер - СправочникСсылка.Партнеры
//   * СуммаДокумента - Число
//   * Склад - СправочникСсылка.Склады
//   * Дата - Дата
//
Функция ЗаказыДляАвтопривязки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Ссылка,
	|	Заказ.Партнер КАК Партнер,
	|	Заказ.СуммаДокумента КАК СуммаДокумента,
	|	Заказ.Склад КАК Склад,
	|	Заказ.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказ
	|ГДЕ
	|	НЕ Заказ.ПометкаУдаления
	|	И НЕ Заказ.Ссылка В
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ПТУ.ЗаказПоставщику
	|		ИЗ
	|			Документ.ПриобретениеТоваровУслуг КАК ПТУ
	|		ГДЕ
	|			ПТУ.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|			И НЕ ПТУ.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает поступления, у которых не заполнен заказ поставщику.
//
// Возвращаемое значение:
//  ТаблицаЗначений - поступления (Ссылка, Партнер, СуммаДокумента, Склад, ЗаказПоставщику, Дата).
//
Функция БесхозныеПоступления()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПТУ.Ссылка КАК Ссылка,
	|	ПТУ.Партнер КАК Партнер,
	|	ПТУ.СуммаДокумента КАК СуммаДокумента,
	|	ПТУ.Склад КАК Склад,
	|	ПТУ.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ПТУ.Дата КАК Дата
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПТУ
	|ГДЕ
	|	НЕ ПТУ.ПометкаУдаления
	|	И ПТУ.ЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПТУ.Дата";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает приходные ордера, у которых не заполнено распоряжение (основание).
//
// Возвращаемое значение:
//  ТаблицаЗначений - ордера (Ссылка, Склад, Дата).
//
Функция БесхозныеОрдера()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ордер.Ссылка КАК Ссылка,
	|	Ордер.Склад КАК Склад,
	|	Ордер.Дата КАК Дата,
	|	Ордер.Распоряжение КАК Распоряжение
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары КАК Ордер
	|ГДЕ
	|	НЕ Ордер.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ордер.Дата";

	ВсеОрдера = Запрос.Выполнить().Выгрузить();

	Бесхозные = Новый ТаблицаЗначений;
	Бесхозные.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.ПриходныйОрдерНаТовары"));
	Бесхозные.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	Бесхозные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));

	Для Каждого СтрокаОрдера Из ВсеОрдера Цикл
		Если ЗначениеЗаполнено(СтрокаОрдера.Распоряжение) Тогда
			Продолжить;
		КонецЕсли;
		Бесхозный = Бесхозные.Добавить();
		ЗаполнитьЗначенияСвойств(Бесхозный, СтрокаОрдера);
	КонецЦикла;

	Возврат Бесхозные;

КонецФункции

// Возвращает табличные части «Товары» документов указанного вида.
//
// Параметры:
//  ВидДокумента - Строка - «ПриобретениеТоваровУслуг», «ЗаказПоставщику» или
//                 «ПриходныйОрдерНаТовары».
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки товаров:
//   * Ссылка - ДокументСсылка - документ-владелец строки
//   * Номенклатура - СправочникСсылка.Номенклатура
//   * Количество - Число
//   * Сумма - Число - сумма строки (для приходного ордера всегда 0)
//
Функция ТоварыДокументовПоВиду(ВидДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2)) КАК Сумма
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК Товары
	|ГДЕ
	|	НЕ Товары.Ссылка.ПометкаУдаления";

	Если ВидДокумента = "ПриобретениеТоваровУслуг" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Ссылка КАК Ссылка,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
		|ГДЕ
		|	НЕ Товары.Ссылка.ПометкаУдаления";
	ИначеЕсли ВидДокумента = "ЗаказПоставщику" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Ссылка КАК Ссылка,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК Товары
		|ГДЕ
		|	НЕ Товары.Ссылка.ПометкаУдаления";
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Строит ключ состава документа для сопоставления по составу.
//
// Параметры:
//  СтрокиТоваров - ТаблицаЗначений - строки документа с колонками
//                 Номенклатура, Количество, Сумма.
//  ВключатьНоменклатуру - Булево - Истина для прохода «номенклатура + количество + сумма»,
//                        Ложь для прохода «количество + сумма».
//
// Возвращаемое значение:
//  Строка - отсортированный ключ состава.
//
Функция КлючСостава(СтрокиТоваров, ВключатьНоменклатуру)

	Части = Новый Массив;
	Для Каждого СтрокаТоваров Из СтрокиТоваров Цикл
		Если ВключатьНоменклатуру Тогда
			Части.Добавить(Строка(СтрокаТоваров.Номенклатура) + "|"
				+ Формат(СтрокаТоваров.Количество, "ЧДЦ=3;ЧН=0") + "|"
				+ Формат(СтрокаТоваров.Сумма, "ЧДЦ=2;ЧН=0"));
		Иначе
			Части.Добавить(Формат(СтрокаТоваров.Количество, "ЧДЦ=3;ЧН=0") + "|"
				+ Формат(СтрокаТоваров.Сумма, "ЧДЦ=2;ЧН=0"));
		КонецЕсли;
	КонецЦикла;

	Сортировка = Новый ТаблицаЗначений;
	Сортировка.Колонки.Добавить("Часть", Новый ОписаниеТипов("Строка"));
	Для Каждого Часть Из Части Цикл
		СтрокаСортировки = Сортировка.Добавить();
		СтрокаСортировки.Часть = Часть;
	КонецЦикла;
	Сортировка.Сортировать("Часть");

	Отсортированные = Новый Массив;
	Для Каждого СтрокаСортировки Из Сортировка Цикл
		Отсортированные.Добавить(СтрокаСортировки.Часть);
	КонецЦикла;

	Возврат СтрСоединить(Отсортированные, ";");

КонецФункции

// Возвращает строки товаров указанного документа из заранее загруженной таблицы.
//
// Параметры:
//  ВсеТовары - ТаблицаЗначений - товары всех документов, см. ТоварыДокументовПоВиду.
//  СсылкаДокумента - ДокументСсылка - документ, строки которого нужны.
//
// Возвращаемое значение:
//  ТаблицаЗначений - отобранные строки.
//
Функция СтрокиТоваровДокумента(ВсеТовары, СсылкаДокумента)

	Найденные = ВсеТовары.НайтиСтроки(Новый Структура("Ссылка", СсылкаДокумента));
	Если Найденные.Количество() = 0 Тогда
		Возврат ВсеТовары.Скопировать(Новый Массив, "Номенклатура, Количество, Сумма");
	КонецЕсли;

	Возврат ВсеТовары.Скопировать(Найденные, "Номенклатура, Количество, Сумма");

КонецФункции

// Выполняет первый этап: привязка поступлений и приходных ордеров к заказам поставщику.
//
// Параметры:
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  Счетчики - Структура - счётчики выполнения (Обработано, Успешно, Ошибок).
//
Процедура ЭтапПоЗаказам(Журнал, Счетчики)

	СохранитьЖурналВРегистр(Журнал);

	ПропускиПревышения = Новый Массив;

	Заказы = ЗаказыДляАвтопривязки();
	Если Заказы.Количество() = 0 Тогда
		ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", Документы.ПриобретениеТоваровУслуг.ПустаяСсылка(), НСтр("ru = 'Поиск заказов'"),
			НСтр("ru = 'Пропуск'"), НСтр("ru = 'Нет заказов поставщику без привязанных поступлений.'"));
		СохранитьЖурналВРегистр(Журнал);
		Возврат;
	КонецЕсли;

	ВсеПоступления = ВсеПоступленияДляПривязки();
	ТоварыПоступлений = ТоварыДокументовПоВиду("ПриобретениеТоваровУслуг");
	ТоварыЗаказов = ТоварыДокументовПоВиду("ЗаказПоставщику");
	ВсеОрдера = БесхозныеОрдера();
	ТоварыОрдеров = ТоварыДокументовПоВиду("ПриходныйОрдерНаТовары");
	ОрдераЗаказов = ОрдераПривязанныеКЗаказам(Заказы);
	РасходЗаказов = РасходныеДокументыЗаказов(Заказы);
	ПоступленияЗаказов = ПоступленияПривязанныеКЗаказам(Заказы);
	ТоварыДляЗаполнения = СтрокиЗаказовДляЗаполнения(Заказы);

	КонтекстПривязки = Новый Структура;
	КонтекстПривязки.Вставить("ОрдераЗаказов", ОрдераЗаказов);
	КонтекстПривязки.Вставить("ТоварыОрдеров", ТоварыОрдеров);
	КонтекстПривязки.Вставить("РасходЗаказов", РасходЗаказов);
	КонтекстПривязки.Вставить("ПоступленияЗаказов", ПоступленияЗаказов);
	КонтекстПривязки.Вставить("ТоварыДляЗаполнения", ТоварыДляЗаполнения);

	ВсегоЗаказов = Заказы.Количество();
	Номер = 0;
	Для Каждого Заказ Из Заказы Цикл

		Номер = Номер + 1;
		Счетчики.Обработано = Счетчики.Обработано + 1;
		ДлительныеОперации.СообщитьПрогресс(Номер * 100 / ВсегоЗаказов,
			СтрШаблон(НСтр("ru = 'Заказ %1 из %2'"), Номер, ВсегоЗаказов));

		Попытка

			// Непроведённый заказ нельзя использовать как основание.
			ОбеспечитьПроведениеДокумента(Заказ.Ссылка);

			СтрокиЗаказа = СтрокиТоваровДокумента(ТоварыЗаказов, Заказ.Ссылка);

			Поступление = НайтиПоступлениеДляЗаказа(Заказ, СтрокиЗаказа,
				ВсеПоступления, ТоварыПоступлений);

			Распоряжение = Неопределено;
			ТоварыРаспоряжения = Неопределено;

			Если ЗначениеЗаполнено(Поступление) Тогда
				Если ПривязатьПоступлениеКЗаказу(Поступление, Заказ.Ссылка, Журнал, Счетчики, ПропускиПревышения,
					КонтекстПривязки) Тогда
					Распоряжение = Поступление;
					ТоварыРаспоряжения = ТоварыПоступлений;
				КонецЕсли;
			Иначе
				ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", Заказ.Ссылка,
					НСтр("ru = 'Поиск поступления'"), НСтр("ru = 'Пропуск'"),
					НСтр("ru = 'Поступление с совпадающими поставщиком, суммой и складом не найдено.'"));
			КонецЕсли;

			Если Распоряжение = Неопределено Тогда
				Распоряжение = Заказ.Ссылка;
				ТоварыРаспоряжения = ТоварыЗаказов;
			КонецЕсли;

			СтрокиРаспоряжения = СтрокиТоваровДокумента(ТоварыРаспоряжения, Распоряжение);
			Ордер = НайтиОрдерПоСоставу(СтрокиРаспоряжения, ВсеОрдера, ТоварыОрдеров);

			Если ЗначениеЗаполнено(Ордер) Тогда
				Привязан = ПривязатьОрдерКРаспоряжению(Ордер, Распоряжение, Журнал, Счетчики, "ПоЗаказам", ПропускиПревышения);
				// Ордер привязан прямо к заказу — заказ считается подтверждённым.
				Если Привязан И Распоряжение = Заказ.Ссылка Тогда
					УстановитьСтатусПодтвержден(Заказ.Ссылка, Журнал, Счетчики, "ПоЗаказам");
				КонецЕсли;
			Иначе
				ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", Распоряжение,
					НСтр("ru = 'Поиск приходного ордера'"), НСтр("ru = 'Пропуск'"),
					НСтр("ru = 'Приходный ордер с совпадающим составом не найден.'"));
			КонецЕсли;

		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Счетчики.Ошибок = Счетчики.Ошибок + 1;
			ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", Заказ.Ссылка,
				НСтр("ru = 'Обработка заказа'"), НСтр("ru = 'Ошибка'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;

		СохранитьЖурналВРегистр(Журнал);

	КонецЦикла;

	// Диагностика пропусков по превышению заказа — одним запросом после цикла.
	ДописатьДиагностикуПревышений(Журнал, ПропускиПревышения);

КонецПроцедуры

// Выполняет второй этап: привязка бесхозных поступлений к заказам
// и бесхозных приходных ордеров к поступлениям.
//
// Параметры:
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  Счетчики - Структура - счётчики выполнения (Обработано, Успешно, Ошибок).
//
Процедура ЭтапПоДокументам(Журнал, Счетчики)

	СохранитьЖурналВРегистр(Журнал);

	ПропускиПревышения = Новый Массив;

	Заказы = ЗаказыДляАвтопривязки();
	Поступления = БесхозныеПоступления();
	ТоварыПоступлений = ТоварыДокументовПоВиду("ПриобретениеТоваровУслуг");
	ТоварыЗаказов = ТоварыДокументовПоВиду("ЗаказПоставщику");
	ТоварыОрдеров = ТоварыДокументовПоВиду("ПриходныйОрдерНаТовары");
	ОрдераЗаказов = ОрдераПривязанныеКЗаказам(Заказы);
	РасходЗаказов = РасходныеДокументыЗаказов(Заказы);
	ПоступленияЗаказов = ПоступленияПривязанныеКЗаказам(Заказы);
	ТоварыДляЗаполнения = СтрокиЗаказовДляЗаполнения(Заказы);

	КонтекстПривязки = Новый Структура;
	КонтекстПривязки.Вставить("ОрдераЗаказов", ОрдераЗаказов);
	КонтекстПривязки.Вставить("ТоварыОрдеров", ТоварыОрдеров);
	КонтекстПривязки.Вставить("РасходЗаказов", РасходЗаказов);
	КонтекстПривязки.Вставить("ПоступленияЗаказов", ПоступленияЗаказов);
	КонтекстПривязки.Вставить("ТоварыДляЗаполнения", ТоварыДляЗаполнения);

	Всего = Поступления.Количество();
	Номер = 0;

	Для Каждого Поступление Из Поступления Цикл

		Номер = Номер + 1;
		Счетчики.Обработано = Счетчики.Обработано + 1;
		Если Всего > 0 Тогда
			ДлительныеОперации.СообщитьПрогресс(Номер * 50 / Всего,
				СтрШаблон(НСтр("ru = 'Поступление %1 из %2'"), Номер, Всего));
		КонецЕсли;

		Попытка

			СтрокиПоступления = СтрокиТоваровДокумента(ТоварыПоступлений, Поступление.Ссылка);
			Заказ = НайтиЗаказДляПоступления(Поступление, СтрокиПоступления, Заказы, ТоварыЗаказов);

			Если ЗначениеЗаполнено(Заказ) Тогда
				ПривязатьПоступлениеКЗаказу(Поступление.Ссылка, Заказ, Журнал, Счетчики, ПропускиПревышения,
					КонтекстПривязки);
			Иначе
				ДобавитьСтрокуЖурнала(Журнал, "ПоДокументам", Поступление.Ссылка,
					НСтр("ru = 'Поиск заказа'"), НСтр("ru = 'Пропуск'"),
					НСтр("ru = 'Открытый заказ с совпадающими поставщиком, суммой и складом не найден.'"));
			КонецЕсли;

		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Счетчики.Ошибок = Счетчики.Ошибок + 1;
			ДобавитьСтрокуЖурнала(Журнал, "ПоДокументам", Поступление.Ссылка,
				НСтр("ru = 'Обработка поступления'"), НСтр("ru = 'Ошибка'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;

		СохранитьЖурналВРегистр(Журнал);

	КонецЦикла;

	Ордера = БесхозныеОрдера();
	ПоступленияСКонтрагентом = ПоступленияДляОрдеров();
	ТоварыКандидатов = ТоварыДокументовПоВиду("ПриобретениеТоваровУслуг");

	ВсегоОрдеров = Ордера.Количество();
	Номер = 0;

	Для Каждого Ордер Из Ордера Цикл

		Номер = Номер + 1;
		Счетчики.Обработано = Счетчики.Обработано + 1;
		Если ВсегоОрдеров > 0 Тогда
			ДлительныеОперации.СообщитьПрогресс(50 + Номер * 50 / ВсегоОрдеров,
				СтрШаблон(НСтр("ru = 'Ордер %1 из %2'"), Номер, ВсегоОрдеров));
		КонецЕсли;

		Попытка

			СтрокиОрдера = СтрокиТоваровДокумента(ТоварыОрдеров, Ордер.Ссылка);
			Поступление = НайтиПоступлениеПоСоставуОрдера(СтрокиОрдера, ПоступленияСКонтрагентом,
				ТоварыКандидатов);

			Если ЗначениеЗаполнено(Поступление) Тогда
				Если ПривязатьОрдерКРаспоряжению(Ордер.Ссылка, Поступление, Журнал, Счетчики, "ПоДокументам", ПропускиПревышения) Тогда
					// Ордер привязан к поступлению — подтверждаем заказ этого поступления.
					УстановитьСтатусПодтвержден(ЗаказПоРаспоряжению(Поступление), Журнал, Счетчики, "ПоДокументам");
				КонецЕсли;
			Иначе
				ДобавитьСтрокуЖурнала(Журнал, "ПоДокументам", Ордер.Ссылка,
					НСтр("ru = 'Поиск поступления'"), НСтр("ru = 'Пропуск'"),
					НСтр("ru = 'Поступление с совпадающим составом не найдено.'"));
			КонецЕсли;

		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Счетчики.Ошибок = Счетчики.Ошибок + 1;
			ДобавитьСтрокуЖурнала(Журнал, "ПоДокументам", Ордер.Ссылка,
				НСтр("ru = 'Обработка приходного ордера'"), НСтр("ru = 'Ошибка'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		КонецПопытки;

		СохранитьЖурналВРегистр(Журнал);

	КонецЦикла;

	// Диагностика пропусков по превышению заказа — одним запросом после циклов.
	ДописатьДиагностикуПревышений(Журнал, ПропускиПревышения);

КонецПроцедуры

// Возвращает все поступления, которые могут быть привязаны к заказу
// (без заказа и без пометки удаления).
//
// Возвращаемое значение:
//  ТаблицаЗначений - поступления (Ссылка, Партнер, СуммаДокумента, Склад, ЗаказПоставщику, Дата).
//
Функция ВсеПоступленияДляПривязки()

	Возврат БесхозныеПоступления();

КонецФункции

// Возвращает поступления, которые могут быть основанием приходного ордера.
//
// Возвращаемое значение:
//  ТаблицаЗначений - поступления (Ссылка, Партнер, СуммаДокумента, Склад, ЗаказПоставщику, Дата).
//
Функция ПоступленияДляОрдеров()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПТУ.Ссылка КАК Ссылка,
	|	ПТУ.Партнер КАК Партнер,
	|	ПТУ.СуммаДокумента КАК СуммаДокумента,
	|	ПТУ.Склад КАК Склад,
	|	ПТУ.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ПТУ.Дата КАК Дата
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПТУ
	|ГДЕ
	|	НЕ ПТУ.ПометкаУдаления
	|	И ПТУ.ЗаказПоставщику <> ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПТУ.Дата";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Подбирает поступление для заказа по поставщику, сумме и складу.
//
// Параметры:
//  Заказ - СтрокаТаблицыЗначений - заказ (Ссылка, Партнер, СуммаДокумента, Склад).
//  СтрокиЗаказа - ТаблицаЗначений - товары заказа.
//  ВсеПоступления - ТаблицаЗначений - бесхозные поступления.
//  ТоварыПоступлений - ТаблицаЗначений - товары поступлений.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриобретениеТоваровУслуг, Неопределено - найденное поступление.
//
Функция НайтиПоступлениеДляЗаказа(Заказ, СтрокиЗаказа, ВсеПоступления, ТоварыПоступлений)

	Кандидаты = Новый Массив;

	Для Каждого Поступление Из ВсеПоступления Цикл
		Если Поступление.Партнер <> Заказ.Партнер Тогда
			Продолжить;
		КонецЕсли;
		Если Поступление.СуммаДокумента <> Заказ.СуммаДокумента Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Поступление.Склад) И ЗначениеЗаполнено(Заказ.Склад)
			И Поступление.Склад <> Заказ.Склад Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты.Добавить(Поступление);
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0].Ссылка;
	КонецЕсли;

	КлючЗаказа = КлючСостава(СтрокиЗаказа, Истина);
	Найденные = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		СтрокиКандидата = СтрокиТоваровДокумента(ТоварыПоступлений, Кандидат.Ссылка);
		Если КлючСостава(СтрокиКандидата, Истина) = КлючЗаказа Тогда
			Найденные.Добавить(Кандидат.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Подбирает заказ для бесхозного поступления по поставщику, сумме и складу.
//
// Параметры:
//  Поступление - СтрокаТаблицыЗначений - поступление (Ссылка, Партнер, СуммаДокумента, Склад).
//  СтрокиПоступления - ТаблицаЗначений - товары поступления.
//  Заказы - ТаблицаЗначений - открытые заказы поставщику.
//  ТоварыЗаказов - ТаблицаЗначений - товары заказов.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику, Неопределено - найденный заказ.
//
Функция НайтиЗаказДляПоступления(Поступление, СтрокиПоступления, Заказы, ТоварыЗаказов)

	Кандидаты = Новый Массив;

	Для Каждого Заказ Из Заказы Цикл
		Если Заказ.Партнер <> Поступление.Партнер Тогда
			Продолжить;
		КонецЕсли;
		Если Заказ.СуммаДокумента <> Поступление.СуммаДокумента Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Поступление.Склад) И ЗначениеЗаполнено(Заказ.Склад)
			И Поступление.Склад <> Заказ.Склад Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты.Добавить(Заказ);
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0].Ссылка;
	КонецЕсли;

	КлючПоступления = КлючСостава(СтрокиПоступления, Истина);
	Найденные = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		СтрокиКандидата = СтрокиТоваровДокумента(ТоварыЗаказов, Кандидат.Ссылка);
		Если КлючСостава(СтрокиКандидата, Истина) = КлючПоступления Тогда
			Найденные.Добавить(Кандидат.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Подбирает приходный ордер по составу документа-основания.
//
// Сопоставление выполняется в два прохода: сначала «номенклатура + количество + сумма»,
// затем «количество + сумма». Сумма ордера рассчитывается по ценам документа-основания.
//
// Параметры:
//  СтрокиОснования - ТаблицаЗначений - товары документа-основания (Номенклатура, Количество, Сумма).
//  Ордера - ТаблицаЗначений - бесхозные приходные ордера.
//  ТоварыОрдеров - ТаблицаЗначений - товары приходных ордеров.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриходныйОрдерНаТовары, Неопределено - найденный ордер.
//
Функция НайтиОрдерПоСоставу(СтрокиОснования, Ордера, ТоварыОрдеров)

	Если СтрокиОснования.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Цены = Новый Соответствие;
	СуммаОснования = 0;
	КоличествоОснования = 0;
	Для Каждого СтрокаОснования Из СтрокиОснования Цикл
		Если СтрокаОснования.Количество <> 0 Тогда
			Цены.Вставить(СтрокаОснования.Номенклатура,
				СтрокаОснования.Сумма / СтрокаОснования.Количество);
		КонецЕсли;
		СуммаОснования = СуммаОснования + СтрокаОснования.Сумма;
		КоличествоОснования = КоличествоОснования + СтрокаОснования.Количество;
	КонецЦикла;

	КлючПоНоменклатуре = КлючСостава(СтрокиОснования, Истина);
	КлючПоКоличеству = КлючСостава(СтрокиОснования, Ложь);

	НайденныеПоНоменклатуре = Новый Массив;
	НайденныеПоКоличеству = Новый Массив;

	Для Каждого Ордер Из Ордера Цикл

		СтрокиОрдера = СтрокиТоваровДокумента(ТоварыОрдеров, Ордер.Ссылка);
		Если СтрокиОрдера.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоОрдера = 0;
		СтрокиСуммами = Новый ТаблицаЗначений;
		СтрокиСуммами.Колонки.Добавить("Номенклатура");
		СтрокиСуммами.Колонки.Добавить("Количество");
		СтрокиСуммами.Колонки.Добавить("Сумма");

		Для Каждого СтрокаОрдера Из СтрокиОрдера Цикл
			Цена = Цены.Получить(СтрокаОрдера.Номенклатура);
			Если Цена = Неопределено Тогда
				Цена = 0;
			КонецЕсли;

			СтрокаСуммой = СтрокиСуммами.Добавить();
			СтрокаСуммой.Номенклатура = СтрокаОрдера.Номенклатура;
			СтрокаСуммой.Количество = СтрокаОрдера.Количество;
			СтрокаСуммой.Сумма = СтрокаОрдера.Количество * Цена;
			КоличествоОрдера = КоличествоОрдера + СтрокаОрдера.Количество;
		КонецЦикла;

		Если КоличествоОрдера <> КоличествоОснования Тогда
			Продолжить;
		КонецЕсли;

		Если КлючСостава(СтрокиСуммами, Истина) = КлючПоНоменклатуре Тогда
			НайденныеПоНоменклатуре.Добавить(Ордер.Ссылка);
		ИначеЕсли КлючСостава(СтрокиСуммами, Ложь) = КлючПоКоличеству Тогда
			НайденныеПоКоличеству.Добавить(Ордер.Ссылка);
		КонецЕсли;

	КонецЦикла;

	Если НайденныеПоНоменклатуре.Количество() = 1 Тогда
		Возврат НайденныеПоНоменклатуре[0];
	КонецЕсли;

	Если НайденныеПоКоличеству.Количество() = 1 Тогда
		Возврат НайденныеПоКоличеству[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Подбирает поступление для бесхозного приходного ордера по составу.
//
// Сопоставление выполняется в два прохода: «номенклатура + количество + сумма»
// и «количество + сумма». Сумма ордера рассчитывается по ценам поступления.
//
// Параметры:
//  СтрокиОрдера - ТаблицаЗначений - товары ордера.
//  Поступления - ТаблицаЗначений - поступления, которые могут быть основанием.
//  ТоварыПоступлений - ТаблицаЗначений - товары поступлений.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриобретениеТоваровУслуг, Неопределено - найденное поступление.
//
Функция НайтиПоступлениеПоСоставуОрдера(СтрокиОрдера, Поступления, ТоварыПоступлений)

	Если СтрокиОрдера.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КоличествоОрдера = 0;
	Для Каждого СтрокаОрдера Из СтрокиОрдера Цикл
		КоличествоОрдера = КоличествоОрдера + СтрокаОрдера.Количество;
	КонецЦикла;

	Кандидаты = Новый Массив;
	Для Каждого Поступление Из Поступления Цикл
		СтрокиПоступления = СтрокиТоваровДокумента(ТоварыПоступлений, Поступление.Ссылка);
		КоличествоПоступления = 0;
		Для Каждого СтрокаПоступления Из СтрокиПоступления Цикл
			КоличествоПоступления = КоличествоПоступления + СтрокаПоступления.Количество;
		КонецЦикла;
		Если КоличествоПоступления = КоличествоОрдера Тогда
			Кандидаты.Добавить(Поступление.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Если Кандидаты.Количество() = 1 Тогда
		Возврат Кандидаты[0];
	КонецЕсли;

	НайденныеПоНоменклатуре = Новый Массив;
	НайденныеПоКоличеству = Новый Массив;

	Для Каждого Кандидат Из Кандидаты Цикл

		СтрокиПоступления = СтрокиТоваровДокумента(ТоварыПоступлений, Кандидат);
		Ключи = КлючиСоответствияОрдераПоступлению(СтрокиОрдера, СтрокиПоступления);

		Если Ключи.ПоНоменклатуре Тогда
			НайденныеПоНоменклатуре.Добавить(Кандидат);
		ИначеЕсли Ключи.ПоКоличеству Тогда
			НайденныеПоКоличеству.Добавить(Кандидат);
		КонецЕсли;

	КонецЦикла;

	Если НайденныеПоНоменклатуре.Количество() = 1 Тогда
		Возврат НайденныеПоНоменклатуре[0];
	КонецЕсли;

	Если НайденныеПоКоличеству.Количество() = 1 Тогда
		Возврат НайденныеПоКоличеству[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Сравнивает состав ордера и поступления двумя проходами.
//
// Сумма ордера рассчитывается по ценам поступления.
//
// Параметры:
//  СтрокиОрдера - ТаблицаЗначений - товары ордера.
//  СтрокиПоступления - ТаблицаЗначений - товары поступления.
//
// Возвращаемое значение:
//  Структура - результат сравнения:
//   * ПоНоменклатуре - Булево - совпали номенклатура, количество и сумма;
//   * ПоКоличеству - Булево - совпали количество и сумма без номенклатуры.
//
Функция КлючиСоответствияОрдераПоступлению(СтрокиОрдера, СтрокиПоступления)

	Результат = Новый Структура;
	Результат.Вставить("ПоНоменклатуре", Ложь);
	Результат.Вставить("ПоКоличеству", Ложь);

	Цены = ЦеныСтрок(СтрокиПоступления);

	СтрокиСуммами = Новый ТаблицаЗначений;
	СтрокиСуммами.Колонки.Добавить("Номенклатура");
	СтрокиСуммами.Колонки.Добавить("Количество");
	СтрокиСуммами.Колонки.Добавить("Сумма");

	Для Каждого СтрокаОрдера Из СтрокиОрдера Цикл
		Цена = Цены.Получить(СтрокаОрдера.Номенклатура);
		Если Цена = Неопределено Тогда
			Цена = 0;
		КонецЕсли;
		СтрокаСуммой = СтрокиСуммами.Добавить();
		СтрокаСуммой.Номенклатура = СтрокаОрдера.Номенклатура;
		СтрокаСуммой.Количество = СтрокаОрдера.Количество;
		СтрокаСуммой.Сумма = СтрокаОрдера.Количество * Цена;
	КонецЦикла;

	Результат.ПоНоменклатуре = КлючСостава(СтрокиСуммами, Истина)
		= КлючСостава(СтрокиПоступления, Истина);
	Результат.ПоКоличеству = КлючСостава(СтрокиСуммами, Ложь)
		= КлючСостава(СтрокиПоступления, Ложь);

	Возврат Результат;

КонецФункции

// Возвращает цены номенклатуры по строкам одного документа.
//
// Параметры:
//  СтрокиДокумента - ТаблицаЗначений - товары документа (Номенклатура, Количество, Сумма).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - номенклатура -> цена.
//
Функция ЦеныСтрок(СтрокиДокумента)

	Цены = Новый Соответствие;
	Для Каждого СтрокаТоваров Из СтрокиДокумента Цикл
		Если СтрокаТоваров.Количество <> 0 Тогда
			Цены.Вставить(СтрокаТоваров.Номенклатура, СтрокаТоваров.Сумма / СтрокаТоваров.Количество);
		КонецЕсли;
	КонецЦикла;

	Возврат Цены;

КонецФункции

// Проводит документ, если он не проведён.
//
// Ввод на основании непроведённого документа платформа запрещает, поэтому
// заказ-основание и распоряжение перед использованием проводятся.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ, который должен быть проведён.
//
// Возвращаемое значение:
//  Булево - Истина, если документ проведён.
//
Функция ОбеспечитьПроведениеДокумента(ДокументСсылка)

	Объект = ДокументСсылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Объект.Проведен Тогда
		Возврат Истина;
	КонецЕсли;

	ПровестиДокумент(Объект);

	Возврат Объект.Проведен;

КонецФункции

// Привязывает поступление к заказу: перезаполняет документ по заказу
// и записывает его в режиме проведения.
//
// Параметры:
//  ПоступлениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - привязываемый документ.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  Счетчики - Структура - счётчики выполнения.
//  ПропускиПревышения - Массив из Структура - сюда добавляются пропуски по превышению
//                       заказа для последующей диагностики одним запросом.
//  ОрдераЗаказов - Соответствие из КлючИЗначение - заказ -> массив ордеров, привязанных
//                  к заказу, см. ОрдераПривязанныеКЗаказам.
//  ТоварыОрдеров - ТаблицаЗначений - строки товаров приходных ордеров.
//  ПропускиПревышения - Массив из Структура - сюда добавляются пропуски по превышению
//                       заказа для последующей диагностики одним запросом.
//  Контекст - Структура - данные, подготовленные на этап:
//   * ОрдераЗаказов - Соответствие - заказ -> массив ордеров, см. ОрдераПривязанныеКЗаказам;
//   * ТоварыОрдеров - ТаблицаЗначений - строки товаров приходных ордеров;
//   * РасходЗаказов - Соответствие - заказ -> массив израсходовавших его документов,
//                     см. РасходныеДокументыЗаказов;
//   * ПоступленияЗаказов - Соответствие - заказ -> массив проведённых поступлений,
//                          привязанных к заказу, см. ПоступленияПривязанныеКЗаказам.
//
// Возвращаемое значение:
//  Булево - Истина, если документ привязан и проведён.
//
Функция ПривязатьПоступлениеКЗаказу(ПоступлениеСсылка, ЗаказСсылка, Журнал, Счетчики, ПропускиПревышения,
	Контекст)

	ОрдераЗаказов = Контекст.ОрдераЗаказов;
	ТоварыОрдеров = Контекст.ТоварыОрдеров;
	РасходЗаказов = Контекст.РасходЗаказов;
	ПоступленияЗаказов = Контекст.ПоступленияЗаказов;
	ТоварыДляЗаполнения = Контекст.ТоварыДляЗаполнения;

	// Сначала проверяются связанные документы: если заказ уже закрыт другим	// проведённым поступлением, второе оформление того же количества ERP не примет,
	// и тратить время на перезаполнение и освобождение заказа от ордеров незачем.
	СвязанныеПоступления = ПоступленияЗаказов.Получить(ЗаказСсылка);
	ДругиеПоступления = Новый Массив;
	Если СвязанныеПоступления <> Неопределено Тогда
		Для Каждого СвязанноеПоступление Из СвязанныеПоступления Цикл
			Если СвязанноеПоступление <> ПоступлениеСсылка Тогда
				ДругиеПоступления.Добавить(СвязанноеПоступление);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ДругиеПоступления.Количество() > 0 Тогда
		ПредставленияПоступлений = Новый Массив;
		Для Каждого ДругоеПоступление Из ДругиеПоступления Цикл
			ПредставленияПоступлений.Добавить(Строка(ДругоеПоступление));
		КонецЦикла;
		ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
			НСтр("ru = 'Проверка связанных документов'"), НСтр("ru = 'Пропуск'"),
			СтрШаблон(
				НСтр("ru = 'Заказ-основание: %1. Заказ уже закрыт проведённым поступлением: %2 — привязка не выполняется.'"),
				Строка(ЗаказСсылка), СтрСоединить(ПредставленияПоступлений, ", ")));
		Возврат Ложь;
	КонецЕсли;

	// Перечень связанных документов пишется до попытки проведения: если обработку
	// остановят, в журнале всё равно останется, чем заказ уже занят.
	ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
		НСтр("ru = 'Проверка связанных документов'"), НСтр("ru = 'Информация'"),
		СтрШаблон(НСтр("ru = 'Заказ-основание: %1. %2'"), Строка(ЗаказСсылка),
			ТекстСвязанныхДокументовЗаказа(ЗаказСсылка, ОрдераЗаказов, РасходЗаказов)));

	Попытка
		Объект = ПоступлениеСсылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ %1 недоступен для изменения.'"),
				ПоступлениеСсылка);
		КонецЕсли;

		// Непроведённый заказ нельзя использовать как основание для ввода.
		ОбеспечитьПроведениеДокумента(ЗаказСсылка);

		// Ввод на основании разрешён только для подтверждённого или закрытого заказа,
		// поэтому статус ставится ДО заполнения поступления.
		УстановитьСтатусПодтвержден(ЗаказСсылка, Журнал, Счетчики, "ПоЗаказам");

		// Склад заполняется перекрёстно: заказ и поступление обмениваются складом,
		// иначе у документа с товарами остаётся пустое место хранения.
		СкладПоступления = Объект.Склад;
		СкладЗаказа = СкладДокумента(ЗаказСсылка);

		Если НЕ ЗначениеЗаполнено(СкладЗаказа) И ЗначениеЗаполнено(СкладПоступления) Тогда
			ЗаполнитьСкладДокумента(ЗаказСсылка, СкладПоступления);
			СкладЗаказа = СкладПоступления;
		КонецЕсли;

		Склад = ?(ЗначениеЗаполнено(СкладЗаказа), СкладЗаказа, СкладПоступления);

		// Фиксируем состояние до перезаполнения: журнал должен показывать, что
		// реально изменилось в документе, а не только слово «Успех».
		БылоПоступлениеПоЗаказам = Объект.ПоступлениеПоЗаказам;
		БылоЗаказПоставщику = Объект.ЗаказПоставщику;
		БылоСтрокТоваров = Объект.Товары.Количество();

		// Состав пересобирается так же, как это делается вручную в форме
		// поступления: товары очищаются, включается «Поступление по заказам»,
		// в шапку ставится заказ, а строки добавляются из документа-заказа
		// вместе с кодом строки. Объект.Заполнить(ЗаказСсылка) для этого
		// не годится: ERP заполняет товары по остаткам регистра
		// «ЗаказыПоставщикам» и теряет строки, которые заказом уже оформлены.
		Объект.Товары.Очистить();
		Объект.ПоступлениеПоЗаказам = Истина;
		Объект.ЗаказПоставщику = ЗаказСсылка;

		ЗаполнитьТоварыИзЗаказа(Объект, ЗаказСсылка, Склад, ТоварыДляЗаполнения);

		Если Объект.Товары.Количество() = 0 Тогда
			ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
				НСтр("ru = 'Привязка поступления к заказу'"), НСтр("ru = 'Пропуск'"),
				СтрШаблон(
					НСтр("ru = 'В заказе %1 нет ни одной строки товаров — заполнять нечем.'"),
					Строка(ЗаказСсылка)));
			Возврат Ложь;
		КонецЕсли;

		// Состав берётся из заказа целиком, поэтому собственное превышение здесь
		// невозможно: ERP сравнит его с остатком при проведении. Если заказ уже
		// оформлен другими документами, причина отказа попадёт в журнал из
		// ПровестиДокумент и будет обработана как пропуск.

		Если ЗначениеЗаполнено(Склад) Тогда
			Объект.Склад = Склад;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось определить склад: он не заполнен ни в заказе, ни в поступлении.'");
		КонецЕсли;

		ПровестиДокумент(Объект);

		// Перечитываем документ из базы объектом (без кэшей реквизитов): объект
		// в памяти мог быть изменён, а запись отменена (Отказ в ПередЗаписью,
		// подписка) — тогда в базе документ остаётся прежним.
		ОбъектВБазе = ПоступлениеСсылка.ПолучитьОбъект();
		Если ОбъектВБазе = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Документ %1 не удалось перечитать после записи.'"), ПоступлениеСсылка);
		КонецЕсли;

		Если ОбъектВБазе.ПоступлениеПоЗаказам <> Объект.ПоступлениеПоЗаказам
			ИЛИ ОбъектВБазе.ЗаказПоставщику <> Объект.ЗаказПоставщику Тогда
			ПричиныЗаписи = ТекстСообщенийПроведения();
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Изменения не сохранились. В базе: поступление по заказам = %1, заказ = %2, проведён = %3. Причины: %4.'"),
				?(ОбъектВБазе.ПоступлениеПоЗаказам, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'")),
				?(ЗначениеЗаполнено(ОбъектВБазе.ЗаказПоставщику),
					Строка(ОбъектВБазе.ЗаказПоставщику), НСтр("ru = 'пусто'")),
				?(ОбъектВБазе.Проведен, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'")),
				?(ЗначениеЗаполнено(ПричиныЗаписи), ПричиныЗаписи,
					НСтр("ru = 'платформа не сообщила причину'")));
		КонецЕсли;

		Счетчики.Успешно = Счетчики.Успешно + 1;
		ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
			НСтр("ru = 'Привязка поступления к заказу'"), НСтр("ru = 'Успех'"),
			СтрШаблон(
				НСтр("ru = 'Заказ-основание: %1. Поступление по заказам: %2 → %3; заказ в шапке: %4 → %5; строк товаров: %6 → %7. Документ проведён.'"),
				Строка(ЗаказСсылка),
				?(БылоПоступлениеПоЗаказам, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'")),
				?(Объект.ПоступлениеПоЗаказам, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'")),
				?(ЗначениеЗаполнено(БылоЗаказПоставщику), Строка(БылоЗаказПоставщику), НСтр("ru = 'пусто'")),
				?(ЗначениеЗаполнено(Объект.ЗаказПоставщику), Строка(Объект.ЗаказПоставщику), НСтр("ru = 'пусто'")),
				БылоСтрокТоваров, Объект.Товары.Количество()));

		Возврат Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		// ERP отказала из-за превышения заказанного: заказ уже оформлен другими
		// документами, и привязать к нему это поступление нельзя. Это не сбой
		// обработки, а штатный пропуск — причина берётся из сообщений ERP.
		ТекстПревышения = ТекстПревышенияЗаказа(ИнформацияОбОшибке);
		Если ЗначениеЗаполнено(ТекстПревышения) Тогда

			// Заказ израсходован другими документами. Если его израсходовали приходные
			// ордера (в том числе без распоряжения), их можно снять с заказа: заказ
			// освободится, поступление привяжется, а ордера перенесутся на него.
			Если ПеренестиОрдераНаПоступление(ПоступлениеСсылка, ЗаказСсылка, Журнал, Счетчики,
				ОрдераЗаказов, ТоварыОрдеров, РасходЗаказов) Тогда
				Счетчики.Успешно = Счетчики.Успешно + 1;
				ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
					НСтр("ru = 'Привязка поступления к заказу'"), НСтр("ru = 'Успех'"),
					СтрШаблон(
						НСтр("ru = 'Заказ-основание: %1. Заказ освобождён от приходных ордеров: поступление привязано, ордера перенесены на него как основание.'"),
						Строка(ЗаказСсылка)));
				Возврат Истина;
			КонецЕсли;

			ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
				НСтр("ru = 'Привязка поступления к заказу'"), НСтр("ru = 'Пропуск'"),
				СтрШаблон(НСтр("ru = 'Заказ-основание: %1. %2'"), Строка(ЗаказСсылка),
					ТекстПревышения));
			ЗапомнитьПропускПревышения(ПропускиПревышения, "ПоЗаказам", ПоступлениеСсылка,
				НСтр("ru = 'Привязка поступления к заказу'"), ЗаказСсылка,
				ПозицииДокумента(Объект.Товары, Объект.Склад));
			Возврат Ложь;
		КонецЕсли;

		Счетчики.Ошибок = Счетчики.Ошибок + 1;
		ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
			НСтр("ru = 'Привязка поступления к заказу'"), НСтр("ru = 'Ошибка'"),
			СтрШаблон(НСтр("ru = 'Заказ-основание: %1. %2'"), Строка(ЗаказСсылка),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Заполняет табличную часть «Товары» поступления строками заказа поставщику.
//
// Строки копируются из документа-заказа вместе с кодом строки и ссылкой на заказ:
// это тот же состав, который получается при ручном заполнении в форме — очистить
// товары, включить «Поступление по заказам» и добавить строки из заказа.
//
// Параметры:
//  Объект - ДокументОбъект.ПриобретениеТоваровУслуг - заполняемый документ.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//  Склад - СправочникСсылка.Склады - склад для строк, у которых склад не заполнен.
//  СтрокиЗаказов - ТаблицаЗначений - строки заказов, загруженные заранее,
//                  см. СтрокиЗаказовДляЗаполнения.
//
// Возвращаемое значение:
//  Число - количество заполненных строк товаров.
//
Функция ЗаполнитьТоварыИзЗаказа(Объект, ЗаказСсылка, Склад, СтрокиЗаказов)

	СтрокиЗаказа = СтрокиЗаказов.НайтиСтроки(Новый Структура("Ссылка", ЗаказСсылка));

	Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказа);
		НоваяСтрока.ЗаказПоставщику = ЗаказСсылка;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Склад) Тогда
			НоваяСтрока.Склад = Склад;
		КонецЕсли;
	КонецЦикла;

	Возврат Объект.Товары.Количество();

КонецФункции

// Загружает строки товаров заказов поставщику для заполнения поступлений.
//
// Запрос выполняется один раз на этап, до циклов обработки: внутри цикла
// привязки он запрещён (SU95 «запрос в цикле»).
//
// Параметры:
//  Заказы - ТаблицаЗначений - заказы с колонкой Ссылка, см. ЗаказыДляАвтопривязки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки товаров заказов; колонки соответствуют реквизитам
//                    табличной части «Товары» заказа плюс колонка Ссылка.
//
Функция СтрокиЗаказовДляЗаполнения(Заказы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыЗаказа.Ссылка КАК Ссылка,
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.Характеристика КАК Характеристика,
	|	ТоварыЗаказа.Упаковка КАК Упаковка,
	|	ТоварыЗаказа.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ТоварыЗаказа.Количество КАК Количество,
	|	ТоварыЗаказа.ВидЦеныПоставщика КАК ВидЦеныПоставщика,
	|	ТоварыЗаказа.Цена КАК Цена,
	|	ТоварыЗаказа.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
	|	ТоварыЗаказа.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
	|	ТоварыЗаказа.Сумма КАК Сумма,
	|	ТоварыЗаказа.СтавкаНДС КАК СтавкаНДС,
	|	ТоварыЗаказа.СуммаНДС КАК СуммаНДС,
	|	ТоварыЗаказа.СуммаСНДС КАК СуммаСНДС,
	|	ТоварыЗаказа.КодСтроки КАК КодСтроки,
	|	ТоварыЗаказа.Склад КАК Склад,
	|	ТоварыЗаказа.Назначение КАК Назначение,
	|	ТоварыЗаказа.Подразделение КАК Подразделение,
	|	ТоварыЗаказа.СписатьНаРасходы КАК СписатьНаРасходы,
	|	ТоварыЗаказа.СтатьяРасходов КАК СтатьяРасходов,
	|	ТоварыЗаказа.АналитикаРасходов КАК АналитикаРасходов,
	|	ТоварыЗаказа.НоменклатураПартнера КАК НоменклатураПартнера
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ТоварыЗаказа
	|ГДЕ
	|	ТоварыЗаказа.Ссылка В (&Заказы)
	|	И НЕ ТоварыЗаказа.Отменено
	|	И ТоварыЗаказа.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыЗаказа.Ссылка,
	|	ТоварыЗаказа.НомерСтроки";
	Запрос.УстановитьПараметр("Заказы", Заказы.ВыгрузитьКолонку("Ссылка"));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Привязывает приходный ордер к документу-основанию: заполняет распоряжение,
// перезаполняет строки из регистра «Товары к поступлению» и проводит ордер.
//
// Параметры:
//  ОрдерСсылка - ДокументСсылка.ПриходныйОрдерНаТовары - привязываемый ордер.
//  РаспоряжениеСсылка - ДокументСсылка - основание (поступление или заказ).
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  Счетчики - Структура - счётчики выполнения.
//  Этап - Строка - этап автопривязки.
//  ПропускиПревышения - Массив - сюда добавляются пропуски по превышению заказа.
//
// Возвращаемое значение:
//  Булево - Истина, если ордер привязан и проведён.
//
Функция ПривязатьОрдерКРаспоряжению(ОрдерСсылка, РаспоряжениеСсылка, Журнал, Счетчики, Этап, ПропускиПревышения)

	Попытка
		Объект = ОрдерСсылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ %1 недоступен для изменения.'"),
				ОрдерСсылка);
		КонецЕсли;

		// Основание ордера должно быть проведено — иначе запись ордера не пройдёт.
		ОбеспечитьПроведениеДокумента(РаспоряжениеСсылка);

		Объект.Распоряжение = РаспоряжениеСсылка;

		// Склад заполняется перекрёстно: ордер и основание обмениваются складом,
		// чтобы у всех документов цепочки было заполнено место хранения.
		СкладОрдера = Объект.Склад;
		СкладРаспоряжения = СкладДокумента(РаспоряжениеСсылка);

		Если НЕ ЗначениеЗаполнено(СкладРаспоряжения) И ЗначениеЗаполнено(СкладОрдера) Тогда
			ЗаполнитьСкладДокумента(РаспоряжениеСсылка, СкладОрдера);
			СкладРаспоряжения = СкладОрдера;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
			Объект.Склад = СкладРаспоряжения;
		КонецЕсли;

		// Склад передаётся и заказу, если основание — поступление.
		ЗаказРаспоряжения = ЗаказПоРаспоряжению(РаспоряжениеСсылка);
		Если ЗначениеЗаполнено(ЗаказРаспоряжения) Тогда
			ЗаполнитьСкладДокумента(ЗаказРаспоряжения,
				?(ЗначениеЗаполнено(СкладРаспоряжения), СкладРаспоряжения, СкладОрдера));
		КонецЕсли;

		// Строки перезаполняются из регистра «Товары к поступлению». Если по основанию
		// в регистре ничего нет, состав строк ордера сохраняется как был.
		ИсходныеСтроки = Объект.Товары.Выгрузить();
		Объект.ЗаполнитьТоварыПоТоварамКПоступлению("НоменклатураКоличество", Объект.Дата);
		Если Объект.Товары.Количество() = 0 И ИсходныеСтроки.Количество() > 0 Тогда
			Объект.Товары.Загрузить(ИсходныеСтроки);
		КонецЕсли;

		ПровестиДокумент(Объект);

		Счетчики.Успешно = Счетчики.Успешно + 1;
		ДобавитьСтрокуЖурнала(Журнал, Этап, ОрдерСсылка,
			НСтр("ru = 'Привязка приходного ордера'"), НСтр("ru = 'Успех'"),
			СтрШаблон(НСтр("ru = 'Основание: %1. Ордер записан и проведён.'"),
				Строка(РаспоряжениеСсылка)));

		Возврат Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();

		// Ордер оформляет заказ так же, как поступление: если ERP отказала
		// по превышению заказанного, привязка невозможна — это пропуск.
		ТекстПревышения = ТекстПревышенияЗаказа(ИнформацияОбОшибке);
		Если ЗначениеЗаполнено(ТекстПревышения) Тогда
			ДобавитьСтрокуЖурнала(Журнал, Этап, ОрдерСсылка,
				НСтр("ru = 'Привязка приходного ордера'"), НСтр("ru = 'Пропуск'"),
				СтрШаблон(НСтр("ru = 'Основание: %1. %2'"), Строка(РаспоряжениеСсылка),
					ТекстПревышения));
			ЗапомнитьПропускПревышения(ПропускиПревышения, Этап, ОрдерСсылка,
				НСтр("ru = 'Привязка приходного ордера'"),
				ЗаказПоРаспоряжению(РаспоряжениеСсылка));
			Возврат Ложь;
		КонецЕсли;

		Счетчики.Ошибок = Счетчики.Ошибок + 1;
		ДобавитьСтрокуЖурнала(Журнал, Этап, ОрдерСсылка,
			НСтр("ru = 'Привязка приходного ордера'"), НСтр("ru = 'Ошибка'"),
			СтрШаблон(НСтр("ru = 'Основание: %1. %2'"), Строка(РаспоряжениеСсылка),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Переводит заказ поставщику в статус «Подтвержден»: заказ считается
// подтверждённым, когда к нему найдено поступление или приходный ордер.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - подтверждаемый заказ.
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  Счетчики - Структура - счётчики выполнения.
//  Этап - Строка - этап автопривязки.
//
// Возвращаемое значение:
//  Булево - Истина, если заказ уже был подтверждён или статус установлен.
//
Функция УстановитьСтатусПодтвержден(ЗаказСсылка, Журнал, Счетчики, Этап)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыЗаказовПоставщикам") Тогда
		Возврат Ложь;
	КонецЕсли;

	СтатусПодтвержден = Перечисления.СтатусыЗаказовПоставщикам.Подтвержден;

	Попытка

		Объект = ЗаказСсылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ %1 недоступен для изменения.'"),
				ЗаказСсылка);
		КонецЕсли;

		Если Объект.Статус = СтатусПодтвержден Тогда
			Возврат Истина;
		КонецЕсли;

		Если Объект.Статус = Перечисления.СтатусыЗаказовПоставщикам.Закрыт Тогда
			ДобавитьСтрокуЖурнала(Журнал, Этап, ЗаказСсылка,
				НСтр("ru = 'Установка статуса заказа'"), НСтр("ru = 'Пропуск'"),
				НСтр("ru = 'Заказ закрыт — статус не изменяется.'"));
			Возврат Ложь;
		КонецЕсли;

		// В статусе «Подтвержден» проверка заполнения требует дат поставки.
		ЗаполнитьПустыеДатыПоставки(Объект);

		Объект.Статус = СтатусПодтвержден;
		ПровестиДокумент(Объект);

		ДобавитьСтрокуЖурнала(Журнал, Этап, ЗаказСсылка,
			НСтр("ru = 'Установка статуса заказа'"), НСтр("ru = 'Успех'"),
			НСтр("ru = 'Статус заказа изменён на «Подтвержден».'"));

		Возврат Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Счетчики.Ошибок = Счетчики.Ошибок + 1;
		ДобавитьСтрокуЖурнала(Журнал, Этап, ЗаказСсылка,
			НСтр("ru = 'Установка статуса заказа'"), НСтр("ru = 'Ошибка'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Заполняет пустые даты отгрузки и поступления в шапке заказа (когда весь заказ
// поставляется одной датой) и в строках: в статусе «Подтвержден» эти даты
// проверяются на заполнение.
//
// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПоставщику - записываемый заказ.
//
Процедура ЗаполнитьПустыеДатыПоставки(ЗаказОбъект)

	Если ЗаказОбъект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДатаОтгрузки = ЗаказОбъект.ДатаОтгрузки;
	ДатаПоступления = ЗаказОбъект.ДатаПоступления;

	Если НЕ ЗначениеЗаполнено(ДатаОтгрузки) Тогда
		ДатаОтгрузки = НачалоДня(ЗаказОбъект.Дата);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаПоступления) Тогда
		ДатаПоступления = ОбщегоНазначенияУТКлиентСервер.РассчитатьДатуОкончанияПериода(
			ДатаОтгрузки, Перечисления.Периодичность.День, ЗаказОбъект.ДлительностьДоставки) + 1;
	КонецЕсли;

	Если ЗаказОбъект.ПоступлениеОднойДатой Тогда
		ЗаказОбъект.ДатаОтгрузки = ДатаОтгрузки;
		ЗаказОбъект.ДатаПоступления = ДатаПоступления;
	КонецЕсли;

	Для Каждого СтрокаТовары Из ЗаказОбъект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.ДатаОтгрузки) Тогда
			СтрокаТовары.ДатаОтгрузки = ДатаОтгрузки;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.ДатаПоступления) Тогда
			СтрокаТовары.ДатаПоступления = ДатаПоступления;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает заказ поставщику, к которому относится документ-распоряжение.
//
// Параметры:
//  РаспоряжениеСсылка - ДокументСсылка - поступление или заказ поставщику.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПоставщику - заказ-основание.
//
Функция ЗаказПоРаспоряжению(РаспоряжениеСсылка)

	Если ТипЗнч(РаспоряжениеСсылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Возврат РаспоряжениеСсылка;
	ИначеЕсли ТипЗнч(РаспоряжениеСсылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РаспоряжениеСсылка, "ЗаказПоставщику");
	КонецЕсли;

	Возврат Документы.ЗаказПоставщику.ПустаяСсылка();

КонецФункции

// Возвращает склад документа (реквизит шапки) или пустую ссылку, если склад не заполнен.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - заказ поставщику, поступление или приходный ордер.
//
// Возвращаемое значение:
//  СправочникСсылка.Склады - склад документа.
//
Функция СкладДокумента(ДокументСсылка)

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Склад");

КонецФункции

// Заполняет пустой склад документа, сохраняя его проведённость.
// Документы цепочки «заказ — поступление — приходный ордер» перекрёстно
// передают друг другу склад, чтобы ни у одного не осталось пустого места хранения.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - изменяемый документ.
//  Склад - СправочникСсылка.Склады - склад, которым нужно заполнить документ.
//
Процедура ЗаполнитьСкладДокумента(ДокументСсылка, Склад)

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) ИЛИ НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;

	Объект = ДокументСсылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Уже заполненный склад не перезаписываем — документ считается источником истины.
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Возврат;
	КонецЕсли;

	Объект.Склад = Склад;

	Если Объект.Проведен Тогда
		ПровестиДокумент(Объект);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

// Возвращает причину отказа ERP из-за превышения заказанного, если документ
// отказано проводить именно по этой причине.
//
// ERP при проведении контролирует остатки заказа («Оформлено больше, чем указано
// в распоряжении …») и отказывает. Для автопривязки это штатная ситуация: заказ уже
// оформлен другими документами (в том числе приходными ордерами без распоряжения),
// и привязать к нему ещё одно поступление нельзя.
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке - ошибка проведения.
//
// Возвращаемое значение:
//  Строка - сообщения ERP с перечнем позиций; пустая строка, если причина другая.
//
Функция ТекстПревышенияЗаказа(ИнформацияОбОшибке)

	Ключ = НСтр("ru = 'Оформлено больше, чем указано в распоряжении'");
	Текст = ИнформацияОбОшибке.Описание;

	Если СтрНайти(Текст, Ключ) = 0 Тогда
		Возврат "";
	КонецЕсли;

	// Отбрасываем обёртку «Документ … не записан. Ошибка: » и стек вызовов:
	// пользователю нужны только сообщения ERP по позициям.
	Префикс = НСтр("ru = 'Ошибка: '");
	Позиция = СтрНайти(Текст, Префикс);
	Если Позиция > 0 Тогда
		Текст = Сред(Текст, Позиция + СтрДлина(Префикс));
	КонецЕсли;

	Позиция = СтрНайти(Текст, "{");
	Если Позиция > 0 Тогда
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;

	Позиция = СтрНайти(Текст, НСтр("ru = 'Проведение не выполнено'"));
	Если Позиция > 0 Тогда
		Текст = Лев(Текст, Позиция - 1);
	КонецЕсли;

	Возврат СокрЛП(Текст);

КонецФункции

// Запоминает пропуск по превышению заказа, чтобы после циклов одной выборкой
// показать в журнале, какие документы уже оформили этот заказ и что осталось
// в заказе по позициям документа.
//
// Параметры:
//  ПропускиПревышения - Массив - накопитель пропусков.
//  Этап - Строка - этап автопривязки.
//  ОбъектСсылка - ДокументСсылка - привязываемый документ.
//  Операция - Строка - выполняемое действие.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//  Позиции - Массив из Структура - позиции документа (Номенклатура, Характеристика,
//            Склад, Количество); Неопределено, если состав неизвестен.
//
Процедура ЗапомнитьПропускПревышения(ПропускиПревышения, Этап, ОбъектСсылка, Операция, ЗаказСсылка,
	Позиции = Неопределено)

	Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;

	Пропуск = Новый Структура;
	Пропуск.Вставить("Этап", Этап);
	Пропуск.Вставить("Объект", ОбъектСсылка);
	Пропуск.Вставить("Операция", Операция);
	Пропуск.Вставить("Заказ", ЗаказСсылка);
	Пропуск.Вставить("Позиции", Позиции);

	ПропускиПревышения.Добавить(Пропуск);

КонецПроцедуры

// Возвращает позиции табличной части товаров документа для диагностики.
//
// Параметры:
//  Товары - ТаблицаДокумента - табличная часть «Товары».
//  Склад - СправочникСсылка.Склады - склад документа.
//
// Возвращаемое значение:
//  Массив из Структура - позиции: Номенклатура, Характеристика, Склад, Количество.
//
Функция ПозицииДокумента(Товары, Склад)

	Позиции = Новый Массив;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("Номенклатура", СтрокаТоваров.Номенклатура);
		Позиция.Вставить("Характеристика", СтрокаТоваров.Характеристика);
		Позиция.Вставить("Склад", Склад);
		Позиция.Вставить("Количество", СтрокаТоваров.Количество);
		Позиции.Добавить(Позиция);
	КонецЦикла;

	Возврат Позиции;

КонецФункции

// Дописывает в журнал диагностику пропусков по превышению заказа: какие документы
// уже оформили заказ (расходные движения регистра «ЗаказыПоставщикам»).
//
// Запрос выполняется один раз на все накопленные пропуски — обращений к базе
// в циклах обработки нет.
//
// Параметры:
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  ПропускиПревышения - Массив из Структура - пропуски по превышению распоряжения.
//
Процедура ДописатьДиагностикуПревышений(Журнал, ПропускиПревышения)

	Если ПропускиПревышения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Заказы = Новый Массив;
	Для Каждого Пропуск Из ПропускиПревышения Цикл
		Если Заказы.Найти(Пропуск.Заказ) = Неопределено Тогда
			Заказы.Добавить(Пропуск.Заказ);
		КонецЕсли;
	КонецЦикла;

	Оформившие = ОформившиеЗаказы(Заказы);
	ОстаткиЗаказов = ОстаткиЗаказовПоПропускам(Заказы);
	ПозицииЗаказов = ПозицииЗаказовПоСсылкам(Заказы);

	Для Каждого Пропуск Из ПропускиПревышения Цикл

		ТекстОформивших = Оформившие.Получить(Пропуск.Заказ);
		Если ТекстОформивших <> Неопределено Тогда
			ДобавитьСтрокуЖурнала(Журнал, Пропуск.Этап, Пропуск.Объект, Пропуск.Операция,
				НСтр("ru = 'Пропуск'"),
				СтрШаблон(НСтр("ru = 'Заказ-основание: %1. %2'"), Строка(Пропуск.Заказ),
					ТекстОформивших));
		КонецЕсли;

		// Остаток регистра сравнивается по тем же ключам, что и контроль ERP
		// (заказ + номенклатура + характеристика + склад): расхождение по
		// характеристике или складу — самая частая причина отказа.
		ТекстРасхождения = ТекстРасхожденияПозиций(Пропуск, ОстаткиЗаказов, ПозицииЗаказов);
		Если ЗначениеЗаполнено(ТекстРасхождения) Тогда
			ДобавитьСтрокуЖурнала(Журнал, Пропуск.Этап, Пропуск.Объект, Пропуск.Операция,
				НСтр("ru = 'Пропуск'"),
				СтрШаблон(НСтр("ru = 'Заказ-основание: %1. Остатки по заказу: %2'"),
					Строка(Пропуск.Заказ), ТекстРасхождения));
		КонецЕсли;

	КонецЦикла;

	СохранитьЖурналВРегистр(Журнал);

КонецПроцедуры

// Возвращает остатки регистра «Заказы поставщикам» по заказам обработки.
//
// Параметры:
//  Заказы - Массив - ссылки на заказы поставщику.
//
// Возвращаемое значение:
//  ТаблицаЗначений - остатки: Заказ, Номенклатура, Характеристика, Склад,
//   Заказано, КОформлению, КПоступлению.
//
Функция ОстаткиЗаказовПоПропускам(Заказы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ЗаказПоставщику КАК Заказ,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Характеристика КАК Характеристика,
	|	Остатки.Склад КАК Склад,
	|	Остатки.ЗаказаноОстаток КАК Заказано,
	|	Остатки.КОформлениюОстаток КАК КОформлению,
	|	Остатки.КПоступлениюОстаток КАК КПоступлению
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(,
	|			ЗаказПоставщику В (&Заказы)) КАК Остатки";
	Запрос.УстановитьПараметр("Заказы", Заказы);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает строки заказов поставщику по заказам обработки.
//
// Параметры:
//  Заказы - Массив - ссылки на заказы поставщику.
//
// Возвращаемое значение:
//  ТаблицаЗначений - позиции заказов: Заказ, Номенклатура, Характеристика,
//   Склад, Количество.
//
Функция ПозицииЗаказовПоСсылкам(Заказы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Заказ,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Склад КАК Склад,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.ЗаказПоставщику КАК Заказ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК Товары
	|		ПО Заказ.Ссылка = Товары.Ссылка
	|ГДЕ
	|	Заказ.Ссылка В (&Заказы)";
	Запрос.УстановитьПараметр("Заказы", Заказы);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Собирает текст расхождения по позициям документа: что есть в заказе,
// какой остаток видит регистр и сколько требуется провести.
//
// Параметры:
//  Пропуск - Структура - пропуск по превышению, см. ЗапомнитьПропускПревышения.
//  ОстаткиЗаказов - ТаблицаЗначений - остатки регистра, см. ОстаткиЗаказовПоПропускам.
//  ПозицииЗаказов - ТаблицаЗначений - строки заказов, см. ПозицииЗаказовПоСсылкам.
//
// Возвращаемое значение:
//  Строка - перечень позиций; пустая, если позиции документа неизвестны.
//
Функция ТекстРасхожденияПозиций(Пропуск, ОстаткиЗаказов, ПозицииЗаказов)

	Если Пропуск.Позиции = Неопределено ИЛИ Пропуск.Позиции.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Тексты = Новый Массив;

	Для Каждого Позиция Из Пропуск.Позиции Цикл

		Отбор = Новый Структура("Заказ, Номенклатура, Характеристика, Склад",
			Пропуск.Заказ, Позиция.Номенклатура, Позиция.Характеристика, Позиция.Склад);

		СтрокиЗаказа = ПозицииЗаказов.НайтиСтроки(Отбор);
		КоличествоВЗаказе = 0;
		Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
			КоличествоВЗаказе = КоличествоВЗаказе + СтрокаЗаказа.Количество;
		КонецЦикла;

		СтрокиОстатка = ОстаткиЗаказов.НайтиСтроки(Отбор);
		Заказано = 0;
		Оформлено = 0;
		КПоступлению = 0;
		Для Каждого СтрокаОстатка Из СтрокиОстатка Цикл
			Заказано = Заказано + СтрокаОстатка.Заказано;
			Оформлено = Оформлено + СтрокаОстатка.КОформлению;
			КПоступлению = КПоступлению + СтрокаОстатка.КПоступлению;
		КонецЦикла;

		ТекстПозиции = СтрШаблон("%1 / %2: в заказе %3, остаток — заказано %4, оформлено %5, к поступлению %6; в документе %7",
			Строка(Позиция.Номенклатура),
			?(ЗначениеЗаполнено(Позиция.Склад), Строка(Позиция.Склад), НСтр("ru = 'склад не указан'")),
			?(СтрокиЗаказа.Количество() = 0, НСтр("ru = 'позиции нет'"),
				Формат(КоличествоВЗаказе, "ЧДЦ=3; ЧН=0")),
			Формат(Заказано, "ЧДЦ=3; ЧН=0"),
			Формат(Оформлено, "ЧДЦ=3; ЧН=0"),
			Формат(КПоступлению, "ЧДЦ=3; ЧН=0"),
			Формат(Позиция.Количество, "ЧДЦ=3; ЧН=0"));

		Если СтрокиЗаказа.Количество() = 0 Тогда
			ТекстПозиции = ТекстПозиции + НСтр("ru = ' (характеристика или склад в заказе не совпадают)'");
		КонецЕсли;

		Тексты.Добавить(ТекстПозиции);

	КонецЦикла;

	Возврат СтрСоединить(Тексты, "; ");

КонецФункции

// Возвращает по каждому заказу перечень документов, которые уже его оформили.
//
// Параметры:
//  Заказы - Массив - ссылки на заказы поставщику.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заказ -> текст «Заказ уже оформили: …».
//
Функция ОформившиеЗаказы(Заказы)

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказы.ЗаказПоставщику КАК ЗаказПоставщику,
	|	Заказы.Регистратор КАК Регистратор,
	|	Заказы.Период КАК Период,
	|	СУММА(Заказы.КОформлению) КАК КОформлению,
	|	СУММА(Заказы.КПоступлению) КАК КПоступлению
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Заказы
	|ГДЕ
	|	Заказы.ЗаказПоставщику В (&Заказы)
	|СГРУППИРОВАТЬ ПО
	|	Заказы.ЗаказПоставщику,
	|	Заказы.Регистратор,
	|	Заказы.Период
	|ИМЕЮЩИЕ
	|	СУММА(Заказы.КОформлению) < 0
	|	ИЛИ СУММА(Заказы.КПоступлению) < 0
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПоставщику,
	|	Период,
	|	Регистратор";
	Запрос.УстановитьПараметр("Заказы", Заказы);

	Движения = Запрос.Выполнить().Выгрузить();

	Для Каждого СтрокаДвижения Из Движения Цикл
		Текст = Результат.Получить(СтрокаДвижения.ЗаказПоставщику);
		Если Текст = Неопределено Тогда
			Текст = "";
		Иначе
			Текст = Текст + ", ";
		КонецЕсли;
		Текст = Текст + СтрШаблон("%1 от %2 (оформлено %3, поступило %4)",
			Строка(СтрокаДвижения.Регистратор),
			Формат(СтрокаДвижения.Период, "ДЛФ=DT"),
			Формат(-СтрокаДвижения.КОформлению, "ЧДЦ=3; ЧН=0"),
			Формат(-СтрокаДвижения.КПоступлению, "ЧДЦ=3; ЧН=0"));
		Результат.Вставить(СтрокаДвижения.ЗаказПоставщику, Текст);
	КонецЦикла;

	Для Каждого КлючИЗначение Из Результат Цикл
		Результат.Вставить(КлючИЗначение.Ключ,
			СтрШаблон(НСтр("ru = 'Заказ уже оформили: %1.'"), КлючИЗначение.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает поступления, привязанные к заказам поставщику.
//
// Параметры:
//  Заказы - ТаблицаЗначений - заказы с колонкой Ссылка, см. ЗаказыДляАвтопривязки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заказ -> массив ссылок на проведённые поступления.
//
Функция ПоступленияПривязанныеКЗаказам(Заказы)

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.ЗаказПоставщику КАК Заказ,
	|	Поступление.Ссылка КАК Поступление
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Поступление
	|ГДЕ
	|	НЕ Поступление.ПометкаУдаления
	|	И Поступление.Проведен
	|	И Поступление.ЗаказПоставщику В (&Заказы)
	|УПОРЯДОЧИТЬ ПО
	|	Поступление.Дата";
	Запрос.УстановитьПараметр("Заказы", Заказы.ВыгрузитьКолонку("Ссылка"));

	Для Каждого СтрокаПоступления Из Запрос.Выполнить().Выгрузить() Цикл
		Список = Результат.Получить(СтрокаПоступления.Заказ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(СтрокаПоступления.Заказ, Список);
		КонецЕсли;
		Список.Добавить(СтрокаПоступления.Поступление);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает описание документов, уже связанных с заказом поставщику:
// приходных ордеров (привязанных к заказу и фактически израсходовавших его).
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - проверяемый заказ.
//  ОрдераЗаказов - Соответствие из КлючИЗначение - заказ -> массив ордеров,
//                  см. ОрдераПривязанныеКЗаказам.
//  РасходЗаказов - Соответствие из КлючИЗначение - заказ -> массив структур движений,
//                  см. РасходныеДокументыЗаказов.
//
// Возвращаемое значение:
//  Строка - описание связанных документов для журнала.
//
Функция ТекстСвязанныхДокументовЗаказа(ЗаказСсылка, ОрдераЗаказов, РасходЗаказов)

	ПривязанныеОрдера = ОрдераЗаказов.Получить(ЗаказСсылка);
	ДвиженияЗаказа = РасходЗаказов.Получить(ЗаказСсылка);

	Если ПривязанныеОрдера = Неопределено И ДвиженияЗаказа = Неопределено Тогда
		Возврат НСтр("ru = 'Связанных документов нет: ни ордеров, ни поступлений за заказом не числится.'");
	КонецЕсли;

	Части = Новый Массив;

	Если ПривязанныеОрдера <> Неопределено Тогда
		ПредставленияОрдеров = Новый Массив;
		Для Каждого ПривязанныйОрдер Из ПривязанныеОрдера Цикл
			ПредставленияОрдеров.Добавить(Строка(ПривязанныйОрдер));
		КонецЦикла;
		Части.Добавить(СтрШаблон(НСтр("ru = 'привязанные к заказу ордера: %1'"),
			СтрСоединить(ПредставленияОрдеров, ", ")));
	КонецЕсли;

	Если ДвиженияЗаказа <> Неопределено Тогда
		Израсходовали = Новый Массив;
		Для Каждого Движение Из ДвиженияЗаказа Цикл
			Если Израсходовали.Найти(Движение.Регистратор) = Неопределено Тогда
				Израсходовали.Добавить(Движение.Регистратор);
			КонецЕсли;
		КонецЦикла;
		ПредставленияИзрасходовавших = Новый Массив;
		Для Каждого Израсходовавший Из Израсходовали Цикл
			ПредставленияИзрасходовавших.Добавить(Строка(Израсходовавший));
		КонецЦикла;
		Части.Добавить(СтрШаблон(НСтр("ru = 'израсходовали заказ: %1'"),
			СтрСоединить(ПредставленияИзрасходовавших, ", ")));
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Связанные документы — %1.'"), СтрСоединить(Части, "; "));

КонецФункции

// Возвращает приходные ордера, привязанные к заказам поставщику.
//
// Параметры:
//  Заказы - ТаблицаЗначений - заказы с колонкой Ссылка, см. ЗаказыДляАвтопривязки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заказ -> массив ссылок на проведённые ордера.
//
Функция ОрдераПривязанныеКЗаказам(Заказы)

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ордер.Распоряжение КАК Заказ,
	|	Ордер.Ссылка КАК Ордер
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары КАК Ордер
	|ГДЕ
	|	НЕ Ордер.ПометкаУдаления
	|	И Ордер.Проведен
	|	И Ордер.Распоряжение В (&Заказы)
	|УПОРЯДОЧИТЬ ПО
	|	Ордер.Дата";
	Запрос.УстановитьПараметр("Заказы", Заказы.ВыгрузитьКолонку("Ссылка"));

	Для Каждого СтрокаОрдера Из Запрос.Выполнить().Выгрузить() Цикл
		Список = Результат.Получить(СтрокаОрдера.Заказ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(СтрокаОрдера.Заказ, Список);
		КонецЕсли;
		Список.Добавить(СтрокаОрдера.Ордер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает документы, которые фактически израсходовали заказы поставщику.
//
// Отбор идёт по расходным движениям регистра «ЗаказыПоставщикам», а не по реквизиту
// «Распоряжение»: остаток заказа списывают и ордера без основания (безхозные),
// у которых в распоряжении заказа нет.
//
// Тип регистратора не фильтруется: расход по заказу пишут не только приходные ордера,
// но и поступления, и корректировки поступлений. Фильтр по типу — у потребителя
// (снимать проведение можно только у ордера).
//
// Параметры:
//  Заказы - ТаблицаЗначений - заказы с колонкой Ссылка, см. ЗаказыДляАвтопривязки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заказ -> массив структур:
//   * Регистратор - ДокументСсылка - израсходовавший документ (ордер, поступление, корректировка);
//   * Номенклатура - СправочникСсылка.Номенклатура - израсходованная позиция;
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика;
//   * Склад - СправочникСсылка.Склады - склад расхода;
//   * Период - Дата - дата движения (дата документа-регистратора).
//
Функция РасходныеДокументыЗаказов(Заказы)

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.ЗаказПоставщику КАК Заказ,
	|	Движения.Номенклатура КАК Номенклатура,
	|	Движения.Характеристика КАК Характеристика,
	|	Движения.Склад КАК Склад,
	|	Движения.Регистратор КАК Регистратор,
	|	Движения.Период КАК Период,
	|	Движения.КОформлению КАК КОформлению,
	|	Движения.КПоступлению КАК КПоступлению
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам КАК Движения
	|ГДЕ
	|	Движения.ЗаказПоставщику В (&Заказы)
	|	И (Движения.КОформлению < 0
	|		ИЛИ Движения.КПоступлению < 0)";
	Запрос.УстановитьПараметр("Заказы", Заказы.ВыгрузитьКолонку("Ссылка"));

	Для Каждого СтрокаДвижения Из Запрос.Выполнить().Выгрузить() Цикл
		Список = Результат.Получить(СтрокаДвижения.Заказ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(СтрокаДвижения.Заказ, Список);
		КонецЕсли;

		Список.Добавить(Новый Структура("Регистратор, Номенклатура, Характеристика, Склад, Период, КОформлению, КПоступлению",
			СтрокаДвижения.Регистратор, СтрокаДвижения.Номенклатура,
			СтрокаДвижения.Характеристика, СтрокаДвижения.Склад, СтрокаДвижения.Период,
			СтрокаДвижения.КОформлению, СтрокаДвижения.КПоступлению));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пытается привязать поступление к заказу, освободив заказ от приходных ордеров.
//
// Порядок: снять проведение у ордеров, привязанных к заказу и пересекающихся
// с поступлением по номенклатуре (заказ освобождается) → привязать поступление
// по заказам → перенести ордера на поступление как основание.
// Если поступление привязать не удалось, ордера возвращаются на заказ.
//
// Параметры:
//  ПоступлениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - привязываемый документ.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//  Счетчики - Структура - счётчики выполнения.
//  ОрдераЗаказов - Соответствие - заказ -> массив ордеров, см. ОрдераПривязанныеКЗаказам.
//  ТоварыОрдеров - ТаблицаЗначений - строки товаров приходных ордеров.
//  РасходЗаказов - Соответствие - заказ -> массив израсходовавших его документов,
//                  см. РасходныеДокументыЗаказов.
//
// Возвращаемое значение:
//  Булево - Истина, если поступление привязано, а ордера перенесены на него.
//
Функция ПеренестиОрдераНаПоступление(ПоступлениеСсылка, ЗаказСсылка, Журнал, Счетчики,
	ОрдераЗаказов, ТоварыОрдеров, РасходЗаказов)

	Если ТоварыОрдеров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Объект = ПоступлениеСсылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокиПоступления = Объект.Товары.Выгрузить();
	СкладПоступления = Объект.Склад;
	НоменклатурыПоступления = НоменклатурыСтрок(СтрокиПоступления);
	НоменклатурыОрдеров = НоменклатурыПоДокументам(ТоварыОрдеров);

	// Кандидаты — ордера, израсходовавшие заказ по номенклатурам поступления. Берутся
	// и привязанные к заказу (по реквизиту «Распоряжение»), и безхозные: последние
	// в поле распоряжения заказ не содержат, но списывают его остаток движениями
	// регистра «ЗаказыПоставщикам», и без их снятия заказ не освобождается.
	Кандидаты = Новый Соответствие;

	Ордера = ?(ОрдераЗаказов = Неопределено, Неопределено, ОрдераЗаказов.Получить(ЗаказСсылка));
	Если Ордера <> Неопределено Тогда
		Для Каждого ОрдерСсылка Из Ордера Цикл
			НоменклатурыОрдера = НоменклатурыОрдеров.Получить(ОрдерСсылка);
			Если НоменклатурыОрдера <> Неопределено
				И ЕстьОбщаяНоменклатура(НоменклатурыПоступления, НоменклатурыОрдера) Тогда
				Кандидаты.Вставить(ОрдерСсылка, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Израсходовавшие = ?(РасходЗаказов = Неопределено, Неопределено, РасходЗаказов.Получить(ЗаказСсылка));
	Если Израсходовавшие <> Неопределено Тогда
		ТипОрдера = Тип("ДокументСсылка.ПриходныйОрдерНаТовары");
		Для Каждого СтрокаРасхода Из Израсходовавшие Цикл
			// Снимать проведение можно только у приходного ордера: поступление
			// снимать нельзя, это учётный документ.
			Если ТипЗнч(СтрокаРасхода.Регистратор) <> ТипОрдера Тогда
				Продолжить;
			КонецЕсли;
			// Сопоставляем только по номенклатуре: склад и характеристика в движениях
			// и строках поступления могут не совпадать, и тогда настоящий виновник
			// отсекается. Снятие лишнего ордера безвредно — он возвращается.
			Если НоменклатурыПоступления.Найти(СтрокаРасхода.Номенклатура) <> Неопределено Тогда
				Кандидаты.Вставить(СтрокаРасхода.Регистратор, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Освобождаем заказ: снимаем проведение у найденных ордеров, запоминая их
	// исходное основание, чтобы при неудаче вернуть всё как было.
	Освобожденные = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		ОрдерСсылка = Кандидат.Ключ;

		Попытка
			ОрдерОбъект = ОрдерСсылка.ПолучитьОбъект();
			Если ОрдерОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ИсходноеРаспоряжение = ОрдерОбъект.Распоряжение;
			ОрдерОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);

			// Отказ записи (Отказ в ПередЗаписью, подписка) исключения не даёт:
			// документ остаётся проведённым, и заказ при этом не освобождается.
			ОрдерПослеЗаписи = ОрдерСсылка.ПолучитьОбъект();
			Если ОрдерПослеЗаписи <> Неопределено И ОрдерПослеЗаписи.Проведен Тогда
				ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ОрдерСсылка,
					НСтр("ru = 'Освобождение заказа от ордера'"), НСтр("ru = 'Пропуск'"),
					НСтр("ru = 'Проведение ордера не отменено — заказ не освобождён.'"));
				Продолжить;
			КонецЕсли;

			Освобожденные.Добавить(Новый Структура("Ордер, Распоряжение", ОрдерСсылка, ИсходноеРаспоряжение));
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ОрдерСсылка,
				НСтр("ru = 'Освобождение заказа от ордера'"), НСтр("ru = 'Ошибка'"),
				СтрШаблон(НСтр("ru = 'Не удалось отменить проведение: %1'"),
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
		КонецПопытки;
	КонецЦикла;

	Если Освобожденные.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Заказ освобождён — привязываем поступление по заказам.
	Попытка
		Объект = ПоступлениеСсылка.ПолучитьОбъект();
		Объект.Товары.Очистить();
		Объект.Заполнить(ЗаказСсылка);

		СкладЗаказа = СкладДокумента(ЗаказСсылка);
		Если ЗначениеЗаполнено(СкладЗаказа) Тогда
			Объект.Склад = СкладЗаказа;
		КонецЕсли;

		ПровестиДокумент(Объект);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Для Каждого Освобожденный Из Освобожденные Цикл
			ВернутьОрдерНаЗаказ(Освобожденный.Ордер, Освобожденный.Распоряжение, Журнал);
		КонецЦикла;
		ТекстРасхода = ТекстРасходаЗаказа(РасходЗаказов, ЗаказСсылка, НоменклатурыПоступления);
		ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ПоступлениеСсылка,
			НСтр("ru = 'Привязка через освобождение заказа'"), НСтр("ru = 'Ошибка'"),
			СтрШаблон(
				НСтр("ru = 'Ордера сняты с заказа, но поступление не привязалось; ордера возвращены на заказ. Заказ израсходовали: %1. Ошибка: %2'"),
				?(ЗначениеЗаполнено(ТекстРасхода), ТекстРасхода, НСтр("ru = 'расход по составу поступления не найден'")),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
		Возврат Ложь;
	КонецПопытки;

	// Переносим освобождённые ордера на поступление.
	Перенесено = 0;
	Для Каждого Освобожденный Из Освобожденные Цикл
		Если ПривязатьОрдерКРаспоряжению(Освобожденный.Ордер, ПоступлениеСсылка, Журнал, Счетчики,
			"ПоЗаказам", Новый Массив) Тогда
			Перенесено = Перенесено + 1;
		Иначе
			ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", Освобожденный.Ордер,
				НСтр("ru = 'Перенос ордера на поступление'"), НСтр("ru = 'Ошибка'"),
				НСтр("ru = 'Ордер остался без проведения — требуется привязать его к поступлению вручную.'"));
		КонецЕсли;
	КонецЦикла;

	Возврат Перенесено > 0;

КонецФункции

// Возвращает ордер в исходное состояние и проводит его (откат освобождения заказа).
//
// Параметры:
//  ОрдерСсылка - ДокументСсылка.ПриходныйОрдерНаТовары - ордер.
//  ИсходноеРаспоряжение - ДокументСсылка - основание, которое было у ордера до снятия
//                         с проведения; у безхозного ордера пустая ссылка.
//  Журнал - ТаблицаЗначений - журнал автопривязки.
//
Процедура ВернутьОрдерНаЗаказ(ОрдерСсылка, ИсходноеРаспоряжение, Журнал)

	Попытка
		ОрдерОбъект = ОрдерСсылка.ПолучитьОбъект();
		Если ОрдерОбъект = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ОрдерОбъект.Распоряжение = ИсходноеРаспоряжение;
		ПровестиДокумент(ОрдерОбъект);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ДобавитьСтрокуЖурнала(Журнал, "ПоЗаказам", ОрдерСсылка,
			НСтр("ru = 'Возврат ордера на заказ'"), НСтр("ru = 'Ошибка'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;

КонецПроцедуры

// Возвращает уникальные номенклатуры строк товаров.
//
// Параметры:
//  СтрокиТоваров - ТаблицаЗначений - строки товаров.
//
// Возвращаемое значение:
//  Массив - номенклатуры.
//
Функция НоменклатурыСтрок(СтрокиТоваров)

	Номенклатуры = Новый Массив;
	Для Каждого СтрокаТоваров Из СтрокиТоваров Цикл
		Если Номенклатуры.Найти(СтрокаТоваров.Номенклатура) = Неопределено Тогда
			Номенклатуры.Добавить(СтрокаТоваров.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Возврат Номенклатуры;

КонецФункции

// Строит состав номенклатур по документам: документ -> массив номенклатур.
//
// Параметры:
//  СтрокиТоваров - ТаблицаЗначений - строки товаров с колонками Ссылка, Номенклатура.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - документ -> массив номенклатур.
//
Функция НоменклатурыПоДокументам(СтрокиТоваров)

	Результат = Новый Соответствие;
	Для Каждого СтрокаТоваров Из СтрокиТоваров Цикл
		Номенклатуры = Результат.Получить(СтрокаТоваров.Ссылка);
		Если Номенклатуры = Неопределено Тогда
			Номенклатуры = Новый Массив;
			Результат.Вставить(СтрокаТоваров.Ссылка, Номенклатуры);
		КонецЕсли;
		Если Номенклатуры.Найти(СтрокаТоваров.Номенклатура) = Неопределено Тогда
			Номенклатуры.Добавить(СтрокаТоваров.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, есть ли у двух списков номенклатур общие позиции.
//
// Параметры:
//  Номенклатуры1 - Массив - первый список.
//  Номенклатуры2 - Массив - второй список.
//
// Возвращаемое значение:
//  Булево - Истина, если есть общая номенклатура.
//
Функция ЕстьОбщаяНоменклатура(Номенклатуры1, Номенклатуры2)

	Для Каждого Номенклатура Из Номенклатуры1 Цикл
		Если Номенклатуры2.Найти(Номенклатура) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает текст о том, какие документы израсходовали заказ по составу поступления.
//
// Строится из уже загруженных движений — без запроса к базе, поэтому его можно
// писать в журнал сразу, не дожидаясь конца задания.
//
// Параметры:
//  РасходЗаказов - Соответствие - заказ -> массив расходных движений, см. РасходныеДокументыЗаказов.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//  НоменклатурыПоступления - Массив - номенклатуры строк товаров поступления.
//
// Возвращаемое значение:
//  Строка - перечень «<документ> от <дата> (оформлено N, поступило M)»; пустая, если расхода нет.
//
Функция ТекстРасходаЗаказа(РасходЗаказов, ЗаказСсылка, НоменклатурыПоступления)

	Израсходовавшие = ?(РасходЗаказов = Неопределено, Неопределено, РасходЗаказов.Получить(ЗаказСсылка));
	Если Израсходовавшие = Неопределено ИЛИ Израсходовавшие.Количество() = 0 Тогда
		Возврат НСтр("ru = 'движений расхода по заказу в регистре ЗаказыПоставщикам нет'");
	КонецЕсли;

	// Сначала показываем расход по позициям поступления, а если такого нет —
	// весь расход по заказу: так видно, чем заказ израсходован на самом деле.
	ТекстПоСоставу = ТекстРасходаПоНоменклатурам(Израсходовавшие, НоменклатурыПоступления, Истина);
	Если ЗначениеЗаполнено(ТекстПоСоставу) Тогда
		Возврат ТекстПоСоставу;
	КонецЕсли;

	ТекстПоЗаказу = ТекстРасходаПоНоменклатурам(Израсходовавшие, НоменклатурыПоступления, Ложь);
	Если ЗначениеЗаполнено(ТекстПоЗаказу) Тогда
		Возврат СтрШаблон(НСтр("ru = 'по позициям поступления расхода нет; по заказу списано: %1'"),
			ТекстПоЗаказу);
	КонецЕсли;

	Возврат НСтр("ru = 'движений расхода по заказу в регистре ЗаказыПоставщикам нет'");

КонецФункции

// Собирает текст расхода заказа по регистраторам.
//
// Параметры:
//  Израсходовавшие - Массив из Структура - расходные движения заказа.
//  НоменклатурыПоступления - Массив - номенклатуры строк товаров поступления.
//  ТолькоПоСоставу - Булево - Истина: только позиции поступления, Ложь: все позиции.
//
// Возвращаемое значение:
//  Строка - перечень «<документ> от <дата> (оформлено N, поступило M)».
//
Функция ТекстРасходаПоНоменклатурам(Израсходовавшие, НоменклатурыПоступления, ТолькоПоСоставу)

	Результат = "";
	УжеДобавлены = Новый Соответствие;

	Для Каждого СтрокаРасхода Из Израсходовавшие Цикл
		Если ТолькоПоСоставу
			И НоменклатурыПоступления.Найти(СтрокаРасхода.Номенклатура) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если УжеДобавлены.Получить(СтрокаРасхода.Регистратор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		УжеДобавлены.Вставить(СтрокаРасхода.Регистратор, Истина);
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), ", ", "")
			+ СтрШаблон("%1 от %2 (оформлено %3, поступило %4)",
				Строка(СтрокаРасхода.Регистратор),
				Формат(СтрокаРасхода.Период, "ДЛФ=DT"),
				Формат(-СтрокаРасхода.КОформлению, "ЧДЦ=3; ЧН=0"),
				Формат(-СтрокаРасхода.КПоступлению, "ЧДЦ=3; ЧН=0"));
	КонецЦикла;

	Возврат Результат;

КонецФункции
// записала в очередь сообщений пользователю: в фоновом задании они иначе теряются,
// и в журнал попадает только «Не удалось провести "…"!».
//
// Параметры:
//  Объект - ДокументОбъект - записываемый документ.
//
Процедура ПровестиДокумент(Объект)

	// Очередь могла остаться от предыдущих документов — начинаем с чистой.
	ПолучитьСообщенияПользователю(Истина);

	ТекстИсключения = "";

	// Запись может как вернуть Ложь в Объект.Проведен, так и выбросить исключение:
	// сообщения платформы в обоих случаях лежат в очереди сообщений пользователю.
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстИсключения = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Причины = ТекстСообщенийПроведения();

	// Исключение важнее флага Проведен: у уже проведённого документа при отмене
	// записи Проведен остаётся Истина, и раньше ошибка молча проглатывалась.
	Если ЗначениеЗаполнено(ТекстИсключения) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Документ %1 не записан. Ошибка: %2'"),
			Объект.Ссылка,
			?(ЗначениеЗаполнено(Причины), Причины + "; " + ТекстИсключения, ТекстИсключения));
	КонецЕсли;

	Если Объект.Проведен Тогда
		// Сообщения не забираем: по ним вызывающий код определяет, применилась ли
		// запись (платформа может отменить её, оставив Проведен прежним).
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Причины) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Документ %1 не проведён. Причины: %2'"),
			Объект.Ссылка, Причины);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстИсключения) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Документ %1 не проведён. Ошибка платформы: %2'"),
			Объект.Ссылка, ТекстИсключения);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Документ %1 не проведён, платформа не сообщила причину.'"), Объект.Ссылка);

КонецПроцедуры

// Возвращает текст сообщений, накопленных платформой в очереди сообщений пользователю.
//
// Возвращаемое значение:
//  Строка - тексты сообщений через точку с запятой.
//
Функция ТекстСообщенийПроведения()

	Части = Новый Массив;

	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = СокрЛП(Сообщение.Текст);
		Если ЗначениеЗаполнено(Текст) Тогда
			Части.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти
