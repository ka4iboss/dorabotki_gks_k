////////////////////////////////////////////////////////////////////////////////
// Перезаполнение поступлений по заказам поставщику.
//
// Обработка находит документы «Приобретение товаров и услуг», у которых не
// установлен признак «Поступление по заказам», и подбирает к ним заказ
// поставщику с точным совпадением партнёра, суммы документа и склада.
// Перезаполнение выполняется построчно: ошибка по одному документу не
// прерывает обработку остальных.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подготавливает задание: находит поступления и однозначно соответствующие
// им заказы поставщику.
//
// Возвращаемое значение:
//  Структура - задание на перезаполнение:
//   * Строки - Массив из Структура - пары «поступление - заказ»:
//      ** Поступление - ДокументСсылка.ПриобретениеТоваровУслуг - перезаполняемый документ
//      ** Заказ - ДокументСсылка.ЗаказПоставщику - заказ-основание
//   * ВсегоСтрок - Число - количество найденных пар
//
Функция ПодготовитьЗадание() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриобретениеТоваровУслуг.Ссылка КАК Поступление,
	|	МАКСИМУМ(Заказ.Ссылка) КАК Заказ
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказ
	|		ПО ПриобретениеТоваровУслуг.Партнер = Заказ.Партнер
	|			И ПриобретениеТоваровУслуг.СуммаДокумента = Заказ.СуммаДокумента
	|			И ПриобретениеТоваровУслуг.Склад = Заказ.Склад
	|ГДЕ
	|	НЕ ПриобретениеТоваровУслуг.ПоступлениеПоЗаказам
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриобретениеТоваровУслуг.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Заказ.Ссылка) = 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	Поступление";

	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокаЗадания = Новый Структура;
		СтрокаЗадания.Вставить("Поступление", Выборка.Поступление);
		СтрокаЗадания.Вставить("Заказ", Выборка.Заказ);
		Строки.Добавить(СтрокаЗадания);
	КонецЦикла;

	Задание = Новый Структура;
	Задание.Вставить("Строки", Строки);
	Задание.Вставить("ВсегоСтрок", Строки.Количество());

	Возврат Задание;

КонецФункции

// Возвращает товары документа для вывода на форме обработки.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ПриобретениеТоваровУслуг, ДокументСсылка.ЗаказПоставщику - документ,
//                 товары которого нужно получить.
//
// Возвращаемое значение:
//  ТаблицаЗначений - товары документа:
//   * Номенклатура - СправочникСсылка.Номенклатура - товар
//   * Количество - Число - количество
//   * Цена - Число - цена
//   * Сумма - Число - сумма
//
Функция ТоварыДокумента(ДокументСсылка) Экспорт

	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Товары.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Товары.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Товары.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Товары;
	КонецЕсли;

	Запрос = Новый Запрос;

	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
	Иначе
		Возврат Товары;
	КонецЕсли;

	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());

	Возврат Товары;

КонецФункции

// Перезаполняет документ «Приобретение товаров и услуг» по заказу поставщику
// и записывает его в режиме проведения.
//
// Ошибка не выбрасывается наружу: она записывается в журнал регистрации и
// возвращается в результате.
//
// Параметры:
//  ПоступлениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - перезаполняемый документ.
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ-основание.
//
// Возвращаемое значение:
//  Структура - результат перезаполнения:
//   * Успешно - Булево - Истина, если документ перезаполнен и записан
//   * ТекстОшибки - Строка - краткое представление ошибки, пустая строка при успехе
//
Функция ПерезаполнитьПоступление(ПоступлениеСсылка, ЗаказСсылка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТекстОшибки", "");

	Если НЕ ЗначениеЗаполнено(ПоступлениеСсылка) ИЛИ НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не заполнено поступление или заказ.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		ПоступлениеОбъект = ПоступлениеСсылка.ПолучитьОбъект();
		Если ТипЗнч(ПоступлениеОбъект) <> Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ %1 недоступен для изменения.'"), Строка(ПоступлениеСсылка));
		КонецЕсли;

		ПоступлениеОбъект.Товары.Очистить();
		ПоступлениеОбъект.Заполнить(ЗаказСсылка);
		ПоступлениеОбъект.Записать(РежимЗаписиДокумента.Проведение);

		Результат.Успешно = Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Результат.ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписатьОшибкуВЖурнал(ПоступлениеСсылка, Результат.ТекстОшибки, ИнформацияОбОшибке);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Выполняет пакетное перезаполнение по всем поступлениям с точным совпадением.
//
// Обработка построчная: ошибка по одному документу попадает в результат,
// после чего обработка переходит к следующему документу.
//
// Возвращаемое значение:
//  Структура - результат обработки:
//   * Всего - Число - количество найденных пар
//   * Обработано - Число - количество успешно перезаполненных документов
//   * Ошибки - Массив из Структура - ошибки по документам:
//      ** Поступление - ДокументСсылка.ПриобретениеТоваровУслуг
//      ** Заказ - ДокументСсылка.ЗаказПоставщику
//      ** ТекстОшибки - Строка
//
Функция ПерезаполнитьТочныеСовпадения() Экспорт

	Задание = ПодготовитьЗадание();

	Результат = Новый Структура;
	Результат.Вставить("Всего", Задание.ВсегоСтрок);
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Ошибки", Новый Массив);

	Для Каждого СтрокаЗадания Из Задание.Строки Цикл

		РезультатСтроки = ПерезаполнитьПоступление(СтрокаЗадания.Поступление, СтрокаЗадания.Заказ);
		Если РезультатСтроки.Успешно Тогда
			Результат.Обработано = Результат.Обработано + 1;
			Продолжить;
		КонецЕсли;

		ОшибкаСтроки = Новый Структура;
		ОшибкаСтроки.Вставить("Поступление", СтрокаЗадания.Поступление);
		ОшибкаСтроки.Вставить("Заказ", СтрокаЗадания.Заказ);
		ОшибкаСтроки.Вставить("ТекстОшибки", РезультатСтроки.ТекстОшибки);
		Результат.Ошибки.Добавить(ОшибкаСтроки);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает ошибку перезаполнения документа в журнал регистрации.
//
// Параметры:
//  ПоступлениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - документ, при обработке которого возникла ошибка.
//  ТекстОшибки - Строка - краткое представление ошибки.
//  ИнформацияОбОшибке - ИнформацияОбОшибке - сведения об ошибке.
//
Процедура ЗаписатьОшибкуВЖурнал(ПоступлениеСсылка, ТекстОшибки, ИнформацияОбОшибке)

	ЗаписьЖурналаРегистрации(
		"Перезаполнение поступлений.Перезаполнение документа",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Документы.ПриобретениеТоваровУслуг,
		ПоступлениеСсылка,
		ТекстОшибки + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

#КонецОбласти
