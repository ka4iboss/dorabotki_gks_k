#Область ПрограммныйИнтерфейс

// Выгружает в текстовые файлы права ролей на объекты метаданных и подсистемы.
// Предназначена для выполнения в фоновом задании длительной операции.
//
// Параметры:
//  КаталогВыгрузки  - Строка - каталог, в который выгружаются файлы;
//  ИсключаемыеРоли - Массив из СправочникСсылка.ИдентификаторыОбъектовМетаданных -
//                    роли, права которых не выгружаются.
//
// Возвращаемое значение:
//  Структура - итоги выгрузки:
//   * Объектов  - Число - количество объектов, по которым записаны файлы;
//   * Подсистем - Число - количество подсистем, по которым записаны файлы;
//   * Файлов    - Число - количество записанных файлов.
//
Функция ВыгрузитьПраваРолей(Знач КаталогВыгрузки, Знач ИсключаемыеРоли) Экспорт
	
	Результат = Новый Структура("Объектов, Подсистем, Файлов", 0, 0, 0);
	
	ВсегоОбъектов = КоличествоОбъектов();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПраваРолей.ОбъектМетаданных.ПолноеИмя КАК Объект,
		|	ПраваРолей.Роль.Имя КАК Роль,
		|	ПраваРолей.ПравоЧтениеБезОграничения КАК Чтение,
		|	ПраваРолей.ПравоДобавление КАК Добавление,
		|	ПраваРолей.ПравоИзменение КАК Изменение,
		|	ПраваРолей.ПравоПросмотр КАК Просмотр,
		|	ПраваРолей.ПравоРедактирование КАК Редактирование,
		|	ПраваРолей.ПравоИнтерактивноеДобавление КАК ИнтерактивноеДобавление
		|ИЗ
		|	РегистрСведений.ПраваРолей КАК ПраваРолей
		|ГДЕ
		|	НЕ ПраваРолей.Роль.ПометкаУдаления
		|	И НЕ ПраваРолей.ОбъектМетаданных.ПометкаУдаления
		|	И НЕ ПраваРолей.Роль В (&СписокИсключений)
		|УПОРЯДОЧИТЬ ПО
		|	Объект,
		|	Роль";
	Запрос.УстановитьПараметр("СписокИсключений", ИсключаемыеРоли);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекущийОбъект = "";
	СтрокиФайла = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Объект <> ТекущийОбъект Тогда
			ЗаписатьФайлОбъекта(КаталогВыгрузки, ТекущийОбъект, СтрокиФайла, Результат);
			ТекущийОбъект = Выборка.Объект;
			СтрокиФайла = Новый Массив;
			СообщитьПрогрессВыгрузки(Результат.Объектов, ВсегоОбъектов,
				НСтр("ru = 'Обработано объектов: %1 из %2'"));
		КонецЕсли;
		
		Права = ПраваРолиСтрокой(Выборка);
		Если ЗначениеЗаполнено(Права) Тогда
			СтрокиФайла.Добавить(Выборка.Роль + " | " + Права);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьФайлОбъекта(КаталогВыгрузки, ТекущийОбъект, СтрокиФайла, Результат);
	
	ИтогиПодсистем = ВыгрузитьПраваРолейНаПодсистемы(КаталогВыгрузки, ИсключаемыеРоли);
	Результат.Подсистем = ИтогиПодсистем.Подсистем;
	Результат.Файлов = Результат.Файлов + ИтогиПодсистем.Файлов;
	
	Возврат Результат;
	
КонецФункции

// Выгружает в текстовые файлы права ролей на подсистемы (разделы) конфигурации.
// Регистр сведений "ПраваРолей" содержит права только на объекты метаданных, имеющие таблицы,
// поэтому права на подсистемы выгружаются отдельно - через функцию ПравоДоступа.
//
// Параметры:
//  КаталогВыгрузки  - Строка - каталог, в который выгружаются файлы;
//  ИсключаемыеРоли - Массив из СправочникСсылка.ИдентификаторыОбъектовМетаданных -
//                    роли, права которых не выгружаются.
//
// Возвращаемое значение:
//  Структура - итоги выгрузки:
//   * Подсистем - Число - количество подсистем, по которым записаны файлы;
//   * Файлов    - Число - количество записанных файлов.
//
Функция ВыгрузитьПраваРолейНаПодсистемы(Знач КаталогВыгрузки, Знач ИсключаемыеРоли) Экспорт
	
	Результат = Новый Структура("Подсистем, Файлов", 0, 0);
	
	ВсеПодсистемы = Новый Соответствие;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		ДобавитьПодсистемы(Подсистема, "", ВсеПодсистемы);
	КонецЦикла;
	
	КаталогПодсистем = КаталогВыгрузки + "\подсистемы";
	СоздатьКаталог(КаталогПодсистем);
	
	РолиДляВыгрузки = ПодготовитьСписокРолей(ИсключаемыеРоли);
	
	ВсегоПодсистем = ВсеПодсистемы.Количество();
	ОбработаноПодсистем = 0;
	
	Для Каждого КлючИЗначение Из ВсеПодсистемы Цикл
		
		ОбработаноПодсистем = ОбработаноПодсистем + 1;
		СообщитьПрогрессВыгрузки(ОбработаноПодсистем, ВсегоПодсистем,
			НСтр("ru = 'Обработано подсистем: %1 из %2'"));
		
		СтрокиФайла = Новый Массив;
		
		Для Каждого Роль Из РолиДляВыгрузки Цикл
			Если ПравоДоступа("Просмотр", КлючИЗначение.Значение, Роль) Тогда
				СтрокиФайла.Добавить(Роль.Имя + " | Просмотр");
			КонецЕсли;
		КонецЦикла;
		
		ЗаписатьФайлПодсистемы(КаталогПодсистем, КлючИЗначение.Ключ, СтрокиФайла, Результат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает общее количество объектов метаданных, по которым есть права у ролей.
//
// Возвращаемое значение:
//  Число - количество объектов.
//
Функция КоличествоОбъектов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ПраваРолей.ОбъектМетаданных.ПолноеИмя КАК Объект
		|	ИЗ
		|		РегистрСведений.ПраваРолей КАК ПраваРолей) КАК ОбъектыМетаданных";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Количество;
	
КонецФункции

// Сообщает прогресс выполнения выгрузки в длительную операцию.
//
// Параметры:
//  Обработано   - Число - количество уже обработанных элементов;
//  Всего        - Число - общее количество элементов;
//  ШаблонТекста - Строка - шаблон текста прогресса, например "Обработано объектов: %1 из %2".
//
Процедура СообщитьПрогрессВыгрузки(Обработано, Всего, ШаблонТекста)
	
	Если Обработано = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйПроцент = 100;
	
	ШагСообщения = Цел(Всего / МаксимальныйПроцент);
	Если ШагСообщения < 1 Тогда
		ШагСообщения = 1;
	КонецЕсли;
	Если Обработано % ШагСообщения <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	Процент = 0;
	Если Всего > 0 Тогда
		Процент = Цел(Обработано * МаксимальныйПроцент / Всего);
	КонецЕсли;
	
	ТекстПрогресса = СтрШаблон(ШаблонТекста, Обработано, Всего);
	
	ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса);
	
КонецПроцедуры

// Записывает файл с правами ролей одного объекта метаданных.
//
// Параметры:
//  КаталогВыгрузки  - Строка - каталог выгрузки;
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных, например "Справочник.Валюты";
//  СтрокиФайла      - Массив из Строка - строки с правами ролей;
//  Результат        - Структура - счетчики результата:
//   * Объектов - Число - количество записанных объектов;
//   * Файлов   - Число - количество записанных файлов.
//
Процедура ЗаписатьФайлОбъекта(КаталогВыгрузки, ПолноеИмяОбъекта, СтрокиФайла, Результат)
	
	Если НЕ ЗначениеЗаполнено(ПолноеИмяОбъекта) ИЛИ СтрокиФайла.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Позиция = СтрНайти(ПолноеИмяОбъекта, ".");
	Если Позиция > 0 Тогда
		ТипОбъекта = Лев(ПолноеИмяОбъекта, Позиция - 1);
		ИмяОбъекта = Сред(ПолноеИмяОбъекта, Позиция + 1);
	Иначе
		ТипОбъекта = "Прочее";
		ИмяОбъекта = ПолноеИмяОбъекта;
	КонецЕсли;
	
	КаталогТипа = КаталогВыгрузки + "\объекты\" + ТипОбъекта;
	СоздатьКаталог(КаталогТипа);
	
	Запись = Новый ЗаписьТекста(КаталогТипа + "\" + ИмяОбъекта + ".txt", КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(ПолноеИмяОбъекта);
	Запись.ЗаписатьСтроку("Ролей: " + СтрокиФайла.Количество());
	Запись.ЗаписатьСтроку("");
	Для Каждого Стр Из СтрокиФайла Цикл
		Запись.ЗаписатьСтроку(Стр);
	КонецЦикла;
	Запись.Закрыть();
	
	Результат.Объектов = Результат.Объектов + 1;
	Результат.Файлов = Результат.Файлов + 1;
	
КонецПроцедуры

// Возвращает роли конфигурации, права которых нужно выгрузить.
//
// Параметры:
//  ИсключаемыеРоли - Массив из СправочникСсылка.ИдентификаторыОбъектовМетаданных -
//                    роли, права которых не выгружаются.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданныхРоль - роли, права которых выгружаются.
//
Функция ПодготовитьСписокРолей(ИсключаемыеРоли)
	
	ИменаИсключаемыхРолей = Новый Соответствие;
	
	Если ЗначениеЗаполнено(ИсключаемыеРоли) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Идентификаторы.Имя КАК Имя
			|ИЗ
			|	Справочник.ИдентификаторыОбъектовМетаданных КАК Идентификаторы
			|ГДЕ
			|	Идентификаторы.Ссылка В (&СписокИсключений)";
		Запрос.УстановитьПараметр("СписокИсключений", ИсключаемыеРоли);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИменаИсключаемыхРолей.Вставить(Выборка.Имя, Истина);
		КонецЦикла;
		
	КонецЕсли;
	
	Роли = Новый Массив;
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если ИменаИсключаемыхРолей[Роль.Имя] = Неопределено Тогда
			Роли.Добавить(Роль);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Роли;
	
КонецФункции

// Добавляет подсистему и все ее вложенные подсистемы в соответствие подсистем.
//
// Параметры:
//  Подсистема    - ОбъектМетаданныхПодсистема - подсистема, которую нужно добавить;
//  ПрефиксИмени  - Строка - префикс полного имени подсистемы для прав роли, например "Subsystem.Продажи.";
//  ВсеПодсистемы - Соответствие из КлючИЗначение - соответствие, в которое добавляются подсистемы:
//                  * Ключ     - Строка - полное имя подсистемы для прав роли, например
//                              "Subsystem.Продажи.Subsystem.ОптовыеПродажи";
//                  * Значение - ОбъектМетаданныхПодсистема - подсистема.
//
Процедура ДобавитьПодсистемы(Знач Подсистема, Знач ПрефиксИмени, ВсеПодсистемы)
	
	ПолноеИмяДляПрав = ПрефиксИмени + "Subsystem." + Подсистема.Имя;
	ВсеПодсистемы.Вставить(ПолноеИмяДляПрав, Подсистема);
	
	Для Каждого ВложеннаяПодсистема Из Подсистема.Подсистемы Цикл
		ДобавитьПодсистемы(ВложеннаяПодсистема, ПолноеИмяДляПрав + ".", ВсеПодсистемы);
	КонецЦикла;
	
КонецПроцедуры

// Записывает файл с правами ролей на одну подсистему.
//
// Параметры:
//  КаталогПодсистем - Строка - каталог, в который выгружаются файлы подсистем;
//  ПолноеИмяДляПрав - Строка - полное имя подсистемы для прав роли, например
//                     "Subsystem.Продажи.Subsystem.ОптовыеПродажи";
//  СтрокиФайла      - Массив из Строка - строки с правами ролей;
//  Результат        - Структура - счетчики результата:
//   * Подсистем - Число - количество записанных подсистем;
//   * Файлов    - Число - количество записанных файлов.
//
Процедура ЗаписатьФайлПодсистемы(КаталогПодсистем, ПолноеИмяДляПрав, СтрокиФайла, Результат)
	
	Если СтрокиФайла.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРолей = Новый СписокЗначений;
	Для Каждого Стр Из СтрокиФайла Цикл
		ИменаРолей.Добавить(Стр);
	КонецЦикла;
	ИменаРолей.СортироватьПоПредставлению();
	
	ИмяФайла = СтрЗаменить(ПолноеИмяДляПрав, "Subsystem.", "");
	
	Запись = Новый ЗаписьТекста(КаталогПодсистем + "\" + ИмяФайла + ".txt", КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(ПолноеИмяДляПрав);
	Запись.ЗаписатьСтроку("Ролей: " + ИменаРолей.Количество());
	Запись.ЗаписатьСтроку("");
	Для Каждого Элемент Из ИменаРолей Цикл
		Запись.ЗаписатьСтроку(Элемент.Значение);
	КонецЦикла;
	Запись.Закрыть();
	
	Результат.Подсистем = Результат.Подсистем + 1;
	Результат.Файлов = Результат.Файлов + 1;
	
КонецПроцедуры

// Возвращает строку с правами роли по данным выборки регистра ПраваРолей.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - строка с правами роли.
//
// Возвращаемое значение:
//  Строка - список прав через запятую.
//
Функция ПраваРолиСтрокой(Выборка)
	
	Права = Новый Массив;
	Если Выборка.Чтение Тогда
		Права.Добавить("Чтение");
	КонецЕсли;
	Если Выборка.Добавление Тогда
		Права.Добавить("Добавление");
	КонецЕсли;
	Если Выборка.Изменение Тогда
		Права.Добавить("Изменение");
	КонецЕсли;
	Если Выборка.Просмотр Тогда
		Права.Добавить("Просмотр");
	КонецЕсли;
	Если Выборка.Редактирование Тогда
		Права.Добавить("Редактирование");
	КонецЕсли;
	Если Выборка.ИнтерактивноеДобавление Тогда
		Права.Добавить("ИнтерактивноеДобавление");
	КонецЕсли;
	
	Возврат СтрСоединить(Права, ", ");
	
КонецФункции

#КонецОбласти
