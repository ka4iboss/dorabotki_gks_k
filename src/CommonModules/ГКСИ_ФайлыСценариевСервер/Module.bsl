#Область ПрограммныйИнтерфейс

// Создаёт/обновляет присоединённые HTML-файлы описания сценария и сохраняет ссылки на них
// в табличной части ОписанияСценария.
//
// Выполняется в фоновом задании: внутри ПриЗаписи сценария эта работа держала транзакцию
// записи и блокировки, из-за чего база вставала при сохранении узлов и групп.
//
// Параметры:
//  СсылкаНаСценарий - СправочникСсылка.ДемонстрационныеСценарии - уже записанный узел инструкции.
//  HTMLПоЯзыкам     - Соответствие из КлючИЗначение - описания по языкам:
//                   * Ключ     - Строка - код языка;
//                   * Значение - Строка - текст HTML описания сценария.
//
Процедура СоздатьПрисоединенныеФайлыПоСсылке(СсылкаНаСценарий, HTMLПоЯзыкам) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаНаСценарий) ИЛИ HTMLПоЯзыкам = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектСценария = СсылкаНаСценарий.ПолучитьОбъект();
	Если ОбъектСценария = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяФайла = ОбъектСценария.ПолныйКод;

	// Карта вики-ссылок на группы и шаги строится один раз на запись: ссылки
	// [[Имя]] разбираются до сохранения HTML в присоединённый файл.
	КартаСсылок = ГКСИ_СсылкиСценариев.КартаСсылокСценариев();

	ЕстьИзменения = Ложь;

	Для Каждого КлючЗначение Из HTMLПоЯзыкам Цикл

		КодЯзыка  = КлючЗначение.Ключ;
		ТекстHTML = КлючЗначение.Значение;

		// GitHub Alerts: [!NOTE]/[!WARNING]/[!TIP]/[!IMPORTANT]/[!CAUTION] ->
		// <div class="markdown-alert markdown-alert-{type}">…</div>.
		// Прогоняем HTML до записи в присоединённый файл, чтобы при открытии
		// элемента/группы в HTMLDocumentField стили алертов применялись сразу,
		// без зависимости от JS-зеркала gksiPostprocessAlerts.
		ТекстHTML = ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ТекстHTML);
		// Ссылки [[Имя]] на группы и шаги: сохранённый HTML читают типовые поля
		// формы и альбом процессов, поэтому ссылки разбираются на сервере.
		// Идемпотентно: если ссылки уже заменены, конструкций [[…]] не остаётся.
		ТекстHTML = ГКСИ_СсылкиСценариев.ПодставитьСсылкиВТекст(ТекстHTML, КартаСсылок, "Навигация");
		// Видео !video(<путь>) -> HTML5-плеер: разбирается на сервере так же,
		// как ссылки (сохранённый HTML читают типовые поля и альбом). Идемпотентно.
		ТекстHTML = ГКСИ_Видео.РазметкуВидеоВHTML(ТекстHTML);

		Если НЕ ЗначениеЗаполнено(КодЯзыка) ИЛИ НЕ ЗначениеЗаполнено(ТекстHTML) Тогда
			Продолжить;
		КонецЕсли;

		СтруктураПоиска = Новый Структура("КодЯзыка", КодЯзыка);
		НайденныеСтроки = ОбъектСценария.ОписанияСценария.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаОписания = НайденныеСтроки[0];
		Иначе
			СтрокаОписания = ОбъектСценария.ОписанияСценария.Добавить();
			СтрокаОписания.КодЯзыка = КодЯзыка;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаОписания.ПрисоединенныйФайл) Тогда
			ДемонстрационныеСценарии.РезультатОбновленияПрисоединенногоФайла(
				СтрокаОписания.ПрисоединенныйФайл, Неопределено, ТекстHTML);
		Иначе
			СтрокаОписания.ПрисоединенныйФайл = СоздатьПрисоединенныйФайлСценария(
				СсылкаНаСценарий, ПолноеИмяФайла, КодЯзыка, ТекстHTML);
		КонецЕсли;

		ЕстьИзменения = Истина;

	КонецЦикла;

	Если НЕ ЕстьИзменения Тогда
		Возврат;
	КонецЕсли;

	// Служебная запись: версия не создаётся, коды и файлы повторно не пересчитываются.
	ОбъектСценария.ДополнительныеСвойства.Вставить("ГКСИ_СлужебнаяЗапись", Истина);
	ОбъектСценария.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт присоединённый HTML-файл сценария через типовое API РаботаСФайлами.
//
// Параметры:
//  ВладелецФайла - СправочникСсылка.ДемонстрационныеСценарии.
//  ПолныйКод     - Строка - полный код сценария.
//  КодЯзыка      - Строка.
//  ТекстHTML     - Строка.
//
// Возвращаемое значение:
//  СправочникСсылка.ДемонстрационныеСценарииПрисоединенныеФайлы, Неопределено - созданный файл.
//
Функция СоздатьПрисоединенныйФайлСценария(ВладелецФайла, ПолныйКод, КодЯзыка, ТекстHTML)

	ДвоичныеДанныеФайла       = ПолучитьДвоичныеДанныеИзСтроки(ТекстHTML, КодировкаТекста.UTF8);
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);

	ПараметрыЗаписиФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыЗаписиФайла.ВладелецФайлов     = ВладелецФайла;
	ПараметрыЗаписиФайла.ИмяБезРасширения   = ДемонстрационныеСценарииКлиентСервер.ИмяФайлаОписанияСценария(
		ПолныйКод, КодЯзыка);
	ПараметрыЗаписиФайла.РасширениеБезТочки = "HTML";

	Возврат РаботаСФайлами.ДобавитьФайл(ПараметрыЗаписиФайла, АдресВоВременномХранилище, "");

КонецФункции

#КонецОбласти

#КонецЕсли
