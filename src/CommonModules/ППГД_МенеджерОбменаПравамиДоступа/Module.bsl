#Область СлужебныйПрограммныйИнтерфейс
Процедура ПередКонвертацией(КомпонентыОбмена) Экспорт
    // Обработчик обязателен по контракту менеджера обмена, дополнительных действий не требует.
    Возврат;
КонецПроцедуры


Процедура ВыгрузитьГруппуДоступа(КомпонентыОбмена, ДанныеИБ, Приемник, СтекВыгрузки) Экспорт
    
    Если ДанныеИБ.ЭтоГруппа Тогда
        Если ЗначениеЗаполнено(ДанныеИБ.Родитель) Тогда
            Приемник.Вставить("Родитель", ДанныеИБ.Родитель.Наименование); 
        КонецЕсли;
        Приемник.Вставить("Наименование", ДанныеИБ.Наименование);
        
    Иначе 
        Приемник.Вставить("Профиль", ДанныеИБ.Профиль.Наименование);    
        
        ЗначенияДоступа = ДанныеИБ.ЗначенияДоступа.Выгрузить();
        Приемник.Вставить("ЗначенияДоступа", ЗначенияДоступа);    

        ВидыДоступа = ДанныеИБ.ВидыДоступа.Выгрузить();
        Приемник.Вставить("ВидыДоступа", ВидыДоступа);
        
        Если ЗначениеЗаполнено(ДанныеИБ.Родитель) Тогда
            Приемник.Вставить("Родитель", ДанныеИБ.Родитель.Наименование);
        КонецЕсли;    
        Приемник.Вставить("Наименование", ДанныеИБ.Наименование);

    КонецЕсли;
    
КонецПроцедуры     

Процедура ВыгрузитьПрофиль(КомпонентыОбмена, ДанныеИБ, Приемник, СтекВыгрузки) Экспорт
    
    Если ДанныеИБ.ЭтоГруппа Тогда
        Если ЗначениеЗаполнено(ДанныеИБ.Родитель) Тогда
            Приемник.Вставить("Родитель", ДанныеИБ.Родитель.Наименование); 
        КонецЕсли;
        Приемник.Вставить("Наименование", ДанныеИБ.Наименование);
        
    Иначе 

        ЗначенияДоступа = ДанныеИБ.ЗначенияДоступа.Выгрузить();
        Приемник.Вставить("ЗначенияДоступа", ЗначенияДоступа); 
        
        ВидыДоступа = ДанныеИБ.ВидыДоступа.Выгрузить();
        Приемник.Вставить("ВидыДоступа", ВидыДоступа);
        
        Роли = ДанныеИБ.Роли.Выгрузить();
        Приемник.Вставить("Роли", Роли);

        Если ЗначениеЗаполнено(ДанныеИБ.Родитель) Тогда
            Приемник.Вставить("Родитель", ДанныеИБ.Родитель.Наименование);
        КонецЕсли;    
        Приемник.Вставить("Наименование", ДанныеИБ.Наименование);
        
        Назначение = ДанныеИБ.Назначение.Выгрузить();
        Приемник.Вставить("Назначение", Назначение);    
        
    КонецЕсли;
    
КонецПроцедуры

// *** НОВЫЕ ПРОЦЕДУРЫ ДЛЯ ГРУПП ПОЛЬЗОВАТЕЛЕЙ И ПОЛЬЗОВАТЕЛЕЙ ***

Процедура ВыгрузитьГруппуПользователей(КомпонентыОбмена, ДанныеИБ, Приемник, СтекВыгрузки) Экспорт
    
    Приемник.Вставить("Наименование", ДанныеИБ.Наименование);
    Если ЗначениеЗаполнено(ДанныеИБ.Родитель) Тогда
        Приемник.Вставить("Родитель", ДанныеИБ.Родитель.Наименование);
    КонецЕсли;
    Приемник.Вставить("ЭтоГруппа", Истина);
    Приемник.Вставить("ПометкаУдаления", ДанныеИБ.ПометкаУдаления);
    
    // Выгружаем табличную часть "Состав"
    Состав = ДанныеИБ.Состав.Выгрузить();
    Приемник.Вставить("Состав", Состав);
    
КонецПроцедуры

Процедура ВыгрузитьПользователя(КомпонентыОбмена, ДанныеИБ, Приемник, СтекВыгрузки) Экспорт
    
    Приемник.Вставить("Наименование",      ДанныеИБ.Наименование);
    Приемник.Вставить("ПометкаУдаления",   ДанныеИБ.ПометкаУдаления);
    
    // Реквизитов "Родитель" или "ГруппаПользователей" у пользователя нет
    // Связь с группами устанавливается через состав групп при импорте
    
    Попытка
        Приемник.Вставить("ПолноеНаименование", ДанныеИБ.НаименованиеПолное);
    Исключение
        Приемник.Вставить("ПолноеНаименование", ДанныеИБ.Наименование);
    КонецПопытки;
    
КонецПроцедуры

#КонецОбласти


