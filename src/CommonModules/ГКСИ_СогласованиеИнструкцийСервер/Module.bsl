#Область ПрограммныйИнтерфейс

// Определяет корневую инструкцию (корневую группу) для указанного узла справочника
// ДемонстрационныеСценарии, поднимаясь по иерархии групп до узла без родителей.
//
// Параметры:
//  Узел - СправочникСсылка.ДемонстрационныеСценарии - группа или элемент инструкции.
//
// Возвращаемое значение:
//  СправочникСсылка.ДемонстрационныеСценарии - корневая группа-инструкция.
//
Функция ОпределитьКорневуюИнструкцию(Знач Узел) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Возврат Справочники.ДемонстрационныеСценарии.ПустаяСсылка();
	КонецЕсли;
	
	ТекущийУзел = Узел;
	Шагов = 0;
	
	Пока Шагов < 50 Цикл
		
		Родители = ГКСИ_ГруппыСценариевСервер.ПолучитьГруппыСценария(ТекущийУзел);
		Если Родители.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ТекущийУзел = Родители[0];
		Шагов = Шагов + 1;
		
	КонецЦикла;
	
	Возврат ТекущийУзел;
	
КонецФункции

// Запускает бизнес-процесс согласования для указанного узла инструкции.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//  ВидСогласования - ПеречислениеСсылка.ГКСИ_ВидыСогласованияИнструкций - вид согласования
//                    (вся инструкция либо отдельный элемент).
//
// Возвращаемое значение:
//  БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - запущенный бизнес-процесс.
//
Функция ЗапуститьСогласование(Знач Предмет, Знач ВидСогласования) Экспорт
	
	ОбеспечитьВерсионированиеИнструкций();
	
	Процесс = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.СоздатьБизнесПроцесс();
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Предмет", Предмет);
	ДанныеЗаполнения.Вставить("ВидСогласования", ВидСогласования);
	ДанныеЗаполнения.Вставить("КорневаяИнструкция", ОпределитьКорневуюИнструкцию(Предмет));
	ДанныеЗаполнения.Вставить("Автор", Пользователи.ТекущийПользователь());
	
	Процесс.Заполнить(ДанныеЗаполнения);
	
	ДатаСтарта = ТекущаяДатаСеанса();
	Процесс.Дата = ДатаСтарта;
	Процесс.ДатаНачала = ДатаСтарта;
	
	Процесс.Записать();
	Процесс.Старт();
	
	Возврат Процесс.Ссылка;
	
КонецФункции

// Возвращает параметры открытия формы первой невыполненной задачи бизнес-процесса.
// Используется, чтобы сразу после запуска согласования открыть исполнителю форму его задачи.
//
// Параметры:
//  БизнесПроцесс - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - запущенный бизнес-процесс.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля ИмяФормы и ПараметрыФормы для метода ОткрытьФорму;
//                            Неопределено - если у бизнес-процесса нет невыполненных задач.
//
Функция ПараметрыОткрытияПервойЗадачи(Знач БизнесПроцесс) Экспорт
	
	Если НЕ ЗначениеЗаполнено(БизнесПроцесс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка КАК Задача,
		|	Задачи.ТочкаМаршрута КАК ТочкаМаршрута
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.БизнесПроцесс = &БизнесПроцесс
		|	И НЕ Задачи.Выполнена
		|
		|УПОРЯДОЧИТЬ ПО
		|	Задачи.Дата";
	
	Запрос.УстановитьПараметр("БизнесПроцесс", БизнесПроцесс);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ФормаВыполненияЗадачи(
		Выборка.Задача, Выборка.ТочкаМаршрута);
	
КонецФункции

// Устанавливает статус согласуемому объекту.
//
// Если согласуется вся инструкция (согласуемый объект совпадает с корневой группой),
// статус получают все группы и элементы инструкции. Если согласуется отдельная
// (не корневая) группа или элемент, статус получает только этот узел.
//
// Параметры:
//  СогласуемыйОбъект - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//  КорневаяИнструкция - СправочникСсылка.ДемонстрационныеСценарии - корневая инструкция узла.
//  Статус - ПеречислениеСсылка.СтатусыДемонстрационныхСценариев - устанавливаемый статус.
//
Процедура УстановитьСтатусСогласования(Знач СогласуемыйОбъект, Знач КорневаяИнструкция, Знач Статус) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КореньИнструкции = КорневаяИнструкция;
	Если НЕ ЗначениеЗаполнено(КореньИнструкции) Тогда
		КореньИнструкции = СогласуемыйОбъект;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СогласуемыйОбъект) И СогласуемыйОбъект = КореньИнструкции Тогда
		УстановитьСтатусПоИнструкции(КореньИнструкции, Статус);
	Иначе
		УстановитьСтатусОбъекта(СогласуемыйОбъект, Статус);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Проверяет, включено ли в программе версионирование объектов.
//
// Возвращаемое значение:
//  Булево - Истина, если версионирование объектов включено.
//
Функция ИспользуетсяВерсионированиеИнструкций() Экспорт
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьВерсионированиеОбъектов");
	
КонецФункции

// Включает версионирование узлов инструкций (демонстрационных сценариев), если оно ещё не включено.
//
// Возвращаемое значение:
//  Булево - Истина, если версионирование инструкций доступно после вызова.
//
Функция ОбеспечитьВерсионированиеИнструкций() Экспорт
	
	Если НЕ ИспользуетсяВерсионированиеИнструкций() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяОбъекта = "Справочник.ДемонстрационныеСценарии";
	
	Если НЕ ВерсионированиеОбъектов.ВключеноВерсионированиеОбъекта(ИмяОбъекта) Тогда
		ВерсионированиеОбъектов.ВключитьВерсионированиеОбъекта(ИмяОбъекта,
			Перечисления.ВариантыВерсионированияОбъектов.ВерсионироватьПриЗаписи);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Записывает версию узла инструкции при обычной записи объекта.
// Вызывается из объектного модуля справочника, так как подписка БСП на запись
// версии не срабатывает для объектного типа сценария в расширении.
//
// Параметры:
//  Источник - СправочникОбъект.ДемонстрационныеСценарии - записываемый узел инструкции.
//
Процедура ЗаписатьВерсиюИнструкции(Знач Источник) Экспорт
	
	Если НЕ ОбеспечитьВерсионированиеИнструкций() Тогда
		Возврат;
	КонецЕсли;
	
	ВерсионированиеОбъектов.ЗаписатьВерсиюОбъекта(Источник, Ложь);
	
КонецПроцедуры

// Возвращает номер последней версии согласуемого узла инструкции.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//
// Возвращаемое значение:
//  Число - номер последней версии узла; 0, если версионирование не используется.
//
Функция НомерВерсииСогласуемогоУзла(Знач Предмет) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Предмет) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НЕ ИспользуетсяВерсионированиеИнструкций() Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ВерсионированиеОбъектов.НомерПоследнейВерсии(Предмет);
	
КонецФункции

// Возвращает подписантов узла инструкции с их последними результатами согласования.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//  ВключатьУзлыИнструкции - Булево - Истина, если выводить подписантов всей инструкции вместе
//                          с её вложенными узлами (для формы группы).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * Сотрудник - СправочникСсылка.Пользователи - подписант;
//   * Этап - Строка - этап согласования;
//   * РезультатСогласования - ПеречислениеСсылка.ГКСИ_РезультатыСогласованияИнструкций - результат;
//   * Комментарий - Строка - комментарий подписанта;
//   * ДатаСогласования - Дата - дата подписания;
//   * НомерВерсии - Число - номер версии инструкции, которую подписал участник;
//   * Узел - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//
Функция ПодписантыПоПредмету(Знач Предмет, ВключатьУзлыИнструкции = Ложь) Экспорт
	
	Подписанты = Новый ТаблицаЗначений;
	Подписанты.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Подписанты.Колонки.Добавить("Этап", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Подписанты.Колонки.Добавить("РезультатСогласования", Новый ОписаниеТипов("ПеречислениеСсылка.ГКСИ_РезультатыСогласованияИнструкций"));
	Подписанты.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Подписанты.Колонки.Добавить("ДатаСогласования", Новый ОписаниеТипов("Дата"));
	Подписанты.Колонки.Добавить("НомерВерсии", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Подписанты.Колонки.Добавить("Узел", Новый ОписаниеТипов("СправочникСсылка.ДемонстрационныеСценарии"));
	
	Если НЕ ЗначениеЗаполнено(Предмет) Тогда
		Возврат Подписанты;
	КонецЕсли;
	
	УсловиеПоУзламИнструкции = ?(ВключатьУзлыИнструкции,
		"ИЛИ Участники.Ссылка.КорневаяИнструкция = &Предмет",
		"");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Участники.Сотрудник КАК Сотрудник,
		|	Участники.РезультатСогласования КАК РезультатСогласования,
		|	Участники.Комментарий КАК Комментарий,
		|	Участники.ДатаСогласования КАК ДатаСогласования,
		|	Участники.НомерВерсии КАК НомерВерсии,
		|	Участники.Ссылка.Предмет КАК Узел,
		|	Участники.Ссылка.Дата КАК ДатаПроцесса,
		|	""Согласование начальниками отделов"" КАК Этап
		|ИЗ
		|	БизнесПроцесс.ГКСИ_СогласованиеИнструкции.Начальники КАК Участники
		|ГДЕ
		|	НЕ Участники.Ссылка.ПометкаУдаления
		|	И (Участники.Ссылка.Предмет = &Предмет " + УсловиеПоУзламИнструкции + ")
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Участники.Сотрудник,
		|	Участники.РезультатСогласования,
		|	Участники.Комментарий,
		|	Участники.ДатаСогласования,
		|	Участники.НомерВерсии,
		|	Участники.Ссылка.Предмет,
		|	Участники.Ссылка.Дата,
		|	""Согласование подчинёнными""
		|ИЗ
		|	БизнесПроцесс.ГКСИ_СогласованиеИнструкции.Подчинённые КАК Участники
		|ГДЕ
		|	НЕ Участники.Ссылка.ПометкаУдаления
		|	И (Участники.Ссылка.Предмет = &Предмет " + УсловиеПоУзламИнструкции + ")
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПроцесса УБЫВ";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыведенныеСотрудники = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Сотрудник)
			ИЛИ ВыведенныеСотрудники.Получить(Выборка.Сотрудник) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПодписанта = Подписанты.Добавить();
		СтрокаПодписанта.Сотрудник = Выборка.Сотрудник;
		СтрокаПодписанта.Этап = Выборка.Этап;
		СтрокаПодписанта.РезультатСогласования = Выборка.РезультатСогласования;
		СтрокаПодписанта.Комментарий = Выборка.Комментарий;
		СтрокаПодписанта.ДатаСогласования = Выборка.ДатаСогласования;
		СтрокаПодписанта.НомерВерсии = Выборка.НомерВерсии;
		СтрокаПодписанта.Узел = Выборка.Узел;
		
		ВыведенныеСотрудники.Вставить(Выборка.Сотрудник, Истина);
		
	КонецЦикла;
	
	Возврат Подписанты;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает статус всем узлам (группам и элементам) инструкции.
//
// Состав узлов инструкции берётся из регистра сведений ГКСИ_ГруппыСценариев
// по измерению КореньИнструкции.
//
// Параметры:
//  КорневаяИнструкция - СправочникСсылка.ДемонстрационныеСценарии - корневая группа-инструкция.
//  Статус - ПеречислениеСсылка.СтатусыДемонстрационныхСценариев - устанавливаемый статус.
//
Процедура УстановитьСтатусПоИнструкции(Знач КорневаяИнструкция, Знач Статус)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыСценариев.Сценарий КАК Узел
		|ИЗ
		|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГруппыСценариев
		|ГДЕ
		|	ГруппыСценариев.КореньИнструкции = &КорневаяИнструкция";
	
	Запрос.УстановитьПараметр("КорневаяИнструкция", КорневаяИнструкция);
	
	УзлыИнструкции = Новый Массив;
	УзлыИнструкции.Добавить(КорневаяИнструкция);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Узел <> КорневаяИнструкция Тогда
			УзлыИнструкции.Добавить(Выборка.Узел);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Узел Из УзлыИнструкции Цикл
		УстановитьСтатусОбъекта(Узел, Статус);
	КонецЦикла;
	
КонецПроцедуры

// Записывает статус в элемент справочника ДемонстрационныеСценарии.
//
// Параметры:
//  Ссылка - СправочникСсылка.ДемонстрационныеСценарии - изменяемый узел.
//  Статус - ПеречислениеСсылка.СтатусыДемонстрационныхСценариев - устанавливаемый статус.
//
Процедура УстановитьСтатусОбъекта(Знач Ссылка, Знач Статус)
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектИнструкции = Ссылка.ПолучитьОбъект();
	Если ОбъектИнструкции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектИнструкции.ОбменДанными.Загрузка = Истина;
	ОбъектИнструкции.Статус = Статус;
	ОбъектИнструкции.Записать();
	
КонецПроцедуры

// Возвращает HTML-документ всей инструкции (корневой группы со всеми вложенными узлами).
// Используется при старте согласования: HTML фиксируется в реквизите процесса,
// чтобы задача показывала тот текст, который согласовывается.
//
// Параметры:
//  КорневаяИнструкция - СправочникСсылка.ДемонстрационныеСценарии - корневая группа-инструкция.
//
// Возвращаемое значение:
//  Строка - HTML-документ инструкции; пустая строка, если инструкция не заполнена.
//
Функция HTMLИнструкции(Знач КорневаяИнструкция) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КорневаяИнструкция) Тогда
		Возврат "";
	КонецЕсли;
	
	ГруппыДляАльбома = Новый Массив;
	ГруппыДляАльбома.Добавить(КорневаяИнструкция);
	
	Возврат ГКСИ_АльбомПроцессов.СобратьДокументАльбомаПоГруппам(ГруппыДляАльбома);
	
КонецФункции

// Возвращает HTML-описание одного узла инструкции (элемента или группы) на указанном языке.
//
// Параметры:
//  Узел - СправочникСсылка.ДемонстрационныеСценарии - узел инструкции.
//  КодЯзыка - Строка - код языка описания; пустая строка - текущий язык сеанса.
//
// Возвращаемое значение:
//  Строка - HTML-описание узла; пустая строка, если описание не найдено.
//
Функция HTMLУзла(Знач Узел, КодЯзыка = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодЯзыка) Тогда
		КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	КонецЕсли;
	
	ПрисоединенныйФайл = ПрисоединенныйФайлОписанияУзла(Узел, КодЯзыка);
	
	Если НЕ ЗначениеЗаполнено(ПрисоединенныйФайл) Тогда
		Возврат "";
	КонецЕсли;
	
	ДанныеФайла = ДемонстрационныеСценарии.ДанныеПрисоединенногоФайлаДляФормыОбъекта(ПрисоединенныйФайл);
	
	Возврат ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ДанныеФайла.ТекстHTML);
	
КонецФункции

// Возвращает ссылку на присоединённый файл описания узла: сначала на указанном языке,
// затем - на любом языке, для которого файл заполнен.
//
// Параметры:
//  Узел - СправочникСсылка.ДемонстрационныеСценарии - узел инструкции.
//  КодЯзыка - Строка - код языка.
//
// Возвращаемое значение:
//  СправочникСсылка.ДемонстрационныеСценарииПрисоединенныеФайлы - ссылка на файл или пустая ссылка.
//
Функция ПрисоединенныйФайлОписанияУзла(Знач Узел, КодЯзыка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОписанияСценария.КодЯзыка КАК КодЯзыка,
		|	ОписанияСценария.ПрисоединенныйФайл КАК ПрисоединенныйФайл
		|ИЗ
		|	Справочник.ДемонстрационныеСценарии.ОписанияСценария КАК ОписанияСценария
		|ГДЕ
		|	ОписанияСценария.Ссылка = &Узел
		|	И ОписанияСценария.ПрисоединенныйФайл <> ЗНАЧЕНИЕ(Справочник.ДемонстрационныеСценарииПрисоединенныеФайлы.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Узел", Узел);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Язык сравнивается во встроенном языке: поле КодЯзыка в табличной части имеет
	// неограниченную длину и в запросе не сравнивается с параметром.
	ФайлЛюбогоЯзыка = Справочники.ДемонстрационныеСценарииПрисоединенныеФайлы.ПустаяСсылка();
	
	Пока Выборка.Следующий() Цикл
		
		Если СокрЛП(Строка(Выборка.КодЯзыка)) = СокрЛП(КодЯзыка) Тогда
			Возврат Выборка.ПрисоединенныйФайл;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ФайлЛюбогоЯзыка) Тогда
			ФайлЛюбогоЯзыка = Выборка.ПрисоединенныйФайл;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ФайлЛюбогоЯзыка;
	
КонецФункции

// Возвращает номер последней версии узла, которую подписали согласующие.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//
// Возвращаемое значение:
//  Число - номер версии; 0, если узел ещё ни разу не согласовывался.
//
Функция НомерПоследнейПодписаннойВерсии(Знач Предмет) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Предмет) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Участники.НомерВерсии) КАК НомерВерсии
		|ИЗ
		|	(ВЫБРАТЬ
		|		Начальники.НомерВерсии КАК НомерВерсии
		|	ИЗ
		|		БизнесПроцесс.ГКСИ_СогласованиеИнструкции.Начальники КАК Начальники
		|	ГДЕ
		|		Начальники.Ссылка.Предмет = &Предмет
		|		И НЕ Начальники.Ссылка.ПометкаУдаления
		|		И Начальники.РезультатСогласования = ЗНАЧЕНИЕ(Перечисление.ГКСИ_РезультатыСогласованияИнструкций.Согласовано)
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Подчинённые.НомерВерсии
		|	ИЗ
		|		БизнесПроцесс.ГКСИ_СогласованиеИнструкции.Подчинённые КАК Подчинённые
		|	ГДЕ
		|		Подчинённые.Ссылка.Предмет = &Предмет
		|		И НЕ Подчинённые.Ссылка.ПометкаУдаления
		|		И Подчинённые.РезультатСогласования = ЗНАЧЕНИЕ(Перечисление.ГКСИ_РезультатыСогласованияИнструкций.Согласовано)) КАК Участники";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Выборка.НомерВерсии) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Выборка.НомерВерсии;
	
КонецФункции

// Возвращает номер последней версии узла, в которой статус согласования был "Проверено".
// Такая версия считается крайней проверенной (подписанной) и служит базой для сравнения.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - узел инструкции.
//
// Возвращаемое значение:
//  Число - номер версии; 0, если проверенных версий нет.
//
Функция НомерПоследнейПровереннойВерсии(Знач Предмет) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Предмет) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВерсииОбъектов.НомерВерсии КАК НомерВерсии
		|ИЗ
		|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
		|ГДЕ
		|	ВерсииОбъектов.Объект = &Объект
		|УПОРЯДОЧИТЬ ПО
		|	НомерВерсии УБЫВ";
	
	Запрос.УстановитьПараметр("Объект", Предмет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Ограничение на разбор истории: проверенная версия обычно одна из последних.
	ПровереноВерсий = 0;
	
	Пока Выборка.Следующий() И ПровереноВерсий < 100 Цикл
		
		ПровереноВерсий = ПровереноВерсий + 1;
		
		Если ВерсияСодержитСтатусПроверено(Предмет, Выборка.НомерВерсии) Тогда
			Возврат Выборка.НомерВерсии;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

// Проверяет, был ли статус узла в указанной версии равен "Проверено".
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - узел инструкции.
//  НомерВерсии - Число - номер версии.
//
// Возвращаемое значение:
//  Булево - Истина, если в версии статус "Проверено".
//
Функция ВерсияСодержитСтатусПроверено(Знач Предмет, Знач НомерВерсии)
	
	Разбор = ВерсионированиеОбъектов.РазборВерсии(Предмет, НомерВерсии);
	
	Если Разбор = Неопределено ИЛИ НЕ Разбор.Свойство("Реквизиты") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтатусПроверено = Перечисления.СтатусыДемонстрационныхСценариев.Проверено;
	
	Для Каждого Реквизит Из Разбор.Реквизиты Цикл
		
		Если СокрЛП(Строка(Реквизит.НаименованиеРеквизита)) <> "Статус" Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеСтатуса = Реквизит.ЗначениеРеквизита;
		
		Возврат ЗначениеСтатуса = СтатусПроверено
			ИЛИ СокрЛП(Строка(ЗначениеСтатуса)) = СокрЛП(Строка(СтатусПроверено));
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает текст Markdown узла из указанной версии.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - узел инструкции.
//  НомерВерсии - Число - номер версии.
//
// Возвращаемое значение:
//  Строка - текст Markdown всех языков; пустая строка, если версия недоступна.
//
Функция ТекстMarkdownВерсии(Знач Предмет, Знач НомерВерсии) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Предмет) ИЛИ НомерВерсии <= 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Разбор = ВерсионированиеОбъектов.РазборВерсии(Предмет, НомерВерсии);
	
	Если Разбор = Неопределено ИЛИ НЕ Разбор.Свойство("Реквизиты") Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого Реквизит Из Разбор.Реквизиты Цикл
		ИмяРеквизита = СокрЛП(Строка(Реквизит.НаименованиеРеквизита));
		Если СтрНайти(ВРег(ИмяРеквизита), "ТЕКСТMARKDOWN") > 0 Тогда
			Возврат Строка(Реквизит.ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Возвращает текущий текст Markdown узла инструкции.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - узел инструкции.
//
// Возвращаемое значение:
//  Строка - текст Markdown всех языков.
//
Функция ТекстMarkdownТекущий(Знач Предмет) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Предмет) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Предмет, "ГКСИ_ТекстMarkdown");
	
КонецФункции

// Возвращает сегмент Markdown указанного языка из полного текста узла.
//
// Параметры:
//  ПолныйТекст - Строка - текст Markdown всех языков с разделителями.
//  КодЯзыка - Строка - код языка.
//
// Возвращаемое значение:
//  Строка - текст на указанном языке; если сегмент не найден - весь полный текст.
//
Функция ТекстMarkdownПоКодуЯзыка(Знач ПолныйТекст, КодЯзыка = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПолныйТекст) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодЯзыка) Тогда
		КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	КонецЕсли;
	
	КодЯзыка = СокрЛП(Строка(КодЯзыка));
	
	НачалоСегмента = "<!--md:lang:" + КодЯзыка + "-->";
	КонецСегмента = "<!--/md:lang:" + КодЯзыка + "-->";
	
	// Поиск без учёта регистра: ВРег не меняет длину строки, поэтому позиции
	// найденных маркеров применимы к исходному тексту.
	ТекстДляПоиска = ВРег(ПолныйТекст);
	ПозицияНачала = СтрНайти(ТекстДляПоиска, ВРег(НачалоСегмента));
	
	Если ПозицияНачала > 0 Тогда
		
		ПозицияСодержимого = ПозицияНачала + СтрДлина(НачалоСегмента);
		ПозицияКонца = СтрНайти(ТекстДляПоиска, ВРег(КонецСегмента), , ПозицияСодержимого);
		
		Если ПозицияКонца > 0 Тогда
			Результат = Сред(ПолныйТекст, ПозицияСодержимого, ПозицияКонца - ПозицияСодержимого);
		Иначе
			Результат = Сред(ПолныйТекст, ПозицияСодержимого);
		КонецЕсли;
		
	Иначе
		// Маркеров нет - текст хранится без разделителей языков.
		Результат = ПолныйТекст;
	КонецЕсли;
	
	// Страховка: маркеры языковых сегментов не должны попадать в текст для показа.
	Результат = СтрЗаменитьПоРегулярномуВыражению(Результат, "<!--/?md:lang:[A-Za-z0-9_-]+-->", "");
	
	Возврат СокрЛП(Результат);
	
КонецФункции

// Возвращает HTML с построчными различиями двух текстов Markdown.
//
// Параметры:
//  ПрежнийТекст - Строка - текст подписанной версии.
//  НовыйТекст - Строка - текущий текст.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент с подсветкой добавленных и удалённых строк;
//           пустая строка, если различий нет.
//
Функция HTMLРазличийТекстов(Знач ПрежнийТекст, Знач НовыйТекст) Экспорт
	
	Если ПрежнийТекст = НовыйТекст Тогда
		Возврат "";
	КонецЕсли;
	
	СтарыеСтроки = СтрРазделить(ПрежнийТекст, Символы.ПС, Ложь);
	НовыеСтроки = СтрРазделить(НовыйТекст, Символы.ПС, Ложь);
	
	Различия = ВычислитьРазличияСтрок(СтарыеСтроки, НовыеСтроки);
	
	ЕстьРазличия = Ложь;
	Для Каждого СтрокаРазличия Из Различия Цикл
		Если СтрокаРазличия.Вид <> "Равно" Тогда
			ЕстьРазличия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьРазличия Тогда
		Возврат "";
	КонецЕсли;
	
	Фрагменты = Новый Массив;
	
	Для Каждого СтрокаРазличия Из Различия Цикл
		
		ТекстСтроки = ЭкранироватьHTMLТекст(СтрокаРазличия.Текст);
		
		Если СтрокаРазличия.Вид = "Добавлено" Тогда
			Фрагменты.Добавить("<div style=""background-color:#e6ffed;color:#04440f;"">+ " + ТекстСтроки + "</div>");
		ИначеЕсли СтрокаРазличия.Вид = "Удалено" Тогда
			Фрагменты.Добавить("<div style=""background-color:#ffecec;color:#6b0f0f;text-decoration:line-through;"">- " + ТекстСтроки + "</div>");
		Иначе
			Фрагменты.Добавить("<div style=""color:#666666;"">&nbsp;&nbsp;" + ТекстСтроки + "</div>");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "<div style=""font-family:Consolas,monospace;font-size:9pt;white-space:pre-wrap;"">"
		+ СтрСоединить(Фрагменты, "")
		+ "</div>";
	
КонецФункции

// Вычисляет построчные различия двух массивов строк.
//
// Параметры:
//  СтарыеСтроки - Массив из Строка - строки прежнего текста.
//  НовыеСтроки - Массив из Строка - строки нового текста.
//
// Возвращаемое значение:
//  Массив из Структура - элементы с полями:
//   * Вид - Строка - "Равно", "Удалено" или "Добавлено";
//   * Текст - Строка - текст строки.
//
Функция ВычислитьРазличияСтрок(СтарыеСтроки, НовыеСтроки)
	
	Результат = Новый Массив;
	
	КоличествоСтарых = СтарыеСтроки.Количество();
	КоличествоНовых = НовыеСтроки.Количество();
	
	// Защита от квадратичной сложности на больших текстах: при превышении
	// лимита выводим блок целиком как удалённый и добавленный.
	Если КоличествоСтарых * КоличествоНовых > 1000000 Тогда
		Для Каждого ТекстСтроки Из СтарыеСтроки Цикл
			ДобавитьСтрокуРазличия(Результат, "Удалено", ТекстСтроки);
		КонецЦикла;
		Для Каждого ТекстСтроки Из НовыеСтроки Цикл
			ДобавитьСтрокуРазличия(Результат, "Добавлено", ТекстСтроки);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
	Матрица = Новый Массив(КоличествоСтарых + 1);
	Для ИндексСтарой = 0 По КоличествоСтарых Цикл
		СтрокаМатрицы = Новый Массив(КоличествоНовых + 1);
		Для ИндексНовой = 0 По КоличествоНовых Цикл
			СтрокаМатрицы[ИндексНовой] = 0;
		КонецЦикла;
		Матрица[ИндексСтарой] = СтрокаМатрицы;
	КонецЦикла;
	
	Для ИндексСтарой = 1 По КоличествоСтарых Цикл
		Для ИндексНовой = 1 По КоличествоНовых Цикл
			Если СтарыеСтроки[ИндексСтарой - 1] = НовыеСтроки[ИндексНовой - 1] Тогда
				Матрица[ИндексСтарой][ИндексНовой] = Матрица[ИндексСтарой - 1][ИндексНовой - 1] + 1;
			Иначе
				Матрица[ИндексСтарой][ИндексНовой] = Макс(
					Матрица[ИндексСтарой - 1][ИндексНовой],
					Матрица[ИндексСтарой][ИндексНовой - 1]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Восстановление последовательности идёт с конца, поэтому строки накапливаются
	// в обратном порядке и затем переворачиваются.
	ОбратныйРезультат = Новый Массив;
	
	ИндексСтарой = КоличествоСтарых;
	ИндексНовой = КоличествоНовых;
	
	Пока ИндексСтарой > 0 И ИндексНовой > 0 Цикл
		Если СтарыеСтроки[ИндексСтарой - 1] = НовыеСтроки[ИндексНовой - 1] Тогда
			ДобавитьСтрокуРазличия(ОбратныйРезультат, "Равно", СтарыеСтроки[ИндексСтарой - 1]);
			ИндексСтарой = ИндексСтарой - 1;
			ИндексНовой = ИндексНовой - 1;
		ИначеЕсли Матрица[ИндексСтарой - 1][ИндексНовой] >= Матрица[ИндексСтарой][ИндексНовой - 1] Тогда
			ДобавитьСтрокуРазличия(ОбратныйРезультат, "Удалено", СтарыеСтроки[ИндексСтарой - 1]);
			ИндексСтарой = ИндексСтарой - 1;
		Иначе
			ДобавитьСтрокуРазличия(ОбратныйРезультат, "Добавлено", НовыеСтроки[ИндексНовой - 1]);
			ИндексНовой = ИндексНовой - 1;
		КонецЕсли;
	КонецЦикла;
	
	Пока ИндексСтарой > 0 Цикл
		ДобавитьСтрокуРазличия(ОбратныйРезультат, "Удалено", СтарыеСтроки[ИндексСтарой - 1]);
		ИндексСтарой = ИндексСтарой - 1;
	КонецЦикла;
	
	Пока ИндексНовой > 0 Цикл
		ДобавитьСтрокуРазличия(ОбратныйРезультат, "Добавлено", НовыеСтроки[ИндексНовой - 1]);
		ИндексНовой = ИндексНовой - 1;
	КонецЦикла;
	
	Для Индекс = ОбратныйРезультат.Количество() - 1 По 0 Цикл
		Результат.Добавить(ОбратныйРезультат[Индекс]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет строку в результат вычисления различий.
//
// Параметры:
//  Результат - Массив из Структура - результат вычисления различий.
//  Вид - Строка - "Равно", "Удалено" или "Добавлено".
//  Текст - Строка - текст строки.
//
Процедура ДобавитьСтрокуРазличия(Результат, Вид, Текст)
	
	СтрокаРазличия = Новый Структура("Вид, Текст", Вид, Текст);
	Результат.Добавить(СтрокаРазличия);
	
КонецПроцедуры

// Экранирует спецсимволы HTML в тексте.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML.
//
Функция ЭкранироватьHTMLТекст(Текст) Экспорт
	
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
