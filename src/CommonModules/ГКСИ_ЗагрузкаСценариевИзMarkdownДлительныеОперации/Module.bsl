// Общий модуль ГКСИ_ЗагрузкаСценариевИзMarkdownДлительныеОперации.
//
// Серверная точка входа для запуска длительной операции записи дерева
// сценариев в фоновом задании.
//
// Контракт вызова задаётся библиотекой ДлительныеОперации:
// при вызове ДлительныеОперации.ВыполнитьВФоне(ИмяПроцедуры, ПараметрыПроцедуры, ...)
// БСП оборачивает переданное ПараметрыПроцедуры в массив первым элементом
// и добавляет вторым элементом АдресРезультата. Поэтому фактическая сигнатура
// вызываемой процедуры всегда:
//
//     ЗаписатьДеревоФоново(ПараметрыЗадания, АдресРезультата)
//
// Первый аргумент — это ровно то значение, которое было передано вторым
// параметром в ВыполнитьВФоне (например, Структура с полями).
// Второй аргумент — служебный адрес ВХ, которым управляет БСП.

#Область СлужебныйПрограммныйИнтерфейс

// Записывает дерево сценариев в фоновом задании.
//
// Параметры:
//  ПараметрыЗадания - Структура - входные данные:
//    * ДеревоУзлов                         - ДеревоЗначений.
//    * КодЯзыка                            - Строка.
//    * РешенияПоКонфликтам                 - Соответствие.
//    * КартаПодменКартинок                 - Соответствие из (Строка, Строка) -
//                                              необязательный. Готовая карта
//                                              подмен (ОригинальныйПуть -> КодФайла)
//                                              из предзагрузки
//                                              ПодготовитьФайлыИнструкций. Если
//                                              задана — фон не обращается к диску
//                                              и не читает АдресаКартинокВоВременномХранилище.
//    * КаталогПоиска                       - Строка - путь к каталогу с картинками
//                                              на диске сервера (используется только
//                                              если КартаПодменКартинок пуста).
//    * АдресаКартинокВоВременномХранилище  - Соответствие - используется только если
//                                              КартаПодменКартинок пуста.
//    * АдресПрогресса                      - Строка - адрес ВХ прогресса
//                                              (см. ИнициализироватьПрогресс).
//  АдресРезультата  - Строка - служебный адрес ВХ, дорисованный БСП.
//                              В нашей схеме не используется, результат
//                              читаем клиентом напрямую по адресу из
//                              СтруктураЗапуска, но параметр обязателен по контракту.
//
//@skip-warning
Процедура ЗаписатьДеревоФоново(ПараметрыЗадания, АдресРезультата) Экспорт

	Попытка

		// Диагностические записи о старте/завершении фонового задания
		// пропускаются, если журнал регистрации полностью отключён
		// администратором. Запись об ошибке (ветка Исключение)
		// пишется всегда - диагностика сбоя не должна теряться.
		// ПолучитьИспользованиеЖурналаРегистрации() возвращает Массив
		// уровней, для которых включена регистрация. Пустой массив
		// означает, что журнал отключён полностью.
		ЖурналВключен = ПолучитьИспользованиеЖурналаРегистрации().Количество() > 0;

		Если ТипЗнч(ПараметрыЗадания) <> Тип("Структура") Тогда
			ВызватьИсключение "Неожиданный тип параметров: "
				+ ТипЗнч(ПараметрыЗадания) + ", ожидалась Структура";
		КонецЕсли;

		// Диагностика: что пришло в фоновое задание.
		КоличествоКорней = 0;
		ДеревоУзлов = Неопределено;
		Если ПараметрыЗадания.Свойство("ДеревоУзлов") Тогда
			ДеревоУзлов = ПараметрыЗадания.ДеревоУзлов;
		КонецЕсли;
		Если ДеревоУзлов <> Неопределено Тогда
			Попытка
				КоличествоКорней = ДеревоУзлов.Строки.Количество();
			Исключение
				КоличествоКорней = -1;
			КонецПопытки;
		КонецЕсли;

		АдресПрогресса = "";
		Если ПараметрыЗадания.Свойство("АдресПрогресса") Тогда
			АдресПрогресса = ПараметрыЗадания.АдресПрогресса;
		КонецЕсли;

		КаталогПоиска = "";
		Если ПараметрыЗадания.Свойство("КаталогПоиска") Тогда
			КаталогПоиска = ПараметрыЗадания.КаталогПоиска;
		КонецЕсли;

		КартаПодменКартинок = Неопределено;
		РазмерКарты = 0;
		Если ПараметрыЗадания.Свойство("КартаПодменКартинок") Тогда
			КартаПодменКартинок = ПараметрыЗадания.КартаПодменКартинок;
		КонецЕсли;
		Если ТипЗнч(КартаПодменКартинок) = Тип("Соответствие") Тогда
			РазмерКарты = КартаПодменКартинок.Количество();
		КонецЕсли;

		ЗаписатьСтартФоновогоЗаданияВЖурнал(ЖурналВключен,
			ДеревоУзлов, КоличествоКорней, КаталогПоиска, РазмерКарты);

		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса, 1, 1, 1,
			"Запуск записи дерева сценариев");

		КодЯзыка = "ru";
		Если ПараметрыЗадания.Свойство("КодЯзыка") Тогда
			КодЯзыка = ПараметрыЗадания.КодЯзыка;
		КонецЕсли;

		РешенияПоКонфликтам = Новый Соответствие;
		Если ПараметрыЗадания.Свойство("РешенияПоКонфликтам") Тогда
			РешенияПоКонфликтам = ПараметрыЗадания.РешенияПоКонфликтам;
		КонецЕсли;

		АдресаКартинокВоВременномХранилище = Неопределено;
		Если ПараметрыЗадания.Свойство("АдресаКартинокВоВременномХранилище") Тогда
			АдресаКартинокВоВременномХранилище = ПараметрыЗадания.АдресаКартинокВоВременномХранилище;
		КонецЕсли;

		АдресРезультатаЗагрузки = "";
	Если ПараметрыЗадания.Свойство("АдресРезультатаЗагрузки") Тогда
		АдресРезультатаЗагрузки = ПараметрыЗадания.АдресРезультатаЗагрузки;
	КонецЕсли;

	// Явно переданный корень-инструкция из формы (приоритет над автоопределением).
	// Если не задан - используется fallback в ЗаписатьДеревоВСправочник/ОбработатьУзелРекурсивно
	// (первый #‑заголовок MD‑файла). Передача через параметр позволяет загружать сценарии
	// в инструкцию, у которой #‑заголовок в MD‑файле - это промежуточная группа
	// (например "Согласование ТКП"), а настоящий корень задан явно оператором.
	ИнструкцияИсточник = Неопределено;
	Если ПараметрыЗадания.Свойство("ИнструкцияИсточник") Тогда
		ИнструкцияИсточник = ПараметрыЗадания.ИнструкцияИсточник;
	КонецЕсли;

	// Сбрасываем автонумератор справочника сценариев: в 1С счётчик
	// автонумерации хранится в служебной таблице БД и не сбрасывается при
	// удалении элементов, поэтому после полной очистки справочника первый
	// созданный элемент получал код вида 075, 103 и т.п. Метод
	// ОбновитьНумерациюОбъектов устанавливает счётчик в максимум существующих
	// кодов + 1 — при пустом справочнике это даст 001 для первого корня.
	ОбновитьНумерациюОбъектов(Метаданные.Справочники.ДемонстрационныеСценарии);

	ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьДеревоВСправочник(
			ДеревоУзлов,
			КодЯзыка,
			РешенияПоКонфликтам,
			КаталогПоиска,
			АдресаКартинокВоВременномХранилище,
			АдресПрогресса,
			АдресРезультатаЗагрузки,
			КартаПодменКартинок,
			ИнструкцияИсточник);

	// После записи всего дерева перенумеровываем корневые группы в 001, 002,
	// 003, ... — иначе первая инструкция получает код 001, но внутренние
	// элементы сценария (подгруппы, шаги) тоже запрашивают коды из
	// автонумератора, и вторая инструкция уезжает на 029, 103 и т.п.
	// Триггер &После("ПриЗаписи") при смене кода корневой группы сам
	// пересчитает ПолныйКодКонтекстный всех её членов в регистре.
	ГКСИ_ГруппыСценариевСервер.ПеренумероватьКорневыеГруппы();

	ЗаписатьЗавершениеФоновогоЗаданияВЖурнал(ЖурналВключен);

	Исключение

		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ФоновоеЗадание",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка фонового задания:" + Символы.ПС + ТекстОшибки);

		АдресПрогресса = "";
		Если ТипЗнч(ПараметрыЗадания) = Тип("Структура")
			И ПараметрыЗадания.Свойство("АдресПрогресса") Тогда
			АдресПрогресса = ПараметрыЗадания.АдресПрогресса;
		КонецЕсли;

		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьПрогресс(АдресПрогресса, 0, 0, 0,
			"Ошибка выполнения", Истина, ТекстОшибки);

	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пишет в журнал регистрации информационное сообщение о старте
// фонового задания. Если журнал отключён в настройках - пропускается.
//
// Параметры:
//  ЖурналВключен    - Булево - признак включённого журнала регистрации.
//  ДеревоУзлов      - ДеревоЗначений, Неопределено - корень дерева.
//  КоличествоКорней - Число - число корней дерева (-1 при ошибке).
//  КаталогПоиска    - Строка - каталог поиска картинок.
//  РазмерКарты      - Число - размер карты подмен картинок (0 если карта не передана).
Процедура ЗаписатьСтартФоновогоЗаданияВЖурнал(ЖурналВключен,
		ДеревоУзлов, КоличествоКорней, КаталогПоиска, РазмерКарты = 0)

	Если Не ЖурналВключен Тогда
		Возврат;
	КонецЕсли;

	ТекстСообщения = "Старт фонового задания. Тип ДеревоУзлов: "
		+ ТипЗнч(ДеревоУзлов)
		+ ", корней: " + КоличествоКорней
		+ ", КаталогПоиска: " + КаталогПоиска
		+ ", размер карты подмен: " + XMLСтрока(РазмерКарты);

	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ФоновоеЗадание",
		УровеньЖурналаРегистрации.Информация, , ,
		ТекстСообщения);

КонецПроцедуры

// Пишет в журнал регистрации информационное сообщение о штатном
// завершении фонового задания. Если журнал отключён - пропускается.
//
// Параметры:
//  ЖурналВключен - Булево - признак включённого журнала регистрации.
Процедура ЗаписатьЗавершениеФоновогоЗаданияВЖурнал(ЖурналВключен)

	Если Не ЖурналВключен Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ФоновоеЗадание",
		УровеньЖурналаРегистрации.Информация, , ,
		"Фоновое задание завершилось штатно");

КонецПроцедуры

#КонецОбласти
