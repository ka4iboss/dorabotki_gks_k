// Переопределяемый модуль для интеграции с ГКСИ_ФайлыИнструкций

#Область ПрограммныйИнтерфейс

// Сохраняет файл в справочник ГКСИ_ФайлыИнструкций и заменяет в тексте Markdown
// имена файлов на коды (GUID) соответствующих элементов справочника.
//
// Параметры:
//   ПараметрыФайла - Структура - имя и расширение файла
//   АдресФайлаВоВременномХранилище - Строка - адрес двоичных данных файла во временном хранилище
//   Форма - Произвольный - форма, содержащая реквизит с текстом Markdown
//   ПутьКДанным - Строка - путь к реквизиту формы с текстом Markdown
//   Предмет - Произвольный - владелец файлов. По умолчанию Неопределено
Процедура ЗаписатьПрисоединенныйФайлВБазу(ПараметрыФайла, АдресФайлаВоВременномХранилище, Форма, ПутьКДанным, Предмет = Неопределено) Экспорт
    ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);

    // SHA-256 нужен для дедупликации картинок при импорте сценариев из Markdown
    // (см. ГКСИ_ЗагрузкаСценариевИзMarkdown.НайтиСуществующийФайлПоХешу).
    // Считаем только если модуль-загрузчик доступен (он — серверный, мы — серверные).
    ХешSHA256 = ГКСИ_ЗагрузкаСценариевИзMarkdown.ВычислитьSHA256(ДвоичныеДанныеФайла);

    // Последний рубеж дедупликации: если такой файл уже есть в справочнике,
    // переиспользуем его и не создаём новый элемент. Иначе при повторной вставке
    // той же картинки под другим именем будут плодиться дубли.
    КодФайла = "";
    Если ЗначениеЗаполнено(ХешSHA256) Тогда
        КодФайла = ГКСИ_ЗагрузкаСценариевИзMarkdown.НайтиСуществующийФайлПоХешу(ХешSHA256);
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(КодФайла) Тогда
        НовыйФайл = Справочники.ГКСИ_ФайлыИнструкций.СоздатьЭлемент();
        НовыйФайл.Наименование = ПараметрыФайла.ИмяБезРасширения;
        НовыйФайл.Расширение = ПараметрыФайла.РасширениеБезТочки;
        НовыйФайл.Файл = Новый ХранилищеЗначения(ДвоичныеДанныеФайла);
        НовыйФайл.ХешSHA256 = ХешSHA256;
        НовыйФайл.Описание = НСтр("ru = 'Вставлен из редактора Markdown'");
        НовыйФайл.Код = Строка(Новый УникальныйИдентификатор());
        НовыйФайл.Записать();
        КодФайла = НовыйФайл.Код;
    КонецЕсли;

    // Заменяем в тексте Markdown все вхождения "(ИмяФайла)" и "![](ИмяФайла)" на код файла.
    // Редактор вставляет изображение в формате "![](%1)", поэтому заменяем оба формата,
    // сохраняя единый вид в тексте: "![](" + Код + ")".
    ИмяФайла = ПараметрыФайла.ИмяБезРасширения + "." + ПараметрыФайла.РасширениеБезТочки;
    ТекущийТекст = Форма[ПутьКДанным];
    // Формат "![]()" (вставка изображения редактором)
    ТекущийТекст = СтрЗаменить(ТекущийТекст, "![](" + ИмяФайла + ")", "![](" + КодФайла + ")");
    // Формат "()" (простая ссылка на файл)
    ТекущийТекст = СтрЗаменить(ТекущийТекст, "(" + ИмяФайла + ")", "(" + КодФайла + ")");
    Форма[ПутьКДанным] = ТекущийТекст;
КонецПроцедуры

// Заглушка подсистемы редактора Markdown. Не используется, так как файлы хранятся в справочнике.
//
// Параметры:
//   ПрисоединенныеФайлы - ТаблицаЗначений - коллекция присоединенных файлов
//   ВладелецФайлов - Произвольный - владелец присоединенных файлов
//   Форма - Произвольный - форма объекта
//   ПутьКДанным - Строка - путь к реквизиту формы
Процедура ЗаполнитьПрисоединенныеФайлыКОбъекту(ПрисоединенныеФайлы, ВладелецФайлов, Форма, ПутьКДанным) Экспорт
    // Не используется
КонецПроцедуры

// Заглушка подсистемы редактора Markdown. Не используется.
//
// Параметры:
//   ДанныеФайла - Произвольный - данные файла
//   ПрисоединенныйФайл - СправочникСсылка - ссылка на присоединенный файл
//   ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы
//   Форма - Произвольный - форма объекта
//   ВладелецФайлов - Произвольный - владелец присоединенных файлов
//   ПутьКДанным - Строка - путь к реквизиту формы
Процедура ПриПолученииДанныхФайла(ДанныеФайла, ПрисоединенныйФайл, ИдентификаторФормы, Форма, ВладелецФайлов, ПутьКДанным) Экспорт
    // Не используется
КонецПроцедуры

// Возвращает data URI изображения по коду файла из справочника ГКСИ_ФайлыИнструкций.
//
// Параметры:
//  КодФайла - Строка - код (GUID) элемента справочника ГКСИ_ФайлыИнструкций.
//
// Возвращаемое значение:
//  Строка - data URI вида "data:<mime>;base64,<base64>".
//           Пустая строка, если код не задан или файл не найден.
Функция ОбработкаИзображенияВТексте(КодФайла) Экспорт
    Если ПустаяСтрока(КодФайла) Тогда
        Возврат "";
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Файл, Расширение ИЗ Справочник.ГКСИ_ФайлыИнструкций ГДЕ Код = &Код";
    Запрос.УстановитьПараметр("Код", КодФайла);
    Результат = Запрос.Выполнить().Выбрать();
    Если Не Результат.Следующий() Тогда
        Возврат "";
    КонецЕсли;
    
    ДвоичныеДанные = Результат.Файл.Получить();
    Base64 = Base64Строка(ДвоичныеДанные);
    Расширение = Результат.Расширение;
    Mime = ПолучитьMimeТип(Расширение);
    Возврат "data:" + Mime + ";base64," + Base64;
КонецФункции

// Возвращает MIME-тип файла по его расширению.
//
// Параметры:
//   Расширение - Строка - расширение файла без точки
//
// Возвращаемое значение:
//   Строка - MIME-тип файла
Функция ПолучитьMimeТип(Расширение) Экспорт
    Если Расширение = "png" Тогда
        Возврат "image/png";
    ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
        Возврат "image/jpeg";
    ИначеЕсли Расширение = "gif" Тогда
        Возврат "image/gif";
    ИначеЕсли Расширение = "bmp" Тогда
        Возврат "image/bmp";
    ИначеЕсли Расширение = "svg" Тогда
        Возврат "image/svg+xml";
    Иначе
        Возврат "application/octet-stream";
    КонецЕсли;
КонецФункции

// Ширина картинок по умолчанию. Используется формами и Альбомом процессов.
// Значение применяется как CSS max-width (например, "100%", "300px", "20em").
//
// Возвращаемое значение:
//   Строка
Функция ШиринаИзображенийПоУмолчанию() Экспорт
    Возврат "100%";
КонецФункции

// Возвращает блок CSS, ограничивающий максимальную ширину картинок в HTML.
//
// Параметры:
//   ШиринаКартинок - Строка - значение CSS max-width ("100%", "300px", "20em").
//                            Пустая строка или Неопределено - дефолт.
//
// Возвращаемое значение:
//   Строка - CSS без обрамляющего <style>. Пустая строка, если ширина пустая.
//
Функция СтильИзображений(ШиринаКартинок = "") Экспорт
    Если НЕ ЗначениеЗаполнено(ШиринаКартинок) Тогда
        ШиринаКартинок = ШиринаИзображенийПоУмолчанию();
    КонецЕсли;
    // Квадратная "коробка": одно значение ограничивает и ширину, и высоту.
    // Вертикальные картинки упрутся в max-height, горизонтальные — в max-width;
    // пропорции сохраняются автоматически (height/width = auto).
    Возврат "img { max-width: " + ШиринаКартинок + "; max-height: " + ШиринаКартинок + "; }";
КонецФункции

// Заменяет в HTML src="КОД" на src="data:<mime>;base64,..." для известных
// картинок из справочника ГКСИ_ФайлыИнструкций. Один пакетный запрос, без
// обращений к БД в цикле.
//
// Параметры:
//   ТекстHTML       - Строка - HTML, в котором встречается <img src="КОД" ...>.
//                              КОД - это GUID элемента справочника
//                              ГКСИ_ФайлыИнструкций (см. ЗаписатьПрисоединенныйФайлВБазу).
//   ШиринаКартинок  - Строка - CSS-значение max-width. Пустое - дефолт.
//                              Подмешивается как глобальное правило img { ... }.
//   МаксимальнаяШиринаПикселей - Число - целевая ширина для сжатия картинок.
//
// Возвращаемое значение:
//   Строка - HTML с заменёнными src и CSS-блоком (если были замены или задана ширина).
//
Функция ЗаменитьКодыИзображенийНаDataURI(ТекстHTML, ШиринаКартинок = "", МаксимальнаяШиринаПикселей = 0) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстHTML) Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	// Собираем все коды из двух представлений:
	//   - HTML:           <img src="КОД">
	//   - Markdown:       ![alt](КОД)
	// КОД — GUID элемента справочника ГКСИ_ФайлыИнструкций.
	КодыУникальные = Новый Соответствие;
	ДополнитьКодыИзСовпаденийПоШаблону(
		ТекстHTML,
		"src\s*=\s*""([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})""",
		КодыУникальные);
	ДополнитьКодыИзСовпаденийПоШаблону(
		ТекстHTML,
		"!\[[^\]]*\]\(([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\)",
		КодыУникальные);

	Если КодыУникальные.Количество() = 0 Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	МассивКодов = Новый Массив;
	Для Каждого КИЗ Из КодыУникальные Цикл
		МассивКодов.Добавить(КИЗ.Ключ);
	КонецЦикла;

	СоответствиеКодДанныеИзПовторки = СоответствиеКодДанныеИзображений(МассивКодов);
	Если СоответствиеКодДанныеИзПовторки.Количество() = 0 Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	// Нормализация: значения из повторного модуля могут содержать
	// ДвоичныеДанные, которые не сериализуются при работе через
	// ДлительныеОперации.ВыполнитьВФоне (платформа требует "примитивные
	// типы, ссылки, Структура"). Перечитываем ДвоичныеДанные из справочника
	// здесь и собираем соответствие с примитивами (Base64, Mime, Ширина,
	// Высота), чтобы дальше по цепочке передавались только они.
	СоответствиеКодДанные = НормализоватьСоответствиеКодДанные(СоответствиеКодДанныеИзПовторки);
	СоответствиеКодДанныеИзПовторки = Неопределено;
	Если СоответствиеКодДанные.Количество() = 0 Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ШиринаКартинок) Тогда
		ШиринаКартинок = ШиринаИзображенийПоУмолчанию();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ШиринаКартинок) Тогда
		ШиринаКартинок = "100%";
	КонецЕсли;
	СтильКартинки = "max-width: " + ШиринаКартинок + "; max-height: " + ШиринаКартинок + ";";

	// Один проход по строке: собираем список вхождений обоих форматов,
	// сортируем по позиции и заменяем через нарезку (Сред), не создавая
	// промежуточных копий всей строки. Для альбома с 50 картинками и
	// HTML на 20 МБ старый вариант давал ~50 × 20 МБ копий внутри
	// платформы; теперь — один линейный проход.
	Вхождения = ГКСИ_СобратьВхожденияКодов(ТекстHTML, СоответствиеКодДанные, СтильКартинки);
	Если Вхождения.Количество() = 0 Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
		УровеньЖурналаРегистрации.Информация, , ,
		"Диагностика D3: собрано вхождений=" + Вхождения.Количество()
		+ ", уникальных кодов в СоответствиеКодДанные=" + СоответствиеКодДанные.Количество()
		+ ", длина ТекстHTML=" + СтрДлина(ТекстHTML));

	// СоответствиеКодДанные после формирования Вхождения больше не нужно.
	// В каждом Вхождении уже лежит строка Замена с готовым data:URI;
	// хранить весь СоответствиеКодДанные с base64-строками до конца
	// сборки — лишняя память на пике.
	СоответствиеКодДанные = Неопределено;

	ТекстHTML = ГКСИ_ПрименитьЗаменыКФрагментам(ТекстHTML, Вхождения);
	Вхождения = Неопределено;

	// Markdown-разметка ![alt](...) видна как текст в HTML-поле.
	// После подстановки data:URI превращаем её в полноценные <img>
	// и сразу проставляем inline-стиль с квадратным ограничением.
	ТекстHTML = ПреобразоватьMarkdownКартинкиВHTML(ТекстHTML, СтильКартинки);

	Возврат ТекстHTML;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает список вхождений обоих форматов (<img src="КОД"> и ![alt](КОД))
// в единый массив структур {Позиция, Длина, Замена}, отсортированный по
// позиции начала. Для каждого кода, по которому найдены данные, формирует
// строку-замену. Несуществующие коды (нет в СоответствиеКодДанные) дают
// вхождений без замены — текст остаётся как есть.
//
// Параметры:
//   ТекстHTML              - Строка - исходный HTML/Markdown.
//   СоответствиеКодДанные  - Соответствие из КлючИЗначение - код -> {Base64, Mime}.
//   СтильКартинки          - Строка - inline-стиль для <img>.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Позиция - Число - начальная позиция (с 1).
//     * Длина   - Число - длина исходного фрагмента.
//     * Замена  - Строка - подставляемое значение.
//
Функция ГКСИ_СобратьВхожденияКодов(ТекстHTML, СоответствиеКодДанные, СтильКартинки)

	Результат = Новый Массив;

	СовпаденияSrc = СтрНайтиВсеПоРегулярномуВыражению(
		ТекстHTML,
		"src\s*=\s*""([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})""",
		Истина);
	Для Каждого Совпадение Из СовпаденияSrc Цикл
		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Код = Группы[0].Значение;
		ДанныеФайла = СоответствиеКодДанные.Получить(Код);
		Если ДанныеФайла = Неопределено Тогда
			// Код не найден в справочнике — оставляем как есть, чтобы
			// браузер показал битую картинку (лучше, чем ронять молча).
			Продолжить;
		КонецЕсли;
		DataURI = "data:" + ДанныеФайла.Mime + ";base64," + ДанныеФайла.Base64;
		Замена = "src=""" + DataURI + """ style=""" + СтильКартинки + """";
		ОписаниеВхождения = Новый Структура;
		ОписаниеВхождения.Вставить("Позиция", Совпадение.НачальнаяПозиция);
		ОписаниеВхождения.Вставить("Длина",   Совпадение.Длина);
		ОписаниеВхождения.Вставить("Замена",  Замена);
		Результат.Добавить(ОписаниеВхождения);
	КонецЦикла;

	СовпаденияMd = СтрНайтиВсеПоРегулярномуВыражению(
		ТекстHTML,
		"!\[[^\]]*\]\(([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\)",
		Истина);
	Для Каждого Совпадение Из СовпаденияMd Цикл
		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Код = Группы[0].Значение;
		ДанныеФайла = СоответствиеКодДанные.Получить(Код);
		Если ДанныеФайла = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		DataURI = "data:" + ДанныеФайла.Mime + ";base64," + ДанныеФайла.Base64;
		Замена = "](" + DataURI + ")";
		ОписаниеВхождения = Новый Структура;
		ОписаниеВхождения.Вставить("Позиция", Совпадение.НачальнаяПозиция);
		ОписаниеВхождения.Вставить("Длина",   Совпадение.Длина);
		ОписаниеВхождения.Вставить("Замена",  Замена);
		Результат.Добавить(ОписаниеВхождения);
	КонецЦикла;

	// Сортируем по позиции начала, чтобы при обходе не пришлось «отматывать».
	// При равенстве позиций (теоретически) — более короткое вхождение первым.
	Если Результат.Количество() > 1 Тогда
		ГКСИ_СортироватьВхожденияПоПозиции(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сортирует массив вхождений по возрастанию Позиция (при равенстве — по Длина).
// Сортировка вставками, без рекурсии и без лишних аллокаций строк.
//
Процедура ГКСИ_СортироватьВхожденияПоПозиции(Вхождения)

	Размер = Вхождения.Количество();
	Для Сч = 1 По Размер - 1 Цикл
		Текущее = Вхождения[Сч];
		ПозицияТекущего = Текущее.Позиция;
		ДлинаТекущего = Текущее.Длина;
		Индекс = Сч;
		Пока Индекс > 0 Цикл
			Предыдущее = Вхождения[Индекс - 1];
			Если Предыдущее.Позиция < ПозицияТекущего
				ИЛИ (Предыдущее.Позиция = ПозицияТекущего И Предыдущее.Длина <= ДлинаТекущего) Тогда
				Прервать;
			КонецЕсли;
			Вхождения[Индекс] = Предыдущее;
			Индекс = Индекс - 1;
		КонецЦикла;
		Вхождения[Индекс] = Текущее;
	КонецЦикла;

КонецПроцедуры

// Применяет замены к ТекстHTML за один проход: копирует в буфер куски
// «между» вхождениями и подставляет Замена для каждого. На выходе —
// строка того же логического содержимого, что и серия СтрЗаменить,
// но без промежуточных полных копий исходной строки.
//
// Параметры:
//   ТекстHTML  - Строка - исходный текст.
//   Вхождения  - Массив из Структура - вхождения, отсортированные по Позиция;
//                не должны пересекаться.
//
// Возвращаемое значение:
//   Строка.
//
Функция ГКСИ_ПрименитьЗаменыКФрагментам(ТекстHTML, Вхождения)

	ДлинаСтроки = СтрДлина(ТекстHTML);
	Курсор = 1; // Позиция следующего символа, который ещё не скопирован.
	Фрагменты = Новый Массив;
	Фрагменты.Добавить("");

	Для Каждого Вхождение Из Вхождения Цикл
		Позиция = Вхождение.Позиция;
		Длина = Вхождение.Длина;
		Если Позиция < Курсор Тогда
			// Перекрытие с предыдущим вхождением (теоретически) — пропускаем.
			Продолжить;
		КонецЕсли;
		Если Позиция > Курсор Тогда
			Фрагменты.Добавить(Сред(ТекстHTML, Курсор, Позиция - Курсор));
		КонецЕсли;
		Фрагменты.Добавить(Вхождение.Замена);
		Курсор = Позиция + Длина;
	КонецЦикла;

	Если Курсор <= ДлинаСтроки Тогда
		Фрагменты.Добавить(Сред(ТекстHTML, Курсор, ДлинаСтроки - Курсор + 1));
	КонецЕсли;

	Возврат СтрСоединить(Фрагменты, "");

КонецФункции

// Преобразует Markdown-разметку картинок `![alt](URL)` в HTML-тег
// `<img src="URL" alt="alt" style="...">`. Используется после того, как
// коды картинок уже заменены на data:URI, чтобы избежать визуального показа
// разметки в полях, которые не рендерят Markdown.
//
// Параметры:
//   Текст          - Строка - HTML/Markdown, в котором могут встречаться ![alt](URL).
//   СтильКартинки  - Строка - inline-стиль, который проставляется на каждый <img>.
//
// Возвращаемое значение:
//   Строка - тот же текст, но все Markdown-картинки заменены на <img>.
//
Функция ПреобразоватьMarkdownКартинкиВHTML(Текст, СтильКартинки = "")

    Если НЕ ЗначениеЗаполнено(Текст) Тогда
        Возврат Текст;
    КонецЕсли;

    Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
        Текст, "!\[[^\]]*\]\(([^)]+)\)", Истина);
    Если Совпадения.Количество() = 0 Тогда
        Возврат Текст;
    КонецЕсли;

    Для Каждого Совпадение Из Совпадения Цикл
        Группы = Совпадение.ПолучитьГруппы();
        Если Группы.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        URL = Группы[0].Значение;
        ПолноеСовпадение = Совпадение.Значение;
        ПозицияAltНачало = СтрНайти(ПолноеСовпадение, "![") + 2;
        ПозицияAltКонец  = СтрНайти(ПолноеСовпадение, "]");
        Alt = Сред(ПолноеСовпадение, ПозицияAltНачало, ПозицияAltКонец - ПозицияAltНачало);
        AltЭкранированный = СтрЗаменить(Alt, """", "&quot;");
        HTMLТег = "<img src=""" + URL + """ alt=""" + AltЭкранированный + """"
            + ?(ЗначениеЗаполнено(СтильКартинки), " style=""" + СтильКартинки + """", "") + ">";
        Текст = СтрЗаменить(Текст, ПолноеСовпадение, HTMLТег);
    КонецЦикла;

    Возврат Текст;

КонецФункции

// Извлекает GUID'ы из Текста по регулярному выражению и добавляет их в
// СоответствиеКоды как ключи (для уникализации).
//
// Параметры:
//   Текст            - Строка - исходный текст.
//   Шаблон           - Строка - регулярное выражение с одной захватывающей группой.
//   СоответствиеКоды - Соответствие из КлючИЗначение - аккумулятор уникальных GUID.
//
Процедура ДополнитьКодыИзСовпаденийПоШаблону(Текст, Шаблон, СоответствиеКоды)

    Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, Шаблон, Истина);
    Для Каждого Совпадение Из Совпадения Цикл
        Группы = Совпадение.ПолучитьГруппы();
        Если Группы.Количество() > 0 Тогда
            СоответствиеКоды.Вставить(Группы[0].Значение, Истина);
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

// Пакетное чтение двоичных данных файлов по списку кодов. Возвращает
// соответствие Код -> Структура {Base64, Mime}. Несуществующие коды в
// соответствие не попадают.
//
// Делегирует чтение в ГКСИ_ДанныеИзображенийMarkdownПовтИсп — общий модуль
// с признаком «Повторное использование возвращаемых значений на время
// сеанса». Платформа в этом режиме ограничивает типы параметров экспортной
// функции: только примитивы, ссылки и Структура. Массив не подходит ни
// в основном сеансе, ни в фоновом задании. Поэтому формируем строку-ключ
// "<Код1>|<Код2>|...|#<Ширина>" и передаём её как примитив. Реализация
// чтения находится в ГКСИ_ДанныеИзображенийMarkdown.
//
// Параметры:
//   МассивКодов - Массив из Строка - коды (GUID) файлов инструкций.
//   МаксимальнаяШиринаПикселей - Число - целевая ширина в пикселях.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - Ключ: Строка (Код), Значение: Структура.
//
Функция СоответствиеКодДанныеИзображений(МассивКодов, МаксимальнаяШиринаПикселей = 0)

	Если МассивКодов = Неопределено ИЛИ МассивКодов.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	КлючКеша = СтрСоединить(МассивКодов, "|")
		+ "#" + XMLСтрока(МаксимальнаяШиринаПикселей);

	Возврат ГКСИ_ДанныеИзображенийMarkdownПовтИсп.СоответствиеКодДанные(КлючКеша);

КонецФункции

// Перечитывает данные по кодам картинок из справочника и собирает
// новое Соответствие, значения которого — Структура с примитивными
// полями (Base64, Mime). Это нужно, чтобы избежать ошибки сериализации
// ДвоичныеДанные при вызове из фонового задания через
// ДлительныеОперации.ВыполнитьВФоне, где допустимы только "примитивные
// типы, ссылки, Структура".
//
// Параметры:
//   ИсходноеСоответствие - Соответствие из КлючИЗначение - код -> Структура(ДвоичныеДанные, Mime).
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - код -> Структура(Base64, Mime)
//
Функция НормализоватьСоответствиеКодДанные(ИсходноеСоответствие)

	Результат = Новый Соответствие;

	Если ИсходноеСоответствие = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	МассивКодов = Новый Массив;
	Для Каждого КИЗ Из ИсходноеСоответствие Цикл
		КодСтрокой = КИЗ.Ключ;
		Если НЕ ЗначениеЗаполнено(КодСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		МассивКодов.Добавить(КодСтрокой);
	КонецЦикла;

	Если МассивКодов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Ищем по полю Код (строковый GUID, который мы сами кладём при создании
	// элемента в СоздатьЭлементФайлаИнструкции: НовыйФайл.Код = Строка(Новый
	// УникальныйИдентификатор())). Этот GUID не совпадает с внутренним УИД
	// объекта в БД, поэтому ПолучитьСсылку() здесь НЕ работает — читаем
	// напрямую запросом по Код.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФайлыИнструкций.Код КАК Код,
	|	ФайлыИнструкций.Файл КАК Файл,
	|	ФайлыИнструкций.Расширение КАК Расширение
	|ИЗ
	|	Справочник.ГКСИ_ФайлыИнструкций КАК ФайлыИнструкций
	|ГДЕ
	|	ФайлыИнструкций.Код В (&МассивКодов)
	|	И НЕ ФайлыИнструкций.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ДвоичныеДанные = Выборка.Файл.Получить();
		Если ДвоичныеДанные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Расширение = НРег(?(Выборка.Расширение = "", "",
			Выборка.Расширение));
		Mime = MimeПоРасширению(Расширение);

		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Base64",  Base64Строка(ДвоичныеДанные));
		СтруктураДанных.Вставить("Mime",    Mime);

		Результат.Вставить(Выборка.Код, СтруктураДанных);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает MIME-тип по расширению файла (без точки).
//
Функция MimeПоРасширению(Расширение)

	Если Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "jpg" ИЛИ Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "webp" Тогда
		Возврат "image/webp";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	КонецЕсли;

	Возврат "application/octet-stream";

КонецФункции

#КонецОбласти
