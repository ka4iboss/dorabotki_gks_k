////////////////////////////////////////////////////////////////////////////////
// Преобразование разметки видео !video(<путь>) в HTML5-плеер.
//
// Разметка используется в текстах Markdown редактора ГКСИ и в сохранённых
// HTML-описаниях инструкций (демонстрационных сценариев).
//
// Основной режим - встроенный HTML5-плеер по ссылке на файл (локальный,
// сетевой или http(s)). Под плеером всегда выводится запасная ссылка
// "Открыть во внешнем плеере" (атрибут data-gksi-video) - её перехватывают
// клиентские обработчики и открывают файл системным проигрывателем, если
// встроенное воспроизведение недоступно (например, браузер блокирует file://).
//
// Путь в разметке может быть обрамлён кавычками (путь копируют из проводника
// Windows) - обрамляющие кавычки снимаются.
//
// Ширина плеера регулируется тем же значением, что и ширина картинок (реквизит
// формы "ШиринаКартинок" и слайдер в альбоме процессов): правило для
// .gksi-video-frame добавляют ГКСИ_MarkdownПереопределяемый (предпросмотр) и
// ГКСИ_АльбомПроцессов (альбом). В сохранённом HTML описания CSS проекта нет,
// поэтому там плеер просто занимает всю ширину описания.

#Область ПрограммныйИнтерфейс

// Преобразует разметку !video(<путь>) в HTML5-плеер.
//
// Параметры:
//  Текст - Строка - текст Markdown, возможно содержащий разметку !video(...).
//
// Возвращаемое значение:
//  Строка - текст, в котором разметка видео заменена на HTML5-плеер.
//
Функция РазметкуВидеоВHTML(Текст) Экспорт

	Маркер = "!video(";
	Результат = Текст;

	Если НЕ ПустаяСтрока(Текст) И СтрНайти(Текст, Маркер) > 0 Тогда

		Вхождения = СтрНайтиВсеПоРегулярномуВыражению(Результат, "!video\(([^)\r\n]*)\)");

		// Заменяем с конца, чтобы позиции предыдущих вхождений не сдвигались.
		Для Индекс = Вхождения.Количество() - 1 По 0 Цикл

			Вхождение = Вхождения[Индекс];
			Путь = Сред(Вхождение.Значение,
				СтрДлина(Маркер) + 1,
				СтрДлина(Вхождение.Значение) - СтрДлина(Маркер) - 1);
			Путь = УбратьОбрамляющиеКавычки(Путь);

			Если ПустаяСтрока(Путь) Тогда
				Продолжить;
			КонецЕсли;

			Замена = ШаблонПлеера(НормализоватьПутьКВидео(Путь), Путь);
			Результат = Лев(Результат, Вхождение.НачальнаяПозиция - 1)
				+ Замена
				+ Сред(Результат, Вхождение.НачальнаяПозиция + Вхождение.Длина);

		КонецЦикла;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Нормализует путь к видеофайлу в URL для атрибута src тега video.
//
// Путь может быть обрамлён кавычками (пользователь копирует путь из проводника
// Windows, где он показан как "D:\Video\a.mp4") - обрамляющие кавычки снимаются.
//
// Параметры:
//  Путь - Строка - путь или URL: локальный (D:\Video\a.mp4), сетевой
//         (\\server\share\a.mp4), абсолютный (/media/a.mp4) или http(s)/file URL.
//
// Возвращаемое значение:
//  Строка - URL для атрибута src.
//
Функция НормализоватьПутьКВидео(Путь) Экспорт

	Результат = УбратьОбрамляющиеКавычки(Путь);
	Результат = СтрЗаменить(Результат, "\", "/");

	ПутьВРег = ВРег(Результат);
	Если СтрНачинаетсяС(ПутьВРег, "HTTP://")
		ИЛИ СтрНачинаетсяС(ПутьВРег, "HTTPS://")
		ИЛИ СтрНачинаетсяС(ПутьВРег, "FILE://") Тогда
		Возврат Результат;
	КонецЕсли;

	Если СтрНачинаетсяС(Результат, "//") Тогда
		// Сетевой путь \\server\share\... - после замены слэшей //server/share/...
		Возврат "file:" + Результат;
	КонецЕсли;

	Если СтрНачинаетсяС(Результат, "/") Тогда
		Возврат "file://" + Результат;
	КонецЕсли;

	// Локальный путь с буквой диска: D:/Video/a.mp4 -> file:///D:/Video/a.mp4
	Возврат "file:///" + Результат;

КонецФункции

// Возвращает ссылку file:// на присоединённый HTML-файл описания сценария.
//
// Ссылка строится по физическому пути файла в томе хранения: корневой путь тома
// (UNC) плюс путь файла внутри тома. Для файлов в информационной базе и для
// локальных томов (путь на диске сервера) ссылка не формируется: у пользователя
// она не откроется, поэтому в плеере остаётся ссылка на видеофайл.
//
// Параметры:
//  ПрисоединенныйФайл - СправочникСсылка.ДемонстрационныеСценарииПрисоединенныеФайлы -
//                       файл описания сценария.
//
// Возвращаемое значение:
//  Строка - URL вида file://server/share/..., либо пустая строка.
//
Функция СсылкаНаФайлОписания(ПрисоединенныйФайл) Экспорт

	Если НЕ ЗначениеЗаполнено(ПрисоединенныйФайл) Тогда
		Возврат "";
	КонецЕсли;

	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(ПрисоединенныйФайл);

	Ссылка = СсылкиНаФайлыОписаний(МассивФайлов).Получить(ПрисоединенныйФайл);
	Если Ссылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Возвращает ссылки file:// на присоединённые HTML-файлы описаний сценариев.
//
// Список обрабатывается одним запросом: функция вызывается из фоновых заданий
// записи описаний, где файлы идут пачкой, а запросы в цикле недопустимы.
//
// Параметры:
//  МассивФайлов - Массив из СправочникСсылка.ДемонстрационныеСценарииПрисоединенныеФайлы -
//                 файлы описаний сценариев.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ссылка на файл -> URL; пустая строка, если
//  файл нельзя открыть по file://.
//
Функция СсылкиНаФайлыОписаний(МассивФайлов) Экспорт

	Результат = Новый Соответствие;

	Если МассивФайлов = Неопределено ИЛИ МассивФайлов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Файлы.Ссылка КАК Файл,
	|	Файлы.ТипХраненияФайла КАК ТипХраненияФайла,
	|	Файлы.ПутьКФайлу КАК ПутьКФайлу,
	|	Тома.ПолныйПутьWindows КАК КорневойПуть
	|ИЗ
	|	Справочник.ДемонстрационныеСценарииПрисоединенныеФайлы КАК Файлы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТомаХраненияФайлов КАК Тома
	|		ПО Файлы.Том = Тома.Ссылка
	|ГДЕ
	|	Файлы.Ссылка В(&Файлы)";
	Запрос.УстановитьПараметр("Файлы", МассивФайлов);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Файл,
			СсылкаНаФайлВТоме(Выборка.ТипХраненияФайла, Выборка.КорневойПуть, Выборка.ПутьКФайлу));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подставляет ссылку на файл описания сценария во все плееры фрагмента HTML.
//
// Ссылка «Открыть в браузере» под плеером открывает не видеофайл, а HTML-описание
// шага: пользователь видит шаг целиком и смотрит видео там. Файл описания
// создаётся позже самого HTML, поэтому путь подставляется постобработкой
// готового текста. Идемпотентно.
//
// Параметры:
//  ТекстHTML            - Строка - HTML описания сценария.
//  СсылкаНаФайлОписания - Строка - URL файла описания; пустая строка - без изменений.
//
// Возвращаемое значение:
//  Строка - HTML с подставленной ссылкой.
//
Функция ПодставитьСсылкуНаФайлОписания(ТекстHTML, СсылкаНаФайлОписания) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстHTML) ИЛИ НЕ ЗначениеЗаполнено(СсылкаНаФайлОписания) Тогда
		Возврат ТекстHTML;
	КонецЕсли;

	НачалоАтрибута = "<a class=""gksi-video-browser"" href=""";
	Замена = "<a class=""gksi-video-browser"" href="""
		+ ЭкранироватьЗначениеАтрибута(СсылкаНаФайлОписания) + """";
	Результат = ТекстHTML;

	Позиция = СтрНайти(Результат, НачалоАтрибута);
	Пока Позиция > 0 Цикл

		НачалоЗначения = Позиция + СтрДлина(НачалоАтрибута);
		КонецЗначения = СтрНайти(Результат, """", , НачалоЗначения);
		Если КонецЗначения = 0 Тогда
			Прервать;
		КонецЕсли;

		Результат = Лев(Результат, Позиция - 1)
			+ Замена
			+ Сред(Результат, КонецЗначения + 1);

		Позиция = СтрНайти(Результат, НачалоАтрибута, , Позиция + СтрДлина(Замена));

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует HTML-фрагмент встроенного плеера с запасной ссылкой.
//
// Видео обёрнуто в div.gksi-video-frame: по этому классу регулируется ширина
// плеера (правило добавляют ГКСИ_MarkdownПереопределяемый и ГКСИ_АльбомПроцессов).
// Стили заданы инлайново: в сохранённом HTML описания CSS проекта нет, а плеер
// должен занимать всю ширину описания и там. Инлайнового max-width у фрейма нет
// намеренно - иначе он перебил бы правило ширины из стилей.
//
// Параметры:
//  URL - Строка - нормализованный URL видео для атрибута src.
//  Оригинал - Строка - исходный путь, как его ввёл пользователь.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент плеера.
//
Функция ШаблонПлеера(URL, Оригинал)

	Шаблон =
	"<div class=""gksi-video"">" + Символы.ПС
	+ "<div class=""gksi-video-frame"""
	+ " style=""position:relative;display:inline-block;width:100%;line-height:0;"">"
	+ "<video controls=""controls"" preload=""metadata"""
	+ " style=""display:block;width:100%;height:auto;max-width:100%;"">"
	+ "<source src=""" + ЭкранироватьЗначениеАтрибута(URL) + """ />"
	+ "Ваш браузер не поддерживает воспроизведение видео."
	+ "</video>"
	+ "</div>" + Символы.ПС
	+ "<div class=""gksi-video-caption"">"
	+ "<a class=""gksi-video-open"" href=""#"""
	+ " data-gksi-video=""" + ЭкранироватьЗначениеАтрибута(Оригинал) + """>"
	+ НСтр("ru = 'Открыть во внешнем плеере'")
	+ "</a>"
	+ "<span class=""gksi-video-sep""> · </span>"
	+ "<a class=""gksi-video-browser"" href=""" + ЭкранироватьЗначениеАтрибута(URL) + """ target=""_blank"">"
	+ НСтр("ru = 'Открыть в браузере'")
	+ "</a></div>" + Символы.ПС
	+ "</div>";

	Возврат Шаблон;

КонецФункции

// Строит ссылку file:// на файл, лежащий в томе хранения файлов.
//
// Параметры:
//  ТипХраненияФайла - ПеречислениеСсылка.ТипыХраненияФайлов - способ хранения файла.
//  КорневойПуть     - Строка - полный путь тома в UNC-формате (\\\\server\\share\\...).
//  ПутьКФайлу       - Строка - путь файла внутри тома.
//
// Возвращаемое значение:
//  Строка - URL файла, либо пустая строка, если файл недоступен по file://.
//
Функция СсылкаНаФайлВТоме(ТипХраненияФайла, КорневойПуть, ПутьКФайлу)

	Если ТипХраненияФайла <> Перечисления.ТипыХраненияФайлов.ВТомахНаДиске Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КорневойПуть) ИЛИ НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат "";
	КонецЕсли;

	// Том может быть и сетевым (\\server\share\...), и локальным диском (R:\...):
	// при файловом варианте или смонтированном диске путь доступен пользователю.
	ПолныйПуть = СокрЛП(КорневойПуть);
	Если Прав(ПолныйПуть, 1) <> "\" Тогда
		ПолныйПуть = ПолныйПуть + "\";
	КонецЕсли;

	ПолныйПуть = ПолныйПуть + СтрЗаменить(СокрЛП(ПутьКФайлу), "/", "\");

	Возврат НормализоватьПутьКВидео(ПолныйПуть);

КонецФункции

// Снимает обрамляющие кавычки с пути и обрезает пробелы по краям.
//
// Путь к файлу часто копируют из проводника Windows или из мессенджера, где он
// показан в кавычках: "D:\загрузки\a.mp4". Кавычки нужно снять до подстановки
// в атрибут src, иначе URL получается невалидным (file:///%22D:/...) и видео
// не воспроизводится.
//
// Параметры:
//  Значение - Строка - путь, возможно обрамлённый кавычками.
//
// Возвращаемое значение:
//  Строка - путь без обрамляющих кавычек и без пробелов по краям.
//
Функция УбратьОбрамляющиеКавычки(Значение)
	
	Результат = СокрЛП(Значение);
	Пока СтрДлина(Результат) >= 2 Цикл
		
		ПервыйСимвол = Лев(Результат, 1);
		ПоследнийСимвол = Прав(Результат, 1);
		
		Если (ПервыйСимвол = """" И ПоследнийСимвол = """")
			ИЛИ (ПервыйСимвол = "'" И ПоследнийСимвол = "'")
			ИЛИ (ПервыйСимвол = "«" И ПоследнийСимвол = "»")
			ИЛИ (ПервыйСимвол = "“" И ПоследнийСимвол = "”") Тогда
			
			Результат = СокрЛП(Сред(Результат, 2, СтрДлина(Результат) - 2));
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Экранирует значение для подстановки в HTML-атрибут.
//
// Параметры:
//  Значение - Строка - экранируемое значение.
//
// Возвращаемое значение:
//  Строка - экранированное значение.
//
Функция ЭкранироватьЗначениеАтрибута(Значение)

	Результат = СтрЗаменить(Значение, "&", "&amp;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");

	Возврат Результат;

КонецФункции

#КонецОбласти
