// Серверная подсистема «Глоссарий» в расширении ГКС_Инструкции.
// Оборачивает типовой справочник Catalog.Глоссарий из основной конфигурации ERP:
//  - читает термины по объектам метаданных (для панели на формах сценариев);
//  - читает все термины с описаниями (для формы выбора из редактора);
//  - отдаёт плоский кеш для обогащения HTML в альбоме процессов и инструкциях;
//  - обогащает HTML: оборачивает термины в <span class="gksi-term">.
//
// Все методы - серверные, вызываются с клиента через &НаСервереБезКонтекста/&НаСервере.
// Запросы — пакетные, без запросов в цикле.

#Область ПрограммныйИнтерфейс

// Возвращает таблицу терминов глоссария, у которых в ТЧ ОбъектыКонфигурации
// встречается хотя бы один из переданных объектов метаданных.
//
// Параметры:
//  МассивОбъектовКонфигурации - Массив из CatalogRef.ИдентификаторыОбъектовМетаданных
//                                или CatalogRef.ИдентификаторыОбъектовРасширений.
//                                Может быть пустым или Неопределено - тогда
//                                возвращаются все термины (для формы выбора).
//  КодЯзыка - Строка - код языка для подбора локализованного наименования
//                      ("ru" - НаименованиеЯзык1, иначе - НаименованиеЯзык2;
//                      если пусто - используется Наименование).
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с колонками:
//    * Ссылка - CatalogRef.Глоссарий.
//    * Наименование - Строка - локализованное имя термина.
//    * Описание - Строка - текстовое описание на запрошенном языке
//                                  (извлечённое из ХранилищеЗначения; если
//                                  описания нет на этом языке - пустая строка).
//
Функция ТерминыПоОбъектамМетаданных(МассивОбъектовКонфигурации, КодЯзыка) Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Наименование");
	Результат.Колонки.Добавить("Описание");

	ОтборПоОбъектам = (МассивОбъектовКонфигурации <> Неопределено)
		И (ТипЗнч(МассивОбъектовКонфигурации) = Тип("Массив"))
		И (МассивОбъектовКонфигурации.Количество() > 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
		?(ОтборПоОбъектам,
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ГлоссарийОбъекты.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_Термины
			|ИЗ
			|	Справочник.Глоссарий.ОбъектыКонфигурации КАК ГлоссарийОбъекты
			|ГДЕ
			|	ГлоссарийОбъекты.ОбъектКонфигурации В (&МассивОбъектов)
			|;",
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Глоссарий.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТ_Термины
			|ИЗ
			|	Справочник.Глоссарий КАК Глоссарий
			|;")
		+ "
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Глоссарий.Ссылка КАК Ссылка,
		|	Глоссарий.Наименование КАК НаименованиеБазовое,
		|	Глоссарий.НаименованиеЯзык1 КАК НаименованиеЯзык1,
		|	Глоссарий.НаименованиеЯзык2 КАК НаименованиеЯзык2,
		|	ГлоссарийОписания.Описание КАК ОписаниеХранилище,
		|	ГлоссарийОписания.КодЯзыка КАК КодЯзыкаОписания
		|ИЗ
		|	ВТ_Термины КАК ВТ_Термины
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Глоссарий КАК Глоссарий
		|		ПО ВТ_Термины.Ссылка = Глоссарий.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Глоссарий.ОписанияГлоссария КАК ГлоссарийОписания
	|		ПО Глоссарий.Ссылка = ГлоссарийОписания.Ссылка
	|			И ГлоссарийОписания.КодЯзыка = &КодЯзыка
		|ГДЕ
		|	НЕ Глоссарий.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Глоссарий.Наименование";

	ОписаниеТипаКодаЯзыка = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2, ДопустимаяДлина.Фиксированная));
	Запрос.УстановитьПараметр("КодЯзыка", ОписаниеТипаКодаЯзыка.ПривестиЗначение(?(ПустаяСтрока(КодЯзыка), "ru", КодЯзыка)));

	Если ОтборПоОбъектам Тогда
		Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектовКонфигурации);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Ссылка = Выборка.Ссылка;
		НоваяСтрока.Наименование = НаименованиеПоЯзыку(Выборка, КодЯзыка);
		НоваяСтрока.Описание = ИзвлечьОписаниеИзХранилища(Выборка.ОписаниеХранилище);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает локализованное наименование термина глоссария по ссылке.
//
// Параметры:
//  Ссылка - СправочникСсылка.Глоссарий - термин глоссария.
//  КодЯзыка - Строка - код языка: "ru" - НаименованиеЯзык1, иначе
//             НаименованиеЯзык2; если языковое наименование пусто -
//             используется базовое Наименование.
//
// Возвращаемое значение:
//  Строка - наименование термина; пустая строка, если ссылка не заполнена
//           или элемент не найден.
//
Функция НаименованиеТерминаПоЯзыку(Ссылка, КодЯзыка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Глоссарий.Наименование КАК НаименованиеБазовое,
		|	Глоссарий.НаименованиеЯзык1 КАК НаименованиеЯзык1,
		|	Глоссарий.НаименованиеЯзык2 КАК НаименованиеЯзык2
		|ИЗ
		|	Справочник.Глоссарий КАК Глоссарий
		|ГДЕ
		|	Глоссарий.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;

	Возврат НаименованиеПоЯзыку(Выборка, КодЯзыка);

КонецФункции

// Возвращает соответствие "Наименование (в нижнем регистре) - Структура{Ссылка, Описание}"
// для всех терминов, имеющих описание на указанном языке.
// Используется для обогащения HTML (вариант C).
//
// Параметры:
//  КодЯзыка - Строка - код языка.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//    Ключ     - Строка - Наименование в нижнем регистре.
//    Значение - Структура:
//      * Ссылка       - CatalogRef.Глоссарий.
//      * Описание     - Строка - описание на указанном языке.
//      * Наименование - Строка - оригинальное наименование.
//
Функция ТерминыДляАвтоподстановки(КодЯзыка) Экспорт

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Глоссарий.Ссылка КАК Ссылка,
		|	Глоссарий.Наименование КАК НаименованиеБазовое,
		|	Глоссарий.НаименованиеЯзык1 КАК НаименованиеЯзык1,
		|	Глоссарий.НаименованиеЯзык2 КАК НаименованиеЯзык2,
		|	ГлоссарийОписания.Описание КАК ОписаниеХранилище
		|ИЗ
		|	Справочник.Глоссарий КАК Глоссарий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Глоссарий.ОписанияГлоссария КАК ГлоссарийОписания
		|		ПО Глоссарий.Ссылка = ГлоссарийОписания.Ссылка
		|			И ГлоссарийОписания.КодЯзыка = &КодЯзыка
		|ГДЕ
		|	НЕ Глоссарий.ПометкаУдаления";

	Запрос.УстановитьПараметр("КодЯзыка", ?(ПустаяСтрока(КодЯзыка), "ru", КодЯзыка));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Наименование = НаименованиеПоЯзыку(Выборка, КодЯзыка);
		Если ПустаяСтрока(Наименование) Тогда
			Продолжить;
		КонецЕсли;
		Описание = ИзвлечьОписаниеИзХранилища(Выборка.ОписаниеХранилище);
		Если ПустаяСтрока(Описание) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(Наименование);
		Если Результат.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеТермина = Новый Структура;
		ДанныеТермина.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеТермина.Вставить("Описание", Описание);
		ДанныеТермина.Вставить("Наименование", Наименование);
		Результат.Вставить(Ключ, ДанныеТермина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обогащает HTML, оборачивая первое вхождение каждого термина из глоссария
// в <span class="gksi-term" data-term-guid="..." title="Описание">...</span>.
// Термины внутри <code>, <pre>, <a> не заменяются.
//
// Параметры:
//  HTML - Строка - исходный HTML (например, собранный из Markdown).
//  КодЯзыка - Строка - код языка для подбора описания.
//
// Возвращаемое значение:
//  Строка - HTML с обёрнутыми терминами.
//
// Использует платформенный метод СтрЗаменитьПоРегулярномуВыражению (доступен с 8.3.23).
//
Функция ОбогатитьHTMLТерминами(HTML, КодЯзыка) Экспорт

	Если ПустаяСтрока(HTML) Тогда
		Возврат HTML;
	КонецЕсли;

	Термины = ГКСИ_ТерминыГлоссарияПовтИсп.Термины(КодЯзыка);
	Если Термины.Количество() = 0 Тогда
		Возврат HTML;
	КонецЕсли;

	// Сортируем по убыванию длины наименования, чтобы избежать частичных
	// пересечений ("Склад готовой продукции" раньше "Склад").
	МассивТерминов = Новый Массив;
	Для Каждого КЗ Из Термины Цикл
		МассивТерминов.Добавить(КЗ.Значение);
	КонецЦикла;
	ГКСИ_СортироватьТерминыПоДлинеУбывание(МассивТерминов);

	// Подготовим список исключённых фрагментов (code/pre/a) - заменим их
	// на плейсхолдеры, проведём замену, потом восстановим.
	Исключения = ГКСИ_СобратьИсключения(HTML);

	РабочийHTML = HTML;
	Для Каждого Фрагмент Из Исключения Цикл
		РабочийHTML = СтрЗаменить(РабочийHTML, Фрагмент.Оригинал, Фрагмент.Плейсхолдер);
	КонецЦикла;

	// По каждому термину делаем замену через регулярное выражение целого слова.
	Для Каждого Термин Из МассивТерминов Цикл
		Наименование = Термин.Наименование;
		ШаблонРег = ГКСИ_ЭкранироватьДляРегулярногоВыражения(Наименование);
		РегВыражение = "(?<![а-яёa-z0-9_])" + ШаблонРег + "(?![а-яёa-z0-9_])";
		Замена = "<span class=""gksi-term"" data-term-guid=""" + XMLСтрока(Термин.Ссылка)
			+ """ title=""" + ГКСИ_ЭкранироватьHTML(Лев(Термин.Описание, 500))
			+ """>" + Наименование + "</span>";
		РабочийHTML = СтрЗаменитьПоРегулярномуВыражению(РабочийHTML,
			РегВыражение, Замена, Истина);
	КонецЦикла;

	// Восстанавливаем исключённые фрагменты.
	Для Каждого Фрагмент Из Исключения Цикл
		РабочийHTML = СтрЗаменить(РабочийHTML, Фрагмент.Плейсхолдер, Фрагмент.Оригинал);
	КонецЦикла;

	Возврат РабочийHTML;

КонецФункции

// Возвращает код языка текущего сеанса (из конфигурации).
//
// Возвращаемое значение:
//  Строка - код языка ("ru" по умолчанию).
//
Функция ТекущийКодЯзыка() Экспорт
	
	// На сервере ТекущийЯзык() возвращает объект метаданных языка, на клиенте - код языка.
	Попытка
		КодЯзыка = ТекущийЯзык().Код;
	Исключение
		КодЯзыка = "";
	КонецПопытки;
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		Попытка
			КодЯзыка = Строка(ТекущийЯзык());
		Исключение
			КодЯзыка = "";
		КонецПопытки;
	КонецЕсли;
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = "ru";
	КонецЕсли;
	
	Возврат КодЯзыка;
	
КонецФункции

// Извлекает описание из значения типа ХранилищеЗначения.
// Если значение пустое, не того типа, или получение не удалось - возвращает "".
//
// Параметры:
//  ОписаниеХранилище - Произвольный.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИзвлечьОписаниеИзХранилища(ОписаниеХранилище) Экспорт

	Если ОписаниеХранилище = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(ОписаниеХранилище) <> Тип("ХранилищеЗначения") Тогда
		Если ТипЗнч(ОписаниеХранилище) = Тип("Строка") Тогда
			Возврат ОписаниеХранилище;
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(ОписаниеХранилище.Получить());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Возвращает идентификатор объекта метаданных (CatalogRef.ИдентификаторыОбъектовМетаданных)
// для переданной ссылки. Если идентификатор не найден - возвращает пустую ссылку.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка.
//
// Возвращаемое значение:
//  СправочникСсылка.ИдентификаторыОбъектовМетаданных - идентификатор объекта
//  метаданных, либо пустая ссылка.
//
Функция ИдентификаторОбъектаМетаданных(Ссылка) Экспорт
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИдентификаторыОбъектовМетаданных.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|ГДЕ
		|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя";
	Запрос.УстановитьПараметр("ПолноеИмя", Ссылка.Метаданные().ПолноеИмя());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();

КонецФункции

// Возвращает термины глоссария в виде JSON-строки для встраивания в HTML превью.
// Используется в подсистеме Markdown-редактора: JSON инжектируется в HTML-каркас
// поля просмотра, JS-функция оборачивает первое вхождение каждого термина в
// <span class="gksi-term" data-term-guid="..." title="...">...</span>.
//
// Параметры:
//  КодЯзыка - Строка - код языка для подбора описания и локализованного
//                      наименования. Если пусто - используется "ru".
//
// Возвращаемое значение:
//  Строка - JSON вида [{"name":"...", "guid":"...", "title":"..."}, ...].
//           Упорядочено по убыванию длины name, чтобы избежать частичных
//           пересечений (сначала длинные). Пустая строка, если терминов нет.
//
Функция ТерминыДляПревьюJSON(КодЯзыка) Экспорт

	КэшКодЯзыка = ?(ПустаяСтрока(КодЯзыка), "ru", КодЯзыка);
	Термины = ГКСИ_ТерминыГлоссарияПовтИсп.Термины(КэшКодЯзыка);
	Если Термины.Количество() = 0 Тогда
		Возврат "[]";
	КонецЕсли;

	МассивТерминов = Новый Массив;
	Для Каждого КЗ Из Термины Цикл
		МассивТерминов.Добавить(КЗ.Значение);
	КонецЦикла;

	// Сортировка по убыванию длины наименования для исключения частичных
	// пересечений ("Склад готовой продукции" раньше "Склад").
	Для Внешний = 0 По МассивТерминов.Количество() - 2 Цикл
		Для Внутренний = 0 По МассивТерминов.Количество() - Внешний - 2 Цикл
			Левый = МассивТерминов[Внутренний];
			Правый = МассивТерминов[Внутренний + 1];
			Если СтрДлина(Левый.Наименование) < СтрДлина(Правый.Наименование) Тогда
				МассивТерминов[Внутренний] = Правый;
				МассивТерминов[Внутренний + 1] = Левый;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого Термин Из МассивТерминов Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("name");
		ЗаписьJSON.ЗаписатьЗначение(Термин.Наименование);
		ЗаписьJSON.ЗаписатьИмяСвойства("guid");
		ЗаписьJSON.ЗаписатьЗначение(XMLСтрока(Термин.Ссылка));
		ЗаписьJSON.ЗаписатьИмяСвойства("title");
		ЗаписьJSON.ЗаписатьЗначение(Лев(Термин.Описание, 500));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подбирает наименование термина по языку.
// Если языковое наименование пустое - возвращает базовое Наименование.
Функция НаименованиеПоЯзыку(Выборка, КодЯзыка)

	Базовое = Выборка.НаименованиеБазовое;
	Язык1 = Выборка.НаименованиеЯзык1;
	Язык2 = Выборка.НаименованиеЯзык2;

	Если КодЯзыка = "ru" Тогда
		Возврат ?(ПустаяСтрока(Язык1), Базовое, Язык1);
	Иначе
		Возврат ?(ПустаяСтрока(Язык2), ?(ПустаяСтрока(Базовое), Язык1, Базовое), Язык2);
	КонецЕсли;

КонецФункции

// Сортирует массив терминов по убыванию длины наименования.
// Сортировка устойчива к равенству длин (сохраняет относительный порядок).
Процедура ГКСИ_СортироватьТерминыПоДлинеУбывание(МассивТерминов)

	// Используем простую пузырьковую сортировку по убыванию длины наименования.
	// Массивы в 1С небольшие (десятки-сотни терминов), это приемлемо.
	Для Внешний = 0 По МассивТерминов.Количество() - 2 Цикл
		Для Внутренний = 0 По МассивТерминов.Количество() - Внешний - 2 Цикл
			Левый = МассивТерминов[Внутренний];
			Правый = МассивТерминов[Внутренний + 1];
			Если СтрДлина(Левый.Наименование) < СтрДлина(Правый.Наименование) Тогда
				МассивТерминов[Внутренний] = Правый;
				МассивТерминов[Внутренний + 1] = Левый;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Экранирует спецсимволы в строке, чтобы она могла быть использована
// как литерал в регулярном выражении платформенного метода.
Функция ГКСИ_ЭкранироватьДляРегулярногоВыражения(Строка)

	СпецСимволы = Новый Массив;
	СпецСимволы.Добавить("\");
	СпецСимволы.Добавить(".");
	СпецСимволы.Добавить("+");
	СпецСимволы.Добавить("*");
	СпецСимволы.Добавить("?");
	СпецСимволы.Добавить("(");
	СпецСимволы.Добавить(")");
	СпецСимволы.Добавить("[");
	СпецСимволы.Добавить("]");
	СпецСимволы.Добавить("{");
	СпецСимволы.Добавить("}");
	СпецСимволы.Добавить("^");
	СпецСимволы.Добавить("$");
	СпецСимволы.Добавить("|");
	СпецСимволы.Добавить("/");

	Результат = Строка;
	Для Каждого Символ Из СпецСимволы Цикл
		Результат = СтрЗаменить(Результат, Символ, "\" + Символ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Минимальное HTML-экранирование для подстановки значения атрибута title.
Функция ГКСИ_ЭкранироватьHTML(Строка)

	Результат = Строка;
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;

КонецФункции

// Собирает фрагменты HTML, которые нужно исключить из обработки
// (содержимое <code>, <pre>, <a>) и подменяет их плейсхолдерами,
// чтобы избежать случайных замен терминов внутри них.
//
// Возвращает массив структур {Оригинал, Плейсхолдер}.
Функция ГКСИ_СобратьИсключения(HTML)

	Результат = Новый Массив;

	СобратьВТегах(HTML, "code", Результат);
	СобратьВТегах(HTML, "pre", Результат);
	СобратьВТегах(HTML, "a", Результат);

	Возврат Результат;

КонецФункции

// Вспомогательная процедура для ГКСИ_СобратьИсключения.
// Заменяет все вхождения <TAG ...>...</TAG> плейсхолдерами и запоминает пары.
Процедура СобратьВТегах(HTML, ИмяТега, Результат)

	РегВыражение = "<" + ИмяТега + "(?:\s[^>]*)?>.*?</" + ИмяТега + ">";
	НайденныеВхождения = СтрНайтиВсеПоРегулярномуВыражению(HTML, РегВыражение, Истина);
	Если НайденныеВхождения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Счетчик = 0;
	Для Каждого Вхождение Из НайденныеВхождения Цикл
		Оригинал = Вхождение.Значение;
		Счетчик = Счетчик + 1;
		Плейсхолдер = СобратьВТегахПлейсхолдер(ИмяТега, Вхождение.НачальнаяПозиция, Счетчик);
		Элемент = Новый Структура;
		Элемент.Вставить("Оригинал", Оригинал);
		Элемент.Вставить("Плейсхолдер", Плейсхолдер);
		Результат.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

// Формирует плейсхолдер для замены фрагмента HTML при обогащении терминами.
Функция СобратьВТегахПлейсхолдер(ИмяТега, НачальнаяПозиция, Счетчик)

	Возврат "{ГКСИ_ИСКЛЮЧЕНИЕ_" + ВРег(ИмяТега) + "_" + XMLСтрока(НачальнаяПозиция)
		+ "_" + XMLСтрока(Счетчик) + "}";

КонецФункции

#КонецОбласти
