    Если СсылкиИзОбъекта = Неопределено Тогда
        СсылкиИзОбъекта = Новый Массив;
    КонецЕсли;
    
    Приемник = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://rules", "ГруппаДоступаГруппа"));
    
    Приемник.Наименование = Источник.Наименование;
    Если Источник.Свойство("Родитель") Тогда
        Приемник.Родитель = Источник.Родитель;    
    КонецЕсли;
    
    Возврат Приемник;
    
КонецФункции

// Выполняет преобразование структуры с данными в объект XDTO указанного типа в соответствии с правилами.
//
// Параметры:
//   КомпонентыОбмена - Структура - содержит все правила и параметры обмена.
//   Источник         - Структура - источник данных, которые необходимо преобразовать в объект XDTO.
//   ТипXDTO          - Строка - тип объекта или тип значения XDTO, к которому надо преобразовать данные.
//   СсылкиИзОбъекта  - Массив из ЛюбаяСсылка - содержит общий список выгруженных по ссылкам объектов.
//   ПроведеноЗаполнениеСвойств - Булево - параметр для определения заполненности общих составных свойств.
//   Расширения       - Структура - для служебного использования.
//
// Возвращаемое значение:
//   ОбъектXDTO - результат преобразования. 
// 
Функция ОбъектXDTOИзДанныхXDTOГрупыДоступа(
        КомпонентыОбмена,
        Знач Источник,
        СсылкиИзОбъекта = Неопределено,
        ПроведеноЗаполнениеСвойств = Ложь,
        Знач Расширения = Неопределено) Экспорт

    Если СсылкиИзОбъекта = Неопределено Тогда
        СсылкиИзОбъекта = Новый Массив;
    КонецЕсли;
    
    Приемник = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://rules", "ГруппаДоступа"));
    
    ТипОбъектаЗначенияДоступа = ФабрикаXDTO.Тип("http://rules", "ЗначенияДоступа");
    Приемник.ЗначенияДоступа = ФабрикаXDTO.Создать(ТипОбъектаЗначенияДоступа);
    
    Для Каждого СтрокаЗначенияДоступа Из Источник.ЗначенияДоступа Цикл  
        ТипОбъектаЗначениеДоступаСтрока = ФабрикаXDTO.Тип("http://rules", "ЗначенияДоступаСтрока");
        ЗначениеДоступаСтрока = ФабрикаXDTO.Создать(ТипОбъектаЗначениеДоступаСтрока);
        ЗначениеДоступаСтрока.ВидДоступа = Строка(ТипЗнч(СтрокаЗначенияДоступа.ВидДоступа));
        ЗначениеДоступаСтрока.ВключаяНижестоящие = СтрокаЗначенияДоступа.ВключаяНижестоящие; 
        
        Если ТипЗнч(СтрокаЗначенияДоступа.ВидДоступа) = Тип("ПеречислениеСсылка.ХозяйственныеОперации") Тогда 
            ЗначениеДоступаСтрока.ЗначениеДоступа = ЗначениеХозОперации(СтрокаЗначенияДоступа.ЗначениеДоступа);    
        КонецЕсли;

        Приемник.ЗначенияДоступа.Строка.Добавить(ЗначениеДоступаСтрока);
    КонецЦикла; 

    ТипОбъектаВидыДоступа = ФабрикаXDTO.Тип("http://rules", "ВидыДоступа");
    Приемник.ВидыДоступа = ФабрикаXDTO.Создать(ТипОбъектаВидыДоступа);
    
    Для Каждого СтрокаЗначенияВидаДоступа Из Источник.ВидыДоступа Цикл  
        ТипОбъектаВидыДоступаСтрока = ФабрикаXDTO.Тип("http://rules", "ВидыДоступаСтрока");
        ЗначениеДоступаСтрока = ФабрикаXDTO.Создать(ТипОбъектаВидыДоступаСтрока);
        ЗначениеДоступаСтрока.ВидДоступа = Строка(ТипЗнч(СтрокаЗначенияВидаДоступа.ВидДоступа));
        ЗначениеДоступаСтрока.ВсеРазрешены = СтрокаЗначенияВидаДоступа.ВсеРазрешены;
        Приемник.ВидыДоступа.Строка.Добавить(ЗначениеДоступаСтрока);
    КонецЦикла; 

    Приемник.Наименование = Источник.Наименование;
    Если Источник.Свойство("Родитель") Тогда
        Приемник.Родитель = Источник.Родитель;    
    КонецЕсли;
    
    Приемник.Профиль = Источник.Профиль;

    Возврат Приемник;
    
КонецФункции

