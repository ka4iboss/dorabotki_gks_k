Функция РольДоступа(РольНаименование, Кэш = Неопределено)
    
    Возврат НайтиВКэшеПоНаименованию(Кэш, "Роль", РольНаименование, Ложь);
    
КонецФункции

// Ищет ссылку объекта в кэше поиска по наименованию.
//
// Параметры:
//  Кэш - Соответствие из Строка, Произвольный, Неопределено - кэш поиска. Если Неопределено, поиск не выполняется.
//  ВидОбъекта - Строка - "Группа", "Профиль" или "Роль".
//  Наименование - Строка - наименование объекта.
//  ЭтоГруппа - Булево - признак группы (для групп доступа и профилей).
//
// Возвращаемое значение:
//  СправочникСсылка, Неопределено - найденная ссылка или Неопределено.
//
Функция НайтиВКэшеПоНаименованию(Кэш, ВидОбъекта, Наименование, ЭтоГруппа)
    
    Если Кэш = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Ключ = ВидОбъекта + "|" + Наименование + "|" + ?(ЭтоГруппа, "1", "0");
    
    Возврат Кэш.Получить(Ключ);
    
КонецФункции

// Однократно заполняет кэш поиска объектов по наименованию (группы доступа, профили, роли).
// Вызывается перед чтением сообщения обмена — вне циклов загрузки.
//
// Возвращаемое значение:
//  Соответствие из Строка, Произвольный - кэш с ключом "ВидОбъекта|Наименование|ПризнакГруппы".
//
Функция ПодготовитьКэшПоискаПоНаименованию()
    
    Кэш = Новый Соответствие;
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ГруппыДоступа.Наименование КАК Наименование,
    |    ГруппыДоступа.ЭтоГруппа КАК ЭтоГруппа,
    |    ГруппыДоступа.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.ГруппыДоступа КАК ГруппыДоступа
    |ГДЕ
    |    ГруппыДоступа.ИмяПредопределенныхДанных = """"";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ключ = "Группа|" + Выборка.Наименование + "|" + ?(Выборка.ЭтоГруппа, "1", "0");
        Если Кэш.Получить(Ключ) = Неопределено Тогда
            Кэш.Вставить(Ключ, Выборка.Ссылка);
        КонецЕсли;
    КонецЦикла;
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ПрофилиГруппДоступа.Наименование КАК Наименование,
    |    ПрофилиГруппДоступа.ЭтоГруппа КАК ЭтоГруппа,
    |    ПрофилиГруппДоступа.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
    |ГДЕ
    |    ПрофилиГруппДоступа.ИдентификаторПоставляемыхДанных = &ПустойИдентификатор";
    Запрос.УстановитьПараметр("ПустойИдентификатор", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ключ = "Профиль|" + Выборка.Наименование + "|" + ?(Выборка.ЭтоГруппа, "1", "0");
        Если Кэш.Получить(Ключ) = Неопределено Тогда
            Кэш.Вставить(Ключ, Выборка.Ссылка);
        КонецЕсли;
    КонецЦикла;
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ИдентификаторыОбъектовМетаданных.Наименование КАК Наименование,
    |    ИдентификаторыОбъектовМетаданных.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ключ = "Роль|" + Выборка.Наименование + "|0";
        Если Кэш.Получить(Ключ) = Неопределено Тогда
            Кэш.Вставить(Ключ, Выборка.Ссылка);
        КонецЕсли;
    КонецЦикла;
    
    Возврат Кэш;
    
КонецФункции

// Пополняет кэш поиска по наименованию записанным объектом.
//
// Параметры:
//  Объект - СправочникОбъект - записанный объект.
//  Кэш - Соответствие из Строка, Произвольный, Неопределено - кэш поиска. Если Неопределено, кэш не пополняется.
//
Процедура ОбновитьКэшПоОбъекту(Объект, Кэш = Неопределено)
    
    Если Кэш = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    МетаданныеОбъекта = Объект.Метаданные();
    Если МетаданныеОбъекта = Метаданные.Справочники.ГруппыДоступа Тогда
        Если ЗначениеЗаполнено(Объект.ИмяПредопределенныхДанных) Тогда
            Возврат;
        КонецЕсли;
        ВидОбъекта = "Группа";
    ИначеЕсли МетаданныеОбъекта = Метаданные.Справочники.ПрофилиГруппДоступа Тогда
        Если ЗначениеЗаполнено(Объект.ИдентификаторПоставляемыхДанных) Тогда
            Возврат;
        КонецЕсли;
        ВидОбъекта = "Профиль";
    Иначе
        Возврат;
    КонецЕсли;
    
    Ключ = ВидОбъекта + "|" + Объект.Наименование + "|" + ?(Объект.ЭтоГруппа, "1", "0");
    Если Кэш.Получить(Ключ) = Неопределено Тогда
        Кэш.Вставить(Ключ, Объект.Ссылка);
    КонецЕсли;
    
КонецПроцедуры

