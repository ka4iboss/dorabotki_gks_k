    Приемник.Наименование    = Источник.Наименование;
    Приемник.ПометкаУдаления = Источник.ПометкаУдаления;
    Приемник.ЭтоГруппа       = Истина;
    
    Если Источник.Свойство("Родитель") И ЗначениеЗаполнено(Источник.Родитель) Тогда
        Приемник.Родитель = Источник.Родитель;
    Иначе
        Приемник.Родитель = "";
    КонецЕсли;
    
    // Состав выгружаем только если есть участники
    Если Источник.Свойство("Состав") И Источник.Состав.Количество() > 0 Тогда
        ТипОбъектаСостав = ФабрикаXDTO.Тип("http://rules", "СоставГруппыПользователей");
        Приемник.Состав = ФабрикаXDTO.Создать(ТипОбъектаСостав);
        
        Для Каждого СтрокаСостава Из Источник.Состав Цикл
            ТипСтроки = ФабрикаXDTO.Тип("http://rules", "СоставГруппыПользователейСтрока");
            СтрокаXDTO = ФабрикаXDTO.Создать(ТипСтроки);
            СтрокаXDTO.Пользователь = Строка(СтрокаСостава.Пользователь);
            Приемник.Состав.Строка.Добавить(СтрокаXDTO);  // используем "Строка" (после переименования в схеме)
        КонецЦикла;
    КонецЕсли;
    
    Возврат Приемник;
    
КонецФункции

Функция ОбъектXDTOИзДанныхXDTOПользователя(
        КомпонентыОбмена,
        Знач Источник,
        СсылкиИзОбъекта = Неопределено,
        ПроведеноЗаполнениеСвойств = Ложь,
        Знач Расширения = Неопределено) Экспорт

    Если СсылкиИзОбъекта = Неопределено Тогда
        СсылкиИзОбъекта = Новый Массив;
    КонецЕсли;
    
    Приемник = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://rules", "Пользователь"));
    
    Приемник.Наименование      = Источник.Наименование;
    Приемник.ПометкаУдаления   = Источник.ПометкаУдаления;
    Приемник.ЭтоГруппа         = Ложь;
    
    // Код – необязательное свойство
    Если Источник.Свойство("Код") И ЗначениеЗаполнено(Источник.Код) Тогда
        Приемник.Код = Источник.Код;
    КонецЕсли;
    
    // ГруппаПользователей теперь необязательное в схеме, можно не выгружать
    // Если всё же требуется, раскомментируйте и передавайте пустую строку
    // Приемник.ГруппаПользователей = "";
    
    // ПолноеНаименование
    Если Источник.Свойство("ПолноеНаименование") Тогда
        Приемник.ПолноеНаименование = Источник.ПолноеНаименование;
    Иначе
        Приемник.ПолноеНаименование = Источник.Наименование;
    КонецЕсли;
    
    Возврат Приемник;
    
КонецФункции


// Выполняет преобразование данных информационной базы в структуру с данными в соответствии с правилами.
//
// Параметры:
//   КомпонентыОбмена    - см. ИнициализироватьКомпонентыОбмена
//   Источник            - ЛюбаяСсылка - ссылка на выгружаемый объект информационной базы.
//   ПравилоКонвертации  - СтрокаТаблицыЗначений - строка таблицы правил конвертации объектов, 
//                         в соответствии с которой выполняется преобразование.
//   СтекВыгрузки        - Массив из ЛюбаяСсылка - ссылки на выгружаемые объекты с учетом вложенности.
//
// Возвращаемое значение:
//   Структура
//  - Неопределено - результат преобразования.
//
Функция ДанныеXDTOИзОбъекта(КомпонентыОбмена, Источник, СтекВыгрузки = Неопределено) Экспорт
    
    Приемник = Новый Структура;
    
    Если СтекВыгрузки = Неопределено Тогда
        СтекВыгрузки = Новый Массив;
    КонецЕсли;
    
    ПозицияВСтеке = СтекВыгрузки.Найти(Источник.Ссылка);
    //    
    //// Проверяем, выгружался ли объект по ссылке, чтобы не допустить зацикливания.
    Если ПозицияВСтеке <> Неопределено Тогда
    //        
        Если ПозицияВСтеке > 0 Тогда
            Возврат Неопределено;
        ИначеЕсли СтекВыгрузки.Количество() > 1 Тогда
    //            // Необходимо искать перебором.
            ПерваяИтерация = Истина;
            Для Каждого ЭлементСтека Из СтекВыгрузки Цикл
                Если ПерваяИтерация Тогда
                    ПерваяИтерация = Ложь;
                    Продолжить;
                КонецЕсли;
                Если ЭлементСтека = Источник.Ссылка Тогда
                    Возврат Неопределено;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        
    СтекВыгрузки.Добавить(Источник.Ссылка);
    //    
    Если Источник.Ссылка.Пустая() Тогда
        Возврат Неопределено;
    КонецЕсли;
    //    
    Иначе
        СтекВыгрузки.Добавить(Источник);
    КонецЕсли;
        
    // Выполнение ПКС, 1-й этап
    ВыгрузитьСсылку(КомпонентыОбмена, Источник, Приемник, СтекВыгрузки);

    Возврат Приемник;
    
КонецФункции

