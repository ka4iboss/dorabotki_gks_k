        //    Возврат;
        //КонецЕсли;
        
        //ПравилоКонвертации = Новый Структура("ПравилоКонвертации, УдалятьСозданныеПоКлючевымСвойствам",
        //    ПравилоКонвертацииСвойства, УдалятьСозданныеПоКлючевымСвойствам);
        //ДанныеДляЗаписиВИБ = СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, ЗначениеСвойства, ПравилоКонвертации, "ПолучитьСсылку");
        //
        //Если ДанныеДляЗаписиВИБ <> Неопределено Тогда
        //    ПриемникДанных[ПКС.СвойствоКонфигурации] = ДанныеДляЗаписиВИБ.Ссылка;
        //КонецЕсли;
        
    Исключение
        ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
            НСтр("ru = 'Ошибка конвертации свойства объекта XDTO, имя свойства: <%1>.';en = 'XDTO object property conversion error. Property: <%1>.'"), ПКС.СвойствоКонфигурации)
            + Символы.ПС + Символы.ПС + ПредставлениеОшибки;
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    
КонецПроцедуры

Функция СсылкаОбъектаПоСвойствамОбъектаXDTO(ПравилоКонвертации, ПолученныеДанные, ДанныеXDTOСодержатСсылку, УзелОбмена)
    
    Результат = Неопределено;
    // ПравилоКонвертации.ПоляПоискаОбъекта - массив, содержит разные варианты поиска
    //    элементы массива - таблица значений с полями поиска.
    Если ПравилоКонвертации.ПоляПоиска = Неопределено
        ИЛИ ТипЗнч(ПравилоКонвертации.ПоляПоиска) <> Тип("Массив") Тогда
        Возврат Результат;
    КонецЕсли;
    
    // Варианты поиска запросом собираются в цикле и выполняются одним пакетом после него.
    ВариантыЗапросов = Новый Массив;
    ИндексВарианта = 0;
    ВариантИдентификации = СокрЛП(ПравилоКонвертации.ВариантИдентификации);
    АнализироватьПубличныеИдентификаторы = ВариантИдентификации = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска"
        И ДанныеXDTOСодержатСсылку
        И ЗначениеЗаполнено(УзелОбмена);
    
    Для Каждого ПопыткаПоиска Из ПравилоКонвертации.ПоляПоиска Цикл
        ИндексВарианта = ИндексВарианта + 1;
        ПоляПоиска = Новый Структура(ПопыткаПоиска);
        ЗаполнитьЗначенияСвойств(ПоляПоиска, ПолученныеДанные);
        
        // Если хотя бы одно поле поиска не заполнено, вариант поиска пропускается.
        // (Кроме справочников и планов видов характеристик - для них допустимо
        // незаполненное поле поиска "Родитель").
        // Вариант поиска является полноценным, если заполнены все поля.
        // В противном случае должен сработать другой вариант поиска.
        ЕстьНезаполненныеПоля = Ложь;
        Для Каждого ПолеПоиска Из ПоляПоиска Цикл
            Если Не ЗначениеЗаполнено(ПолеПоиска.Значение) Тогда
                Если (ПравилоКонвертации.ЭтоСправочник Или ПравилоКонвертации.ЭтоПланВидовХарактеристик)
                    И ПолеПоиска.Ключ = "Родитель" Тогда
                    Продолжить;
                КонецЕсли;
                
                ЕстьНезаполненныеПоля = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если ЕстьНезаполненныеПоля Тогда
            // Переход к следующему варианту поиска.
            Продолжить;
        КонецЕсли;
        
            
        ПоискЗапросом = Ложь;
        Если АнализироватьПубличныеИдентификаторы Тогда
            ПоискЗапросом = Истина;
        Иначе
            // Возможно, поиск можно выполнить платформенными методами.
            Если ПравилоКонвертации.ЭтоДокумент
                И ПоляПоиска.Количество() = 2
                И ПоляПоиска.Свойство("Дата")
                И ПоляПоиска.Свойство("Номер") Тогда
                Результат = ПравилоКонвертации.МенеджерОбъекта.НайтиПоНомеру(ПоляПоиска.Номер, ПоляПоиска.Дата);
                Результат = ?(Результат.Пустая(), Неопределено, Результат);
            ИначеЕсли ПравилоКонвертации.ЭтоСправочник
                И ПоляПоиска.Количество() = 1
                И ПоляПоиска.Свойство("Наименование") Тогда
                Результат = ПравилоКонвертации.МенеджерОбъекта.НайтиПоНаименованию(ПоляПоиска.Наименование, Истина);
            ИначеЕсли ПравилоКонвертации.ЭтоСправочник
                И ПоляПоиска.Количество() = 1
                И ПоляПоиска.Свойство("Код") Тогда
                Результат = ПравилоКонвертации.МенеджерОбъекта.НайтиПоКоду(ПоляПоиска.Код);
            Иначе
                ПоискЗапросом = Истина;
            КонецЕсли;
        КонецЕсли;
        
        Если ПоискЗапросом Тогда
            // Запрос по варианту не выполняется здесь — все варианты выполняются одним пакетом после цикла.
            ВариантыЗапросов.Добавить(
                ПодготовитьВариантПоискаЗапросом(ПравилоКонвертации, ПоляПоиска, ИндексВарианта));
        КонецЕсли;
        Если ЗначениеЗаполнено(Результат) Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;
    
    Если ВариантыЗапросов.Количество() > 0 Тогда
        // Собранные варианты поиска запросом расположены в списке вариантов идентификации раньше
        // платформенного поиска, поэтому имеют приоритет над найденным значением Результат.
        СсылкаПоЗапросу = НайтиСсылкуОбъектаЗапросами(ВариантыЗапросов, АнализироватьПубличныеИдентификаторы, УзелОбмена);
        Если СсылкаПоЗапросу <> Неопределено Тогда
            Результат = СсылкаПоЗапросу;
        КонецЕсли;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

// Готовит описание варианта поиска объекта запросом.
//
// Параметры:
//  ПравилоКонвертации - Структура - правило конвертации, используется полное имя объекта.
//  ПоляПоиска - Структура - поля поиска варианта идентификации.
//  НомерВарианта - Число - порядковый номер варианта в списке вариантов идентификации.
//
// Возвращаемое значение:
//  Структура - описание варианта поиска: полное имя объекта метаданных, условие отбора
//              по полям поиска и значения параметров запроса.
//
Функция ПодготовитьВариантПоискаЗапросом(ПравилоКонвертации, ПоляПоиска, НомерВарианта)
    
    ВариантЗапроса = Новый Структура("ПолноеИмя, Условие, Параметры");
    ВариантЗапроса.ПолноеИмя = ПравилоКонвертации.ПолноеИмя;
    ВариантЗапроса.Параметры = Новый Соответствие;
    
    Отбор = Новый Массив;
    
    Для Каждого ПолеПоиска Из ПоляПоиска Цикл
        
        // Имена параметров должны быть уникальны в пакете запросов, поэтому содержат номер варианта.
        ИмяПараметра = ПолеПоиска.Ключ + "_" + Формат(НомерВарианта, "ЧГ=0");
        
        Если ОбменДаннымиПовтИсп.ЭтоСтроковыйРеквизитНеограниченнойДлины(ПравилоКонвертации.ПолноеИмя, ПолеПоиска.Ключ) Тогда
            
            ОтборСтрокой = "ВЫРАЗИТЬ(Таблица.[Ключ] КАК СТРОКА([ДлинаСтроки])) = &[Ключ]";
            ОтборСтрокой = СтрЗаменить(ОтборСтрокой, "[ДлинаСтроки]", Формат(СтрДлина(ПолеПоиска.Значение), "ЧГ=0"));
            
        Иначе
            
            ОтборСтрокой = "Таблица.[Ключ] = &[Ключ]";
            
        КонецЕсли;
        
        ОтборСтрокой = СтрЗаменить(ОтборСтрокой, "&[Ключ]", "&" + ИмяПараметра);
        ОтборСтрокой = СтрЗаменить(ОтборСтрокой, "[Ключ]", ПолеПоиска.Ключ);
        Отбор.Добавить(ОтборСтрокой);
        
        ВариантЗапроса.Параметры.Вставить(ИмяПараметра, ПолеПоиска.Значение);
        
    КонецЦикла;
    
    ВариантЗапроса.Условие = СтрСоединить(Отбор, " И ");
    
    Возврат ВариантЗапроса;
    
КонецФункции

// Ищет ссылку объекта запросами по всем подготовленным вариантам поиска.
// Все запросы выполняются одним пакетом, за одно обращение к серверу.
//
// Параметры:
//  ВариантыЗапросов - Массив из Структура - описания вариантов, см. ПодготовитьВариантПоискаЗапросом().
//  АнализироватьПубличныеИдентификаторы - Булево - Истина, если из поиска исключаются уже
//                сопоставленные ранее объекты.
//  УзелОбмена - СправочникСсылка - узел обмена.
//
// Возвращаемое значение:
//  СправочникСсылка, ДокументСсылка - найденная ссылка;
//  Неопределено - объект не найден.
//
Функция НайтиСсылкуОбъектаЗапросами(ВариантыЗапросов, АнализироватьПубличныеИдентификаторы, УзелОбмена)
    
    Запрос = Новый Запрос;
    ТекстПакета = "";
    
    Для Каждого ВариантЗапроса Из ВариантыЗапросов Цикл
        
        ТекстВарианта =
        "ВЫБРАТЬ
        |    Таблица.Ссылка КАК Ссылка
        |ИЗ
        |    &ПолноеИмя КАК Таблица
        |ГДЕ
        |    &УсловиеОтбора";
        
        УсловиеОтбора = ВариантЗапроса.Условие;
        
        Если АнализироватьПубличныеИдентификаторы Тогда
            // Из поиска необходимо исключить уже сопоставленные ранее объекты.
            ТекстСоединения = "    ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторы
                |    ПО ПубличныеИдентификаторы.Ссылка = Таблица.Ссылка И ПубличныеИдентификаторы.УзелИнформационнойБазы = &УзелОбмена";
            ТекстВарианта = СтрЗаменить(ТекстВарианта, "ГДЕ", ТекстСоединения + Символы.ПС + "    ГДЕ");
            УсловиеОтбора = УсловиеОтбора + Символы.ПС + "    И ПубличныеИдентификаторы.Ссылка is null";
            Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
        КонецЕсли;
        
        ТекстВарианта = СтрЗаменить(ТекстВарианта, "&ПолноеИмя", ВариантЗапроса.ПолноеИмя);
        ТекстВарианта = СтрЗаменить(ТекстВарианта, "&УсловиеОтбора", УсловиеОтбора);
        
        ТекстПакета = ТекстПакета + ?(ПустаяСтрока(ТекстПакета), "", Символы.ПС) + ТекстВарианта + ";";
        
        Для Каждого Параметр Из ВариантЗапроса.Параметры Цикл
            Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
        КонецЦикла;
        
    КонецЦикла;
    
    Запрос.Текст = ТекстПакета;
    РезультатыЗапросов = Запрос.ВыполнитьПакет();
    
    // Первый непустой результат соответствует наиболее приоритетному варианту поиска.
    Для Каждого РезультатЗапроса Из РезультатыЗапросов Цикл
        
        Если РезультатЗапроса = Неопределено Или РезультатЗапроса.Пустой() Тогда
            Продолжить;
        КонецЕсли;
        
        Выборка = РезультатЗапроса.Выбрать();
        Выборка.Следующий();
        
        Возврат Выборка.Ссылка;
        
    КонецЦикла;
    
    Возврат Неопределено;
    
КонецФункции

