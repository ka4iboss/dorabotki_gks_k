#Область КонвертацияXDTOВСтруктуру

Процедура КонвертацияСвойстваXDTOВЭлементСтруктуры(Источник, Свойство, Приемник,
    ИмяДляСвойстваСоставногоТипа = "", ТипСвойства = Неопределено)
    
    Если Не Источник.Установлено(Свойство) Тогда
        Возврат;
    КонецЕсли;
    //
    
    ИмяСвойства = ?(ИмяДляСвойстваСоставногоТипа = "", Свойство.Имя, ИмяДляСвойстваСоставногоТипа);
    
    ЗначениеXDTO = Источник.ПолучитьXDTO(Свойство);
    Если ТипСвойства <> Неопределено Тогда
        
        ТипЗначенияXDTO = ТипСвойства;
        
    ИначеЕсли ЗначениеXDTO <> Неопределено Тогда
        
        ТипЗначенияXDTO = ТипЗначенияСвойстваXDTO(Свойство, ЗначениеXDTO);
        
    Иначе
        
        Возврат;
        
    КонецЕсли;
    
    Попытка
        Если ТипЗнч(ЗначениеXDTO) = Тип("ЗначениеXDTO") Тогда
            
            КонвертироватьПростоеСвойства(Приемник, ИмяСвойства, ЗначениеXDTO, ТипЗначенияXDTO);
            
        ИначеЕсли ТипЗнч(ЗначениеXDTO) = Тип("ОбъектXDTO") Тогда
            
            // В свойстве могут находиться:
            // - дополнительная информация
            // - табличная часть
            // - набор ключевых свойств
            // - набор общих свойств
            // - свойство составного типа.
            
            КлассЗначенияXDTO = ИмяКлассаЗначенияXDTO(Свойство, ТипЗначенияXDTO);
            
            Если КлассЗначенияXDTO = КлассПроизвольныеДанные() Тогда // Дополнительная информация
                
                Значение = СериализаторXDTO.ПрочитатьXDTO(ЗначениеXDTO);
                Приемник.Вставить(ИмяСвойства, Значение);
                
            ИначеЕсли КлассЗначенияXDTO = КлассТаблицаОбъекта() Тогда
    // Если элемент табличной части пуст (например, <Состав/>), создаём пустую таблицу
    Если ЗначениеXDTO.Свойства().Количество() = 0 Тогда
        Приемник.Вставить(ИмяСвойства, Новый ТаблицаЗначений);
    Иначе
        КонвертироватьТаблицуОбъекта(Приемник,  ИмяСвойства, Свойство, ТипЗначенияXDTO, ЗначениеXDTO);
    КонецЕсли;               
            
            Иначе
                
                КонвертироватьСоставноеСвойство(Приемник, ИмяСвойства, ТипЗначенияXDTO, ЗначениеXDTO);
                
            КонецЕсли;
        КонецЕсли;
    Исключение
        ПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
            НСтр("ru = 'Ошибка чтения объекта XDTO, имя свойства: <%1>.';en = 'XDTO object reading error. Property: <%1>.'"), ИмяСвойства)
            + Символы.ПС + Символы.ПС + ПредставлениеОшибки;
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    
КонецПроцедуры

Процедура КонвертироватьСоставноеСвойство(Приемник, Знач ИмяСвойства, Знач ТипЗначенияXDTO, Знач ЗначениеXDTO)

    Для Каждого ПодСвойство Из ЗначениеXDTO.Свойства() Цикл
        
        ОписаниеСвойства = ТипЗначенияXDTO.Свойства.Получить(ПодСвойство.Имя);
        Если ОписаниеСвойства = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Если НЕ ЗначениеXDTO.Установлено(ПодСвойство) Тогда
            Продолжить;
        КонецЕсли;
        
        КонвертацияСвойстваXDTOВЭлементСтруктуры(ЗначениеXDTO, ПодСвойство, Приемник, ИмяСвойства, ОписаниеСвойства.Тип);
        Прервать;
        
    КонецЦикла;

КонецПроцедуры

Процедура КонвертироватьТаблицуОбъекта(Приемник, Знач ИмяСвойства, Знач СвойствоXDTO, Знач ТипЗначенияXDTO, Знач ЗначениеXDTO)
    
    // Инициализируем таблицу значений, которая отображает табличную часть объекта.
    Значение = Новый ТаблицаЗначений;
    ИнициализироватьКолонкиТаблицыОбъектаПоТипу(Значение, ТипЗначенияXDTO.Свойства[0].Тип);
    
    ТабличнаяЧастьXDTO = ЗначениеXDTO.Строка;
    Если ТипЗнч(ТабличнаяЧастьXDTO) <> Тип("СписокXDTO") Тогда
        
        МассивОбъектовXDTO = Новый Массив(1);
        МассивОбъектовXDTO[0] = ТабличнаяЧастьXDTO;
        
        ТабличнаяЧастьXDTO = МассивОбъектовXDTO;
        
    КонецЕсли;
    
    Для Каждого СтрокаXDTO Из ТабличнаяЧастьXDTO Цикл
        
        СтрокаТЧ = Значение.Добавить();
        Для Каждого СвойствоСтрокиТЧ Из СтрокаXDTO.Свойства() Цикл
            
            СтрокаТипСвойства = СвойствоСтрокиТЧ.Тип;
            
            КонвертацияСвойстваXDTOВЭлементСтруктуры(СтрокаXDTO, СвойствоСтрокиТЧ, СтрокаТЧ, , СтрокаТипСвойства);
            
        КонецЦикла;
        
    КонецЦикла;
    
    Приемник.Вставить(ИмяСвойства, Значение);
    
КонецПроцедуры

// Параметры:
//   Таблица - ТаблицаЗначений - таблица для инициализации колонок.
//   Тип - ТипОбъектаXDTO - тип объекта.
//
Процедура ИнициализироватьКолонкиТаблицыОбъектаПоТипу(Таблица, Знач Тип)
    
    Для Каждого Колонка Из Тип.Свойства Цикл
        Таблица.Колонки.Добавить(Колонка.Имя);
    КонецЦикла;
    
КонецПроцедуры

Функция КлассТаблицаОбъекта()
    
    Возврат "ТаблицаОбъекта"; // @Non-NLS
    
КонецФункции

Функция КлассПроизвольныеДанные()
    
    Возврат "ПроизвольныеДанные"; // @Non-NLS
    
КонецФункции

// Определение класса для значения свойства.
// Класс используется для выбора алгоритма преобразования в структуру.
//
Функция ИмяКлассаЗначенияXDTO(Знач СвойствоXDTO, Знач ТипЗначенияXDTO)
    
    Если СвойствоXDTO.Имя = "AdditionalInfo" Тогда
        Возврат КлассПроизвольныеДанные();
    ИначеЕсли ЭтоТипТаблицыОбъекта(ТипЗначенияXDTO) Тогда
        Возврат КлассТаблицаОбъекта();
    КонецЕсли;
    
    Возврат КлассСоставныеСвойства();
    
КонецФункции

Функция КлассСоставныеСвойства()
    
    Возврат "СоставныеСвойства"; // @Non-NLS
    
КонецФункции

Функция ЭтоТипТаблицыОбъекта(Знач ТипСвойстваXDTO)
    
    Если ТипЗнч(ТипСвойстваXDTO) = Тип("ТипОбъектаXDTO")
        И ТипСвойстваXDTO.Свойства.Количество() = 1 Тогда
        
        Возврат ТипСвойстваXDTO.Свойства[0].ВерхняяГраница <> 1;
        
    КонецЕсли;
    
    Возврат Ложь;
КонецФункции

// Инкапсуляция алгоритмов преобразования свойств объекта XDTO в элементы структуры
//
Процедура КонвертироватьПростоеСвойства(Приемник,Знач ИмяСвойства, Знач ЗначениеXDTO, Знач ТипСвойства)
    
    Значение = ПрочитатьЗначениеXDTO(ЗначениеXDTO, ТипСвойства);
    
    Если ТипЗнч(Приемник) = Тип("Структура") Тогда
        Приемник.Вставить(ИмяСвойства, Значение);
    Иначе
        
        Если ТипЗнч(Приемник) = Тип("СтрокаТаблицыЗначений")
            И Приемник.Владелец().Колонки.Найти(ИмяСвойства) = Неопределено Тогда
            Возврат;
        КонецЕсли;
        
        Приемник[ИмяСвойства] = Значение;
    КонецЕсли;
    
КонецПроцедуры

Функция ПрочитатьЗначениеXDTO(ЗначениеXDTO, ТипСвойства = Неопределено)
    
    ТипСвойства = ?(ТипСвойства = Неопределено, ЗначениеXDTO.Тип(), ТипСвойства);
    
    Если ЗначениеXDTO = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Значение = ЗначениеXDTO.Значение;

    Возврат Значение;
    
КонецФункции

// Определение типа свойства XDTO.
//
// Если свойство относится к базовому пакету XDTO, то тип можно получить прямым обращением методом Тип().
// Если переданное свойство принадлежит расширению пакета XDTO, то обращении метод Тип() возвращает AnyType,
// т.е. тип определен не будет.
//
// Для получения типа свойства из расширения необходимо:
//  1. Получить имя базового объекта (объекта, который расширяем);
//  2. По имени базового объекта получить объект из расширения;
//  3. У объекта из п2 выбрать свойство с нужным именем и зачитать его тип.
//
// Возвращаемое значение:
//  ТипЗначенияXDTO - тип свойства объекта XDTO.
//
Функция ТипЗначенияСвойстваXDTO(Знач СвойствоXDTO, ЗначениеXDTO)
    
    Результат = ЗначениеXDTO.Тип();
    Если СвойствоXDTO.ОбъектВладелец = Неопределено Тогда
        
        // Владельца может не быть у полностью нового объекта, который добавляется расширением
        // Например, работаем со справочником, который отсутствует в типовой конфигурации.
        Возврат Результат;
        
    КонецЕсли;
    
    ПространствоИменСвойства = СвойствоXDTO.URIПространстваИмен;
    //Если ЭтоБазоваяСхема(КомпонентыОбмена, ПространствоИменСвойства) Тогда
    //    
    //    Возврат Результат;
    //    
    //КонецЕсли;
    
    ТипXDTOВладельцаСвойства = СвойствоXDTO.ОбъектВладелец.Тип();
    
    //Если НЕ ЭтоБазоваяСхема(КомпонентыОбмена, ПространствоИменВладельца) Тогда
    //    
    //    // Свойство должно принадлежать объекту XDTO базовой схемы
    //    Возврат Результат;
    //    
    //КонецЕсли;
    
    ОбъектXDTOРасширения = ФабрикаXDTO.Тип(ПространствоИменСвойства, ТипXDTOВладельцаСвойства.Имя);
    Если ОбъектXDTOРасширения <> Неопределено Тогда
        
        СвойствоОбъектаXDTOРасширения = ОбъектXDTOРасширения.Свойства.Получить(СвойствоXDTO.Имя);
        Если СвойствоОбъектаXDTOРасширения <> Неопределено Тогда
            
            Результат = СвойствоОбъектаXDTOРасширения.Тип;
            
        КонецЕсли;
        

    КонецЕсли;
    
    Возврат Результат;    
    
КонецФункции

#КонецОбласти

#Область Прочее
#КонецОбласти
// Выполняет загрузку сообщения из XML-файла.
// Параметры:
//   СтруктураПараметров - Структура - структура с ключом "АдресНаСервере" (путь к файлу выгрузки).
//   АдресРезультата    - Строка - адрес временного хранилища, куда будут помещены результаты загрузки.
//
Процедура ЗагрузкаСообщения(СтруктураПараметров, АдресРезультата) Экспорт
    
    ТаблицаПротокола = Новый ТаблицаЗначений;
    ТаблицаПротокола.Колонки.Добавить("ТипОбъекта",   Новый ОписаниеТипов("Строка"));
    ТаблицаПротокола.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
    ТаблицаПротокола.Колонки.Добавить("Действие",     Новый ОписаниеТипов("Строка"));
    ТаблицаПротокола.Колонки.Добавить("Ошибка",       Новый ОписаниеТипов("Строка"));
    
    Попытка
        // Читаем файл как текст UTF-8
        ЧтениеТекста = Новый ЧтениеТекста(СтруктураПараметров.АдресНаСервере, "UTF-8");
        ТекстXML = ЧтениеТекста.Прочитать();
        ЧтениеТекста.Закрыть();
        
        Стр = ТаблицаПротокола.Добавить();
        Стр.ТипОбъекта = "Отладка";
        Стр.Наименование = "Файл прочитан как текст";
        Стр.Действие = "Длина: " + СтрДлина(ТекстXML) + " символов";
        Стр.Ошибка = "";
        
        // Удаляем BOM (U+FEFF), если есть
        Если СтрДлина(ТекстXML) > 0 Тогда
            Если КодСимвола(Лев(ТекстXML, 1)) = 65279 Тогда
                ТекстXML = Сред(ТекстXML, 2);
                Стр = ТаблицаПротокола.Добавить();
                Стр.ТипОбъекта = "Отладка";
                Стр.Наименование = "Удалён BOM (U+FEFF)";
                Стр.Действие = "Новая длина: " + СтрДлина(ТекстXML);
                Стр.Ошибка = "";
            КонецЕсли;
        КонецЕсли;
        
        ЧтениеXML = Новый ЧтениеXML;
        ЧтениеXML.УстановитьСтроку(ТекстXML);
        
        // Важно: активируем парсер, переходя к первому узлу
        ЧтениеXML.Прочитать();
        
        // Пропускаем объявление XML и другие служебные узлы
        Пока ЧтениеXML.ТипУзла = ТипУзлаXML.ОбъявлениеXML 
              Или ЧтениеXML.ТипУзла = ТипУзлаXML.Текст 
              Или ЧтениеXML.ТипУзла = ТипУзлаXML.Комментарий 
              Или ЧтениеXML.ТипУзла = ТипУзлаXML.ИнструкцияОбработки Цикл
            ЧтениеXML.Прочитать();
        КонецЦикла;
        
        Стр = ТаблицаПротокола.Добавить();
        Стр.ТипОбъекта = "Отладка";
        Стр.Наименование = "После пропуска служебных узлов";
        Стр.Действие = "узел: " + ЧтениеXML.ЛокальноеИмя + " (тип " + ЧтениеXML.ТипУзла + ")";
        Стр.Ошибка = "";
        
        // Заходим внутрь Message
        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
           И ЧтениеXML.ЛокальноеИмя = "Message" Тогда
            
            ЧтениеXML.Прочитать(); // Входим внутрь Message
            
            Стр = ТаблицаПротокола.Добавить();
            Стр.ТипОбъекта = "Отладка";
            Стр.Наименование = "После входа в Message";
            Стр.Действие = "узел: " + ЧтениеXML.ЛокальноеИмя + " (тип " + ЧтениеXML.ТипУзла + ")";
            Стр.Ошибка = "";
            
            // Пропускаем Header
            Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
               И ЧтениеXML.ЛокальноеИмя = "Header" Тогда
                Стр = ТаблицаПротокола.Добавить();
                Стр.ТипОбъекта = "Отладка";
                Стр.Наименование = "Найден Header, пропускаем...";
                Стр.Действие = "";
                Стр.Ошибка = "";
                
                ЧтениеXML.Пропустить();
				ЧтениеXML.Прочитать();
				
                Стр = ТаблицаПротокола.Добавить();
                Стр.ТипОбъекта = "Отладка";
                Стр.Наименование = "После пропуска Header";
                Стр.Действие = "узел: " + ЧтениеXML.ЛокальноеИмя + " (тип " + ЧтениеXML.ТипУзла + ")";
                Стр.Ошибка = "";
            КонецЕсли;
            
        КонецЕсли;
        
        Стр = ТаблицаПротокола.Добавить();
        Стр.ТипОбъекта = "Отладка";
        Стр.Наименование = "Начинаем чтение объектов";
        Стр.Действие = "первый элемент: " + ЧтениеXML.ЛокальноеИмя;
        Стр.Ошибка = "";
        
        Результаты = Новый Структура;
        Результаты.Вставить("ТаблицаПротокола", ТаблицаПротокола);
        Результаты.Вставить("Счетчики", Новый Структура);
        
        Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
            ПрочитатьСообщениеОбмена(ЧтениеXML, Результаты);
        Иначе
            Стр = ТаблицаПротокола.Добавить();
            Стр.ТипОбъекта = "Отладка";
            Стр.Наименование = "Нет начального элемента для чтения объектов";
            Стр.Действие = "тип узла: " + ЧтениеXML.ТипУзла;
            Стр.Ошибка = "";
            
            Стр = ТаблицаПротокола.Добавить();
            Стр.ТипОбъекта = "Информация";
            Стр.Наименование = "Файл не содержит данных для загрузки";
            Стр.Действие = "Предупреждение";
            Стр.Ошибка = "";
        КонецЕсли;
        
    Исключение
        Стр = ТаблицаПротокола.Добавить();
        Стр.ТипОбъекта = "Отладка";
        Стр.Наименование = "Исключение в ЗагрузкаСообщения";
        Стр.Действие = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Стр.Ошибка = "";
        
        Результаты = Новый Структура;
        Результаты.Вставить("ТаблицаПротокола", ТаблицаПротокола);
        Результаты.Вставить("Счетчики", Новый Структура);
    КонецПопытки;
    
    ПоместитьВоВременноеХранилище(Результаты, АдресРезультата);
    
КонецПроцедуры

Процедура ПрочитатьСообщениеОбмена(ФайлОбмена, Результаты, ТаблицыДляЗагрузки = Неопределено, РежимАнализа = Ложь)
    
    МассивОбъектовКУдалению   = Новый Массив;
    МассивЗагруженныхОбъектов = Новый Массив;
    
    Счетчики = Новый Структура;
    Счетчики.Вставить("ГруппыДоступа",     Новый Структура("Создано,Обновлено", 0, 0));
    Счетчики.Вставить("Профили",           Новый Структура("Создано,Обновлено", 0, 0));
    Счетчики.Вставить("ГруппыПользователей", Новый Структура("Создано,Обновлено", 0, 0));
    Счетчики.Вставить("Пользователи",      Новый Структура("Создано,Обновлено", 0, 0));
    
    ТаблицаПротокола = Результаты.ТаблицаПротокола;
    Результаты.Вставить("МассивОбъектовКУдалению",   МассивОбъектовКУдалению);
    Результаты.Вставить("МассивЗагруженныхОбъектов", МассивЗагруженныхОбъектов);
    Результаты.Вставить("Счетчики",                  Счетчики);
    
    // Кэш поиска объектов по наименованию заполняется однократно — вне цикла загрузки.
    Кэш = ПодготовитьКэшПоискаПоНаименованию();
    
    КоличествоЭлементов = 0;
    
    Пока ФайлОбмена.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
        
        КоличествоЭлементов = КоличествоЭлементов + 1;
        ЛокальноеИмя = ФайлОбмена.ЛокальноеИмя;
        ПространствоИмен = ФайлОбмена.URIПространстваИмен; 
		
		НоваяСтрокаОтладка = ТаблицаПротокола.Добавить();
		НоваяСтрокаОтладка.ТипОбъекта = "Отладка";
		НоваяСтрокаОтладка.Наименование = "Обнаружен элемент: " + ЛокальноеИмя;
		НоваяСтрокаОтладка.Действие = "пространство: " + ПространствоИмен;
		НоваяСтрокаОтладка.Ошибка = "";

		ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
        "Обнаружен элемент: '" + ЛокальноеИмя + "', пространство имен: '" + ПространствоИмен + "'");
		
        Попытка
            ТипОбъектаXDTO = ФабрикаXDTO.Тип(ПространствоИмен, ЛокальноеИмя);
            ОбъектXDTO     = ФабрикаXDTO.ПрочитатьXML(ФайлОбмена, ТипОбъектаXDTO);
            
            ДанныеXDTO = ОбъектXDTOВСтруктуру(ОбъектXDTO);
            
            ИмяТипа = ТипОбъектаXDTO.Имя;
            Если ИмяТипа = "ГруппаДоступа" ИЛИ ИмяТипа = "ГруппаДоступаГруппа" Тогда
                ТипДляПротокола = "Группа доступа";
                КлючСчетчика = "ГруппыДоступа";
            ИначеЕсли ИмяТипа = "Профиль" ИЛИ ИмяТипа = "ПрофильГруппа" Тогда
                ТипДляПротокола = "Профиль";
                КлючСчетчика = "Профили";
            ИначеЕсли ИмяТипа = "ГруппаПользователей" Тогда
                ТипДляПротокола = "Группа пользователей";
                КлючСчетчика = "ГруппыПользователей";
            ИначеЕсли ИмяТипа = "Пользователь" Тогда
                ТипДляПротокола = "Пользователь";
                КлючСчетчика = "Пользователи";
            Иначе
                ТипДляПротокола = ИмяТипа;
                КлючСчетчика = "";
            КонецЕсли;
            
            ДанныеДляЗаписиВИБ = СтруктураОбъектаXDTOВДанныеИБ(ДанныеXDTO, ТипОбъектаXDTO.Имя, "КонвертироватьИЗаписать", Кэш);
                    
            Если ДанныеДляЗаписиВИБ = Неопределено Тогда
                НоваяСтрока = ТаблицаПротокола.Добавить();
                НоваяСтрока.ТипОбъекта   = ТипДляПротокола;
                НоваяСтрока.Наименование = ?(ДанныеXDTO.Свойство("Наименование"), ДанныеXDTO.Наименование, "");
                НоваяСтрока.Действие     = "Пропущен";
                НоваяСтрока.Ошибка       = "Не удалось определить данные для записи";
                Продолжить;  
            КонецЕсли;
			
			НоваяСтрокаОтладка = ТаблицаПротокола.Добавить();
			НоваяСтрокаОтладка.ТипОбъекта = "Отладка";
			НоваяСтрокаОтладка.Наименование = "Объект передан на запись: " + ДанныеДляЗаписиВИБ.Наименование;
			НоваяСтрокаОтладка.Действие = "тип: " + ТипОбъектаXDTO.Имя;
			НоваяСтрокаОтладка.Ошибка = "";
			
            Попытка
                БылНовым = ДанныеДляЗаписиВИБ.Ссылка.Пустая();
                ДанныеДляЗаписиВИБ.Записать();
                
                Если КлючСчетчика <> "" Тогда
                    Счетчик = Счетчики[КлючСчетчика];
                    Если БылНовым Тогда
                        Счетчик.Создано = Счетчик.Создано + 1;
                        Действие = "Создан";
                    Иначе
                        Счетчик.Обновлено = Счетчик.Обновлено + 1;
                        Действие = "Обновлен";
                    КонецЕсли;
                    
                    НоваяСтрока = ТаблицаПротокола.Добавить();
                    НоваяСтрока.ТипОбъекта   = ТипДляПротокола;
                    НоваяСтрока.Наименование = ДанныеДляЗаписиВИБ.Наименование;
                    НоваяСтрока.Действие     = Действие;
                    НоваяСтрока.Ошибка       = "";
                КонецЕсли;
                
            Исключение
                ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
                НоваяСтрока = ТаблицаПротокола.Добавить();
                НоваяСтрока.ТипОбъекта   = ТипДляПротокола;
                НоваяСтрока.Наименование = ДанныеДляЗаписиВИБ.Наименование;
                НоваяСтрока.Действие     = "Ошибка";
                НоваяСтрока.Ошибка       = ТекстОшибки;
            КонецПопытки;
            
        Исключение
            ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
            НоваяСтрока = ТаблицаПротокола.Добавить();
            НоваяСтрока.ТипОбъекта   = "Неизвестно";
            НоваяСтрока.Наименование = ЛокальноеИмя;
            НоваяСтрока.Действие     = "Ошибка чтения XML";
            НоваяСтрока.Ошибка       = ТекстОшибки;
        КонецПопытки;
        
    КонецЦикла;
    
    Если КоличествоЭлементов = 0 Тогда
        НоваяСтрока = ТаблицаПротокола.Добавить();
        НоваяСтрока.ТипОбъекта = "Информация";
        НоваяСтрока.Наименование = "Не найдено ни одного элемента данных в XML";
        НоваяСтрока.Действие = "Предупреждение";
        НоваяСтрока.Ошибка = "";
    КонецЕсли;
    
КонецПроцедуры



// Преобразует строковое представление УИД в ссылку на объект текущей информационной базы.
// Сначала выполняется поиск УИД в регистре публичных идентификаторов.
// При удачном поиске возвращается ссылка из регистра, при неудачном
// возвращается либо ссылка с исходным УИД (если она еще не сопоставлена),
// либо выполняется генерация новой ссылки со случайным УИД.
// И в том и в другом случае в регистре публичных идентификаторов создается запись.
// 
// Параметры:
//  Наименование - Строка - наименование объекта информационной базы, ссылку на который нужно получить.
//  ЛокальноеИмя - Строка - локальное имя типа объекта XDTO ("ГруппаДоступа" и т.п.).
//
// Возвращаемое значение:
//   ЛюбаяСсылка - ссылка на объект информационной базы.
// 
Функция СсылкаОбъектаПоНаименованию(Наименование, ЛокальноеИмя) Экспорт
    
    УстановитьПривилегированныйРежим(Истина);
    
    Если ЛокальноеИмя = "ГруппаДоступа" Тогда
        СсылкаГруппаДоступа = Справочники.ГруппыДоступа.НайтиПоНаименованию(Наименование, Истина);
        Если Не ЗначениеЗаполнено(СсылкаГруппаДоступа) Тогда 
            СсылкаПоНаименованию = Новый УникальныйИдентификатор;
        Иначе 
            СсылкаПоНаименованию = СсылкаГруппаДоступа.УникальныйИдентификатор();
        КонецЕсли;
    КонецЕсли;
    
    // Найдена ссылка по УИД или создана новая ссылка.
    Возврат СсылкаПоНаименованию;
    
КонецФункции

Функция ГруппаДоступаПоНаименованию(НаименованиеГруппы, ИскатьГруппу = Ложь, Кэш = Неопределено)

    Возврат НайтиВКэшеПоНаименованию(Кэш, "Группа", НаименованиеГруппы, ИскатьГруппу);
    
КонецФункции

Функция ПрофильПоНаименованию(НаименованиеПрофиля, ИскатьГруппу = Ложь, Кэш = Неопределено)

    Возврат НайтиВКэшеПоНаименованию(Кэш, "Профиль", НаименованиеПрофиля, ИскатьГруппу);
    
КонецФункции

Функция СтруктураОбъектаXDTOВДанныеИБ(ДанныеXDTO, ЛокальноеИмя, Действие = "КонвертироватьИЗаписать", Кэш = Неопределено) Экспорт
   ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
    "СтруктураОбъектаXDTOВДанныеИБ: " + ЛокальноеИмя + " '" + ?(ДанныеXDTO.Свойство("Наименование"), ДанныеXDTO.Наименование, "") + "'"); 
    ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
        "СтруктураОбъектаXDTOВДанныеИБ: начало обработки " + ЛокальноеИмя + " '" + ?(ДанныеXDTO.Свойство("Наименование"), ДанныеXDTO.Наименование, "") + "'");
    
    ПолученныеДанные = ИнициализироватьПолученныеДанные(ДанныеXDTO, ЛокальноеИмя);

    
    Если Кэш = Неопределено Тогда
        ВызватьИсключение НСтр("ru = 'ТБ_ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ: не передан кэш поиска по наименованию.'");
    КонецЕсли;
        
    Если ЛокальноеИмя = "ГруппаДоступа" Тогда
        СсылкаГруппаДоступа = ГруппаДоступаПоНаименованию(ДанныеXDTO.Наименование, Ложь, Кэш);
        Если ЗначениеЗаполнено(СсылкаГруппаДоступа) Тогда 
            ПолученныеДанные = СсылкаГруппаДоступа.ПолучитьОбъект();
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Найден существующий объект ГруппаДоступа: " + ДанныеXDTO.Наименование);
        Иначе 
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Создание нового объекта ГруппаДоступа: " + ДанныеXDTO.Наименование);
        КонецЕсли; 
    ИначеЕсли ЛокальноеИмя = "Профиль" Тогда  
        СсылкаПрофиль = ПрофильПоНаименованию(ДанныеXDTO.Наименование, Ложь, Кэш);
        Если ЗначениеЗаполнено(СсылкаПрофиль) Тогда 
            ПолученныеДанные = СсылкаПрофиль.ПолучитьОбъект();
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Найден существующий объект Профиль: " + ДанныеXDTO.Наименование);
        Иначе 
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Создание нового объекта Профиль: " + ДанныеXDTO.Наименование);
        КонецЕсли; 
    ИначеЕсли ЛокальноеИмя = "ГруппаДоступаГруппа" Тогда  
        СсылкаГруппаДоступаГруппа = ГруппаДоступаПоНаименованию(ДанныеXDTO.Наименование, Истина);
        Если ЗначениеЗаполнено(СсылкаГруппаДоступаГруппа) Тогда 
            ПолученныеДанные = СсылкаГруппаДоступаГруппа.ПолучитьОбъект();
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Найдена существующая группа ГруппаДоступа: " + ДанныеXDTO.Наименование);
        Иначе 
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Создание новой группы ГруппаДоступа: " + ДанныеXDTO.Наименование);
        КонецЕсли; 
    ИначеЕсли ЛокальноеИмя = "ПрофильГруппа" Тогда  
        СсылкаПрофильГруппа = ПрофильПоНаименованию(ДанныеXDTO.Наименование, Истина, Кэш);
        Если ЗначениеЗаполнено(СсылкаПрофильГруппа) Тогда 
            ПолученныеДанные = СсылкаПрофильГруппа.ПолучитьОбъект();
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Найдена существующая группа Профиль: " + ДанныеXDTO.Наименование);
        Иначе 
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Создание новой группы Профиль: " + ДанныеXDTO.Наименование);
        КонецЕсли;
    ИначеЕсли ЛокальноеИмя = "ГруппаПользователей" Тогда
        СсылкаГруппаПользователей = Справочники.ГруппыПользователей.НайтиПоНаименованию(ДанныеXDTO.Наименование, Истина);
        Если ЗначениеЗаполнено(СсылкаГруппаПользователей) Тогда
            ПолученныеДанные = СсылкаГруппаПользователей.ПолучитьОбъект();
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Найдена существующая ГруппаПользователей: " + ДанныеXDTO.Наименование);
        Иначе
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Создание новой ГруппыПользователей: " + ДанныеXDTO.Наименование);
        КонецЕсли;
    ИначеЕсли ЛокальноеИмя = "Пользователь" Тогда
        СсылкаПользователь = Справочники.Пользователи.НайтиПоНаименованию(ДанныеXDTO.Наименование);
        Если ЗначениеЗаполнено(СсылкаПользователь) Тогда
            ПолученныеДанные = СсылкаПользователь.ПолучитьОбъект();
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Найден существующий Пользователь: " + ДанныеXDTO.Наименование);
        Иначе
            ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
                "Создание нового Пользователя: " + ДанныеXDTO.Наименование);
        КонецЕсли;
    КонецЕсли;

        КонвертацияСвойствСтруктурыОбъектаXDTO(
        ДанныеXDTO,
        ПолученныеДанные,
        ЛокальноеИмя,
        Кэш);

    Возврат ПолученныеДанные;
    
КонецФункции

Функция ИнициализироватьПолученныеДанные(ДанныеXDTO, ЛокальноеИмя)
    
    ПолученныеДанные = Неопределено;
    
    Если ЛокальноеИмя = "ГруппаДоступа" Тогда
        ПолученныеДанные = Справочники.ГруппыДоступа.СоздатьЭлемент();
    ИначеЕсли ЛокальноеИмя = "ГруппаДоступаГруппа" Тогда
        ПолученныеДанные = Справочники.ГруппыДоступа.СоздатьГруппу();
    ИначеЕсли ЛокальноеИмя = "ПрофильГруппа" Тогда
        ПолученныеДанные = Справочники.ПрофилиГруппДоступа.СоздатьГруппу();
    ИначеЕсли ЛокальноеИмя = "Профиль" Тогда
        ПолученныеДанные = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
    ИначеЕсли ЛокальноеИмя = "ГруппаПользователей" Тогда
        ПолученныеДанные = Справочники.ГруппыПользователей.СоздатьЭлемент();   // ИСПРАВЛЕНО: не группа
    ИначеЕсли ЛокальноеИмя = "Пользователь" Тогда
        ПолученныеДанные = Справочники.Пользователи.СоздатьЭлемент();    
    КонецЕсли;
    
    Возврат ПолученныеДанные;
    
КонецФункции

Процедура КонвертацияСвойствСтруктурыОбъектаXDTO(
        ДанныеXDTO,
        ПолученныеДанные,
        ЛокальноеИмя,
        Кэш = Неопределено)
    
    ЗаписьЖурналаРегистрации("Отладка.ЗагрузкаПрав", УровеньЖурналаРегистрации.Примечание,
        "КонвертацияСвойствСтруктурыОбъектаXDTO: " + ЛокальноеИмя + " '" + ?(ДанныеXDTO.Свойство("Наименование"), ДанныеXDTO.Наименование, "") + "'");
    
    Если ЛокальноеИмя = "ГруппаДоступа" Тогда    
        
        ПолученныеДанные.ЗначенияДоступа.Очистить();
        Для Каждого СтрокаЗначенийДоступа Из ДанныеXDTO.ЗначенияДоступа Цикл   
            НоваяСтрокаЗначениеДоступа = ПолученныеДанные.ЗначенияДоступа.Добавить();
            Если СтрокаЗначенийДоступа.ВидДоступа = "Организация" Тогда
                НоваяСтрокаЗначениеДоступа.ВидДоступа = Справочники.Организации.ПустаяСсылка();    
                НоваяСтрокаЗначениеДоступа.ВключаяНижестоящие = СтрокаЗначенийДоступа.ВключаяНижестоящие; 
            ИначеЕсли СтрокаЗначенийДоступа.ВидДоступа = "Пользователь" Тогда
                НоваяСтрокаЗначениеДоступа.ВидДоступа = Справочники.Пользователи.ПустаяСсылка();    
                НоваяСтрокаЗначениеДоступа.ВключаяНижестоящие = СтрокаЗначенийДоступа.ВключаяНижестоящие;  
            ИначеЕсли СтрокаЗначенийДоступа.ВидДоступа = "Хозяйственные операции" Тогда  
                НоваяСтрокаЗначениеДоступа.ВидДоступа = Перечисления.ХозяйственныеОперации.ПустаяСсылка();    
                НоваяСтрокаЗначениеДоступа.ВключаяНижестоящие = СтрокаЗначенийДоступа.ВключаяНижестоящие;  
                Если ЗначениеЗаполнено(СтрокаЗначенийДоступа.ЗначениеДоступа) Тогда
                    НоваяСтрокаЗначениеДоступа.ЗначениеДоступа = Перечисления.ХозяйственныеОперации[СтрокаЗначенийДоступа.ЗначениеДоступа];
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        
        ПолученныеДанные.Наименование = ДанныеXDTO.Наименование; 
        
        Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(ДанныеXDTO.Профиль, Истина);   
        
        Если ЗначениеЗаполнено(Профиль) Тогда
            ПолученныеДанные.Профиль = Профиль;
        Иначе 
            ПрофильОбъект = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
            ПрофильОбъект.Наименование = ДанныеXDTO.Профиль;
            ПрофильОбъект.Записать();
            ОбновитьКэшПоОбъекту(ПрофильОбъект, Кэш);
            ПолученныеДанные.Профиль = ПрофильОбъект.Ссылка;
        КонецЕсли;
        
        Если ДанныеXDTO.Свойство("Родитель") Тогда
            Родитель = ГруппаДоступаПоНаименованию(ДанныеXDTO.Родитель, Истина, Кэш);
            Если ЗначениеЗаполнено(Родитель) И Родитель.ЭтоГруппа Тогда
                ПолученныеДанные.Родитель = Родитель;
            Иначе 
                РодительОбъект = Справочники.ГруппыДоступа.СоздатьГруппу();
                РодительОбъект.Наименование = ДанныеXDTO.Родитель;    
                РодительОбъект.Записать();
                ОбновитьКэшПоОбъекту(РодительОбъект, Кэш);
                ПолученныеДанные.Родитель = РодительОбъект.Ссылка;
            КонецЕсли;
            
        КонецЕсли;   
        
        ПолученныеДанные.ПометкаУдаления = Ложь;
        
        Если ДанныеXDTO.Свойство("ВидыДоступа") Тогда  
            
            ПолученныеДанные.ВидыДоступа.Очистить();
            
            Для Каждого СтрокаЗначенийДоступа Из ДанныеXDTO.ВидыДоступа Цикл   
                НоваяСтрокаЗначениеДоступа = ПолученныеДанные.ВидыДоступа.Добавить();
                Если СтрокаЗначенийДоступа.ВидДоступа = "Организация" Тогда
                    НоваяСтрокаЗначениеДоступа.ВидДоступа = Справочники.Организации.ПустаяСсылка();    
                    НоваяСтрокаЗначениеДоступа.ВсеРазрешены = СтрокаЗначенийДоступа.ВсеРазрешены; 
                ИначеЕсли СтрокаЗначенийДоступа.ВидДоступа = "Пользователь" Тогда
