////////////////////////////////////////////////////////////////////////////////
// Версии подсистем расширения «Доработки_ГКС_К».
//
// Единая точка, где указаны версии подсистем. При выпуске изменения подсистемы:
//   1) поднять версию этой подсистемы (major.minor.patch) в функции ниже;
//   2) поднять версию расширения в Configuration.mdo:
//      major расширения . major подсистем . minor подсистем . patch подсистем.
//
// Схема версии расширения:
//   X — major расширения (меняется только по явному решению);
//   Y — major подсистем: +1 при major-изменении (Z, W сбрасываются в 0);
//   Z — minor подсистем: +1 при minor-изменении (W сбрасывается в 0);
//   W — patch подсистем: +1 при patch-изменении.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает версию подсистемы ГКСИ (инструкции и описания демонстраций).
//
// Возвращаемое значение:
//  Строка - версия подсистемы в формате "major.minor.patch".
//
Функция ВерсияГКСИ() Экспорт
	Возврат "2.46.20";
КонецФункции

// Возвращает версию подсистемы ППГД (права, профили и группы доступа).
//
// Возвращаемое значение:
//  Строка - версия подсистемы в формате "major.minor.patch".
//
Функция ВерсияППГД() Экспорт
	Возврат "1.20.3";
КонецФункции

// Возвращает версию подсистемы ВерсииОбъектов (просмотр и переход по версиям объектов).
//
// Возвращаемое значение:
//  Строка - версия подсистемы в формате "major.minor.patch".
//
Функция ВерсияВерсииОбъектов() Экспорт
	Возврат "1.3.4";
КонецФункции

// Возвращает версию подсистемы ШаблоныНаименований (конструктор шаблонов наименований номенклатуры).
//
// Возвращаемое значение:
//  Строка - версия подсистемы в формате "major.minor.patch".
//
Функция ВерсияШаблоновНаименований() Экспорт
	Возврат "1.0.0";
КонецФункции

// Возвращает версию расширения «Доработки_ГКС_К».
//
// Возвращаемое значение:
//  Строка - версия расширения в формате "X.Y.Z.W".
//
Функция ВерсияРасширения() Экспорт
	
	Отбор = Новый Структура("Имя", ИмяРасширения());
	Расширения = РасширенияКонфигурации.Получить(Отбор);
	
	Если Расширения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Расширения[0].Версия;
	
КонецФункции

// Возвращает версии расширения и его подсистем одной структурой.
//
// Возвращаемое значение:
//  Структура - ключи:
//   * ВерсияРасширения - Строка - версия расширения;
//   * ВерсияГКСИ - Строка - версия подсистемы ГКСИ;
//   * ВерсияППГД - Строка - версия подсистемы ППГД;
//   * ВерсияВерсииОбъектов - Строка - версия подсистемы ВерсииОбъектов;
//   * ВерсияШаблоновНаименований - Строка - версия подсистемы ШаблоныНаименований.
//
Функция Версии() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ВерсияРасширения", ВерсияРасширения());
	Результат.Вставить("ВерсияГКСИ", ВерсияГКСИ());
	Результат.Вставить("ВерсияППГД", ВерсияППГД());
	Результат.Вставить("ВерсияВерсииОбъектов", ВерсияВерсииОбъектов());
	Результат.Вставить("ВерсияШаблоновНаименований", ВерсияШаблоновНаименований());
	
	Возврат Результат;
	
КонецФункции

// Выводит в окно сообщений версию расширения и версии его подсистем.
//
Процедура ПоказатьВерсии() Экспорт
	
	ТекстСообщения = "Версия расширения «Доработки_ГКС_К»: " + ВерсияРасширения() + Символы.ПС
		+ "Подсистема ГКСИ: " + ВерсияГКСИ() + Символы.ПС
		+ "Подсистема ППГД: " + ВерсияППГД() + Символы.ПС
		+ "Подсистема ВерсииОбъектов: " + ВерсияВерсииОбъектов() + Символы.ПС
		+ "Подсистема ШаблоныНаименований: " + ВерсияШаблоновНаименований();
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя расширения «Доработки_ГКС_К».
//
// Возвращаемое значение:
//  Строка - имя расширения.
//
Функция ИмяРасширения()
	Возврат "Доработки_ГКС_К";
КонецФункции

#КонецОбласти
