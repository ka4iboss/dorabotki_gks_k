// Общий модуль ГКСИ_ЗагрузкаСценариевИзMarkdown.
//
// Серверная логика загрузки иерархии групп и элементов справочника
// ДемонстрационныеСценарии из Markdown-файла.
//
// Формат входного файла:
//   * строки вида "# Заголовок" / "## Подзаголовок" / "### Подуровень"
//     задают иерархию групп справочника (1, 2, 3 уровни соответственно);
//   * текст под заголовком (до следующего заголовка того же или большего
//     уровня) становится Markdown-описанием элемента/группы;
//   * файл трактуется как одноязычный (по умолчанию "ru").
//
// Все записи проходят через расширение: записи РС ГКСИ_ГруппыСценариев,
// типовое поле "Родитель" обнуляется в ГКСИ_ПередЗаписью, присоединённые
// HTML-файлы создаются через типовое API РаботаСФайлами.

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает Markdown-файл и возвращает дерево узлов.
// Структура результата:
//   * Корневой узел дерева — служебная группа-обёртка с именем файла
//     (без расширения и без пути). Всегда трактуется как группа.
//   * Внутри обёртки — узлы, соответствующие заголовкам пользователя:
//     "# ..." -> 2 уровень в дереве, "## ..." -> 3, "### ..." -> 4.
//   * Правило "группа/элемент" определяется в ОбработатьУзелРекурсивно:
//     самый глубокий заголовок (без потомков) становится элементом,
//     все остальные — группами.
//
// Параметры:
//  АдресФайлаВоВременномХранилище - Строка - адрес двоичных данных
//                          Markdown-файла во временном хранилище.
//  ИмяФайла                    - Строка - полное имя файла (с путём и расширением).
//                          Используется для имени корневой группы-обёртки.
//
// Возвращаемое значение:
//  ДеревоЗначений.
//
Функция РазобратьMarkdownВДерево(АдресФайлаВоВременномХранилище, ИмяФайла = "") Экспорт

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Уровень",       Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(1, 0)));
	Дерево.Колонки.Добавить("Наименование",  Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(150)));
	Дерево.Колонки.Добавить("ТекстMarkdown", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(0)));
	Дерево.Колонки.Добавить("Порядок",       Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(5, 0)));

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Дерево;
	КонецЕсли;

	ТекстФайла = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Если НЕ ЗначениеЗаполнено(ТекстФайла) Тогда
		Возврат Дерево;
	КонецЕсли;

	// Корневая группа-обёртка с именем файла.
	ИмяКорневойГруппы = ИмяФайлаБезРасширения(ИмяФайла);
	Если НЕ ЗначениеЗаполнено(ИмяКорневойГруппы) Тогда
		ИмяКорневойГруппы = НСтр("ru = 'Импортированные сценарии'");
	КонецЕсли;
	Корень = Дерево.Строки.Добавить();
	Корень.Уровень       = 1;
	Корень.Наименование  = ИмяКорневойГруппы;
	Корень.ТекстMarkdown = "";
	Корень.Порядок       = 1;

	МассивСтрок = СтрРазделить(ТекстФайла, Символы.ПС, Истина);

	// Стек текущих узлов: индекс элемента = уровень - 1.
	// Корень (уровень 1) уже лежит в стеке.
	СтекУзлов = Новый Массив;
	СтекУзлов.Добавить(Корень);

	МаксимальныйУровень = 4;

	Для Каждого ИсходнаяСтрока Из МассивСтрок Цикл

		// Убираем \r (на случай CRLF) — иначе он попадёт в текст.
		ОбработаннаяСтрока = СтрЗаменить(ИсходнаяСтрока, Символы.ВК, "");

		Уровень   = 0;
		Наименование = "";

		// Распознаём заголовок вида "# ...", "## ...", "### ..." по началу строки.
		Если СтрНачинаетсяС(ОбработаннаяСтрока, "#") Тогда
			ДлинаСтроки = СтрДлина(ОбработаннаяСтрока);
			ПозицияХеша = 1;
			Пока ПозицияХеша <= Мин(ДлинаСтроки, 3)
					И Сред(ОбработаннаяСтрока, ПозицияХеша, 1) = "#" Цикл
				ПозицияХеша = ПозицияХеша + 1;
			КонецЦикла;
			Уровень = ПозицияХеша - 1 + 1; // +1 для учёта корневой обёртки
			Если Уровень >= 2 И Уровень <= МаксимальныйУровень
					И ПозицияХеша <= ДлинаСтроки
					И Сред(ОбработаннаяСтрока, ПозицияХеша, 1) = " " Тогда
				Наименование = СокрЛП(Сред(ОбработаннаяСтрока, ПозицияХеша + 1));
			Иначе
				Уровень = 0;
			КонецЕсли;
		КонецЕсли;

		Если Уровень >= 2 И ЗначениеЗаполнено(Наименование) Тогда

			// Подняться по стеку до родителя нужного уровня.
			// В стеке: индекс 0 = уровень 1, индекс 1 = уровень 2 и т.д.
			// Для заголовка уровня N родитель — это стек[N-2].
			Пока СтекУзлов.Количество() > (Уровень - 1) Цикл
				СтекУзлов.Удалить(СтекУзлов.Количество() - 1);
			КонецЦикла;

			ТекущийРодитель = СтекУзлов[СтекУзлов.Количество() - 1];

			// Найти существующего ребёнка или создать нового.
			НоваяСтрока = Неопределено;
			Для Каждого Дочерний Из ТекущийРодитель.Строки Цикл
				Если Дочерний.Наименование = Наименование Тогда
					НоваяСтрока = Дочерний;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если НоваяСтрока = Неопределено Тогда
				НоваяСтрока = ТекущийРодитель.Строки.Добавить();
				НоваяСтрока.Уровень       = Уровень;
				НоваяСтрока.Наименование  = Наименование;
				НоваяСтрока.ТекстMarkdown = "";
				НоваяСтрока.Порядок       = ТекущийРодитель.Строки.Количество();
			КонецЕсли;

			СтекУзлов.Добавить(НоваяСтрока);

			Продолжить;
		КонецЕсли;

		// Обычная строка — добавить в текст текущего открытого узла (вершина стека).
		ТекущийУзел = СтекУзлов[СтекУзлов.Количество() - 1];

		Если ТекущийУзел.ТекстMarkdown = "" Тогда
			ТекущийУзел.ТекстMarkdown = ОбработаннаяСтрока;
		Иначе
			ТекущийУзел.ТекстMarkdown = ТекущийУзел.ТекстMarkdown
				+ Символы.ПС + ОбработаннаяСтрока;
		КонецЕсли;

	КонецЦикла;

	Возврат Дерево;

КонецФункции

// Ищет существующие элементы/группы справочника ДемонстрационныеСценарии
// по списку наименований. Возвращает соответствие Имя -> Ссылка.
//
// Параметры:
//  МассивНаименований - Массив из Строка.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Ключ: Строка (Наименование), Значение: Массив из Структура
//   со полями Ссылка, ЭтоГруппа, ИнструкцияИсточник.
//
Функция НайтиСуществующихПоИмени(МассивНаименований) Экспорт

	Результат = Новый Соответствие;
	Если МассивНаименований.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДемонстрационныеСценарии.Ссылка КАК Ссылка,
	|	ДемонстрационныеСценарии.Наименование КАК Наименование,
	|	ДемонстрационныеСценарии.ЭтоГруппа КАК ЭтоГруппа,
	|	ДемонстрационныеСценарии.ГКСИ_ИнструкцияИсточник КАК ИнструкцияИсточник
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
	|ГДЕ
	|	ДемонстрационныеСценарии.Наименование В (&МассивНаименований)
	|	И НЕ ДемонстрационныеСценарии.ПометкаУдаления";

	Запрос.УстановитьПараметр("МассивНаименований", МассивНаименований);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = Выборка.Наименование;
		МассивСсылок = Результат.Получить(Имя);
		Если МассивСсылок = Неопределено Тогда
			МассивСсылок = Новый Массив;
			Результат.Вставить(Имя, МассивСсылок);
		КонецЕсли;
		МассивСсылок.Добавить(Новый Структура("Ссылка, ЭтоГруппа, ИнструкцияИсточник",
			Выборка.Ссылка, Выборка.ЭтоГруппа, Выборка.ИнструкцияИсточник));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает SHA-256 от двоичных данных в виде hex-строки (64 символа).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные.
//
// Возвращаемое значение:
//  Строка - hex-представление хеша.
//
Функция ВычислитьSHA256(ДвоичныеДанные) Экспорт

	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ХешОбъект = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешОбъект.Добавить(ДвоичныеДанные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешОбъект.ХешСумма));

КонецФункции

// Ищет существующий элемент справочника ГКСИ_ФайлыИнструкций по хешу SHA-256.
// Используется для дедупликации картинок при импорте.
//
// Параметры:
//  Хеш - Строка - hex-представление SHA-256.
//
// Возвращаемое значение:
//  Строка - код (GUID) найденного элемента, или пустая строка, если не найден.
//
Функция НайтиСуществующийФайлПоХешу(Хеш) Экспорт

	Если НЕ ЗначениеЗаполнено(Хеш) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ГКСИ_ФайлыИнструкций.Код КАК Код
	|ИЗ
	|	Справочник.ГКСИ_ФайлыИнструкций КАК ГКСИ_ФайлыИнструкций
	|ГДЕ
	|	ГКСИ_ФайлыИнструкций.ХешSHA256 = &Хеш
	|	И НЕ ГКСИ_ФайлыИнструкций.ПометкаУдаления";
	Запрос.УстановитьПараметр("Хеш", Хеш);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Код;
	КонецЕсли;

	Возврат "";

КонецФункции

// Находит все файлы в каталоге и подкаталогах по маске.
//
// Параметры:
//  ИмяКаталога - Строка - путь к каталогу.
//  Маска        - Строка - маска поиска (например, "*.png").
//
// Возвращаемое значение:
//  Массив из Файл - найденные файлы.
//
Функция НайтиФайлыВКаталоге(ИмяКаталога, Маска) Экспорт

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(ИмяКаталога) ИЛИ НЕ ЗначениеЗаполнено(Маска) Тогда
		Возврат Результат;
	КонецЕсли;

	НайденныеФайлы = НайтиФайлы(ИмяКаталога, Маска, Истина);
	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Допустимые расширения файлов картинок (в нижнем регистре, с ведущей точкой).
// Используются для фильтрации при построении индекса каталога и для нормализации
// пользовательских имён в ПодменитьСсылкиНаКартинкиВТексте.
//
Функция РасширенияКартинок()
	Результат = Новый Массив;
	Результат.Добавить(".png");
	Результат.Добавить(".jpg");
	Результат.Добавить(".jpeg");
	Результат.Добавить(".gif");
	Результат.Добавить(".webp");
	Результат.Добавить(".bmp");
	Результат.Добавить(".svg");
	Возврат Результат;
КонецФункции

// Проверяет, что переданное расширение (с точкой, в любом регистре) является
// расширением файла картинки из поддерживаемого списка.
//
Функция ЭтоРасширениеКартинки(Расширение)
	Если НЕ ЗначениеЗаполнено(Расширение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Нормализованное = НРег(Расширение);
	Для Каждого Элемент Из РасширенияКартинок() Цикл
		Если Элемент = Нормализованное Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Строит индекс файлов-картинок в каталоге и подкаталогах за один рекурсивный
// обход диска. Используется в ПодготовитьКартинкиДляДерева вместо серии
// повторных вызовов НайтиФайлы по маске *.png и т.п., что на больших каталогах
// давало сложность O(n × m).
//
// Параметры:
//  КаталогПоиска - Строка - путь к каталогу на диске сервера.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Ключ: Строка (имя файла в нижнем регистре),
//                  Значение: Строка (полное имя файла на диске).
//
Функция ИндексФайловКаталогаКартинок(КаталогПоиска) Экспорт

	Индекс = Новый Соответствие;

	Если НЕ ЗначениеЗаполнено(КаталогПоиска) Тогда
		Возврат Индекс;
	КонецЕсли;

	Попытка
		// Один рекурсивный обход всего каталога (по маске "*") — намного быстрее,
		// чем для каждой уникальной картинки вызывать НайтиФайлы по её маске.
		НайденныеФайлы = НайтиФайлы(КаталогПоиска, "*", Истина);
	Исключение
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось построить индекс каталога картинок: " + КаталогПоиска
			+ Символы.ПС + ОписаниеОшибки());
		Возврат Индекс;
	КонецПопытки;

	Для Каждого Файл Из НайденныеФайлы Цикл
		Если Файл.ЭтоФайл() Тогда
			ИмяФайлаВНижРегистре = НРег(Файл.Имя);
			Если ЭтоРасширениеКартинки(
				Сред(ИмяФайлаВНижРегистре,
					СтрНайти(ИмяФайлаВНижРегистре, ".", НаправлениеПоиска.СКонца))) Тогда
				Индекс.Вставить(ИмяФайлаВНижРегистре, Файл.ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Заменяет в тексте Markdown ссылки на картинки формата Obsidian ![[path]]
// на стандартный ![] (КОД). Загружает картинки в справочник
// ГКСИ_ФайлыИнструкций с дедупликацией по SHA-256. Битые ссылки помечает
// как "❌ <path>" в тексте и пишет предупреждение в журнал регистрации.
//
// Параметры:
//  ТекстMarkdown - Строка - исходный текст сценария.
//  КаталогПоиска - Строка - каталог, относительно которого ищутся картинки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - с ключами:
//   * НовыйТекст  - Строка - текст после подмены.
//   * КартаПодмен - Соответствие из КлючИЗначение - ОригинальныйПуть - КодФайла.
//                     Для битых ссылок значение - пустая строка.
//
Функция ЗагрузитьКартинкиИзТекста(ТекстMarkdown, КаталогПоиска) Экспорт

	Результат = Новый Соответствие;
	Результат.Вставить("НовыйТекст",  ТекстMarkdown);
	Результат.Вставить("КартаПодмен", Новый Соответствие);

	Если НЕ ЗначениеЗаполнено(ТекстMarkdown) Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КаталогПоиска) Тогда
		Возврат Результат;
	КонецЕсли;

	УникальныеПути = УникальныеПутиКартинокИзТекста(ТекстMarkdown);
	Если УникальныеПути.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	КартаПодмен = ПодготовитьКартуПодменКартинок(УникальныеПути, КаталогПоиска);

	НовыйТекст = ТекстMarkdown;
	Для Каждого КИЗ Из КартаПодмен Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		КодФайла         = КИЗ.Значение;

		Если ЗначениеЗаполнено(КодФайла) Тогда
			НовыйТекст = СтрЗаменить(НовыйТекст,
				"![" + "[" + ОригинальныйПуть + "]" + "]",
				"![](" + КодФайла + ")");
		Иначе
			НовыйТекст = СтрЗаменить(НовыйТекст,
				"![" + "[" + ОригинальныйПуть + "]" + "]",
				"❌ " + ОригинальныйПуть);
		КонецЕсли;

	КонецЦикла;

	Результат.Вставить("НовыйТекст",  НовыйТекст);
	Результат.Вставить("КартаПодмен", КартаПодмен);

	Возврат Результат;

КонецФункции

// Собирает уникальные пути картинок из ![[...]] вхождений в тексте.
//
// Параметры:
//  ТекстMarkdown - Строка.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Ключ: Строка (путь), Значение: Истина.
//
Функция УникальныеПутиКартинокИзТекста(ТекстMarkdown) Экспорт

	УникальныеПути = Новый Соответствие;

	// Obsidian-синтаксис: ![[path]] и ![[path|extra]]
	// ([^\]|]+) — чистый путь до | или до закрытия
	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
		ТекстMarkdown, "!\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", Истина);
	Для Каждого Совпадение Из Совпадения Цикл
		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() > 0 И Группы[0] <> Неопределено
			И Группы[0].Значение <> Неопределено Тогда
			УникальныеПути.Вставить(Группы[0].Значение, Истина);
		КонецЕсли;
	КонецЦикла;

	// Стандартный markdown: ![alt](path)
	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
		ТекстMarkdown, "!\[[^\]]*\]\(([^)]+)\)", Истина);
	Для Каждого Совпадение Из Совпадения Цикл
		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() > 0 И Группы[0] <> Неопределено
			И Группы[0].Значение <> Неопределено Тогда
			Путь = Группы[0].Значение;
			// Защита от повторной вставки, если тот же путь уже был в Obsidian-варианте
			Если УникальныеПути.Получить(Путь) = Неопределено Тогда
				УникальныеПути.Вставить(Путь, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат УникальныеПути;

КонецФункции

// Загружает картинки в справочник ГКСИ_ФайлыИнструкций и возвращает
// карту Соответствие "ОригинальныйПуть" -> "КодФайла". Без запросов к БД
// внутри циклов: дедупликация - одним пакетным запросом, создание -
// вне цикла.
//
// Параметры:
//  УникальныеПути - Соответствие из КлючИЗначение - Ключ: Строка (путь из ![[...]]).
//  КаталогПоиска  - Строка - каталог, относительно которого ищем.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Ключ: Строка (путь), Значение: Строка (код-GUID файла
//                  инструкции или пустая строка, если файл не найден).
//
Функция ПодготовитьКартуПодменКартинок(УникальныеПути, КаталогПоиска) Экспорт

	КартаПодмен = Новый Соответствие;

	// Шаг 1. Поиск файлов и подсчёт хешей (без БД).
	СоответствиеПутьХеш = Новый Соответствие;
	МассивХешей = Новый Массив;
	Для Каждого КИЗ Из УникальныеПути Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		РезультатПоиска = НайтиКартинкуНаДискеИПосчитатьХеш(ОригинальныйПуть, КаталогПоиска);

		Если РезультатПоиска.Найден Тогда
			СоответствиеПутьХеш.Вставить(ОригинальныйПуть, РезультатПоиска);
			МассивХешей.Добавить(РезультатПоиска.Хеш);
		Иначе
			КартаПодмен.Вставить(ОригинальныйПуть, "");
		КонецЕсли;

	КонецЦикла;

	// Шаг 2. Один запрос на дедупликацию.
	СоответствиеХешКод = ХешиСуществующихФайлов(МассивХешей);

	// Шаг 3. Создание недостающих элементов (вне цикла).
	Для Каждого КИЗ Из СоответствиеПутьХеш Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		РезультатПоиска  = КИЗ.Значение;
		Хеш = РезультатПоиска.Хеш;

		КодФайла = СоответствиеХешКод.Получить(Хеш);
		Если НЕ ЗначениеЗаполнено(КодФайла) Тогда
			КодФайла = СоздатьЭлементФайлаИнструкции(
				РезультатПоиска.ИмяФайла, РезультатПоиска.ДвоичныеДанные, Хеш);
			СоответствиеХешКод.Вставить(Хеш, КодФайла);
		КонецЕсли;

		КартаПодмен.Вставить(ОригинальныйПуть, КодФайла);

	КонецЦикла;

	Возврат КартаПодмен;

КонецФункции

// Записывает дерево сценариев в справочник ДемонстрационныеСценарии.
//
// Параметры:
//  ДеревоУзлов                         - ДеревоЗначений - дерево узлов,
//                                         полученное РазобратьMarkdownВДерево.
//  КодЯзыка                            - Строка - код языка для HTML-файлов.
//  РешенияПоКонфликтам                 - Соответствие из КлючИЗначение -
//                                         ключ: ИмяИзФайла, значение: {Действие, Ссылка}.
//  КаталогПоиска                       - Строка - путь к каталогу с картинками
//                                         на диске сервера (для сценария
//                                         «выбрать каталог»). Используется
//                                         как фолбэк, если КартаПодменКартинок
//                                         не передана.
//  АдресаКартинокВоВременномХранилище  - Соответствие из КлючИЗначение -
//                                         Ключ: ИмяФайла, Значение: адрес ВХ.
//                                         Используется, если КартаПодменКартинок
//                                         не передана.
//  АдресПрогресса                      - Строка - адрес ВХ прогресса
//                                         (см. ИнициализироватьПрогресс).
//  АдресРезультатаЗагрузки             - Строка - адрес ВХ для таблицы результата.
//  КартаПодменКартинок                 - Соответствие из КлючИЗначение -
//                                         необязательный. Ключ: ОригинальныйПуть,
//                                         Значение: КодФайла. Если задан -
//                                         карта используется «как есть», без
//                                         обращения к диску/ВХ и без
//                                         создания элементов (готовый результат
//                                         ПодготовитьФайлыИнструкций).
//  ИнструкцияИсточник                   - СправочникСсылка.ДемонстрационныеСценарии -
//                                         необязательный. Явно переданный корень-инструкция
//                                         из формы обработки. Имеет приоритет над автоопределением
//                                         по первому #-заголовку MD-файла. Используется, когда
//                                         #-заголовок файла - это промежуточная группа
//                                         (например "Согласование ТКП"), а настоящая корневая
//                                         инструкция задаётся оператором.
//                                         Если Неопределено или пустая ссылка - используется
//                                         fallback (первый #-заголовок, как раньше).
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Наименование - Строка
//   * Действие     - Строка - "Создан", "Обновлён", "Пропущен", "Дублирован", "Ошибка"
//   * Ссылка       - СправочникСсылка.ДемонстрационныеСценарии
//
Функция ЗаписатьДеревоВСправочник(ДеревоУзлов, КодЯзыка, РешенияПоКонфликтам,
	КаталогПоиска = "", АдресаКартинокВоВременномХранилище = Неопределено,
	АдресПрогресса = "", АдресРезультатаЗагрузки = "",
	КартаПодменКартинок = Неопределено,
	ИнструкцияИсточник = Неопределено) Экспорт

	Результат = НовыйТаблицаРезультата();

	// Считаем общее число узлов для прогресса этапа записи.
	ВсегоУзлов = ПосчитатьВсеУзлыДерева(ДеревоУзлов);

	// Все информационные ЖР-записи в этой функции — диагностические.
	// Пишем только если журнал регистрации не отключён администратором.
	// Это снимает нагрузку при полностью отключённом журнале.
	// ПолучитьИспользованиеЖурналаРегистрации() возвращает Массив
	// уровней, для которых включена регистрация. Пустой массив
	// означает, что журнал отключён полностью.
	ЖурналВключен = ПолучитьИспользованиеЖурналаРегистрации().Количество() > 0;

	Если ЖурналВключен Тогда
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Информация, , ,
			"Старт записи дерева. Всего узлов: " + ВсегоУзлов
			+ ", решений по конфликтам: " + РешенияПоКонфликтам.Количество()
			+ ", каталог поиска: " + КаталогПоиска
			+ ", адресов картинок в ВХ: " + ?(АдресаКартинокВоВременномХранилище <> Неопределено,
				XMLСтрока(АдресаКартинокВоВременномХранилище.Количество()), "0"));

		// Диагностика пакета D: печатаем ключи и действия решений, чтобы понять,
		// доходят ли решения до фонового задания и совпадают ли ключи с именами узлов.
		// Формирует потенциально длинную строку — поэтому тоже под условным блоком.
		ДиагностическиеСтроки = Новый Массив;
		Для Каждого КИЗ Из РешенияПоКонфликтам Цикл
			ОписаниеРешения = КИЗ.Значение;
			ТекстДействия = "<без действия>";
			Если ТипЗнч(ОписаниеРешения) = Тип("Структура")
				И ОписаниеРешения.Свойство("Действие") Тогда
				ТекстДействия = Строка(ОписаниеРешения.Действие);
			КонецЕсли;
			ДиагностическиеСтроки.Добавить(Строка(КИЗ.Ключ) + " -> " + ТекстДействия);
		КонецЦикла;
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Информация, , ,
			"Диагностика D: решения по конфликтам на входе в запись: ["
			+ СтрСоединить(ДиагностическиеСтроки, "; ") + "]");
	КонецЕсли;

	Попытка

	// Этап 2: загрузка картинок (0..30%).
	Если ЖурналВключен Тогда
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Информация, , ,
			"Запись дерева: этап 2 — подготовка картинок"
			+ ?(КартаПодменКартинок <> Неопределено,
				" (карта передана готовой из предзагрузки)", ""));
	КонецЕсли;
	Если КартаПодменКартинок = Неопределено Тогда
		КартаПодменКартинок = ПодготовитьКартинкиДляДерева(
			ДеревоУзлов, КаталогПоиска, АдресаКартинокВоВременномХранилище, АдресПрогресса);
	КонецЕсли;
		Если ЖурналВключен Тогда
			ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
				УровеньЖурналаРегистрации.Информация, , ,
				"Запись дерева: этап 2 завершён, карта подмен содержит "
				+ ?(КартаПодменКартинок <> Неопределено, XMLСтрока(КартаПодменКартинок.Количество()), "0") + " записей");
		КонецЕсли;

		// Этап 3: запись в справочник (30..100%).
		Если ЖурналВключен Тогда
			ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
				УровеньЖурналаРегистрации.Информация, , ,
				"Запись дерева: этап 3 — запись в справочник");
		КонецЕсли;
		ОбработаноУзлов = 0;
		МассивHTMLПоУзлам = Новый Массив;
		// Собираем кеш существующих узлов по именам дерева для авто-резолва:
		// если узел с таким именем (и типом) уже есть в базе, но решение по
		// нему не задано (форма конфликтов не открывалась или узел не попал
		// в РешенияПоКонфликтам), используем существующий как кандидат на
		// обновление - это позволяет добавить связь с родителем из MD
		// вместо создания дубля. Один пакетный запрос на все уникальные
		// имена дерева - без обращений к БД в цикле обхода.
		МассивУникальныхИмен = ГКСИ_СобратьУникальныеИменаИзДерева(ДеревоУзлов);
		КешСуществующих = НайтиСуществующихПоИмени(МассивУникальныхИмен);
	Для Каждого Корень Из ДеревоУзлов.Строки Цикл
		ОбработаноУзлов = ОбработатьУзелРекурсивно(Корень, Неопределено, КодЯзыка, РешенияПоКонфликтам,
			Результат, КартаПодменКартинок, АдресПрогресса, ВсегоУзлов, ОбработаноУзлов,
			МассивHTMLПоУзлам, КешСуществующих, ИнструкцияИсточник);
	КонецЦикла;

		// Этап 4: пакетное создание присоединённых HTML-файлов (95..100%).
		// Раньше файлы создавались внутри хука &После("ПриЗаписи") каждого узла,
		// что вызывало повторную Записать() объекта и на больших деревьях
		// существенно тормозило загрузку. Теперь HTML накапливается по ссылкам
		// и обрабатывается одним пакетом после записи всего дерева.
		Если МассивHTMLПоУзлам.Количество() > 0 Тогда
			ЗаписатьПрогресс(АдресПрогресса, 3, ВсегоУзлов, ВсегоУзлов,
				НСтр("ru = 'Создание присоединённых файлов'"));
			Сводка = СоздатьПрисоединенныеHTMLФайлыПакетно(МассивHTMLПоУзлам);
			Если Сводка.Ошибок > 0 Тогда
				ЗаписатьПрогресс(АдресПрогресса, 3, ВсегоУзлов, ВсегоУзлов,
					СтрШаблон(НСтр("ru = 'Создание файлов: %1 ошибок'"), Сводка.Ошибок));
			КонецЕсли;
		КонецЕсли;

		Если ЖурналВключен Тогда
			ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
				УровеньЖурналаРегистрации.Информация, , ,
				"Завершение записи дерева. Строк в результате: " + Результат.Количество()
				+ ", обработано узлов: " + ОбработаноУзлов
				+ " из " + ВсегоУзлов);
		КонецЕсли;

	Исключение

		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка на этапе записи дерева:" + Символы.ПС + ТекстОшибки);
		ВызватьИсключение;

	КонецПопытки;

	// Финальный кадр прогресса — "Готово".
	ЗаписатьПрогресс(АдресПрогресса, 4, ВсегоУзлов, ВсегоУзлов,
		"Загрузка завершена");

	// Передаём таблицу результата обратно в форму (если задан адрес).
	Если ЗначениеЗаполнено(АдресРезультатаЗагрузки) Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультатаЗагрузки);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Преобразует Markdown в простой HTML. Поддерживает заголовки H1..H3,
// параграфы, жирный/курсив/моноширинный шрифт, ссылки. Реализовано
// на платформенных функциях регулярных выражений (без COM/VBScript).
//
// Параметры:
//  ТекстMarkdown - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - HTML-представление.
//
Функция MarkdownВHTML(ТекстMarkdown) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстMarkdown) Тогда
		Возврат "";
	КонецЕсли;

	// Экранирование HTML-сущностей в исходном тексте.
	Текст = ТекстMarkdown;

	// Заголовки — собираем до остальных замен, чтобы не повредить содержимое
	// символами # внутри обычного текста.
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "(?m)^### (.+?)$",  "<h3>$1</h3>");
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "(?m)^## (.+?)$",   "<h2>$1</h2>");
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "(?m)^# (.+?)$",    "<h1>$1</h1>");

	// Жирный (**...**) и курсив (*...*) — порядок важен: сначала двойные.
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "\*\*(.+?)\*\*", "<strong>$1</strong>");
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "(?<!\*)\*([^*]+?)\*(?!\*)", "<em>$1</em>");

	// Моноширинный `...`.
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "`([^`]+?)`", "<code>$1</code>");

	// Ссылки [текст](url).
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "\[([^\]]+)\]\(([^)]+)\)",
		"<a href=""$2"">$1</a>");

	// Картинки ![alt](КОД) — оставляем src с кодом (GUID), дальше заменим на data URI.
	Текст = СтрЗаменитьПоРегулярномуВыражению(Текст, "!\[([^\]]*)\]\(([^)]+)\)",
		"<img src=""$2"" alt=""$1"">");

	// Параграфы — каждая непустая строка, не являющаяся тегом.
	//
	// ВАЖНО: используем СтрРазделить(..., Ложь), а не Истина. С флагом Истина
	// BSL схлопывает последовательные символы ПС в один разделитель и
	// пустые элементы НЕ возвращаются — между абзацами исходного markdown
	// (\n\n) потерь не будет, но и новый <p> не образуется: всё содержимое
	// упадёт в один большой <p>...</p> через <br>. Это правильно работает
	// для обычного prose-текста, но ломает GitHub Alerts: маркер [!CAUTION]
	// оказывается где-то в середине большого <p> (после "Текст<br>"), и
	// ЗаменитьОбёрткуНаDiv в ОбработатьАлертыВHTML (ищет "<p>[!TYPE" — точное
	// начало параграфа) его не находит. Лог показывает byType=CAUTION=1,
	// но delta=0; changed=Нет. С флагом Ложь пустые строки остаются в массиве,
	// и код ниже (ветка ПустаяСтрока) корректно сбрасывает Буфер в <p>.
	//
	// Дополнительно удаляем Символы.ВК (\r) — это страховка от CRLF: после
	// СтрЗаменить любая строка, состоящая только из \r, становится пустой
	// и попадает в ветку ПустаяСтрока, а не в обычный текстовый буфер.
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	МассивСтрок = СтрРазделить(Текст, Символы.ПС, Ложь);
	Фрагменты  = Новый Массив;
	Буфер      = Новый Массив;

	Для Каждого Строка Из МассивСтрок Цикл

		ЭтоТег = СтрНачинаетсяС(Строка, "<")
			И (СтрНайти(Строка, "</h") > 0
				ИЛИ СтрНайти(Строка, "</p>") > 0
				ИЛИ СтрНачинаетсяС(Строка, "<h1>")
				ИЛИ СтрНачинаетсяС(Строка, "<h2>")
				ИЛИ СтрНачинаетсяС(Строка, "<h3>"));

		Если ПустаяСтрока(Строка) Тогда
			Если Буфер.Количество() > 0 Тогда
				Фрагменты.Добавить("<p>" + СтрСоединить(Буфер, "<br>") + "</p>");
				Буфер.Очистить();
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ЭтоТег Тогда
			Если Буфер.Количество() > 0 Тогда
				Фрагменты.Добавить("<p>" + СтрСоединить(Буфер, "<br>") + "</p>");
				Буфер.Очистить();
			КонецЕсли;
			Фрагменты.Добавить(Строка);
			Продолжить;
		КонецЕсли;

		Буфер.Добавить(Строка);

	КонецЦикла;

	Если Буфер.Количество() > 0 Тогда
		Фрагменты.Добавить("<p>" + СтрСоединить(Буфер, "<br>") + "</p>");
	КонецЕсли;

	ТекстHTML = СтрСоединить(Фрагменты, Символы.ПС);

	// Подмена кодов картинок (GUID) на data:URI, чтобы при первом открытии
	// формы элемента/группы картинки были видны без дополнительной перезаписи.
	// Без обращений к БД в цикле: один пакетный запрос на все коды.
	ТекстHTML = ГКСИ_MarkdownПереопределяемый.ЗаменитьКодыИзображенийНаDataURI(ТекстHTML);

	Возврат ТекстHTML;

КонецФункции

// Преобразует Markdown в HTML с постобработкой GitHub Alerts.
// Прокси-обёртка над MarkdownВHTML + ОбработатьАлертыВHTML.
// Единая точка конвейера для накопления HTML в МассивHTMLПоУзлам —
// вызывается из обеих веток ОбработатьУзелРекурсивно (Прикрепить и Создать/Обновить),
// чтобы не было рассинхронизации между ветками по обработке блоков
// [!NOTE]/[!WARNING]/[!TIP]/[!IMPORTANT]/[!CAUTION].
//
// История: до версии 2.32.29 прогон ОбработатьАлертыВHTML после MarkdownВHTML
// был только в ветке «Прикрепить» (добавлен в v2.32.8). В основной ветке
// «Создать/Обновить» HTML записывался без прогона, и блоки [!NOTE] и т.д.
// сохранялись в присоединённом файле как plain-текст без классов
// markdown-alert-*. Теперь обе ветки идут через один и тот же шаг.
//
// Параметры:
//  ТекстMarkdown - Строка - исходный Markdown.
//
// Возвращаемое значение:
//  Строка - HTML с обработанными блоками GitHub Alerts.
//
Функция MarkdownВHTMLСАлертами(ТекстMarkdown) Экспорт

	// Диагностическое логирование: фиксирует факт входа в обёртку и
	// сколько символов preprocessing добавила к исходному тексту.
	// Если после публикации расширения в ЖР нет записей "PREPROC hit" —
	// значит, 1С использует старую закэшированную версию модуля и нужно
	// перезапустить сеанс. Если "PREPROC hit=0" при наличии [!TYPE]
	// в исходнике — баг в preprocessing.
	ДлинаДо = ?(ЗначениеЗаполнено(ТекстMarkdown), СтрДлина(ТекстMarkdown), 0);
	ТекстНормализованный = ОбеспечитьРазрывПередМаркерамиАлертов(ТекстMarkdown);
	ДлинаПосле = ?(ЗначениеЗаполнено(ТекстНормализованный), СтрДлина(ТекстНормализованный), 0);
	ЧислоСовпаденийМаркеров = СтрЧислоВхождений(ТекстMarkdown, "[!WARNING]")
		+ СтрЧислоВхождений(ТекстMarkdown, "[!NOTE]")
		+ СтрЧислоВхождений(ТекстMarkdown, "[!TIP]")
		+ СтрЧислоВхождений(ТекстMarkdown, "[!IMPORTANT]")
		+ СтрЧислоВхождений(ТекстMarkdown, "[!CAUTION]");

	ЗаписьЖурналаРегистрации(
		"ГКСИ.MarkdownServer.Alerts.Preprocess",
		УровеньЖурналаРегистрации.Информация, , ,
		"PREPROC hit=" + Строка(ЧислоСовпаденийМаркеров)
		+ "; lenBefore=" + Строка(ДлинаДо)
		+ "; lenAfter=" + Строка(ДлинаПосле)
		+ "; delta=" + Строка(ДлинаПосле - ДлинаДо));

	Возврат ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(
		MarkdownВHTML(ТекстНормализованный));

КонецФункции

// Добавляет пустую строку (\n\n) перед каждым вхождением [!TYPE]
// (WARNING, NOTE, TIP, IMPORTANT, CAUTION) в исходном Markdown.
//
// Контекст: парсер РазобратьMarkdownВДерево (строки 138-143) соединяет
// непустые строки исходного файла через одиночный \n:
//
//	ТекущийУзел.ТекстMarkdown + Символы.ПС + ОбработаннаяСтрока
//
// То есть в ТекстMarkdown, который приходит в MarkdownВHTMLСАлертами,
// НИКОГДА нет пустых строк между абзацами — даже если в исходном .md
// между блоками был перевод строки. После MarkdownВHTML с такими
// данными весь файл уходит в один большой <p>...</p>, маркер [!CAUTION]
// оказывается в его середине (после какого-то <br>), и ЗаменитьОбёрткуНаDiv
// в ОбработатьАлертыВHTML (ищет "<p>[!TYPE" — точное начало параграфа)
// его не находит. Лог показывает byType=CAUTION=1, но delta=0.
//
// Решение: перед MarkdownВHTML принудительно вставить \n\n перед
// каждым маркером алерта. Это безопасно — несколько \n подряд
// MarkdownВHTML трактует как одну пустую строку (пустые элементы массива
// попадают в ветку ПустаяСтрока, Буфер корректно сбрасывается).
//
// Идемпотентность: повторный прогон на уже нормализованном тексте добавит
// ещё одну пару \n — на результате это не скажется.
//
// Edge-case: функция не различает [!TYPE] внутри других конструкций
// markdown (ссылок, блоков кода). В текущих сценариях таких конструкций
// нет — алерты всегда идут отдельной строкой. Если в будущем потребуется
// более аккуратное поведение — можно ограничить поиск позицией начала
// строки через СтрНайти + реверс-поиск ближайшего \n.
//
// Параметры:
//  Текст - Строка - исходный Markdown.
//
// Возвращаемое значение:
//  Строка - нормализованный Markdown с пустыми строками перед [!TYPE].
//
Функция ОбеспечитьРазрывПередМаркерамиАлертов(Текст) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = Текст;

	// Порядок замен не важен — обрабатываем каждый тип независимо.
	Результат = СтрЗаменить(Результат, "[!WARNING]",   Символы.ПС + Символы.ПС + "[!WARNING]");
	Результат = СтрЗаменить(Результат, "[!NOTE]",      Символы.ПС + Символы.ПС + "[!NOTE]");
	Результат = СтрЗаменить(Результат, "[!TIP]",       Символы.ПС + Символы.ПС + "[!TIP]");
	Результат = СтрЗаменить(Результат, "[!IMPORTANT]", Символы.ПС + Символы.ПС + "[!IMPORTANT]");
	Результат = СтрЗаменить(Результат, "[!CAUTION]",   Символы.ПС + Символы.ПС + "[!CAUTION]");

	Возврат Результат;

КонецФункции

// Создаёт пустую таблицу результата записи.
//
// Возвращаемое значение:
//  ТаблицаЗначений.
//
Функция НовыйТаблицаРезультата()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("Действие",     Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("Ссылка",       Новый ОписаниеТипов("СправочникСсылка.ДемонстрационныеСценарии"));
	Результат.Колонки.Добавить("ТекстОшибки",  Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(500)));
	Возврат Результат;

КонецФункции

// Рекурсивно обходит узлы дерева и записывает их в справочник.
// Транзакция одна на весь вызов — накапливаем ошибки, откатываем при исключении.
//
// Параметры:
//  Узел                  - СтрокаДереваЗначений.
//  РодительскаяСсылка    - СправочникСсылка.ДемонстрационныеСценарии.
//  КодЯзыка              - Строка.
//  РешенияПоКонфликтам   - Соответствие из КлючИЗначение.
//  Результат             - ТаблицаЗначений.
//  КартаПодменКартинок   - Соответствие из КлючИЗначение - результат ПодготовитьКартинкиДляДерева.
//                          Если пустое - картинки не обрабатываются.
//  АдресПрогресса        - Строка - адрес ВХ для публикации прогресса (необязательный).
//  ВсегоУзлов            - Число - общее число узлов в дереве (для прогресса).
//  ОбработаноУзлов       - Число - счётчик уже обработанных узлов (вход/выход).
//  МассивHTMLПоУзлам     - Произвольный - накопленный массив HTML по узлам (необязательный).
//  КешСуществующих       - Соответствие из КлючИЗначение - кеш существующих по имени (необязательный).
//  ИнструкцияИсточник    - СправочникСсылка.ДемонстрационныеСценарии - корень-инструкция (необязательный).
//
// Возвращаемое значение:
//  Число - новое значение счётчика ОбработаноУзлов (после текущего узла и его детей).
//
Функция ОбработатьУзелРекурсивно(Узел, РодительскаяСсылка, КодЯзыка, РешенияПоКонфликтам,
	Результат, КартаПодменКартинок = Неопределено,
	АдресПрогресса = "", ВсегоУзлов = 0, ОбработаноУзлов = 0,
	МассивHTMLПоУзлам = Неопределено, КешСуществующих = Неопределено,
	ИнструкцияИсточник = Неопределено)

	// ИнструкцияИсточник - СправочникСсылка.ДемонстрационныеСценарии - ссылка на
	// корневую группу-инструкцию для текущего поддерева. Передаётся через рекурсию:
	// на верхнем уровне (#-заголовок с Узел.Уровень = 2) узел сам становится
	// инструкцией для своих детей, на вложенных уровнях - наследуется от родителя.
	// Записывается в реквизит ГКСИ_ИнструкцияИсточник только у новых элементов
	// (не групп), чтобы форма списка могла отфильтровать элемент в его инструкции.

	ОбработаноУзлов = ОбработаноУзлов + 1;

	// Прогресс публикуем не на каждый узел (на 1000 узлов это 2000 операций
	// с ВХ), а через шаг — около 1% от всего (но не реже одного раза и
	// обязательно на последнем узле). Это даёт плавную полосу без лишних
	// задержек на ВХ.
	ШагПрогрессаУзлов = Макс(1, Цел(ВсегоУзлов / 100));
	Если ОбработаноУзлов = ВсегоУзлов
			ИЛИ ОбработаноУзлов % ШагПрогрессаУзлов = 0 Тогда
		ЗаписатьПрогресс(АдресПрогресса, 3, ОбработаноУзлов, ВсегоУзлов,
			СтрШаблон(НСтр("ru = 'Запись элемента: %1'"), Узел.Наименование));
	КонецЕсли;

	// Правило: самый глубокий заголовок (без дочерних узлов) — элемент,
	// все остальные — группы.
	ЭтоГруппа = Узел.Строки.Количество() > 0;
	РешениеПоУзлу = РешенияПоКонфликтам.Получить(Узел.Наименование);

	// Авто-резолв: если явного решения по узлу нет (форма конфликтов не
	// открывалась, или узел не попал в РешенияПоКонфликтам), ищем в базе
	// существующий узел с тем же именем и типом и трактуем его как
	// кандидат на обновление. Это позволяет избежать дублей и добавить
	// связь с родителем из MD через уже идемпотентный вызов
	// ДобавитьСценарийВГруппу ниже.
	Если РешениеПоУзлу = Неопределено Тогда
		РешениеПоУзлу = ГКСИ_АвтоРезолвУзлаПоКешу(КешСуществующих, Узел, ЭтоГруппа);

		// Защита от переиспользования чужих узлов: если авто-резолв вернул
		// существующий узел, помеченный другой инструкцией-источником,
		// обновлять его нельзя — иначе при загрузке следующей инструкции
		// чужие реквизиты будут перезаписаны. В таком случае решение сбрасывается,
		// узел будет создан как новый. Узлы с пустым источником (общие группы)
		// и узлы без заполненной текущей инструкции (корневой уровень) пропускаются.
		Если РешениеПоУзлу <> Неопределено
				И РешениеПоУзлу.Действие = "Обновить"
				И ЗначениеЗаполнено(ИнструкцияИсточник) Тогда
			СуществующийИсточник = ГКСИ_ПолучитьИнструкциюИсточникИзКеша(
				КешСуществующих, Узел.Наименование, РешениеПоУзлу.Ссылка);
			Если ЗначениеЗаполнено(СуществующийИсточник)
					И СуществующийИсточник <> ИнструкцияИсточник Тогда
				ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
					УровеньЖурналаРегистрации.Предупреждение, , ,
					"Авто-резолв пропущен: узел """ + Узел.Наименование
					+ """ принадлежит другой инструкции (" + СуществующийИсточник + ")");
				РешениеПоУзлу = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Подмена ссылок на картинки в тексте узла — по готовой карте.
	ТекстУзла = Узел.ТекстMarkdown;
	Если КартаПодменКартинок <> Неопределено И ЗначениеЗаполнено(ТекстУзла) Тогда
		ТекстУзла = ПодменитьСсылкиНаКартинкиВТексте(ТекстУзла, КартаПодменКартинок);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		СсылкаНаУзел = Неопределено;

	Если РешениеПоУзлу <> Неопределено И РешениеПоУзлу.Действие = "Пропустить" Тогда
		ДобавитьСтрокуРезультата(Результат, Узел.Наименование, "Пропущен", СсылкаНаУзел, "");
	ИначеЕсли РешениеПоУзлу <> Неопределено И РешениеПоУзлу.Действие = "Прикрепить" Тогда
		СсылкаНаУзел = РешениеПоУзлу.Ссылка;

		// Если пользователь при разрешении конфликта выбрал «оставить из файла»,
		// то в решении приходит текст узла из файла — перезаписываем реквизиты узла
		// и накапливаем HTML для пакетного обновления присоединённых файлов.
		// Если ТекстИзФайла пустой (вариант «оставить наш» или пользователь не
		// открывал диалог) — узел остаётся в исходном виде, запись в РС создаётся,
		// текст и HTML не трогаем.
		Если РешениеПоУзлу.Свойство("ТекстИзФайла")
				И ЗначениеЗаполнено(РешениеПоУзлу.ТекстИзФайла) Тогда
			ОбъектУзла = СсылкаНаУзел.ПолучитьОбъект();
			Если ОбъектУзла <> Неопределено Тогда
				ОбъектУзла.ГКСИ_ТекстMarkdown        = ТекстУзла;
				ОбъектУзла.ГКСИ_MarkdownСформирован  = Истина;
				ОбъектУзла.Записать();

			Если МассивHTMLПоУзлам <> Неопределено Тогда
				// Прогон через единый конвейер Markdown → HTML + обработка GitHub Alerts.
				// См. MarkdownВHTMLСАлертами.
				HTMLУзла = MarkdownВHTMLСАлертами(ТекстУзла);
				ЭлементHTMLПоУзлу = Новый Структура(
					"Сценарий, КодЯзыка, ТекстHTML",
					СсылкаНаУзел, КодЯзыка, HTMLУзла);
				МассивHTMLПоУзлам.Добавить(ЭлементHTMLПоУзлу);
			КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ДобавитьСтрокуРезультата(Результат, Узел.Наименование, "Прикреплён", СсылкаНаУзел, "");
	Иначе

			// Получаем объект (новый или существующий по решению).
			Если РешениеПоУзлу <> Неопределено И РешениеПоУзлу.Действие = "Обновить" Тогда
				ОбъектУзла = РешениеПоУзлу.Ссылка.ПолучитьОбъект();
			Иначе
				Если ЭтоГруппа Тогда
					ОбъектУзла = Справочники.ДемонстрационныеСценарии.СоздатьГруппу();
				Иначе
					ОбъектУзла = Справочники.ДемонстрационныеСценарии.СоздатьЭлемент();
				КонецЕсли;
			КонецЕсли;

		ЗаполнитьРеквизитыУзла(ОбъектУзла, Узел, КодЯзыка, ТекстУзла);

		// Фиксируем инструкцию-источник для нового элемента (не группы, не обновления):
		// записываем в реквизит ГКСИ_ИнструкцияИсточник ссылку на корневую
		// группу-инструкцию, в рамках которой он создаётся. Это позволяет форме
		// списка отображать элемент только в его инструкции.
		// Для существующих элементов с пустым реквизитом (до введения фичи)
		// также заполняем - это дозаполнение при первом импорте после обновления.
		// Если пользователь осознанно очистил реквизит - повторные импорты
		// не перезапишут, т.к. условие "пустой" уже не выполнится.
	ЭтоНовыйЭлемент = (РешениеПоУзлу = Неопределено
		ИЛИ РешениеПоУзлу.Действие <> "Обновить");

		// Корневая обёртка инструкции (Уровень = 1) получает код не по общей
		// автонумерации справочника (иначе вторая инструкция получит код = MAX+1
		// от всего справочника, например "019" после инструкции с 18 узлами),
		// а по отдельной последовательности среди служебных корневых обёрток:
		// 001, 002, 003 ... Это обеспечивает компактную и предсказуемую нумерацию
		// головных групп инструкций в форме списка.
		// Только при создании новой группы; при "Обновить" код уже есть и не трогаем.
		Если ЭтоГруппа
				И Узел.Уровень = 1
				И ЭтоНовыйЭлемент Тогда
			ОбъектУзла.Код = ГКСИ_ГруппыСценариевСервер.ГКСИ_ПолучитьСледующийКодКорневойОбёртки();
		КонецЕсли;
		// Заполняем ГКСИ_ИнструкцияИсточник только при создании узла (группы или
		// элемента) или при дозаполнении существующего с пустым реквизитом.
		// При явном "Обновить" (переиспользование) реквизит НЕ перезаписывается -
		// иначе общая группа, созданная в ГИП, при загрузке ДМТО стала бы
		// "своей" для ДМТО и потеряла бы признак общей. Признак общей группы
		// (пустой источник + несколько корней в РС) восстанавливается отдельной
		// процедурой исправления данных (см. ОчиститьВсеСправочникиИРегистры).
		// Поле ГКСИ_ИнструкцияИсточник доступно только для элементов (не групп),
		// поэтому для групп реквизит не записывается. Чтение реквизита у группы
		// тоже невозможно, поэтому обращаемся к нему только если узел - не группа.
		// Признак общей группы определяется через РС ГКСИ_ГруппыСценариев
		// (несколько корневых инструкций).
		Если НЕ ЭтоГруппа
				И ЗначениеЗаполнено(ИнструкцияИсточник)
				И (ЭтоНовыйЭлемент
					ИЛИ НЕ ЗначениеЗаполнено(ОбъектУзла.ГКСИ_ИнструкцияИсточник)) Тогда
			ОбъектУзла.ГКСИ_ИнструкцияИсточник = ИнструкцияИсточник;
		КонецЕсли;

			ОбъектУзла.Записать();
			СсылкаНаУзел = ОбъектУзла.Ссылка;

			// Накапливаем HTML для пакетного создания присоединённых файлов
			// после записи всего дерева. Старый канал ДополнительныеСвойства
			// больше не используется: это исключает повторную Записать() внутри
			// &После("ПриЗаписи") на каждом узле.
		Если МассивHTMLПоУзлам <> Неопределено
				И ЗначениеЗаполнено(СсылкаНаУзел)
				И ЗначениеЗаполнено(ТекстУзла) Тогда
			// Прогон через единый конвейер Markdown → HTML + обработка GitHub Alerts.
			// См. MarkdownВHTMLСАлертами.
			HTMLДляПередачи = MarkdownВHTMLСАлертами(ТекстУзла);
			ЭлементHTMLПоУзлу = Новый Структура("Сценарий, КодЯзыка, ТекстHTML",
				СсылкаНаУзел, КодЯзыка, HTMLДляПередачи);
			МассивHTMLПоУзлам.Добавить(ЭлементHTMLПоУзлу);
		КонецЕсли;

			Если РешениеПоУзлу <> Неопределено И РешениеПоУзлу.Действие = "Обновить" Тогда
				Действие = "Обновлён";
			Иначе
				Действие = "Создан";
			КонецЕсли;
			ДобавитьСтрокуРезультата(Результат, Узел.Наименование, Действие, СсылкаНаУзел, "");

		КонецЕсли;

// Инструкция-источник для самого текущего узла и для рекурсивного вызова детей.
// Разделяем:
//  - ИнструкцияИсточникДляУзла  — что писать в КореньИнструкции регистра
//    для самого текущего узла;
//  - ИнструкцияИсточникДляДетей — что передавать детям как корневую инструкцию.
//
// Логика:
//  - если из формы явно передан ИнструкцияИсточник (не пустой):
//      * он же идёт и в КореньИнструкции текущего узла (ИнструкцияИсточникДляУзла),
//        и передаётся детям (ИнструкцияИсточникДляДетей). Это покрывает как
//        #-заголовки верхнего уровня, так и вложенные узлы — все они получают
//        один и тот же корень инструкции, под которой их загрузили.
//  - если ИнструкцияИсточник НЕ передан:
//      * #-заголовок (Узел.Уровень = 2) сам становится инструкцией и для себя,
//        и для своих детей.
//      * вложенные узлы наследуют.
//
// Корень-обёртка (Узел.Уровень = 1) пропускается условием Узел.Уровень = 2
// и не становится инструкцией - это служебная группа с именем файла.
//
// Изменение bugfix 1.100 (откат bugfix 1.95): раньше #-заголовку верхнего
// уровня КореньИнструкции НЕ писался (ИнструкцияИсточникДляУзла = Неопределено).
// Это приводило к тому, что дочерние ##-заголовки, записанные как отдельные
// корневые группы справочника, получали ПолныйКод = "002", "003" и т.д.,
// и в КодВКонтексте не появлялся префикс корневой инструкции. Теперь
// #-заголовку пишется тот же корень, что и его детям, — благодаря этому
// в КодВКонтексте всех узлов инструкции появляется префикс корня
// (например, "001.002" для ##-заголовка ДМТО), и дерево строит правильную
// иерархию.

Если ЗначениеЗаполнено(ИнструкцияИсточник) Тогда
    ИнструкцияИсточникДляУзла  = ИнструкцияИсточник;
    ИнструкцияИсточникДляДетей = ИнструкцияИсточник;
Иначе
    ИнструкцияИсточникДляУзла  = ?(ЗначениеЗаполнено(СсылкаНаУзел), СсылкаНаУзел, ИнструкцияИсточник);
    ИнструкцияИсточникДляДетей = ИнструкцияИсточникДляУзла;
КонецЕсли;

// Связь с родителем через расширение (РС ГКСИ_ГруппыСценариев).
// КореньИнструкции = ИнструкцияИсточникДляУзла — корневая группа-инструкция,
// в рамках которой загружается узел. Для #-заголовка верхнего уровня
// это Неопределено (он сам корневой); для вложенных — наследованный
// ИнструкцияИсточник от формы или от родителя.
// Если Неопределено — ДобавитьСценарийВГруппу запишет запись без
// измерения КореньИнструкции (см. ГКСИ_ЗаписатьПолныйКодКонтекстный).
Если ЗначениеЗаполнено(РодительскаяСсылка) И ЗначениеЗаполнено(СсылкаНаУзел) Тогда
    ГКСИ_ГруппыСценариевСервер.ДобавитьСценарийВГруппу(СсылкаНаУзел, РодительскаяСсылка, ИнструкцияИсточникДляУзла);

// Корневая обёртка инструкции (Уровень = 1, имя файла без ".md")
// не имеет родителя в дереве разбора, поэтому ДобавитьСценарийВГруппу
// выше не вызывается. Без отдельной регистрации форма ФормаСпискаДеревоГрупп
// не находит её в РС и рисует фиктивный узел с Наименование = КодВКонтексте
// (см. ГКСИ_СоздатьСтрокуДерева, блок 2). Регистрируем обёртку
// отдельной записью с самоссылкой, чтобы её КодВКонтексте = "<КодОбёртки>"
// появился в дереве и форма отображала настоящее имя обёртки из справочника.
//
// #-заголовки (Уровень = 2) и ниже идут через ДобавитьСценарийВГруппу
// выше: их РодительскаяСсылка указывает на обёртку, а КореньИнструкции
// наследуется от обёртки (ИнструкцияИсточникДляДетей обёртки).
ИначеЕсли ЭтоГруппа
        И Узел.Уровень = 1
        И ЗначениеЗаполнено(СсылкаНаУзел) Тогда
    ГКСИ_ГруппыСценариевСервер.ЗарегистрироватьКорневуюГруппуИнструкции(СсылкаНаУзел);
Иначе
    // Дочерние узлы без родителя в дереве разбора пропускаем:
    // они не относятся к инструкции и не должны регистрироваться.
КонецЕсли;

ЗафиксироватьТранзакцию();
Исключение
    ОтменитьТранзакцию();
    ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
        УровеньЖурналаРегистрации.Ошибка, , ,
        "Ошибка записи узла: " + Узел.Наименование + Символы.ПС + ТекстОшибки);
    КраткоеПредставление = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    ДобавитьСтрокуРезультата(Результат, Узел.Наименование, "Ошибка", Неопределено, КраткоеПредставление);
    Возврат ОбработаноУзлов;
КонецПопытки;

Для Каждого ДочернийУзел Из Узел.Строки Цикл
    ОбработаноУзлов = ОбработатьУзелРекурсивно(ДочернийУзел, СсылкаНаУзел, КодЯзыка, РешенияПоКонфликтам,
        Результат, КартаПодменКартинок, АдресПрогресса, ВсегоУзлов, ОбработаноУзлов,
        МассивHTMLПоУзлам, КешСуществующих, ИнструкцияИсточникДляДетей);
КонецЦикла;

	// Пересчёт кодов всей инструкции выполняем только для корневой обёртки
	// (Узел.Уровень = 1): ПересчитатьПолныйКодДляПоддерева покрывает саму
	// обёртку и всех её потомков (ГКСИ_СобратьПотомковРекурсивно добавляет в
	// массив и саму группу, и все вложенные группы), поэтому промежуточные
	// группы пересчитывать не нужно — это N полных построений графа базы на
	// одном дереве при том же результате. Пересчёт идёт после записи всего
	// поддерева (после рекурсии в детей) — в этот момент все связи уже в регистре.
	// Без пересчёта подгруппа внутри подгруппы получает код только своей позиции
	// в родителе, без префикса корня (например, "001" вместо "029.005.001").
	Если Узел.Уровень = 1 И ЗначениеЗаполнено(СсылкаНаУзел) Тогда
		ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодДляПоддерева(СсылкаНаУзел);
	КонецЕсли;

	Возврат ОбработаноУзлов;

КонецФункции

// Создаёт/обновляет присоединённые HTML-файлы сценариев пакетным способом:
// один проход после записи всего дерева, а не на каждом узле.
//
// В отличие от ObjectModule.ГКСИ_СоздатьПрисоединенныеФайлыИзДопСвойств,
// здесь HTML передаётся не через ДополнительныеСвойства, а напрямую
// массивом структур {Сценарий, КодЯзыка, ТекстHTML}. Это исключает повторную
// ОбъектСценария.Записать() внутри хука &После("ПриЗаписи") и даёт
// многократное ускорение при большом числе узлов.
//
// Параметры:
//  МассивСценариевИHTML - Массив из Структура - элементы со полями:
//                           * Сценарий  - СправочникСсылка.ДемонстрационныеСценарии
//                           * КодЯзыка  - Строка
//                           * ТекстHTML - Строка
//  РазмерЧанка          - Число - необязательный, по умолчанию 1.
//                          Число сценариев в одной внешней транзакции.
//                          1 = каждая запись атомарна; >1 = уплотнение БСП-транзакций.
//
// Возвращаемое значение:
//  Структура:
//    * ОбработаноСценариев - Число - успешно обработано сценариев.
//    * СозданоФайлов       - Число - сколько новых присоединённых файлов создано.
//    * ОбновленоФайлов     - Число - сколько существующих файлов обновлено.
//    * Ошибок              - Число - сколько сценариев завершились с ошибкой.
//    * ТекстОшибки         - Строка - текст последней ошибки (для протокола).
//
// @skip-check CognitiveComplexity
// @skip-check NestedStatements
// @skip-check UsageWriteLogEvent
// @skip-check Typo
// @skip-check LatinAndCyrillicSymbolInWord
// @skip-check DuplicateStringLiteral
//
// Осознанное архитектурное решение: двойной Try/Catch (внешний для чанка,
// внутренний для сценария) даёт изоляцию ошибок одного сценария от всего
// пакета. Это повышает когнитивную сложность и вложенность, но
// альтернатива (один общий Try/Catch) приводит к риску рассогласования
// данных при ошибке в середине пакета.
Функция СоздатьПрисоединенныеHTMLФайлыПакетно(МассивСценариевИHTML, РазмерЧанка = 1) Экспорт

	Сводка = Новый Структура;
	Сводка.Вставить("ОбработаноСценариев", 0);
	Сводка.Вставить("СозданоФайлов",       0);
	Сводка.Вставить("ОбновленоФайлов",     0);
	Сводка.Вставить("Ошибок",              0);
	Сводка.Вставить("ТекстОшибки",         "");

	Если МассивСценариевИHTML.Количество() = 0 Тогда
		Возврат Сводка;
	КонецЕсли;

	Если РазмерЧанка < 1 Тогда
		РазмерЧанка = 1;
	КонецЕсли;

	ЖурналВключен = ПолучитьИспользованиеЖурналаРегистрации().Количество() > 0;

	// Шаг 1. Группировка по сценарию: Соответствие (ссылка -> массив {КодЯзыка, ТекстHTML}).
	ГруппировкаПоСценариям = Новый Соответствие;
	Для Каждого ЭлементВход Из МассивСценариевИHTML Цикл
		Если ТипЗнч(ЭлементВход) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Сценарий = ЭлементВход.Сценарий;
		Если НЕ ЗначениеЗаполнено(Сценарий) Тогда
			Продолжить;
		КонецЕсли;
		МассивПоСценарию = ГруппировкаПоСценариям.Получить(Сценарий);
		Если МассивПоСценарию = Неопределено Тогда
			МассивПоСценарию = Новый Массив;
			ГруппировкаПоСценариям.Вставить(Сценарий, МассивПоСценарию);
		КонецЕсли;
		ЭлементПоСценарию = Новый Структура("КодЯзыка, ТекстHTML",
			ЭлементВход.КодЯзыка, ЭлементВход.ТекстHTML);
		МассивПоСценарию.Добавить(ЭлементПоСценарию);
	КонецЦикла;

	// Шаг 2. Преобразуем соответствие в массив ссылок для последовательного обхода.
	МассивСценариев = Новый Массив;
	Для Каждого КИЗ Из ГруппировкаПоСценариям Цикл
		МассивСценариев.Добавить(КИЗ.Ключ);
	КонецЦикла;

	Если МассивСценариев.Количество() = 0 Тогда
		Возврат Сводка;
	КонецЕсли;

	// Шаг 3. Обработка чанками с двойной защитой (внешняя — на чанк,
	// внутренняя — на отдельный сценарий).
	НомерЧанка = 0;
	Индекс = 0;
	Пока Индекс < МассивСценариев.Количество() Цикл
		НомерЧанка = НомерЧанка + 1;
		КонецЧанка = Мин(Индекс + РазмерЧанка, МассивСценариев.Количество());

		НачатьТранзакцию();
		Попытка

			Для Сч = Индекс По КонецЧанка - 1 Цикл
				Сценарий        = МассивСценариев[Сч];
				МассивПоСценарию = ГруппировкаПоСценариям.Получить(Сценарий);

				// Внутренний Try/Catch — ошибка на одном сценарии не валит чанк.
				Попытка
					ОбработатьОдинСценарийВПакете(Сценарий, МассивПоСценарию, Сводка);
				Исключение
					Сводка.Ошибок = Сводка.Ошибок + 1;
					Сводка.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					Если ЖурналВключен Тогда
						ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
							УровеньЖурналаРегистрации.Ошибка, , ,
							"Ошибка пакетного создания присоединённого файла для сценария: "
							+ Сценарий + Символы.ПС + Сводка.ТекстОшибки);
					КонецЕсли;
				КонецПопытки;

			КонецЦикла;

			ЗафиксироватьТранзакцию();

		Исключение

			ОтменитьТранзакцию();
			Сводка.Ошибок = Сводка.Ошибок + (КонецЧанка - Индекс);
			Сводка.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Если ЖурналВключен Тогда
				ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
					УровеньЖурналаРегистрации.Ошибка, , ,
					"Ошибка чанка №" + НомерЧанка + " (записей: " + (КонецЧанка - Индекс) + ")"
					+ Символы.ПС + Сводка.ТекстОшибки);
			КонецЕсли;

		КонецПопытки;

		Индекс = КонецЧанка;
	КонецЦикла;

	Если ЖурналВключен Тогда
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Информация, , ,
			"Пакетное создание присоединённых HTML: обработано "
			+ Сводка.ОбработаноСценариев + " сценариев, создано "
			+ Сводка.СозданоФайлов + " файлов, обновлено "
			+ Сводка.ОбновленоФайлов + ", ошибок: " + Сводка.Ошибок);
	КонецЕсли;

	Возврат Сводка;

КонецФункции

// Внутренний помощник СоздатьПрисоединенныеHTMLФайлыПакетно: создаёт/обновляет
// присоединённые HTML-файлы ровно для одного сценария в рамках уже открытой
// внешней транзакции. Логика выделена в отдельную процедуру для того, чтобы
// внешняя функция могла изолировать ошибку сценария внутренним Try/Catch.
//
// Параметры:
//  Сценарий         - СправочникСсылка.ДемонстрационныеСценарии.
//  МассивПоСценарию - Массив из Структура - элементы со полями:
//                       * КодЯзыка  - Строка
//                       * ТекстHTML - Строка
//  Сводка           - Структура - накапливает счётчики Сводка.ОбработаноСценариев,
//                     Сводка.СозданоФайлов, Сводка.ОбновленоФайлов.
//
Процедура ОбработатьОдинСценарийВПакете(Сценарий, МассивПоСценарию, Сводка)

	ОбъектСценария = Сценарий.ПолучитьОбъект();
	Если ОбъектСценария = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолныйКод = ОбъектСценария.ПолныйКод;

	Для Каждого Элемент Из МассивПоСценарию Цикл

		КодЯзыка  = Элемент.КодЯзыка;
		ТекстHTML = Элемент.ТекстHTML;

		Если НЕ ЗначениеЗаполнено(КодЯзыка) ИЛИ НЕ ЗначениеЗаполнено(ТекстHTML) Тогда
			Продолжить;
		КонецЕсли;

		СтруктураПоиска = Новый Структура("КодЯзыка", КодЯзыка);
		НайденныеСтроки = ОбъектСценария.ОписанияСценария.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаОписания = НайденныеСтроки[0];
		Иначе
			СтрокаОписания = ОбъектСценария.ОписанияСценария.Добавить();
			СтрокаОписания.КодЯзыка = КодЯзыка;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаОписания.ПрисоединенныйФайл) Тогда
			ДемонстрационныеСценарии.РезультатОбновленияПрисоединенногоФайла(
				СтрокаОписания.ПрисоединенныйФайл, Неопределено, ТекстHTML);
			Сводка.ОбновленоФайлов = Сводка.ОбновленоФайлов + 1;
		Иначе
			ДвоичныеДанныеФайла       = ПолучитьДвоичныеДанныеИзСтроки(ТекстHTML, КодировкаТекста.UTF8);
			АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);

			ПараметрыЗаписиФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыЗаписиФайла.ВладелецФайлов     = Сценарий;
			ПараметрыЗаписиФайла.ИмяБезРасширения   = ДемонстрационныеСценарииКлиентСервер.ИмяФайлаОписанияСценария(
				ПолныйКод, КодЯзыка);
			ПараметрыЗаписиФайла.РасширениеБезТочки = "HTML";

			СтрокаОписания.ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(
				ПараметрыЗаписиФайла, АдресВоВременномХранилище, "");
			Сводка.СозданоФайлов = Сводка.СозданоФайлов + 1;
		КонецЕсли;

	КонецЦикла;

	// Условная запись: только если ТЧ ОписанияСценария реально изменилась.
	// Если все файлы уже существовали и обновились без записи в ТЧ — Записать()
	// не вызывается, лишнего срабатывания хуков нет.
	Если ОбъектСценария.Модифицированность() Тогда
		ОбъектСценария.Записать();
	КонецЕсли;

	Сводка.ОбработаноСценариев = Сводка.ОбработаноСценариев + 1;

КонецПроцедуры

// Авто-резолв существующего узла по предзагруженному кешу
// "Имя -> Массив {Ссылка, ЭтоГруппа}". Если в базе есть узел с тем же
// именем и типом (группа/элемент), возвращает решение "Обновить" с этой
// ссылкой. Иначе - Неопределено (узел будет создан новым).
//
// Используется в ОбработатьУзелРекурсивно, когда узел не попал в
// РешенияПоКонфликтам (форма конфликтов не открывалась или узел не был
// отмечен как конфликтный). Позволяет:
//   * не плодить дубли по наименованию;
//   * добавить связь с родителем из MD через уже идемпотентный вызов
//     ДобавитьСценарийВГруппу ниже по стеку.
//
// Параметры:
//  КешСуществующих - Соответствие из КлючИЗначение - результат НайтиСуществующихПоИмени,
//                       Ключ: Имя, Значение: Массив из Структура со полями
//                       Ссылка и ЭтоГруппа. Может быть Неопределено -
//                       тогда возвращается Неопределено (вырожденный
//                       случай, если кеш ещё не собран).
//  Узел           - СтрокаДереваЗначений - текущий узел из MD.
//  ЭтоГруппа      - Булево - признак группы для узла из MD (вычисляется
//                    как Узел.Строки.Количество() > 0).
//
// Возвращаемое значение:
//  Неопределено, Структура - описание решения авто-резолва
//                            (поля Действие и Ссылка).
//
Функция ГКСИ_АвтоРезолвУзлаПоКешу(КешСуществующих, Узел, ЭтоГруппа)

	Если КешСуществующих = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = Узел.Наименование;
	МассивОписаний = КешСуществующих.Получить(Имя);
	Если МассивОписаний = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Подходящие = Новый Массив;
	Для Каждого Описание Из МассивОписаний Цикл
		Если Описание.ЭтоГруппа = ЭтоГруппа Тогда
			Подходящие.Добавить(Описание.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Если Подходящие.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Подходящие.Количество() > 1 Тогда
		// Редкий случай: в базе несколько узлов с тем же именем и типом.
		// Берём первый попавшийся - дополнительная выборка "самого
		// свежего" потребовала бы ещё один запрос в цикле авто-резолва,
		// что снижает отдачу от фичи. Предупреждение в ЖР фиксирует
		// ситуацию для ручного разбора при необходимости.
		ЖурналВключенЛокально = ПолучитьИспользованиеЖурналаРегистрации().Количество() > 0;
		Если ЖурналВключенЛокально Тогда
			ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				"Авто-резолв: для узла """ + Имя + """ найдено "
				+ Подходящие.Количество() + " подходящих существующих узлов, "
				+ "используется первый: " + Подходящие[0]);
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Действие", "Обновить");
	Результат.Вставить("Ссылка",   Подходящие[0]);

	Возврат Результат;

КонецФункции

// Возвращает ГКСИ_ИнструкцияИсточник существующего узла по имени и ссылке
// из кеша НайтиСуществующихПоИмени. Используется в ОбработатьУзелРекурсивно
// для защиты от переиспользования чужих элементов: если авто-резолв вернул
// существующий узел, принадлежащий другой инструкции, мы сбрасываем решение
// и создаём новый элемент.
//
Функция ГКСИ_ПолучитьИнструкциюИсточникИзКеша(КешСуществующих, Имя, Ссылка)

	Если КешСуществующих = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	МассивОписаний = КешСуществующих.Получить(Имя);
	Если МассивОписаний = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Описание Из МассивОписаний Цикл
		Если Описание.Ссылка = Ссылка Тогда
			Возврат Описание.ИнструкцияИсточник;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Собирает уникальные наименования узлов из дерева значений в плоский
// массив строк. Используется для предварительного запроса к БД по
// существующим узлам перед обходом дерева (один пакетный запрос вместо
// запросов в цикле обхода).
//
// Параметры:
//  ДеревоУзлов - ДеревоЗначений.
//
// Возвращаемое значение:
//  Массив из Строка - уникальные наименования в порядке первого
//                     появления при обходе в глубину.
//
Функция ГКСИ_СобратьУникальныеИменаИзДерева(ДеревоУзлов)

	Результат = Новый Массив;
	Если ДеревоУзлов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	СоответствиеИмен = Новый Соответствие;

	// Итеративный обход в глубину через стек - без рекурсии, чтобы не
	// зависеть от лимита стека платформы на больших деревьях.
	СтекУзлов = Новый Массив;
	Для Каждого Корень Из ДеревоУзлов.Строки Цикл
		СтекУзлов.Добавить(Корень);
	КонецЦикла;

	Пока СтекУзлов.Количество() > 0 Цикл

		Узел = СтекУзлов[СтекУзлов.Количество() - 1];
		СтекУзлов.Удалить(СтекУзлов.Количество() - 1);

		Имя = Узел.Наименование;
		Если СоответствиеИмен.Получить(Имя) = Неопределено Тогда
			СоответствиеИмен.Вставить(Имя, Истина);
			Результат.Добавить(Имя);
		КонецЕсли;

		Для Каждого Дочерний Из Узел.Строки Цикл
			СтекУзлов.Добавить(Дочерний);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собирает все уникальные пути картинок из текстов дерева, ищет файлы,
// делает один запрос на дедупликацию и создаёт недостающие элементы.
// Возвращает готовую карту подмен для ОбработатьУзелРекурсивно.
//
// Параметры:
//  ДеревоУзлов                       - ДеревоЗначений.
//  КаталогПоиска                     - Строка - путь к каталогу с картинками на диске сервера.
//  АдресаКартинокВоВременномХранилище - Соответствие из КлючИЗначение - необязательный.
//                                       Ключ: ИмяФайла, Значение: адрес ВХ. Передаётся с клиента.
//  АдресПрогресса                    - Строка - адрес ВХ прогресса (необязательный).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Ключ: Строка (оригинальный путь), Значение: Строка (код файла).
//
Функция ПодготовитьКартинкиДляДерева(ДеревоУзлов, КаталогПоиска,
		АдресаКартинокВоВременномХранилище = Неопределено, АдресПрогресса = "")

	КартаПодмен = Новый Соответствие;

	ЕстьАдресаВХ = (АдресаКартинокВоВременномХранилище <> Неопределено
		И АдресаКартинокВоВременномХранилище.Количество() > 0);

	Если НЕ ЗначениеЗаполнено(КаталогПоиска) И НЕ ЕстьАдресаВХ Тогда
		Возврат КартаПодмен;
	КонецЕсли;

	// Собираем уникальные пути из всех узлов.
	УникальныеПути = Новый Соответствие;
	СобратьПутиКартинокИзДерева(ДеревоУзлов, УникальныеПути);

	ВсегоКартинок = УникальныеПути.Количество();
	Если ВсегоКартинок = 0 Тогда
		Возврат КартаПодмен;
	КонецЕсли;

	// Шаг 0 (разово). Один рекурсивный обход диска для построения индекса
	// файлов картинок по имени. Используется в НайтиКартинкуИПосчитатьХеш
	// вместо серии повторных поисков НайтиФайлы по маске (на больших
	// каталогах это снижает сложность с O(n × m) до O(m)). Строится
	// только когда каталог задан и поиск на диске реально понадобится —
	// при чистом сценарии с ВХ индекс не нужен.
	ИндексФайловКаталога = Неопределено;
	Если ЗначениеЗаполнено(КаталогПоиска) Тогда
		ИндексФайловКаталога = ИндексФайловКаталогаКартинок(КаталогПоиска);
	КонецЕсли;

	// Шаг обновления прогресса на этапе 2 — не на каждую картинку, а через
	// шаг (1% от всего, но не реже чем каждую картинку и не чаще чем каждые 50).
	ШагПрогрессаКартинок = Макс(1, Мин(50, Цел(ВсегоКартинок / 100)));

	// На диске/ВХ ищем и считаем хеши.
	СоответствиеПутьРезультат = Новый Соответствие;
	МассивХешей = Новый Массив;
	Найдено = 0;
	СчетчикИтераций = 0;
	Для Каждого КИЗ Из УникальныеПути Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		РезультатПоиска = НайтиКартинкуИПосчитатьХеш(
			ОригинальныйПуть, КаталогПоиска, АдресаКартинокВоВременномХранилище,
			ИндексФайловКаталога);

		Если РезультатПоиска.Найден Тогда
			СоответствиеПутьРезультат.Вставить(ОригинальныйПуть, РезультатПоиска);
			МассивХешей.Добавить(РезультатПоиска.Хеш);
			Найдено = Найдено + 1;
		Иначе
			КартаПодмен.Вставить(ОригинальныйПуть, "");
		КонецЕсли;

		СчетчикИтераций = СчетчикИтераций + 1;
		Если СчетчикИтераций % ШагПрогрессаКартинок = 0 Тогда
			ЗаписатьПрогресс(АдресПрогресса, 2, Найдено, ВсегоКартинок,
				СтрШаблон(НСтр("ru = 'Поиск картинки: %1'"), ОригинальныйПуть));
		КонецЕсли;

	КонецЦикла;

	// Один запрос на дедупликацию.
	СоответствиеХешКод = ХешиСуществующихФайлов(МассивХешей);

	Если ПолучитьИспользованиеЖурналаРегистрации().Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Информация, , ,
			"Диагностика D2: уникальных хешей=" + МассивХешей.Количество()
			+ ", найдено в БД=" + СоответствиеХешКод.Количество()
			+ ", из них дублей внутри загрузки="
			+ (СоответствиеПутьРезультат.Количество() - МассивХешей.Количество()));
	КонецЕсли;

	// Создание недостающих файлов.
	СозданоНовых = 0;
	Для Каждого КИЗ Из СоответствиеПутьРезультат Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		РезультатПоиска  = КИЗ.Значение;
		Хеш = РезультатПоиска.Хеш;

		КодФайла = СоответствиеХешКод.Получить(Хеш);
		Если НЕ ЗначениеЗаполнено(КодФайла) Тогда
			КодФайла = СоздатьЭлементФайлаИнструкции(
				РезультатПоиска.ИмяФайла, РезультатПоиска.ДвоичныеДанные, Хеш);
			СоответствиеХешКод.Вставить(Хеш, КодФайла);
			СозданоНовых = СозданоНовых + 1;
		КонецЕсли;

		КартаПодмен.Вставить(ОригинальныйПуть, КодФайла);

	КонецЦикла;

	// Финал этапа 2.
	ЗаписатьПрогресс(АдресПрогресса, 2, ВсегоКартинок, ВсегоКартинок,
		СтрШаблон(НСтр("ru = 'Загружено картинок: %1 (новых: %2)'"), ВсегоКартинок, СозданоНовых));

	Возврат КартаПодмен;

КонецФункции

// Синхронно (до запуска фонового задания) читает адреса картинок из ВХ,
// находит файлы, считает хеши и создаёт недостающие элементы
// справочника ГКСИ_ФайлыИнструкций. Возвращает адрес ВХ (без UID) с
// готовой картой подмен ОригинальныйПуть -> КодФайла.
//
// Используется в клиент-серверной базе, когда файлы .md и картинки
// находятся на машине клиента (например, на сетевом ресурсе \\comp\share),
// недоступной серверу 1С напрямую. В этом случае:
//  1. Форма помещает выбранные картинки во ВХ основного сеанса;
//  2. Форма синхронно вызывает ПодготовитьФайлыИнструкцийНаСервере()
//     на сервере — здесь читаем двоичные данные, считаем хеши,
//     создаём элементы;
//  3. В фоновое задание передаём уже готовую карту подмен
//     (см. ЗаписатьДеревоВСправочник), без обращения к диску.
//
// Параметры:
//  ДеревоУзлов                       - ДеревоЗначений.
//  АдресаКартинокВоВременномХранилище - Соответствие из КлючИЗначение.
//                                       Ключ: ИмяФайла, Значение: адрес ВХ.
//  АдресПрогресса                    - Строка - адрес ВХ прогресса
//                                       (необязательный).
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище с готовой картой подмен
//           (Соответствие ОригинальныйПуть -> Строка-КодФайла). Пустая
//           строка, если картинок в дереве нет.
//
//@skip-warning
Функция ПодготовитьФайлыИнструкций(ДеревоУзлов,
		АдресаКартинокВоВременномХранилище = Неопределено,
		АдресПрогресса = "") Экспорт

	КартаПодмен = Новый Соответствие;

	Если ДеревоУзлов = Неопределено Тогда
		Возврат ПоместитьВоВременноеХранилище(КартаПодмен, Неопределено);
	КонецЕсли;

	ЕстьАдресаВХ = (АдресаКартинокВоВременномХранилище <> Неопределено
		И АдресаКартинокВоВременномХранилище.Количество() > 0);

	Если НЕ ЕстьАдресаВХ Тогда
		// Картинок с клиента не пришло — карта пустая, не ищем.
		Возврат ПоместитьВоВременноеХранилище(КартаПодмен, Неопределено);
	КонецЕсли;

	// Собираем уникальные пути из всех узлов.
	УникальныеПути = Новый Соответствие;
	СобратьПутиКартинокИзДерева(ДеревоУзлов, УникальныеПути);

	ВсегоКартинок = УникальныеПути.Количество();
	Если ВсегоКартинок = 0 Тогда
		Возврат ПоместитьВоВременноеХранилище(КартаПодмен, Неопределено);
	КонецЕсли;

	ШагПрогрессаКартинок = Макс(1, Мин(50, Цел(ВсегоКартинок / 100)));

	СоответствиеПутьРезультат = Новый Соответствие;
	МассивХешей = Новый Массив;
	Найдено = 0;
	СчетчикИтераций = 0;
	Для Каждого КИЗ Из УникальныеПути Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		РезультатПоиска = НайтиКартинкуИПосчитатьХеш(
			ОригинальныйПуть, "", АдресаКартинокВоВременномХранилище);

		Если РезультатПоиска.Найден Тогда
			СоответствиеПутьРезультат.Вставить(ОригинальныйПуть, РезультатПоиска);
			МассивХешей.Добавить(РезультатПоиска.Хеш);
			Найдено = Найдено + 1;
		Иначе
			КартаПодмен.Вставить(ОригинальныйПуть, "");
		КонецЕсли;

		СчетчикИтераций = СчетчикИтераций + 1;
		Если СчетчикИтераций % ШагПрогрессаКартинок = 0 Тогда
			ЗаписатьПрогресс(АдресПрогресса, 2, Найдено, ВсегоКартинок,
				СтрШаблон(НСтр("ru = 'Поиск картинки: %1'"), ОригинальныйПуть));
		КонецЕсли;

	КонецЦикла;

	СоответствиеХешКод = ХешиСуществующихФайлов(МассивХешей);

	Если ПолучитьИспользованиеЖурналаРегистрации().Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Информация, , ,
			"Предзагрузка картинок: уникальных хешей=" + МассивХешей.Количество()
			+ ", найдено в БД=" + СоответствиеХешКод.Количество());
	КонецЕсли;

	СозданоНовых = 0;
	Для Каждого КИЗ Из СоответствиеПутьРезультат Цикл

		ОригинальныйПуть = КИЗ.Ключ;
		РезультатПоиска  = КИЗ.Значение;
		Хеш = РезультатПоиска.Хеш;

		КодФайла = СоответствиеХешКод.Получить(Хеш);
		Если НЕ ЗначениеЗаполнено(КодФайла) Тогда
			КодФайла = СоздатьЭлементФайлаИнструкции(
				РезультатПоиска.ИмяФайла, РезультатПоиска.ДвоичныеДанные, Хеш);
			СоответствиеХешКод.Вставить(Хеш, КодФайла);
			СозданоНовых = СозданоНовых + 1;
		КонецЕсли;

		КартаПодмен.Вставить(ОригинальныйПуть, КодФайла);

	КонецЦикла;

	ЗаписатьПрогресс(АдресПрогресса, 2, ВсегоКартинок, ВсегоКартинок,
		СтрШаблон(НСтр("ru = 'Загружено картинок: %1 (новых: %2)'"), ВсегоКартинок, СозданоНовых));

	Возврат ПоместитьВоВременноеХранилище(КартаПодмен, Неопределено);

КонецФункции

// Считает общее число строк в дереве (включая корень и все дочерние).
//
// Параметры:
//  Узел - ДеревоЗначений или СтрокаДереваЗначений.
//
// Возвращаемое значение:
//  Число.
//
//@skip-warning SU15 - параметр Узел принимает ДеревоЗначений или СтрокаДереваЗначений,
//  в EDT нет синтаксиса для типизации через ИЛИ, поэтому предупреждение подавлено явно.
Функция ПосчитатьВсеУзлыДерева(Узел)

	Если Узел = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Счетчик = 0;
	Для Каждого Строка Из Узел.Строки Цикл
		Счетчик = Счетчик + 1 + ПосчитатьВсеУзлыДерева(Строка);
	КонецЦикла;
	Возврат Счетчик;

КонецФункции

// Рекурсивно собирает уникальные пути картинок из текстов всех узлов дерева.
//
// Параметры:
//  Узел           - ДеревоЗначений - корень или поддерево.
//  УникальныеПути - Соответствие из КлючИЗначение - пополняемое соответствие.
//
Процедура СобратьПутиКартинокИзДерева(Узел, УникальныеПути)
	СобратьПутиКартинокИзУзла(Узел, УникальныеПути);
КонецПроцедуры

// Обход подстрок одного узла. Выделено, чтобы линтер видел конкретный тип.
//
// Параметры:
//  Узел           - СтрокаДереваЗначений - строка дерева.
//  УникальныеПути - Соответствие из КлючИЗначение - пополняемое соответствие.
//
Процедура СобратьПутиКартинокИзУзла(Узел, УникальныеПути)

	Для Каждого Строка Из Узел.Строки Цикл

		Если ЗначениеЗаполнено(Строка.ТекстMarkdown) Тогда

			// Obsidian: ![[path]] и ![[path|extra]]
			Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
				Строка.ТекстMarkdown, "!\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", Истина);
			Для Каждого Совпадение Из Совпадения Цикл
				Группы = Совпадение.ПолучитьГруппы();
				Если Группы.Количество() > 0 И Группы[0] <> Неопределено
					И Группы[0].Значение <> Неопределено Тогда
					УникальныеПути.Вставить(Группы[0].Значение, Истина);
				КонецЕсли;
			КонецЦикла;

			// Стандартный markdown: ![alt](path)
			Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
				Строка.ТекстMarkdown, "!\[[^\]]*\]\(([^)]+)\)", Истина);
			Для Каждого Совпадение Из Совпадения Цикл
				Группы = Совпадение.ПолучитьГруппы();
				Если Группы.Количество() > 0 И Группы[0] <> Неопределено
					И Группы[0].Значение <> Неопределено Тогда
					Путь = Группы[0].Значение;
					Если УникальныеПути.Получить(Путь) = Неопределено Тогда
						УникальныеПути.Вставить(Путь, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

		СобратьПутиКартинокИзУзла(Строка, УникальныеПути);

	КонецЦикла;

КонецПроцедуры

// Подменяет в тексте Markdown ссылки на картинки по готовой карте.
// Поддерживает три варианта:
//   - Obsidian: ![[path]]
//   - Obsidian с extra: ![[path|size|caption]]
//   - Стандартный markdown: ![alt](path)
//
// Для каждого совпадения ищет «чистый путь» в карте подмен (для Obsidian —
// до `|...`, для markdown — это сам url). Если нашёл — заменяет всё
// совпадение на ![](GUID). Если нет — на ❌ <путь>, чтобы пользователь
// видел неподгруженную картинку.
//
// Замены собираются в массив и применяются с конца строки — так позиции
// более ранних совпадений не сбиваются при изменении длины.
//
// Параметры:
//  ТекстMarkdown         - Строка.
//  КартаПодменКартинок   - Соответствие из КлючИЗначение - Ключ: оригинальный путь, Значение: код файла.
//
// Возвращаемое значение:
//  Строка - текст с подменёнными ссылками.
//
Функция ПодменитьСсылкиНаКартинкиВТексте(ТекстMarkdown, КартаПодменКартинок)

	Результат = ТекстMarkdown;
	Замены = Новый Массив;

	ДобавитьЗаменыПоРегулярномуВыражению(Результат,
		"!\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", КартаПодменКартинок, Замены);

	ДобавитьЗаменыПоРегулярномуВыражению(Результат,
		"!\[[^\]]*\]\(([^)]+)\)", КартаПодменКартинок, Замены);

	// Применяем с конца, чтобы не сбивать позиции остальных замен.
	// Для пустого массива Замены.ВГраница() = -1, цикл не выполнится ни разу.
	Для Счётчик = 0 По Замены.ВГраница() Цикл
		Замена = Замены[Замены.ВГраница() - Счётчик];
		Результат = Лев(Результат, Замена.Позиция - 1)
			+ Замена.Текст
			+ Сред(Результат, Замена.Позиция + Замена.Длина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сканирует Текст регулярным выражением, для каждого совпадения с захватом
// пути в группе 1 ищет путь в КартеПодмен и добавляет в массив Замены
// структуру {Позиция, Длина, Текст} с готовой строкой замены.
//
// Параметры:
//  Текст               - Строка - исходный текст.
//  РегулярноеВыражение - Строка - паттерн с одной захватывающей группой (путь).
//  КартаПодмен         - Соответствие из КлючИЗначение - Ключ: путь, Значение: код файла.
//  Замены              - Массив из Структура - пополняемый массив структур замен.
//
Процедура ДобавитьЗаменыПоРегулярномуВыражению(Текст, РегулярноеВыражение, КартаПодмен, Замены)

	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(
		Текст, РегулярноеВыражение, Истина);

	Для Каждого Совпадение Из Совпадения Цикл
		Группы = Совпадение.ПолучитьГруппы();
		Если Группы.Количество() = 0
			ИЛИ Группы[0] = Неопределено
			ИЛИ Группы[0].Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Путь = Группы[0].Значение;
		КодФайла = КартаПодмен.Получить(Путь);
		НовыйТекст = ?(ЗначениеЗаполнено(КодФайла),
			"![](" + КодФайла + ")",
			"❌ " + Путь);

		Замены.Добавить(Новый Структура("Позиция, Длина, Текст",
			Совпадение.НачальнаяПозиция, Совпадение.Длина, НовыйТекст));
	КонецЦикла;

КонецПроцедуры

// Заполняет реквизиты объекта (группы или элемента) на основании узла дерева.
// Поле "Родитель" намеренно не заполняется — оно обнуляется в
// ГКСИ_ПередЗаписью (см. ObjectModule ДемонстрационныеСценарии).
// ГКСИ_ТекстMarkdown хранит текст в мультиязычном формате с маркерами
// <!--md:lang:КОД-->...<!--/md:lang:КОД>, который понимает форма элемента
// справочника.
// При создании/обновлении узла выставляется статус "НаПроверке" —
// сценарий только что загружен из файла и требует ревью.
//
// Параметры:
//  ОбъектУзла - СправочникОбъект.ДемонстрационныеСценарии.
//  Узел       - СтрокаДереваЗначений.
//  КодЯзыка   - Строка.
//  ТекстУзла  - Строка - обработанный текст (после подмены ![[...]]).
//
Процедура ЗаполнитьРеквизитыУзла(ОбъектУзла, Узел, КодЯзыка, ТекстУзла)

	ОбъектУзла.Наименование           = Узел.Наименование;
	ОбъектУзла.ГКСИ_ТекстMarkdown      = ОбернутьВМаркерыЯзыка(ТекстУзла, КодЯзыка);
	ОбъектУзла.ГКСИ_MarkdownСформирован = Истина;
	ОбъектУзла.Статус                 = Перечисления.СтатусыДемонстрационныхСценариев.НаПроверке;

КонецПроцедуры

// Добавляет строку в таблицу результата.
//
// Параметры:
//  Результат - ТаблицаЗначений.
//  Наименование - Строка.
//  Действие - Строка.
//  Ссылка - СправочникСсылка.ДемонстрационныеСценарии.
//  ТекстОшибки - Строка.
//
Процедура ДобавитьСтрокуРезультата(Результат, Наименование, Действие, Ссылка, ТекстОшибки)

	Строка = Результат.Добавить();
	Строка.Наименование = Наименование;
	Строка.Действие     = Действие;
	Строка.Ссылка       = Ссылка;
	Строка.ТекстОшибки  = ТекстОшибки;

КонецПроцедуры

// Возвращает имя файла без расширения и пути.
// Из "C:\folder\тестовый файл.md" -> "тестовый файл".
//
// Параметры:
//  ПолноеИмяФайла - Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяФайлаБезРасширения(ПолноеИмяФайла)

	Если НЕ ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		Возврат "";
	КонецЕсли;

	Имя = СтрЗаменить(ПолноеИмяФайла, "/", "\");
	ПозицияСлеша = СтрНайти(Имя, "\", НаправлениеПоиска.СКонца);
	Если ПозицияСлеша > 0 Тогда
		Имя = Сред(Имя, ПозицияСлеша + 1);
	КонецЕсли;

	ПозицияТочки = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки > 1 Тогда
		Имя = Лев(Имя, ПозицияТочки - 1);
	КонецЕсли;

	Возврат СокрЛП(Имя);

КонецФункции

// Оборачивает произвольный текст в маркеры языка, принятые в форме элемента
// справочника (формат хранения ГКСИ_ТекстMarkdown).
//
// Параметры:
//  ТекстMarkdown - Строка - исходный текст (без маркеров).
//  КодЯзыка      - Строка - код языка.
//
// Возвращаемое значение:
//  Строка - текст, обёрнутый маркерами <!--md:lang:КОД-->...<!--/md:lang:КОД-->.
//
Функция ОбернутьВМаркерыЯзыка(ТекстMarkdown, КодЯзыка)

	Если НЕ ЗначениеЗаполнено(ТекстMarkdown) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "<!--md:lang:" + КодЯзыка + "-->"
		+ Символы.ПС
		+ ТекстMarkdown
		+ Символы.ПС
		+ "<!--/md:lang:" + КодЯзыка + "-->";

КонецФункции

// Добавление/обновление строки ТЧ ОписанияСценария выполняется в нашем
// ObjectModule.ГКСИ_ПередЗаписью (см. ГКСИ_СоздатьПрисоединенныеФайлыИзДопСвойств).
// Прямой доступ из обработки больше не нужен.

// Находит файл картинки на диске по оригинальному пути из ![[...]]
// и возвращает структуру с именем, двоичными данными и SHA-256.
// Без обращения к БД. Без записи.
//
// Параметры:
//  ОригинальныйПуть - Строка - путь к картинке в ![[...]] (Obsidian-формат).
//  КаталогПоиска    - Строка - каталог, относительно которого ищем.
//
// Возвращаемое значение:
//  Структура - с полями:
//   * Найден          - Булево - true, если файл найден.
//   * ИмяФайла        - Строка - имя файла без пути.
//   * ДвоичныеДанные   - ДвоичныеДанные - пустые, если файл не найден.
//   * Хеш             - Строка - SHA-256, пустая, если файл не найден.
//
// Находит двоичные данные картинки и считает SHA-256.
//
// Источник поиска (по приоритету):
//  1. АдресаКартинокВоВременномХранилище - Соответствие (ИмяФайла -> АдресВХ).
//     Используется, когда картинки передаются с клиента через временное
//     хранилище (тонкий клиент при сервере 1С на другой машине).
//  2. КаталогПоиска на диске сервера. Если передан ИндексФайловКаталога —
//     поиск идёт в нём за O(1) (см. ИндексФайловКаталогаКартинок). Иначе —
//     резервный путь через НайтиФайлы (для обратной совместимости и редких
//     сценариев вызова без индекса).
//
// Параметры:
//  ОригинальныйПуть                       - Строка - путь картинки из ![[...]].
//  КаталогПоиска                          - Строка - путь к каталогу на диске сервера.
//  АдресаКартинокВоВременномХранилище     - Соответствие из КлючИЗначение -
//                                           необязательный. Ключ: ИмяФайла, Значение: адрес ВХ.
//  ИндексФайловКаталога                   - Соответствие из КлючИЗначение -
//                                           необязательный. Ключ: имя файла в нижнем регистре,
//                                           Значение: полное имя файла на диске. Если передан —
//                                           используется вместо повторного поиска НайтиФайлы.
//
// Возвращаемое значение:
//  Структура:
//   * Найден         - Булево.
//   * ИмяФайла       - Строка.
//   * ДвоичныеДанные - ДвоичныеДанные.
//   * Хеш            - Строка.
//@skip-warning SU13
Функция НайтиКартинкуИПосчитатьХеш(ОригинальныйПуть, КаталогПоиска,
		АдресаКартинокВоВременномХранилище = Неопределено,
		ИндексФайловКаталога = Неопределено)

	ПустыеДвоичныеДанные = ПолучитьДвоичныеДанныеИзBase64Строки("");

	Результат = Новый Структура;
	Результат.Вставить("Найден",          Ложь);
	Результат.Вставить("ИмяФайла",        "");
	Результат.Вставить("ДвоичныеДанные",  ПустыеДвоичныеДанные);
	Результат.Вставить("Хеш",             "");

	// Нормализация пути: обрезать #anchor и |альт.
	НормализованныйПуть = ОригинальныйПуть;
	ПозицияЯкоря = СтрНайти(НормализованныйПуть, "#");
	Если ПозицияЯкоря > 0 Тогда
		НормализованныйПуть = Лев(НормализованныйПуть, ПозицияЯкоря - 1);
	КонецЕсли;
	ПозицияАльта = СтрНайти(НормализованныйПуть, "|");
	Если ПозицияАльта > 0 Тогда
		НормализованныйПуть = Лев(НормализованныйПуть, ПозицияАльта - 1);
	КонецЕсли;
	НормализованныйПуть = СокрЛП(НормализованныйПуть);

	Если НЕ ЗначениеЗаполнено(НормализованныйПуть) Тогда
		Возврат Результат;
	КонецЕсли;

	// Имя файла с расширением.
	ИмяФайла = СтрЗаменить(НормализованныйПуть, "/", "\");
	ПозицияСлеша = СтрНайти(ИмяФайла, "\", НаправлениеПоиска.СКонца);
	Если ПозицияСлеша > 0 Тогда
		ИмяФайла = Сред(ИмяФайла, ПозицияСлеша + 1);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат Результат;
	КонецЕсли;

	ДвоичныеДанные = ПустыеДвоичныеДанные;
	НайденыДвоичныеДанные = Ложь;

	// Шаг 1. Поиск среди переданных с клиента картинок (по имени файла,
	// без учёта регистра). Это сценарий тонкого клиента при сервере 1С
	// на другой машине, когда локальные пути RDP-компьютера серверу
	// недоступны.
	Если АдресаКартинокВоВременномХранилище <> Неопределено Тогда
		ИмяФайлаНижний = НРег(ИмяФайла);
		Для Каждого КИЗ Из АдресаКартинокВоВременномХранилище Цикл
			Если НРег(КИЗ.Ключ) = ИмяФайлаНижний Тогда
				АдресВХ = КИЗ.Значение;
				Если ТипЗнч(АдресВХ) = Тип("Строка") И ЗначениеЗаполнено(АдресВХ) Тогда
					ДанныеИзВХ = ПолучитьИзВременногоХранилища(АдресВХ);
					Если ТипЗнч(ДанныеИзВХ) = Тип("ДвоичныеДанные")
							И ДанныеИзВХ.Размер() > 0 Тогда
						ДвоичныеДанные = ДанныеИзВХ;
						НайденыДвоичныеДанные = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Шаг 2. Если в ВХ не нашли — ищем на диске сервера.
	Если НЕ НайденыДвоичныеДанные И ЗначениеЗаполнено(КаталогПоиска) Тогда
		ПолноеИмяФайла = "";
		Если ИндексФайловКаталога <> Неопределено Тогда
			// Быстрый путь: поиск в индексе, собранном один раз до цикла.
			ПолноеИмяФайла = ИндексФайловКаталога.Получить(НРег(ИмяФайла));
		Иначе
			// Резервный путь (обратная совместимость): поиск файла на диске
			// по имени, при провале — рекурсивный обход каталога по маске.
			// Медленно на больших каталогах, поэтому в основном потоке
			// вызов идёт с уже построенным индексом.
			ФайлыВКорне = НайтиФайлыВКаталоге(КаталогПоиска, ИмяФайла);
			Если ФайлыВКорне.Количество() > 0 Тогда
				ПолноеИмяФайла = ФайлыВКорне[0].ПолноеИмя;
			Иначе
				Расширение = ПолучитьРасширениеФайла(ИмяФайла);
				Если ЭтоРасширениеКартинки(Расширение) Тогда
					МаскаФайлов = "*" + Расширение;
					ФайлыРекурсивно = НайтиФайлыВКаталоге(КаталогПоиска, МаскаФайлов);
					Для Каждого Файл Из ФайлыРекурсивно Цикл
						Если НРег(Файл.Имя) = НРег(ИмяФайла) Тогда
							ПолноеИмяФайла = Файл.ПолноеИмя;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
			ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
			НайденыДвоичныеДанные = Истина;
		КонецЕсли;
	КонецЕсли;

	Если НЕ НайденыДвоичныеДанные Тогда
		Возврат Результат;
	КонецЕсли;

	Хеш = ВычислитьSHA256(ДвоичныеДанные);

	Результат.Вставить("Найден",         Истина);
	Результат.Вставить("ИмяФайла",       ИмяФайла);
	Результат.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	Результат.Вставить("Хеш",            Хеш);

	Возврат Результат;

КонецФункции

// Обёртка-синоним для обратной совместимости со старым именем функции.
//@skip-warning
Функция НайтиКартинкуНаДискеИПосчитатьХеш(ОригинальныйПуть, КаталогПоиска)
	Возврат НайтиКартинкуИПосчитатьХеш(ОригинальныйПуть, КаталогПоиска, Неопределено);
КонецФункции

// Одним пакетным запросом возвращает соответствие Хеш -> Код файла инструкции
// для всех существующих в справочнике файлов с указанными хешами.
// Используется для дедупликации картинок при импорте.
//
// Параметры:
//  МассивХешей - Массив из Строка - hex-представления SHA-256.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Ключ: Строка (хеш), Значение: Строка (код-GUID).
//
Функция ХешиСуществующихФайлов(МассивХешей)

	Результат = Новый Соответствие;

	Если МассивХешей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГКСИ_ФайлыИнструкций.ХешSHA256 КАК ХешSHA256,
	|	ГКСИ_ФайлыИнструкций.Код КАК Код
	|ИЗ
	|	Справочник.ГКСИ_ФайлыИнструкций КАК ГКСИ_ФайлыИнструкций
	|ГДЕ
	|	ГКСИ_ФайлыИнструкций.ХешSHA256 В (&МассивХешей)
	|	И НЕ ГКСИ_ФайлыИнструкций.ПометкаУдаления";
	Запрос.УстановитьПараметр("МассивХешей", МассивХешей);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ХешSHA256, Выборка.Код);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт новый элемент справочника ГКСИ_ФайлыИнструкций и возвращает его код.
// Предполагается, что вызывающий код уже проверил отсутствие такого хеша
// в БД (через ХешиСуществующихФайлов) и в локальном кэше.
//
// Параметры:
//  ИмяФайла      - Строка - имя файла без пути.
//  ДвоичныеДанные - ДвоичныеДанные.
//  Хеш           - Строка - SHA-256.
//
// Возвращаемое значение:
//  Строка - код (GUID) созданного элемента.
//
Функция СоздатьЭлементФайлаИнструкции(ИмяФайла, ДвоичныеДанные, Хеш)

	ИмяБезРасширения = ИмяФайлаБезРасширения(ИмяФайла);
	РасширениеБезТочки = ПолучитьРасширениеФайла(ИмяФайла);
	Если СтрНачинаетсяС(РасширениеБезТочки, ".") Тогда
		РасширениеБезТочки = Сред(РасширениеБезТочки, 2);
	КонецЕсли;

	НовыйФайл = Справочники.ГКСИ_ФайлыИнструкций.СоздатьЭлемент();
	НовыйФайл.Наименование = ИмяБезРасширения;
	НовыйФайл.Расширение   = НРег(РасширениеБезТочки);
	НовыйФайл.Файл         = Новый ХранилищеЗначения(ДвоичныеДанные);
	НовыйФайл.ХешSHA256    = Хеш;
	НовыйФайл.Описание     = НСтр("ru = 'Загружен при импорте сценариев из Markdown'");
	НовыйФайл.Код          = Строка(Новый УникальныйИдентификатор());
	НовыйФайл.Записать();

	Возврат НовыйФайл.Код;

КонецФункции

// Возвращает расширение файла (с точкой) из полного или относительного имени.
//
// Параметры:
//  ИмяФайла - Строка.
//
// Возвращаемое значение:
//  Строка - расширение с точкой (например, ".png") или пустая строка.
//
Функция ПолучитьРасширениеФайла(ИмяФайла)

	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;

	ПозицияТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(ИмяФайла, ПозицияТочки);

КонецФункции

#Область ПрогрессДлительнойОперации

// Этапы прогресса загрузки сценариев.
// Шкала: 0..100%.
//   1. Парсинг файла:          0..10%.
//   2. Загрузка картинок:     10..30%.
//   3. Запись в справочник:   30..100%.

// Создаёт структуру прогресса во временном хранилище и возвращает её адрес.
// Вызывается на сервере перед стартом длительной операции.
//
// Параметры:
//  ВсегоЭтапов - Число - число логических этапов (по умолчанию 3).
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище.
//
Функция ИнициализироватьПрогресс(ВсегоЭтапов = 3) Экспорт

	СтруктураПрогресса = Новый Структура;
	СтруктураПрогресса.Вставить("Статус",             "Выполняется");
	СтруктураПрогресса.Вставить("Этап",               0);
	СтруктураПрогресса.Вставить("ВсегоЭтапов",        ВсегоЭтапов);
	СтруктураПрогресса.Вставить("ТекущееЗначение",    0);
	СтруктураПрогресса.Вставить("ВсегоВЭтапе",        0);
	СтруктураПрогресса.Вставить("Сообщение",          "");
	СтруктураПрогресса.Вставить("ТекстОшибки",        "");
	СтруктураПрогресса.Вставить("ПроцентГотовности",  0);

	Возврат ПоместитьВоВременноеХранилище(СтруктураПрогресса, Новый УникальныйИдентификатор);

КонецФункции

// Записывает текущее состояние прогресса во временное хранилище.
//
// Параметры:
//  АдресПрогресса    - Строка - адрес, возвращённый ИнициализироватьПрогресс.
//  Этап              - Число  - номер текущего этапа (1..ВсегоЭтапов).
//  ТекущееЗначение   - Число  - сколько элементов обработано в этапе.
//  ВсегоВЭтапе       - Число  - сколько всего элементов в этапе.
//  Сообщение         - Строка - текст текущей операции (имя узла, файла).
//  ЭтоОшибка         - Булево - признак аварийного завершения.
//  ТекстОшибки       - Строка - описание ошибки (если есть).
//
Процедура ЗаписатьПрогресс(АдресПрогресса, Этап, ТекущееЗначение, ВсегоВЭтапе,
		Сообщение = "", ЭтоОшибка = Ложь, ТекстОшибки = "") Экспорт

	Если НЕ ЗначениеЗаполнено(АдресПрогресса) Тогда
		Возврат;
	КонецЕсли;

	СтруктураПрогресса = ПолучитьИзВременногоХранилища(АдресПрогресса);
	Если СтруктураПрогресса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураПрогресса.Этап             = Этап;
	СтруктураПрогресса.ТекущееЗначение  = ТекущееЗначение;
	СтруктураПрогресса.ВсегоВЭтапе      = ВсегоВЭтапе;
	СтруктураПрогресса.Сообщение        = Сообщение;

	Если ЭтоОшибка Тогда
		СтруктураПрогресса.Статус       = "Ошибка";
		СтруктураПрогресса.ТекстОшибки  = ТекстОшибки;
		СтруктураПрогресса.ПроцентГотовности = 100;
	ИначеЕсли Этап > СтруктураПрогресса.ВсегоЭтапов Тогда
		СтруктураПрогресса.Статус       = "Готово";
		СтруктураПрогресса.ПроцентГотовности = 100;
	Иначе
		СтруктураПрогресса.Статус       = "Выполняется";
		СтруктураПрогресса.ПроцентГотовности = ПроцентГотовности(
			Этап, ТекущееЗначение, ВсегоВЭтапе, СтруктураПрогресса.ВсегоЭтапов);
	КонецЕсли;

	ПоместитьВоВременноеХранилище(СтруктураПрогресса, АдресПрогресса);

КонецПроцедуры

// Возвращает структуру текущего прогресса.
// Клиент вызывает в обработчике ожидания раз в секунду.
//
// Параметры:
//  АдресПрогресса - Строка - адрес во временном хранилище.
//
// Возвращаемое значение:
//  Структура, Неопределено - если адрес пустой или данные недоступны.
//
Функция ПолучитьПрогресс(АдресПрогресса) Экспорт

	Если НЕ ЗначениеЗаполнено(АдресПрогресса) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьИзВременногоХранилища(АдресПрогресса);

КонецФункции

// Пересчитывает общий процент готовности на основе шкалы:
//   1 этап: 0..10, 2 этап: 10..30, 3 этап: 30..100.
//
// Параметры:
//  Этап              - Число - номер текущего этапа (1..ВсегоЭтапов).
//  ТекущееЗначение   - Число - сколько элементов обработано в этапе.
//  ВсегоВЭтапе       - Число - сколько всего элементов в этапе.
//  ВсегоЭтапов       - Число - сколько этапов всего.
//
// Возвращаемое значение:
//  Число - процент готовности (0..100).
//
Функция ПроцентГотовности(Этап, ТекущееЗначение, ВсегоВЭтапе, ВсегоЭтапов)

	МассивГраниц = Новый Массив;
	МассивГраниц.Добавить(0);
	МассивГраниц.Добавить(10);
	МассивГраниц.Добавить(30);
	МассивГраниц.Добавить(100);

	Если ВсегоЭтапов >= 3 Тогда
		НачалоЭтапа = МассивГраниц[Этап - 1];
		КонецЭтапа  = МассивГраниц[Этап];
	ИначеЕсли ВсегоЭтапов = 2 Тогда
		Если Этап = 1 Тогда
			НачалоЭтапа = 0;
			КонецЭтапа  = 10;
		Иначе
			НачалоЭтапа = 10;
			КонецЭтапа  = 100;
		КонецЕсли;
	ИначеЕсли ВсегоЭтапов = 1 Тогда
		НачалоЭтапа = 0;
		КонецЭтапа  = 100;
	Иначе
		Возврат 0;
	КонецЕсли;

	Если ВсегоВЭтапе <= 0 Тогда
		Возврат НачалоЭтапа;
	КонецЕсли;

	ДоляЭтапа = Мин(1, ТекущееЗначение / ВсегоВЭтапе);
	Возврат Цел(НачалоЭтапа + (КонецЭтапа - НачалоЭтапа) * ДоляЭтапа);

КонецФункции

