// Запускает бизнес-процесс согласования элемента инструкции на сервере.
//
// Параметры:
//	ВсяИнструкция - Булево - Истина для согласования всей инструкции,
//	                Ложь - для согласования отдельного элемента.
//
// Возвращаемое значение:
//	Структура, Неопределено - параметры открытия формы первой задачи бизнес-процесса.
//
&НаСервере
Функция ГКСИ_ЗапуститьСогласованиеНаСервере(ВсяИнструкция)
	
	ВидСогласования = ?(ВсяИнструкция,
		Перечисления.ГКСИ_ВидыСогласованияИнструкций.ВсяИнструкция,
		Перечисления.ГКСИ_ВидыСогласованияИнструкций.ЭлементИнструкции);
	
	Процесс = ГКСИ_СогласованиеИнструкцийСервер.ЗапуститьСогласование(Объект.Ссылка, ВидСогласования);
	
	Возврат ГКСИ_СогласованиеИнструкцийСервер.ПараметрыОткрытияПервойЗадачи(Процесс);
	
КонецФункции

// Открывает видеофайл внешним плеером, если нажатие было по запасной ссылке
// видеоплеера (атрибут data-gksi-video, формируется в модуле ГКСИ_Видео).
// Нужна для типовых HTML-полей ТекстСценария / ТекстСценарияЧтение, где
// обработчик нажатия не наш.
//
// Параметры:
//   ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля
//                   HTML-документа.
//
// Возвращаемое значение:
//   Булево - Истина, если нажатие обработано (файл открыт внешним плеером).
//
&НаКлиенте
Функция РМ_ОткрытьВидеоВнешнимПлеером(ДанныеСобытия)

	ПутьКВидео = ГКСИ_MarkdownКлиент.ПутьВидеоИзДанныхСобытия(ДанныеСобытия);
	Если ПустаяСтрока(ПутьКВидео) Тогда
		Возврат Ложь;
	КонецЕсли;

	НачатьЗапускПриложения(
		ГКСИ_MarkdownКлиент.ПустоеОписаниеОповещенияДляЗапускаПриложения(), ПутьКВидео);

	Возврат Истина;

КонецФункции

// Перечитывает ТЧ ОписанияСценария и реквизиты ТекстСценария/ТекстСценарияЧтение
// из базы сразу после записи. Платформа после ПослеЗаписиНаСервере НЕ вызывает
// ПриЧтенииНаСервере, поэтому данные формы устаревают до переоткрытия —
// здесь принудительно обновляем их, чтобы пользователь видел актуальный
// HTML в режиме просмотра без переоткрытия.
//
// Использует типовую ДемонстрационныеСценарии.ЗаполнитьОписанияСценариев,
// которая перечитывает строки ТЧ ОписанияСценария по ссылке объекта
// (с сохранением GUID существующих строк).
&НаСервере
Процедура РМ_ОбновитьОписанияПослеЗаписиНаСервере()

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ОписанияСценария.Очистить();
	ДемонстрационныеСценарии.ЗаполнитьОписанияСценариев(Объект, ОписанияСценария);

	ТекстСценария       = ПолучитьОписаниеНаЯзыке(ЭтотОбъект, ЯзыкСценария);
	ТекстСценарияЧтение = ПолучитьОписаниеНаЯзыке(ЭтотОбъект, ЯзыкСценарияЧтение);

КонецПроцедуры

&НаСервере
Процедура РМ_ДобавитьПанельРедактора()

	РМ_ДобавитьПолеШиринаКартинок();

	РодительскаяСтраница = Элементы.Найти("СтраницаВариантОтображенияРедактирование");
	Если РодительскаяСтраница <> Неопределено Тогда
		ГКСИ_MarkdownСерверВызовСервера.ВставитьПолеРедактированияТекстаНаФорму(ЭтотОбъект, РодительскаяСтраница, "ТекстMarkdownСтрока", Истина, , , ШиринаКартинок);
	Иначе
		ГКСИ_MarkdownСерверВызовСервера.ВставитьПолеРедактированияТекстаНаФорму(ЭтотОбъект, ЭтотОбъект, "ТекстMarkdownСтрока", Истина, , , ШиринаКартинок);
	КонецЕсли;

	РМ_ДобавитьПанельГлоссария();

КонецПроцедуры

// Программно добавляет на форму страницу "Глоссарий" с таблицей терминов,
// отфильтрованных по объекту метаданных текущего элемента.
&НаСервере
Процедура РМ_ДобавитьПанельГлоссария()

	Если Элементы.Найти("РМ_СтраницаГлоссарий") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяСтраница = Элементы.Добавить("РМ_СтраницаГлоссарий", Тип("ГруппаФормы"));
	НоваяСтраница.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяСтраница.Заголовок = "Глоссарий";
	НоваяСтраница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	ТаблицаГлоссария = Элементы.Добавить("РМ_ТаблицаГлоссария", Тип("ТаблицаФормы"), НоваяСтраница);
	ТаблицаГлоссария.ПутьКДанным = "ГКСИ_ТерминыГлоссария";
	КолонкаНаименованиеЭлемент = Элементы.Добавить("РМ_ТерминНаименование", Тип("ПолеФормы"), ТаблицаГлоссария);
	КолонкаНаименованиеЭлемент.ПутьКДанным = "ГКСИ_ТерминыГлоссария.Наименование";
	КолонкаНаименованиеЭлемент.Заголовок = "Термин";
	КолонкаОписаниеЭлемент = Элементы.Добавить("РМ_ТерминОписание", Тип("ПолеФормы"), ТаблицаГлоссария);
	КолонкаОписаниеЭлемент.ПутьКДанным = "ГКСИ_ТерминыГлоссария.Описание";
	КолонкаОписаниеЭлемент.Заголовок = "Описание";

	РМ_ОбновитьТаблицуГлоссария();

КонецПроцедуры

&НаСервере
Процедура РМ_ОбновитьТаблицуГлоссария()

	ГКСИ_ТерминыГлоссарияПовтИсп.Очистить();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОбъекта = ГКСИ_Глоссарий.ИдентификаторОбъектаМетаданных(Объект.Ссылка);
	МассивОбъектов = Новый Массив;
	Если ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		МассивОбъектов.Добавить(ИдентификаторОбъекта);
	КонецЕсли;

	КодЯзыка = ГКСИ_Глоссарий.ТекущийКодЯзыка();
	Термины = ГКСИ_Глоссарий.ТерминыПоОбъектамМетаданных(МассивОбъектов, КодЯзыка);
	Для Каждого Строка Из Термины Цикл
		НоваяСтрока = ГКСИ_ТерминыГлоссария.Добавить();
		НоваяСтрока.Ссылка = XMLСтрока(Строка.Ссылка);
		НоваяСтрока.Наименование = Строка.Наименование;
		НоваяСтрока.Описание = Строка.Описание;
	КонецЦикла;

КонецПроцедуры

&НаСервере
//@skip-warning module-unused-method - вызывается из ПриЧтенииНаСервере
//  без префикса ЭтотОбъект (РМ_ПриЧтенииНаСервереОбновитьГлоссарий),
//  поэтому статический анализ не видит вызов.
Процедура РМ_ПриЧтенииНаСервереОбновитьГлоссарий()

	Если Элементы.Найти("РМ_СтраницаГлоссарий") <> Неопределено Тогда
		РМ_ОбновитьТаблицуГлоссария();
	КонецЕсли;

КонецПроцедуры

// Добавляет поле ввода ШиринаКартинок рядом с панелью редактора Markdown.
// Сам реквизит формы объявлен декларативно в Form.form.
&НаСервере
Процедура РМ_ДобавитьПолеШиринаКартинок()

	Если Элементы.Найти("ШиринаКартинок") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Родитель = Элементы.Найти("СтраницаВариантОтображенияРедактирование");
	Если Родитель = Неопределено Тогда
		Родитель = ЭтотОбъект;
	КонецЕсли;

	ПолеВвода = Элементы.Добавить("ШиринаКартинок", Тип("ПолеФормы"), Родитель);
	ПолеВвода.Заголовок = "Ширина картинок и видео";
	ПолеВвода.Подсказка = "CSS-значение, например 100%, 600px, 40em. Управляет размером картинок и видео";
	ПолеВвода.ПутьКДанным = "ШиринаКартинок";
	ПолеВвода.УстановитьДействие("ПриИзменении", "РМ_Подключаемый_ШиринаКартинокПриИзменении");

КонецПроцедуры

// Обработчик изменения ширины картинок — обновляет CSS в iframe просмотра.
&НаКлиенте
Процедура РМ_Подключаемый_ШиринаКартинокПриИзменении(Элемент)

	ГКСИ_MarkdownКлиент.ОбновитьШиринуИзображений(ЭтотОбъект, ШиринаКартинок);

КонецПроцедуры

&НаСервере
Процедура РМ_ЗаполнитьФайлыBase64()

	ГКСИ_MarkdownФормаСервер.ЗаполнитьФайлыBase64(ЭтотОбъект);

КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура РМ_УстановитьСегментMarkdownВФорму(Форма, КодЯзыка)

	ПолныйТекст = "";
	Если Форма.Объект <> Неопределено Тогда
		Попытка
			ПолныйТекст = Форма.Объект.ГКСИ_ТекстMarkdown;
		Исключение
			ПолныйТекст = "";
		КонецПопытки;
	КонецЕсли;

	Форма.ТекстMarkdownСтрока = РМ_ПолучитьСегментMarkdown(ПолныйТекст, КодЯзыка);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РМ_СохранитьСегментMarkdownТекущегоЯзыка(Форма)

	Попытка
		ПолныйТекст = Форма.Объект.ГКСИ_ТекстMarkdown;
	Исключение
		Возврат;
	КонецПопытки;

	Попытка
		Форма.Объект.ГКСИ_ТекстMarkdown = РМ_ЗаменитьСегментMarkdown(ПолныйТекст,
			Форма.ЯзыкСценария, Форма.ТекстMarkdownСтрока);
		Форма.Объект.ГКСИ_MarkdownСформирован = Истина;
	Исключение
		// Объект открыт без прав на изменение и доступен только для чтения,
		// поэтому сохранять сегмент Markdown некуда.
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура РМ_СобратьТекстMarkdown(ТекущийОбъект)

	ТекущийОбъект.ГКСИ_ТекстMarkdown = РМ_ЗаменитьСегментMarkdown(
		ТекущийОбъект.ГКСИ_ТекстMarkdown, ЯзыкСценария, ТекстMarkdownСтрока);
	ТекущийОбъект.ГКСИ_MarkdownСформирован = Истина;

КонецПроцедуры

// Получает сегмент markdown для указанного языка из полного текста.
// Формат: <!--md:lang:КОД_ЯЗЫКА-->...<!--/md:lang:КОД_ЯЗЫКА-->
&НаКлиентеНаСервереБезКонтекста
Функция РМ_ПолучитьСегментMarkdown(ПолныйТекст, КодЯзыка)

	Если НЕ ЗначениеЗаполнено(ПолныйТекст) Тогда
		Возврат "";
	КонецЕсли;

	Начало = "<!--md:lang:" + КодЯзыка + "-->";
	Конец  = "<!--/md:lang:" + КодЯзыка + "-->";

	ПозицияНачала = СтрНайти(ПолныйТекст, Начало);
	Если ПозицияНачала = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозицияСодержимого = ПозицияНачала + СтрДлина(Начало);
	ПозицияКонца = СтрНайти(ПолныйТекст, Конец, , ПозицияСодержимого);
	Если ПозицияКонца = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Сред(ПолныйТекст, ПозицияСодержимого, ПозицияКонца - ПозицияСодержимого));

КонецФункции

// Заменяет (или добавляет) сегмент markdown указанного языка в полном тексте.
&НаКлиентеНаСервереБезКонтекста
Функция РМ_ЗаменитьСегментMarkdown(ПолныйТекст, КодЯзыка, НовыйСегмент)

	Начало = "<!--md:lang:" + КодЯзыка + "-->" + Символы.ПС;
	Конец  = Символы.ПС + "<!--/md:lang:" + КодЯзыка + "-->";

	НовыйБлок = Начало + НовыйСегмент + Конец;

	Если НЕ ЗначениеЗаполнено(ПолныйТекст) Тогда
		Возврат НовыйБлок;
	КонецЕсли;

	ПозицияНачала = СтрНайти(ПолныйТекст, "<!--md:lang:" + КодЯзыка + "-->");
	Если ПозицияНачала = 0 Тогда
		Возврат ПолныйТекст + Символы.ПС + Символы.ПС + НовыйБлок;
	КонецЕсли;

	ПозицияКонца = СтрНайти(ПолныйТекст, "<!--/md:lang:" + КодЯзыка + "-->", , ПозицияНачала);
	Если ПозицияКонца = 0 Тогда
		Возврат ПолныйТекст + Символы.ПС + Символы.ПС + НовыйБлок;
	КонецЕсли;

	Возврат Лев(ПолныйТекст, ПозицияНачала - 1) + НовыйБлок
		+ Сред(ПолныйТекст, ПозицияКонца + СтрДлина("<!--/md:lang:" + КодЯзыка + "-->"));

КонецФункции

// При записи объекта обходим все коды языков из ГКСИ_ТекстMarkdown
// и для каждого конвертируем сегмент Markdown в HTML. Результат
// помещается в ТекущийОбъект.ДополнительныеСвойства как Соответствие
// (КодЯзыка -> HTML). Серверная часть (ГКСИ_MarkdownФормаСервер.СоздатьПрисоединенныеФайлыИзДопСвойств)
// вызывается ДО типового ПередЗаписьюНаСервере через &Перед и сама
// создаёт/обновляет присоединённые HTML-файлы.
//
// Такой подход не зависит от тонкостей типовой записи новых строк
// (которая создаёт файл с пустым HTML и сбрасывает флаг изменений) —
// мы формируем файлы сами и помечаем строки как не-изменённые,
// чтобы типовая их не трогала.
&НаКлиенте
Процедура РМ_ЗаписатьHTMLИзMarkdown(Отказ, ПараметрыЗаписи)

	Если НЕ ЗначениеЗаполнено(Объект.ГКСИ_ТекстMarkdown) Тогда
		Возврат;
	КонецЕсли;

	ПолеHTMLПросмотра = Элементы.Найти("РМ_ПолеПросмотра_ТекстMarkdownСтрока");
	Если ПолеHTMLПросмотра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КодыЯзыков = РМ_ПолучитьКодыЯзыковИзMarkdown(Объект.ГКСИ_ТекстMarkdown);
	Если КодыЯзыков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	HTMLПоЯзыкам = Новый Соответствие;
	Для Каждого КодЯзыка Из КодыЯзыков Цикл

		СегментMarkdown = РМ_ПолучитьСегментMarkdown(Объект.ГКСИ_ТекстMarkdown, КодЯзыка);
		Если НЕ ЗначениеЗаполнено(СегментMarkdown) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ТекстДляКонвертации = ГКСИ_MarkdownКлиент.ЗаменитьКодыФайловНаBase64(СегментMarkdown, ЭтотОбъект);
			ФрагментHTML = ГКСИ_MarkdownКлиент.ТекстHTMLПоТекстуMarkdown(ПолеHTMLПросмотра, ТекстДляКонвертации);
			ДемонстрационныеСценарииКлиентСервер.ДобавитьТегиТелаЕслиНеобходимо(ФрагментHTML);
		Исключение
			Продолжить;
		КонецПопытки;

		HTMLПоЯзыкам.Вставить(КодЯзыка, ФрагментHTML);

	КонецЦикла;

	Если HTMLПоЯзыкам.Количество() > 0 Тогда
		АдресВХ = ПоместитьВоВременноеХранилище(HTMLПоЯзыкам, ЭтотОбъект.УникальныйИдентификатор);
		ПараметрыЗаписи.Вставить("ГКСИ_АдресHTMLПоЯзыкам", АдресВХ);
	КонецЕсли;

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);
	Объект.ГКСИ_MarkdownСформирован = Истина;

КонецПроцедуры

// Возвращает коды языков, найденные в ГКСИ_ТекстMarkdown по маркерам
// <!--md:lang:КОД_ЯЗЫКА-->...<!--/md:lang:КОД_ЯЗЫКА-->.
// Реализовано через обычный поиск подстрок (СтрНайти), без регулярных
// выражений — функция должна работать на тонком клиенте.
&НаКлиентеНаСервереБезКонтекста
Функция РМ_ПолучитьКодыЯзыковИзMarkdown(ПолныйТекст)

	Результат = Новый Массив;

	Если НЕ ЗначениеЗаполнено(ПолныйТекст) Тогда
		Возврат Результат;
	КонецЕсли;

	ПрефиксМаркера = "<!--md:lang:";
	ДлинаПрефикса  = СтрДлина(ПрефиксМаркера);
	ПозицияПоиска  = 1;

	Пока Истина Цикл

		ПозицияМаркера = СтрНайти(ПолныйТекст, ПрефиксМаркера, , ПозицияПоиска);
		Если ПозицияМаркера = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоКода = ПозицияМаркера + ДлинаПрефикса;
		ПозицияОкончания = СтрНайти(ПолныйТекст, "-->", , НачалоКода);
		Если ПозицияОкончания = 0 Тогда
			Прервать;
		КонецЕсли;

		КодЯзыка = Сред(ПолныйТекст, НачалоКода, ПозицияОкончания - НачалоКода);
		Если ЗначениеЗаполнено(КодЯзыка)
			И Результат.Найти(КодЯзыка) = Неопределено Тогда
			Результат.Добавить(КодЯзыка);
		КонецЕсли;

		ПозицияПоиска = ПозицияОкончания;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Для каждого кода языка из ПараметрыЗаписи["ГКСИ_АдресHTMLПоЯзыкам"]
// находит/создаёт строку ТЧ объекта ТекущийОбъект.ОписанияСценария
// и создаёт/обновляет присоединённый HTML-файл через РаботаСФайлами.
//
// Структура хранения:
//   Объект.ОписанияСценария — ТЧ объекта: КодЯзыка, ПрисоединенныйФайл, ХэшДанныхПоставщика.
//
// Вызывается из &Перед("ПередЗаписьюНаСервере") ДО типового обработчика.
// Реализация вынесена в общий модуль ГКСИ_MarkdownФормаСервер.СоздатьПрисоединенныеФайлыИзДопСвойств.

&НаСервере
Процедура РМ_СоздатьПрисоединенныеФайлыИзДопСвойств(Форма, ТекущийОбъект, ПараметрыЗаписи, Отказ)

	ГКСИ_MarkdownФормаСервер.СоздатьПрисоединенныеФайлыИзДопСвойств(Форма, ТекущийОбъект, ПараметрыЗаписи, Отказ);

КонецПроцедуры

// Делегат в общий модуль ГКСИ_MarkdownФормаКлиент.ВыполнитьМиграциюHTMLВMarkdown.
&НаКлиенте
Процедура РМ_ВыполнитьМиграциюHTMLВMarkdown()

	ГКСИ_MarkdownФормаКлиент.ВыполнитьМиграциюHTMLВMarkdown(ЭтотОбъект);

КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура РМ_УправлениеВидимостьюMarkdown(Форма)

	Элементы = Форма.Элементы;

	ЭтоРежимРедактирования = (Форма.ВариантОтображенияФормы = "Редактирование");
	ЭтоРежимПеревод        = (Форма.ВариантОтображенияФормы = "Перевод");

	ПолеТекстСценария = Элементы.Найти("ТекстСценария");
	Если ПолеТекстСценария <> Неопределено Тогда
		ПолеТекстСценария.Видимость = НЕ (ЭтоРежимРедактирования Или ЭтоРежимПеревод);
	КонецЕсли;

	ИменаСкрываемых = Новый Массив;
	ИменаСкрываемых.Добавить("ТекстСценарияРедактировать");
	ИменаСкрываемых.Добавить("ТекстСценарияЗакончитьРедактирование");
	ИменаСкрываемых.Добавить("ТекстСценарияОтменитьРедактирование");
	ИменаСкрываемых.Добавить("ТекстСценарияНайтиИЗаменить");

	Для Каждого ИмяЭлемента Из ИменаСкрываемых Цикл
		Элемент = Элементы.Найти(ИмяЭлемента);
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//@skip-warning undefined-variable
&НаКлиенте
//@skip-warning module-unused-method
Процедура РМ_ДобавитьГруппу(Команда)

	// Форма выбора группы не принимает параметров открытия: список всегда содержит
	// все узлы справочника, а выбранную группу проверяет обработчик завершения
	// (см. РМ_ЗавершениеВыбораГруппы).
	ИмяФормыВыбораГруппы = "Catalog.ДемонстрационныеСценарии.Form.ГКСИ_ФормаВыбораГруппы";
	ОткрытьФорму(ИмяФормыВыбораГруппы,
		,
		ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("РМ_ЗавершениеВыбораГруппы", ЭтотОбъект));

КонецПроцедуры

// Обработчик завершения выбора родительской группы из формы ГКСИ_ФормаВыбораГруппы.
// Добавляет выбранную группу в таблицу ГКСИ_ГруппыСценария.
//
// Параметры:
//  РезультатВыбора        - Структура, Неопределено - результат формы выбора
//                            (Ссылка, ЭтоГруппа, Фрагмент) или Неопределено при отказе.
//  ДополнительныеПараметры - Произвольный - параметры оповещения.
//@skip-warning
&НаКлиенте
Процедура РМ_ЗавершениеВыбораГруппы(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ВыбраннаяГруппа = РезультатВыбора.Ссылка;
	Если НЕ ЗначениеЗаполнено(ВыбраннаяГруппа) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ РезультатВыбора.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В качестве родительской группы можно выбрать только группу.'"));
		Возврат;
	КонецЕсли;

	Если ВыбраннаяГруппа = Объект.Ссылка Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Группа не может быть вложена сама в себя.'"));
		Возврат;
	КонецЕсли;

	//@skip-warning undefined-variable
	Для Каждого Строка Из ГКСИ_ГруппыСценария Цикл
		Если Строка.Группа = ВыбраннаяГруппа Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Эта группа уже добавлена.'"));
			Возврат;
		КонецЕсли;
	КонецЦикла;

	//@skip-warning undefined-variable
	НоваяСтрока = ГКСИ_ГруппыСценария.Добавить();
	НоваяСтрока.Группа               = ВыбраннаяГруппа;
	// Полный код будет рассчитан автоматически в обработчике ПриЗаписи объекта
	// (см. РМ_ПриЗаписи в ObjectModule справочника).
	НоваяСтрока.ПолныйКодКонтекстный = "";

КонецПроцедуры

&НаКлиенте
//@skip-warning undefined-variable ГКСИ_ГруппыСценария - реквизит формы, определяется в Form.form
Процедура РМ_УдалитьГруппу(Команда)

	ТекущаяСтрока = Элементы.ГКСИ_ГруппыСценария.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	//@skip-warning undefined-variable
	ГКСИ_ГруппыСценария.Удалить(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ГКСИ_ПереключитьРежим(Команда)

	ГКСИ_MarkdownФормаКлиент.ПереключитьРежим(ЭтотОбъект, Команда);

КонецПроцедуры


// Обновляет заголовок кнопки тумблера в соответствии с текущим режимом формы.
//@skip-warning
&НаКлиентеНаСервереБезКонтекста
Процедура РМ_ОбновитьЗаголовокТумблера(Форма)

	Кнопка = Форма.Элементы.Найти("ГКСИ_ПереключитьРежим");
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Форма.ВариантОтображенияФормы = "Редактирование" Тогда
		Кнопка.Заголовок = НСтр("ru = 'Режим: Редактирование — Просмотр'");
	Иначе
		Кнопка.Заголовок = НСтр("ru = 'Режим: Просмотр — Редактирование'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

