// Модуль формы элемента справочника ДемонстрационныеСценарии.
// Расширение: встраивание Markdown-редактора подсистемы РМ_РедакторMarkdown
// вместо типового HTML-редактора. Типовой вывод HTML в файл и типовые
// отчёты/Альбом процессов/поиск-замена сохраняются (HTML продолжает
// писаться стандартным механизмом через ДемонстрационныеСценарии.ЗаписатьНовыеОписанияСценариевИзФормыОбъекта).

#Область ОбработчикиСобытийФормы

// Перехват типового ПриСозданииНаСервере: добавляем реквизиты, заполняем
// ФайлыBase64, извлекаем сегмент markdown текущего языка.
//@skip-warning
&Перед("ПриСозданииНаСервере")
&НаСервере
Процедура РМ_ПередПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	РМ_УстановитьДействиеКлиентскогоПередЗаписью();
	РМ_ДобавитьПанельРедактора();
	ГКСИ_ГруппыСценариевСервер.ДобавитьПанельГруппСценария(ЭтотОбъект);
	РМ_ЗаполнитьФайлыBase64();
	ГКСИ_ГруппыСценариевСервер.ЗаполнитьГруппыСценария(ЭтотОбъект);
	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);

КонецПроцедуры

//@skip-warning
&После("ПриСозданииНаСервере")
&НаСервере
Процедура РМ_ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РМ_УправлениеВидимостьюMarkdown(ЭтотОбъект);
	РМ_ДобавитьКнопкуТумблера(ЭтотОбъект);
	РМ_ОбновитьЗаголовокТумблера(ЭтотОбъект);

КонецПроцедуры

// Добавляет кнопку тумблера режима в командную панель формы.
//@skip-warning
&НаСервере
Процедура РМ_ДобавитьКнопкуТумблера(Форма)

	ИмяКнопки = "ГКСИ_ПереключитьРежим";

	Если Форма.Элементы.Найти(ИмяКнопки) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	РодительскаяГруппа = Форма.Элементы.Найти("ГруппаКомментарийРодитель");
	Если РодительскаяГруппа = Неопределено Тогда
		РодительскаяГруппа = Форма;
	КонецЕсли;

	НоваяКнопка = Форма.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), РодительскаяГруппа);
	НоваяКнопка.ИмяКоманды = ИмяКнопки;
	НоваяКнопка.Видимость = Истина;

КонецПроцедуры

// Обновляет заголовок кнопки тумблера после переключения в режим Просмотр
// (типовой обработчик вызывает наш перехватчик).
//@skip-warning
&После("УстановитьВариантПросмотр")
&НаКлиенте
Процедура РМ_ПослеУстановитьВариантПросмотр(Команда)

	РМ_ОбновитьЗаголовокТумблера(ЭтотОбъект);

КонецПроцедуры

// Обновляет заголовок кнопки тумблера после переключения в режим Редактирование.
//@skip-warning
&После("УстановитьВариантРедактирование")
&НаКлиенте
Процедура РМ_ПослеУстановитьВариантРедактирование(Команда)

	РМ_ОбновитьЗаголовокТумблера(ЭтотОбъект);

КонецПроцедуры

// Программная обёртка над типовым УстановитьВариантПросмотр для тумблера режима
// в ГКСИ_MarkdownФормаКлиент.ПереключитьРежим. Общий модуль не может вызвать
// неэкспортный типовой обработчик через ОписаниеОповещения напрямую. Метод
// уже заимствован в расширение через &После выше, поэтому прямой вызов по
// имени из этой обёртки компилируется.
//
// Параметры:
//  Команда - КомандаФормы - команда тумблера режима.
//@skip-warning
&НаКлиенте
Процедура ГКСИ_УстановитьВариантПросмотр(Команда) Экспорт

	УстановитьВариантПросмотр(Команда);

КонецПроцедуры

// Программная обёртка над типовым УстановитьВариантРедактирование для тумблера
// режима в ГКСИ_MarkdownФормаКлиент.ПереключитьРежим.
//
// Параметры:
//  Команда - КомандаФормы - команда тумблера режима.
//@skip-warning
&НаКлиенте
Процедура ГКСИ_УстановитьВариантРедактирование(Команда) Экспорт

	УстановитьВариантРедактирование(Команда);

КонецПроцедуры

// Перехват типового ПриЧтенииНаСервере.
//@skip-warning
&После("ПриЧтенииНаСервере")
&НаСервере
Процедура РМ_ПослеПриЧтенииНаСервере(ТекущийОбъект)

	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	ГКСИ_ГруппыСценариевСервер.ЗаполнитьГруппыСценария(ЭтотОбъект);
	// Типовой код уже положил HTML в ТекстСценарияЧтение напрямую, минуя наш
	// делегат ПолучитьОписаниеНаЯзыке. Прогоняем через серверную обработку алертов,
	// чтобы GitHub Alerts в форме элемента отображались с правильным CSS-классом.
	ТекстСценарияЧтение = ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ТекстСценарияЧтение);

КонецПроцедуры

// Серверный ПередЗаписьюНаСервере: срабатывает ДО типового.
// Для каждого языка, для которого клиент положил HTML в ДополнительныеСвойства,
// создаёт присоединённый HTML-файл (если его ещё нет) или обновляет
// содержимое существующего, и приводит строку ТЧ ОписанияСценария в
// состояние, при котором типовая ЗаписатьНовыеОписанияСценариевИзФормыОбъекта
// её не трогает (ДатаМодификации заполнена, ЕстьИзмененияРедактирования = Ложь).
//@skip-warning
&Перед("ПередЗаписьюНаСервере")
&НаСервере
Процедура РМ_ПередПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ГКСИ_MarkdownФормаСервер.СоздатьПрисоединенныеФайлыИзДопСвойств(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	РМ_СобратьТекстMarkdown(ТекущийОбъект);
	ГКСИ_ГруппыСценариевСервер.СинхронизироватьГруппыСценария(ЭтотОбъект, ТекущийОбъект, Отказ);

КонецПроцедуры

// Клиентский ПередЗаписью привязан программно через УстановитьДействие
// в РМ_ПередПриСозданииНаСервере: аннотация &Перед("ПередЗаписью")
// не работает, так как в типовой форме нет клиентского обработчика ПередЗаписью.
// Сигнатура клиентского ПередЗаписью управляемой формы: (Отказ, ПараметрыЗаписи).
//@skip-warning
&НаКлиенте
Процедура РМ_КлиентскийПередЗаписью(Отказ, ПараметрыЗаписи)

	ГКСИ_MarkdownФормаКлиент.ЗаписатьHTMLИзMarkdown(ЭтотОбъект, Отказ, ПараметрыЗаписи);

КонецПроцедуры
// Перехват типового ПослеЗаписиНаСервере: обновление ФайлыBase64 после записи,
// чтобы внесённые изменения файлов инструкций отразились в редакторе.
// Платформа после ПослеЗаписиНаСервере НЕ вызывает ПриЧтенииНаСервере,
// поэтому реквизит формы ТекстСценарияЧтение остаётся со старым значением —
// перечитываем его явно, чтобы пользователь сразу видел изменения описания
// без переоткрытия формы.
//@skip-warning
&После("ПослеЗаписиНаСервере")
&НаСервере
Процедура РМ_ПослеПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	РМ_ЗаполнитьФайлыBase64();
	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	РМ_ОбновитьОписанияПослеЗаписиНаСервере();
	ДемонстрационныеСценарииКлиентСервер.ОтразитьТекущиеЯзыкиНаФорме(
		ЭтотОбъект, "ЯзыкСценарияЧтение", "ЯзыкСценария");

КонецПроцедуры

// Перехват типового ОбработкаОповещения: типовая логика поиска-замены остаётся
// (выполняется до нашего перехватчика через &Перед), здесь — Markdown-реакция.
//@skip-warning
&После("ОбработкаОповещения")
&НаКлиенте
Процедура РМ_ПослеОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "РМ_ОбновитьФайлыBase64" Тогда
		РМ_ЗаполнитьФайлыBase64();
		РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Перехват типового ТекстСценарияДокументСформирован: миграция HTML->Markdown.
//@skip-warning
&Перед("ТекстСценарияДокументСформирован")
&НаКлиенте
Процедура РМ_ПередТекстСценарияДокументСформирован(Элемент)

	РМ_ВыполнитьМиграциюHTMLВMarkdown();

КонецПроцедуры

// Перехват типового ТекстСценарияПриНажатии: типовая логика нажатия в HTML-поле
// остаётся, дополнительно выполняется сохранение сегмента Markdown текущего языка.
//@skip-warning
&Перед("ТекстСценарияПриНажатии")
&НаКлиенте
Процедура РМ_ПередТекстСценарияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если РМ_ОткрытьВидеоВнешнимПлеером(ДанныеСобытия) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

// Перехват типового ТекстСценарияЧтениеПриНажатии: то же, что и для редактируемого
// поля — фиксируем текущий сегмент Markdown перед обработкой клика.
//@skip-warning
&Перед("ТекстСценарияЧтениеПриНажатии")
&НаКлиенте
Процедура РМ_ПередТекстСценарияЧтениеПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если РМ_ОткрытьВидеоВнешнимПлеером(ДанныеСобытия) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

// Перехват типового Подключаемый_Открытие: вызывается подсистемой Мультиязычность
// при открытии мультиязычных полей. Дополнительно инициализируем новое поле
// ТекстMarkdownСтрока, если оно пустое.
//@skip-warning
&Перед("Подключаемый_Открытие")
&НаКлиенте
Процедура РМ_ПередПодключаемыйОткрытие(Элемент, СтандартнаяОбработка)

	Если Элемент.Имя = "ТекстMarkdownСтрока"
		И НЕ ЗначениеЗаполнено(ТекстMarkdownСтрока) Тогда
		РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Отправляет текущий элемент инструкции на согласование.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//
&НаКлиенте
Процедура ГКСИ_ОтправитьНаСогласование(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите элемент инструкции'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыЗадачи = ГКСИ_ЗапуститьСогласованиеНаСервере(Ложь);
	Если ПараметрыЗадачи = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Согласование запущено, но задача не найдена'"));
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(ПараметрыЗадачи.ИмяФормы, ПараметрыЗадачи.ПараметрыФормы);
	
КонецПроцедуры

// Перекрытие типового обработчика Редактировать. Типовое поведение открывает
// присоединённый HTML-файл сценария во внешнем редакторе через
// РаботаСФайламиСлужебныйКлиент.РедактироватьСОповещением. В нашем решении
// сценарий редактируется прямо в форме через Markdown-редактор подсистемы
// РМ_РедакторMarkdown, поэтому открытие внешнего файла не требуется.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&Вместо("Редактировать")
&НаКлиенте
Процедура РМ_РедактироватьВместо(Команда)

КонецПроцедуры

// Перекрытие типового обработчика ЗакончитьРедактирование. Типовое поведение
// закрывает редактирование внешнего HTML-файла через
// РаботаСФайламиСлужебныйКлиент.ЗакончитьРедактированиеСОповещением. Так как
// внешний файл не открывается, обработчик не нужен.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&Вместо("ЗакончитьРедактирование")
&НаКлиенте
Процедура РМ_ЗакончитьРедактированиеВместо(Команда)

КонецПроцедуры

// Перекрытие типового обработчика ОтменитьРедактирование. Типовое поведение
// освобождает внешний HTML-файл через
// РаботаСФайламиСлужебныйВызовСервера.ОсвободитьФайлы. Так как внешний файл
// не открывается, обработчик не нужен.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&Вместо("ОтменитьРедактирование")
&НаКлиенте
Процедура РМ_ОтменитьРедактированиеВместо(Команда)

КонецПроцедуры

// Перехват типового Подключаемый_ИзменитьЯзыкРедактирования: сохраняем сегмент
// текущего языка до переключения.
//@skip-warning
&Перед("Подключаемый_ИзменитьЯзыкРедактирования")
&НаКлиенте
Процедура РМ_ПередИзменитьЯзыкРедактирования(Команда)

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

//@skip-warning
&После("Подключаемый_ИзменитьЯзыкРедактирования")
&НаКлиенте
Процедура РМ_ПослеИзменитьЯзыкРедактирования(Команда)

	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	РМ_УправлениеВидимостьюMarkdown(ЭтотОбъект);

КонецПроцедуры

// Перехват типового Подключаемый_ИзменитьЯзыкПросмотра.
//@skip-warning
&Перед("Подключаемый_ИзменитьЯзыкПросмотра")
&НаКлиенте
Процедура РМ_ПередИзменитьЯзыкПросмотра(Команда)

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

//@skip-warning
&После("Подключаемый_ИзменитьЯзыкПросмотра")
&НаКлиенте
Процедура РМ_ПослеИзменитьЯзыкПросмотра(Команда)

	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	РМ_УправлениеВидимостьюMarkdown(ЭтотОбъект);

КонецПроцедуры

// Привязывает клиентский обработчик ПередЗаписью формы к нашей процедуре
// РМ_КлиентскийПередЗаписью. Аннотация &Перед("ПередЗаписью") не сработала,
// потому что в типовой форме нет клиентского обработчика ПередЗаписью.
// Вызывается из &Перед("ПриСозданииНаСервере"), потому что УстановитьДействие
// на клиенте заимствованной формы расширения недоступен (Метод недоступен на клиенте).
//@skip-warning
&НаСервере
Процедура РМ_УстановитьДействиеКлиентскогоПередЗаписью()

	//@skip-warning
	ЭтотОбъект.УстановитьДействие("ПередЗаписью", "РМ_КлиентскийПередЗаписью");

КонецПроцедуры

// Делегирует обработку смены текущей страницы поля комментария в подсистему Markdown-редактора.
//
// Параметры:
//   Элемент - ПолеФормы - элемент формы, содержащий страницы поля комментария, в котором произошло событие
//   ТекущаяСтраница - ЭлементСпискаЗначений, ГруппаФормы - новая текущая страница поля комментария
//@skip-warning
&НаКлиенте
Процедура РМ_Подключаемый_ПриСменеСтраницыПоляКомментария(Элемент, ТекущаяСтраница) Экспорт
	ГКСИ_MarkdownКлиент.ПриСменеСтраницыПоляКомментария(ЭтотОбъект, Элемент, ТекущаяСтраница);
КонецПроцедуры

// Делегирует обработку команды форматирования поля комментария Markdown
// в клиентский общий модуль подсистемы РМ_РедакторMarkdown.
//
// Предназначена для подключения к элементам управления формы
// (кнопки, команды формы), отвечающим за форматирование текста комментария
// в формате Markdown (жирный, курсив, заголовки, ссылки, списки и т.п.).
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&НаКлиенте
