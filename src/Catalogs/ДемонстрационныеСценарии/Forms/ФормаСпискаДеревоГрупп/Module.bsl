// Модуль формы списка с деревом групп.
// Один элемент справочника отображается под каждой из своих групп
// (виртуальное дублирование строк). Иерархия групп строится по регистру
// сведений ГКСИ_ГруппыСценариев; стандартное поле Родитель не используется.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ГКСИ_ПостроитьДерево();
	ГКСИ_УстановитьУсловноеОформление();
	ГКСИ_НастроитьВидимостьКомандСоздания();

	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст =
		"ГКСИ_ПостроитьДерево v" + ГКСИ_ВерсияРасширения()
		+ ": " + ГКСИ_ОтладкаДерева();
	СообщениеПользователю.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГКСИ_ДеревоСценариев

&НаКлиенте
Процедура ГКСИ_ДеревоСценариевВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ГКСИ_ДеревоСценариевВыполнитьОткрытие(ВыбраннаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Отправляет выделенные в дереве узлы на согласование.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//
&НаКлиенте
Процедура ГКСИ_ОтправитьНаСогласование(Команда)
	
	ВыделенныеСсылки = ГКСИ_СобратьВыделенныеСсылки();
	Если ВыделенныеСсылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите узлы для отправки на согласование'"));
		Возврат;
	КонецЕсли;
	
	ГКСИ_ОтправитьНаСогласованиеНаСервере(ВыделенныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ГКСИ_ПостроитьДерево();

КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)

	ТекущиеДанные = Элементы.ГКСИ_ДеревоСценариев.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ЭтоГруппа Тогда
		ГКСИ_ОткрытьФормуЭлемента(Неопределено, ТекущиеДанные.Сценарий);
	ИначеЕсли ТекущиеДанные <> Неопределено Тогда
		ГКСИ_ОткрытьФормуЭлемента(ТекущиеДанные.Сценарий, Неопределено);
	Иначе
		ГКСИ_ОткрытьФормуЭлемента(Неопределено, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьГруппу(Команда)

	ТекущиеДанные = Элементы.ГКСИ_ДеревоСценариев.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ЭтоГруппа Тогда
		ГКСИ_ОткрытьФормуЭлемента(Неопределено, ТекущиеДанные.Сценарий);
	Иначе
		ГКСИ_ОткрытьФормуЭлемента(Неопределено, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдаление(Команда)

	ВыделенныеСсылки = ГКСИ_СобратьВыделенныеСсылки();
	Если ВыделенныеСсылки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ГКСИ_ПереключитьПометкуУдаленияНаСервере(ВыделенныеСсылки);
	ГКСИ_ПостроитьДерево();

КонецПроцедуры

&НаКлиенте
Процедура АльбомПоВыделенным(Команда)

	ГруппыДляАльбома = ГКСИ_ГруппыДляАльбомаПоВыделению();
	Поддерево = ГКСИ_СобратьПоддеревоАльбомаНаСервере(ГруппыДляАльбома);
	ПараметрыФормы = Новый Структура("Поддерево", Поддерево);
	ОткрытьФорму(
		"Справочник.ДемонстрационныеСценарии.Форма.АльбомПроцессов",
		ПараметрыФормы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запускает бизнес-процессы согласования для выделенных узлов дерева.
//
// Параметры:
//	ВыделенныеСсылки - Массив из СправочникСсылка.ДемонстрационныеСценарии -
//	                   узлы инструкций, выбранные пользователем в дереве.
//
&НаСервере
Процедура ГКСИ_ОтправитьНаСогласованиеНаСервере(ВыделенныеСсылки)
	
	ЗапущеноСогласований = 0;
	Для Каждого Ссылка Из ВыделенныеСсылки Цикл
		
		КорневаяИнструкция = ГКСИ_СогласованиеИнструкцийСервер.ОпределитьКорневуюИнструкцию(Ссылка);
		ВидСогласования = ?(Ссылка = КорневаяИнструкция,
			Перечисления.ГКСИ_ВидыСогласованияИнструкций.ВсяИнструкция,
			Перечисления.ГКСИ_ВидыСогласованияИнструкций.ЭлементИнструкции);
		
		ГКСИ_СогласованиеИнструкцийСервер.ЗапуститьСогласование(Ссылка, ВидСогласования);
		ЗапущеноСогласований = ЗапущеноСогласований + 1;
		
	КонецЦикла;
	
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = СтрШаблон(НСтр("ru = 'Запущено согласований: %1'"), ЗапущеноСогласований);
	СообщениеПользователю.Сообщить();
	
КонецПроцедуры

// Скрывает кнопки создания для пользователей, у которых нет права
// на добавление элементов справочника. В частности, это роль
// ГКСИ_ЧтениеИнструкций — она даёт только чтение и просмотр,
// поэтому кнопки «Создать» и «Создать группу» таким пользователям
// не нужны. Пользователям с правом добавления кнопки остаются.
//
&НаСервере
Процедура ГКСИ_НастроитьВидимостьКомандСоздания()

	Если ПравоДоступа("Добавление",
		Метаданные.Справочники.ДемонстрационныеСценарии) Тогда
		Возврат;
	КонецЕсли;

	Элементы.ФормаСоздать.Видимость = Ложь;
	Элементы.ФормаСоздатьГруппу.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Функция ГКСИ_СобратьВыделенныеСсылки()

	Результат = Новый Массив;

	Для Каждого Идентификатор Из Элементы.ГКСИ_ДеревоСценариев.ВыделенныеСтроки Цикл
		СтрокаДерева = ГКСИ_ДеревоСценариев.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаДерева <> Неопределено И СтрокаДерева.Сценарий <> Неопределено Тогда
			Результат.Добавить(СтрокаДерева.Сценарий);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ГКСИ_ПереключитьПометкуУдаленияНаСервере(МассивСсылок)

	Для Каждого Ссылка Из МассивСсылок Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Объект.УстановитьПометкуУдаления(Не Объект.ПометкаУдаления, Истина);
	КонецЦикла;

КонецПроцедуры

// Собирает массив групп для построения альбома процессов по выделению
// в дереве сценариев.
//
//   - Если выделены только группы, возвращаются их ссылки.
//   - Если выделены только элементы, возвращаются все группы этих элементов
//     (через регистр ГКСИ_ГруппыСценариев).
//   - Если выделены и группы, и элементы, возвращается объединение.
//   - Если ничего не выделено, возвращается пустой массив.
//
// Пустой массив трактуется построителем ГКСИ_АльбомПроцессов как
// "по всем корневым группам каталога".
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии - группы для альбома.
//
&НаКлиенте
Функция ГКСИ_ГруппыДляАльбомаПоВыделению()

	МассивГрупп = Новый Массив;
	МассивЭлементов = Новый Массив;
	Дедупликация = Новый Соответствие;

	ГКСИ_РазделитьВыделениеПоГруппам(МассивГрупп, МассивЭлементов, Дедупликация);

	Если МассивЭлементов.Количество() > 0 Тогда
		ГруппыЭлементов = ГКСИ_ПолучитьГруппыСценариевНаСервере(МассивЭлементов);
		Для Каждого Группа Из ГруппыЭлементов Цикл
			Если Дедупликация.Получить(Группа) = Неопределено Тогда
				Дедупликация.Вставить(Группа, Истина);
				МассивГрупп.Добавить(Группа);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат МассивГрупп;

КонецФункции

// Обходит выделенные строки дерева и раскладывает их по двум массивам:
// группы - в МассивГрупп (с дедупликацией), элементы - в МассивЭлементов
// (для последующего серверного запроса групп).
//
// Параметры:
//  МассивГрупп    - Массив из CatalogRef.ДемонстрационныеСценарии - накопитель групп (с дедупликацией).
//  МассивЭлементов - Массив из CatalogRef.ДемонстрационныеСценарии - накопитель сценариев.
//  Дедупликация   - Соответствие из КлючИЗначение - защита от дублей в МассивГрупп.
//
&НаКлиенте
Процедура ГКСИ_РазделитьВыделениеПоГруппам(МассивГрупп, МассивЭлементов, Дедупликация)

	Для Каждого Идентификатор Из Элементы.ГКСИ_ДеревоСценариев.ВыделенныеСтроки Цикл
		СтрокаДерева = ГКСИ_ДеревоСценариев.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаДерева = Неопределено
			ИЛИ СтрокаДерева.Сценарий = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаДерева.ЭтоГруппа Тогда
			Если Дедупликация.Получить(СтрокаДерева.Сценарий) = Неопределено Тогда
				Дедупликация.Вставить(СтрокаДерева.Сценарий, Истина);
				МассивГрупп.Добавить(СтрокаДерева.Сценарий);
			КонецЕсли;
		Иначе
			МассивЭлементов.Добавить(СтрокаДерева.Сценарий);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Рекурсивно собирает поддерево выделенных групп для альбома процессов.
//
//   - Обход не зависит от состояния развёрнутости дерева на форме: для каждой
//     корневой группы вызывается ГКСИ_ГруппыСценариевСервер.ПолучитьЧленовГруппы,
//     который отдаёт непосредственных членов группы без обращения к UI.
//   - Возвращается плоский массив структур {Сценарий, ЭтоГруппа, РодительскаяГруппа},
//     упорядоченный по обходу DFS. Корневые группы в массив не включаются.
//
// Параметры:
//  МассивКорневыхГрупп - Массив из CatalogRef.ДемонстрационныеСценарии - группы
//                        верхнего уровня, для которых нужно собрать поддерево.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Сценарий         - CatalogRef.ДемонстрационныеСценарии
//   * ЭтоГруппа        - Булево
//   * РодительскаяГруппа - CatalogRef.ДемонстрационныеСценарии
//
&НаСервереБезКонтекста
Функция ГКСИ_СобратьПоддеревоАльбомаНаСервере(МассивКорневыхГрупп)

	Поддерево = Новый Массив;
	Обработанные = Новый Соответствие;

	Если МассивКорневыхГрупп = Неопределено Тогда
		Возврат Поддерево;
	КонецЕсли;

	Для Каждого Корень Из МассивКорневыхГрупп Цикл
		Если НЕ ЗначениеЗаполнено(Корень) Тогда
			Продолжить;
		КонецЕсли;
		Если Обработанные.Получить(Корень) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Корень, Истина);
		Поддерево.Добавить(Новый Структура(
			"Сценарий, ЭтоГруппа, РодительскаяГруппа",
			Корень, Истина, Справочники.ДемонстрационныеСценарии.ПустаяСсылка()));
		ГКСИ_ДобавитьУзелПоддерева(Поддерево, Корень, Обработанные);
	КонецЦикла;

	Возврат Поддерево;

КонецФункции

&НаСервереБезКонтекста
Процедура ГКСИ_ДобавитьУзелПоддерева(Поддерево, Группа, Обработанные)

	Если НЕ ЗначениеЗаполнено(Группа) Тогда
		Возврат;
	КонецЕсли;
	// Защита от повтора нужна только для членов Группы; саму Группу
	// в Поддерево уже добавил вызывающий код (ГКСИ_СобратьПоддеревоАльбомаНаСервере)
	// и пометил в Обработанные. Если бы мы выходили здесь по уже-добавленной
	// Группе, потомки никогда бы не собирались — поддерево оставалось бы
	// только из корневой записи (см. регрессию bugfix 2.21).

	ЧленыГруппы = ГКСИ_ГруппыСценариевСервер.ПолучитьЧленовГруппы(Группа);

	Для Каждого ЧленГруппы Из ЧленыГруппы Цикл
		Если Обработанные.Получить(ЧленГруппы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(ЧленГруппы, Истина);

		ЭтоГруппа = ЧленГруппы.ЭтоГруппа;
		Поддерево.Добавить(Новый Структура(
			"Сценарий, ЭтоГруппа, РодительскаяГруппа",
			ЧленГруппы, ЭтоГруппа, Группа));

		Если ЭтоГруппа Тогда
			ГКСИ_ДобавитьУзелПоддерева(Поддерево, ЧленГруппы, Обработанные);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает массив групп, в которые входят переданные сценарии.
//
// Параметры:
//  МассивСценариев - Массив из CatalogRef.ДемонстрационныеСценарии.
//
// Возвращаемое значение:
//  Массив из CatalogRef.ДемонстрационныеСценарии.
//
&НаСервереБезКонтекста
Функция ГКСИ_ПолучитьГруппыСценариевНаСервере(Знач МассивСценариев)

	Если МассивСценариев.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сценарии", МассивСценариев);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|ГКСИ_ГруппыСценариев.Группа КАК Группа
		|ИЗ
		|РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
		|ГДЕ
		|ГКСИ_ГруппыСценариев.Сценарий В(&Сценарии)";

	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Группа");
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ГКСИ_ДеревоСценариевВыполнитьОткрытие(ВыбраннаяСтрока)

	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НайденнаяСтрока = ГКСИ_ДеревоСценариев.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьЗначение(, НайденнаяСтрока.Сценарий);

КонецПроцедуры

&НаКлиенте
Процедура ГКСИ_ОткрытьФормуЭлемента(Сценарий, РодительГруппы)

	ПараметрыФормы = Новый Структура;
	Если Сценарий <> Неопределено Тогда
		ПараметрыФормы.Вставить("Ключ", Сценарий);
	КонецЕсли;

	Если РодительГруппы <> Неопределено Тогда
		ПараметрыФормы.Вставить("Родитель", РодительГруппы);
	КонецЕсли;

	ОткрытьФорму("Catalog.ДемонстрационныеСценарии.ObjectForm", ПараметрыФормы);

КонецПроцедуры

&НаСервере
Процедура ГКСИ_УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;

	ПолеГруппа = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеГруппа.Поле = Новый ПолеКомпоновкиДанных("Наименование");

	ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(
		Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ГКСИ_ДеревоСценариев.ЭтоГруппа");
	ЭлементОтбора.ВидСравнения    = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение  = Истина;

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста",
		Метаданные.ЭлементыСтиля.ШрифтЗаголовкаВсплывающейГруппы.Значение);

КонецПроцедуры

// Строит дерево значений исключительно по регистру ГКСИ_ГруппыСценариев.
//
// Алгоритм:
//  1. Один пакетный запрос забирает:
//     - все записи РС с непустым КодВКонтексте
//       (ресурс имеет формат "<КодКорня>.<ЛокальныйКод>", например
//       "001.002.001" — корневая группа инструкции с кодом 001,
//       узел с локальным кодом 002.001);
//     - свойства элементов справочника (Наименование, Код, ЭтоГруппа,
//       ПометкаУдаления) для отрисовки строк дерева.
//  2. Для каждой записи вычисляется код родителя — это её КодВКонтексте
//     без последней секции после последней точки. Например:
//       "001.002.001" -> родитель "001.002"
//       "001.002"     -> родитель "001"
//       "001"         -> родителя нет (это сама корневая #группа инструкции)
//     По коду родителя формируется соответствие ДочерниеКоды.
//  3. Корни дерева — записи с КодВКонтексте без точек (т.е. корневые
//     #группы инструкций). Они становятся верхними узлами дерева.
//  4. Для каждого корня рекурсивно раскрываются дочерние коды
//     (сортировка по строковому коду), формируя полное поддерево.
//  5. Осиротевшие записи (нет родителя в РС — например, для старых
//     данных без КодВКонтексте) собираются в отдельной ветке "(Сироты)".
//
// Так логика полностью опирается на ПолныйКодКонтекстный / КодВКонтексте
// из регистра, не зависит от вспомогательного реквизита КореньИнструкции
// и от связей (Сценарий, Группа) как от первичной иерархии.
//
&НаСервере
Процедура ГКСИ_ПостроитьДерево()

	ГКСИ_ДеревоСценариев.ПолучитьЭлементы().Очистить();

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ГКСИ_ГруппыСценариев.Сценарий КАК Сценарий,
	|	ГКСИ_ГруппыСценариев.КодВКонтексте КАК КодВКонтексте
	|ИЗ
	|	РегистрСведений.ГКСИ_ГруппыСценариев КАК ГКСИ_ГруппыСценариев
	|ГДЕ
	|	ГКСИ_ГруппыСценариев.КодВКонтексте <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Код КАК Код,
	|	Спр.Наименование КАК Наименование,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа,
	|	Спр.ПометкаУдаления КАК ПометкаУдаления,
	|	Спр.ТипГруппы КАК ТипГруппы
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК Спр");

	РезультатПакета = Запрос.ВыполнитьПакет();

	// Кеш свойств справочника по ссылке.
	КэшПоСсылке = Новый Соответствие;
	ВыборкаСпр = РезультатПакета[1].Выбрать();
	Пока ВыборкаСпр.Следующий() Цикл
		КэшЗаписи = Новый Структура;
		КэшЗаписи.Вставить("Наименование",    ВыборкаСпр.Наименование);
		КэшЗаписи.Вставить("Код",             ВыборкаСпр.Код);
		КэшЗаписи.Вставить("ЭтоГруппа",       ВыборкаСпр.ЭтоГруппа);
		КэшЗаписи.Вставить("ПометкаУдаления", ВыборкаСпр.ПометкаУдаления);
		КэшЗаписи.Вставить("ТипГруппы",       ВыборкаСпр.ТипГруппы);
		КэшПоСсылке.Вставить(ВыборкаСпр.Ссылка, КэшЗаписи);
	КонецЦикла;

	// КодВКонтексте -> Запись из РС.
	ЗаписиПоКоду = Новый Соответствие;

	ВыборкаСвязей = РезультатПакета[0].Выбрать();
	Пока ВыборкаСвязей.Следующий() Цикл
		КодВКонтексте = ВыборкаСвязей.КодВКонтексте;
		Если НЕ ЗначениеЗаполнено(КодВКонтексте) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаписиПоКоду.Получить(КодВКонтексте) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("Сценарий",      ВыборкаСвязей.Сценарий);
		Запись.Вставить("КодВКонтексте", КодВКонтексте);
		ЗаписиПоКоду.Вставить(КодВКонтексте, Запись);
	КонецЦикла;

	// Собираем все коды: реальные из РС + промежуточные префиксы.
	// Корневая #-группа инструкции (например, "001" для ДМТО) всегда присутствует
	// в РС как запись (Сценарий = Инструкция по ДМТО, КодВКонтексте = "001")
	// благодаря откату bugfix 1.95 (см. ОбработатьУзелРекурсивно): #-заголовку
	// верхнего уровня теперь пишется КореньИнструкции = он сам.
	// Дочерние коды вкладываются через КодРодителя(Код) — строковый префикс.
	ВсеКоды = Новый Массив;
	УжеВВсехКодах = Новый Соответствие;
	Для Каждого КлючИЗначение Из ЗаписиПоКоду Цикл
		Код = КлючИЗначение.Ключ;
		Если УжеВВсехКодах[Код] = Неопределено Тогда
			УжеВВсехКодах.Вставить(Код, Истина);
			ВсеКоды.Добавить(Код);
		КонецЕсли;
		// Промежуточные коды: для "001.001.002.001" это "001.001.002", "001.001", "001".
		// Добавляем ТОЛЬКО если для такого кода ЕСТЬ запись в РС — иначе это
		// фиктивный промежуточный уровень, которого нет в реальной инструкции
		// (например, обёртка содержит сразу #-заголовки, без промежуточной группы).
		// Если родительский код отсутствует в РС, дочерний узел ниже будет
		// поднят к ближайшему существующему предку (ГКСИ_НайтиБлижайшегоПредка).
		// Корневой код "001" (самоссылка обёртки) всегда есть в РС.
		КодПромежуточный = Код;
		Пока Истина Цикл
			ПозицияТочки = СтрНайти(КодПромежуточный, ".", НаправлениеПоиска.СКонца);
			Если ПозицияТочки = 0 Тогда
				Прервать;
			КонецЕсли;
			КодПромежуточный = Лев(КодПромежуточный, ПозицияТочки - 1);
			Если УжеВВсехКодах[КодПромежуточный] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЗаписиПоКоду.Получить(КодПромежуточный) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УжеВВсехКодах.Вставить(КодПромежуточный, Истина);
			ВсеКоды.Добавить(КодПромежуточный);
		КонецЦикла;
	КонецЦикла;

	ВсеКодыСорт = ГКСИ_ОтсортироватьМассивСтрок(ВсеКоды);

	// ВеткаПоКоду: КодВКонтексте -> СтрокаДерева. Используется для поиска
	// уже созданного родителя при создании дочерней строки.
	ВеткаПоКоду = Новый Соответствие;

	Для Каждого Код Из ВсеКодыСорт Цикл
		КодРодителя = ГКСИ_КодРодителяПоКоду(Код);

		Если КодРодителя = "" Тогда
			// Корневой код — создаём в корне дерева.
			ГКСИ_СоздатьСтрокуДерева(ГКСИ_ДеревоСценариев, Код,
				ЗаписиПоКоду, КэшПоСсылке, ВеткаПоКоду);
		Иначе
			// Дочерний код: ищем ближайшего существующего предка в ВеткаПоКоду.
			// Прямой родитель может отсутствовать в РС (промежуточная группа,
			// которой нет в реальной инструкции) — тогда поднимаемся выше.
			РодительскаяВетка = ГКСИ_НайтиБлижайшегоПредка(КодРодителя, ВеткаПоКоду);
			Если РодительскаяВетка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ГКСИ_СоздатьСтрокуДерева(РодительскаяВетка, Код,
				ЗаписиПоКоду, КэшПоСсылке, ВеткаПоКоду);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Создаёт строку дерева в указанной родительской коллекции и заполняет её поля
// по записи из РС. Используется в ГКСИ_ПостроитьДерево.
// Метод Добавить() коллекции формы дерева принимает параметры только через
// копирование значений в возвращённый элемент — поэтому здесь нет
// ГКСИ_ДеревоСценариев.ПолучитьЭлементы().Добавить(Элемент).
//
&НаСервере
Процедура ГКСИ_СоздатьСтрокуДерева(РодительскаяВетка, КодВКонтексте,
		ЗаписиПоКоду, КэшПоСсылке, ВеткаПоКоду)

	Ветка = РодительскаяВетка.ПолучитьЭлементы().Добавить();
	Ветка.ПолныйКодКонтекстный = КодВКонтексте;
	Ветка.КоличествоГрупп      = 0;

	ЗаписьЖурналаРегистрации("ГКСИ.СоздатьСтрокуДерева",
		УровеньЖурналаРегистрации.Информация, , ,
		"[v2.14][ДИАГН] Вход: КодВКонтексте=" + КодВКонтексте
			+ ", ВсегоЗаписей=" + ЗаписиПоКоду.Количество()
			+ ", ВсегоКэш=" + КэшПоСсылке.Количество());

	// 1) Приоритет — запись из РС (если есть). Это и сценарий, и группа —
	// обе пишутся в регистр с КодВКонтексте.
	Запись = ЗаписиПоКоду.Получить(КодВКонтексте);
	Если Запись <> Неопределено Тогда
		Сценарий     = Запись.Сценарий;
		КэшСценария  = КэшПоСсылке[Сценарий];
		Ветка.Сценарий = Сценарий;
		ЗаписьЖурналаРегистрации("ГКСИ.СоздатьСтрокуДерева",
			УровеньЖурналаРегистрации.Информация, , ,
			"[v2.14][ДИАГН] Блок1: Запись найдена, КодВКонтексте=" + КодВКонтексте
				+ ", Сценарий=" + Строка(Сценарий)
				+ ", КэшНайден=" + Строка(КэшСценария <> Неопределено)
				+ ?(КэшСценария <> Неопределено,
					", ИмяИзКэш=" + КэшСценария.Наименование, ", ИмяИзСтрокиСценарий"));
		Если КэшСценария <> Неопределено Тогда
			Ветка.Наименование = КэшСценария.Наименование;
			Ветка.ЭтоГруппа    = КэшСценария.ЭтоГруппа;
			Если КэшСценария.ЭтоГруппа Тогда
				Ветка.Картинка = ГКСИ_ИндексКартинкиГруппы(КэшСценария);
			ИначеЕсли КэшСценария.ПометкаУдаления Тогда
				Ветка.Картинка = 4;
			Иначе
				Ветка.Картинка = 3;
			КонецЕсли;
		Иначе
			Ветка.Наименование = Строка(Сценарий);
			Ветка.ЭтоГруппа    = Истина;
			Ветка.Картинка     = 0;
		КонецЕсли;
		ВеткаПоКоду.Вставить(КодВКонтексте, Ветка);
		Возврат;
	КонецЕсли;

	// 2) Фиктивный промежуточный узел (например, "001.001" без записи в РС).
	// Это возможно для пустых уровней иерархии — показываем их как плейсхолдеры.
	Ветка.Сценарий     = Неопределено;
	Ветка.ЭтоГруппа    = Истина;
	Ветка.Наименование = КодВКонтексте;
	Ветка.Картинка     = 0;
	ВеткаПоКоду.Вставить(КодВКонтексте, Ветка);

КонецПроцедуры

// Возвращает код родителя по коду в контексте: КодВКонтексте без последней
// секции после последней точки. Например:
//   "001"            -> ""
//   "001.002"        -> "001"
//   "001.002.001"    -> "001.002"
//
// Пустая строка на выходе означает, что узел сам является корнем дерева.
//
&НаСервере
Функция ГКСИ_КодРодителяПоКоду(КодВКонтексте)

	ПозицияТочки = СтрНайти(КодВКонтексте, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(КодВКонтексте, ПозицияТочки - 1);

КонецФункции

// Рекурсивно добавляет узел по записи РС в дерево и раскрывает его
// дочерние коды (сортировка по строковому коду).
// Процедура оставлена для совместимости с внешними вызовами, но не
// используется в ГКСИ_ПостроитьДерево (иерархия теперь строится
// двухпроходным алгоритмом через ВеткаПоКоду).
//
&НаСервере
Процедура ГКСИ_ДобавитьУзелПоКоду(Запись, РодительскаяВетка,
		ЗаписиПоКоду, ДочерниеКоды, КэшПоСсылке)

	Сценарий = Запись.Сценарий;
	КэшСценария = КэшПоСсылке[Сценарий];
	ЭтоГруппа = (КэшСценария <> Неопределено И КэшСценария.ЭтоГруппа);

	Ветка = РодительскаяВетка.ПолучитьЭлементы().Добавить();
	Ветка.Сценарий             = Сценарий;
	Ветка.ЭтоГруппа            = ЭтоГруппа;
	Ветка.Наименование         = ?(КэшСценария <> Неопределено,
		КэшСценария.Наименование, Строка(Сценарий));
	Ветка.ПолныйКодКонтекстный = Запись.КодВКонтексте;
	Ветка.КоличествоГрупп      = 0;
	Если ЭтоГруппа Тогда
		Ветка.Картинка = ГКСИ_ИндексКартинкиГруппы(КэшСценария);
	Иначе
		Ветка.Картинка = ?(КэшСценария <> Неопределено
			И КэшСценария.ПометкаУдаления, 4, 3);
	КонецЕсли;

	Если НЕ ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	ДетиКоды = ДочерниеКоды.Получить(Запись.КодВКонтексте);
	Если ДетиКоды = Неопределено ИЛИ ДетиКоды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ДетиКодыСорт = ГКСИ_ОтсортироватьМассивСтрок(ДетиКоды);
	Для Каждого КодРебенка Из ДетиКодыСорт Цикл
		ЗаписьРебенка = ЗаписиПоКоду.Получить(КодРебенка);
		Если ЗаписьРебенка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ГКСИ_ДобавитьУзелПоКоду(ЗаписьРебенка, Ветка,
			ЗаписиПоКоду, ДочерниеКоды, КэшПоСсылке);
	КонецЦикла;

КонецПроцедуры

// Возвращает новый массив строк, отсортированный по возрастанию
// представления (для кодов в формате "001", "001.001", "001.002.001"
// строковое сравнение даёт естественный порядок).
//
&НаСервере
Функция ГКСИ_ОтсортироватьМассивСтрок(МассивСтрок)

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из МассивСтрок Цикл
		Список.Добавить(Элемент, Строка(Элемент));
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает индекс картинки для строки группы в коллекции ПиктограммыЭлементов.
//   0  — обычная группа без пометки удаления,
//   1  — обычная группа с пометкой удаления,
//   19 — группа-ветвление без пометки удаления,
//   20 — группа-ветвление с пометкой удаления.
//
&НаСервере
Функция ГКСИ_ИндексКартинкиГруппы(КэшГруппы)

	Если КэшГруппы = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ЭтоВетвление = Ложь;
	Если КэшГруппы.Свойство("ТипГруппы") Тогда
		ЭтоВетвление = (КэшГруппы.ТипГруппы
			= Перечисления.ТипыГруппДемонстрационныхСценариев.Ветвление);
	КонецЕсли;

	ПометкаУдаления = ?(КэшГруппы.Свойство("ПометкаУдаления"),
		КэшГруппы.ПометкаУдаления, Ложь);

	Если ЭтоВетвление Тогда
		Возврат ?(ПометкаУдаления, 20, 19);
	КонецЕсли;

	Возврат ?(ПометкаУдаления, 1, 0);

КонецФункции

// Собирает статистику построенного дерева для диагностики:
//   * сколько корневых групп создано;
//   * сколько строк в каждой корневой ветке (сортировка по убыванию);
//   * сколько всего строк в дереве.
// Вызывается из ПриСозданииНаСервере — текст отображается пользователю
// через СообщениеПользователю. Если сообщения нет — значит конфигурация
// БД не обновлена (выполняется старый код).
//
&НаСервере
Функция ГКСИ_ОтладкаДерева()

	Корневые = ГКСИ_ДеревоСценариев.ПолучитьЭлементы();
	КоличествоКорневых = Корневые.Количество();

	СписокВеток = Новый СписокЗначений;
	ВсегоСтрок = 0;

	Для Каждого Ветка Из Корневые Цикл
		РазмерВетки = ГКСИ_ПодсчитатьСтрокиВетки(Ветка);
		ВсегоСтрок = ВсегоСтрок + РазмерВетки;
		СписокВеток.Добавить(Ветка.Наименование + " (" + Ветка.ПолныйКодКонтекстный + ") "
			+ Формат(РазмерВетки, "ЧГ=") + " строк",
			Формат(-РазмерВетки, "ЧГ=") + Ветка.Наименование);
	КонецЦикла;

	СписокВеток.СортироватьПоПредставлению();
	ТекстВеток = "";
	Для Каждого Элемент Из СписокВеток Цикл
		ТекстВеток = ТекстВеток + ?(ТекстВеток = "", "", "; ") + Элемент.Значение;
	КонецЦикла;

	Возврат "корней " + Формат(КоличествоКорневых, "ЧГ=") + ", всего " + Формат(ВсегоСтрок, "ЧГ=")
		+ ". " + ТекстВеток;

КонецФункции

&НаСервере
Функция ГКСИ_ПодсчитатьСтрокиВетки(Ветка)

	Счетчик = 1;
	Для Каждого Подветка Из Ветка.ПолучитьЭлементы() Цикл
		Счетчик = Счетчик + ГКСИ_ПодсчитатьСтрокиВетки(Подветка);
	КонецЦикла;
	Возврат Счетчик;

КонецФункции

// Возвращает версию расширения "пустая_для_гкс.ГКС_Инструкции"
// как строку для диагностического сообщения.
//
// ВАЖНО: Метаданные.Версия в коде расширения возвращает версию
// ОСНОВНОЙ конфигурации (например, "2.5.26.118"), а не расширения.
// Версия самого расширения доступна через Метаданные.Конфигурация
// только в контексте конфигуратора, а в реальном сеансе
// Предприятия это метаданные БД основной конфигурации.
//
// Поэтому версия расширения возвращается как явная строка-константа.
// При обновлении версии расширения — синхронно менять эту строку.
//
// Используется в ГКСИ_ОтладкаДерева (текст сообщения ПриСозданииНаСервере).
//
&НаСервере
Функция ГКСИ_ВерсияРасширения()

	Возврат "2.20";

КонецФункции

// Ищет ближайшего существующего предка для кода в дереве.
// Сначала проверяет сам КодВКонтексте в ВеткаПоКоду, и если он уже создан —
// возвращает его. Иначе поднимается по иерархии префиксов через точку
// ("001.001.002" → "001.001" → "001"), пока не найдёт код, для которого
// в ВеткаПоКоду уже создана строка. Возвращает Неопределено, если ни один
// предок не найден (выше корневого "001").
//
// Используется в ГКСИ_ПостроитьДерево: если для "001.001.001" родительский
// код "001.001" отсутствует в РС (промежуточной группы нет в инструкции),
// узел поднимается к ближайшему существующему предку — "001" (обёртка).
//
// Параметры:
//  КодВКонтексте - Строка - код, для которого ищется ближайший существующий предок.
//  ВеткаПоКоду   - Соответствие из КлючИЗначение - КодВКонтексте -> СтрокаДерева формы.
//
// Возвращаемое значение:
//  СтрокаДереваЗначений, Неопределено - ветка ближайшего существующего предка
//                                     или Неопределено, если предков нет.
//
&НаСервере
Функция ГКСИ_НайтиБлижайшегоПредка(КодВКонтексте, ВеткаПоКоду)

	// Сначала проверяем сам код — если он уже в ВеткаПоКоду, значит это
	// прямой родитель (или сам узел), и подниматься выше не нужно.
	Ветка = ВеткаПоКоду[КодВКонтексте];
	Если Ветка <> Неопределено Тогда
		Возврат Ветка;
	КонецЕсли;

	ТекущийКод = КодВКонтексте;
	Пока Истина Цикл
		ПозицияТочки = СтрНайти(ТекущийКод, ".", НаправлениеПоиска.СКонца);
		Если ПозицияТочки = 0 Тогда
			// Дошли до корневого уровня — выше идти некуда.
			Возврат Неопределено;
		КонецЕсли;
		ТекущийКод = Лев(ТекущийКод, ПозицияТочки - 1);
		Ветка = ВеткаПоКоду[ТекущийКод];
		Если Ветка <> Неопределено Тогда
			Возврат Ветка;
		КонецЕсли;
	КонецЦикла;

КонецФункции


#КонецОбласти
