// Модуль формы АльбомПроцессов. Заменяет типовую логику построения
// альбома процессов (которая опирается на платформенный Родитель
// справочника ДемонстрационныеСценарии, обнуляемый в
// ObjectModule.ГКСИ_ПередЗаписью) на собственный построитель
// ГКСИ_АльбомПроцессов, использующий подсистему множественной
// принадлежности.

#Область ОбработчикиСобытийФормы

// Полностью заменяет типовой обработчик ПриСозданииНаСервере, который
// обязательно требует параметр СценарииОтчета и при его отсутствии
// устанавливает Отказ = Истина и выводит сообщение
// "Не выбрано ни одной групп демонстрационных сценариев для формирования альбома процессов".
//
// Если форма открыта из ФормаСпискаДеревоГрупп с параметром ГруппыДляАльбома
// (Массив из CatalogRef.ДемонстрационныеСценарии), строится альбом только по
// этим группам. Иначе - альбом по всему каталогу.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
&Вместо("ПриСозданииНаСервере")
&НаСервере
Процедура ГКСИ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	АдресГрупп = Неопределено;
	Если Параметры.Свойство("ГруппыДляАльбомаАдрес") Тогда
		АдресГрупп = Параметры.ГруппыДляАльбомаАдрес;
	КонецЕсли;
	Если АдресГрупп <> Неопределено Тогда
		ГруппыДляАльбома = ПолучитьИзВременногоХранилища(АдресГрупп);
	КонецЕсли;

	// Сохраняем массив групп во временном хранилище: при изменении ширины
	// картинок Параметры уже недоступны, и без этого альбом перестраивался
	// бы по всему справочнику.
	Если ГруппыДляАльбома <> Неопределено Тогда
		ГруппыДляАльбомаАдрес = ПоместитьВоВременноеХранилище(
			ГруппыДляАльбома, УникальныйИдентификатор);
	КонецЕсли;

	// Поддерево альбома: форма списка передаёт готовое поддерево выделенных групп
	// (плоский массив узлов с указанием родителя) напрямую через ПараметрыФормы.
	// Чтобы массив пережил серверные вызовы внутри формы альбома (например,
	// ГКСИ_СобратьАльбомНаСервере), сохраняем его в ВХ с УИД текущей формы:
	// ПолучитьИзВременногоХранилища(<адрес>) без УИД читает с привязкой к УИД
	// текущей формы, что совпадает с УИДом формы альбома.
	Если Параметры.Свойство("Поддерево")
			И ТипЗнч(Параметры.Поддерево) = Тип("Массив")
			И Параметры.Поддерево.Количество() > 0 Тогда
		ПоддеревоАльбомаАдрес = ПоместитьВоВременноеХранилище(
			Параметры.Поддерево, УникальныйИдентификатор);
	КонецЕсли;

	ГКСИ_ИнициализироватьПоляШирины();

	// Команды массового разворачивания/сворачивания групп альбома.
	ГКСИ_ДобавитьКомандыСворачивания();

	// Привязка клиентского обработчика очистки HTML-поля перед закрытием.
	// Тонкий клиент: аннотация &Вместо / &Перед не работает на несуществующий
	// типовой обработчик, поэтому используем УстановитьДействие.
	УстановитьДействие("ПередЗакрытием", "ГКСИ_ПередЗакрытием");

	ТекстHTML = ГКСИ_СобратьАльбомНаСервере();

	// Типовая форма по событию ТекстHTMLДокументСформирован автоматически
	// вызывает диалог печати. Поскольку альбом — это предпросмотр,
	// печать при открытии не нужна: подавляем её явно.
	НеВызыватьКомандуПечати = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перехват типового нажатия в поле HTML-документа.
//
// Типовой обработчик ДемонстрационныеСценарииКлиент.ПриНажатииВПолеHTMLДокумента
// для любой непустой ссылки отменяет стандартную обработку, а для адресов
// без префикса базы вызывает ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку.
// Внутренние якоря альбома (#gksi-node-<uuid>) в этот сценарий не попадают:
// платформа пыталась бы открыть навигационную ссылку «#gksi-node-...» и
// прокрутка к разделу не выполнялась.
//
// Поэтому адреса-якоря обрабатываем сами (прокрутка к разделу), а всё
// остальное передаём типовому обработчику без изменений.
//
// Параметры:
//  Элемент              - ПолеФормы - поле HTML-документа, в котором произошло нажатие.
//  ДанныеСобытия        - ФиксированнаяСтруктура - данные события нажатия.
//  СтандартнаяОбработка - Булево - признак стандартной обработки события.
//
&Вместо("ТекстHTMLПриНажатии")
&НаКлиенте
Процедура ГКСИ_ТекстHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ПутьКВидео = ГКСИ_MarkdownКлиент.ПутьВидеоИзДанныхСобытия(ДанныеСобытия);
	Если Не ПустаяСтрока(ПутьКВидео) Тогда
		// Запасная ссылка под HTML5-плеером: открываем файл внешним плеером.
		НачатьЗапускПриложения(
			ГКСИ_MarkdownКлиент.ПустоеОписаниеОповещенияДляЗапускаПриложения(), ПутьКВидео);
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	ИмяЯкоря = ГКСИ_ИмяЯкоряИзДанныхСобытия(ДанныеСобытия);
	Если Не ПустаяСтрока(ИмяЯкоря)
			И ГКСИ_ПерейтиКЯкорюАльбома(ИмяЯкоря) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	ДемонстрационныеСценарииКлиент.ПриНажатииВПолеHTMLДокумента(
		ЭтотОбъект, Элемент, ДанныеСобытия, СтандартнаяОбработка);

КонецПроцедуры

// Возвращает имя внутреннего якоря документа из данных события нажатия.
//
// Имя берётся из атрибута data-gksi-anchor элемента ссылки: этот атрибут
// проставляет ГКСИ_СсылкиСценариев.ПереписатьСсылкиНаЯкоряВHTML вместе с
// адресом #gksi-node-<uuid> и не зависит от того, как браузер разрешил href
// относительно адреса документа. Если атрибута нет (например, ссылку
// сформировал не альбом), используется фрагмент после "#" из адреса события.
//
// Параметры:
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события ПриНажатии поля HTML-документа.
//
// Возвращаемое значение:
//  Строка - имя якоря без символа "#"; пустая строка, если нажатие не по якорю
//           внутри документа.
//
&НаКлиенте
Функция ГКСИ_ИмяЯкоряИзДанныхСобытия(ДанныеСобытия)

	Если ДанныеСобытия = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Адрес = "";
	ИмяЯкоряИзРазметки = "";
	Попытка
		Если ДанныеСобытия.Anchor <> Неопределено Тогда
			ЗначениеАтрибута = ДанныеСобытия.Anchor.getAttribute("data-gksi-anchor");
			Если ТипЗнч(ЗначениеАтрибута) = Тип("Строка") Тогда
				ИмяЯкоряИзРазметки = СокрЛП(ЗначениеАтрибута);
			КонецЕсли;
			Адрес = ДанныеСобытия.Anchor.getAttribute("href");
		КонецЕсли;
	Исключение
		Адрес = "";
		ИмяЯкоряИзРазметки = "";
	КонецПопытки;

	Если Не ПустаяСтрока(ИмяЯкоряИзРазметки) Тогда
		Возврат ИмяЯкоряИзРазметки;
	КонецЕсли;

	Если ПустаяСтрока(Адрес) Тогда
		Адрес = СокрЛП(Строка(ДанныеСобытия.Href));
	КонецЕсли;

	ПозицияРешетки = СтрНайти(Адрес, "#");
	Если ПозицияРешетки = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Адрес, ПозицияРешетки + 1);

КонецФункции

// Прокручивает документ альбома к разделу по внутреннему якорю.
//
// Перед прокруткой раскрываются все свёрнутые <details> по пути к целевому
// узлу: скрытый узел браузер прокрутить не может.
//
// Параметры:
//  ИмяЯкоря - Строка - имя якоря узла (см. ГКСИ_СсылкиСценариев.ИмяЯкоряУзла).
//
// Возвращаемое значение:
//  Булево - Истина, если узел найден в документе и прокрутка выполнена.
//
&НаКлиенте
Функция ГКСИ_ПерейтиКЯкорюАльбома(ИмяЯкоря)

	Если ПустаяСтрока(ИмяЯкоря) Тогда
		Возврат Ложь;
	КонецЕсли;

	Документ = ГКСИ_ДокументАльбома();
	Если Документ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ЦелевойУзел = Документ.getElementById(ИмяЯкоря);
	Если ЦелевойУзел = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Родитель = ЦелевойУзел.parentNode;
	Пока Родитель <> Неопределено Цикл
		Если Строка(Родитель.tagName) = "DETAILS" Тогда
			Родитель.setAttribute("open", "open");
		КонецЕсли;
		Родитель = Родитель.parentNode;
	КонецЦикла;

	ЦелевойУзел.scrollIntoView(Истина);

	Возврат Истина;

КонецФункции

// Возвращает DOM-документ поля ТекстHTML альбома.
//
// Возвращаемое значение:
//  ВнешнийОбъект, Неопределено - документ поля (ДокументHTMLDOM) или
//  Неопределено, если поле ещё не сформировано либо недоступно.
//
&НаКлиенте
Функция ГКСИ_ДокументАльбома()

	Попытка
		Возврат Элементы.ТекстHTML.Документ;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Инициализация полей выбора ширины картинок: список единиц измерения,
// минимум слайдера, значения по умолчанию, привязка обработчиков.
//
// @skip-warning SU93 - метод вызывается из обработчика ПриСозданииНаСервере,
// оставлен рядом для удобства чтения и сопровождения.
&НаСервере
Процедура ГКСИ_ИнициализироватьПоляШирины()

	// Слайдер: числа 1..200 с шагом 1.
	ЭлементСлайдер = Элементы.Найти("ШиринаКартинокЧисло");
	Если ЭлементСлайдер <> Неопределено Тогда
		ЭлементСлайдер.МинимальноеЗначение = 1;
		ЭлементСлайдер.МаксимальноеЗначение = 200;
		ЭлементСлайдер.Шаг = 1;
		ЭлементСлайдер.БольшойШаг = 10;
		ЭлементСлайдер.ШагРазметки = 25;
		ЭлементСлайдер.Ширина = 20;
		ЭлементСлайдер.АвтоМаксимальнаяШирина = Ложь;
		ЭлементСлайдер.РастягиватьПоГоризонтали = Ложь;
		ЭлементСлайдер.УстановитьДействие("ПриИзменении",
			"ГКСИ_Подключаемый_ШиринаКартинокЧислоПриИзменении");
	КонецЕсли;

	// Подпись диапазона под слайдером: "1 ⟵⟶ 200".
	ЭлементыДиапазон = Элементы.Найти("ШиринаКартинокДиапазонПодпись");
	Если ЭлементыДиапазон = Неопределено Тогда
		ЭлементыДиапазон = Элементы.Добавить(
			"ШиринаКартинокДиапазонПодпись",
			Тип("ДекорацияФормы"),
			ЭлементСлайдер.Родитель);
		ЭлементыДиапазон.Вид = ВидДекорацииФормы.Надпись;
		ЭлементыДиапазон.Заголовок = "1  ⟵⟶  200";
		ЭлементыДиапазон.Ширина = 20;
		ЭлементыДиапазон.АвтоМаксимальнаяШирина = Ложь;
		ЭлементыДиапазон.РастягиватьПоГоризонтали = Ложь;
		ЭлементыДиапазон.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		ЭлементыДиапазон.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Верх;
		// Размещаем сразу после слайдера.
		Элементы.Переместить(ЭлементыДиапазон, ЭлементСлайдер.Родитель, ЭлементСлайдер);
	КонецЕсли;

	// Поле выбора единицы: px, %, em, rem, vw, vh.
	ЭлементЕдиница = Элементы.Найти("ШиринаКартинокЕдиница");
	Если ЭлементЕдиница <> Неопределено Тогда
		ЭлементЕдиница.СписокВыбора.Очистить();
		ЭлементЕдиница.СписокВыбора.Добавить("px",  "px  — пиксели");
		ЭлементЕдиница.СписокВыбора.Добавить("%",   "%   — проценты от ширины контейнера");
		ЭлементЕдиница.СписокВыбора.Добавить("em",  "em  — относительно шрифта");
		ЭлементЕдиница.СписокВыбора.Добавить("rem", "rem — относительно корневого шрифта");
		ЭлементЕдиница.СписокВыбора.Добавить("vw",  "vw  — проценты от ширины окна");
		ЭлементЕдиница.СписокВыбора.Добавить("vh",  "vh  — проценты от высоты окна");
		ЭлементЕдиница.УстановитьДействие("ПриИзменении",
			"ГКСИ_Подключаемый_ШиринаКартинокЕдиницаПриИзменении");
	КонецЕсли;

	// Значения по умолчанию.
	Если ШиринаКартинокЧисло = 0 Тогда
		ШиринаКартинокЧисло = 100;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ШиринаКартинокЕдиница) Тогда
		ШиринаКартинокЕдиница = "%";
	КонецЕсли;

	// Атрибут для декорации-надписи (чтобы EDT не ругался на пустые
	// реквизиты; само значение не используется — текст берётся из
	// Элементы.ШиринаКартинокДиапазонПодпись.Заголовок).
	ШиринаКартинокДиапазон = "1 ⟵⟶ 2000";

КонецПроцедуры

// Обработчик изменения числа на слайдере — обновляет CSS в DOM HTML-поля
// без серверного вызова и без перезагрузки картинок. Это критично для альбомов
// с большим количеством изображений: раньше каждый «чих» слайдера вызывал
// полный пакет запросов + перекодирование всех картинок в base64 + пересылку
// HTML на клиент, что вешало сеанс при нескольких десятках картинок.
// Привязывается программно в ГКСИ_ПриСозданииНаСервере.
&НаКлиенте
Процедура ГКСИ_Подключаемый_ШиринаКартинокЧислоПриИзменении(Элемент)

	ГКСИ_ОбновитьСтильКартинок();

КонецПроцедуры

// Обработчик изменения единицы измерения — обновляет CSS в DOM HTML-поля.
&НаКлиенте
Процедура ГКСИ_Подключаемый_ШиринаКартинокЕдиницаПриИзменении(Элемент)

	ГКСИ_ОбновитьСтильКартинок();

КонецПроцедуры

// Клиентский апдейт CSS-блока <style id="album-imgs-style"> в документе
// HTML-поля ТекстHTML. Не обращается к серверу и не перекодирует картинки.
//
// Используем textContent, а не innerHTML — содержимое <style> не парсится
// как HTML, и textContent не вызывает повторного парсинга CSS-правил в DOM
// (в отличие от удаления/вставки узла). Браузер сам инвалидирует правила
// при изменении текста <style>.
&НаКлиенте
Процедура ГКСИ_ОбновитьСтильКартинок()

	ШиринаCSS = Строка(ШиринаКартинокЧисло) + ШиринаКартинокЕдиница;
	ШиринаCSS = СокрЛП(ШиринаCSS);
	Если ПустаяСтрока(ШиринаCSS) Тогда
		Возврат;
	КонецЕсли;

	НовыйCSS = "img { max-width: " + ШиринаCSS + " !important; max-height: " + ШиринаCSS + " !important; }";

	Попытка
		HTMLПоле = Элементы.ТекстHTML;
		Документ = HTMLПоле.Документ;
		УзелСтиля = Документ.getElementById("album-imgs-style");
		Если УзелСтиля <> Неопределено Тогда
			УзелСтиля.textContent = НовыйCSS;
		КонецЕсли;
	Исключение
		// Документ ещё не сформирован или поле недоступно (например,
		// в момент переключения страницы). Тихо игнорируем — стиль
		// применится при следующем изменении слайдера.
	КонецПопытки;

КонецПроцедуры

// Серверная обёртка для принудительного перестроения альбома. Сохранена
// для совместимости с внешними вызовами и для случая, когда клиент
// запрашивает полную пересборку (например, при смене набора групп).
&НаСервере
Процедура ГКСИ_ПерестроитьАльбом()

	ТекстHTML = ГКСИ_СобратьАльбомНаСервере();

КонецПроцедуры

// Очистка HTML-поля перед закрытием формы.
//
// Каждое изображение в альбоме встроено как data:URI в base64 (см.
// ГКСИ_ТелоГипертекста → ГКСИ_MarkdownПереопределяемый.ЗаменитьКодыИзображенийНаDataURI).
// Даже после уничтожения управляемой формы браузер, на котором 1С
// рендерит HTMLDocumentField, может удерживать распакованные картинки
// в памяти до следующего GC. Если альбом открывают несколько раз подряд
// или между альбомами работают с другими тяжёлыми формами, память
// процесса 1cv8c растёт.
//
// Перед закрытием формы принудительно очищаем содержимое <body> и
// освобождаем реквизит формы. Это явный сигнал браузеру отпустить
// <img>-узлы и связанные с ними data:URI.
//
// Подключается программно в ГКСИ_ПриСозданииНаСервере — типовой
// обработчик ПередЗакрытием в форме АльбомПроцессов не определён,
// но если в будущем появится (например, диалог подтверждения),
// мы не должны его ломать: вешаемся через УстановитьДействие.
//
&НаКлиенте
Процедура ГКСИ_ПередЗакрытием(Отказ, СтандартнаяОбработка)

	ГКСИ_ОчиститьHTMLПередЗакрытием();

КонецПроцедуры

// Клиентская реализация очистки HTML-поля.
// 1. Обнуляем src у всех <img> — это снимает ссылки на декодированные
//    WebKit-битмапы и позволяет освободить bitmap-кеш до разрушения поля.
// 2. Очищаем <head>: <style id="album-imgs-style">, <script>, <link>,
//    <meta> — раньше они не очищались и удерживали память до закрытия формы.
// 3. Очищаем <body> — снимает все DOM-узлы с их data:URI в атрибутах.
// 4. Сбрасываем реквизит формы `ТекстHTML`, чтобы гигантская строка
//    с data:URI не висела в контексте управляемой формы.
// Полная выгрузка bitmap-кеша WebKit произойдёт после закрытия формы,
// когда платформа разрушит HTMLDocumentField.
//
&НаКлиенте
Процедура ГКСИ_ОчиститьHTMLПередЗакрытием()

	Попытка
		HTMLПоле = Элементы.ТекстHTML;
		Документ = HTMLПоле.Документ;
		Если Документ <> Неопределено Тогда
			Картинки = Документ.images;
			Для Индекс = 0 По Картинки.length - 1 Цикл
				Картинки[Индекс].src = "";
			КонецЦикла;
			Голова = Документ.head;
			Если Голова <> Неопределено Тогда
				Голова.innerHTML = "";
			КонецЕсли;
			Тело = Документ.body;
			Если Тело <> Неопределено Тогда
				Тело.innerHTML = "";
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Документ мог быть ещё не сформирован или уже разрушен —
		// не критично.
	КонецПопытки;

	ТекстHTML = "";

КонецПроцедуры

// Собирает альбом, отдавая в построитель готовую строку ШиринаКартинок.
// Заодно вычисляет целевую ширину в пикселях для сжатия картинок на сервере.
//
// @skip-warning SU93 - серверный хелпер для обработчика формы.
&НаСервере
Функция ГКСИ_СобратьАльбомНаСервере()

	ШиринаКартинок = Строка(ШиринаКартинокЧисло) + ШиринаКартинокЕдиница;
	МаксимальнаяШиринаПикселей = ГКСИ_ШиринаКартинокВПикселях(
		ШиринаКартинокЧисло, ШиринаКартинокЕдиница);

	// Приоритет источников данных:
	//   1. Поддерево альбома (новый контракт) - форма списка передаёт уже собранное
	//      поддерево выделенных групп через ПараметрыФормы.Сохраняем в ВХ
	//      с УИДом текущей формы, чтобы пережить серверные вызовы внутри альбома.
	//   2. Массив групп (старый контракт) - совместимость с прежними вызовами.
	//   3. Весь каталог - по умолчанию.
	Если НЕ ПустаяСтрока(ПоддеревоАльбомаАдрес) Тогда
		Поддерево = ПолучитьИзВременногоХранилища(ПоддеревоАльбомаАдрес);
		Если Поддерево <> Неопределено Тогда
			Возврат ГКСИ_АльбомПроцессов.СобратьДокументАльбомаПоПоддереву(
				Поддерево, ШиринаКартинок, МаксимальнаяШиринаПикселей);
		КонецЕсли;
	КонецЕсли;

	ГруппыДляАльбома = Неопределено;
	Если НЕ ПустаяСтрока(ГруппыДляАльбомаАдрес) Тогда
		МассивГрупп = ПолучитьИзВременногоХранилища(ГруппыДляАльбомаАдрес);
		Если МассивГрупп <> Неопределено Тогда
			ГруппыДляАльбома = МассивГрупп;
		КонецЕсли;
	КонецЕсли;

	Если ГруппыДляАльбома <> Неопределено Тогда
		Возврат ГКСИ_АльбомПроцессов.СобратьДокументАльбомаПоГруппам(
			ГруппыДляАльбома, ШиринаКартинок, МаксимальнаяШиринаПикселей);
	Иначе
		Возврат ГКСИ_АльбомПроцессов.СобратьДокументАльбома(
			ШиринаКартинок, МаксимальнаяШиринаПикселей);
	КонецЕсли;

КонецФункции

// Целевая ширина для сжатия картинок в кеше сеанса.
//
//   - "px" — берём как есть.
//   - "%"  или пусто — используем 1280 px (A4 @ 96dpi × 1.5 retina).
//
// Возвращаемое значение:
//   Число - целевая ширина в пикселях. 0 — не сжимать.
&НаСервере
Функция ГКСИ_ШиринаКартинокВПикселях(Число, Единица)

	Если НЕ ЗначениеЗаполнено(Число) Тогда
		Возврат 1280;
	КонецЕсли;

	Если НРег(СокрЛП(Единица)) = "px" Тогда
		Возврат Число;
	КонецЕсли;

	Возврат 1280;

КонецФункции

// Добавляет в командную панель формы команды массового разворачивания
// и сворачивания групп альбома. Кнопки управляют состоянием уже
// сформированного HTML-документа на клиенте (см. ГКСИ_УстановитьОткрытиеВсехГрупп),
// без обращения к серверу и без перестроения альбома.
//
// @skip-warning SU93 - серверный хелпер, вызывается из ГКСИ_ПриСозданииНаСервере.
&НаСервере
Процедура ГКСИ_ДобавитьКомандыСворачивания()

	ГКСИ_ДобавитьКомандуИКнопку(
		"ГКСИ_РазвернутьВсеГруппы",
		НСтр("ru = 'Развернуть всё'"),
		НСтр("ru = 'Развернуть все группы альбома'"),
		"ГКСИ_РазвернутьВсеГруппы");

	ГКСИ_ДобавитьКомандуИКнопку(
		"ГКСИ_СвернутьВсеГруппы",
		НСтр("ru = 'Свернуть всё'"),
		НСтр("ru = 'Свернуть все группы альбома'"),
		"ГКСИ_СвернутьВсеГруппы");

КонецПроцедуры

// Создаёт команду формы и кнопку для неё в командной панели формы.
//
// Параметры:
//  ИмяКоманды  - Строка - имя команды формы.
//  Заголовок   - Строка - заголовок команды и кнопки.
//  Подсказка   - Строка - всплывающая подсказка.
//  ИмяДействия - Строка - имя клиентского обработчика команды.
//
// @skip-warning SU93 - серверный хелпер, вызывается из ГКСИ_ДобавитьКомандыСворачивания.
&НаСервере
Процедура ГКСИ_ДобавитьКомандуИКнопку(ИмяКоманды, Заголовок, Подсказка, ИмяДействия)

	Если Команды.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Заголовок = Заголовок;
	Команда.Подсказка = Подсказка;
	Команда.Действие = ИмяДействия;

	Кнопка = Элементы.Добавить(ИмяКоманды + "Кнопка", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	Кнопка.ИмяКоманды = Команда.Имя;
	Кнопка.Отображение = ОтображениеКнопки.Текст;

КонецПроцедуры

// Разворачивает все группы альбома.
//
// Параметры:
//  Команда - КомандаФормы - команда формы, инициировавшая вызов.
//
&НаКлиенте
Процедура ГКСИ_РазвернутьВсеГруппы(Команда)

	ГКСИ_УстановитьОткрытиеВсехГрупп(Истина);

КонецПроцедуры

// Сворачивает все группы альбома.
//
// Параметры:
//  Команда - КомандаФормы - команда формы, инициировавшая вызов.
//
&НаКлиенте
Процедура ГКСИ_СвернутьВсеГруппы(Команда)

	ГКСИ_УстановитьОткрытиеВсехГрупп(Ложь);

КонецПроцедуры

// Переключает состояние всех сворачиваемых блоков <details> в документе
// HTML-поля. Работает с уже сформированным DOM, без обращения к серверу.
//
// Параметры:
//  Открыть - Булево - Истина: раскрыть все группы; Ложь: свернуть все группы.
//
&НаКлиенте
Процедура ГКСИ_УстановитьОткрытиеВсехГрупп(Открыть)

	Попытка
		HTMLПоле = Элементы.ТекстHTML;
		Документ = HTMLПоле.Документ;
		Если Документ = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ИмяАтрибутаОткрытия = "open";
		Узлы = Документ.getElementsByTagName("details");
		Для Индекс = 0 По Узлы.length - 1 Цикл
			Если Открыть Тогда
				Узлы[Индекс].setAttribute(ИмяАтрибутаОткрытия, ИмяАтрибутаОткрытия);
			Иначе
				Узлы[Индекс].removeAttribute(ИмяАтрибутаОткрытия);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Документ ещё не сформирован или поле недоступно - операция не критична.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
