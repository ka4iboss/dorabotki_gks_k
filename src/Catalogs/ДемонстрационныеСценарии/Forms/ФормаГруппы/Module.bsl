// Модуль формы группы справочника ДемонстрационныеСценарии.
// Расширение: добавляет в форму группы программную панель «Входит в группы»
// с возможностью указать, в какие родительские группы входит текущая группа.
// Логика работы с регистром РМ_ГруппыСценариев вынесена в общий модуль
// РМ_ГруппыСценариевСервер (используется той же формой элемента).

#Область ОбработчикиСобытийФормы

// Перехват типового ПриСозданииНаСервере: добавляет панель групп,
// заполняет её, регистрирует клиентский ПередЗаписью, добавляет панель
// Markdown-редактора, заполняет ФайлыBase64, извлекает сегмент markdown
// текущего языка.
//@skip-warning
&Перед("ПриСозданииНаСервере")
&НаСервере
Процедура РМ_ПередПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	РМ_УстановитьДействиеКлиентскогоПередЗаписью();
	РМ_ДобавитьПанельРедактора();
	ГКСИ_ГруппыСценариевСервер.ДобавитьПанельГруппСценария(ЭтотОбъект);
	РМ_ЗаполнитьФайлыBase64();
	ГКСИ_ГруппыСценариевСервер.ЗаполнитьГруппыСценария(ЭтотОбъект);
	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);

КонецПроцедуры

// Скрывает типовые кнопки редактирования HTML-файла и типовое HTML-поле
// в режимах редактирования/перевода (управляется через ВариантОтображенияФормы).
//@skip-warning
&После("ПриСозданииНаСервере")
&НаСервере
Процедура РМ_ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РМ_УправлениеВидимостьюMarkdown(ЭтотОбъект);
	РМ_ДобавитьКнопкуТумблера(ЭтотОбъект);
	РМ_ОбновитьЗаголовокТумблера(ЭтотОбъект);

КонецПроцедуры

// Добавляет кнопку тумблера режима в командную панель формы.
//
// В ФормаГруппы обе кандидатуры (ГруппаКомандыСЯзыком, ГруппаКомментарийРодитель)
// лежат внутри ГруппаРедактирование, которую типовой УправлениеВидимостью
// прячет в режиме Просмотр вместе со всеми дочерними элементами. Поэтому
// кладём кнопку прямо в корень формы — он видим в любом режиме.
//@skip-warning
&НаСервере
Процедура РМ_ДобавитьКнопкуТумблера(Форма)

	ИмяКнопки = "ГКСИ_ПереключитьРежим";

	Если Форма.Элементы.Найти(ИмяКнопки) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоваяКнопка = Форма.Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Форма);
	НоваяКнопка.ИмяКоманды = ИмяКнопки;
	НоваяКнопка.Видимость = Истина;

КонецПроцедуры

// Заполняет таблицу ГКСИ_ГруппыСценария при чтении объекта из БД,
// чтобы пользователь видел актуальный список групп, и обновляет
// сегмент Markdown текущего языка в форме.
//@skip-warning
&После("ПриЧтенииНаСервере")
&НаСервере
Процедура РМ_ПослеПриЧтенииНаСервере(ТекущийОбъект)

	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	ГКСИ_ГруппыСценариевСервер.ЗаполнитьГруппыСценария(ЭтотОбъект);

КонецПроцедуры

// Серверный ПередЗаписьюНаСервере: срабатывает ДО типового.
// Синхронизирует регистр РМ_ГруппыСценариев с содержимым таблицы формы,
// собирает текст Markdown и создаёт/обновляет присоединённые HTML-файлы
// по каждому языку из РМ_АдресHTMLПоЯзыкам (полученному на клиенте).
// Для каждого языка, для которого клиент положил HTML в ДополнительныеСвойства,
// создаёт присоединённый HTML-файл (если его ещё нет) или обновляет
// содержимое существующего, и приводит строку ТЧ ОписанияСценария в
// состояние, при котором типовая ЗаписатьНовыеОписанияСценариевИзФормыОбъекта
// её не трогает (ДатаМодификации заполнена, ЕстьИзмененияРедактирования = Ложь).
//@skip-warning
&Перед("ПередЗаписьюНаСервере")
&НаСервере
Процедура РМ_ПередПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ГКСИ_ГруппыСценариевСервер.СинхронизироватьГруппыСценария(ЭтотОбъект, ТекущийОбъект, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	РМ_СобратьТекстMarkdown(ТекущийОбъект);
	РМ_СоздатьПрисоединенныеФайлыИзДопСвойств(
		ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);

КонецПроцедуры

// Перехват типового ПослеЗаписиНаСервере: обновление ФайлыBase64 после записи,
// чтобы внесённые изменения файлов инструкций отразились в редакторе.
// Платформа после ПослеЗаписиНаСервере НЕ вызывает ПриЧтенииНаСервере,
// поэтому реквизит формы ТекстСценарияЧтение остаётся со старым значением —
// перечитываем его явно и заново формируем список шагов группы, чтобы
// пользователь сразу видел изменения без переоткрытия формы.
//@skip-warning
&После("ПослеЗаписиНаСервере")
&НаСервере
Процедура РМ_ПослеПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	РМ_ЗаполнитьФайлыBase64();
	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	РМ_ОбновитьОписанияПослеЗаписиНаСервере();
	ДемонстрационныеСценарииКлиентСервер.ОтразитьТекущиеЯзыкиНаФорме(
		ЭтотОбъект, "ЯзыкСценарияЧтение", "ЯзыкСценария");

КонецПроцедуры

// Клиентский ПередЗаписью привязан программно через УстановитьДействие
// в РМ_ПередПриСозданииНаСервере: аннотация &Перед("ПередЗаписью")
// не работает, так как в типовой форме нет клиентского обработчика ПередЗаписью.
// Сигнатура клиентского ПередЗаписью управляемой формы: (Отказ, ПараметрыЗаписи).
//@skip-warning
&НаКлиенте
Процедура РМ_КлиентскийПередЗаписью(Отказ, ПараметрыЗаписи)

	РМ_ЗаписатьHTMLИзMarkdown(Отказ, ПараметрыЗаписи);

КонецПроцедуры

// Перехват типового ОбработкаОповещения: типовая логика поиска-замены остаётся
// (выполняется до нашего перехватчика через &Перед), здесь — Markdown-реакция.
//@skip-warning
&После("ОбработкаОповещения")
&НаКлиенте
Процедура РМ_ПослеОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "РМ_ОбновитьФайлыBase64" Тогда
		РМ_ЗаполнитьФайлыBase64();
		РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Перехват типового ТекстСценарияДокументСформирован: миграция HTML->Markdown.
//@skip-warning
&Перед("ТекстСценарияДокументСформирован")
&НаКлиенте
Процедура РМ_ПередТекстСценарияДокументСформирован(Элемент)

	РМ_ВыполнитьМиграциюHTMLВMarkdown();

КонецПроцедуры

// Перехват типового ТекстСценарияПриНажатии: типовая логика нажатия в HTML-поле
// остаётся, дополнительно выполняется сохранение сегмента Markdown текущего языка.
//@skip-warning
&Перед("ТекстСценарияПриНажатии")
&НаКлиенте
Процедура РМ_ПередТекстСценарияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если РМ_ОткрытьВидеоВнешнимПлеером(ДанныеСобытия) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

// Перехват типового ТекстСценарияЧтениеПриНажатии: то же, что и для редактируемого
// поля — фиксируем текущий сегмент Markdown перед обработкой клика.
//@skip-warning
&Перед("ТекстСценарияЧтениеПриНажатии")
&НаКлиенте
Процедура РМ_ПередТекстСценарияЧтениеПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Если РМ_ОткрытьВидеоВнешнимПлеером(ДанныеСобытия) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

// Перехват типового Подключаемый_Открытие: вызывается подсистемой Мультиязычность
// при открытии мультиязычных полей. Дополнительно инициализируем новое поле
// ТекстMarkdownСтрока, если оно пустое.
//@skip-warning
&Перед("Подключаемый_Открытие")
&НаКлиенте
Процедура РМ_ПередПодключаемыйОткрытие(Элемент, СтандартнаяОбработка)

	Если Элемент.Имя = "ТекстMarkdownСтрока"
		И НЕ ЗначениеЗаполнено(ТекстMarkdownСтрока) Тогда
		РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Отправляет текущую инструкцию (группу) на согласование.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//
&НаКлиенте
Процедура ГКСИ_ОтправитьНаСогласование(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите инструкцию'"));
		Возврат;
	КонецЕсли;
	
	ГКСИ_ЗапуститьСогласованиеНаСервере(Истина);
	
КонецПроцедуры

// Перекрытие типового обработчика Редактировать. Типовое поведение открывает
// присоединённый HTML-файл сценария во внешнем редакторе через
// РаботаСФайламиСлужебныйКлиент.РедактироватьСОповещением. В нашем решении
// сценарий редактируется прямо в форме через Markdown-редактор подсистемы
// РМ_РедакторMarkdown, поэтому открытие внешнего файла не требуется.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&Вместо("Редактировать")
&НаКлиенте
Процедура РМ_РедактироватьВместо(Команда)

КонецПроцедуры

// Перекрытие типового обработчика ЗакончитьРедактирование. Типовое поведение
// закрывает редактирование внешнего HTML-файла через
// РаботаСФайламиСлужебныйКлиент.ЗакончитьРедактированиеСОповещением. Так как
// внешний файл не открывается, обработчик не нужен.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&Вместо("ЗакончитьРедактирование")
&НаКлиенте
Процедура РМ_ЗакончитьРедактированиеВместо(Команда)

КонецПроцедуры

// Перекрытие типового обработчика ОтменитьРедактирование. Типовое поведение
// освобождает внешний HTML-файл через
// РаботаСФайламиСлужебныйВызовСервера.ОсвободитьФайлы. Так как внешний файл
// не открывается, обработчик не нужен.
//
// Параметры:
//	Команда - КомандаФормы - команда формы, инициировавшая обработку.
//@skip-warning
&Вместо("ОтменитьРедактирование")
&НаКлиенте
Процедура РМ_ОтменитьРедактированиеВместо(Команда)

КонецПроцедуры

// Перекрытие типового ДобавитьКТекстуСписокШаговГруппы: исправляет давний баг
// типовой, при котором HTML со списком шагов формировался в локальной переменной
// ТекстШаги, но не записывался обратно в реквизит формы ТекстСценарияЧтение —
// пользователь видел старое описание без списка шагов. Также источник шагов
// переключён с типового поля Родитель на РС РМ_ГруппыСценариев (наша модель
// иерархии сценариев — многие-ко-многим через регистр).
//@skip-warning
&Вместо("ДобавитьКТекстуСписокШаговГруппы")
&НаСервере
Процедура РМ_ДобавитьКТекстуСписокШаговГруппыВместо()

	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	// Получаем членов группы из РС РМ_ГруппыСценариев
	// (типовое поле Родитель не используется, т.к. иерархия хранится
	// в регистре сведений).
	ЧленыГруппы = ГКСИ_ГруппыСценариевСервер.ПолучитьЧленовГруппы(Объект.Ссылка);
	Если ЧленыГруппы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТекСценарияЧтениеДляСписка = ПолучитьОписаниеНаЯзыке(ЭтотОбъект, ЯзыкСценарияЧтение);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДемонстрационныеСценарии.ПолныйКод     КАК ПолныйКод,
	|	ДемонстрационныеСценарии.Ссылка        КАК Ссылка,
	|	ДемонстрационныеСценарии.ЭтоГруппа     КАК ЭтоГруппа
	|ИЗ
	|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
	|ГДЕ
	|	ДемонстрационныеСценарии.Ссылка В (&ЧленыГруппы)
	|	И НЕ ДемонстрационныеСценарии.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПолныйКод ИЕРАРХИЯ
	|	";

	Запрос.УстановитьПараметр("ЧленыГруппы", ЧленыГруппы);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	ШрифтГруппы              = ШрифтыСтиля.ШрифтГруппаШагиГруппы;
	ШрифтЗаголовок           = ШрифтыСтиля.ШрифтЗаголовокШагиГруппы;

	ТекстСписокШаговГруппы = Новый ФорматированныйДокумент;
	ТекстСписокШаговГруппы.УстановитьHTML(ТекСценарияЧтениеДляСписка, Новый Структура);

	ТекстСписокШаговГруппы.Добавить(Символы.ПС);
	ТекстСписокШаговГруппы.Добавить(Символы.ПС);

	ТекстШагиВГруппе = СтрШаблон(НСтр("ru = 'Шаги в группе: %1';
										|en = 'Steps in the group: %1'"), Выборка.Количество());

	Элемент = ТекстСписокШаговГруппы.Добавить(ТекстШагиВГруппе);
	Элемент.Шрифт = ШрифтЗаголовок;

	ТекстСписокШаговГруппы.Добавить(Символы.ПС);
	ТекстСписокШаговГруппы.Добавить(Символы.ПС);

	Пока Выборка.Следующий() Цикл

		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
		ПолныйКодКонтекстный = ГКСИ_ГруппыСценариевСервер.ПолныйПолныйКодКонтекстный(
			Выборка.Ссылка, Объект.Ссылка);
		ПредставлениеШага = СтрШаблон("%1 %2", ПолныйКодКонтекстный, Символы.ПС);

		Элемент = ТекстСписокШаговГруппы.Добавить(ПредставлениеШага);
		Элемент.НавигационнаяСсылка = НавигационнаяСсылка;

		Если Выборка.ЭтоГруппа Тогда
			Элемент.Шрифт = ШрифтГруппы;
		Иначе
			Элемент.Шрифт = ШрифтыСтиля.ОбычныйШрифтТекста;
		КонецЕсли;

	КонецЦикла;

	ТекстШаги = "";
	Вложения = Новый Структура;
	ТекстСписокШаговГруппы.ПолучитьHTML(ТекстШаги, Вложения);

	// Исправление давнего бага типовой: HTML со списком шагов сохраняется
	// в реквизите формы ТекстСценарияЧтение.
	ТекстСценарияЧтение = ТекстШаги;

КонецПроцедуры

// Перехват типового Подключаемый_ИзменитьЯзыкРедактирования: сохраняем сегмент
// текущего языка до переключения.
//@skip-warning
&Перед("Подключаемый_ИзменитьЯзыкРедактирования")
&НаКлиенте
Процедура РМ_ПередИзменитьЯзыкРедактирования(Команда)

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

//@skip-warning
&После("Подключаемый_ИзменитьЯзыкРедактирования")
&НаКлиенте
Процедура РМ_ПослеИзменитьЯзыкРедактирования(Команда)

	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	РМ_УправлениеВидимостьюMarkdown(ЭтотОбъект);

КонецПроцедуры

// Перехват типового Подключаемый_ИзменитьЯзыкПросмотра.
//@skip-warning
&Перед("Подключаемый_ИзменитьЯзыкПросмотра")
&НаКлиенте
Процедура РМ_ПередИзменитьЯзыкПросмотра(Команда)

	РМ_СохранитьСегментMarkdownТекущегоЯзыка(ЭтотОбъект);

КонецПроцедуры

//@skip-warning
&После("Подключаемый_ИзменитьЯзыкПросмотра")
&НаКлиенте
Процедура РМ_ПослеИзменитьЯзыкПросмотра(Команда)

	РМ_УстановитьСегментMarkdownВФорму(ЭтотОбъект, ЯзыкСценария);
	РМ_УправлениеВидимостьюMarkdown(ЭтотОбъект);

КонецПроцедуры

// Открывает форму выбора родительской группы для текущей группы.
//
// Форма выбора не принимает параметров открытия: список всегда содержит все узлы
// справочника, а допустимость выбранной группы проверяет обработчик завершения
// (см. РМ_ЗавершениеВыбораГруппы): сама группа, её потомки по регистру
// ГКСИ_ГруппыСценариев и уже добавленные группы не принимаются.
//@skip-warning
&НаКлиенте
Процедура РМ_ДобавитьГруппу(Команда)

	ИмяФормыВыбораГруппы = "Catalog.ДемонстрационныеСценарии.Form.ГКСИ_ФормаВыбораГруппы";
	ОткрытьФорму(ИмяФормыВыбораГруппы,
		,
		ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("РМ_ЗавершениеВыбораГруппы", ЭтотОбъект));

КонецПроцедуры

// Обработчик завершения выбора родительской группы из формы ГКСИ_ФормаВыбораГруппы.
// Добавляет выбранную группу в таблицу ГКСИ_ГруппыСценария.
//
// Параметры:
//  РезультатВыбора        - Структура, Неопределено - результат формы выбора
//                            (Ссылка, ЭтоГруппа, Фрагмент) или Неопределено при отказе.
//  ДополнительныеПараметры - Произвольный - параметры оповещения.
//@skip-warning
&НаКлиенте
Процедура РМ_ЗавершениеВыбораГруппы(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ВыбраннаяГруппа = РезультатВыбора.Ссылка;
	Если НЕ ЗначениеЗаполнено(ВыбраннаяГруппа) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ РезультатВыбора.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В качестве родительской группы можно выбрать только группу.'"));
		Возврат;
	КонецЕсли;

	УжеДобавленныеГруппы = Новый Массив;
	//@skip-warning undefined-variable
	Для Каждого Строка Из ГКСИ_ГруппыСценария Цикл
		УжеДобавленныеГруппы.Добавить(Строка.Группа);
	КонецЦикла;

	// Исключаем саму группу и её потомков (иначе получится цикл в иерархии),
	// а также уже добавленные группы.
	ИсключаемыеГруппы = РМ_ПолучитьИсключаемыеГруппыНаСервере(Объект.Ссылка, УжеДобавленныеГруппы);
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ИсключаемыеГруппы.Добавить(Объект.Ссылка);
	КонецЕсли;
	Если ИсключаемыеГруппы.Найти(ВыбраннаяГруппа) <> Неопределено Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Эту группу выбрать нельзя: она уже добавлена, совпадает с текущей или вложена в неё.'"));
		Возврат;
	КонецЕсли;

	//@skip-warning undefined-variable
	НоваяСтрока = ГКСИ_ГруппыСценария.Добавить();
	НоваяСтрока.Группа               = ВыбраннаяГруппа;
	// Полный код будет рассчитан автоматически в обработчике ПриЗаписи объекта
	// (см. РМ_ПриЗаписи в ObjectModule справочника).
	НоваяСтрока.ПолныйКодКонтекстный = "";

КонецПроцедуры

// Удаляет текущую строку из таблицы ГКСИ_ГруппыСценария.
// Связь с регистром удалится синхронизацией в ПередЗаписьюНаСервере.
//@skip-warning
&НаКлиенте
Процедура РМ_УдалитьГруппу(Команда)

	ТекущаяСтрока = Элементы.ГКСИ_ГруппыСценария.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	//@skip-warning undefined-variable
	ГКСИ_ГруппыСценария.Удалить(ТекущаяСтрока);

КонецПроцедуры

// Привязывает клиентский обработчик ПередЗаписью формы к нашей процедуре
// РМ_КлиентскийПередЗаписью. Аннотация &Перед("ПередЗаписью") не сработала,
// потому что в типовой форме нет клиентского обработчика ПередЗаписью.
// Вызывается из &Перед("ПриСозданииНаСервере"), потому что УстановитьДействие
// на клиенте заимствованной формы расширения недоступен (Метод недоступен на клиенте).
//@skip-warning
&НаСервере
Процедура РМ_УстановитьДействиеКлиентскогоПередЗаписью()

	//@skip-warning
	ЭтотОбъект.УстановитьДействие("ПередЗаписью", "РМ_КлиентскийПередЗаписью");

КонецПроцедуры

