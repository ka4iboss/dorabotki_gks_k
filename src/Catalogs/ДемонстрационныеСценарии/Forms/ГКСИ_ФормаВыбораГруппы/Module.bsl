// Форма выбора родительских групп для сценария/группы.
// Источник данных: ValueTable (заполняется запросом в ПриСозданииНаСервере).
// Параметр открытия формы:
//   ИсключаемыеГруппы — массив ссылок на уже выбранные группы (чтобы не было
//   дубликатов) и на всех потомков редактируемой группы (чтобы исключить цикл).
#Область ОбработчикиСобытийФормы

//@skip-warning
&НаСервере
Процедура ГКСИ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	//@skip-warning
	Если Параметры.Свойство("ИсключаемыеГруппы")
		//@skip-warning
			И ТипЗнч(Параметры.ИсключаемыеГруппы) = Тип("Массив") Тогда
		//@skip-warning
		ИсключаемыеСсылки = Новый Соответствие;
		Для Каждого ЭлементМассива Из Параметры.ИсключаемыеГруппы Цикл
			Если ЗначениеЗаполнено(ЭлементМассива) Тогда
				ИсключаемыеСсылки.Вставить(ЭлементМассива, Истина);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ИсключаемыеСсылки = Новый Соответствие;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДемонстрационныеСценарии.Ссылка КАК Группа,
		|	ДемонстрационныеСценарии.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
		|ГДЕ
		|	ДемонстрационныеСценарии.ЭтоГруппа = ИСТИНА
		|УПОРЯДОЧИТЬ ПО
		|	ДемонстрационныеСценарии.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	СписокГрупп.Очистить();
	Пока Выборка.Следующий() Цикл
		Если ИсключаемыеСсылки.Получить(Выборка.Группа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = СписокГрупп.Добавить();
		НоваяСтрока.Группа = Выборка.Группа;
		НоваяСтрока.Наименование = Выборка.Наименование;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокГрупп

&НаКлиенте
Процедура СписокГруппВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбраннаяСтрока) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = СписокГрупп.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекущиеДанные <> Неопределено Тогда
		ОповеститьОВыборе(ТекущиеДанные.Группа);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГКСИ_Выбрать(Команда)

	Если Элементы.СписокГрупп.ТекущаяСтрока = Неопределено Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Выберите группу из списка.";
		СообщениеПользователю.Поле = "СписокГрупп";
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.СписокГрупп.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОповеститьОВыборе(ТекущиеДанные.Группа);

КонецПроцедуры

#КонецОбласти

