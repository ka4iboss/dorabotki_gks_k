// Форма выбора узла демонстрационного сценария: группы или шага.
//
// Форма не принимает параметров открытия: параметры формы объявляются в редакторе
// формы, а инструментарий их объявить не может — без объявления платформа не
// передаёт значения в структуру Параметры, и параметр открытия молча теряется.
// Поэтому список строится всегда одинаково: все узлы всех инструкций, по строке
// на каждую пару «узел — инструкция», отсортированные по инструкции и коду
// (см. ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора). Однозначность вики-ссылки
// обеспечивает код узла в контексте инструкции, а не отбор списка.
//
// Результат выбора форма передаёт в метод Закрыть структурой:
//  * Ссылка    - CatalogRef.ДемонстрационныеСценарии - выбранный узел;
//  * ЭтоГруппа - Булево - Истина, если выбранный узел является группой;
//  * Фрагмент  - Строка - готовый к вставке фрагмент вики-ссылки
//                "[[Код|Наименование]]" (или "[[Наименование]]", если кода нет).
//
// Вызывающая сторона использует нужное ей поле результата:
//  * выбор родительской группы (ФормаЭлемента, ФормаГруппы) — Ссылка, нужна группа;
//  * выбор инструкции-источника (обработки выгрузки и загрузки) — Ссылка, нужна группа;
//  * вставка вики-ссылки из редактора Markdown (ГКСИ_MarkdownКлиент) — Фрагмент.
//
// Значение получает обработчик, переданный в ОткрытьФорму (ОписаниеОповещения).
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ГКСИ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьСписокУзлов();

	Заголовок = НСтр("ru = 'Выбор группы или шага сценария'");

	// Ссылка на узел в таблице не выводится: наименование, код и инструкция
	// показаны отдельными колонками, а переход по ссылке из формы выбора не нужен.
	Элементы.СписокГруппСписокГрупп.Видимость = Ложь;
	Элементы.СписокГруппСписокГрупп1.Заголовок = НСтр("ru = 'Группа / шаг'");
	Элементы.СписокГруппЭтоГруппа.Заголовок = НСтр("ru = 'Группа'");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокГрупп

&НаКлиенте
Процедура СписокГруппВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	// Стандартная обработка выключена всегда: значение, которое платформа
	// передала бы владельцу формы по строке таблицы значений, не несёт ни
	// признака группы, ни фрагмента ссылки.
	СтандартнаяОбработка = Ложь;

	СтрокаТаблицы = СтрокаТаблицыПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Закрыть(РезультатВыбора(СтрокаТаблицы));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГКСИ_Выбрать(Команда)

	СтрокаТаблицы = Элементы.СписокГрупп.ТекущиеДанные;
	Если СтрокаТаблицы = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите группу или шаг сценария.'"));
		Возврат;
	КонецЕсли;

	Закрыть(РезультатВыбора(СтрокаТаблицы));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список узлов демонстрационных сценариев для выбора.
//
// Отбор по инструкции не выполняется: форма не принимает параметров открытия.
// Наименование инструкции выводится отдельной колонкой, чтобы узлы разных
// инструкций различались при просмотре списка.
//
&НаСервере
Процедура ЗаполнитьСписокУзлов()

	СписокГрупп.Очистить();

	УзлыИнструкций = ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора(Неопределено);

	Для Каждого УзелИнструкции Из УзлыИнструкций Цикл

		НоваяСтрока = СписокГрупп.Добавить();
		НоваяСтрока.Группа       = УзелИнструкции.Ссылка;
		НоваяСтрока.Наименование = УзелИнструкции.Наименование;
		НоваяСтрока.Код          = УзелИнструкции.Код;
		НоваяСтрока.ЭтоГруппа    = УзелИнструкции.ЭтоГруппа;
		НоваяСтрока.Инструкция   = УзелИнструкции.Инструкция;
		// Фрагмент считается по коду узла в контексте его инструкции: у одного
		// и того же узла в разных инструкциях коды разные.
		НоваяСтрока.Фрагмент     = ГКСИ_СсылкиСценариев.ФрагментСсылкиПоКодуИНаименованию(
			УзелИнструкции.Код, УзелИнструкции.Наименование);

	КонецЦикла;

КонецПроцедуры

// Возвращает строку таблицы узлов по идентификатору из события Выбор.
//
// Параметры:
//  ВыбраннаяСтрока - Число, Неопределено - идентификатор строки таблицы формы.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка таблицы узлов.
//
&НаКлиенте
Функция СтрокаТаблицыПоИдентификатору(ВыбраннаяСтрока)

	Если ТипЗнч(ВыбраннаяСтрока) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СписокГрупп.НайтиПоИдентификатору(ВыбраннаяСтрока);

КонецФункции

// Возвращает значение, которое форма передаёт в метод Закрыть.
//
// Параметры:
//  СтрокаТаблицы - СтрокаТаблицыЗначений - выбранная строка таблицы узлов.
//
// Возвращаемое значение:
//  Структура - Ссылка, ЭтоГруппа, Фрагмент (см. описание модуля формы).
//
&НаКлиенте
Функция РезультатВыбора(СтрокаТаблицы)

	Возврат Новый Структура("Ссылка, ЭтоГруппа, Фрагмент",
		СтрокаТаблицы.Группа, СтрокаТаблицы.ЭтоГруппа, СтрокаТаблицы.Фрагмент);

КонецФункции

#КонецОбласти
