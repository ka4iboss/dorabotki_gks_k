// Форма выбора группы или шага демонстрационного сценария.
//
// Режимы работы задаются параметром открытия РежимВыбора:
//  "Группы" (по умолчанию) - выбор родительской группы сценария или группы: в списке
//      все группы каталога, кроме перечисленных в параметре ИсключаемыеГруппы.
//  "УзлыСсылки" - выбор узла для вставки вики-ссылки [[...]] из редактора Markdown:
//      в списке группы и шаги инструкции, которой принадлежит узел из параметра
//      СсылкаУзла (если узел не указан или ещё не связан с инструкцией - узлы всех
//      инструкций), с кодом в контексте и признаком группы.
//
// Параметры открытия формы:
//  РежимВыбора       - Строка - "Группы" или "УзлыСсылки".
//  ИсключаемыеГруппы - Массив - уже выбранные группы и потомки редактируемой группы
//                      (режим "Группы").
//  СсылкаУзла        - CatalogRef.ДемонстрационныеСценарии, Неопределено - узел, из
//                      описания которого открыт выбор (режим "УзлыСсылки").
//
// Результат выбора передаётся в метод Закрыть и зависит от режима:
//  "Группы"     - ссылка на выбранный элемент справочника ДемонстрационныеСценарии;
//  "УзлыСсылки" - готовая к вставке вики-ссылка вида "[[Код|Наименование]]".
// Значение получает обработчик, переданный в ОткрытьФорму (ОписаниеОповещения).
#Область ОбработчикиСобытийФормы

//@skip-warning
&НаСервере
Процедура ГКСИ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтоВыборУзловСсылки = ЭтоРежимВыбораУзловСсылки();

	СписокГрупп.Очистить();

	Если ЭтоВыборУзловСсылки Тогда
		ЗаполнитьУзлыИнструкции();
		Заголовок = НСтр("ru = 'Выбор группы или шага для ссылки'");
	Иначе
		ЗаполнитьГруппы();
	КонецЕсли;

	// Код в контексте и признак группы нужны только при выборе узла ссылки.
	Элементы.СписокГруппКод.Видимость = ЭтоВыборУзловСсылки;
	Элементы.СписокГруппЭтоГруппа.Видимость = ЭтоВыборУзловСсылки;
	Элементы.СписокГруппСписокГрупп1.Видимость = НЕ ЭтоВыборУзловСсылки;

	Если ЭтоВыборУзловСсылки Тогда
		Элементы.СписокГруппСписокГрупп.Заголовок = НСтр("ru = 'Группа / шаг'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокГрупп

&НаКлиенте
Процедура СписокГруппВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если ТипЗнч(ВыбраннаяСтрока) <> Тип("Число") Тогда
		Возврат;
	КонецЕсли;

	ВыбраннаяСтрокаТаблицы = СписокГрупп.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ВыбраннаяСтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Закрыть(РезультатВыбораУзла(ВыбраннаяСтрокаТаблицы.Группа));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГКСИ_Выбрать(Команда)

	ТекущиеДанныеСтроки = Элементы.СписокГрупп.ТекущиеДанные;
	Если ТекущиеДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Закрыть(РезультатВыбораУзла(ТекущиеДанныеСтроки.Группа));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет, открыта ли форма для выбора узла ссылки.
//
// Возвращаемое значение:
//  Булево - Истина, если параметр открытия РежимВыбора равен "УзлыСсылки".
//
//@skip-warning
&НаСервере
Функция ЭтоРежимВыбораУзловСсылки()

	//@skip-warning
	Возврат Параметры.Свойство("РежимВыбора")
		//@skip-warning
		И Параметры.РежимВыбора = "УзлыСсылки";

КонецФункции

// Заполняет список группами каталога для выбора родительской группы.
//
&НаСервере
Процедура ЗаполнитьГруппы()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДемонстрационныеСценарии.Ссылка КАК Ссылка,
		|	ДемонстрационныеСценарии.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
		|ГДЕ
		|	ДемонстрационныеСценарии.ЭтоГруппа
		|	И НЕ ДемонстрационныеСценарии.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";

	ИсключаемыеГруппы = ИсключаемыеГруппыИзПараметров();

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ИсключаемыеГруппы.Найти(Выборка.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = СписокГрупп.Добавить();
		НоваяСтрока.Группа = Выборка.Ссылка;
		НоваяСтрока.Наименование = Выборка.Наименование;
	КонецЦикла;

КонецПроцедуры

// Заполняет список группами и шагами инструкции для выбора узла ссылки.
//
&НаСервере
Процедура ЗаполнитьУзлыИнструкции()

	//@skip-warning
	СсылкаУзла = ?(Параметры.Свойство("СсылкаУзла"), Параметры.СсылкаУзла, Неопределено);

	УзлыИнструкции = УзлыИнструкцииУзла(СсылкаУзла);

	Для Каждого УзелИнструкции Из УзлыИнструкции Цикл
		НоваяСтрока = СписокГрупп.Добавить();
		НоваяСтрока.Группа = УзелИнструкции.Ссылка;
		НоваяСтрока.Код = УзелИнструкции.Код;
		НоваяСтрока.ЭтоГруппа = УзелИнструкции.ЭтоГруппа;
	КонецЦикла;

КонецПроцедуры

// Возвращает узлы инструкции, к которой относится узел описания.
//
// Если узел не указан или ещё не связан с инструкцией (не записан), возвращаются
// узлы всех инструкций — иначе выбор ссылки на несохранённом узле был бы пустым.
//
// Параметры:
//  СсылкаУзла - CatalogRef.ДемонстрационныеСценарии, Неопределено - узел описания.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора().
//
&НаСервере
Функция УзлыИнструкцииУзла(СсылкаУзла)

	Если Не ЗначениеЗаполнено(СсылкаУзла) Тогда
		Возврат ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора(Неопределено);
	КонецЕсли;

	КореньИнструкции = ГКСИ_СсылкиСценариев.КореньИнструкцииУзла(СсылкаУзла);
	УзлыИнструкции = ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора(КореньИнструкции);
	Если УзлыИнструкции.Количество() > 0 Тогда
		Возврат УзлыИнструкции;
	КонецЕсли;

	Возврат ГКСИ_СсылкиСценариев.УзлыИнструкцииДляВыбора(Неопределено);

КонецФункции

// Возвращает значение, которое форма передаёт в метод Закрыть.
//
// В режиме выбора узла ссылки возвращается готовый фрагмент вики-ссылки,
// в режиме выбора группы — ссылка на выбранную группу.
//
// Параметры:
//  Ссылка - CatalogRef.ДемонстрационныеСценарии - выбранный узел.
//
// Возвращаемое значение:
//  Строка, CatalogRef.ДемонстрационныеСценарии - результат выбора.
//
&НаКлиенте
Функция РезультатВыбораУзла(Ссылка)

	Возврат ФрагментСсылкиДляОповещенияНаСервере(Ссылка);

КонецФункции

// Возвращает фрагмент вики-ссылки для результата выбора в режиме выбора узла.
//
// Параметры:
//  Ссылка - CatalogRef.ДемонстрационныеСценарии - выбранный узел.
//
// Возвращаемое значение:
//  Строка, CatalogRef.ДемонстрационныеСценарии - фрагмент ссылки или сама ссылка,
//  если форма открыта для выбора группы.
//
&НаСервере
Функция ФрагментСсылкиДляОповещенияНаСервере(Ссылка)

	Если Не ЭтоРежимВыбораУзловСсылки() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат ГКСИ_СсылкиСценариев.ФрагментСсылкиДляУзла(Ссылка);

КонецФункции

// Возвращает массив групп, которые нельзя выбирать в качестве родительской группы.
//
// Возвращаемое значение:
//  Массив - ссылки на исключаемые группы; пустой массив, если параметр не передан.
//
//@skip-warning
&НаСервере
Функция ИсключаемыеГруппыИзПараметров()

	//@skip-warning
	Если Параметры.Свойство("ИсключаемыеГруппы")
		//@skip-warning
		И ТипЗнч(Параметры.ИсключаемыеГруппы) = Тип("Массив") Тогда
		//@skip-warning
		Возврат Параметры.ИсключаемыеГруппы;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

#КонецОбласти
