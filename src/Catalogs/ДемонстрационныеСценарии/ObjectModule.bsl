#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Переопределение типового обработчика ПередЗаписью:
//  - обнуляет стандартный реквизит Родитель (платформенная иерархия больше не используется);
//  - фиксирует в ДополнительныеСвойства прежнюю группу для последующей синхронизации регистра;
//  - сбрасывает статус согласования при изменении текста сценария.
//
// Создание присоединённых HTML-файлов делается НЕ здесь, а в ГКСИ_ПриЗаписи,
// потому что ПолныйКод заполняется только в &После("ПриЗаписи")
// через ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодКонтекстныйДляСценария.
// До этого момента имя файла через ДемонстрационныеСценарииКлиентСервер
// .ИмяФайлаОписанияСценария получается с пустым ПолныйКод.
//
// Параметры:
//  Отказ - Булево - стандартный параметр обработчика записи.
//
//@skip-warning
&Перед("ПередЗаписью")
Процедура ГКСИ_ПередЗаписью(Отказ) Экспорт

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СтарыйРодитель = Родитель;
	ДополнительныеСвойства.Вставить("ГКСИ_ПрежнийРодитель", СтарыйРодитель);

	Если ЗначениеЗаполнено(Родитель) Тогда
		Родитель = Справочники.ДемонстрационныеСценарии.ПустаяСсылка();
	КонецЕсли;

	// Служебная запись (сохранение ссылок на присоединённые файлы из фонового задания):
	// ни версия, ни сброс статуса согласования для неё не нужны.
	Если ДополнительныеСвойства.Свойство("ГКСИ_СлужебнаяЗапись") Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ГКСИ.ЗаписьДиагностика", УровеньЖурналаРегистрации.Информация, , ,
		"5. OBJ_PRE: вход, Новый=" + ?(ЭтоНовый(), "Да", "Нет"));

	ПрежнийТекст        = Неопределено;
	ПрежнееНаименование = Неопределено;
	Если НЕ ЭтоНовый() Тогда
		ПрежнийТекст        = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ГКСИ_ТекстMarkdown");
		ПрежнееНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование");
	КонецЕсли;

	// Сброс статуса согласования при изменении текста сценария: сравнивается исходный
	// Markdown-текст, из которого при записи формируется присоединённый HTML описания.
	Если ПрежнийТекст <> Неопределено И ГКСИ_MarkdownСформирован
		И ПрежнийТекст <> ГКСИ_ТекстMarkdown Тогда
		Статус = Перечисления.СтатусыДемонстрационныхСценариев.НаПроверке;
	КонецЕсли;

	// Версия узла инструкции создаётся только при значимом изменении содержимого
	// (текст или наименование) и при отсутствии версий. Иначе каждая служебная запись
	// (смена статуса согласования) порождала полную сериализацию объекта со сжатием —
	// это и вешало базу при сохранении.
	Если ПрежнийТекст = Неопределено
		Или ПрежнееНаименование <> Наименование
		Или ПрежнийТекст <> ГКСИ_ТекстMarkdown
		Или ГКСИ_СогласованиеИнструкцийСервер.НомерВерсииСогласуемогоУзла(Ссылка) = 0 Тогда
		ЗаписьЖурналаРегистрации("ГКСИ.ЗаписьДиагностика", УровеньЖурналаРегистрации.Информация, , ,
			"6. OBJ_PRE: перед ЗаписатьВерсиюИнструкции, длина текста=" + СтрДлина(ГКСИ_ТекстMarkdown));
		ГКСИ_СогласованиеИнструкцийСервер.ЗаписатьВерсиюИнструкции(ЭтотОбъект);
		ЗаписьЖурналаРегистрации("ГКСИ.ЗаписьДиагностика", УровеньЖурналаРегистрации.Информация, , ,
			"7. OBJ_PRE: после ЗаписатьВерсиюИнструкции");
	КонецЕсли;

КонецПроцедуры

// Переопределение типового обработчика ПриЗаписи:
//  - синхронизирует регистр ГКСИ_ГруппыСценариев по обновлённому ПолныйКод;
//  - после пересчёта ПолныйКод создаёт/обновляет присоединённые HTML-файлы
//    по адресу соответствия HTML-кодов языков из
//    ДополнительныеСвойства["ГКСИ_АдресHTMLПоЯзыкам"] и сохраняет ссылку
//    на файл в ТЧ ОписанияСценария.
//
// Параметры:
//  Отказ - Булево - стандартный параметр обработчика записи.
//
//@skip-warning
&После("ПриЗаписи")
Процедура ГКСИ_ПриЗаписи(Отказ) Экспорт

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Служебная запись из фонового задания: коды уже пересчитаны, файлы создаются там же.
	Если ДополнительныеСвойства.Свойство("ГКСИ_СлужебнаяЗапись") Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ГКСИ.ЗаписьДиагностика", УровеньЖурналаРегистрации.Информация, , ,
		"8. OBJ_POST: вход, ЭтоГруппа=" + ?(ЭтоГруппа, "Да", "Нет"));

	Если ЭтоГруппа Тогда
		ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодДляПоддерева(Ссылка);
	Иначе
		ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодКонтекстныйДляСценария(Ссылка);
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ГКСИ.ЗаписьДиагностика", УровеньЖурналаРегистрации.Информация, , ,
		"9. OBJ_POST: после пересчёта кодов");

	// Создание присоединённых файлов и повторная запись объекта — тяжёлая операция.
	// Внутри ПриЗаписи она держала транзакцию и блокировки, поэтому выполняется в фоне.
	ГКСК_ЗапуститьОбновлениеПрисоединенныхФайлов(Ссылка);

	ЗаписьЖурналаРегистрации("ГКСИ.ЗаписьДиагностика", УровеньЖурналаРегистрации.Информация, , ,
		"10. OBJ_POST: выход");

КонецПроцедуры

// Передаёт HTML-описания сценария в фоновое задание, которое создаст/обновит
// присоединённые файлы и сохранит ссылки на них в ТЧ ОписанияСценария.
//
// Параметры:
//  СсылкаНаСценарий - СправочникСсылка.ДемонстрационныеСценарии - уже записанный узел инструкции.
//
Процедура ГКСК_ЗапуститьОбновлениеПрисоединенныхФайлов(СсылкаНаСценарий)

	Если НЕ ЗначениеЗаполнено(СсылкаНаСценарий) Тогда
		Возврат;
	КонецЕсли;

	// Канал передачи данных: формы кладут в ПараметрыЗаписи, обработка — в
	// ДополнительныеСвойства объекта перед Записать().
	АдресВХ = Неопределено;
	Если ДополнительныеСвойства.Свойство("ГКСИ_АдресHTMLПоЯзыкам")
		И ЗначениеЗаполнено(ДополнительныеСвойства.ГКСИ_АдресHTMLПоЯзыкам) Тогда
		АдресВХ = ДополнительныеСвойства.ГКСИ_АдресHTMLПоЯзыкам;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресВХ) Тогда
		Возврат;
	КонецЕсли;

	HTMLПоЯзыкам = ПолучитьИзВременногоХранилища(АдресВХ);
	Если HTMLПоЯзыкам = Неопределено ИЛИ HTMLПоЯзыкам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ФоновыеЗадания.Выполнить(
		"ГКСИ_ФайлыСценариевСервер.СоздатьПрисоединенныеФайлыПоСсылке",
		Новый Массив(СсылкаНаСценарий, HTMLПоЯзыкам));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
