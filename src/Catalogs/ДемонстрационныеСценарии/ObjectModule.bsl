#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// Переопределение типового обработчика ПередЗаписью:
//  - обнуляет стандартный реквизит Родитель (платформенная иерархия больше не используется);
//  - фиксирует в ДополнительныеСвойства прежнюю группу для последующей синхронизации регистра.
//
// Создание присоединённых HTML-файлов делается НЕ здесь, а в ГКСИ_ПриЗаписи,
// потому что ПолныйКод заполняется только в &После("ПриЗаписи")
// через ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодКонтекстныйДляСценария.
// До этого момента имя файла через ДемонстрационныеСценарииКлиентСервер
// .ИмяФайлаОписанияСценария получается с пустым ПолныйКод.
//
// Параметры:
//  Отказ - Булево - стандартный параметр обработчика записи.
//
//@skip-warning
&Перед("ПередЗаписью")
Процедура ГКСИ_ПередЗаписью(Отказ) Экспорт

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СтарыйРодитель = Родитель;
	ДополнительныеСвойства.Вставить("ГКСИ_ПрежнийРодитель", СтарыйРодитель);

	Если ЗначениеЗаполнено(Родитель) Тогда
		Родитель = Справочники.ДемонстрационныеСценарии.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

// Переопределение типового обработчика ПриЗаписи:
//  - синхронизирует регистр ГКСИ_ГруппыСценариев по обновлённому ПолныйКод;
//  - после пересчёта ПолныйКод создаёт/обновляет присоединённые HTML-файлы
//    по адресу соответствия HTML-кодов языков из
//    ДополнительныеСвойства["ГКСИ_АдресHTMLПоЯзыкам"] и сохраняет ссылку
//    на файл в ТЧ ОписанияСценария.
//
// Параметры:
//  Отказ - Булево - стандартный параметр обработчика записи.
//
//@skip-warning
&После("ПриЗаписи")
Процедура ГКСИ_ПриЗаписи(Отказ) Экспорт

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоГруппа Тогда
		ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодДляПоддерева(Ссылка);
	Иначе
		ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодКонтекстныйДляСценария(Ссылка);
	КонецЕсли;

	// ПолныйКод уже заполнен - создаём присоединённые файлы и сохраняем ТЧ.
	ГКСИ_СоздатьПрисоединенныеФайлыИзДопСвойств(Ссылка);

КонецПроцедуры

// Создаёт/обновляет присоединённые HTML-файлы сценария по адресу соответствия
// HTML в ДополнительныеСвойства записываемого объекта.
//
// Канал данных тот же, что используют формы ФормаЭлемента/ФормаГруппы:
// ПараметрыЗаписи.ГКСИ_АдресHTMLПоЯзыкам (либо ДополнительныеСвойства).
//
// Параметры:
//  СсылкаНаСценарий - СправочникСсылка.ДемонстрационныеСценарии - уже записан.
//
Процедура ГКСИ_СоздатьПрисоединенныеФайлыИзДопСвойств(СсылкаНаСценарий)

	Если НЕ ЗначениеЗаполнено(СсылкаНаСценарий) Тогда
		Возврат;
	КонецЕсли;

	// Канал передачи данных: формы кладут в ПараметрыЗаписи, обработка — в
	// ДополнительныеСвойства объекта перед Записать().
	АдресВХ = Неопределено;
	Если ДополнительныеСвойства.Свойство("ГКСИ_АдресHTMLПоЯзыкам")
		И ЗначениеЗаполнено(ДополнительныеСвойства.ГКСИ_АдресHTMLПоЯзыкам) Тогда
		АдресВХ = ДополнительныеСвойства.ГКСИ_АдресHTMLПоЯзыкам;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресВХ) Тогда
		Возврат;
	КонецЕсли;

	HTMLПоЯзыкам = ПолучитьИзВременногоХранилища(АдресВХ);
	Если HTMLПоЯзыкам = Неопределено ИЛИ HTMLПоЯзыкам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Перечитываем объект, чтобы получить свежий ПолныйКод после
	// ГКСИ_ГруппыСценариевСервер.ПересчитатьПолныйКодКонтекстныйДляСценария.
	ОбъектСценария = СсылкаНаСценарий.ПолучитьОбъект();
	Если ОбъектСценария = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяФайла = ОбъектСценария.ПолныйКод;

	Для Каждого КлючЗначение Из HTMLПоЯзыкам Цикл

		КодЯзыка  = КлючЗначение.Ключ;
		ТекстHTML = КлючЗначение.Значение;

		// GitHub Alerts: [!NOTE]/[!WARNING]/[!TIP]/[!IMPORTANT]/[!CAUTION] ->
		// <div class="markdown-alert markdown-alert-{type}">…</div>.
		// Прогоняем HTML до записи в присоединённый файл, чтобы при открытии
		// элемента/группы в HTMLDocumentField стили алертов применялись сразу,
		// без зависимости от JS-зеркала gksiPostprocessAlerts.
		ТекстHTML = ГКСИ_MarkdownСерверВызовСервера.ОбработатьАлертыВHTML(ТекстHTML);

		Если НЕ ЗначениеЗаполнено(КодЯзыка) ИЛИ НЕ ЗначениеЗаполнено(ТекстHTML) Тогда
			Продолжить;
		КонецЕсли;

		СтруктураПоиска = Новый Структура("КодЯзыка", КодЯзыка);
		НайденныеСтроки = ОбъектСценария.ОписанияСценария.НайтиСтроки(СтруктураПоиска);

		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаОписания = НайденныеСтроки[0];
		Иначе
			СтрокаОписания = ОбъектСценария.ОписанияСценария.Добавить();
			СтрокаОписания.КодЯзыка = КодЯзыка;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаОписания.ПрисоединенныйФайл) Тогда
			ДемонстрационныеСценарии.РезультатОбновленияПрисоединенногоФайла(
				СтрокаОписания.ПрисоединенныйФайл, Неопределено, ТекстHTML);
		Иначе
			СтрокаОписания.ПрисоединенныйФайл = ГКСИ_СоздатьПрисоединенныйФайлСценария(
				СсылкаНаСценарий, ПолноеИмяФайла, КодЯзыка, ТекстHTML);
		КонецЕсли;

	КонецЦикла;

	// Сохраняем изменения ТЧ ОписанияСценария (ссылки на созданные файлы).
	ОбъектСценария.Записать();

КонецПроцедуры

// Создаёт присоединённый HTML-файл сценария через типовое API РаботаСФайлами.
// Сигнатура совпадает с ГКСИ_СоздатьПрисоединенныйФайлСценария из форм
// ФормаЭлемента/ФормаГруппы (за исключением параметра Форма, который здесь
// не нужен — мы вызываем из серверного контекста после записи объекта).
//
// Параметры:
//  ВладелецФайла - СправочникСсылка.ДемонстрационныеСценарии.
//  ПолныйКод     - Строка - полный код сценария.
//  КодЯзыка      - Строка.
//  ТекстHTML     - Строка.
//
// Возвращаемое значение:
//  CatalogRef.ДемонстрационныеСценарииПрисоединенныеФайлы, Undefined - созданный
//  присоединённый файл или Неопределено при ошибке.
//
Функция ГКСИ_СоздатьПрисоединенныйФайлСценария(ВладелецФайла, ПолныйКод, КодЯзыка, ТекстHTML)

	ДвоичныеДанныеФайла       = ПолучитьДвоичныеДанныеИзСтроки(ТекстHTML, КодировкаТекста.UTF8);
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла);

	ПараметрыЗаписиФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыЗаписиФайла.ВладелецФайлов     = ВладелецФайла;
	ПараметрыЗаписиФайла.ИмяБезРасширения   = ДемонстрационныеСценарииКлиентСервер.ИмяФайлаОписанияСценария(
		ПолныйКод, КодЯзыка);
	ПараметрыЗаписиФайла.РасширениеБезТочки = "HTML";

	Возврат РаботаСФайлами.ДобавитьФайл(ПараметрыЗаписиФайла, АдресВоВременномХранилище, "");

КонецФункции

#КонецОбласти

#КонецЕсли
