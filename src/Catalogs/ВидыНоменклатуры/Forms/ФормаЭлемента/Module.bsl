#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПодбораДопРеквизитов

// Обработчик выбора в форме списка дополнительных реквизитов и сведений.
// Сигнатура события таблицы формы - три параметра.
&НаКлиенте
Процедура ГКСК_ТаблицаПодбораДопРеквизитовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	МассивСвойств = ГКСК_МассивСвойствИзВыбора(ВыбранноеЗначение);
	Если МассивСвойств.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Результат = ГКСК_ДобавитьСвойстваВНабор(МассивСвойств);

	Если Результат.Добавлено = 0 Тогда
		ТекстПредупреждения = НСтр("ru = 'Выбранные реквизиты уже есть в наборе вида номенклатуры.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
	ИначеЕсли Результат.Пропущено > 0 Тогда
		ТекстПредупреждения = СтрШаблон(
			НСтр("ru = 'Добавлено реквизитов: %1. Пропущено: %2.'"),
			Результат.Добавлено, Результат.Пропущено);
		ПоказатьПредупреждение(, ТекстПредупреждения);
	Иначе
		// Все выбранные реквизиты добавлены без пропусков - сообщение не требуется.
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Открывает список дополнительных реквизитов для множественного выбора и добавляет
// выбранные реквизиты в основной набор вида номенклатуры.
&НаКлиенте
Процедура ГКСК_ДобавитьДопРеквизитИзСписка(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстПредупреждения = НСтр("ru = 'Сначала запишите вид номенклатуры, затем добавляйте дополнительные реквизиты.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.НаборСвойств) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У вида номенклатуры не заполнен набор свойств.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыФормы.Вставить("Отбор", Новый Структура("ЭтоДополнительноеСведение", Ложь));

	ОткрытьФорму("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.Форма.ФормаСписка",
		ПараметрыФормы, Элементы.ТаблицаПодбораДопРеквизитов);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Приводит результат выбора в форме списка к массиву ссылок на дополнительные реквизиты.
&НаКлиентеНаСервереБезКонтекста
Функция ГКСК_МассивСвойствИзВыбора(ВыбранныеЗначения)

	Результат = Новый Массив;
	ТипСвойства = Тип("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения");

	Если ТипЗнч(ВыбранныеЗначения) = Тип("Массив") Тогда
		МассивЗначений = ВыбранныеЗначения;
	Иначе
		МассивЗначений = Новый Массив;
		Если ВыбранныеЗначения <> Неопределено Тогда
			МассивЗначений.Добавить(ВыбранныеЗначения);
		КонецЕсли;
	КонецЕсли;

	Для Каждого Значение Из МассивЗначений Цикл
		Ссылка = Неопределено;
		Если ТипЗнч(Значение) = ТипСвойства Тогда
			Ссылка = Значение;
		Иначе
			Значение.Свойство("Ссылка", Ссылка);
		КонецЕсли;
		Если ТипЗнч(Ссылка) = ТипСвойства И Результат.Найти(Ссылка) = Неопределено Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Добавляет выбранные реквизиты в таблицу дополнительных реквизитов номенклатуры формы.
// В набор вида номенклатуры строки попадают штатно при записи вида номенклатуры.
&НаСервере
Функция ГКСК_ДобавитьСвойстваВНабор(Знач МассивСвойств)

	Результат = Новый Структура("Добавлено, Пропущено", 0, 0);

	Если Не ЗначениеЗаполнено(Объект.НаборСвойств) Или МассивСвойств.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Свойства.Ссылка КАК Ссылка,
	|	Свойства.Заголовок КАК Заголовок,
	|	Свойства.ПометкаУдаления КАК ПометкаУдаления,
	|	Свойства.ЭтоДополнительноеСведение КАК ЭтоДополнительноеСведение
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
	|ГДЕ
	|	Свойства.Ссылка В (&МассивСвойств)";
	Запрос.УстановитьПараметр("МассивСвойств", МассивСвойств);

	ДанныеСвойств = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСвойства = Новый Структура(
			"Заголовок, ПометкаУдаления, ЭтоДополнительноеСведение",
			Выборка.Заголовок, Выборка.ПометкаУдаления, Выборка.ЭтоДополнительноеСведение);
		ДанныеСвойств.Вставить(Выборка.Ссылка, ДанныеСвойства);
	КонецЦикла;

	Существующие = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ТаблицаДопРеквизитовНоменклатуры Цикл
		Существующие.Вставить(СтрокаТаблицы.Свойство, Истина);
	КонецЦикла;

	Для Каждого Свойство Из МассивСвойств Цикл
		Если Существующие.Получить(Свойство) <> Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		ДанныеСвойства = ДанныеСвойств.Получить(Свойство);
		Если ДанныеСвойства = Неопределено Или ДанныеСвойства.ЭтоДополнительноеСведение Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаДопРеквизитовНоменклатуры.Добавить();
		НоваяСтрока.Свойство = Свойство;
		НоваяСтрока.ОбщееСвойство = Ложь;
		НоваяСтрока.ПредставлениеРеквизита = ДанныеСвойства.Заголовок;
		НоваяСтрока.ИндексКартинки = ?(ДанныеСвойства.ПометкаУдаления, 4, 1);

		Существующие.Вставить(Свойство, Истина);
		Результат.Добавлено = Результат.Добавлено + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
