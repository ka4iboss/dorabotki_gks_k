#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ППГД_ОбновитьИзРодителейСписокНаСервере(МассивСсылок)
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Родительские профили обновляемых объектов — одним запросом.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрофилиГруппДоступаРодители.Ссылка КАК Объект,
	|	ПрофилиГруппДоступаРодители.Профиль КАК Профиль
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.ППГД_РодительскиеПрофили КАК ПрофилиГруппДоступаРодители
	|ГДЕ
	|	ПрофилиГруппДоступаРодители.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	
	ТаблицаРодителей = Новый ТаблицаЗначений;
	ТаблицаРодителей.Колонки.Добавить("Объект");
	ТаблицаРодителей.Колонки.Добавить("Профиль");
	ВсеРодители = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаРодителя = ТаблицаРодителей.Добавить();
		СтрокаРодителя.Объект = Выборка.Объект;
		СтрокаРодителя.Профиль = Выборка.Профиль;
		ВсеРодители.Добавить(Выборка.Профиль);
	КонецЦикла;
	
	Если ТаблицаРодителей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Роли родительских профилей — одним запросом.
	ЗапросРоли = Новый Запрос;
	ЗапросРоли.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПрофилиГруппДоступаРоли.Ссылка КАК Профиль,
	|	ПрофилиГруппДоступаРоли.Роль.Имя КАК Роль
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|ГДЕ
	|	ПрофилиГруппДоступаРоли.Ссылка В(&РодительскиеПрофили)";
	ЗапросРоли.УстановитьПараметр("РодительскиеПрофили", ВсеРодители);
	
	РолиПоПрофилям = Новый Соответствие;
	ВыборкаРоли = ЗапросРоли.Выполнить().Выбрать();
	Пока ВыборкаРоли.Следующий() Цикл
		СписокРолейПрофиля = РолиПоПрофилям.Получить(ВыборкаРоли.Профиль);
		Если СписокРолейПрофиля = Неопределено Тогда
			СписокРолейПрофиля = Новый Соответствие;
			РолиПоПрофилям.Вставить(ВыборкаРоли.Профиль, СписокРолейПрофиля);
		КонецЕсли;
		СписокРолейПрофиля.Вставить(ВыборкаРоли.Роль, Истина);
	КонецЦикла;
	
	// Объединяем роли всех родителей по каждому объекту (без дублей).
	РолиПоОбъектам = Новый Соответствие;
	Для Каждого СтрокаРодителя Из ТаблицаРодителей Цикл
		СписокРолейОбъекта = РолиПоОбъектам.Получить(СтрокаРодителя.Объект);
		Если СписокРолейОбъекта = Неопределено Тогда
			СписокРолейОбъекта = Новый Соответствие;
			РолиПоОбъектам.Вставить(СтрокаРодителя.Объект, СписокРолейОбъекта);
		КонецЕсли;
		СписокРолейПрофиля = РолиПоПрофилям.Получить(СтрокаРодителя.Профиль);
		Если СписокРолейПрофиля <> Неопределено Тогда
			Для Каждого КлючИЗначение Из СписокРолейПрофиля Цикл
				СписокРолейОбъекта.Вставить(КлючИЗначение.Ключ, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из РолиПоОбъектам Цикл
		РольОбъект = КлючИЗначение.Ключ.ПолучитьОбъект();
		Если РольОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КлючРоли Из КлючИЗначение.Значение Цикл
			РольОбъект.Роли.Добавить().Роль = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Роль." + КлючРоли.Ключ);
		КонецЦикла;
		Попытка
			РольОбъект.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_ОбновитьИзРодителейПосле(Команда)
	
	МассивДляОбновления = Новый Массив;
	ППГД_СобратьЭлементыДляОбновления(Элементы.Список.ВыделенныеСтроки, МассивДляОбновления);
	
	Если МассивДляОбновления.Количество() > 0 Тогда
		ППГД_ОбновитьИзРодителейСписокНаСервере(МассивДляОбновления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_СобратьЭлементыДляОбновления(МасивСтрок, МассивДляОбновления)
	
	Для Каждого Стр Из МасивСтрок Цикл
		
		ТекДанные = Элементы.Список.ДанныеСтроки(Стр);
		
		Если ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекДанные.Ссылка, "ЭтоГруппа") = Истина Тогда
			
			ВложенныеЭлементыГруппы = ППГД_ПолучитьВложенныеЭлементы(ТекДанные.Ссылка);
			ППГД_СобратьЭлементыДляОбновления(ВложенныеЭлементыГруппы, МассивДляОбновления);
			
		Иначе
			
			МассивДляОбновления.Добавить(ТекДанные.Ссылка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ППГД_ПолучитьВложенныеЭлементы(ГруппаСсылка)
	
	МасВложенных = Новый Массив;
	
	Выборка = Справочники.ПрофилиГруппДоступа.Выбрать(ГруппаСсылка);
	Пока Выборка.Следующий() Цикл
		
		МасВложенных.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат МасВложенных;
	
КонецФункции

#КонецОбласти

