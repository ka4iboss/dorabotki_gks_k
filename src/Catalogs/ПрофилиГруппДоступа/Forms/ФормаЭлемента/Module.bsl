КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ППГД_текстДобавитьРолиПосле(Команда)
	
	ППГД_ИзменитьСоставРолей(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_текстИсключитьРолиПосле(Команда)
	
	ППГД_ИзменитьСоставРолей(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_ОбновитьИзРодителейПосле(Команда)
	
	ППГД_ОбновитьИзРодителейПослеНаСервере();
	ППГД_ИзменитьСоставРолей(Истина, "ППГД_ТекстовыеРолиКРодительским"); 
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_СкопироватьРолиПосле(Команда)

	ТекстРолей = ППГД_ПолучитьТекстСтрокВыбранныхРолей();
	ОбъектКопирования = Новый COMОбъект("htmlfile");
	ОбъектКопирования.ParentWindow.ClipboardData.SetData("Text", ТекстРолей);
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_ОбоработатьОтложенныеРолиПосле(Команда)
	
	Если ЗначениеЗаполнено(Объект.ППГД_ОтложенныеРолиДобавление) ТОгда
		ППГД_ИзменитьСоставРолей(Истина, "ППГД_ОтложенныеРолиДобавление");
		ППГД_ТекстОставшихсяОтложенныхРолей();
	Иначе
		ППГД_ИзменитьСоставРолей(Ложь, "ППГД_ОтложенныеРолиУдаление");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_ЗаполнитьВыбраннымиПосле(Команда)
	ППГД_СписокПредставлений.УстановитьТекст(ППГД_ПолучитьТекстСтрокВыбранныхРолей());
КонецПроцедуры

&НаКлиенте
Процедура ППГД_ПодборРолей(Команда)
	
	РолиПрофиля = Новый Массив;
	Для Каждого СтрокаТабличнойЧасти Из Объект.Роли Цикл
		РолиПрофиля.Добавить(СтрокаТабличнойЧасти.Роль);
	КонецЦикла;
	ОбъектыПрофиля = Новый Массив;
	Для Каждого СтрокаТабличнойЧасти Из Объект.ППГД_Объекты Цикл
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ОбъектМетаданных) Тогда
			ОбъектыПрофиля.Добавить(СтрокаТабличнойЧасти.ОбъектМетаданных);
		КонецЕсли;
	КонецЦикла;
	ПараметрыФормы = Новый Структура("ПрофильГруппыДоступа,РолиПрофиля,ОбъектыПрофиля", Объект.Ссылка, РолиПрофиля, ОбъектыПрофиля);
	ОткрытьФорму("Обработка.ППГД_ПодборРолейДляПрофиляГруппДоступа.Форма",
		ПараметрыФормы,
		ЭтотОбъект,,,,
		Новый ОписаниеОповещения("ППГД_ОбработкаПодбораРолей", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ППГД_ИзменитьСоставРолей(Режим, ИмяРеквизита = "")
	
	ПараметрыВыполнения = ППГД_ПолучитьПараметры();
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		МассивРолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект[ИмяРеквизита],Символы.ПС,Истина,Истина);
	Иначе
		СтрокаРоли = ППГД_СписокПредставлений.ПолучитьТекст();
		МассивРолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРоли,ППГД_СписокПредставлений.РазделительСтрок,Истина,Истина);
	КонецЕсли;
	
	Изменения = Ложь;
	
	//На форме не всегда есть все роли, 
	//и при установки пометки для роли которой нет ничего не будет сделано
	//поэтому получим список всех ролей, для удаления не актуально
	Если Режим Тогда 
		Дерево = ППГД_ПолучитьПолноеДеревоРолей(ПараметрыВыполнения);
	Иначе 
		Дерево = РеквизитФормыВЗначение("Роли", Тип("ДеревоЗначений"));
	КонецЕсли;
	
	//Роли назначенные пользователю, поэтому работаем с этой таблицей
	//дерево может отображать все роли, в таблице только назначенные
	ТЗРолей = РеквизитФормыВЗначение("КоллекцияРолей", Тип("ТаблицаЗначений"));
	
	СтрокиДерева=Дерево.Строки;
	
	Для каждого НоваяРоль из МассивРолей Цикл 
		
		НоваяРоль = СокрЛП(НоваяРоль);
		
		Если Прав(НоваяРоль,7) = " (Роль)" Тогда
			НоваяРоль = Лев(НоваяРоль,СтрДлина(НоваяРоль)-7);	
		КонецЕсли;	
			
		СтрокаДерева = СтрокиДерева.Найти(НоваяРоль,"Синоним");
		Если СтрокаДерева = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		НайденныеРоли = ТЗРолей.НайтиСтроки(Новый Структура("Роль", СтрокаДерева.Имя));
		
		Если Режим Тогда 
			Если НайденныеРоли.Количество() = 0 Тогда
				ТЗРолей.Добавить().Роль = СтрокаДерева.Имя;
			КонецЕсли;
		Иначе
			Если НайденныеРоли.Количество() > 0 Тогда
				ТЗРолей.Удалить(НайденныеРоли[0]);
			КонецЕсли;
		КонецЕсли;
		Изменения = Истина;
	КонецЦикла;
	
	//в списке изменения могут быть не существующие роли
	//или не доступные для назначения
	Если Изменения Тогда 
		
		ЗначениеВДанныеФормы(ТЗРолей,КоллекцияРолей);
		//Обрежем дерево согласно назначенным ролям
		// по сути по таблице назначенных ролей ставим галки
		// и при необходимости скрываем не включенные
		ППГД_ОбновитьПометкуВыбранныхРолей(Дерево.Строки);
		ЗначениеВДанныеФормы(Дерево,Роли);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ППГД_ОбновитьПометкуВыбранныхРолей(Знач Коллекция)
	
	ПоказатьТолькоВыбранныеРоли = Элементы.РолиПоказатьТолькоВыбранныеРоли.Пометка;
	
	Индекс = Коллекция.Количество()-1;
	
	Пока Индекс >= 0 Цикл
		Строка = Коллекция[Индекс];
		
		Если Строка.ЭтоРоль Тогда
			Отбор = Новый Структура("Роль", Строка.Имя);
			Строка.Пометка = КоллекцияРолей.НайтиСтроки(Отбор).Количество() > 0;
			Если ПоказатьТолькоВыбранныеРоли И НЕ Строка.Пометка Тогда
				Коллекция.Удалить(Индекс);
			КонецЕсли;
		Иначе
			ППГД_ОбновитьПометкуВыбранныхРолей(Строка.ПолучитьЭлементы());
			Если Строка.ПолучитьЭлементы().Количество() = 0 Тогда
				Коллекция.Удалить(Индекс);
			Иначе
				Строка.Пометка = Истина;
				Для каждого Элемент Из Строка.ПолучитьЭлементы() Цикл
					Если НЕ Элемент.Пометка Тогда
						Строка.Пометка = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Индекс = Индекс-1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ППГД_ПолучитьПолноеДеревоРолей(ПараметрыВыполнения)
	НазначениеРолей = ПараметрыВыполнения.НазначениеРолей;
	СкрытьРольПолныеПрава = ПараметрыВыполнения.Свойство("СкрытьРольПолныеПрава")
	                      И ПараметрыВыполнения.СкрытьРольПолныеПрава = Истина;
	//Всегда получаем полное дерево					  
	ПоказатьТолькоВыбранныеРоли = Ложь;
					  
	ДеревоРолей = ПользователиСлужебныйПовтИсп.ДеревоРолей(
	ПоказатьПодсистемыРолей, НазначениеРолей).Получить();
	
	ДеревоРолей.Колонки.Добавить("ЭтоНедоступнаяРоль",    Новый ОписаниеТипов("Булево"));
	ДеревоРолей.Колонки.Добавить("ЭтоНесуществующаяРоль", Новый ОписаниеТипов("Булево"));
	ППГД_ДобавитьИменаНесуществующихИНедоступныхРолей(ПараметрыВыполнения, ДеревоРолей);
	
	ДеревоРолей.Колонки.Добавить("Пометка",       Новый ОписаниеТипов("Булево"));
	ДеревоРолей.Колонки.Добавить("НомерКартинки", Новый ОписаниеТипов("Число"));
	ППГД_ПодготовитьДеревоРолей(ДеревоРолей.Строки, СкрытьРольПолныеПрава, ПоказатьТолькоВыбранныеРоли,
	ПараметрыВыполнения.КоллекцияРолей);
	
	Возврат ДеревоРолей;
КонецФункции

&НаСервере
Процедура ППГД_ДобавитьИменаНесуществующихИНедоступныхРолей(ПараметрыВвыполнения, ДеревоРолей)
	
	КоллекцияРолей_П  = ПараметрыВвыполнения.КоллекцияРолей;
	ВсеРоли = ПользователиСлужебный.ВсеРоли().Соответствие;
	
	НедоступныеРоли    = Новый СписокЗначений;
	НесуществующиеРоли = Новый СписокЗначений;
	
	// Добавление несуществующих ролей.
	Для каждого Строка Из КоллекцияРолей_П Цикл
		Отбор = Новый Структура("ЭтоРоль, Имя", Истина, Строка.Роль);
		Если ДеревоРолей.Строки.НайтиСтроки(Отбор, Истина).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Синоним = ВсеРоли.Получить(Строка.Роль);
		Если Синоним = Неопределено Тогда
			НесуществующиеРоли.Добавить(Строка.Роль,
				?(Лев(Строка.Роль, 1) = "?", Строка.Роль, "? " + Строка.Роль));
		Иначе
			НедоступныеРоли.Добавить(Строка.Роль, Синоним);
		КонецЕсли;
	КонецЦикла;
	
	НедоступныеРоли.СортироватьПоПредставлению();
	Для Каждого ОписаниеРоли Из НедоступныеРоли Цикл
		Индекс = НедоступныеРоли.Индекс(ОписаниеРоли);
		СтрокаДерева = ДеревоРолей.Строки.Вставить(Индекс);
		СтрокаДерева.Имя     = ОписаниеРоли.Значение;
		СтрокаДерева.Синоним = ОписаниеРоли.Представление;
		СтрокаДерева.ЭтоРоль = Истина;
		СтрокаДерева.ЭтоНедоступнаяРоль = Истина;
	КонецЦикла;
	
	НесуществующиеРоли.СортироватьПоПредставлению();
	Для Каждого ОписаниеРоли Из НесуществующиеРоли Цикл
		Индекс = НесуществующиеРоли.Индекс(ОписаниеРоли);
		СтрокаДерева = ДеревоРолей.Строки.Вставить(Индекс);
		СтрокаДерева.Имя     = ОписаниеРоли.Значение;
		СтрокаДерева.Синоним = ОписаниеРоли.Представление;
		СтрокаДерева.ЭтоРоль = Истина;
		СтрокаДерева.ЭтоНесуществующаяРоль = Истина;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Функция ППГД_ПолучитьПараметры()
	
	ПараметрыДействия = Новый Структура;
	ПараметрыДействия.Вставить("ОсновнойПараметр", Неопределено);
	ПараметрыДействия.Вставить("Форма",            ЭтотОбъект);
	ПараметрыДействия.Вставить("КоллекцияРолей",   КоллекцияРолей);
	
	ПараметрыДействия.Вставить("СкрытьРольПолныеПрава",
	Объект.Ссылка <> ПредопределенноеЗначение("Справочник.ПрофилиГруппДоступа.Администратор"));
	
	ПараметрыДействия.Вставить("НазначениеРолей",
	УправлениеДоступомСлужебныйКлиентСервер.НазначениеПрофиля(Объект));
	
	Возврат ПараметрыДействия;
	
КонецФункции

&НаСервере
Процедура ППГД_ПодготовитьДеревоРолей(Знач Коллекция, Знач СкрытьРольПолныеПрава, Знач ПоказатьТолькоВыбранныеРоли, КоллекцияРолей)
	
	Индекс = Коллекция.Количество()-1;
	
	Пока Индекс >= 0 Цикл
		Строка = Коллекция[Индекс];
		
		ППГД_ПодготовитьДеревоРолей(Строка.Строки, СкрытьРольПолныеПрава, ПоказатьТолькоВыбранныеРоли,
			КоллекцияРолей);
		
		Если Строка.ЭтоРоль Тогда
			Если СкрытьРольПолныеПрава
			   И (    ВРег(Строка.Имя) = ВРег("ПолныеПрава")
			      ИЛИ ВРег(Строка.Имя) = ВРег("АдминистраторСистемы")) Тогда
				Коллекция.Удалить(Индекс);
			Иначе
				Строка.НомерКартинки = 7;
				Строка.Пометка = КоллекцияРолей.НайтиСтроки(
					Новый Структура("Роль", Строка.Имя)).Количество() > 0;
				
				Если ПоказатьТолькоВыбранныеРоли И НЕ Строка.Пометка Тогда
					Коллекция.Удалить(Индекс);
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Строка.Строки.Количество() = 0 Тогда
				Коллекция.Удалить(Индекс);
			Иначе
				Строка.НомерКартинки = 6;
				Строка.Пометка = Строка.Строки.НайтиСтроки(
					Новый Структура("Пометка", Ложь)).Количество() = 0;
			КонецЕсли;
		КонецЕсли;
		
		Индекс = Индекс-1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ППГД_ОбновитьИзРодителейПослеНаСервере()
	
	ТЗРодительскиеПрофили = Объект.ППГД_РодительскиеПрофили.Выгрузить(,"Профиль");
	
	Если ТЗРодительскиеПрофили.Количество() > 0 Тогда
		
		ПараметрыВыполнения = ППГД_ПолучитьПараметры();
		
		Дерево = ППГД_ПолучитьПолноеДеревоРолей(ПараметрыВыполнения);
		
		МассивРодительскихРолей = ТЗРодительскиеПрофили.ВыгрузитьКолонку("Профиль");
		
		Запрос = Новый Запрос;
		Запрос.Текст ="ВЫБРАТЬ
		|	ПрофилиГруппДоступаРоли.Роль.Имя КАК Роль
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
		|ГДЕ
		|	ПрофилиГруппДоступаРоли.Ссылка В(&РодительскиеПрофили)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрофилиГруппДоступаРоли.Роль";
		Запрос.УстановитьПараметр("РодительскиеПрофили",МассивРодительскихРолей);
		Выборка = Запрос.Выполнить().Выгрузить();
		    КоллекцияРолей.Загрузить(Выборка);
			ППГД_ОбновитьПометкуВыбранныхРолей(Дерево.Строки);
		ЗначениеВДанныеФормы(Дерево,Роли);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ППГД_ПолучитьТекстСтрокВыбранныхРолей()
	
	ТекстРолей = "";
	Дерево = РеквизитФормыВЗначение("Роли", Тип("ДеревоЗначений"));
	
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		Если СтрокаДерева.Пометка Тогда
			ТекстРолей = ТекстРолей + СтрокаДерева.Синоним + Символы.ПС;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат ТекстРолей;
	
КонецФункции

&НаСервере
Процедура ППГД_ТекстОставшихсяОтложенныхРолей()
	
	ТекстРолей = "";
	Дерево = РеквизитФормыВЗначение("Роли", Тип("ДеревоЗначений"));
	МассивРолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.ППГД_ОтложенныеРолиДобавление,Символы.ПС,Истина,Истина);
	
	
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		
		ИндексВМассиве = МассивРолей.Найти(СтрокаДерева.Синоним);
		
		Если Не ИндексВМассиве = Неопределено Тогда
			МассивРолей.Удалить(ИндексВМассиве);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаМассива Из МассивРолей Цикл
		ТекстРолей = ТекстРолей + СтрокаМассива + Символы.ПС;	
	КонецЦикла;
	
	Объект.ППГД_ОтложенныеРолиДобавление = ТекстРолей;

	
	
КонецПроцедуры

&НаКлиенте
Процедура ППГД_ОбработкаПодбораРолей(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		ППГД_ОбработатьПодборРолейВПрофильГруппыДоступа(РезультатЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ППГД_ОбработатьПодборРолейВПрофильГруппыДоступа(РезультатПодбора)
	
	Объект.Роли.Очистить();
	Для Каждого Элемент Из РезультатПодбора.Роли Цикл
