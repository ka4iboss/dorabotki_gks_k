#Область ОписаниеПеременных

// Признак того, что включён обработчик ожидания обновления страницы «Диагностика».
&НаКлиенте
Перем ОбновлениеЖурналаВключено;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьОтборыСписков();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказы

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Заказы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ЗаполнитьТоварыЗаказаНаСервере(Неопределено);
		Возврат;
	КонецЕсли;

	ЗаполнитьТоварыЗаказаНаСервере(ТекущиеДанные.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоступления

&НаКлиенте
Процедура ПоступленияПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Поступления.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ЗаполнитьТоварыПоступленияНаСервере(Неопределено);
		Возврат;
	КонецЕсли;

	УстановитьОтборыЗаказов(ТекущиеДанные.Партнер, ТекущиеДанные.СуммаДокумента, ТекущиеДанные.Склад);
	ЗаполнитьТоварыПоступленияНаСервере(ТекущиеДанные.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерезаполнитьПоступлениеПоЗаказу(Команда)

	ТекущееПоступление = Элементы.Поступления.ТекущиеДанные;
	ТекущийЗаказ = Элементы.Заказы.ТекущиеДанные;

	Если ТекущееПоступление = Неопределено ИЛИ ТекущийЗаказ = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите поступление и заказ.'"));
		Возврат;
	КонецЕсли;

	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Поступление", ТекущееПоступление.Ссылка);
	ПараметрыКоманды.Вставить("Заказ", ТекущийЗаказ.Ссылка);

	Оповещение = Новый ОписаниеОповещения("ПерезаполнитьПоступлениеПоЗаказуЗавершение", ЭтотОбъект, ПараметрыКоманды);

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Документ %1 будет очищен, перезаполнен по заказу %2 и проведен. Продолжить?'"),
		Строка(ТекущееПоступление.Ссылка),
		Строка(ТекущийЗаказ.Ссылка));

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьТочныеСовпадения(Команда)

	Задание = ПодготовитьЗаданиеНаСервере();

	Если Задание.ВсегоСтрок = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не найдено поступлений с точным совпадением по заказу поставщику.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПерезаполнитьТочныеСовпаденияЗавершение", ЭтотОбъект);

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Будет перезаполнено и проведено документов: %1. Продолжить?'"),
		Задание.ВсегоСтрок);

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтопривязкуПоЗаказам(Команда)

	ЗапуститьАвтопривязку("ПоЗаказам");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтопривязкуПоДокументам(Команда)

	ЗапуститьАвтопривязку("ПоДокументам");

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЖурналДиагностики(Команда)

	ОчиститьЖурналНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПерезаполнитьПоступлениеПоЗаказуЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ПерезаполнитьПоступлениеНаСервере(ДополнительныеПараметры.Поступление, ДополнительныеПараметры.Заказ);

	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Не удалось перезаполнить документ %1: %2'"),
			Строка(ДополнительныеПараметры.Поступление),
			Результат.ТекстОшибки));
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Документ %1 перезаполнен по заказу %2 и проведен.'"),
		Строка(ДополнительныеПараметры.Поступление),
		Строка(ДополнительныеПараметры.Заказ)));

	ОбновитьОтборыСписковНаСервере();
	ЗаполнитьТоварыПоступленияНаСервере(ДополнительныеПараметры.Поступление);

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьТочныеСовпаденияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ПерезаполнитьТочныеСовпаденияНаСервере();
	ПоказатьПредупреждение(, ОписаниеРезультата(Результат));

	ОбновитьОтборыСписковНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборыЗаказов(Партнер, СуммаДокумента, Склад)

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Заказы);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Заказы, "Партнер", Партнер, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Заказы, "СуммаДокумента", СуммаДокумента, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Заказы, "Склад", Склад, ВидСравненияКомпоновкиДанных.Равно);

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборыСписков()

	// В списке нужны только поступления, ещё не связанные с заказами поставщику.
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Поступления, "ПоступлениеПоЗаказам", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Заказы);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборыСписковНаСервере()

	ОбновитьОтборыСписков();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоступленияНаСервере(ПоступлениеСсылка)

	ТоварыПоступления.Загрузить(ГКСК_ПерезаполнениеПоступленийСервер.ТоварыДокумента(ПоступлениеСсылка));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыЗаказаНаСервере(ЗаказСсылка)

	ТоварыЗаказа.Загрузить(ГКСК_ПерезаполнениеПоступленийСервер.ТоварыДокумента(ЗаказСсылка));

КонецПроцедуры

&НаСервере
Функция ПодготовитьЗаданиеНаСервере()

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПодготовитьЗадание();

КонецФункции

&НаСервере
Функция ПерезаполнитьПоступлениеНаСервере(ПоступлениеСсылка, ЗаказСсылка)

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПерезаполнитьПоступление(ПоступлениеСсылка, ЗаказСсылка);

КонецФункции

&НаСервере
Функция ПерезаполнитьТочныеСовпаденияНаСервере()

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПерезаполнитьТочныеСовпадения();

КонецФункции

&НаКлиенте
Функция ОписаниеРезультата(Результат)

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(
		НСтр("ru = 'Обработано документов: %1 из %2.'"),
		Результат.Обработано,
		Результат.Всего));

	Если Результат.Ошибки.Количество() > 0 Тогда
		Тексты.Добавить("");
		Тексты.Добавить(СтрШаблон(
			НСтр("ru = 'Не обработано (ошибок: %1):'"),
			Результат.Ошибки.Количество()));
		Для Каждого ОшибкаСтроки Из Результат.Ошибки Цикл
			Тексты.Добавить(СтрШаблон("%1: %2", Строка(ОшибкаСтроки.Поступление), ОшибкаСтроки.ТекстОшибки));
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура ЗапуститьАвтопривязку(Этап)

	Задание = ПодготовитьЗаданиеАвтопривязкиНаСервере(Этап);
	Если Задание.Всего = 0 Тогда
		ПоказатьПредупреждение(, Задание.Описание);
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("АвтопривязкаПодтверждена", ЭтотОбъект, Этап);

	ТекстВопроса = Задание.Описание + Символы.ПС
		+ НСтр("ru = 'Документы будут перезаполнены и проведены. Продолжить?'");

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура АвтопривязкаПодтверждена(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаданиеАвтопривязки = ЗапуститьЗаданиеАвтопривязкиНаСервере(ДополнительныеПараметры);
	Если ЗаданиеАвтопривязки = Неопределено ИЛИ ЗаданиеАвтопривязки.ДлительнаяОперация = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось запустить фоновое задание.'"));
		Возврат;
	КонецЕсли;

	// Журнал диагностики пишется в регистр сведений, поэтому форма может показывать
	// строки во время выполнения задания и после его отмены.
	ОчиститьЖурналНаСервере();
	ВключитьОбновлениеЖурнала();

	Оповещение = Новый ОписаниеОповещения("АвтопривязкаЗавершена", ЭтотОбъект);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Автопривязка документов'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	// Окно ожидания по умолчанию блокирует интерфейс, и тогда обработчик ожидания
	// (чтение журнала из хранилища) не выполняется: страница «Диагностика» остаётся
	// пустой и после отмены задания. Независимое окно не блокирует форму.
	ПараметрыОжидания.РежимОткрытияОкнаОжидания = РежимОткрытияОкнаФормы.Независимый;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(ЗаданиеАвтопривязки.ДлительнаяОперация, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура АвтопривязкаЗавершена(Результат, ДополнительныеПараметры) Экспорт

	ВыключитьОбновлениеЖурнала();
	ОбновитьЖурналДиагностикиНаСервере();

	Если Результат = Неопределено Тогда
		// Задание отменено пользователем. Строки, записанные до отмены, уже в журнале.
		Если ЖурналДиагностики.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Задание отменено, строк диагностики получить не удалось.
				|Диагностика также пишется в журнал регистрации: событие ""ГКСК.АвтопривязкаДокументов""'"));
		Иначе
			ПоказатьПредупреждение(, НСтр("ru = 'Задание отменено. Обработанные строки — на странице «Диагностика».'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;

	РезультатЗадания = ПолучитьРезультатАвтопривязкиНаСервере(Результат.АдресРезультата);
	Если РезультатЗадания = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось прочитать результат фонового задания.'"));
		Возврат;
	КонецЕсли;

	ЗагрузитьЖурналДиагностикиНаСервере(РезультатЗадания.Лог);

	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Обработано документов: %1. Успешно: %2. Ошибок: %3. Подробности — на странице «Диагностика».'"),
		РезультатЗадания.Обработано, РезультатЗадания.Успешно, РезультатЗадания.Ошибок));

	ОбновитьОтборыСписковНаСервере();

КонецПроцедуры

&НаСервере
Функция ПодготовитьЗаданиеАвтопривязкиНаСервере(Этап)

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПодготовитьЗаданиеАвтопривязки(Этап);

КонецФункции

&НаСервере
Функция ЗапуститьЗаданиеАвтопривязкиНаСервере(Этап)

	ГКСК_ПерезаполнениеПоступленийСервер.ОчиститьЖурналАвтопривязки();

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Этап", Этап);

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Автопривязка документов'");

	ДлительнаяОперация = ДлительныеОперации.ВыполнитьВФоне(
		"ГКСК_ПерезаполнениеПоступленийСервер.ВыполнитьЗаданиеАвтопривязки",
		ПараметрыЗадания, ПараметрыВыполнения);

	Результат = Новый Структура;
	Результат.Вставить("ДлительнаяОперация", ДлительнаяОперация);

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьРезультатАвтопривязкиНаСервере(АдресРезультата)

	Если НЕ ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗагрузитьЖурналДиагностикиНаСервере(Лог)

	Если ТипЗнч(Лог) = Тип("ТаблицаЗначений") Тогда
		ЖурналДиагностики.Загрузить(Лог);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьЖурналДиагностикиНаСервере()

	Лог = ГКСК_ПерезаполнениеПоступленийСервер.ЖурналАвтопривязкиИзРегистра();
	Если Лог.Количество() <> ЖурналДиагностики.Количество() Тогда
		ЖурналДиагностики.Загрузить(Лог);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОчиститьЖурналНаСервере()

	ЖурналДиагностики.Очистить();
	ГКСК_ПерезаполнениеПоступленийСервер.ОчиститьЖурналАвтопривязки();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурналДиагностики()

	ОбновитьЖурналДиагностикиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВключитьОбновлениеЖурнала()

	// Переменная модуля формы до первого присваивания равна Неопределено,
	// поэтому сравниваем с Истиной, а не отрицаем значение.
	Если ОбновлениеЖурналаВключено <> Истина Тогда
		ПодключитьОбработчикОжидания("ОбновитьЖурналДиагностики", 2);
		ОбновлениеЖурналаВключено = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыключитьОбновлениеЖурнала()

	Если ОбновлениеЖурналаВключено = Истина Тогда
		ОтключитьОбработчикОжидания("ОбновитьЖурналДиагностики");
