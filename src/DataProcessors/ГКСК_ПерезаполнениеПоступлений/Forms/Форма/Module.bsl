#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьОтборыСписков();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаказы

&НаКлиенте
Процедура ЗаказыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Заказы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ЗаполнитьТоварыЗаказаНаСервере(Неопределено);
		Возврат;
	КонецЕсли;

	ЗаполнитьТоварыЗаказаНаСервере(ТекущиеДанные.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоступления

&НаКлиенте
Процедура ПоступленияПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Поступления.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ЗаполнитьТоварыПоступленияНаСервере(Неопределено);
		Возврат;
	КонецЕсли;

	УстановитьОтборыЗаказов(ТекущиеДанные.Партнер, ТекущиеДанные.СуммаДокумента, ТекущиеДанные.Склад);
	ЗаполнитьТоварыПоступленияНаСервере(ТекущиеДанные.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерезаполнитьПоступлениеПоЗаказу(Команда)

	ТекущееПоступление = Элементы.Поступления.ТекущиеДанные;
	ТекущийЗаказ = Элементы.Заказы.ТекущиеДанные;

	Если ТекущееПоступление = Неопределено ИЛИ ТекущийЗаказ = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите поступление и заказ.'"));
		Возврат;
	КонецЕсли;

	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Поступление", ТекущееПоступление.Ссылка);
	ПараметрыКоманды.Вставить("Заказ", ТекущийЗаказ.Ссылка);

	Оповещение = Новый ОписаниеОповещения("ПерезаполнитьПоступлениеПоЗаказуЗавершение", ЭтотОбъект, ПараметрыКоманды);

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Документ %1 будет очищен, перезаполнен по заказу %2 и проведен. Продолжить?'"),
		Строка(ТекущееПоступление.Ссылка),
		Строка(ТекущийЗаказ.Ссылка));

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьТочныеСовпадения(Команда)

	Задание = ПодготовитьЗаданиеНаСервере();

	Если Задание.ВсегоСтрок = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не найдено поступлений с точным совпадением по заказу поставщику.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПерезаполнитьТочныеСовпаденияЗавершение", ЭтотОбъект);

	ТекстВопроса = СтрШаблон(
		НСтр("ru = 'Будет перезаполнено и проведено документов: %1. Продолжить?'"),
		Задание.ВсегоСтрок);

	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПерезаполнитьПоступлениеПоЗаказуЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ПерезаполнитьПоступлениеНаСервере(ДополнительныеПараметры.Поступление, ДополнительныеПараметры.Заказ);

	Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Не удалось перезаполнить документ %1: %2'"),
			Строка(ДополнительныеПараметры.Поступление),
			Результат.ТекстОшибки));
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Документ %1 перезаполнен по заказу %2 и проведен.'"),
		Строка(ДополнительныеПараметры.Поступление),
		Строка(ДополнительныеПараметры.Заказ)));

	ОбновитьОтборыСписковНаСервере();
	ЗаполнитьТоварыПоступленияНаСервере(ДополнительныеПараметры.Поступление);

КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьТочныеСовпаденияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ПерезаполнитьТочныеСовпаденияНаСервере();
	ПоказатьПредупреждение(, ОписаниеРезультата(Результат));

	ОбновитьОтборыСписковНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборыЗаказов(Партнер, СуммаДокумента, Склад)

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Заказы);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Заказы, "Партнер", Партнер, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Заказы, "СуммаДокумента", СуммаДокумента, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Заказы, "Склад", Склад, ВидСравненияКомпоновкиДанных.Равно);

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборыСписков()

	// В списке нужны только поступления, ещё не связанные с заказами поставщику.
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Поступления, "ПоступлениеПоЗаказам", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Заказы);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборыСписковНаСервере()

	ОбновитьОтборыСписков();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыПоступленияНаСервере(ПоступлениеСсылка)

	ТоварыПоступления.Загрузить(ГКСК_ПерезаполнениеПоступленийСервер.ТоварыДокумента(ПоступлениеСсылка));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыЗаказаНаСервере(ЗаказСсылка)

	ТоварыЗаказа.Загрузить(ГКСК_ПерезаполнениеПоступленийСервер.ТоварыДокумента(ЗаказСсылка));

КонецПроцедуры

&НаСервере
Функция ПодготовитьЗаданиеНаСервере()

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПодготовитьЗадание();

КонецФункции

&НаСервере
Функция ПерезаполнитьПоступлениеНаСервере(ПоступлениеСсылка, ЗаказСсылка)

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПерезаполнитьПоступление(ПоступлениеСсылка, ЗаказСсылка);

КонецФункции

&НаСервере
Функция ПерезаполнитьТочныеСовпаденияНаСервере()

	Возврат ГКСК_ПерезаполнениеПоступленийСервер.ПерезаполнитьТочныеСовпадения();

КонецФункции

&НаКлиенте
Функция ОписаниеРезультата(Результат)

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(
		НСтр("ru = 'Обработано документов: %1 из %2.'"),
		Результат.Обработано,
		Результат.Всего));

	Если Результат.Ошибки.Количество() > 0 Тогда
		Тексты.Добавить("");
		Тексты.Добавить(СтрШаблон(
			НСтр("ru = 'Не обработано (ошибок: %1):'"),
			Результат.Ошибки.Количество()));
		Для Каждого ОшибкаСтроки Из Результат.Ошибки Цикл
			Тексты.Добавить(СтрШаблон("%1: %2", Строка(ОшибкаСтроки.Поступление), ОшибкаСтроки.ТекстОшибки));
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти
