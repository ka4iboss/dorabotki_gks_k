#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокРегистров();
	
	Замещать = Истина;
	Прогресс = 0;
	ВыполняетсяОбработка = Ложь;
	
	Если Не ПустаяСтрока(ИмяРегистра) Тогда
		ЗаполнитьПоляРегистра();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяРегистраПриИзменении(Элемент)
	
	ЗаполнитьПоляРегистра();
	ОчиститьРезультат();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРегистраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗаполнитьСписокВыбораРегистров(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРегистраНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	// Заполняем список выбора перед его открытием на клиенте.
	ЗаполнитьСписокВыбораРегистров(Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьУсловие(Команда)
	
	ДобавитьУсловиеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУсловие(Команда)
	
	УдалитьУсловиеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура Изменить(Команда)
	
	Если ВыполняетсяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбран регистр сведений.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьИзменяемыеПоля() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного поля для изменения.'"));
		Возврат;
	КонецЕсли;
	
	Если ЭтоРегистрПодчиненныйРегистратору() Тогда
		ТекстВопроса = НСтр("ru = 'Регистр сведений подчинён регистратору.
			|Изменения будут потеряны при перепроведении документа-регистратора.
			|Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьИзменение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	ВыполнитьИзменение();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьСписокВыбораРегистров(Элемент)
	
	Если Элемент.СписокВыбора.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокРегистров() Цикл
		Элемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьИзменение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ВыполнитьИзменение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИзменение()
	
	ДлительнаяОперация = НачатьИзменение();
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, ОбработкаОшибок.КраткоеПредставлениеОшибки(ДлительнаяОперация.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	ВыполняетсяОбработка = Истина;
	Прогресс = 0;
	ОчиститьРезультат();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ИзменениеЗавершено", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеЗавершено(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняетсяОбработка = Ложь;
	Прогресс = 100;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, ОбработкаОшибок.КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке));
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРезультат(Результат.АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРегистров()
	
	Элементы.ПолеИмяРегистра.СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из СписокРегистров() Цикл
		Элементы.ПолеИмяРегистра.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокРегистров()
	
	Результат = Новый СписокЗначений;
	
	Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
		Результат.Добавить(Регистр.ПолноеИмя(), Регистр.Представление());
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоляРегистра()
	
	ПоляРегистра.Очистить();
	УсловияОтбора.Очистить();
	ПредставлениеРегистра = "";
	
	ОбработкаОбъект = Обработки.ГКСК_ГрупповоеИзменениеЗаписейРегистров.Создать();
	СписокПолей = ОбработкаОбъект.ПоляРегистра(ИмяРегистра);
	ПредставлениеРегистра = ОбработкаОбъект.ПредставлениеРегистра(ИмяРегистра);
	
	Для Каждого Описание Из СписокПолей Цикл
		Строка = ПоляРегистра.Добавить();
		Строка.Имя = Описание.Имя;
		Строка.Представление = Описание.Представление;
		Строка.ВидПоля = Описание.ВидПоля;
		Строка.Изменять = Ложь;
	КонецЦикла;
	
	ЗаполнитьСписокПолейОтбора(СписокПолей);
	ЗаполнитьСписокСравнений();
	ДобавитьУсловиеСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПолейОтбора(СписокПолей)
	
	Элементы.КолонкаОтбораИмяПоля.СписокВыбора.Очистить();
	
	Для Каждого Описание Из СписокПолей Цикл
		Элементы.КолонкаОтбораИмяПоля.СписокВыбора.Добавить(Описание.Имя, Описание.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСравнений()
	
	Список = Элементы.КолонкаОтбораВидСравнения.СписокВыбора;
	Список.Очистить();
	Список.Добавить("Равно", НСтр("ru = 'Равно'"));
	Список.Добавить("НеРавно", НСтр("ru = 'Не равно'"));
	Список.Добавить("Больше", НСтр("ru = 'Больше'"));
	Список.Добавить("БольшеИлиРавно", НСтр("ru = 'Больше или равно'"));
	Список.Добавить("Меньше", НСтр("ru = 'Меньше'"));
	Список.Добавить("МеньшеИлиРавно", НСтр("ru = 'Меньше или равно'"));
	Список.Добавить("Содержит", НСтр("ru = 'Содержит'"));
	Список.Добавить("НачинаетсяС", НСтр("ru = 'Начинается с'"));
	Список.Добавить("Заполнено", НСтр("ru = 'Заполнено'"));
	Список.Добавить("НеЗаполнено", НСтр("ru = 'Не заполнено'"));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловиеСервер()
	
	Строка = УсловияОтбора.Добавить();
	Строка.ВидСравнения = "Равно";
	
КонецПроцедуры

&НаСервере
Процедура УдалитьУсловиеСервер()
	
	Если УсловияОтбора.Количество() > 0 Тогда
		УсловияОтбора.Удалить(УсловияОтбора.Количество() - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьИзменяемыеПоля()
	
	Для Каждого Строка Из ПоляРегистра Цикл
		Если Строка.Изменять И Строка.ВидПоля <> "Регистратор" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЭтоРегистрПодчиненныйРегистратору()
	
	ОбработкаОбъект = Обработки.ГКСК_ГрупповоеИзменениеЗаписейРегистров.Создать();
	Возврат ОбработкаОбъект.ЭтоРегистрПодчиненныйРегистратору(ИмяРегистра);
	
КонецФункции

&НаСервере
Функция НачатьИзменение()
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяРегистра", ИмяРегистра);
	ПараметрыЗадания.Вставить("УсловияОтбора", УсловияОтбораВыгрузить());
	ПараметрыЗадания.Вставить("ИзменяемыеПоля", ИзменяемыеПоляВыгрузить());
	ПараметрыЗадания.Вставить("Замещать", Замещать);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Групповое изменение записей регистров сведений'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработка.ГКСК_ГрупповоеИзменениеЗаписейРегистров.МодульОбъекта.ВыполнитьИзменениеЗаписей",
		ПараметрыЗадания, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция УсловияОтбораВыгрузить()
	
	Результат = Новый Массив;
	
	Для Каждого Строка Из УсловияОтбора Цикл
		Если ПустаяСтрока(Строка.ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("ИмяПоля", Строка.ИмяПоля);
		Описание.Вставить("ВидСравнения", Строка.ВидСравнения);
		Описание.Вставить("Значение", Строка.Значение);
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИзменяемыеПоляВыгрузить()
	
	Результат = Новый Массив;
	
	Для Каждого Строка Из ПоляРегистра Цикл
		Если Не Строка.Изменять Или Строка.ВидПоля = "Регистратор" Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("Имя", Строка.Имя);
		Описание.Вставить("Значение", Строка.Значение);
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРезультат(АдресРезультата)
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаДанных Из Данные Цикл
			НоваяСтрока = РезультатОбработки.Добавить();
			НоваяСтрока.Запись = СтрокаДанных.Запись;
			НоваяСтрока.Ошибка = СтрокаДанных.Ошибка;
		КонецЦикла;
	КонецЕсли;
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРезультат()
	
	РезультатОбработки.Очистить();
	Прогресс = 0;
	
КонецПроцедуры

#КонецОбласти
