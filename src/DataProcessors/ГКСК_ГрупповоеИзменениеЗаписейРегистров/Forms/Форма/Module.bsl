#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокРегистров();
	
	Замещать = Истина;
	Прогресс = 0;
	ВыполняетсяОбработка = Ложь;
	
	Если Не ПустаяСтрока(ИмяРегистра) Тогда
		ЗаполнитьПоляРегистра();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяРегистраПриИзменении(Элемент)
	
	ЗаполнитьПоляРегистра();
	ОчиститьОтмеченныеЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРегистраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗаполнитьСписокВыбораРегистров(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяРегистраНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	// Заполняем список выбора перед его открытием на клиенте.
	ЗаполнитьСписокВыбораРегистров(Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьУсловие(Команда)
	
	ДобавитьУсловиеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУсловие(Команда)
	
	УдалитьУсловиеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЗаписи(Команда)
	
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбран регистр сведений.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗаполнитьЗаписиРегистра() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось построить список записей выбранного регистра.'"));
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенные(Команда)
	
	Идентификаторы = Элементы.ТаблицаЗаписей.ВыделенныеСтроки;
	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выделено ни одной записи.'"));
		Возврат;
	КонецЕсли;
	
	ИменаПолей = Новый Массив;
	Для Каждого Описание Из КлючевыеПоляРегистра() Цикл
		ИменаПолей.Добавить(Описание.Имя);
	КонецЦикла;
	
	Записи = Новый Массив;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаСписка = Элементы.ТаблицаЗаписей.ДанныеСтроки(Идентификатор);
		Если СтрокаСписка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Новый Структура;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Запись.Вставить(ИмяПоля, СтрокаСписка[ИмяПоля]);
		КонецЦикла;
		Записи.Добавить(Запись);
	КонецЦикла;
	
	ДобавитьВОтмеченные(Записи);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	
	ОчиститьОтмеченныеЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура Изменить(Команда)
	
	Если ВыполняетсяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбран регистр сведений.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьИзменяемыеПоля() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного поля для изменения.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьОтмеченныеЗаписи() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одной записи регистра.'"));
		Возврат;
	КонецЕсли;
	
	Если ЭтоРегистрПодчиненныйРегистратору() Тогда
		ТекстВопроса = НСтр("ru = 'Регистр сведений подчинён регистратору.
			|Изменения будут потеряны при перепроведении документа-регистратора.
			|Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьИзменение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	ВыполнитьИзменение();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьСписокВыбораРегистров(Элемент)
	
	Если Элемент.СписокВыбора.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокРегистров() Цикл
		Элемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьИзменение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ВыполнитьИзменение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИзменение()
	
	ДлительнаяОперация = НачатьИзменение();
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДлительнаяОперация.ИнформацияОбОшибке);
		ЗаписатьОшибкуВЖурнал(ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ВыполняетсяОбработка = Истина;
	Прогресс = 0;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ИзменениеЗавершено", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеЗавершено(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняетсяОбработка = Ложь;
	Прогресс = 100;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(Результат.ИнформацияОбОшибке);
		ЗаписатьОшибкуВЖурнал(ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОбновитьПослеИзменения();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОшибкуВЖурнал(ТекстОшибки)
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Групповое изменение записей регистров сведений'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		,
		ТекстОшибки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРегистров()
	
	Элементы.ПолеИмяРегистра.СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из СписокРегистров() Цикл
		Элементы.ПолеИмяРегистра.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокРегистров()
	
	Результат = Новый СписокЗначений;
	
	Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
		Результат.Добавить(Регистр.ПолноеИмя(), Регистр.Представление());
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоляРегистра()
	
	ПоляРегистра.Очистить();
	УсловияОтбора.Очистить();
	ПредставлениеРегистра = "";
	
	ОбработкаОбъект = Обработки.ГКСК_ГрупповоеИзменениеЗаписейРегистров.Создать();
	СписокПолей = ОбработкаОбъект.ПоляРегистра(ИмяРегистра);
	ПредставлениеРегистра = ОбработкаОбъект.ПредставлениеРегистра(ИмяРегистра);
	
	Для Каждого Описание Из СписокПолей Цикл
		Строка = ПоляРегистра.Добавить();
		Строка.Имя = Описание.Имя;
		Строка.Представление = Описание.Представление;
		Строка.ВидПоля = Описание.ВидПоля;
		Строка.Изменять = Ложь;
	КонецЦикла;
	
	ЗаполнитьСписокПолейОтбора(СписокПолей);
	ЗаполнитьСписокСравнений();
	ДобавитьУсловиеСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПолейОтбора(СписокПолей)
	
	Элементы.КолонкаОтбораИмяПоля.СписокВыбора.Очистить();
	
	Для Каждого Описание Из СписокПолей Цикл
		Элементы.КолонкаОтбораИмяПоля.СписокВыбора.Добавить(Описание.Имя, Описание.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗаписиРегистра()
	
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбработкаОбъект = Обработки.ГКСК_ГрупповоеИзменениеЗаписейРегистров.Создать();
	
	ПараметрыВыборки = Новый Структура;
	ПараметрыВыборки.Вставить("ИмяРегистра", ИмяРегистра);
	ПараметрыВыборки.Вставить("УсловияОтбора", УсловияОтбораВыгрузить());
	
	ПараметрыСписка = ОбработкаОбъект.ПараметрыДинамическогоСписка(ПараметрыВыборки);
	Если ПустаяСтрока(ПараметрыСписка.ТекстЗапроса) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗаписиРегистра.ТекстЗапроса = ПараметрыСписка.ТекстЗапроса;
	
	// В запросе динамического списка не поддерживаются ПЕРВЫЕ и УПОРЯДОЧИТЬ:
	// порциями и порядком управляет компоновка данных.
	
	Для Каждого Элемент Из ПараметрыСписка.ПараметрыЗапроса Цикл
		ЗаписиРегистра.Параметры.УстановитьЗначениеПараметра(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ПересоздатьКолонкиСписка(ПараметрыСписка.ИменаПолей);
	Элементы.ТаблицаЗаписей.Обновить();
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПересоздатьКолонкиСписка(ИменаПолей)
	
	Удаляемые = Новый Массив;
	Для Каждого Элемент Из Элементы.ТаблицаЗаписей.ПодчиненныеЭлементы Цикл
		Если СтрНачинаетсяС(Элемент.Имя, "КолонкаСписка") Тогда
			Удаляемые.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из Удаляемые Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		НоваяКолонка = Элементы.Добавить("КолонкаСписка" + ИмяПоля, Тип("ПолеФормы"), Элементы.ТаблицаЗаписей);
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным = "ЗаписиРегистра." + ИмяПоля;
		НоваяКолонка.Заголовок = ИмяПоля;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьОтмеченныеЗаписи()
	
	ОтмеченныеЗаписи.Очистить();
	
КонецПроцедуры

&НаСервере
Функция ЕстьОтмеченныеЗаписи()
	
	Возврат ОтмеченныеЗаписи.Количество() > 0;
	
КонецФункции

&НаСервере
Функция КлючевыеПоляРегистра()
	
	ОбработкаОбъект = Обработки.ГКСК_ГрупповоеИзменениеЗаписейРегистров.Создать();
	Возврат ОбработкаОбъект.КлючевыеПоля(ИмяРегистра);
	
КонецФункции

&НаСервере
Процедура ДобавитьВОтмеченные(Записи)
	
	ОписанияКлюча = КлючевыеПоляРегистра();
	
	Для Каждого Запись Из Записи Цикл
		
		КлючЗаписи = ЗначениеВСтрокуВнутр(Запись);
		Если НайтиОтмеченнуюЗапись(КлючЗаписи) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ОтмеченныеЗаписи.Добавить();
		НоваяСтрока.Ключ = КлючЗаписи;
		НоваяСтрока.Представление = ПредставлениеОтмеченнойЗаписи(Запись, ОписанияКлюча);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиОтмеченнуюЗапись(КлючЗаписи)
	
	Для Каждого Строка Из ОтмеченныеЗаписи Цикл
		Если Строка.Ключ = КлючЗаписи Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПредставлениеОтмеченнойЗаписи(Запись, ОписанияКлюча)
	
	Части = Новый Массив;
	Для Каждого Описание Из ОписанияКлюча Цикл
		Части.Добавить(Описание.Имя + "=" + Строка(Запись[Описание.Имя]));
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "; ");
	
КонецФункции

&НаСервере
Функция ОтмеченныеЗаписиВыгрузить()
	
	Результат = Новый Массив;
	
	Для Каждого Строка Из ОтмеченныеЗаписи Цикл
		Результат.Добавить(ЗначениеИзСтрокиВнутр(Строка.Ключ));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокСравнений()
	
	Список = Элементы.КолонкаОтбораВидСравнения.СписокВыбора;
	Список.Очистить();
	Список.Добавить("Равно", НСтр("ru = 'Равно'"));
	Список.Добавить("НеРавно", НСтр("ru = 'Не равно'"));
	Список.Добавить("Больше", НСтр("ru = 'Больше'"));
	Список.Добавить("БольшеИлиРавно", НСтр("ru = 'Больше или равно'"));
	Список.Добавить("Меньше", НСтр("ru = 'Меньше'"));
	Список.Добавить("МеньшеИлиРавно", НСтр("ru = 'Меньше или равно'"));
	Список.Добавить("Содержит", НСтр("ru = 'Содержит'"));
	Список.Добавить("НачинаетсяС", НСтр("ru = 'Начинается с'"));
	Список.Добавить("Заполнено", НСтр("ru = 'Заполнено'"));
	Список.Добавить("НеЗаполнено", НСтр("ru = 'Не заполнено'"));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловиеСервер()
	
	Строка = УсловияОтбора.Добавить();
	Строка.ВидСравнения = "Равно";
	
КонецПроцедуры

&НаСервере
Процедура УдалитьУсловиеСервер()
	
	Если УсловияОтбора.Количество() > 0 Тогда
		УсловияОтбора.Удалить(УсловияОтбора.Количество() - 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕстьИзменяемыеПоля()
	
	Для Каждого Строка Из ПоляРегистра Цикл
		Если Строка.Изменять И Строка.ВидПоля <> "Регистратор" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ЭтоРегистрПодчиненныйРегистратору()
	
	ОбработкаОбъект = Обработки.ГКСК_ГрупповоеИзменениеЗаписейРегистров.Создать();
	Возврат ОбработкаОбъект.ЭтоРегистрПодчиненныйРегистратору(ИмяРегистра);
	
КонецФункции

&НаСервере
Функция НачатьИзменение()
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяРегистра", ИмяРегистра);
	ПараметрыЗадания.Вставить("Записи", ОтмеченныеЗаписиВыгрузить());
	ПараметрыЗадания.Вставить("ИзменяемыеПоля", ИзменяемыеПоляВыгрузить());
	ПараметрыЗадания.Вставить("Замещать", Замещать);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'Групповое изменение записей регистров сведений'");
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработка.ГКСК_ГрупповоеИзменениеЗаписейРегистров.МодульОбъекта.ВыполнитьИзменениеЗаписей",
		ПараметрыЗадания, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция УсловияОтбораВыгрузить()
	
	Результат = Новый Массив;
	
	Для Каждого Строка Из УсловияОтбора Цикл
		Если ПустаяСтрока(Строка.ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("ИмяПоля", Строка.ИмяПоля);
		Описание.Вставить("ВидСравнения", Строка.ВидСравнения);
		Описание.Вставить("Значение", Строка.Значение);
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИзменяемыеПоляВыгрузить()
	
	Результат = Новый Массив;
	
	Для Каждого Строка Из ПоляРегистра Цикл
		Если Не Строка.Изменять Или Строка.ВидПоля = "Регистратор" Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("Имя", Строка.Имя);
		Описание.Вставить("Значение", Строка.Значение);
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьПослеИзменения()
	
	ОбновитьОтмеченныеЗаписи();
	Элементы.ТаблицаЗаписей.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтмеченныеЗаписи()
	
	Если ОтмеченныеЗаписи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписанияКлюча = КлючевыеПоляРегистра();
	ИзменяемыеПоля = ИзменяемыеПоляВыгрузить();
	
	Обновленные = Новый Массив;
	УжеЕсть = Новый Соответствие;
	
	Для Каждого Строка Из ОтмеченныеЗаписи Цикл
		
		Ключ = ЗначениеИзСтрокиВнутр(Строка.Ключ);
		Для Каждого Изменение Из ИзменяемыеПоля Цикл
			Если Ключ.Свойство(Изменение.Имя) Тогда
				Ключ.Вставить(Изменение.Имя, Изменение.Значение);
			КонецЕсли;
		КонецЦикла;
		
		КлючСтрокой = ЗначениеВСтрокуВнутр(Ключ);
		Если УжеЕсть.Получить(КлючСтрокой) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть.Вставить(КлючСтрокой, Истина);
		
		Описание = Новый Структура;
		Описание.Вставить("Ключ", КлючСтрокой);
		Описание.Вставить("Представление", ПредставлениеОтмеченнойЗаписи(Ключ, ОписанияКлюча));
		Обновленные.Добавить(Описание);
		
	КонецЦикла;
	
	ОтмеченныеЗаписи.Очистить();
	
	Для Каждого Описание Из Обновленные Цикл
		НоваяСтрока = ОтмеченныеЗаписи.Добавить();
		НоваяСтрока.Ключ = Описание.Ключ;
		НоваяСтрока.Представление = Описание.Представление;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
