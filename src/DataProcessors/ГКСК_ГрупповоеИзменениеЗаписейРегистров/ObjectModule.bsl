#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполняет групповое изменение записей регистра сведений в фоновом задании.
//
// Параметры:
//   Параметры - Структура - параметры изменения:
//     * ИмяРегистра - Строка - полное имя регистра сведений;
//     * УсловияОтбора - Массив из Структура - условия отбора (ИмяПоля, ВидСравнения, Значение);
//     * ИзменяемыеПоля - Массив из Структура - изменяемые поля (Имя, Значение);
//     * Замещать - Булево - замещать существующие записи.
//   АдресРезультата - Строка - адрес временного хранилища для таблицы результата.
//
Процедура ВыполнитьИзменениеЗаписей(Параметры, АдресРезультата) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Запись", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка"));
	
	Попытка
		ВыполнитьИзменениеЗаписейВнутренне(Параметры, Результат);
	Исключение
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.Запись = НСтр("ru = 'Обработка прервана'");
		СтрокаРезультата.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

// Возвращает описание полей регистра сведений для выбора в форме.
//
// Параметры:
//   ИмяРегистра - Строка - полное имя регистра сведений.
//
// Возвращаемое значение:
//   Массив из Структура - описание полей (Имя, Представление, ВидПоля).
//
Функция ПоляРегистра(ИмяРегистра) Экспорт
	
	Результат = Новый Массив;
	
	Регистр = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
	Если Регистр = Неопределено Или Не Метаданные.РегистрыСведений.Содержит(Регистр) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоПодчиненныйРегистратору(Регистр) Тогда
		Результат.Добавить(ОписаниеПоля("Регистратор", НСтр("ru = 'Регистратор'"), "Регистратор"));
	КонецЕсли;
	
	Если ЭтоПериодический(Регистр) Тогда
		Результат.Добавить(ОписаниеПоля("Период", НСтр("ru = 'Период'"), "Период"));
	КонецЕсли;
	
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Результат.Добавить(ОписаниеПоля(Измерение.Имя, Измерение.Представление(), "Измерение"));
	КонецЦикла;
	
	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Результат.Добавить(ОписаниеПоля(Ресурс.Имя, Ресурс.Представление(), "Ресурс"));
	КонецЦикла;
	
	Для Каждого Реквизит Из Регистр.Реквизиты Цикл
		Результат.Добавить(ОписаниеПоля(Реквизит.Имя, Реквизит.Представление(), "Реквизит"));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление регистра сведений по полному имени.
//
// Параметры:
//   ИмяРегистра - Строка - полное имя регистра сведений.
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеРегистра(ИмяРегистра) Экспорт
	
	Регистр = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
	Если Регистр = Неопределено Или Не Метаданные.РегистрыСведений.Содержит(Регистр) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Регистр.Представление();
	
КонецФункции

// Возвращает признак того, что регистр сведений подчинён регистратору.
//
// Параметры:
//   ИмяРегистра - Строка - полное имя регистра сведений.
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоРегистрПодчиненныйРегистратору(ИмяРегистра) Экспорт
	
	Регистр = Метаданные.НайтиПоПолномуИмени(ИмяРегистра);
	Если Регистр = Неопределено Или Не Метаданные.РегистрыСведений.Содержит(Регистр) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЭтоПодчиненныйРегистратору(Регистр);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеПоля(Имя, Представление, ВидПоля)
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Представление", ?(ПустаяСтрока(Представление), Имя, Представление));
	Результат.Вставить("ВидПоля", ВидПоля);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПодчиненныйРегистратору(Регистр)
	
	Возврат Регистр.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
	
КонецФункции

Функция ЭтоПериодический(Регистр)
	
	Возврат Регистр.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;
	
КонецФункции

Процедура ВыполнитьИзменениеЗаписейВнутренне(Параметры, Результат)
	
	Регистр = Метаданные.НайтиПоПолномуИмени(Параметры.ИмяРегистра);
	Если Регистр = Неопределено Или Не Метаданные.РегистрыСведений.Содержит(Регистр) Тогда
		ВызватьИсключение НСтр("ru = 'Регистр сведений не найден.'");
	КонецЕсли;
	
	ПодчиненРегистратору = ЭтоПодчиненныйРегистратору(Регистр);
	Периодический = ЭтоПериодический(Регистр);
	
	КлючевыеПоля = Новый Массив;
	Если ПодчиненРегистратору Тогда
		КлючевыеПоля.Добавить("Регистратор");
	КонецЕсли;
	Если Периодический Тогда
		КлючевыеПоля.Добавить("Период");
	КонецЕсли;
	Для Каждого Измерение Из Регистр.Измерения Цикл
		КлючевыеПоля.Добавить(Измерение.Имя);
	КонецЦикла;
	
	ИменаПолей = ИменаПолейРегистра(Регистр);
	
	ПараметрыЗапроса = Новый Структура;
	ТекстЗапроса = ТекстЗапроса(Регистр, Параметры.УсловияОтбора, ИменаПолей, ПараметрыЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого Элемент Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	МенеджерРегистра = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Регистр.ПолноеИмя());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтарыеЗначения = Новый Структура;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			СтарыеЗначения.Вставить(ИмяПоля, ЗначениеПоля(Регистр, ИмяПоля, Выборка[ИмяПоля]));
		КонецЦикла;
		
		НовыеЗначения = Новый Структура;
		Для Каждого Элемент Из СтарыеЗначения Цикл
			НовыеЗначения.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
		Для Каждого Изменение Из Параметры.ИзменяемыеПоля Цикл
			Если Изменение.Имя = "Регистратор" Тогда
				Продолжить;
			КонецЕсли;
			НовыеЗначения.Вставить(Изменение.Имя,
				ПривестиЗначениеКПолю(Регистр, Изменение.Имя, Изменение.Значение));
		КонецЦикла;
		
		КлючИзменился = Ложь;
		Для Каждого ИмяПоля Из КлючевыеПоля Цикл
			Если СтарыеЗначения[ИмяПоля] <> НовыеЗначения[ИмяПоля] Тогда
				КлючИзменился = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ПредставлениеЗаписи = ПредставлениеКлюча(КлючевыеПоля, СтарыеЗначения);
		
		Попытка
			Если ПодчиненРегистратору Тогда
				ИзменитьЗаписьПодчиненногоРегистра(МенеджерРегистра, Регистр, КлючевыеПоля,
					СтарыеЗначения, НовыеЗначения, Параметры.ИзменяемыеПоля);
			Иначе
				ИзменитьЗаписьНезависимогоРегистра(МенеджерРегистра, Регистр, КлючевыеПоля,
					СтарыеЗначения, НовыеЗначения, КлючИзменился, Параметры.Замещать);
			КонецЕсли;
		Исключение
			СтрокаРезультата = Результат.Добавить();
			СтрокаРезультата.Запись = ПредставлениеЗаписи;
			СтрокаРезультата.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИменаПолейРегистра(Регистр)
	
	Результат = Новый Массив;
	
	Если ЭтоПодчиненныйРегистратору(Регистр) Тогда
		Результат.Добавить("Регистратор");
	КонецЕсли;
	Если ЭтоПериодический(Регистр) Тогда
		Результат.Добавить("Период");
	КонецЕсли;
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Результат.Добавить(Измерение.Имя);
	КонецЦикла;
	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Результат.Добавить(Ресурс.Имя);
	КонецЦикла;
	Для Каждого Реквизит Из Регистр.Реквизиты Цикл
		Результат.Добавить(Реквизит.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеПоля(Регистр, ИмяПоля, Значение)
	
	Если Значение <> NULL Тогда
		Возврат Значение;
	КонецЕсли;
	
	Описание = ОписаниеТипаПоля(Регистр, ИмяПоля);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Описание.ПривестиЗначение(Неопределено);
	
КонецФункции

Функция ПривестиЗначениеКПолю(Регистр, ИмяПоля, Значение)
	
	Описание = ОписаниеТипаПоля(Регистр, ИмяПоля);
	Если Описание = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если Значение = Неопределено Тогда
		Возврат Описание.ПривестиЗначение(Неопределено);
	КонецЕсли;
	
	Попытка
		Возврат Описание.ПривестиЗначение(Значение);
	Исключение
		Возврат Значение;
	КонецПопытки;
	
КонецФункции

Функция ОписаниеТипаПоля(Регистр, ИмяПоля)
	
	Если ИмяПоля = "Период" Тогда
		Возврат Новый ОписаниеТипов("Дата");
	КонецЕсли;
	
	Для Каждого Измерение Из Регистр.Измерения Цикл
		Если Измерение.Имя = ИмяПоля Тогда
			Возврат Измерение.Тип;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Если Ресурс.Имя = ИмяПоля Тогда
			Возврат Ресурс.Тип;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из Регистр.Реквизиты Цикл
		Если Реквизит.Имя = ИмяПоля Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ТекстЗапроса(Регистр, УсловияОтбора, ИменаПолей, ПараметрыЗапроса)
	
	Поля = Новый Массив;
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Поля.Добавить("Т." + ИмяПоля + " КАК " + ИмяПоля);
	КонецЦикла;
	
	Текст = "ВЫБРАТЬ" + Символы.ПС
		+ СтрСоединить(Поля, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ " + Регистр.ПолноеИмя() + " КАК Т";
	
	Условия = Новый Массив;
	Индекс = 0;
	Для Каждого Условие Из УсловияОтбора Цикл
		Если ПустаяСтрока(Условие.ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если ИменаПолей.Найти(Условие.ИмяПоля) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Условие.ВидСравнения = "Заполнено" Или Условие.ВидСравнения = "НеЗаполнено" Тогда
			Условия.Добавить(ВыражениеУсловия(Условие.ИмяПоля, Условие.ВидСравнения, ""));
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		ИмяПараметра = "П" + Индекс;
		ПараметрыЗапроса.Вставить(ИмяПараметра, Условие.Значение);
		Условия.Добавить(ВыражениеУсловия(Условие.ИмяПоля, Условие.ВидСравнения, ИмяПараметра));
	КонецЦикла;
	
	Если Условия.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + "  И ");
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ВыражениеУсловия(ИмяПоля, ВидСравнения, ИмяПараметра)
	
	Поле = "Т." + ИмяПоля;
	
	Если ВидСравнения = "Равно" Тогда
		Возврат Поле + " = &" + ИмяПараметра;
	ИначеЕсли ВидСравнения = "НеРавно" Тогда
		Возврат Поле + " <> &" + ИмяПараметра;
	ИначеЕсли ВидСравнения = "Больше" Тогда
		Возврат Поле + " > &" + ИмяПараметра;
	ИначеЕсли ВидСравнения = "БольшеИлиРавно" Тогда
		Возврат Поле + " >= &" + ИмяПараметра;
	ИначеЕсли ВидСравнения = "Меньше" Тогда
		Возврат Поле + " < &" + ИмяПараметра;
	ИначеЕсли ВидСравнения = "МеньшеИлиРавно" Тогда
		Возврат Поле + " <= &" + ИмяПараметра;
	ИначеЕсли ВидСравнения = "Содержит" Тогда
		Возврат Поле + " ПОДОБНО ""%"" + &" + ИмяПараметра + " + ""%""";
	ИначеЕсли ВидСравнения = "НачинаетсяС" Тогда
		Возврат Поле + " ПОДОБНО &" + ИмяПараметра + " + ""%""";
	ИначеЕсли ВидСравнения = "Заполнено" Тогда
		Возврат Поле + " ЕСТЬ НЕ NULL";
	ИначеЕсли ВидСравнения = "НеЗаполнено" Тогда
		Возврат Поле + " ЕСТЬ NULL";
	КонецЕсли;
	
	Возврат Поле + " = &" + ИмяПараметра;
	
КонецФункции

Функция ПредставлениеКлюча(КлючевыеПоля, Значения)
	
	Части = Новый Массив;
	Для Каждого ИмяПоля Из КлючевыеПоля Цикл
		Части.Добавить(ИмяПоля + "=" + Строка(Значения[ИмяПоля]));
	КонецЦикла;
	
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

Процедура ЗаполнитьКлючЗаписи(МенеджерЗаписи, Регистр, КлючевыеПоля, Значения)
	
	Для Каждого ИмяПоля Из КлючевыеПоля Цикл
		МенеджерЗаписи[ИмяПоля] = Значения[ИмяПоля];
	КонецЦикла;
	
КонецПроцедуры

Процедура ИзменитьЗаписьНезависимогоРегистра(МенеджерРегистра, Регистр, КлючевыеПоля,
	СтарыеЗначения, НовыеЗначения, КлючИзменился, Замещать)
	
	НачатьТранзакцию();
	Попытка
		
		Если КлючИзменился Тогда
			
			МенеджерНовый = МенеджерРегистра.СоздатьМенеджерЗаписи();
			ЗаполнитьКлючЗаписи(МенеджерНовый, Регистр, КлючевыеПоля, НовыеЗначения);
			МенеджерНовый.Прочитать();
			Если МенеджерНовый.Выбран() Тогда
				ВызватьИсключение НСтр("ru = 'Запись с новыми значениями измерений уже существует.'");
			КонецЕсли;
			
			МенеджерСтарый = МенеджерРегистра.СоздатьМенеджерЗаписи();
			ЗаполнитьКлючЗаписи(МенеджерСтарый, Регистр, КлючевыеПоля, СтарыеЗначения);
			МенеджерСтарый.Прочитать();
			Если Не МенеджерСтарый.Выбран() Тогда
				ВызватьИсключение НСтр("ru = 'Запись не найдена.'");
			КонецЕсли;
			МенеджерСтарый.Удалить();
			
			МенеджерНовый = МенеджерРегистра.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерНовый, НовыеЗначения);
			МенеджерНовый.Записать(Истина);
			
		Иначе
			
			МенеджерЗаписи = МенеджерРегистра.СоздатьМенеджерЗаписи();
			ЗаполнитьКлючЗаписи(МенеджерЗаписи, Регистр, КлючевыеПоля, СтарыеЗначения);
			МенеджерЗаписи.Прочитать();
			Если Не МенеджерЗаписи.Выбран() Тогда
				ВызватьИсключение НСтр("ru = 'Запись не найдена.'");
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, НовыеЗначения);
			МенеджерЗаписи.Записать(Замещать);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ИзменитьЗаписьПодчиненногоРегистра(МенеджерРегистра, Регистр, КлючевыеПоля,
	СтарыеЗначения, НовыеЗначения, ИзменяемыеПоля)
	
	НачатьТранзакцию();
	Попытка
		
		НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СтарыеЗначения.Регистратор);
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Прочитать();
		
		Найдена = Ложь;
		Для Каждого Запись Из НаборЗаписей Цикл
			Если КлючиРавны(Запись, КлючевыеПоля, СтарыеЗначения) Тогда
				Для Каждого Изменение Из ИзменяемыеПоля Цикл
					Если Изменение.Имя = "Регистратор" Тогда
						Продолжить;
					КонецЕсли;
					Запись[Изменение.Имя] = ПривестиЗначениеКПолю(Регистр, Изменение.Имя, Изменение.Значение);
				КонецЦикла;
				Найдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не Найдена Тогда
			ВызватьИсключение НСтр("ru = 'Запись не найдена в наборе записей регистратора.'");
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция КлючиРавны(Запись, КлючевыеПоля, Значения)
	
	Для Каждого ИмяПоля Из КлючевыеПоля Цикл
		Если Запись[ИмяПоля] <> Значения[ИмяПоля] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

