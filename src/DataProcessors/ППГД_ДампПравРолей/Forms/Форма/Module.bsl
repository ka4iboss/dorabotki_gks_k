#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокРолейИсключения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	
	КаталогВыгрузки = СокрЛП(Объект.КаталогВыгрузки);
	Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог выгрузки.'"));
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = НачатьВыгрузкуНаСервере(КаталогВыгрузки);
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(ДлительнаяОперация.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Выгрузка прав ролей'");
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Формируются файлы с правами ролей...'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ВыгрузкаЗавершена", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокРолейИсключения()
	
	СписокРолиИсключения.Очистить();
	
	ИменаРолей = Новый Массив;
	
	Для Каждого Роль Из Метаданные.ОсновныеРоли Цикл
		ИменаРолей.Добавить("Роль." + Роль.Имя);
	КонецЦикла;
	
	ИменаРолей.Добавить("Роль.УдаленныйДоступOData");
	
	Попытка
		НазначениеРолей = Пользователи.НазначениеРолей();
		Для Каждого ИмяРоли Из НазначениеРолей.ТолькоДляАдминистраторовСистемы Цикл
			ИменаРолей.Добавить("Роль." + ИмяРоли);
		КонецЦикла;
		Для Каждого ИмяРоли Из НазначениеРолей.ТолькоДляВнешнихПользователей Цикл
			ИменаРолей.Добавить("Роль." + ИмяРоли);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Выгрузка прав ролей.Получение назначения ролей'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;
	
	ИменаРолей = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ИменаРолей);
	Идентификаторы = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ИменаРолей);
	
	Для Каждого Элемент Из Идентификаторы Цикл
		СписокРолиИсключения.Добавить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НачатьВыгрузкуНаСервере(Знач КаталогВыгрузки)
	
	ИсключаемыеРоли = Новый Массив;
	
	Для Каждого ЭлементСписка Из СписокРолиИсключения Цикл
		ИсключаемыеРоли.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Выгрузка прав ролей'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ППГД_ДампПравРолейСервер.ВыгрузитьПраваРолей",
		КаталогВыгрузки,
		ИсключаемыеРоли);
	
КонецФункции

&НаКлиенте
Процедура ВыгрузкаЗавершена(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ИтогиВыгрузки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ШаблонСообщения = НСтр("ru = 'Выгрузка завершена. Объектов: %1, подсистем: %2, файлов: %3.'");
	ПоказатьОповещениеПользователя(СтрШаблон(ШаблонСообщения, ИтогиВыгрузки.Объектов,
		ИтогиВыгрузки.Подсистем, ИтогиВыгрузки.Файлов));
	
КонецПроцедуры

#КонецОбласти
