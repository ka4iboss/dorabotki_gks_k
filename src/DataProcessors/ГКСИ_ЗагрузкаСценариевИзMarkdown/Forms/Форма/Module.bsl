// Модуль основной формы обработки ГКСИ_ЗагрузкаСценариевИзMarkdown.
//
// Сценарий работы:
//   1. ВыбратьФайл — открыть диалог выбора файла, поместить его на сервер.
//   2. ЗагрузитьФайл — прочитать содержимое, разобрать Markdown в дерево (на сервере).
//   3. ПроверитьКонфликты — найти существующие элементы с теми же именами.
//      Если есть совпадения — открыть форму разрешения конфликтов.
//   4. ВыполнитьЗагрузку — записать новые/обновлённые элементы в справочник.
//
// Элементы формы (поля, кнопки в группе) заданы статически в Form.form.
//
// Решение по выбору группы в поле «Инструкция-источник» (CatalogRef):
// Для штатных реквизитов типа Parent иерархического справочника платформа сама
// применяет правила выбора групп. Для пользовательского реквизита — нет.
// Программная установка свойства ВыборГруппИЭлементов в EDT невозможна
// (тип свойства неоднозначен для разных контекстов, runtime «Несоответствие типов»
// для ГруппыИЭлементы / ИспользованиеГруппИЭлементов / Булево). Поэтому
// в обработчике НачалоВыбора → клиентский ГКСИ_ИнструкцияИсточникПолеНачалоВыбора
// форма выбора открывается с параметром ВыборГруппИЭлементов.

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Открывает форму выбора с параметром ВыборГруппИЭлементов, чтобы
// пользователь мог выбрать группу-корень инструкции. Без этого поле
// ввода иерархического справочника для пользовательского реквизита
// по умолчанию предлагает только элементы.
//
// Параметры:
//  Элемент             - FormField - поле формы, для которого сработал обработчик.
//  ДанныеВыбора        - Неопределено - в данном обработчике не используется.
//  СтандартнаяОбработка - Булево - если Истина, платформа сама откроет форму выбора.
//                                  Принудительно устанавливаем Ложь, чтобы открыть
//                                  форму с параметром ВыборГруппИЭлементов.
&НаКлиенте
Процедура ГКСИ_ИнструкцияИсточникПолеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыборГруппИЭлементов",
		ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("РасширенныйПоиск", Истина);

	Оповещение = Новый ОписаниеОповещения(
		"ГКСИ_ИнструкцияИсточникЗавершениеВыбора", ЭтотОбъект);

	ОткрытьФорму("Справочник.ДемонстрационныеСценарии.Форма.ГКСИ_ФормаВыбораГруппы",
		ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды ВыбратьФайл: открывает диалог выбора и помещает файл
// на сервер во временное хранилище.
// Использует современное асинхронное API (ПоместитьФайлыНаСерверАсинх
// с вариантом диалога выбора файлов).
// Результат — массив объектов ОписаниеПомещенногоФайла
// (свойства: Адрес, СсылкаНаФайл, ПомещениеФайлаОтменено).
//@skip-warning
&НаКлиенте
Асинх Процедура ВыбратьФайл(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр(
		"ru = 'Выберите файл Markdown и относящиеся к нему картинки'");
	Диалог.Фильтр =
		"Markdown и картинки|*.md;*.png;*.jpg;*.jpeg;*.gif;*.webp;*.bmp"
		+ "|Markdown|*.md"
		+ "|Изображения|*.png;*.jpg;*.jpeg;*.gif;*.webp;*.bmp"
		+ "|Все файлы|*.*";
	Диалог.ИндексФильтра = 0;
	Диалог.МножественныйВыбор = Истина;
	Диалог.ПредварительныйПросмотр = Истина;

	РезультатВыбора = Ждать Диалог.ВыбратьАсинх();
	Если РезультатВыбора = Неопределено
		ИЛИ РезультатВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Сформировать описания файлов для передачи на сервер через ВХ.
	ОписанияФайлов = Новый Массив;
	Для Каждого ПолноеИмяФайла Из РезультатВыбора Цикл
		Описание = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, "");
		ОписанияФайлов.Добавить(Описание);
	КонецЦикла;

	РезультатыПомещения = Ждать ПоместитьФайлыНаСерверАсинх(, , ОписанияФайлов,
		УникальныйИдентификатор);

	Если РезультатыПомещения = Неопределено
		ИЛИ РезультатыПомещения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Собираем структуру: Имя -> Адрес, разделяя .md и картинки.
	// Параллельно запоминаем полный путь к .md, чтобы на сервере вычислить
	// родительский каталог и подставить его в КаталогПоиска для поиска
	// картинок на диске рядом с .md. Полный путь берём из РезультатВыбора
	// (это массив полных путей, которые вернул диалог выбора файла),
	// матчим по конечной части пути после последнего слеша — иначе сравнение
	// ломается на file:///C:/... и URL-encoded вариантах.
	АдресаФайлов = Новый Соответствие;
	ПолныйПутьКФайлу = "";
	Для Каждого Описание Из РезультатыПомещения Цикл
		Если Описание.ПомещениеФайлаОтменено
			ИЛИ Описание.Адрес = Неопределено
			ИЛИ Описание.СсылкаНаФайл = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяФайлаИзОписания = Описание.СсылкаНаФайл.Имя;
		АдресаФайлов.Вставить(ИмяФайлаИзОписания, Описание.Адрес);
		ПозицияТочки = СтрНайти(ИмяФайлаИзОписания, ".", НаправлениеПоиска.СКонца);
		Расширение = ?(ПозицияТочки = 0, "",
			НРег(Сред(ИмяФайлаИзОписания, ПозицияТочки)));
		Если Расширение = ".md" И НЕ ЗначениеЗаполнено(ПолныйПутьКФайлу) Тогда
			ИмяФайлаНижний = НРег(ИмяФайлаИзОписания);
			Для Каждого ПолноеИмя Из РезультатВыбора Цикл
				НормализованныйПуть = СтрЗаменить(ПолноеИмя, "/", "\");
				ПозицияСлеша = СтрНайти(НормализованныйПуть, "\", НаправлениеПоиска.СКонца);
				ИмяФайлаИзПолногоПути = ?(ПозицияСлеша > 0,
					Сред(НормализованныйПуть, ПозицияСлеша + 1),
					НормализованныйПуть);
				Если НРег(ИмяФайлаИзПолногоПути) = ИмяФайлаНижний Тогда
					ПолныйПутьКФайлу = ПолноеИмя;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	ЗагрузитьФайлИКартинкиНаСервере(АдресаФайлов, ПолныйПутьКФайлу);

КонецПроцедуры

// Обработчик команды ЗагрузитьФайл: вызывает серверную процедуру парсинга.
//@skip-warning
&НаКлиенте
Процедура ЗагрузитьФайл(Команда)

	Если НЕ ЗначениеЗаполнено(АдресФайлаВоВременномХранилище) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала выберите файл.'"));
		Возврат;
	КонецЕсли;

	ЗагрузитьФайлНаСервере(АдресФайлаВоВременномХранилище);

КонецПроцедуры

// Обработчик команды ПроверитьКонфликты.
//
// Сервисный обработчик для обратной совместимости и тестов.
// Кнопка скрыта в Form.form, но метод и команда оставлены.
// ВАЖНО: передаём УИД основной формы в открываемую форму, чтобы та
// могла прочитать массив конфликтов из ВХ по тому же ключу.
//@skip-warning
&НаКлиенте
Процедура ПроверитьКонфликты(Команда)

	Если НЕ ЗначениеЗаполнено(АдресДереваУзлов) Тогда
		ПоказатьПредупреждение(, "Сначала загрузите файл.");
		Возврат;
	КонецЕсли;

	ДанныеФормы = ПодготовитьДанныеДляФормыКонфликтов();

	Если ДанныеФормы.КоличествоКонфликтов = 0 Тогда
		ПоказатьПредупреждение(, "Конфликтов не найдено. Можно выполнить загрузку.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	// Передаём массив структур напрямую — поля примитивны и CatalogRef,
	// сериализация через ПараметрыФормы работает без ВХ.
	ПараметрыФормы.Вставить("МассивКонфликтов", ДанныеФормы.МассивКонфликтов);

	Оповещение = Новый ОписаниеОповещения("ПослеРазрешенияКонфликтов", ЭтотОбъект);
	ОткрытьФорму("DataProcessor.ГКСИ_ЗагрузкаСценариевИзMarkdown.Form.ФормаРазрешенияКонфликтов",
		ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Серверная обёртка: получает массив конфликтов, помещает его во временное
// хранилище, привязанное к УИД основной формы. Возвращает адрес ВХ и счётчик.
//
// ВАЖНО (пакет D bugfix):
//  1. Адрес сохраняется в реквизит формы «АдресМассиваКонфликтовИзПоследнейПроверки».
//     Это переживает любые клиент-серверные вызовы и доступно из обработчиков
//     оповещения, в которые ПоказатьВыборЭлемента не прокидывает параметры.
//  2. УИД основной формы передаётся в форму разрешения конфликтов как
//     дополнительный параметр, чтобы та могла прочитать данные по тому же
//     ключу (без этого у формы разрешения другой УИД — данные ВХ недоступны).
// Серверная обёртка: получает массив конфликтов и возвращает его на клиент.
//
// ВАЖНО (пакет D bugfix):
//  1. Возвращаем массив напрямую — поля примитивны + CatalogRef, сериализация
//     между клиентом и сервером работает без ВХ и без ХранилищеЗначения.
//  2. Клиент сохраняет массив в реквизит формы «МассивКонфликтовИзПоследнейПроверки»
//     (тип Массив). Это переживает любые клиент-серверные вызовы и доступно
//     из обработчика ПослеВыбораДействияПоКонфликтам, в который
//     ПоказатьВыборЭлемента не прокидывает дополнительные параметры.
//  3. ХранилищеЗначения и ВХ в этой схеме НЕ используем:
//     - ХранилищеЗначения в реквизите формы платформа 8.3.27 запрещает;
//     - ВХ без УИД — адрес невалиден после возврата на клиент;
//     - ВХ с УИД — данные недоступны из другой формы без передачи УИД,
//       а УИД передавать через параметры формы неудобно и рискованно.
//@skip-warning
&НаСервере
Функция ПодготовитьДанныеДляФормыКонфликтов()

	МассивКонфликтов = ПроверитьКонфликтыНаСервере();

	Результат = Новый Структура;
	Результат.Вставить("МассивКонфликтов",   МассивКонфликтов);
	Результат.Вставить("КоличествоКонфликтов", МассивКонфликтов.Количество());

	Возврат Результат;

КонецФункции

// Обработчик команды ВыполнитьЗагрузку.
//
// Сценарий пакета D (версия 1.7):
//  1. Если файл ещё не загружен в дерево — предупреждение и выход.
//  2. На сервере собираются конфликты (через ПодготовитьДанныеДляФормыКонфликтов).
//  3. Если конфликтов нет — сразу запускаем фоновую запись.
//  4. Если есть — показываем меню из 3 пунктов:
//       «Разрешить конфликты…»         — открывает ФормаРазрешенияКонфликтов;
//       «Обновить все существующие»    — массовое действие «Обновить»;
//       «Пропустить все существующие»  — массовое действие «Пропустить».
//     После любого из вариантов запись стартует автоматически.
//
// Команда ПроверитьКонфликты (см. отдельную процедуру) скрыта в Form.form,
// но обработчик оставлен как сервисный для тестов и обратной совместимости.
//@skip-warning
&НаКлиенте
Процедура ВыполнитьЗагрузку(Команда)

	Если НЕ ЗначениеЗаполнено(АдресДереваУзлов) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала загрузите файл.'"));
		Возврат;
	КонецЕсли;

	ДанныеФормы = ПодготовитьДанныеДляФормыКонфликтов();

	Если ДанныеФормы.КоличествоКонфликтов = 0 Тогда
		ЗапуститьЗагрузкуСейчас();
		Возврат;
	КонецЕсли;

	ТекстЗаголовка = СтрШаблон(
		НСтр("ru = 'Найдено совпадений с существующими элементами: %1.'"),
		ДанныеФормы.КоличествоКонфликтов);
	ТекстПодсказки = НСтр("ru = 'Выберите массовое действие или откройте форму для индивидуального решения.'");

	СписокДействий = Новый СписокЗначений;
	СписокДействий.Добавить("Разрешить",     НСтр("ru = 'Разрешить конфликты…'"));
	СписокДействий.Добавить("ОбновитьВсе",   НСтр("ru = 'Обновить все существующие'"));
	СписокДействий.Добавить("ПропуститьВсе", НСтр("ru = 'Пропустить все существующие'"));

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("МассивКонфликтов", ДанныеФормы.МассивКонфликтов);
	Оповещение = Новый ОписаниеОповещения(
		"ПослеВыбораДействияПоКонфликтам", ЭтотОбъект, ДопПараметры);
	СписокДействий.ПоказатьВыборЭлемента(Оповещение,
		ТекстЗаголовка + Символы.ПС + ТекстПодсказки);

КонецПроцедуры

// Обработчик выбора каталога. Передаёт путь на сервер, получает список .md
// из корня каталога. Если файл один — сразу вызывает парсинг.
// Если несколько — пользователю показывается выбор.
// Если ни одного — сообщение об ошибке.
//@skip-warning
&НаКлиенте
Процедура ВыбратьКаталог(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Выберите каталог с Markdown-файлом и картинками'");
	Если НЕ ЗначениеЗаполнено(КаталогРесурсов) Тогда
		Диалог.Каталог = КаталогРесурсов;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораКаталога", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запускает запись дерева в фоновом задании через ДлительныеОперации.ВыполнитьВФоне
// и подключает обработчик ожидания для периодического обновления прогресса на клиенте.
//
// Используется как точка входа в пакет D (версия 1.7): вызывается из
// ВыполнитьЗагрузку (когда конфликтов нет), из ПослеВыбораДействияПоКонфликтам
// (для массовых действий) и из ПослеРазрешенияКонфликтов (после закрытия
// формы разрешения). Старый обработчик ПослеПодтвержденияЗагрузки,
// который жил для команды «Выполнить загрузку?» через ПоказатьВопрос,
// удалён вместе с этим диалогом.
//@skip-warning
&НаКлиенте
Процедура ЗапуститьЗагрузкуСейчас()

	// Запуск фонового задания. Адрес прогресса и адрес результата
	// инициализируются на сервере, возвращаются в виде структуры.
	// Третий параметр — адрес ВХ готовой карты подмен картинок
	// (результат предзагрузки через ПодготовитьФайлыИнструкций).
	// Если карта не заполнена (сценарий «выбрать каталог»),
	// фон сам соберёт карту через КаталогПоиска и/или АдресСоответствияКартинок.
	ДанныеЗапуска = ЗапуститьЗаписьДереваВФоне(
		АдресДереваУзлов,
		АдресРешенийВоВременномХранилище,
		АдресКартыФайлов,
		КаталогПоиска);

	Если ДанныеЗапуска = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗапуска.АдресПрогресса)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗапуска.АдресРезультатаЗагрузки)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗапуска.ИдентификаторЗадания) Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = НСтр("ru = 'Не удалось запустить загрузку'");
		Возврат;
	КонецЕсли;

	АдресПрогресса              = ДанныеЗапуска.АдресПрогресса;
	АдресРезультатаЗагрузки     = ДанныеЗапуска.АдресРезультатаЗагрузки;
	ИдентификаторЗадания        = ДанныеЗапуска.ИдентификаторЗадания;

	ТолькоПросмотр = Истина;
	ПроцентГотовности         = 0;
	ТекстПрогресса            = НСтр("ru = 'Запись сценариев запущена...'");

	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ЗавершениеФоновойЗагрузки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДанныеЗапуска.ДанныеФоновогоЗадания,
		ОповещениеОЗавершении,
		ПараметрыОжидания());

	// Параллельно запускаем лёгкий опрос прогресса через обработчик ожидания,
	// чтобы пользователь видел движение полосы и текущий узел.
	ПодключитьОбработчикОжидания("ОбработчикОжиданияПрогресса", 1, Ложь);

КонецПроцедуры

// Обработчик выбора пункта меню массового действия по конфликтам.
// Массив конфликтов приходит в ДопПараметры из ОписаниеОповещения,
// которое было создано в ВыполнитьЗагрузку.
//
//  "Разрешить"       — открывает ФормаРазрешенияКонфликтов (передаём массив
//                       в ПараметрыФормы напрямую).
//  "ОбновитьВсе"     — формирует Соответствие {ИмяИзФайла -> {Действие, Ссылка}}.
//  "ПропуститьВсе"   — формирует Соответствие {ИмяИзФайла -> {Действие, Ссылка}}.
//
// Параметры:
//   ВыбранныйЭлемент - Произвольный - выбранный пункт меню.
//   ДопПараметры - Произвольный - дополнительные параметры оповещения.
//@skip-warning
&НаКлиенте
Процедура ПослеВыбораДействияПоКонфликтам(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивКонфликтов = Неопределено;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		ДопПараметры.Свойство("МассивКонфликтов", МассивКонфликтов);
	КонецЕсли;
	Если МассивКонфликтов = Неопределено Тогда
		МассивКонфликтов = Новый Массив;
	КонецЕсли;

	Действие = ВыбранныйЭлемент.Значение;

	Если Действие = "Разрешить" Тогда
		ПараметрыФормы = Новый Структура;
		// Передаём массив напрямую через ПараметрыФормы — поля примитивны
		// и CatalogRef, сериализация между клиентом и сервером работает.
		ПараметрыФормы.Вставить("МассивКонфликтов", МассивКонфликтов);
		// Диагностика пакета D bugfix: фиксируем тип и размер массива
		// непосредственно перед ОткрытьФорму. Если запись не появится в ЖР —
		// выполнение не дошло до этой строки (например, сбой выше).
		// ЗаписьЖурналаРегистрации недоступна на клиенте — вызываем серверную
		// обёртку. Передаём только тип и размер (примитивы), чтобы не
		// дублировать сериализацию массива.
		ДиагностикаПередОткрытиемФормыРазрешения(
			ТипЗнч(МассивКонфликтов),
			?(ТипЗнч(МассивКонфликтов) = Тип("Массив"),
				МассивКонфликтов.Количество(), -1));
		Оповещение = Новый ОписаниеОповещения("ПослеРазрешенияКонфликтов", ЭтотОбъект);
		ОткрытьФорму("DataProcessor.ГКСИ_ЗагрузкаСценариевИзMarkdown.Form.ФормаРазрешенияКонфликтов",
			ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Возврат;
	КонецЕсли;

	МассовоеДействие = ?(Действие = "ОбновитьВсе", "Обновить", "Пропустить");
	//@skip-warning
	Решения = СформироватьРешенияПоВсемКонфликтам(МассивКонфликтов, МассовоеДействие);
	// ВАЖНО: адрес ВХ нужно сохранить в реквизит формы, иначе
	// ЗапуститьЗагрузкуСейчас прочитает старое/пустое значение и в фон
	// уйдёт пустое соответствие — обработка создаст всё заново вместо
	// применения массового решения.
	АдресРешенийВоВременномХранилище = ПоместитьВоВременноеХранилище(
		Решения, УникальныйИдентификатор);
	ЗапуститьЗагрузкуСейчас();

КонецПроцедуры

// Формирует Соответствие "ИмяИзФайла -> {Действие, Ссылка}" по всем конфликтам
// для массового применения. Используется, когда пользователь выбрал
// «Обновить все» или «Пропустить все» в меню массового действия.
//
// Контракт (пакет D bugfix): ключ — ИмяИзФайла (строка), значение — Структура
// с полями Действие и Ссылка. Совпадает с тем, что возвращает форма разрешения
// конфликтов, и с тем, что ожидает серверный ОбработатьУзелРекурсивно
// (РешенияПоКонфликтам.Получить(Узел.Наименование), .Действие / .Ссылка).
//
// Параметры:
//  АдресМассиваКонфликтов - Строка - адрес во временном хранилище, по которому
//                                   сервер должен прочитать массив.
//  Действие               - Строка - "Обновить" или "Пропустить".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -
//   Ключ: Строка (ИмяИзФайла),
//   Значение: Структура со свойствами Действие (Строка) и Ссылка (CatalogRef).
//@skip-warning
&НаСервере
Функция СформироватьРешенияПоВсемКонфликтамИзВХ(АдресМассиваКонфликтов, Действие)

	Решения = Новый Соответствие;

	Если НЕ ЗначениеЗаполнено(АдресМассиваКонфликтов) Тогда
		Возврат Решения;
	КонецЕсли;

	МассивКонфликтов = ПолучитьИзВременногоХранилища(АдресМассиваКонфликтов);
	Если ТипЗнч(МассивКонфликтов) <> Тип("Массив") Тогда
		Возврат Решения;
	КонецЕсли;

	Для Каждого ОписаниеКонфликта Из МассивКонфликтов Цикл
		Если НЕ ОписаниеКонфликта.Свойство("ИмяИзФайла") Тогда
			Продолжить;
		КонецЕсли;
		РешениеПоУзлу = Новый Структура;
		РешениеПоУзлу.Вставить("Действие", Действие);
		РешениеПоУзлу.Вставить("Ссылка",   ОписаниеКонфликта.СуществующаяСсылка);
		Решения.Вставить(ОписаниеКонфликта.ИмяИзФайла, РешениеПоУзлу);
	КонецЦикла;

	Возврат Решения;

КонецФункции

// Формирует Соответствие "ИмяИзФайла -> {Действие, Ссылка}" по всем конфликтам
// для массового применения. Используется, когда пользователь выбрал
// «Обновить все» или «Пропустить все» в меню массового действия.
//
// Контракт (пакет D bugfix): ключ — ИмяИзФайла (строка), значение — Структура
// с полями Действие и Ссылка. Совпадает с тем, что возвращает форма разрешения
// конфликтов, и с тем, что ожидает серверный ОбработатьУзелРекурсивно
// (РешенияПоКонфликтам.Получить(Узел.Наименование), .Действие / .Ссылка).
//
// Параметры:
//  МассивКонфликтов - Массив из Структура - уже собранный список конфликтов
//                      с полями ИмяИзФайла, СуществующаяСсылка, СуществующееЭтоГруппа.
//  Действие         - Строка - "Обновить" или "Пропустить".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -
//   Ключ: Строка (ИмяИзФайла),
//   Значение: Структура со свойствами Действие (Строка) и Ссылка (CatalogRef).
//@skip-warning
&НаСервере
Функция СформироватьРешенияПоВсемКонфликтам(МассивКонфликтов, Действие)

	Решения = Новый Соответствие;

	Если ТипЗнч(МассивКонфликтов) <> Тип("Массив") Тогда
		Возврат Решения;
	КонецЕсли;

	Для Каждого ОписаниеКонфликта Из МассивКонфликтов Цикл
		Если НЕ ОписаниеКонфликта.Свойство("ИмяИзФайла") Тогда
			Продолжить;
		КонецЕсли;
		РешениеПоУзлу = Новый Структура;
		РешениеПоУзлу.Вставить("Действие", Действие);
		РешениеПоУзлу.Вставить("Ссылка",   ОписаниеКонфликта.СуществующаяСсылка);
		Решения.Вставить(ОписаниеКонфликта.ИмяИзФайла, РешениеПоУзлу);
	КонецЦикла;

	Возврат Решения;

КонецФункции

// Обработчик завершения выбора значения из формы
// Catalog.ДемонстрационныеСценарии.Form.ГКСИ_ФормаВыбораГруппы (открытой из
// ГКСИ_ИнструкцияИсточникПолеНачалоВыбора). Сохраняет выбранную ссылку в реквизит формы.
//
// Параметры:
//  Результат              - Структура, Неопределено - результат формы выбора
//                           (Ссылка, ЭтоГруппа, Фрагмент) или Неопределено при отказе.
//  ДополнительныеПараметры - Произвольный - не используется.
&НаКлиенте
Процедура ГКСИ_ИнструкцияИсточникЗавершениеВыбора(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ВыбраннаяИнструкция = Результат.Ссылка;
	Если НЕ ЗначениеЗаполнено(ВыбраннаяИнструкция) Тогда
		Возврат;
	КонецЕсли;

	// Инструкцией может быть только группа: в списке формы есть и шаги.
	Если НЕ Результат.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите группу-инструкцию.'"));
		Возврат;
	КонецЕсли;

	ГКСИ_ИнструкцияИсточник = ВыбраннаяИнструкция;

КонецПроцедуры

// Диагностическая серверная обёртка без контекста формы для записи в ЖР
// из клиентского кода (ЗаписьЖурналаРегистрации в тонком/web-клиенте
// недоступна, см. ошибки BSL LS в точке 1 пакета D bugfix).
//
// Принимает только тип и размер массива (примитивы), чтобы не дублировать
// сериализацию массива структур между клиентом и сервером — фактический
// массив уже передаётся через ПараметрыФормы.
//@skip-warning
&НаСервереБезКонтекста
Процедура ДиагностикаПередОткрытиемФормыРазрешения(ТипМассиваСтрокой, РазмерМассива)

	ТекстРазмера = ?(РазмерМассива < 0, "<не массив>", XMLСтрока(РазмерМассива));
	ЗаписьЖурналаРегистрации(
		"ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
		УровеньЖурналаРегистрации.Информация, , ,
		"Диагностика D: перед ОткрытьФорму ФормаРазрешенияКонфликтов. "
		+ "Тип МассивКонфликтов = " + ТипМассиваСтрокой
		+ ", размер = " + ТекстРазмера);

КонецПроцедуры

// Обработчик ожидания прогресса: периодически читает структуру прогресса
// из ВХ и обновляет реквизиты формы. Отключается при завершении или ошибке.
//@skip-warning
&НаКлиенте
Процедура ОбработчикОжиданияПрогресса() Экспорт

	Если НЕ ЗначениеЗаполнено(АдресПрогресса) Тогда
		ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
		Возврат;
	КонецЕсли;

	Прогресс = ПолучитьПрогрессНаСервере(АдресПрогресса);
	Если Прогресс = Неопределено Тогда
		ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
		Возврат;
	КонецЕсли;

	Если Прогресс.Статус = "Готово" ИЛИ Прогресс.Статус = "Ошибка" Тогда
		ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
		Возврат;
	КонецЕсли;

	ПроцентГотовности = Прогресс.ПроцентГотовности;
	Если ЗначениеЗаполнено(Прогресс.Сообщение) Тогда
		ТекстПрогресса = Прогресс.Сообщение;
	КонецЕсли;

КонецПроцедуры

// Возвращает параметры обработчика ожидания для ДлительныеОперацииКлиент.ОжидатьЗавершение.
//@skip-warning
&НаКлиенте
Функция ПараметрыОжидания()

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Интервал        = 1;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;

	Возврат ПараметрыОжидания;

КонецФункции

// Обработчик оповещения о завершении фонового задания.
//
// Параметры:
//   Результат - Произвольный - результат выполнения фонового задания.
//   ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//@skip-warning
&НаКлиенте
Процедура ЗавершениеФоновойЗагрузки(Результат, ДополнительныеПараметры) Экспорт

	ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
	ТолькоПросмотр = Ложь;

	Если ТипЗнч(Результат) <> Тип("Структура")
		ИЛИ НЕ Результат.Свойство("Статус") Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = "Не удалось выполнить загрузку";
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = "Не удалось выполнить загрузку";
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресРезультатаЗагрузки) Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = "Не удалось выполнить загрузку";
		Возврат;
	КонецЕсли;

	Статистика = ПолучитьСтатистикуРезультатаНаСервере(АдресРезультатаЗагрузки);

	ПроцентГотовности = 100;
	ТекстПрогресса     = "Загрузка завершена";

	ТекстИтога = СтрШаблон("Готово. Создано: %1, обновлено: %2, пропущено: %3, ошибок: %4.",
		Статистика.Создано, Статистика.Обновлено, Статистика.Пропущено, Статистика.Ошибок);

	Если Статистика.Создано + Статистика.Обновлено = 0 Тогда
		ТекстИтога = ТекстИтога + Символы.ПС + Символы.ПС
			+ "Сценарии не созданы. Подробности в журнале регистрации (ГКСИ.ЗагрузкаСценариевИзMarkdown).";
	КонецЕсли;

	ПоказатьПредупреждение(, ТекстИтога);
	ОповеститьОбИзменении(Тип("СправочникСсылка.ДемонстрационныеСценарии"));

КонецПроцедуры

// Запускает фоновое задание записи дерева. Возвращает структуру
// с адресами ВХ и идентификатором задания.
//
// Параметры:
//  АдресДерева       - Строка - адрес ВХ дерева узлов.
//  АдресРешений      - Строка - адрес ВХ с решениями по конфликтам.
//  АдресКартыФайлов  - Строка - адрес ВХ карты подмен картинок
//                                 (ОригинальныйПуть -> КодФайла), результат
//                                 предзагрузки через ПодготовитьФайлыИнструкций.
//                                 Если пусто — фон работает по старой логике:
//                                 поиск на диске (КаталогПоиска) и/или по
//                                 АдресСоответствияКартинок.
//  Каталог           - Строка - путь к каталогу с картинками на диске
//                                 сервера (используется только при пустой
//                                 АдресКартыФайлов — сценарий «выбрать каталог»).
//@skip-warning
&НаСервере
Функция ЗапуститьЗаписьДереваВФоне(АдресДерева, АдресРешений, АдресКартыФайлов, Каталог)

	Если НЕ ЗначениеЗаполнено(АдресДерева) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Адрес для таблицы результата (привязан к UID формы, чтобы после
	// возврата клиент получил данные через ПолучитьИзВременногоХранилища).
	АдресРезультатаЗагрузки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	// Адрес прогресса — отдельный ВХ-блок, обновляется из фонового задания.
	АдресПрогресса = ГКСИ_ЗагрузкаСценариевИзMarkdown.ИнициализироватьПрогресс(3);

	// Карта подмен картинок: новый канал (через диалог) — готовая карта,
	// старый канал (через выбор каталога) — Неопределено, фон сам соберёт.
	КартаПодменКартинок = Неопределено;
	КаталогПоиска = "";
	АдресаКартинокВоВременномХранилище = Неопределено;
	Если ЗначениеЗаполнено(АдресКартыФайлов) Тогда
		ДанныеКарты = ПолучитьИзВременногоХранилища(АдресКартыФайлов);
		Если ТипЗнч(ДанныеКарты) = Тип("Соответствие") Тогда
			КартаПодменКартинок = ДанныеКарты;
		КонецЕсли;
	Иначе
		КаталогПоиска = Каталог;
		АдресаКартинокВоВременномХранилище = СоответствиеИзВХ(АдресСоответствияКартинок);
	КонецЕсли;

	// Собираем параметры для передачи в фоновое задание.
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДеревоУзлов",                        ПолучитьИзВременногоХранилища(АдресДерева));
	СтруктураПараметров.Вставить("КодЯзыка",                           "ru");
	СтруктураПараметров.Вставить("РешенияПоКонфликтам",                РешенияИзВХ(АдресРешений));
	СтруктураПараметров.Вставить("КартаПодменКартинок",                КартаПодменКартинок);
	СтруктураПараметров.Вставить("КаталогПоиска",                      КаталогПоиска);
	СтруктураПараметров.Вставить("АдресаКартинокВоВременномХранилище", АдресаКартинокВоВременномХранилище);
	СтруктураПараметров.Вставить("АдресПрогресса",                     АдресПрогресса);
	СтруктураПараметров.Вставить("АдресРезультатаЗагрузки",            АдресРезультатаЗагрузки);
	// Явно переданный корень-инструкция из реквизита формы (приоритет
	// над автоопределением по Узел.Уровень = 2 в ОбработатьУзелРекурсивно).
	// Если не задан, в фоновом задании используется старая логика — берётся
	// первый #‑заголовок MD‑файла как инструкция-источник (см. описание в
	// ОбработатьУзелРекурсивно).
	СтруктураПараметров.Вставить("ИнструкцияИсточник",                 ГКСИ_ИнструкцияИсточник);

	ИмяПроцедуры = "ГКСИ_ЗагрузкаСценариевИзMarkdownДлительныеОперации.ЗаписатьДеревоФоново";
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'ГКСИ. Загрузка сценариев из Markdown'");

	// Контракт ВыполнитьВФоне (см. ДлительныеОперации.Модуль, ~строка 540):
	// БСП оборачивает переданный параметр в массив первым элементом и
	// добавляет АдресРезультата вторым. Поэтому передаём СтруктураПараметров
	// напрямую — в фоне она придёт как ПараметрыЗадания.
	ДанныеФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(
		ИмяПроцедуры,
		СтруктураПараметров,
		ПараметрыВыполнения);

	Если ДанныеФоновогоЗадания = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеФоновогоЗадания.ИдентификаторЗадания) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("АдресПрогресса",          АдресПрогресса);
	Результат.Вставить("АдресРезультатаЗагрузки", АдресРезультатаЗагрузки);
	Результат.Вставить("ИдентификаторЗадания",    ДанныеФоновогоЗадания.ИдентификаторЗадания);
	Результат.Вставить("ДанныеФоновогоЗадания",   ДанныеФоновогоЗадания);

	Возврат Результат;

КонецФункции

// Извлекает соответствие решений из ВХ. Возвращает пустое соответствие,
// если адрес пустой или данные не являются соответствием.
//@skip-warning
&НаСервере
Функция РешенияИзВХ(Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные;
	КонецЕсли;

	Возврат Новый Соответствие;

КонецФункции

// Извлекает соответствие адресов картинок из ВХ. Возвращает Неопределено,
// если адрес пустой или данные не соответствуют ожидаемому типу.
//@skip-warning
&НаСервере
Функция СоответствиеИзВХ(Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает текущую структуру прогресса из ВХ.
// Используется клиентским обработчиком ожидания для отображения полосы прогресса.
//@skip-warning
&НаСервере
Функция ПолучитьПрогрессНаСервере(Адрес)

	Возврат ГКСИ_ЗагрузкаСценариевИзMarkdown.ПолучитьПрогресс(Адрес);

КонецФункции

// Возвращает статистику по таблице результата загрузки:
// количество созданных, обновлённых, пропущенных элементов и ошибок.
//@skip-warning
&НаСервере
Функция ПолучитьСтатистикуРезультатаНаСервере(Адрес)

	Статистика = Новый Структура;
	Статистика.Вставить("Создано", 0);
	Статистика.Вставить("Обновлено", 0);
	Статистика.Вставить("Пропущено", 0);
	Статистика.Вставить("Ошибок", 0);

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Статистика;
	КонецЕсли;

	Результат = ПолучитьИзВременногоХранилища(Адрес);
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("ТаблицаЗначений") Тогда
		Возврат Статистика;
	КонецЕсли;

	Для Каждого Строка Из Результат Цикл
		Если Строка.Действие = "Создан" Тогда
			Статистика.Создано = Статистика.Создано + 1;
		ИначеЕсли Строка.Действие = "Обновлён" Тогда
			Статистика.Обновлено = Статистика.Обновлено + 1;
		ИначеЕсли Строка.Действие = "Пропущен" Тогда
			Статистика.Пропущено = Статистика.Пропущено + 1;
		ИначеЕсли Строка.Действие = "Ошибка" Тогда
			Статистика.Ошибок = Статистика.Ошибок + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Статистика;

КонецФункции

// Обработчик выбора каталога. Передаёт путь на сервер, получает список .md
// из корня каталога. Если файл один — сразу вызывает парсинг.
// Если несколько — пользователю показывается выбор.
// Если ни одного — сообщение об ошибке.
//
// Параметры:
//   ВыбранныеФайлы - Произвольный - выбранные файлы.
//   ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//@skip-warning
&НаКлиенте
Процедура ПослеВыбораКаталога(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено
		ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КаталогРесурсов = ВыбранныеФайлы[0];
	КаталогПоиска  = КаталогРесурсов;

	Диагностика = ПолучитьСписокФайловMarkdownНаСервере(КаталогРесурсов);
	СписокФайлов = Диагностика.Файлы;

	Если СписокФайлов.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр("ru = 'В выбранном каталоге не найдено .md-файлов.'");
		Если ЗначениеЗаполнено(Диагностика.Сообщение) Тогда
			ТекстПредупреждения = ТекстПредупреждения
				+ Символы.ПС + Символы.ПС
				+ НСтр("ru = 'Диагностика:'") + Символы.ПС
				+ НСтр("ru = '  Исходный путь:'") + " " + Диагностика.ПутьИсходный + Символы.ПС
				+ НСтр("ru = '  Нормализованный путь:'") + " " + Диагностика.ПутьНормализ + Символы.ПС
				+ НСтр("ru = '  Каталог существует:'") + " " + ?(Диагностика.КаталогСущ, НСтр("ru = 'да'"), НСтр("ru = 'нет'")) + Символы.ПС
				+ Диагностика.Сообщение;
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат;
	КонецЕсли;

	Если СписокФайлов.Количество() = 1 Тогда
		ИмяФайла = СписокФайлов[0];
		ЗагрузитьФайлИзКаталогаНаСервере(КаталогРесурсов, ИмяФайла);
		Возврат;
	КонецЕсли;

	// Несколько файлов — предложить выбор.
	Список = Новый СписокЗначений;
	Для Каждого ИмяФайла Из СписокФайлов Цикл
		Список.Добавить(ИмяФайла);
	КонецЦикла;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаИзСписка", ЭтотОбъект);
	Список.ПоказатьВыборЭлемента(Оповещение,
		НСтр("ru = 'Выберите Markdown-файл для загрузки'"));

КонецПроцедуры

// Обработчик выбора конкретного .md-файла из списка.
//
// Параметры:
//   ВыбранныйЭлемент - Произвольный - выбранный элемент списка.
//   ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения.
//@skip-warning
&НаКлиенте
Процедура ПослеВыбораФайлаИзСписка(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = ВыбранныйЭлемент.Значение;
	ЗагрузитьФайлИзКаталогаНаСервере(КаталогРесурсов, ИмяФайла);

КонецПроцедуры

// Обработчик закрытия формы разрешения конфликтов.
//
// Параметры:
//  Результат               - Соответствие, Неопределено - решения по конфликтам.
//  ДополнительныеПараметры - Произвольный - контекст вызова.
//@skip-warning
&НаКлиенте
Процедура ПослеРазрешенияКонфликтов(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	АдресРешенийВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат,
		УникальныйИдентификатор);

	// Сразу запускаем фоновую запись — это симметрично веткам
	// «Обновить все»/«Пропустить все» в ПослеВыбораДействияПоКонфликтам.
	// ЗапуститьЗагрузкуСейчас читает АдресРешенийВоВременномХранилище,
	// АдресДереваУзлов и АдресСоответствияКартинок — все они уже заполнены
	// на момент открытия формы разрешения.
	ЗапуститьЗагрузкуСейчас();

КонецПроцедуры

// Парсит загруженный файл и сохраняет дерево узлов во временном хранилище.
//
// Параметры:
//  Адрес - Строка - адрес двоичных данных Markdown-файла во временном хранилище.
//@skip-warning
&НаСервере
Процедура ЗагрузитьФайлНаСервере(Адрес)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Если ДвоичныеДанные <> Неопределено Тогда
		ТекстФайла = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
		ТекстПревью = ТекстФайла;
	КонецЕсли;

	ДеревоУзлов = ГКСИ_ЗагрузкаСценариевИзMarkdown.РазобратьMarkdownВДерево(Адрес, ИмяФайла);

	Если ДеревоУзлов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АдресДереваУзлов = ПоместитьВоВременноеХранилище(ДеревоУзлов, УникальныйИдентификатор);

КонецПроцедуры

// Серверная часть команды ВыбратьФайлИКартинки. Принимает Соответствие
// "ИмяФайла" -> "АдресВХ", находит в нём .md (ровно один) и картинки,
// помещает соответствие картинок во временное хранилище и кладёт его
// адрес в реквизит формы. Затем запускает парсинг .md.
//
// Параметры:
//  АдресаФайлов      - Соответствие из (Строка, Строка).
//  ПолныйПутьКФайлу  - Строка - полный путь к .md-файлу на клиенте.
//                       Если задан, родительский каталог подставляется
//                       в КаталогПоиска для поиска картинок на диске.
//
//@skip-warning
&НаСервере
Процедура ЗагрузитьФайлИКартинкиНаСервере(АдресаФайлов, ПолныйПутьКФайлу = "")

	Если АдресаФайлов = Неопределено ИЛИ АдресаФайлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Отделяем .md от картинок по расширению.
	РасширенияКартинок = Новый Соответствие;
	РасширенияКартинок.Вставить(".png",  Истина);
	РасширенияКартинок.Вставить(".jpg",  Истина);
	РасширенияКартинок.Вставить(".jpeg", Истина);
	РасширенияКартинок.Вставить(".gif",  Истина);
	РасширенияКартинок.Вставить(".webp", Истина);
	РасширенияКартинок.Вставить(".bmp",  Истина);

	АдресФайлаИзДиалога = "";
	ИмяФайлаИзДиалога   = "";
	АдресаКартинок = Новый Соответствие;
	СчетчикMd = 0;

	Для Каждого КИЗ Из АдресаФайлов Цикл
		ИмяФайлаЭлемента   = КИЗ.Ключ;
		АдресЭлемента      = КИЗ.Значение;

		Если НЕ ЗначениеЗаполнено(ИмяФайлаЭлемента)
			ИЛИ НЕ ЗначениеЗаполнено(АдресЭлемента) Тогда
			Продолжить;
		КонецЕсли;

		// Поиск расширения (последняя точка в имени).
		ПозицияТочки = СтрНайти(ИмяФайлаЭлемента, ".", НаправлениеПоиска.СКонца);
		Если ПозицияТочки = 0 Тогда
			Расширение = "";
		Иначе
			Расширение = НРег(Сред(ИмяФайлаЭлемента, ПозицияТочки));
		КонецЕсли;

		Если Расширение = ".md" Тогда
			СчетчикMd = СчетчикMd + 1;
			АдресФайлаИзДиалога = АдресЭлемента;
			ИмяФайлаИзДиалога   = ИмяФайлаЭлемента;
		ИначеЕсли РасширенияКартинок.Получить(Расширение) = Истина Тогда
			АдресаКартинок.Вставить(ИмяФайлаЭлемента, АдресЭлемента);
		Иначе
			// Прочие расширения игнорируются.
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(АдресФайлаИзДиалога) Тогда
		Возврат;
	КонецЕсли;

	// Сохраняем соответствие картинок во временном хранилище — будет
	// использовано при записи дерева (см. ЗаписатьДеревоВСправочник).
	Если АдресаКартинок.Количество() > 0 Тогда
		АдресСоответствияКартинок = ПоместитьВоВременноеХранилище(
			АдресаКартинок, УникальныйИдентификатор);
	Иначе
		АдресСоответствияКартинок = "";
	КонецЕсли;

	// Заполняем реквизиты формы, чтобы были активны кнопки Загрузить файл
	// и Выполнить загрузку (они проверяют АдресФайлаВоВременномХранилище).
	АдресФайлаВоВременномХранилище = АдресФайлаИзДиалога;
	ИмяФайла                       = ИмяФайлаИзДиалога;

	// КаталогПоиска: если клиент передал полный путь к .md, берём его
	// родительский каталог — это позволит поиску картинок на диске работать
	// для сценария "выбрал .md в диалоге, картинки лежат рядом".
	// Используем существующую ГКСИ_НормализоватьПутьКаталога — она снимает
	// file:// и URL-encoded (для веб-клиента и расширения работы с файлами).
	КаталогПоиска = "";
	Если ЗначениеЗаполнено(ПолныйПутьКФайлу) Тогда
		НормализованныйПуть = ГКСИ_НормализоватьПутьКаталога(ПолныйПутьКФайлу);
		Если ЗначениеЗаполнено(НормализованныйПуть) Тогда
			ПозицияСлеша = СтрНайти(НормализованныйПуть, "\", НаправлениеПоиска.СКонца);
			Если ПозицияСлеша > 0 Тогда
				КаталогПоиска = Лев(НормализованныйПуть, ПозицияСлеша - 1);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Парсим .md.
	ЗагрузитьФайлНаСервере(АдресФайлаИзДиалога);

	// Предзагрузка картинок (синхронно, до запуска фонового задания):
	// читаем двоичные данные из ВХ основного сеанса, считаем хеши,
	// создаём недостающие элементы справочника ГКСИ_ФайлыИнструкций
	// и получаем готовую карту подмен. Это решает проблему клиент-серверной
	// базы с файлами на сетевом ресурсе, недоступном машине сервера 1С:
	// фоновое задание получает уже готовую карту и не обращается к диску.
	Если ЗначениеЗаполнено(АдресДереваУзлов) Тогда
		АдресКартыФайлов = ПодготовитьФайлыИнструкцийНаСервере(
			АдресСоответствияКартинок, АдресДереваУзлов);
	Иначе
		АдресКартыФайлов = "";
	КонецЕсли;

КонецПроцедуры

// Синхронная серверная обёртка над ГКСИ_ЗагрузкаСценариевИзMarkdown.
// ПодготовитьФайлыИнструкций: читает адрес соответствия картинок,
// достаёт дерево из ВХ и возвращает адрес ВХ с готовой картой подмен.
//
// Параметры:
//  АдресСоответствияКартинок - Строка - адрес ВХ соответствия ИмяФайла -> АдресВХ.
//  АдресДереваУзлов          - Строка - адрес ВХ дерева узлов.
//
// Возвращаемое значение:
//  Строка - адрес ВХ карты подмен (ОригинальныйПуть -> КодФайла) или пустая строка.
//@skip-warning
&НаСервере
Функция ПодготовитьФайлыИнструкцийНаСервере(АдресСоответствияКартинок, АдресДереваУзлов)

	Если НЕ ЗначениеЗаполнено(АдресДереваУзлов) Тогда
		Возврат "";
	КонецЕсли;

	АдресаКартинокВХ = СоответствиеИзВХ(АдресСоответствияКартинок);

	ДеревоУзлов = ПолучитьИзВременногоХранилища(АдресДереваУзлов);
	Если ДеревоУзлов = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ГКСИ_ЗагрузкаСценариевИзMarkdown.ПодготовитьФайлыИнструкций(
		ДеревоУзлов, АдресаКартинокВХ, "");

КонецФункции

// Возвращает список имён .md-файлов из корня указанного каталога.
//
// Ищет в указанном каталоге .md-файлы (без обхода подкаталогов). Перед поиском
// нормализует путь: убирает префикс file://, который возвращает
// ДиалогВыбораФайла в веб-клиенте и некоторых режимах тонкого клиента,
// и декодирует URL-encoded символы (%20 -> пробел и т.п.). Без этого
// серверный НайтиФайлы получает путь вроде "file:///C:/Users/.../%D0%98%D0%BD%D1%81%D1%82%D1%80" и
// возвращает пустой массив, а пользователь видит "не найдено .md-файлов".
//
// Параметры:
//  Каталог - Строка - путь к каталогу, переданный из обработчика выбора каталога.
//
// Возвращаемое значение:
//  Структура - результат диагностики:
//   * Файлы          - Массив из Строка - имена найденных .md-файлов (без пути).
//   * ПутьИсходный   - Строка - что пришло с клиента (как есть).
//   * ПутьНормализ   - Строка - после снятия file:// и URL-декодирования.
//   * КаталогСущ     - Булево - существует ли каталог на стороне сервера.
//   * Сообщение      - Строка - пояснение, если поиск не дал результатов.
//
&НаСервере
Функция ПолучитьСписокФайловMarkdownНаСервере(Каталог)

	ПутьИсходный   = ?(Каталог = Неопределено, "", Строка(Каталог));
	ПутьНормализ   = ГКСИ_НормализоватьПутьКаталога(Каталог);
	КаталогСущ     = Ложь;
	Файлы          = Новый Массив;
	Сообщение      = "";

	Если НЕ ЗначениеЗаполнено(ПутьНормализ) Тогда
		Сообщение = "Пустой путь после нормализации.";
	Иначе
		Попытка
			ОбъектКаталога = Новый Файл(ПутьНормализ);
			КаталогСущ = ОбъектКаталога.Существует();
		Исключение
			КаталогСущ = Ложь;
			Сообщение = "Ошибка проверки каталога: " + ОписаниеОшибки();
		КонецПопытки;

		Если НЕ КаталогСущ Тогда
			Сообщение = Сообщение + ?(Сообщение = "", "", Символы.ПС)
				+ "Каталог не существует на стороне сервера 1С. "
				+ "Если обработка запускается в файл-серверной 1С "
				+ "(rphost на другой машине), сервер не видит локальные "
				+ "пути вашего RDP-компьютера. В таком случае файл-инструкция "
				+ "должна лежать на диске, доступном серверу 1С "
				+ "(общий сетевой ресурс или путь вида UNC).";
		Иначе
			Попытка
				НайденныеФайлы = НайтиФайлы(ПутьНормализ, "*.md", Ложь);
				Для Каждого Файл Из НайденныеФайлы Цикл
					Если Файл.ЭтоФайл() Тогда
						Файлы.Добавить(Файл.Имя);
					КонецЕсли;
				КонецЦикла;
			Исключение
				Сообщение = "Ошибка поиска .md: " + ОписаниеОшибки();
			КонецПопытки;
			Если Файлы.Количество() = 0 Тогда
				Сообщение = Сообщение + ?(Сообщение = "", "", Символы.ПС)
					+ "Каталог существует, но в нём не найдено .md-файлов "
					+ "(поиск без подкаталогов).";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Файлы",        Файлы);
	Результат.Вставить("ПутьИсходный", ПутьИсходный);
	Результат.Вставить("ПутьНормализ", ПутьНормализ);
	Результат.Вставить("КаталогСущ",   КаталогСущ);
	Результат.Вставить("Сообщение",    Сообщение);

	Возврат Результат;

КонецФункции

// Преобразует путь, полученный из ДиалогВыбораФайла (РежимДиалогаВыбораФайла.ВыборКаталога),
// в обычный локальный путь, пригодный для серверных файловых функций.
//
// Убирает:
//   - префикс file://  (веб-клиент и расширение работы с файлами);
//   - лишний ведущий слэш после file://;
//   - URL-encoded символы (%20, %D0 и т.д.) — на случай, если диалог
//     вернул путь в URL-кодировке.
//
// Параметры:
//  Каталог - Строка - исходный путь.
//
// Возвращаемое значение:
//  Строка - нормализованный путь.
//
&НаСервере
Функция ГКСИ_НормализоватьПутьКаталога(Каталог)

	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат "";
	КонецЕсли;

	Результат = СокрЛП(Каталог);

	// Префикс file:// (регистронезависимо).
	Если СтрНачинаетсяС(ВРег(Результат), "FILE:") Тогда
		Результат = Сред(Результат, 6);
		// После "file:" бывает "//" или "/".
		Пока СтрНачинаетсяС(Результат, "/") Цикл
			Результат = Сред(Результат, 2);
		КонецЦикла;
	КонецЕсли;

	// URL-decode, если в строке есть признак кодировки.
	Если СтрНайти(Результат, "%") > 0 Тогда
		ГКСИ_НормализоватьПутьКаталога_Декодировать(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ГКСИ_НормализоватьПутьКаталога_Декодировать(Результат)

	Попытка
		Результат = РаскодироватьСтроку(Результат, СпособКодированияСтроки.КодировкаURL);
	Исключение
		// Часть символов уже не URL-encoded — оставляем как есть.
		// СокрЛП здесь только для того, чтобы линтер SU62 видел код в Исключение.
		Результат = СокрЛП(Результат);
	КонецПопытки;

КонецПроцедуры

// Загружает указанный .md-файл из каталога: помещает во временное хранилище
// и запускает парсинг. КаталогПоиска сохраняется для последующей загрузки картинок.
//
// Параметры:
//  Каталог  - Строка - каталог, в котором лежит файл.
//  ИмяФайлаИзКаталога - Строка - имя .md-файла.
//@skip-warning
&НаСервере
Процедура ЗагрузитьФайлИзКаталогаНаСервере(Каталог, ИмяФайлаИзКаталога)

	Если НЕ ЗначениеЗаполнено(Каталог) ИЛИ НЕ ЗначениеЗаполнено(ИмяФайлаИзКаталога) Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяФайла = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") + ИмяФайлаИзКаталога;
	ФайлНаДиске = Новый Файл(ПолноеИмяФайла);
	Если НЕ ФайлНаДиске.Существует() ИЛИ НЕ ФайлНаДиске.ЭтоФайл() Тогда
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
	ИмяФайла = ИмяФайлаИзКаталога;
	КаталогПоиска = Каталог;

	ТекстФайла = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	ТекстПревью = ТекстФайла;

	АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные,
		УникальныйИдентификатор);

	ДеревоУзлов = ГКСИ_ЗагрузкаСценариевИзMarkdown.РазобратьMarkdownВДерево(
		АдресФайлаВоВременномХранилище, ИмяФайла);

	Если ДеревоУзлов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АдресДереваУзлов = ПоместитьВоВременноеХранилище(ДеревоУзлов, УникальныйИдентификатор);

КонецПроцедуры

// Собирает массив имён из дерева и ищет существующие элементы справочника.
// Возвращает массив структур с информацией о конфликтах.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяИзФайла              - Строка.
//   * СуществующаяСсылка       - СправочникСсылка.ДемонстрационныеСценарии.
//   * СуществующееНаименование - Строка.
//   * СуществующееЭтоГруппа    - Булево.
//   * ТекстИзФайла             - Строка - текст узла из MD-файла (для сравнения
//                                 при разрешении конфликта «Прикрепить»). Если
//                                 текст в файле для узла не задан — пустая
//                                 строка.
//   * СуществующийТекст        - Строка - ГКСИ_ТекстMarkdown существующего узла
//                                 из БД. Используется формой разрешения
//                                 конфликтов, чтобы сравнить с ТекстИзФайла и
//                                 при разнице открыть диалог «чей текст оставить».
//@skip-warning
&НаСервере
Функция ПроверитьКонфликтыНаСервере()

	Если НЕ ЗначениеЗаполнено(АдресДереваУзлов) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ДеревоУзлов = ПолучитьИзВременногоХранилища(АдресДереваУзлов);

	МассивИмен = Новый Массив;
	СобратьИменаИзДерева(ДеревоУзлов, МассивИмен);

	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
		УровеньЖурналаРегистрации.Информация, , ,
		"Собранные имена из дерева (" + МассивИмен.Количество() + " шт.): " + МассивИменВСтроку(МассивИмен));

	Найденные = ГКСИ_ЗагрузкаСценариевИзMarkdown.НайтиСуществующихПоИмени(МассивИмен);

	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
		УровеньЖурналаРегистрации.Информация, , ,
		"Найдено совпадений по именам: " + Найденные.Количество());

	// Собираем все найденные ссылки, чтобы одним пакетным запросом получить
	// их текущие тексты Markdown. Если этого не делать, форма разрешения
	// конфликтов будет вынуждена получать тексты по одному (лишние вызовы
	// сервера, лишние обращения к БД).
	МассивСсылок = Новый Массив;
	Для Каждого КлючИЗначение Из Найденные Цикл
		Для Каждого ОписаниеСсылки Из КлючИЗначение.Значение Цикл
			МассивСсылок.Добавить(ОписаниеСсылки.Ссылка);
		КонецЦикла;
	КонецЦикла;
	ТекстыСуществующихУзлов = ТекстыУзловПоСсылкам(МассивСсылок);

	МассивКонфликтов = Новый Массив;
	Для Каждого КлючИЗначение Из Найденные Цикл
		Имя = КлючИЗначение.Ключ;
		ТекстУзлаИзФайла = НайтиТекстУзлаПоИмениВДереве(ДеревоУзлов, Имя);
		Для Каждого ОписаниеСсылки Из КлючИЗначение.Значение Цикл
			Описание = Новый Структура;
			Описание.Вставить("ИмяИзФайла",              Имя);
			Описание.Вставить("СуществующаяСсылка",       ОписаниеСсылки.Ссылка);
			Описание.Вставить("СуществующееНаименование", Строка(ОписаниеСсылки.Ссылка));
			Описание.Вставить("СуществующееЭтоГруппа",    ОписаниеСсылки.ЭтоГруппа);
			Описание.Вставить("ТекстИзФайла",             ТекстУзлаИзФайла);
			ТекстСуществующий = ТекстыСуществующихУзлов.Получить(ОписаниеСсылки.Ссылка);
			Описание.Вставить("СуществующийТекст",        ?(ТекстСуществующий = Неопределено, "", ТекстСуществующий));
			МассивКонфликтов.Добавить(Описание);
		КонецЦикла;
	КонецЦикла;

	Возврат МассивКонфликтов;

КонецФункции

// Возвращает соответствие «Ссылка -> ГКСИ_ТекстMarkdown» для переданного
// списка ссылок. Используется в ПроверитьКонфликтыНаСервере, чтобы одним
// запросом получить текущие тексты всех существующих узлов, участвующих в
// конфликтах.
//
// Параметры:
//  МассивСсылок - Массив из СправочникСсылка.ДемонстрационныеСценарии.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -
//   Ключ: СправочникСсылка.ДемонстрационныеСценарии,
//   Значение: Строка - текст узла (ГКСИ_ТекстMarkdown), пустая строка, если
//            для ссылки текст не найден.
//@skip-warning
&НаСервере
Функция ТекстыУзловПоСсылкам(МассивСсылок)

	Результат = Новый Соответствие;

	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДемонстрационныеСценарии.Ссылка КАК Ссылка,
		|	ДемонстрационныеСценарии.ГКСИ_ТекстMarkdown КАК ТекстMarkdown
		|ИЗ
		|	Справочник.ДемонстрационныеСценарии КАК ДемонстрационныеСценарии
		|ГДЕ
		|	ДемонстрационныеСценарии.Ссылка В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = ?(Выборка.ТекстMarkdown = Null ИЛИ Выборка.ТекстMarkdown = Неопределено,
			"",
			Строка(Выборка.ТекстMarkdown));
		Результат.Вставить(Выборка.Ссылка, Текст);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Рекурсивно ищет в дереве строку с заданным именем и возвращает её текст
// Markdown. Используется в ПроверитьКонфликтыНаСервере, чтобы при разрешении
// конфликта «Прикрепить» можно было сравнить текст из файла с текстом
// существующего узла и при разнице открыть диалог «чей текст оставить».
//
// Параметры:
//  УзелДерева - ДеревоЗначений, СтрокаДереваЗначений - узел для поиска.
//                Допустимо передавать как само дерево (тогда обход начинается
//                со строк верхнего уровня), так и конкретную строку.
//  Имя        - Строка - искомое наименование.
//
// Возвращаемое значение:
//  Строка - текст узла. Если узел не найден - пустая строка.
//@skip-warning
&НаСервере
Функция НайтиТекстУзлаПоИмениВДереве(УзелДерева, Имя)

	Если УзелДерева = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// У ДеревоЗначений нет колонок - у него есть только Строки. Если
	// вызвали с самим деревом, обходим строки верхнего уровня; на совпадении
	// по наименованию сразу возвращаем текст, иначе рекурсивно идём вглубь.
	Если ТипЗнч(УзелДерева) = Тип("ДеревоЗначений") Тогда
		Для Каждого СтрокаВерхнегоУровня Из УзелДерева.Строки Цикл
			Результат = НайтиТекстУзлаПоИмениВДереве(СтрокаВерхнегоУровня, Имя);
			Если Результат <> "" Тогда
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;

	Если УзелДерева.Наименование = Имя Тогда
		Возврат ?(УзелДерева.ТекстMarkdown = Неопределено, "", УзелДерева.ТекстMarkdown);
	КонецЕсли;

	Для Каждого Ребёнок Из УзелДерева.Строки Цикл
		Результат = НайтиТекстУзлаПоИмениВДереве(Ребёнок, Имя);
		Если Результат <> "" Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Преобразует массив в строку вида "[элемент1, элемент2, ...]" для ЖР.
//@skip-warning
&НаСервере
Функция МассивИменВСтроку(МассивИмен)

	Части = Новый Массив;
	Для Каждого Элемент Из МассивИмен Цикл
		Части.Добавить(Строка(Элемент));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Части, ", ") + "]";

КонецФункции

// Рекурсивно собирает наименования всех строк дерева.
//
// Параметры:
//  Дерево       - ДеревоЗначений, СтрокаДереваЗначений - текущий узел.
//  МассивИмен   - Массив из Строка - собираемые имена.
//@skip-warning
&НаСервере
Процедура СобратьИменаИзДерева(Дерево, МассивИмен)

	Для Каждого Строка Из Дерево.Строки Цикл
		Если МассивИмен.Найти(Строка.Наименование) = Неопределено Тогда
			МассивИмен.Добавить(Строка.Наименование);
		КонецЕсли;
		СобратьИменаИзДерева(Строка, МассивИмен);
	КонецЦикла;

КонецПроцедуры

// Записывает дерево узлов в справочник через синхронный серверный вызов.
// В файловой БД фоновое задание не стартует в отдельном потоке, поэтому
// используется прямой вызов. UI блокируется на время записи (обычно
// несколько секунд); после возврата управление получает вызывающий клиент.
//
// Возвращает адрес таблицы результата во временном хранилище или
// пустую строку при ошибке.
//
// Параметры:
//  АдресДерева      - Строка - адрес ВХ дерева узлов.
//  АдресРешений     - Строка - адрес ВХ с решениями по конфликтам.
//  АдресКартыФайлов - Строка - адрес ВХ карты подмен картинок
//                                (готовый результат ПодготовитьФайлыИнструкций).
//                                Если пусто — синхронный вызов сам соберёт
//                                карту через ПодготовитьКартинкиДляДерева.
//@skip-warning
&НаСервере
Функция ЗаписатьДеревоСинхронноНаСервере(АдресДерева, АдресРешений, АдресКартыФайлов)

	Если НЕ ЗначениеЗаполнено(АдресДерева) Тогда
		Возврат "";
	КонецЕсли;

	ДеревоУзлов = ПолучитьИзВременногоХранилища(АдресДерева);

	Решения = Новый Соответствие;
	Если ЗначениеЗаполнено(АдресРешений) Тогда
		ДанныеРешений = ПолучитьИзВременногоХранилища(АдресРешений);
		Если ТипЗнч(ДанныеРешений) = Тип("Соответствие") Тогда
			Решения = ДанныеРешений;
		КонецЕсли;
	КонецЕсли;

	// Карта подмен картинок: новый канал (через диалог) — готовая карта,
	// старый канал — Неопределено, тогда ЗаписатьДеревоВСправочник сам
	// соберёт карту через КаталогПоиска и АдресСоответствияКартинок.
	КартаПодменКартинок = Неопределено;
	Если ЗначениеЗаполнено(АдресКартыФайлов) Тогда
		ДанныеКарты = ПолучитьИзВременногоХранилища(АдресКартыФайлов);
		Если ТипЗнч(ДанныеКарты) = Тип("Соответствие") Тогда
			КартаПодменКартинок = ДанныеКарты;
		КонецЕсли;
	КонецЕсли;

	// Адрес для результата — привязываем к UID формы, чтобы после
	// возврата на клиент получить таблицу обратно.
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	Попытка
		ГКСИ_ЗагрузкаСценариевИзMarkdown.ЗаписатьДеревоВСправочник(
			ДеревоУзлов,
			"ru",
			Решения,
			КаталогПоиска,
			СоответствиеИзВХ(АдресСоответствияКартинок),
			"",
			АдресРезультата,
			КартаПодменКартинок);
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Ошибка синхронной записи дерева:" + Символы.ПС + ТекстОшибки);
		Возврат "";
	КонецПопытки;

	Возврат АдресРезультата;

КонецФункции

#КонецОбласти
