// Модуль формы разрешения конфликтов обработки ГКСИ_ЗагрузкаСценариевИзMarkdown.
//
// Контракт (пакет D, версия 1.7):
//  - Форма открывается из основной формы с параметром
//    «МассивКонфликтов» — массив структур конфликта
//    (поля ИмяИзФайла, СуществующаяСсылка, СуществующееЭтоГруппа,
//     ТекстИзФайла, СуществующийТекст).
//    Передаётся напрямую через ПараметрыФормы. CatalogRef, строки
//    сериализуются между клиентом и сервером платформой.
//  - Форма сама заполняет таблицу Конфликты (ПриСозданииНаСервере).
//    Никаких собственных запросов к БД она не делает.
//  - Для каждой строки пользователь задаёт Решение: «Пропустить», «Обновить»
//    или «Прикрепить к нашей группе».
//  - По кнопке «Применить»:
//    * если среди «Прикрепить» есть узлы, у которых ТекстИзФайла и
//      СуществующийТекст отличаются — открывается цепочка диалогов
//      «чей текст оставить» (ПоказатьВыборИзМеню);
//    * иначе — сразу закрытие формы с результатом.
//  - Результат (Соответствие ИмяИзФайла -> {Действие, Ссылка, [ТекстИзФайла]})
//    возвращается в основную форму через ОповеститьОВыборе.
//    Поле ТекстИзФайла заполняется только для тех «Прикрепить», где
//    пользователь выбрал «оставить из файла» — в этом случае серверный
//    ОбработатьУзелРекурсивно переписывает ГКСИ_ТекстMarkdown и HTML.
//  - По кнопке «Отмена» возвращается Неопределено.
//
// Элементы формы (таблица конфликтов, кнопки) заданы статически в Form.form.

#Область ОбработчикиСобытийФормы

// Обработчик события формы. Заполняет таблицу конфликтов из параметра.
//
// Контракт (пакет D bugfix):
//  1. Параметр «МассивКонфликтов» — массив структур, переданный напрямую
//     через ПараметрыФормы. Поля примитивны + CatalogRef — сериализация
//     между клиентом и сервером работает.
//  2. Если параметр не передан или это не Массив — пишем в ЖР предупреждение
//     и оставляем таблицу пустой.
//@skip-warning
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Диагностика пакета D bugfix: самая первая строка серверного обработчика.
	// Если запись не появится в ЖР — ПриСозданииНаСервере не вызывается
	// (например, исключение в НастроитьКолонкуРешения выше). Это первое, что
	// надо проверять при пустой форме разрешения.
	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
		УровеньЖурналаРегистрации.Информация, , ,
		"Диагностика D: вход в ПриСозданииНаСервере ФормаРазрешенияКонфликтов.");

	НастроитьКолонкуРешения();

	МассивКонфликтовИзПараметров = Неопределено;
	Параметры.Свойство("МассивКонфликтов", МассивКонфликтовИзПараметров);

	// Диагностика пакета D
	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
		УровеньЖурналаРегистрации.Информация, , ,
		"Форма разрешения: Параметры.МассивКонфликтов тип = "
		+ ТипЗнч(МассивКонфликтовИзПараметров)
		+ ", количество = "
		+ ?(ТипЗнч(МассивКонфликтовИзПараметров) = Тип("Массив"),
			XMLСтрока(МассивКонфликтовИзПараметров.Количество()),
			""));

	Если ТипЗнч(МассивКонфликтовИзПараметров) = Тип("Массив") Тогда
		ЗаполнитьТаблицуКонфликтов(МассивКонфликтовИзПараметров);
	Иначе
		ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Форма разрешения конфликтов открыта без параметра МассивКонфликтов.");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды Применить.
//
// Поведение (пакет D, расширение для варианта «Прикрепить»):
//  1. Собирает список «Прикрепить»-узлов, у которых ТекстИзФайла и
//     СуществующийТекст различаются (после нормализации — сравнение
//     построчное по строкам, нечувствительно к концевому переводу строки).
//  2. Если таких узлов нет — сразу формирует решения и закрывает форму.
//  3. Иначе — открывает цепочку диалогов ПоказатьВыборИзМеню (по одному на
//     конфликт), где пользователь выбирает, чей текст оставить.
//     «Отмена» в диалоге = пользователь закрывает окно без выбора —
//     для такого узла решение сбрасывается на «Пропустить».
//  4. После всех диалогов формирует Соответствие решений и возвращает его
//     владельцу через ОповеститьОВыборе.
//@skip-warning
&НаКлиенте
Процедура Применить(Команда)

	МассивКонфликтовТекста = СобратьМассивКонфликтовПрикрепитьСРазнымиТекстами();

	Если МассивКонфликтовТекста.Количество() = 0 Тогда
		ОповеститьОВыборе(СобратьРешения(Новый Соответствие));
		Возврат;
	КонецЕсли;

	КонтекстДиалога = Новый Структура;
	КонтекстДиалога.Вставить("МассивКонфликтовТекста", МассивКонфликтовТекста);
	КонтекстДиалога.Вставить("ИндексТекущего",         0);
	КонтекстДиалога.Вставить("ВыборТекстаПоУзлам",     Новый Соответствие);

	ПоказатьДиалогВыбораТекстаДляТекущегоКонфликта(КонтекстДиалога);

КонецПроцедуры

// Обработчик команды Отмена.
//@skip-warning
&НаКлиенте
Процедура Отмена(Команда)

	ОповеститьОВыборе(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу Конфликты значениями из переданного массива.
//
// Параметры:
//  МассивКонфликтов - Массив из Структура - элементы конфликта:
//                     ИмяИзФайла, СуществующаяСсылка, СуществующееЭтоГруппа,
//                     ТекстИзФайла, СуществующийТекст.
//@skip-warning
&НаСервере
Процедура ЗаполнитьТаблицуКонфликтов(МассивКонфликтов)

	Конфликты.Очистить();
	Для Каждого ОписаниеКонфликта Из МассивКонфликтов Цикл
		НоваяСтрока = Конфликты.Добавить();
		// ЗаполнитьЗначенияСвойств копирует только те свойства, которые есть
		// и в приёмнике, и в источнике — лишние поля игнорируются.
		// ТекстИзФайла и СуществующийТекст подхватятся, если они есть
		// в колонках таблицы Конфликты (см. Form.form).
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеКонфликта);
		НоваяСтрока.Решение = "Пропустить";
	КонецЦикла;

	ЗаписьЖурналаРегистрации("ГКСИ.ЗагрузкаСценариевИзMarkdown.ПроверкаКонфликтов",
		УровеньЖурналаРегистрации.Информация, , ,
		"В таблицу Конфликты добавлено строк: " + Конфликты.Количество());

КонецПроцедуры

// Настраивает список выбора для колонки "Решение" и закрывает от
// редактирования колонки, описывающие существующий элемент.
// Колонки созданы статически в Form.form, здесь дополняем
// интерактивные свойства.
//@skip-warning
&НаСервере
Процедура НастроитьКолонкуРешения()

	ЭлементРешение = Элементы.Найти("КонфликтыКонфликты3");
	Если ЭлементРешение <> Неопределено Тогда
		ЭлементРешение.СписокВыбора.Очистить();
		ЭлементРешение.СписокВыбора.Добавить("Пропустить",  НСтр("ru = 'Пропустить'"));
		ЭлементРешение.СписокВыбора.Добавить("Обновить",    НСтр("ru = 'Обновить'"));
		ЭлементРешение.СписокВыбора.Добавить("Прикрепить",  НСтр("ru = 'Прикрепить к нашей группе'"));
	КонецЕсли;

	ЗакрытьОтРедактирования("КонфликтыКонфликты");
	ЗакрытьОтРедактирования("КонфликтыКонфликты1");
	ЗакрытьОтРедактирования("КонфликтыКонфликты2");
	ЗакрытьОтРедактирования("КонфликтыТекстИзФайла");
	ЗакрытьОтРедактирования("КонфликтыСуществующийТекст");

КонецПроцедуры

// Устанавливает ТолькоПросмотр для указанной колонки, если она найдена.
//@skip-warning
&НаСервере
Процедура ЗакрытьОтРедактирования(ИмяЭлемента)

	Элемент = Элементы.Найти(ИмяЭлемента);
	Если Элемент <> Неопределено Тогда
		Элемент.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

// Собирает массив «Прикрепить»-узлов с разными текстами между файлом и БД.
//
// Используется в Применить для принятия решения — открывать ли цепочку
// диалогов «чей текст оставить». Тексты считаются равными, если после
// удаления концевых пробелов и переводов строк совпадают побайтно.
//
// Возвращаемое значение:
//  Массив из Структура - пустой массив, если расхождений нет, иначе
//   элементы с полями:
//    * ИмяИзФайла        - Строка - ключ решения.
//    * ТекстИзФайла       - Строка - текст узла из MD-файла.
//    * СуществующийТекст  - Строка - ГКСИ_ТекстMarkdown существующего узла.
//@skip-warning
&НаКлиенте
Функция СобратьМассивКонфликтовПрикрепитьСРазнымиТекстами()

	Результат = Новый Массив;

	Для Каждого Строка Из Конфликты Цикл
		Если Строка.Решение <> "Прикрепить" Тогда
			Продолжить;
		КонецЕсли;
		Если ТекстыСовпадают(Строка.ТекстИзФайла, Строка.СуществующийТекст) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("ИмяИзФайла",       Строка.ИмяИзФайла);
		Описание.Вставить("ТекстИзФайла",      Строка.ТекстИзФайла);
		Описание.Вставить("СуществующийТекст", Строка.СуществующийТекст);
		Результат.Добавить(Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сравнивает две строки текста по содержимому: пустые/неопределённые
// считаются равными; сравнение производится после удаления концевых
// пробелов и переводов строк. Используется при определении, нужно ли
// открывать диалог «чей текст оставить» для «Прикрепить».
//
// Параметры:
//  Текст1 - Строка, Неопределено, Null - первая строка.
//  Текст2 - Строка, Неопределено, Null - вторая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если тексты можно считать одинаковыми.
//@skip-warning
&НаКлиенте
Функция ТекстыСовпадают(Текст1, Текст2)

	Нормализованный1 = СокрЛП(?(Текст1 = Неопределено ИЛИ Текст1 = Null, "", Текст1));
	Нормализованный2 = СокрЛП(?(Текст2 = Неопределено ИЛИ Текст2 = Null, "", Текст2));

	Возврат Нормализованный1 = Нормализованный2;

КонецФункции

// Открывает диалог ПоказатьВыборИзМеню для текущего конфликта из цепочки.
// После ответа пользователя — рекурсивно переходит к следующему конфликту;
// когда все конфликты обработаны — закрывает форму с результатом.
//
// Параметры:
//  КонтекстДиалога - Структура - поля:
//                     * МассивКонфликтовТекста - Массив - очередь конфликтов;
//                     * ИндексТекущего         - Число - какой по счёту
//                                                       конфликт сейчас
//                                                       обрабатывается;
//                     * ВыборТекстаПоУзлам     - Соответствие - накопленный
//                                                       выбор пользователя
//                                                       (Имя -> ТекстИзФайла
//                                                       или "" для "наш").
//@skip-warning
&НаКлиенте
Процедура ПоказатьДиалогВыбораТекстаДляТекущегоКонфликта(КонтекстДиалога)

	Если КонтекстДиалога.ИндексТекущего >= КонтекстДиалога.МассивКонфликтовТекста.Количество() Тогда
		ОповеститьОВыборе(СобратьРешения(КонтекстДиалога.ВыборТекстаПоУзлам));
		Возврат;
	КонецЕсли;

	ТекущийКонфликт = КонтекстДиалога.МассивКонфликтовТекста[КонтекстДиалога.ИндексТекущего];

	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("ИзФайла",   НСтр("ru = 'Оставить из файла'"));
	СписокВыбора.Добавить("Наш",       НСтр("ru = 'Оставить наш'"));
	СписокВыбора.Добавить("Пропустить", НСтр("ru = 'Пропустить узел'"));

	ЗаголовокМеню = СтрШаблон(НСтр("ru = 'Тексты разные для «%1». Чей оставить?'"),
		ТекущийКонфликт.ИмяИзФайла);

	Оповещение = Новый ОписаниеОповещения(
		"ОбработатьВыборТекстовогоКонфликта", ЭтотОбъект, КонтекстДиалога);

	ПоказатьВыборИзМеню(Оповещение, СписокВыбора, ЗаголовокМеню);

КонецПроцедуры

// Обработчик результата диалога ПоказатьВыборИзМеню в цепочке выбора
// текстов. Сохраняет выбор пользователя в КонтекстДиалога.ВыборТекстаПоУзлам
// и запускает следующую итерацию. Если пользователь закрыл меню без
// выбора — для текущего конфликта сбрасывается Решение на «Пропустить».
//
// Параметры:
//  ВыбранныйПункт   - ЭлементСпискаЗначений, Неопределено - результат диалога.
//  КонтекстДиалога  - Структура - контекст цепочки (см. ПоказатьДиалогВыбораТекста...).
//@skip-warning
&НаКлиенте
Процедура ОбработатьВыборТекстовогоКонфликта(ВыбранныйПункт, КонтекстДиалога) Экспорт

	ТекущийКонфликт = КонтекстДиалога.МассивКонфликтовТекста[КонтекстДиалога.ИндексТекущего];

	Если ВыбранныйПункт <> Неопределено Тогда
		РешениеПоТексту = ВыбранныйПункт.Значение;
		Если РешениеПоТексту = "ИзФайла" Тогда
			// Оставляем из файла: пробрасываем в результат текст узла из файла,
			// серверный ОбработатьУзелРекурсивно перепишет ГКСИ_ТекстMarkdown
			// и HTML существующего узла.
			КонтекстДиалога.ВыборТекстаПоУзлам.Вставить(
				ТекущийКонфликт.ИмяИзФайла, ТекущийКонфликт.ТекстИзФайла);
		ИначеЕсли РешениеПоТексту = "Наш" Тогда
			// Оставляем наш: явно ставим пустую строку — это сигнал, что текст
			// перезаписывать не надо.
			КонтекстДиалога.ВыборТекстаПоУзлам.Вставить(
				ТекущийКонфликт.ИмяИзФайла, "");
		Иначе
			// "Пропустить" — узел в этом конфликте едет как Пропустить,
			// ничего не пишем в ВыборТекстаПоУзлам; обработка ниже сама
			// выставит Решение = "Пропустить" в строке таблицы.
			СброситьРешениеВСтрокеКонфликта(ТекущийКонфликт.ИмяИзФайла, "Пропустить");
		КонецЕсли;
	Иначе
		// Крестик / Esc — эквивалент «Пропустить».
		СброситьРешениеВСтрокеКонфликта(ТекущийКонфликт.ИмяИзФайла, "Пропустить");
	КонецЕсли;

	КонтекстДиалога.ИндексТекущего = КонтекстДиалога.ИндексТекущего + 1;
	ПоказатьДиалогВыбораТекстаДляТекущегоКонфликта(КонтекстДиалога);

КонецПроцедуры

// Вспомогательная: устанавливает значение колонки Решение в строке таблицы
// Конфликты с заданным ИмяИзФайла. Используется при отказе пользователя
// от диалога выбора текста — в этом случае соответствующая строка
// превращается в «Пропустить».
//
// Параметры:
//  ИмяИзФайла - Строка - ключ поиска строки.
//  НовоеРешение - Строка - значение для колонки Решение.
//@skip-warning
&НаКлиенте
Процедура СброситьРешениеВСтрокеКонфликта(ИмяИзФайла, НовоеРешение)

	Строки = Конфликты.НайтиСтроки(Новый Структура("ИмяИзФайла", ИмяИзФайла));
	Для Каждого Строка Из Строки Цикл
		Строка.Решение = НовоеРешение;
	КонецЦикла;

КонецПроцедуры

// Собирает Соответствие Решений из таблицы Конфликты.
//
// Контракт (пакет D bugfix): ключ соответствия — ИмяИзФайла (строка),
// значение — Структура {Действие, Ссылка}. Это совпадает с серверным
// контрактом ОбработатьУзелРекурсивно, который ищет решение по
// РешенияПоКонфликтам.Получить(Узел.Наименование) и читает .Действие / .Ссылка.
//
// Для действия «Прикрепить» дополнительно пробрасывается поле ТекстИзФайла:
// если оно заполнено — серверный код перезаписывает ГКСИ_ТекстMarkdown
// и HTML существующего узла текстом из файла (вариант «оставить из файла»);
// если пустое — узел не меняется (вариант «оставить наш»).
//
// Параметры:
//  ВыборТекстаПоУзлам - Соответствие - накопленный выбор пользователя по
//                      результатам цепочки диалогов. Ключ — ИмяИзФайла,
//                      значение — текст из файла (для «из файла») или "" /
//                      Неопределено (для «наш»). Если ИмяИзФайла в нём нет —
//                      считается, что пользователь выбрал «наш», текст не
//                      перезаписывается.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение -
//   Ключ: Строка (ИмяИзФайла),
//   Значение: Структура со свойствами:
//    * Действие     - Строка - "Пропустить", "Обновить" или "Прикрепить".
//    * Ссылка       - CatalogRef.
//    * ТекстИзФайла - Строка - непустое значение только для «Прикрепить +
//                  оставить из файла», иначе пустая строка.
//@skip-warning
&НаКлиенте
Функция СобратьРешения(ВыборТекстаПоУзлам)

	Результат = Новый Соответствие;
	Для Каждого Строка Из Конфликты Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ИмяИзФайла) Тогда
			Продолжить;
		КонецЕсли;
		РешениеПоУзлу = Новый Структура;
		РешениеПоУзлу.Вставить("Действие", Строка.Решение);
		РешениеПоУзлу.Вставить("Ссылка",   Строка.СуществующаяСсылка);
		Если Строка.Решение = "Прикрепить" И ВыборТекстаПоУзлам <> Неопределено Тогда
			ТекстВыбора = ВыборТекстаПоУзлам.Получить(Строка.ИмяИзФайла);
			РешениеПоУзлу.Вставить("ТекстИзФайла", ?(ТекстВыбора = Неопределено, "", ТекстВыбора));
		Иначе
			РешениеПоУзлу.Вставить("ТекстИзФайла", "");
		КонецЕсли;
		Результат.Вставить(Строка.ИмяИзФайла, РешениеПоУзлу);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
