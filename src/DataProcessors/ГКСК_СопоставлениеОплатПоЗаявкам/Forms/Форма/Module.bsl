
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ДатаОтбора) Тогда
		ДатаОтбора = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ОбновитьТаблицуРезультата();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаОтбораПриИзменении(Элемент)
	
	ОбновитьТаблицуРезультата();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СопоставитьОплатуСЗаявкой(Команда)
	
	ВыделенныеСтроки = Элементы.ТаблицаРезультата.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки для сопоставления.");
		Возврат;
	КонецЕсли;
	
	// Идентификаторы выделенных строк не совпадают с индексами таблицы значений,
	// поэтому данные строк берем из самого табличного поля (ДанныеСтроки).
	ДанныеВыделенныхСтрок = Новый Массив;
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Элементы.ТаблицаРезультата.ДанныеСтроки(ИдентификаторСтроки);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеВыделенныхСтрок.Добавить(Новый Структура("Оплата, Заявка", СтрокаТаблицы.Расход, СтрокаТаблицы.Ссылка));
	КонецЦикла;
	
	ПодготовитьИЗапуститьЗадание(ДанныеВыделенныхСтрок);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодготовитьИЗапуститьЗадание(ДанныеВыделенныхСтрок)
	
	Задание = ПодготовитьЗаданиеНаСервере(ДанныеВыделенныхСтрок);
	
	Если Задание.Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Задание.Ошибки, Символы.ПС));
		Возврат;
	КонецЕсли;
	
	Если Задание.Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нет данных для сопоставления.");
		Возврат;
	КонецЕсли;
	
	Если Задание.ТребуетсяПриведение Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопрос", ЭтотОбъект, Задание);
		ПоказатьВопрос(Оповещение, Задание.ОписаниеПриведения, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗапуститьЗадание(Задание);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗапуститьЗадание(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьЗадание(Задание)
	
	ДлительнаяОперация = ЗапуститьЗаданиеНаСервере(Задание);
	Если ДлительнаяОперация = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось запустить фоновое задание.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗавершениеЗадания", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.Заголовок = "Сопоставление оплат с заявками";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеЗадания(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьТаблицуРезультата();
	
	Если Результат = Неопределено Тогда
		ПоказатьПредупреждение(, "Фоновое задание не вернуло результат.");
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	РезультатЗадания = ПолучитьРезультатЗаданияНаСервере(Результат.АдресРезультата);
	
	Если РезультатЗадания = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось прочитать результат фонового задания.");
		Возврат;
	КонецЕсли;
	
	Тексты = Новый Массив;
	
	Если РезультатЗадания.Ошибки.Количество() > 0 Тогда
		Если НЕ ПустаяСтрока(РезультатЗадания.Этап) Тогда
			Тексты.Добавить(СтрШаблон("Ошибка на этапе «%1»:", РезультатЗадания.Этап));
		КонецЕсли;
		Тексты.Добавить(СтрСоединить(РезультатЗадания.Ошибки, Символы.ПС));
		ПоказатьПредупреждение(, СтрСоединить(Тексты, Символы.ПС));
		Возврат;
	КонецЕсли;
	
	Если РезультатЗадания.ПриведениеВыполнено Тогда
		Тексты.Добавить("Договоры приведены к детализации расчётов «По заказам», связанные документы перезаполнены.");
	КонецЕсли;
	
	Если РезультатЗадания.СопоставленоОплат > 0 Тогда
		Тексты.Добавить(СтрШаблон("Сопоставлено оплат: %1.", РезультатЗадания.СопоставленоОплат));
	КонецЕсли;
	
	Если Тексты.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Тексты, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьЗаданиеНаСервере(ДанныеВыделенныхСтрок)
	
	Возврат ГКСК_СопоставлениеОплатПоЗаявкамСервер.ПодготовитьЗадание(ДанныеВыделенныхСтрок);
	
КонецФункции

&НаСервере
Функция ЗапуститьЗаданиеНаСервере(Задание)
	
	ПараметрыЗадания = Новый Структура("Строки, ТребуетсяПриведение");
	ПараметрыЗадания.Строки = Задание.Строки;
	ПараметрыЗадания.ТребуетсяПриведение = Задание.ТребуетсяПриведение;
	
	// Адрес результата формируется автоматически во временном хранилище формы,
	// а сам результат читается из Результат.АдресРезультата в обработчике завершения.
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Сопоставление оплат с заявками";
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ГКСК_СопоставлениеОплатПоЗаявкамСервер.ВыполнитьЗадание", ПараметрыЗадания, ПараметрыВыполнения);
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатЗаданияНаСервере(АдресРезультата)
	
	Если НЕ ЗначениеЗаполнено(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьТаблицуРезультата()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявка.Статус КАК Статус,
	|	Заявка.Автор КАК Автор,
	|	МАКСИМУМ(Списание.Ссылка) КАК Расход,
	|	Заявка.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Списание.Ссылка) КАК Колво
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК Списание
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
	|		ПО Списание.Ссылка.Партнер = Заявка.Партнер
	|			И Списание.Ссылка.СуммаДокумента = Заявка.СуммаДокумента
	|ГДЕ
	|	Заявка.Проведен
	|	И НЕ ТИПЗНАЧЕНИЯ(Списание.ОбъектРасчетов.Объект) = ТИП(Документ.ЗаказПоставщику)
	|	И НЕ Списание.Ссылка.ОплатаПоЗаявкам
	|	И Списание.Ссылка.Дата > &Дата
	|СГРУППИРОВАТЬ ПО
	|	Заявка.Ссылка,
	|	Заявка.Статус,
	|	Заявка.Автор";
	
	Запрос.УстановитьПараметр("Дата", ДатаОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

#КонецОбласти
