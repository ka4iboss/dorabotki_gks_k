&НаКлиенте
Процедура СоздатьГруппыДоступа(Команда)
	
	ВидыДоступа = ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа);
	ПараметрыСоздания = Новый Структура;
	ПараметрыСоздания.Вставить("Профиль", Объект.ПрофильГруппыДоступа);
	ПараметрыСоздания.Вставить("Родитель", Объект.Родитель);
	ПараметрыСоздания.Вставить("ВидыДоступа", ПараметрыПрофиляГруппыДоступа.ВсеВидыДоступа);
	ПараметрыСоздания.Вставить("ЗначенияДоступа", Новый Соответствие);
	ПараметрыСоздания.Вставить("СпособыОпределения", Новый Соответствие);
	ПараметрыСоздания.Вставить("ШаблонНаименования", ШаблонНаименованияГруппДоступа);
	ПараметрыСоздания.Вставить("ПараметрыШаблонаНаименования", Новый Соответствие);
	Индекс = 0;
	//ПараметрыШаблонаНаименования = Новый Соответствие;
	//ИндексыПредставленийВидовДоступа = Новый Соответствие;
	
	Для Каждого ВидДоступа Из ВидыДоступа Цикл
		
		Постфикс = ПолучитьПостфикс(Индекс + 1);
		
		ТаблицаЗначенийДоступа = ЭтотОбъект["ЗначенияДоступа_" + Постфикс];
		ЗначенияДоступа = Новый Массив;
		Для Каждого СтрокаЗначенияДоступа Из ТаблицаЗначенийДоступа Цикл
			ЗначенияДоступа.Добавить(СтрокаЗначенияДоступа.ЗначениеДоступа);
		КонецЦикла;
		ПараметрыСоздания.ЗначенияДоступа.Вставить(ВидДоступа, ЗначенияДоступа);
		ПараметрыСоздания.СпособыОпределения.Вставить(ВидДоступа, ЭтотОбъект["ВидДоступаВсеРазрешены_" + Постфикс]);
		
		ПредставлениеВидаДоступа = ПредставлениеВидовДоступа.Получить(ТипЗнч(ВидДоступа));
		Параметр = "[" + ПредставлениеВидаДоступа + "]";
		Если СтрНайти(ШаблонНаименованияГруппДоступа, Параметр) > 0 Тогда
			ПараметрыСоздания.ПараметрыШаблонаНаименования.Вставить(ВидДоступа, Параметр);
		КонецЕсли;
		//ИндексыПредставленийВидовДоступа.Вставить(ПредставлениеВидаДоступа, Индекс);
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	//ШаблоныПараметровНаименования = Новый Соответствие;
	//Для Каждого Элемент Из ИндексыПредставленийВидовДоступа Цикл
	//	ШаблонПоиска = "[" + Элемент.Ключ + "]";
	//	ШаблонПараметраНаименования = ПолучитьТекстШаблонаПараметра(Элемент.Значение);
	//	ШаблонНаименования = СтрЗаменить(ШаблонНаименования, ШаблонПоиска, ШаблонПараметраНаименования);
	//	ШаблоныПараметровНаименования.Вставить(Элемент.Значение, ШаблонПараметраНаименования);
	//КонецЦикла;
	//ПараметрыСоздания.Вставить("ШаблонНаименования", ШаблонНаименования);
	//ПараметрыСоздания.Вставить("ШаблоныПараметровНаименования", ШаблоныПараметровНаименования);
	
	СоздатьГруппыДоступаНаСервере(ПараметрыСоздания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗначенияДоступаЗаполнить(Команда)
	
	Постфикс = ВыделитьПостфикс(Команда.Имя);
	ВидДоступа = ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа)[Число(Постфикс) - 1];
	ТаблицаЗначенийДоступа = ЭтотОбъект["ЗначенияДоступа_" + Постфикс];
	
	ТаблицаЗначенийДоступа.Очистить();
	ЗначенияДоступа = ПолучитьЗначенияДоступа(ВидДоступа);
	Для Каждого ЗначениеДоступа Из ЗначенияДоступа Цикл
		СтрокаЗначенияДоступа = ТаблицаЗначенийДоступа.Добавить();
		СписокЗначенийДоступа = Новый СписокЗначений;
		СписокЗначенийДоступа.Добавить(ЗначениеДоступа);
		СтрокаЗначенияДоступа.ЗначениеДоступа = СписокЗначенийДоступа;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияДоступаОбъединить(Команда)
	
	Постфикс = ВыделитьПостфикс(Команда.Имя);
	ТаблицаЗначенийДоступа = ЭтотОбъект["ЗначенияДоступа_" + Постфикс];
	
	ВыделенныеСтроки = Элементы["ЗначенияДоступа_" + Постфикс].ВыделенныеСтроки;
	ЗначениеДоступа = Неопределено;
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		ТекущиеДанные = ТаблицаЗначенийДоступа.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если ЗначениеДоступа = Неопределено Тогда
			ЗначениеДоступа = ТекущиеДанные.ЗначениеДоступа;
		Иначе
			Для Каждого Элемент Из ТекущиеДанные.ЗначениеДоступа Цикл
				ЗначениеДоступа.Добавить(Элемент.Значение, Элемент.Представление);
			КонецЦикла;
			ТаблицаЗначенийДоступа.Удалить(ТекущиеДанные);
		КонецЕсли;
	КонецЦикла;
	
	Элементы["ЗначенияДоступа_" + Постфикс].ТекущаяСтрока = ВыделенныеСтроки[0];
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеДоступаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Постфикс = ВыделитьПостфикс(Элемент.Имя);
	ВидДоступа = ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа)[Число(Постфикс) - 1];
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	ЗначенияДоступа = Новый Массив;
	Для Каждого ЗначениеДоступа Из ТекущиеДанные.ЗначениеДоступа Цикл
		ЗначенияДоступа.Добавить(ЗначениеДоступа.Значение);
	КонецЦикла;
	
	ТипыЗначенийДоступа = Новый Массив;
	ТипыЗначенийДоступа.Добавить(ТипЗнч(ВидДоступа));
	ПараметрыФормы = Новый Структура("ТипЗначения,Значения", Новый ОписаниеТипов(ТипыЗначенийДоступа), ЗначенияДоступа);
	ОткрытьФорму("Обработка.ППГД_ГенерацияГруппДоступа.Форма.СписокЗначений",
		ПараметрыФормы,
		Элемент,,,,
		Новый ОписаниеОповещения("ЗначениеДоступаНачалоВыбораОкончаниеВыбора", ЭтотОбъект, Новый Структура("ИмяТаблицыЗначенийДоступа", "ЗначенияДоступа_" + Постфикс)),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредставлениеВидовДоступа()
	
	Попытка
		ПредставлениеВидовДоступа = УправлениеДоступомСлужебныйПовтИсп.ПредставлениеВидовДоступа();
	Исключение
		ПредставлениеВидовДоступа = Новый ФиксированноеСоответствие(Новый Соответствие);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПараметрыПрофиляГруппыДоступа(ПрофильГруппыДоступа)
	
	Если ЗначениеЗаполнено(ПрофильГруппыДоступа) Тогда
		ПараметрыПрофиляГруппыДоступа = ПолучитьПараметрыПрофиляГруппыДоступаНаСервере(ПрофильГруппыДоступа);
	Иначе
		ПустойМассив = Новый Массив;
		ПараметрыПрофиляГруппыДоступа = Новый ФиксированнаяСтруктура("ВидыДоступа,ВсеВидыДоступа",
			Новый ФиксированныйМассив(ПустойМассив), Новый ФиксированныйМассив(ПустойМассив));
	КонецЕсли;
	
	Возврат ПараметрыПрофиляГруппыДоступа;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПараметрыПрофиляГруппыДоступаНаСервере(ПрофильГруппыДоступа)
	
	Если ЗначениеЗаполнено(ПрофильГруппыДоступа) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	ПрофилиГруппДоступаВидыДоступа.ВидДоступа КАК ВидДоступа,
			|	ВЫБОР
			|		КОГДА ИспользуемыеВидыДоступа.ТипЗначенийДоступа ЕСТЬ NULL
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК Используемый
			|ИЗ
			|	Справочник.ПрофилиГруппДоступа.ВидыДоступа КАК ПрофилиГруппДоступаВидыДоступа
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИспользуемыеВидыДоступа КАК ИспользуемыеВидыДоступа
			|		ПО ПрофилиГруппДоступаВидыДоступа.ВидДоступа = ИспользуемыеВидыДоступа.ТипЗначенийДоступа
			|ГДЕ
			|	ПрофилиГруппДоступаВидыДоступа.Ссылка = &ПрофильГруппыДоступа
			|
			|УПОРЯДОЧИТЬ ПО
			|	ПрофилиГруппДоступаВидыДоступа.НомерСтроки");
		Запрос.УстановитьПараметр("ПрофильГруппыДоступа", ПрофильГруппыДоступа);
		
		УстановитьОтключениеБезопасногоРежима(Истина);
		УстановитьПривилегированныйРежим(Истина);
		
		ВсеВидыДоступа = Новый Массив;
		ВидыДоступа = Новый Массив;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ВсеВидыДоступа.Добавить(Выборка.ВидДоступа);
			Если Выборка.Используемый Тогда
				ВидыДоступа.Добавить(Выборка.ВидДоступа);
			КонецЕсли;
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		УстановитьОтключениеБезопасногоРежима(Ложь);
		
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура("ВидыДоступа,ВсеВидыДоступа", Новый ФиксированныйМассив(ВидыДоступа), Новый ФиксированныйМассив(ВсеВидыДоступа));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа)
	
	Возврат ПараметрыПрофиляГруппыДоступа.ВидыДоступа;
	
КонецФункции

&НаСервере
Процедура ПрофильГруппыДоступаПриИзмененииНаСервере()
	
	//ВидыДоступаПрофиляГруппыДоступа = ПолучитьВидыДоступаПрофиляГруппыДоступа(Объект.ПрофильГруппыДоступа);
	//ВидыДоступа = Новый ФиксированныйМассив(ВидыДоступаПрофиляГруппыДоступа);
	ПараметрыПрофиляГруппыДоступа = ПолучитьПараметрыПрофиляГруппыДоступа(Объект.ПрофильГруппыДоступа);
	
	НастроитьФормуПоПрофилюГруппыДоступаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуПоПрофилюГруппыДоступа()
	
	Постфикс = ПолучитьПостфикс(ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа).Количество());
	Элемент = Элементы.Найти("ГруппаВидДоступа_" + Постфикс);
	
	Если Элемент = Неопределено Тогда
		НастроитьФормуПоПрофилюГруппыДоступаНаСервере();
	Иначе
		НастроитьЭлементыГруппПоВидамДоступа(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоПрофилюГруппыДоступаНаСервере()
	
	ВидыДоступа = ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа);
	НачальныйИндекс = ВидыДоступа.Количество();
	Пока НачальныйИндекс > 0 Цикл
		Постфикс = ПолучитьПостфикс(НачальныйИндекс);
		Элемент = Элементы.Найти("ГруппаВидДоступа_" + Постфикс);
		Если Элемент <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		НачальныйИндекс = НачальныйИндекс - 1;
	КонецЦикла;
	НачальныйИндекс = НачальныйИндекс + 1;
	
	Если НачальныйИндекс > 0 И НачальныйИндекс <= ВидыДоступа.Количество() Тогда
		ДобавитьРеквизитыФормы(НачальныйИндекс);
		СоздатьЭлементыГруппВидовДоступа(НачальныйИндекс);
	КонецЕсли;
	НастроитьЭлементыГруппПоВидамДоступа(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыФормы(НачальныйИндекс)
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	КоличествоВидовДоступа = ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа).Количество();
	Для Индекс = НачальныйИндекс По КоличествоВидовДоступа Цикл
		Постфикс = ПолучитьПостфикс(Индекс);
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЗначенияДоступа_" + Постфикс, Новый ОписаниеТипов("ТаблицаЗначений")));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ЗначениеДоступа", Новый ОписаниеТипов("СписокЗначений"), "ЗначенияДоступа_" + Постфикс, "Значение доступа"));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВидДоступаВсеРазрешены_" + Постфикс, Новый ОписаниеТипов("Булево"),, "Способ определения"));
		Команда = Команды.Добавить("ЗначенияДоступаЗаполнить_" + Постфикс);
		Команда.Действие = "ЗначенияДоступаЗаполнить";
		Команда.Заголовок = "Заполнить";
		Команда = Команды.Добавить("ЗначенияДоступаОбъединить_" + Постфикс);
		Команда.Действие = "ЗначенияДоступаОбъединить";
		Команда.Заголовок = "Объединить";
		Команда.СочетаниеКлавиш = Новый СочетаниеКлавиш(Клавиша.J,, Истина);
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

&НаСервере
// Создает на форме элементы для групп видов доступа.
//
// Параметры:
//  НачальныйИндекс - Число - индекс, начиная с которого создаются элементы.
Процедура СоздатьЭлементыГруппВидовДоступа(НачальныйИндекс)

	КоличествоВидовДоступа = ПолучитьВидыДоступа(ПараметрыПрофиляГруппыДоступа).Количество();
	
	Для Индекс = НачальныйИндекс По КоличествоВидовДоступа Цикл
		
		Постфикс = ПолучитьПостфикс(Индекс);
		
		Группа = Элементы.Добавить("ГруппаВидДоступа_" + Постфикс, Тип("ГруппаФормы"), Элементы.ГруппаВидыДоступа);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Элемент = Элементы.Добавить("ВидДоступаВсеРазрешены_" + Постфикс, Тип("ПолеФормы"), Группа);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = "ВидДоступаВсеРазрешены_" + Постфикс;
		Элемент.РежимВыбораИзСписка = Истина;
		Элемент.СписокВыбора.Добавить(Ложь, "Все запрещены");
		Элемент.СписокВыбора.Добавить(Истина, "Все разрешены");
		Таблица = Элементы.Добавить("ЗначенияДоступа_" + Постфикс, Тип("ТаблицаФормы"), Группа);
		Таблица.ПутьКДанным = "ЗначенияДоступа_" + Постфикс;
		Кнопка = Элементы.Добавить("ЗначенияДоступаЗаполнить_" + Постфикс, Тип("КнопкаФормы"), Таблица.КоманднаяПанель);
		Кнопка.ИмяКоманды = "ЗначенияДоступаЗаполнить_" + Постфикс;
		Кнопка = Элементы.Добавить("ЗначенияДоступаОбъединить_" + Постфикс, Тип("КнопкаФормы"), Таблица.КоманднаяПанель);
		Кнопка.ИмяКоманды = "ЗначенияДоступаОбъединить_" + Постфикс;
		Колонка = Элементы.Добавить("ЗначенияДоступаЗначениеДоступа_" + Постфикс, Тип("ПолеФормы"), Таблица);
		Колонка.ПутьКДанным = "ЗначенияДоступа_" + Постфикс + ".ЗначениеДоступа";
		Колонка.Вид = ВидПоляФормы.ПолеВвода;
		Колонка.КнопкаОчистки = Истина;
		Колонка.УстановитьДействие("НачалоВыбора", "ЗначениеДоступаНачалоВыбора");
		Элемент = Элементы.Найти("ЗначенияДоступа_" + Постфикс + "СтрокаПоиска");
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЭлементыГруппПоВидамДоступа(Форма)
	
	Индекс = 1;
	Для Каждого ВидДоступа Из ПолучитьВидыДоступа(Форма.ПараметрыПрофиляГруппыДоступа) Цикл
		Постфикс = ПолучитьПостфикс(Индекс);
		НастроитьЭлементыГруппыПоВидуДоступа(Форма, Постфикс, ВидДоступа);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Пока Истина Цикл
		Постфикс = ПолучитьПостфикс(Индекс);
		Элемент = Форма.Элементы.Найти("ГруппаВидДоступа_" + Постфикс);
		Если Элемент = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Элемент.Видимость = Ложь;
		Форма["ЗначенияДоступа_" + Постфикс].Очистить();
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьЭлементыГруппыПоВидуДоступа(Форма, Постфикс, ВидДоступа)
	
	Форма["ЗначенияДоступа_" + Постфикс].Очистить();
	
	ПредставлениеВидаДоступа = Форма.ПредставлениеВидовДоступа.Получить(ТипЗнч(ВидДоступа));
	Если ПредставлениеВидаДоступа = Неопределено Тогда
		ПредставлениеВидаДоступа = ПолучитьПредставлениеВидаДоступа(ВидДоступа);
		ПредставлениеВидовДоступа = Новый Соответствие(Форма.ПредставлениеВидовДоступа);
		ПредставлениеВидовДоступа.Вставить(ТипЗнч(ВидДоступа), ПредставлениеВидаДоступа);
		Форма.ПредставлениеВидовДоступа = Новый ФиксированноеСоответствие(ПредставлениеВидовДоступа);
	КонецЕсли;
	
	Элемент = Форма.Элементы.Найти("ГруппаВидДоступа_" + Постфикс);
	Элемент.Видимость = Истина;
	Элемент.Заголовок = ПредставлениеВидаДоступа;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПостфикс(Индекс)
	
	Возврат Формат(Индекс, "ЧГ=");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВыделитьПостфикс(Текст)
	
	Позиция = СтрНайти(Текст, "_", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Постфикс = Сред(Текст, Позиция + 1);
	Иначе
		ВызватьИсключение "Не найден постфикс";
	КонецЕсли;
	
	Возврат Постфикс;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеВидаДоступа(ВидДоступа)
	
	МетаданныеВидаДоступа = ВидДоступа.Метаданные();
	
	Возврат МетаданныеВидаДоступа.Сниноним;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначенияДоступа(ВидДоступа)
	
	Результат = Новый Массив;
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.Представление КАК Представление
		|ИЗ
		|	&Таблица КАК Таблица";
	ПолноеИмяМетаданных = ВидДоступа.Метаданные().ПолноеИмя();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Таблица", ПолноеИмяМетаданных);
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗначениеДоступаНачалоВыбораОкончаниеВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		ТекущиеДанные = Элементы[ДополнительныеПараметры.ИмяТаблицыЗначенийДоступа].ТекущиеДанные;
		ТекущиеДанные.ЗначениеДоступа.Загрузить(РезультатЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьШаблонНаименованияГруппДоступа()
	
	ЧастиНаименования = Новый Массив;
	ЧастиНаименования.Добавить("Группа доступа");
