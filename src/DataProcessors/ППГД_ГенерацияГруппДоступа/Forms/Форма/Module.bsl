&НаСервереБезКонтекста
Процедура СоздатьГруппыДоступаНаСервере(Знач ПараметрыСоздания)
	
	КоличествоВидовДоступа = ПараметрыСоздания.ЗначенияДоступа.Количество();
	ПараметрыПеребора = Новый Структура("ТекущиеИндексы,Количество", Новый Массив(КоличествоВидовДоступа), Новый Массив(КоличествоВидовДоступа));
	Индекс = 0;
	Для Каждого ЗначенияДоступа Из ПараметрыСоздания.ЗначенияДоступа Цикл
		ПараметрыПеребора.ТекущиеИндексы[Индекс] = 0;
		ПараметрыПеребора.Количество[Индекс] = ЗначенияДоступа.Количество();
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Попытка
		Ответственный = Пользователи.ТекущийПользователь();
	Исключение
		Ответственный = Неопределено;
	КонецПопытки;
	
	ПредставленияЗначенийДоступа = ПолучитьПредставленияЗначенийДоступа(ПараметрыСоздания);
	
	//Блокировка = Новый БлокировкаДанных;
	//ЭлементБлокировки = Блокировка.Добавить("Справочник.ПрофилиГруппДоступа");
	//ЭлементБлокировки.УстановитьЗначение("Ссылка", ПараметрыСоздания.Профиль);
	
	НачатьТранзакцию();
	
	//Блокировка.Заблокировать();
	
	НаборЗначенийВидовДоступа = ПолучитьНаборЗначенийВидовДоступа(ПараметрыСоздания, ПараметрыПеребора);
	Пока НаборЗначенийВидовДоступа <> Неопределено Цикл
		СоздатьГруппуДоступа(ПараметрыСоздания, НаборЗначенийВидовДоступа, ПредставленияЗначенийДоступа, Ответственный);
		НаборЗначенийВидовДоступа = ПолучитьСледующийНаборПеребора(ПараметрыСоздания, ПараметрыПеребора);
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставленияЗначенийДоступа(ПараметрыСоздания)
	
	Результат = Новый Соответствие;
	
	// По одному виду доступа — своя таблица метаданных, поэтому формируем
	// единый пакетный запрос (ОБЪЕДИНИТЬ ВСЕ) вместо запроса в цикле.
	ЧастиЗапроса = Новый Массив;
	ПараметрыСсылок = Новый Соответствие;
	
	Номер = 0;
	Для Каждого Элемент Из ПараметрыСоздания.ШаблоныПараметровНаименования Цикл
		ВидДоступа = ПараметрыСоздания.ВидыДоступа[Элемент.Ключ];
		ПолноеИмяМетаданных = ВидДоступа.Метаданные().ПолноеИмя();
		СписокСсылок = Новый Массив;
		Для Каждого ЗначенияДоступа Из ПараметрыСоздания.ЗначенияДоступа[Элемент.Ключ] Цикл
			Для Каждого ЗначениеДоступа Из ЗначенияДоступа Цикл
				СписокСсылок.Добавить(ЗначениеДоступа.Значение);
			КонецЦикла;
		КонецЦикла;
		
		Номер = Номер + 1;
		ИмяПараметра = "СписокСсылок" + Формат(Номер, "ЧГ=0");
		ЧастиЗапроса.Добавить(
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка,
			|	Таблица.Представление КАК Представление
			|ИЗ
			|	" + ПолноеИмяМетаданных + " КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В(&" + ИмяПараметра + ")");
		ПараметрыСсылок.Вставить(ИмяПараметра, СписокСсылок);
	КонецЦикла;
	
	Если ЧастиЗапроса.Количество() > 0 Тогда
		УстановитьОтключениеБезопасногоРежима(Истина);
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос(СтрСоединить(ЧастиЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС));
		Для Каждого КлючИЗначение Из ПараметрыСсылок Цикл
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.Представление);
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
		УстановитьОтключениеБезопасногоРежима(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНаборЗначенийВидовДоступа(ПараметрыСоздания, ПараметрыПеребора)
	
	Результат = Новый Массив;
	Индекс = 0;
	Пока Индекс < ПараметрыСоздания.ВидыДоступа.Количество() Цикл
		ТекущийИндекс = ПараметрыПеребора.ТекущиеИндексы[Индекс];
		Если ТекущийИндекс < ПараметрыПеребора.Количество[Индекс] Тогда
			Результат.Добавить(ПараметрыСоздания.ЗначенияДоступа[Индекс][ТекущийИндекс]);
		Иначе
			Результат.Добавить(Неопределено);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСледующийНаборПеребора(ПараметрыСоздания, ПараметрыПеребора)
	
	Результат = Неопределено;
	
	Индекс = ПараметрыПеребора.ТекущиеИндексы.ВГраница();
	Пока Индекс >= 0 Цикл
		ПараметрыПеребора.ТекущиеИндексы[Индекс] = ПараметрыПеребора.ТекущиеИндексы[Индекс] + 1;
		Если ПараметрыПеребора.ТекущиеИндексы[Индекс] >= ПараметрыПеребора.Количество[Индекс] Тогда
			ПараметрыПеребора.ТекущиеИндексы[Индекс] = 0;
		Иначе
			Результат = ПолучитьНаборЗначенийВидовДоступа(ПараметрыСоздания, ПараметрыПеребора);
			Прервать;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьГруппуДоступа(ПараметрыСоздания, НаборЗначенийВидовДоступа, ПредставленияЗначенийДоступа, Ответственный)
	
	СправочникОбъект = Справочники.ГруппыДоступа.СоздатьЭлемент();
	СправочникОбъект.Родитель = ПараметрыСоздания.Родитель;
	СправочникОбъект.Профиль = ПараметрыСоздания.Профиль;
	СправочникОбъект.Ответственный = Ответственный;
	
	Наименование = ПараметрыСоздания.ШаблонНаименования;
	ПредставлениеЗначенийДоступа = Новый Массив;
	
	Индекс = 0;
	Для Каждого ВидДоступа Из ПараметрыСоздания.ВидыДоступа Цикл
		
		СтрокаВидаДоступа = СправочникОбъект.ВидыДоступа.Добавить();
		СтрокаВидаДоступа.ВидДоступа = ВидДоступа;
		СтрокаВидаДоступа.ВсеРазрешены = ПараметрыСоздания.СпособыОпределения[ВидДоступа];
		
		ПредставлениеЗначенийДоступа.Очистить();
		ЗначенияДоступа = НаборЗначенийВидовДоступа[Индекс];
		
		Если ЗначенияДоступа <> Неопределено Тогда
			Для Каждого Элемент Из ЗначенияДоступа Цикл
				СтрокаЗначенияДоступа = СправочникОбъект.ЗначенияДоступа.Добавить();
				СтрокаЗначенияДоступа.ВидДоступа = ВидДоступа;
				СтрокаЗначенияДоступа.ЗначениеДоступа = Элемент.Значение;
				ПредставлениеЗначенияДоступа = ПредставленияЗначенийДоступа[Элемент.Значение];
				ПредставлениеЗначенийДоступа.Добавить(ПредставлениеЗначенияДоступа);
			КонецЦикла;
		КонецЕсли;
		
		ШаблонПараметраНаименования = ПараметрыСоздания.ШаблоныПараметровНаименования[Индекс];
		Если ШаблонПараметраНаименования <> Неопределено Тогда
			Если ПредставлениеЗначенийДоступа.Количество() > 0 Тогда
				ПредставлениеЗначенийДоступаСтрокой = СтрСоединить(ПредставлениеЗначенийДоступа, "; ");
			Иначе
				ПредставлениеЗначенийДоступаСтрокой = "";
			КонецЕсли;
			Наименование = СтрЗаменить(Наименование, ШаблонПараметраНаименования, ПредставлениеЗначенийДоступаСтрокой);
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	СправочникОбъект.Наименование = Наименование;
	
	СправочникОбъект.Записать();
	
КонецПроцедуры


#КонецОбласти
