#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьПравоПерехода = ГКСК_ВерсииОбъектовСервер.ЕстьПравоПереходаНаВерсию();
	
	Элементы.ЦелеваяВерсия.СписокВыбора.Очистить();
	Элементы.ЦелеваяВерсия.СписокВыбора.Добавить("Текущая", НСтр("ru = 'Текущая версия'"));
	Элементы.ЦелеваяВерсия.СписокВыбора.Добавить("Прошлая", НСтр("ru = 'Прошлая версия'"));
	Элементы.ЦелеваяВерсия.СписокВыбора.Добавить("Первая", НСтр("ru = 'Первая версия'"));
	
	ЗаполнитьТипыОбъектов();
	ОбновитьСписокОбъектов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)
	
	ОчиститьОтметки();
	ОбновитьСписокОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	
	ОбновитьСписокОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	
	ОбновитьСписокОбъектов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОбъектов

&НаКлиенте
Процедура ТаблицаОбъектовПриАктивизацииСтроки(Элемент)
	
	ТекущийОбъект = Элементы.ТаблицаОбъектов.ТекущаяСтрока;
	Если ТекущийОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСведенияОВерсияхСсылки(ТекущийОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаЗаписей

&НаКлиенте
Процедура ТаблицаЗаписейПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаЗаписей.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСведенияОВерсияхЗаписи(ТекущаяСтрока.Запись);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбъекты(Команда)
	
	ОбновитьСписокОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаТекущую(Команда)
	
	ЗапроситьПереходНаВерсию("Текущая");
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаПрошлую(Команда)
	
	ЗапроситьПереходНаВерсию("Прошлая");
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаПервую(Команда)
	
	ЗапроситьПереходНаВерсию("Первая");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетТекущая(Команда)
	
	ОткрытьОтчетПоВерсии("Текущая");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПрошлая(Команда)
	
	ОткрытьОтчетПоВерсии("Прошлая");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПервая(Команда)
	
	ОткрытьОтчетПоВерсии("Первая");
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиДляОтмеченных(Команда)
	
	Если Элементы.ТаблицаЗаписей.Видимость Тогда
		ОтмеченныеЗаписи = ОтмеченныеЗначения();
		Если ОтмеченныеЗаписи.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одной записи регистра.'"));
			Возврат;
		КонецЕсли;
		СписокКлючейЗаписей = ОтмеченныеЗаписи;
		СписокСсылок = Новый Массив;
	Иначе
		ОтмеченныеОбъектыСсылки = ОтмеченныеЗначения();
		Если ОтмеченныеОбъектыСсылки.Количество() = 0 Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Не отмечено ни одного объекта.'"));
			Возврат;
		КонецЕсли;
		СписокКлючейЗаписей = Новый Массив;
		СписокСсылок = ОтмеченныеОбъектыСсылки;
	КонецЕсли;
	
	Если ПустаяСтрока(ЦелеваяВерсия) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана целевая версия.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("СписокОбъектов", СписокСсылок);
	ПараметрыЗадания.Вставить("ТипОбъекта", ?(СписокКлючейЗаписей.Количество() > 0, ТипОбъекта, Неопределено));
	ПараметрыЗадания.Вставить("СписокЗаписей", СписокКлючейЗаписей);
	ПараметрыЗадания.Вставить("ТипВерсии", ЦелеваяВерсия);
	
	ДлительнаяОперация = НачатьПереходНаВерсии(ПараметрыЗадания);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПереходНаВерсииЗавершение", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТолькоРазличия(Команда)
	
	ТолькоРазличия = Не ТолькоРазличия;
	ОбновитьОтборРазличий();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенные(Команда)
	
	ИзменитьОтметкуВыделенных(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкуВыделенных(Команда)
	
	ИзменитьОтметкуВыделенных(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапроситьПереходНаВерсию(ТипВерсии)
	
	Если Не ЕстьВыбранныеДанные() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны данные для перехода на версию.'"));
		Возврат;
	КонецЕсли;
	
	НомерВерсии = НомерВерсииДляПерехода(ТипВерсии);
	Если НомерВерсии = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для выбранных данных версия указанного вида не найдена.'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("НомерВерсии", НомерВерсии);
	
	Оповещение = Новый ОписаниеОповещения("ЗапроситьПереходНаВерсиюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ТекстВопроса = НСтр("ru = 'Выполнить переход на выбранную версию? Текущие данные будут заменены.'");
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПереходНаВерсию(НомерВерсии)
	
	Результат = ПерейтиНаВерсиюНаСервере(НомерВерсии);
	
	Если Результат.Статус = "ВосстановлениеВыполнено" Тогда
		ПоказатьОповещениеПользователя(Результат.Сообщение, , НСтр("ru = 'Переход на версию'"));
		ОбновитьСведенияОВыбранныхДанных();
		Возврат;
	КонецЕсли;
	
	ПоказатьПредупреждение(, Результат.ТекстОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПоВерсии(ТипВерсии)
	
	Если Не ЕстьВыбранныеДанные() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбраны данные для открытия отчёта.'"));
		Возврат;
	КонецЕсли;
	
	НомерВерсии = НомерВерсииДляПерехода(ТипВерсии);
	Если НомерВерсии = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для выбранных данных версия указанного вида не найдена.'"));
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = ОтчетПоВерсииНаСервере(НомерВерсии);
	ТабличныйДокумент.Показать(НСтр("ru = 'Печатная форма версии'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПереходНаВерсиюЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьПереходНаВерсию(ДополнительныеПараметры.НомерВерсии);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереходНаВерсииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ДанныеРезультата = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	УдалитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ТекстСообщения = СтрШаблон(НСтр("ru = 'Переход выполнен. Успешно: %1.'"), ДанныеРезультата.Выполнено);
	Если ДанныеРезультата.Ошибки.Количество() > 0 Тогда
		ТекстСообщения = ТекстСообщения
			+ Символы.ПС + НСтр("ru = 'Не выполнено для:'")
			+ Символы.ПС + СтрСоединить(ДанныеРезультата.Ошибки, Символы.ПС);
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстСообщения);
	ОбновитьСписокОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьОтметкуВыделенных(Отметка)
	
	Если Элементы.ТаблицаЗаписей.Видимость Тогда
		Значения = ЗаписиВыделенныхСтрок();
	Иначе
		Значения = Элементы.ТаблицаОбъектов.ВыделенныеСтроки;
	КонецЕсли;
	
	Если Значения.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выделено ни одной строки.'"));
		Возврат;
	КонецЕсли;
	
	ПрименитьОтметкуВыделенным(Значения, Отметка);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаписиВыделенныхСтрок()
	
	Результат = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ТаблицаЗаписей.ВыделенныеСтроки Цикл
		
		Если ТипЗнч(ВыделеннаяСтрока) = Тип("Число") Тогда
			Если ВыделеннаяСтрока >= 1 И ВыделеннаяСтрока <= ТаблицаЗаписей.Количество() Тогда
				Результат.Добавить(СокрЛП(Строка(ТаблицаЗаписей[ВыделеннаяСтрока - 1].Запись)));
			КонецЕсли;
		Иначе
			Результат.Добавить(СокрЛП(Строка(ВыделеннаяСтрока.Запись)));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТипыОбъектов()
	
	ТаблицаТипов = ГКСК_ВерсииОбъектовСервер.ВерсионируемыеОбъекты();
	
	Элементы.ТипОбъекта.СписокВыбора.Очистить();
	Для Каждого СтрокаТипа Из ТаблицаТипов Цикл
		Элементы.ТипОбъекта.СписокВыбора.Добавить(СтрокаТипа.ТипОбъекта, СтрокаТипа.Представление);
	КонецЦикла;
	
	Если ТаблицаТипов.Количество() = 0 Тогда
		ТипОбъекта = Неопределено;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипОбъекта) И ТаблицаТипов.Найти(ТипОбъекта, "ТипОбъекта") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиНоменклатуры = ТаблицаТипов.НайтиСтроки(Новый Структура("ПолноеИмя", "Справочник.Номенклатура"));
	Если СтрокиНоменклатуры.Количество() > 0 Тогда
		ТипОбъекта = СтрокиНоменклатуры[0].ТипОбъекта;
	Иначе
		ТипОбъекта = ТаблицаТипов[0].ТипОбъекта;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокОбъектов()
	
	ТаблицаРазличий.Очистить();
	ОчиститьСведенияОВерсиях();
	ТаблицаЗаписей.Очистить();
	ВыбранныйОбъект = Неопределено;
	ВыбраннаяЗапись = "";
	
	ВидСписка = ГКСК_ВерсииОбъектовСервер.ВидСпискаТипаОбъекта(ТипОбъекта);
	
	Элементы.ТаблицаЗаписей.Видимость = ВидСписка = "ЗаписиРегистра";
	Элементы.ТаблицаОбъектов.Видимость = ВидСписка = "Ссылки";
	
	Если ПустаяСтрока(ВидСписка) Тогда
		Элементы.ВидНоменклатуры.Видимость = Ложь;
		ВидНоменклатуры = Неопределено;
		ПредупредитьОТипеОбъекта();
		ОчиститьСписокОбъектов();
		УстановитьДоступностьКоманд();
		Возврат;
	КонецЕсли;
	
	Если ВидСписка = "ЗаписиРегистра" Тогда
		Элементы.ВидНоменклатуры.Видимость = Ложь;
		ВидНоменклатуры = Неопределено;
		ЗаполнитьСписокЗаписей();
		УстановитьДоступностьКоманд();
		Возврат;
	КонецЕсли;
	
	Элементы.ВидНоменклатуры.Видимость = ГКСК_ВерсииОбъектовСервер.ЕстьРеквизитВидНоменклатуры(ТипОбъекта);
	Если Не Элементы.ВидНоменклатуры.Видимость Тогда
		ВидНоменклатуры = Неопределено;
	КонецЕсли;
	
	НастроитьДинамическийСписок();
	
	УстановитьДоступностьКоманд();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДинамическийСписок()
	
	Настройки = ГКСК_ВерсииОбъектовСервер.НастройкиДинамическогоСпискаОбъектов(
		ТипОбъекта, СтрокаПоиска, ВидНоменклатуры);
	
	Если ПустаяСтрока(Настройки.ПолноеИмя) Тогда
		ПредупредитьОТипеОбъекта();
		ОчиститьСписокОбъектов();
		Возврат;
	КонецЕсли;
	
	СписокОбъектов.ОсновнаяТаблица = Настройки.ПолноеИмя;
	СписокОбъектов.ПроизвольныйЗапрос = Истина;
	СписокОбъектов.ТекстЗапроса = Настройки.ТекстЗапроса;
	Для Каждого Параметр Из Настройки.Параметры Цикл
		СписокОбъектов.Параметры.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	СписокОбъектов.Параметры.УстановитьЗначениеПараметра("Отмеченные", ОтмеченныеЗначения());
	
	Элементы.ТаблицаОбъектов.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗаписей()
	
	ТаблицаЗаписей.Очистить();
	
	ДанныеСписка = ГКСК_ВерсииОбъектовСервер.СписокЗаписейРегистра(ТипОбъекта, СтрокаПоиска);
	Отмеченные = ОтмеченныеЗначения();
	
	Для Каждого СтрокаСписка Из ДанныеСписка Цикл
		
		НоваяСтрока = ТаблицаЗаписей.Добавить();
		НоваяСтрока.Запись = СтрокаСписка.Запись;
		НоваяСтрока.Наименование = СтрокаСписка.Наименование;
		НоваяСтрока.Отметка = Отмеченные.Найти(СтрокаСписка.Запись) <> Неопределено;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПредупредитьОТипеОбъекта()
	
	Если Не ЗначениеЗаполнено(ТипОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		НСтр("ru = 'Для типа объекта ""%1"" просмотр версий не поддерживается.'"),
		Строка(ТипОбъекта));
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСписокОбъектов()
	
	ИмяТаблицы = СокрЛП(СписокОбъектов.ОсновнаяТаблица);
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	
	СписокОбъектов.ТекстЗапроса =
		"ВЫБРАТЬ
		|	Объекты.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(Объекты.Ссылка) КАК Наименование,
		|	ВЫБОР
		|		КОГДА Объекты.Ссылка В (&Отмеченные)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Отметка
		|ИЗ
		|	" + ИмяТаблицы + " КАК Объекты
		|ГДЕ
		|	ЛОЖЬ";
	
	СписокОбъектов.Параметры.УстановитьЗначениеПараметра("Отмеченные", ОтмеченныеЗначения());
	
	Элементы.ТаблицаОбъектов.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтметкиВСписке()
	
	Отмеченные = ОтмеченныеЗначения();
	
	Если Элементы.ТаблицаЗаписей.Видимость Тогда
		
		Для Каждого СтрокаТаблицы Из ТаблицаЗаписей Цикл
			СтрокаТаблицы.Отметка = Отмеченные.Найти(СтрокаТаблицы.Запись) <> Неопределено;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если ПустаяСтрока(СписокОбъектов.ОсновнаяТаблица) Тогда
		Возврат;
	КонецЕсли;
	
	СписокОбъектов.Параметры.УстановитьЗначениеПараметра("Отмеченные", Отмеченные);
	Элементы.ТаблицаОбъектов.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьОтметки()
	
	ОтмеченныеОбъекты = "";
	ОбновитьОтметкиВСписке();
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтметкуВыделенным(Значения, Отметка)
	
	Отмеченные = ОтмеченныеЗначения();
	
	Для Каждого Значение Из Значения Цикл
		
		Индекс = Отмеченные.Найти(Значение);
		
		Если Отметка И Индекс = Неопределено Тогда
			Отмеченные.Добавить(Значение);
		ИначеЕсли Не Отметка И Индекс <> Неопределено Тогда
			Отмеченные.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
	ОтмеченныеОбъекты = ЗначениеВСтрокуВнутр(Отмеченные);
	ОбновитьОтметкиВСписке();
	
КонецПроцедуры

&НаСервере
Функция ОтмеченныеЗначения()
	
	Если ПустаяСтрока(ОтмеченныеОбъекты) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Попытка
		Значение = ЗначениеИзСтрокиВнутр(ОтмеченныеОбъекты);
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервере
Функция ДанныеВыбраннойСтроки()
	
	Если Элементы.ТаблицаЗаписей.Видимость Тогда
		Возврат ГКСК_ВерсииОбъектовСервер.ДанныеПоЗаписиСтрокой(ТипОбъекта, ВыбраннаяЗапись);
	КонецЕсли;
	
	Возврат ВыбранныйОбъект;
	
КонецФункции

&НаСервере
Функция ЕстьВыбранныеДанные()
	
	Возврат ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(ДанныеВыбраннойСтроки());
	
КонецФункции

&НаСервере
Процедура ОбновитьСведенияОВерсияхСсылки(Ссылка)
	
	ВыбранныйОбъект = Ссылка;
	ВыбраннаяЗапись = "";
	ОбновитьСведенияОВыбранныхДанных();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСведенияОВерсияхЗаписи(ЗаписьСтрокой)
	
	ВыбраннаяЗапись = СокрЛП(Строка(ЗаписьСтрокой));
	ВыбранныйОбъект = Неопределено;
	ОбновитьСведенияОВыбранныхДанных();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСведенияОВыбранныхДанных()
	
	ОчиститьСведенияОВерсиях();
	
	ДанныеВыбора = ДанныеВыбраннойСтроки();
	Если ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(ДанныеВыбора) Тогда
		
		Сведения = ГКСК_ВерсииОбъектовСервер.СведенияОВерсиях(ДанныеВыбора);
		
		ПодписьТекущая = ПредставлениеВерсии(Сведения.Текущая);
		ПодписьПрошлая = ПредставлениеВерсии(Сведения.Прошлая);
		ПодписьПервая = ПредставлениеВерсии(Сведения.Первая);
		
	КонецЕсли;
	
	ЗаполнитьТаблицуРазличий();
	УстановитьДоступностьКоманд();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборРазличий()
	
	Элементы.КнопкаТолькоРазличия.Пометка = ТолькоРазличия;
	ЗаполнитьТаблицуРазличий();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРазличий()
	
	ТаблицаРазличий.Очистить();
	
	ДанныеВыбора = ДанныеВыбраннойСтроки();
	Если Не ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(ДанныеВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	ВсеРазличия = ГКСК_ВерсииОбъектовСервер.ТаблицаРазличийВерсий(ДанныеВыбора);
	
	Для Каждого СтрокаРазличия Из ВсеРазличия Цикл
		
		Если ТолькоРазличия И Не СтрокаРазличия.ЕстьРазличие Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРазличий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРазличия);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСведенияОВерсиях()
	
	ПодписьТекущая = "";
	ПодписьПрошлая = "";
	ПодписьПервая = "";
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьКоманд()
	
	ЕстьДанные = ЕстьВыбранныеДанные();
	
	Элементы.КнопкаТолькоРазличия.Пометка = ТолькоРазличия;
	Элементы.ГруппаПакет.Видимость = ЕстьПравоПерехода;
	
	Элементы.КнопкаПерейтиТекущая.Видимость = ЕстьПравоПерехода;
	Элементы.КнопкаПерейтиТекущая.Доступность = ЕстьДанные;
	Элементы.КнопкаПерейтиПрошлая.Видимость = ЕстьПравоПерехода;
	Элементы.КнопкаПерейтиПрошлая.Доступность = ЕстьДанные;
	Элементы.КнопкаПерейтиПервая.Видимость = ЕстьПравоПерехода;
	Элементы.КнопкаПерейтиПервая.Доступность = ЕстьДанные;
	Элементы.КнопкаПерейтиДляОтмеченных.Доступность = ЕстьПравоПерехода;
	
	Элементы.КнопкаОтчетТекущая.Доступность = ЕстьДанные;
	Элементы.КнопкаОтчетПрошлая.Доступность = ЕстьДанные;
	Элементы.КнопкаОтчетПервая.Доступность = ЕстьДанные;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеВерсии(СведенияОВерсии)
	
	Если СведенияОВерсии = Неопределено Тогда
		Возврат НСтр("ru = 'Версия отсутствует.'");
	КонецЕсли;
	
	Возврат СведенияОВерсии.Представление;
	
КонецФункции

&НаСервере
Функция НомерВерсииДляПерехода(ТипВерсии)
	
	Возврат ГКСК_ВерсииОбъектовСервер.НомерВерсииПоТипу(ДанныеВыбраннойСтроки(), ТипВерсии);
	
КонецФункции

&НаСервере
Функция ПерейтиНаВерсиюНаСервере(НомерВерсии)
	
	ДанныеВыбора = ДанныеВыбраннойСтроки();
	
	Результат = Новый Структура;
	Результат.Вставить("Статус", "ОшибкаВосстановления");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Сообщение", "");
	
	Если Не ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(ДанныеВыбора) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не выбраны данные для перехода на версию.'");
		Возврат Результат;
	КонецЕсли;
	
	Сведения = ГКСК_ВерсииОбъектовСервер.СведенияОВерсиях(ДанныеВыбора);
	
	ТекстСообщенияОбОшибке = "";
	СтатусПерехода = ГКСК_ВерсииОбъектовСервер.ПерейтиНаВерсию(
		ДанныеВыбора, НомерВерсии, ТекстСообщенияОбОшибке, Сведения.Источник);
	
	Результат.Статус = СтатусПерехода;
	Результат.ТекстОшибки = ТекстСообщенияОбОшибке;
	
	Если СтатусПерехода = "ВосстановлениеВыполнено" Тогда
		Результат.Сообщение = НСтр("ru = 'Версия восстановлена.'");
	ИначеЕсли ПустаяСтрока(ТекстСообщенияОбОшибке) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Не удалось выполнить переход на версию.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОтчетПоВерсииНаСервере(НомерВерсии)
	
	Возврат ГКСК_ВерсииОбъектовСервер.ОтчетПоВерсии(ДанныеВыбраннойСтроки(), НомерВерсии);
	
КонецФункции

&НаСервере
Функция НачатьПереходНаВерсии(ПараметрыЗадания)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ГКСК_ВерсииОбъектовСервер.ВыполнитьПереходНаВерсииДляОтмеченных",
		ПараметрыЗадания,
		ПараметрыВыполнения);
	
КонецФункции

#КонецОбласти
