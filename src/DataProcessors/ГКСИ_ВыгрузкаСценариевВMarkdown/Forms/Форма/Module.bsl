// Модуль формы обработки ГКСИ_ВыгрузкаСценариевВMarkdown.
//
// Сценарий работы:
//   1. Пользователь выбирает инструкцию-источник (корневую обертку) либо
//      нажимает «Выгрузить все инструкции».
//   2. Указывает каталог выгрузки на своей машине.
//   3. Запускается фоновое задание, которое готовит файлы (.md и картинки).
//   4. По завершении файлы помещаются во временное хранилище и сохраняются
//      в выбранный каталог.
//
// Прогресс читается из временного хранилища обработчиком ожидания.

#Область ОбработчикиСобытийФормы

// Инициализирует форму значениями по умолчанию.
//
// Параметры:
//  Отказ                - Булево - признак отказа от открытия формы.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
&НаСервере
Процедура ГКСИ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(КодЯзыка) Тогда
		КодЯзыка = "ru";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Открывает форму выбора с параметром ВыборГруппИЭлементов, чтобы пользователь
// мог выбрать группу-корень инструкции.
//
// Параметры:
//  Элемент             - FormField - поле формы, для которого сработал обработчик.
//  ДанныеВыбора        - Неопределено - в данном обработчике не используется.
//  СтандартнаяОбработка - Булево - принудительно устанавливаем Ложь.
//
&НаКлиенте
Процедура ГКСИ_ИнструкцияИсточникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыборГруппИЭлементов",
		ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("РасширенныйПоиск", Истина);

	Оповещение = Новый ОписаниеОповещения(
		"ГКСИ_ИнструкцияИсточникЗавершениеВыбора", ЭтотОбъект);

	ОткрытьФорму("Справочник.ДемонстрационныеСценарии.Форма.ГКСИ_ФормаВыбораГруппы",
		ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Выгружает выбранную инструкцию.
//
// Параметры:
//  Команда - КомандаФормы - не используется.
//
&НаКлиенте
Процедура Выгрузить(Команда)

	ЗапуститьВыгрузку(Ложь);

КонецПроцедуры

// Выгружает все инструкции.
//
// Параметры:
//  Команда - КомандаФормы - не используется.
//
&НаКлиенте
Процедура ВыгрузитьВсе(Команда)

	ЗапуститьВыгрузку(Истина);

КонецПроцедуры

// Открывает диалог выбора каталога выгрузки.
//
// Параметры:
//  Команда - КомандаФормы - не используется.
//
&НаКлиенте
Процедура ВыбратьКаталог(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = НСтр("ru = 'Выберите каталог для выгрузки'");
	Если ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		Диалог.Каталог = КаталогВыгрузки;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораКаталогаВыгрузки", ЭтотОбъект);
	Диалог.Показать(Оповещение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик завершения выбора инструкции-источника из формы
// Catalog.ДемонстрационныеСценарии.Form.ГКСИ_ФормаВыбораГруппы.
//
// Параметры:
//  Результат               - Структура, Неопределено - результат формы выбора
//                            (Ссылка, ЭтоГруппа, Фрагмент) или Неопределено при отказе.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ГКСИ_ИнструкцияИсточникЗавершениеВыбора(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ВыбраннаяИнструкция = Результат.Ссылка;
	Если НЕ ЗначениеЗаполнено(ВыбраннаяИнструкция) Тогда
		Возврат;
	КонецЕсли;

	// Инструкцией может быть только группа: в списке формы есть и шаги.
	Если НЕ Результат.ЭтоГруппа Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите группу-инструкцию.'"));
		Возврат;
	КонецЕсли;

	ГКСИ_ИнструкцияИсточник = ВыбраннаяИнструкция;

КонецПроцедуры

// Обработчик завершения выбора каталога выгрузки.
//
// Параметры:
//  ВыбранныеФайлы          - Массив из Строка - выбранные пути.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ПослеВыбораКаталогаВыгрузки(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ВыбранныеФайлы) <> Тип("Массив")
		ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КаталогВыгрузки = ВыбранныеФайлы[0];

КонецПроцедуры

// Проверяет данные и запускает фоновую выгрузку.
//
// Параметры:
//  ВсеИнструкции - Булево - Истина: выгружаются все инструкции,
//                           Ложь: только выбранная.
//
&НаКлиенте
Процедура ЗапуститьВыгрузку(ВсеИнструкции)

	Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог выгрузки.'"));
		Возврат;
	КонецЕсли;

	Если НЕ ВсеИнструкции И НЕ ЗначениеЗаполнено(ГКСИ_ИнструкцияИсточник) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите инструкцию для выгрузки.'"));
		Возврат;
	КонецЕсли;

	ДанныеЗапуска = ЗапуститьВыгрузкуВФоне(ВсеИнструкции);

	Если ДанныеЗапуска = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗапуска.АдресПрогресса)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗапуска.АдресРезультата)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеЗапуска.ИдентификаторЗадания) Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = НСтр("ru = 'Не удалось запустить выгрузку'");
		Возврат;
	КонецЕсли;

	АдресПрогресса      = ДанныеЗапуска.АдресПрогресса;
	АдресРезультата     = ДанныеЗапуска.АдресРезультата;
	ИдентификаторЗадания = ДанныеЗапуска.ИдентификаторЗадания;

	ТолькоПросмотр = Истина;
	ПроцентГотовности       = 0;
	ТекстПрогресса          = НСтр("ru = 'Выгрузка запущена...'");

	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ЗавершениеВыгрузки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		ДанныеЗапуска.ДанныеФоновогоЗадания,
		ОповещениеОЗавершении,
		ПараметрыОжидания());

	ПодключитьОбработчикОжидания("ОбработчикОжиданияПрогресса", 1, Ложь);

КонецПроцедуры

// Периодически читает структуру прогресса из ВХ и обновляет реквизиты формы.
//
&НаКлиенте
Процедура ОбработчикОжиданияПрогресса() Экспорт

	Если НЕ ЗначениеЗаполнено(АдресПрогресса) Тогда
		ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
		Возврат;
	КонецЕсли;

	Прогресс = ПолучитьПрогрессНаСервере(АдресПрогресса);
	Если Прогресс = Неопределено Тогда
		ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
		Возврат;
	КонецЕсли;

	Если Прогресс.Статус = "Готово" ИЛИ Прогресс.Статус = "Ошибка" Тогда
		ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
		Возврат;
	КонецЕсли;

	ПроцентГотовности = Прогресс.ПроцентГотовности;
	Если ЗначениеЗаполнено(Прогресс.Сообщение) Тогда
		ТекстПрогресса = Прогресс.Сообщение;
	КонецЕсли;

КонецПроцедуры

// Возвращает параметры обработчика ожидания завершения фонового задания.
//
// Возвращаемое значение:
//  Структура - параметры ожидания.
//
&НаКлиенте
Функция ПараметрыОжидания()

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Интервал          = 1;
	ПараметрыОжидания.ВыводитьСообщения = Ложь;

	Возврат ПараметрыОжидания;

КонецФункции

// Обработчик завершения фонового задания: помещает файлы в ВХ и сохраняет их.
//
// Параметры:
//  Результат               - Структура, Неопределено - результат фонового задания.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ЗавершениеВыгрузки(Результат, ДополнительныеПараметры) Экспорт

	ОтключитьОбработчикОжидания("ОбработчикОжиданияПрогресса");
	ТолькоПросмотр = Ложь;

	Если ТипЗнч(Результат) <> Тип("Структура")
		ИЛИ НЕ Результат.Свойство("Статус")
		ИЛИ Результат.Статус = "Ошибка" Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = НСтр("ru = 'Не удалось выполнить выгрузку'");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресРезультата) Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = НСтр("ru = 'Не удалось выполнить выгрузку'");
		Возврат;
	КонецЕсли;

	МассивФайлов = ПоместитьФайлыВХНаСервере(АдресРезультата);

	Если МассивФайлов.Количество() = 0 Тогда
		ПроцентГотовности = 0;
		ТекстПрогресса     = НСтр("ru = 'Нет данных для выгрузки'");
		Возврат;
	КонецЕсли;

	ПроцентГотовности = 100;
	ТекстПрогресса     = СтрШаблон(
		НСтр("ru = 'Выгрузка завершена. Файлов: %1'"), МассивФайлов.Количество());

	СохранитьФайлыНаДиске(МассивФайлов);

КонецПроцедуры

// Сохраняет подготовленные файлы в выбранный каталог.
//
// Параметры:
//  МассивФайлов - Массив из Структура - {Имя, Адрес}.
//
&НаКлиенте
Процедура СохранитьФайлыНаДиске(МассивФайлов)

	ОписанияФайлов = Новый Массив;
	Для Каждого Файл Из МассивФайлов Цикл
		ОписанияФайлов.Добавить(
			Новый ОписаниеПередаваемогоФайла(Файл.Имя, Файл.Адрес));
	КонецЦикла;

	Оповещение = Новый ОписаниеОповещения("ПослеСохраненияФайлов", ЭтотОбъект);
	НачатьПолучениеФайловССервера(Оповещение, ОписанияФайлов, КаталогВыгрузки);

КонецПроцедуры

// Обработчик завершения сохранения файлов на диск.
//
// Параметры:
//  ПолученныеФайлы         - Массив из Строка - полученные файлы.
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ПослеСохраненияФайлов(ПолученныеФайлы, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ПолученныеФайлы) <> Тип("Массив") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сохранение файлов отменено.'"));
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Выгрузка завершена. Сохранено файлов: %1.'"),
		ПолученныеФайлы.Количество()));

КонецПроцедуры

// Запускает фоновое задание подготовки файлов. Возвращает структуру
// с адресами ВХ и идентификатором задания.
//
// Параметры:
//  ВсеИнструкции - Булево - Истина: выгружаются все инструкции.
//
// Возвращаемое значение:
//  Структура, Неопределено - {АдресПрогресса, АдресРезультата, ИдентификаторЗадания,
//                             ДанныеФоновогоЗадания}.
//
&НаСервере
Функция ЗапуститьВыгрузкуВФоне(ВсеИнструкции)

	МассивКорней = ПолучитьКорниДляВыгрузки(ВсеИнструкции);
	Если МассивКорней.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Адрес результата привязан к UID формы, чтобы клиент получил данные
	// через ПолучитьИзВременногоХранилища после завершения задания.
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	// Четыре этапа: сбор инструкций, чтение картинок, формирование файлов, финал.
	АдресПрогресса = ГКСИ_ЗагрузкаСценариевИзMarkdown.ИнициализироватьПрогресс(4);

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("МассивКорней", МассивКорней);
	СтруктураПараметров.Вставить("КодЯзыка", КодЯзыка);
	СтруктураПараметров.Вставить("АдресПрогресса", АдресПрогресса);
	СтруктураПараметров.Вставить("АдресРезультатаВыгрузки", АдресРезультата);

	ИмяПроцедуры = "ГКСИ_ВыгрузкаСценариевВMarkdownДлительныеОперации.ПодготовитьФайлыФоново";
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания =
		НСтр("ru = 'ГКСИ. Выгрузка сценариев в Markdown'");

	ДанныеФоновогоЗадания = ДлительныеОперации.ВыполнитьВФоне(
		ИмяПроцедуры,
		СтруктураПараметров,
		ПараметрыВыполнения);

	Если ДанныеФоновогоЗадания = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеФоновогоЗадания.ИдентификаторЗадания) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("АдресПрогресса", АдресПрогресса);
	Результат.Вставить("АдресРезультата", АдресРезультата);
	Результат.Вставить("ИдентификаторЗадания", ДанныеФоновогоЗадания.ИдентификаторЗадания);
	Результат.Вставить("ДанныеФоновогоЗадания", ДанныеФоновогоЗадания);

	Возврат Результат;

КонецФункции

// Возвращает массив корневых оберток для выгрузки.
//
// Параметры:
//  ВсеИнструкции - Булево - Истина: все инструкции, Ложь: только выбранная.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ДемонстрационныеСценарии.
//
&НаСервере
Функция ПолучитьКорниДляВыгрузки(ВсеИнструкции)

	Если ВсеИнструкции Тогда
		Возврат ГКСИ_ВыгрузкаСценариевВMarkdown.ПолучитьКорневыеОберткиИнструкций();
	КонецЕсли;

	МассивКорней = Новый Массив;
	Корень = ГКСИ_ВыгрузкаСценариевВMarkdown.ПолучитьКорневуюОберткуИнструкции(
		ГКСИ_ИнструкцияИсточник);
	Если ЗначениеЗаполнено(Корень) Тогда
		МассивКорней.Добавить(Корень);
	КонецЕсли;

	Возврат МассивКорней;

КонецФункции

// Возвращает текущую структуру прогресса из ВХ.
//
// Параметры:
//  Адрес - Строка - адрес структуры прогресса.
//
&НаСервере
Функция ПолучитьПрогрессНаСервере(Адрес)

	Возврат ГКСИ_ЗагрузкаСценариевИзMarkdown.ПолучитьПрогресс(Адрес);

КонецФункции

// Помещает подготовленные фоном файлы во временное хранилище формы.
//
// Параметры:
//  АдресРезультата - Строка - адрес ВХ со структурой результата выгрузки.
//
// Возвращаемое значение:
//  Массив из Структура - {Имя, Адрес}.
//
&НаСервере
Функция ПоместитьФайлыВХНаСервере(АдресРезультата)

	МассивФайлов = Новый Массив;

	РезультатВыгрузки = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(РезультатВыгрузки) <> Тип("Структура")
		ИЛИ НЕ РезультатВыгрузки.Свойство("Файлы") Тогда
		Возврат МассивФайлов;
	КонецЕсли;

	Для Каждого Файл Из РезультатВыгрузки.Файлы Цикл
		Адрес = ПоместитьВоВременноеХранилище(Файл.ДвоичныеДанные, УникальныйИдентификатор);
		МассивФайлов.Добавить(Новый Структура("Имя, Адрес", Файл.ИмяФайла, Адрес));
	КонецЦикла;

	Возврат МассивФайлов;

КонецФункции

#КонецОбласти
