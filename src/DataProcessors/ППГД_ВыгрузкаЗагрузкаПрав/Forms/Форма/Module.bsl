#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
    ВыгружатьВсе = Истина;  
    ФлажокВыгружатьПользователейВсе = Истина;
    ДанныеФормы = Новый Структура("ВыбранныеЭлементыСписков", Новый Массив);
    ГруппыДоступа.Параметры.УстановитьЗначениеПараметра("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
    Профили.Параметры.УстановитьЗначениеПараметра("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
    ГруппыПользователей.Параметры.УстановитьЗначениеПараметра("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
    Пользователи.Параметры.УстановитьЗначениеПараметра("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
КонецПроцедуры    

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВыгружатьВсеПриИзменении(Элемент) 
    Если ВыгружатьВсе Тогда
        ФлажокВыгружатьПользователейВсе = Истина;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьГруппыДоступаСОтборомПриИзменении(Элемент)
	// Логика отбора по флажку будет определена позже
	Элементы.ГруппыДоступа.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьПрофилиСОтборомПриИзменении(Элемент)
	// Логика отбора по флажку будет определена позже
	Элементы.Профили.Обновить();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппыДоступа

&НаКлиенте
Процедура ГруппыДоступаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    Если Поле = Элементы.ГруппыДоступаПометка Тогда 
        СтандартнаяОбработка = Ложь;
        ТекущиеДанные = Элемент.ТекущиеДанные;
        Если ТекущиеДанные <> Неопределено Тогда
            ЭтоГруппа = ?(ТекущиеДанные.Свойство("ЭтоГруппа"), ТекущиеДанные.ЭтоГруппа, Ложь);
            СнятьПоставитьПометкуСГруппой(ТекущиеДанные.Пометка, ТекущиеДанные.Ссылка, ЭтоГруппа);
            ГруппыДоступа.Параметры.УстановитьЗначениеПараметра("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
            Элементы.ГруппыДоступа.Обновить();
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПрофили

&НаКлиенте
Процедура ПрофилиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
    Если Поле = Элементы.ПрофилиПометка Тогда 
        СтандартнаяОбработка = Ложь;
        ТекущиеДанные = Элемент.ТекущиеДанные;
        Если ТекущиеДанные <> Неопределено Тогда
            ЭтоГруппа = ?(ТекущиеДанные.Свойство("IsFolder"), ТекущиеДанные.IsFolder, Ложь);
            СнятьПоставитьПометкуСГруппой(ТекущиеДанные.Пометка, ТекущиеДанные.Ссылка, ЭтоГруппа);
            Профили.Параметры.УстановитьЗначениеПараметра("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
            Элементы.Профили.Обновить();
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыгрузитьВыбранные(Команда)  
    ВыполнитьВыгрузкуИзФормы(Ложь);
КонецПроцедуры 

&НаКлиенте
Процедура ВыгрузитьВсе(Команда)
    ВыполнитьВыгрузкуИзФормы(Истина);
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
    ДополнительныеПараметры = Новый Структура("ВидФайла", "ФайлДанныхДляЗагрузки");
    Оповещение = Новый ОписаниеОповещения("ПоместитьФайлВХранилищеЗавершить", ЭтотОбъект, ДополнительныеПараметры);
    ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
    
    Если ЗначениеЗаполнено(ПутьКФайлуЗагрузки) Тогда
        ПараметрыЗагрузки.Интерактивно = Ложь;
        // Удаляем двойные кавычки в начале и конце пути
        ПутьОчищенный = СтрЗаменить(ПутьКФайлуЗагрузки, """", "");
        ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки, ПутьОчищенный);
    Иначе
        ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
        ПараметрыЗагрузки.Диалог.Фильтр = "Файлы XML (*.xml)|*.xml";
        ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьПользователейВсеПриИзменении(Элемент)
    ВыгружатьВсе = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПротокол(Команда)
    ТаблицаПротоколаЗагрузки.Очистить();
    ИтогиЗагрузки = "";
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьВыгрузкуИзФормы(ВыгрузитьВсе = Ложь) 
    АдресФайлаДанныхВХранилище = ВыполнитьВыгрузкуНаСервере(ВыгрузитьВсе);
    Если АдресФайлаДанныхВХранилище = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ИмяСохраняемогоФайла = НСтр("ru = 'Файл выгрузки.xml'");
    НачатьПолучениеФайлаССервера(АдресФайлаДанныхВХранилище, ИмяСохраняемогоФайла);
КонецПроцедуры   

&НаСервере
Функция ВыполнитьВыгрузкуНаСервере(ВыгрузитьВсе)
    ИмяВременногоФайлаДанных = ИмяФайлаНаСервереИлиКлиенте();  
    КомпонентыОбмена = КомпонентыОбмена("Отправка");
    ППГД_ОбменДаннымиXDTOСервер.ОткрытьФайлВыгрузки(КомпонентыОбмена, ИмяВременногоФайлаДанных);
    ЕстьВыгруженныеОбъекты = Ложь;
    
    УстановитьПривилегированныйРежим(Истина);
    Попытка
        ППГД_МенеджерОбменаПравамиДоступа.ПередКонвертацией(КомпонентыОбмена);
    Исключение
        ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
        Возврат Неопределено;
    КонецПопытки;
    
    Запрос = Новый Запрос; 
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    ГруппыДоступа.Ссылка КАК Ссылка,
    |    ГруппыДоступа.ЭтоГруппа КАК ЭтоГруппа
    |ИЗ
    |    Справочник.ГруппыДоступа КАК ГруппыДоступа
    |ГДЕ
    |    НЕ ГруппыДоступа.ПометкаУдаления
    |    И ГруппыДоступа.ИмяПредопределенныхДанных = """"
    |    И ВЫБОР
    |            КОГДА &ВыгрузитьВсе
    |                ТОГДА ИСТИНА
    |            ИНАЧЕ ГруппыДоступа.Ссылка В (&ВыбранныеЭлементыСписков)
    |        КОНЕЦ
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |    ПрофилиГруппДоступа.Ссылка,
    |    ПрофилиГруппДоступа.ЭтоГруппа
    |ИЗ
    |    Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
    |ГДЕ
    |    НЕ ПрофилиГруппДоступа.ПометкаУдаления
    |    И ПрофилиГруппДоступа.ИдентификаторПоставляемыхДанных = &ИдентификаторПоставляемыхДанных
    |    И ВЫБОР
    |            КОГДА &ВыгрузитьВсе
    |                ТОГДА ИСТИНА
    |            ИНАЧЕ ПрофилиГруппДоступа.Ссылка В (&ВыбранныеЭлементыСписков)
    |        КОНЕЦ
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |    ГруппыПользователей.Ссылка,
    |    ИСТИНА КАК ЭтоГруппа
    |ИЗ
    |    Справочник.ГруппыПользователей КАК ГруппыПользователей
    |ГДЕ
    |    НЕ ГруппыПользователей.ПометкаУдаления
    |    И ГруппыПользователей.ИмяПредопределенныхДанных = """"
    |    И ВЫБОР
    |            КОГДА &ВыгрузитьВсе
    |                ТОГДА ИСТИНА
    |            ИНАЧЕ ГруппыПользователей.Ссылка В (&ВыбранныеЭлементыСписков)
    |        КОНЕЦ
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |    Пользователи.Ссылка,
    |    ЛОЖЬ КАК ЭтоГруппа
    |ИЗ
    |    Справочник.Пользователи КАК Пользователи
    |ГДЕ
    |    НЕ Пользователи.ПометкаУдаления
    |    И Пользователи.ИмяПредопределенныхДанных = """"
    |    И ВЫБОР
    |            КОГДА &ВыгрузитьВсе
    |                ТОГДА ИСТИНА
    |            ИНАЧЕ Пользователи.Ссылка В (&ВыбранныеЭлементыСписков)
    |        КОНЕЦ";
        
    Запрос.УстановитьПараметр("ВыгрузитьВсе", ВыгрузитьВсе);
    Запрос.УстановитьПараметр("ВыбранныеЭлементыСписков", ДанныеФормы.ВыбранныеЭлементыСписков);
    Запрос.УстановитьПараметр("ИдентификаторПоставляемыхДанных", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
    
    РезультатЗапроса = Запрос.Выполнить();
    Если РезультатЗапроса.Пустой() Тогда
        ОбщегоНазначения.СообщитьПользователю("Нет данных для выгрузки!");
        Возврат Неопределено;
    КонецЕсли;
    
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл   
        Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыДоступа") Тогда   
            Если Не Выборка.ЭтоГруппа Тогда 
                ППГД_ОбменДаннымиXDTOСервер.ВыгрузкаГруппыДоступа(КомпонентыОбмена, Выборка.Ссылка.ПолучитьОбъект());    
            Иначе 
                ППГД_ОбменДаннымиXDTOСервер.ВыгрузкаГруппыГруппыДоступа(КомпонентыОбмена, Выборка.Ссылка.ПолучитьОбъект());
            КонецЕсли;  
        ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ПрофилиГруппДоступа") Тогда   
            Если Не Выборка.ЭтоГруппа Тогда
                ППГД_ОбменДаннымиXDTOСервер.ВыгрузкаПрофиля(КомпонентыОбмена, Выборка.Ссылка.ПолучитьОбъект());    
            Иначе 
                ППГД_ОбменДаннымиXDTOСервер.ВыгрузкаГруппыПрофиля(КомпонентыОбмена, Выборка.Ссылка.ПолучитьОбъект());  
            КонецЕсли;
        ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыПользователей") Тогда
            ППГД_ОбменДаннымиXDTOСервер.ВыгрузкаГруппыПользователей(КомпонентыОбмена, Выборка.Ссылка.ПолучитьОбъект());
        ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.Пользователи") Тогда
            ППГД_ОбменДаннымиXDTOСервер.ВыгрузкаПользователя(КомпонентыОбмена, Выборка.Ссылка.ПолучитьОбъект());
        КонецЕсли;        
        ЕстьВыгруженныеОбъекты = ЕстьВыгруженныеОбъекты Или Не КомпонентыОбмена.ФлагОшибки;
    КонецЦикла;

    КомпонентыОбмена.ФайлОбмена.ЗаписатьКонецЭлемента(); // Body
    КомпонентыОбмена.ФайлОбмена.Закрыть();
    АдресФайлаДанных = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайлаДанных), УникальныйИдентификатор);
    Возврат АдресФайлаДанных;
КонецФункции

&НаСервере
Функция КомпонентыОбмена(НаправлениеОбмена, ВерсияФорматаОбменаПриЗагрузке = "", РасширениеФорматаПриЗагрузке = "") 
    КомпонентыОбмена = ППГД_ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена(НаправлениеОбмена);
    КомпонентыОбмена.КлючСообщенияЖурналаРегистрации = НСтр("ru = 'Перенос данных через буфер обмена'");
    КомпонентыОбмена.XMLСхема = "http://rules";
    Возврат КомпонентыОбмена;
КонецФункции

&НаСервере
Функция ИмяФайлаНаСервереИлиКлиенте()
    Возврат ПолучитьИмяВременногоФайла(".xml");
КонецФункции



&НаКлиенте
Процедура ПоместитьФайлВХранилищеЗавершить(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
    Если ПомещенныйФайл = Неопределено Тогда 
        Возврат; 
    КонецЕсли;
    АдресФайлаЗагрузки = ПомещенныйФайл.Хранение;
    
    Результат = ЗагрузитьДанныеНаСервере(АдресФайлаЗагрузки);
    
    Если Результат <> Неопределено Тогда
        ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.Итоги);
        
        ТаблицаПротоколаЗагрузки.Очистить();
        Для Каждого Стр Из Результат.Протокол Цикл
            НоваяСтр = ТаблицаПротоколаЗагрузки.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
        КонецЦикла;
    Иначе
        ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось загрузить данные.");
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗагрузкиДанных(Результат) Экспорт
    Если Результат = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Выводим итоги
    ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.Итоги);
    
    // Заполняем таблицу протокола
    ТаблицаПротоколаЗагрузки.Очистить();
    Для Каждого Стр Из Результат.Протокол Цикл
        НоваяСтр = ТаблицаПротоколаЗагрузки.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
    КонецЦикла;
КонецПроцедуры

