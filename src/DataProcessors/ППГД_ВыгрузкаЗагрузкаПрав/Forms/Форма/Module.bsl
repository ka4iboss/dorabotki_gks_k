&НаСервере
Функция ПолучитьВсеДочерниеСсылкиНаСервере(СсылкаНаГруппу)

    Результат = Новый Массив;
    
    Если Не ЗначениеЗаполнено(СсылкаНаГруппу) Тогда
        Возврат Результат;
    КонецЕсли;
    
    ТипСсылки = ТипЗнч(СсылкаНаГруппу);
    
    Если ТипСсылки = Тип("СправочникСсылка.ГруппыДоступа") Тогда
        ИмяСправочника = "Справочник.ГруппыДоступа";
    ИначеЕсли ТипСсылки = Тип("СправочникСсылка.ПрофилиГруппДоступа") Тогда
        ИмяСправочника = "Справочник.ПрофилиГруппДоступа";
    ИначеЕсли ТипСсылки = Тип("СправочникСсылка.ГруппыПользователей") Тогда
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |   Группы.Ссылка КАК Ссылка
            |ИЗ
            |   Справочник.ГруппыПользователей КАК Группы
            |ГДЕ
            |   Группы.Ссылка В ИЕРАРХИИ (&Группа)
            |   И Группы.Ссылка <> &Группа
            |   И НЕ Группы.ПометкаУдаления
            |
            |ОБЪЕДИНИТЬ
            |
            |ВЫБРАТЬ
            |   Состав.Пользователь КАК Ссылка
            |ИЗ
            |   Справочник.ГруппыПользователей.Состав КАК Состав
            |ГДЕ
            |   Состав.Ссылка.Ссылка В ИЕРАРХИИ (&Группа)
            |   И НЕ Состав.Пользователь.ПометкаУдаления";
        Запрос.УстановитьПараметр("Группа", СсылкаНаГруппу);
        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();
        Пока Выборка.Следующий() Цикл
            Результат.Добавить(Выборка.Ссылка);
        КонецЦикла;
        Возврат Результат;
    Иначе
        Возврат Результат;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Справочник.Ссылка КАК Ссылка
        |ИЗ
        |   " + ИмяСправочника + " КАК Справочник
        |ГДЕ
        |   Справочник.Ссылка В ИЕРАРХИИ (&Группа)
        |   И Справочник.Ссылка <> &Группа
        |   И НЕ Справочник.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("Группа", СсылкаНаГруппу);
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Добавить(Выборка.Ссылка);
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

&НаКлиенте
Процедура СнятьПоставитьПометкуСГруппой(ТекущаяПометка, Ссылка, ЭтоГруппа)
    Если ТекущаяПометка Тогда
        Индекс = ДанныеФормы.ВыбранныеЭлементыСписков.Найти(Ссылка);
        Если Индекс >= 0 Тогда ДанныеФормы.ВыбранныеЭлементыСписков.Удалить(Индекс); КонецЕсли;
        Если ЭтоГруппа Тогда
            Дочерние = ПолучитьВсеДочерниеСсылкиНаСервере(Ссылка);
            Для Каждого Дочерний Из Дочерние Цикл
                Инд = ДанныеФормы.ВыбранныеЭлементыСписков.Найти(Дочерний);
                Если Инд >= 0 Тогда ДанныеФормы.ВыбранныеЭлементыСписков.Удалить(Инд); КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    Иначе
        Если ДанныеФормы.ВыбранныеЭлементыСписков.Найти(Ссылка) = Неопределено Тогда
            ДанныеФормы.ВыбранныеЭлементыСписков.Добавить(Ссылка);
        КонецЕсли;
        Если ЭтоГруппа Тогда
            Дочерние = ПолучитьВсеДочерниеСсылкиНаСервере(Ссылка);
            Для Каждого Дочерний Из Дочерние Цикл
                Если ДанныеФормы.ВыбранныеЭлементыСписков.Найти(Дочерний) = Неопределено Тогда
                    ДанныеФормы.ВыбранныеЭлементыСписков.Добавить(Дочерний);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти



