&НаСервере
Функция ЗагрузитьДанныеНаСервере(АдресФайлаЗагрузки)
    
    СтруктураПараметров = Новый Структура;
    
    Попытка
        // Определяем путь к файлу
        Если ЗначениеЗаполнено(ПутьКФайлуЗагрузки) Тогда
            // Удаляем кавычки, если пользователь вставил путь из проводника
            ОчищенныйПуть = СтрЗаменить(ПутьКФайлуЗагрузки, """", "");
            АдресНаСервере = ОчищенныйПуть;
        Иначе
            ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаЗагрузки);
            АдресНаСервере = ПолучитьИмяВременногоФайла("xml");
            ДвоичныеДанные.Записать(АдресНаСервере);
            УдалитьИзВременногоХранилища(АдресФайлаЗагрузки);
        КонецЕсли;
        
        СтруктураПараметров.Вставить("АдресНаСервере", АдресНаСервере);
        
        АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
        
        // Вызов загрузки
        ППГД_ОбменДаннымиXDTOСервер.ЗагрузкаСообщения(СтруктураПараметров, АдресРезультата);
        
        РезультатыЗагрузки = ПолучитьИзВременногоХранилища(АдресРезультата);
        УдалитьИзВременногоХранилища(АдресРезультата);
        
    Исключение
        // В случае ошибки формируем протокол с её описанием
        РезультатыЗагрузки = Новый Структура;
        ТаблицаПротокола = Новый ТаблицаЗначений;
        ТаблицаПротокола.Колонки.Добавить("ТипОбъекта",   Новый ОписаниеТипов("Строка"));
        ТаблицаПротокола.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
        ТаблицаПротокола.Колонки.Добавить("Действие",     Новый ОписаниеТипов("Строка"));
        ТаблицаПротокола.Колонки.Добавить("Ошибка",       Новый ОписаниеТипов("Строка"));
        
        НоваяСтрока = ТаблицаПротокола.Добавить();
        НоваяСтрока.ТипОбъекта = "Ошибка";
        НоваяСтрока.Наименование = "Исключение при загрузке";
        НоваяСтрока.Действие = "";
        НоваяСтрока.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        
        РезультатыЗагрузки.Вставить("ТаблицаПротокола", ТаблицаПротокола);
        РезультатыЗагрузки.Вставить("Счетчики", Новый Структура);
    КонецПопытки;
    
    РезультатКлиент = Новый Структура;
    РезультатКлиент.Вставить("Итоги", "");
    РезультатКлиент.Вставить("Протокол", Новый Массив);
    
    Если РезультатыЗагрузки <> Неопределено Тогда
        
        Счетчики = РезультатыЗагрузки.Счетчики;
        Текст = "Загрузка завершена:" + Символы.ПС;
        Для Каждого КлючИЗначение Из Счетчики Цикл
            Счетчик = КлючИЗначение.Значение;
            Если Счетчик.Создано > 0 Или Счетчик.Обновлено > 0 Тогда
                Текст = Текст + Символы.ПС + КлючИЗначение.Ключ + ": создано " + Счетчик.Создано + ", обновлено " + Счетчик.Обновлено;
            КонецЕсли;
        КонецЦикла;
        Если Текст = "Загрузка завершена:" + Символы.ПС Тогда
            Текст = "Загрузка завершена. Новых или изменённых объектов не найдено.";
        КонецЕсли;
        РезультатКлиент.Итоги = Текст;
        
        МассивПротокола = Новый Массив;
        Для Каждого Строка Из РезультатыЗагрузки.ТаблицаПротокола Цикл
            СтруктураСтроки = Новый Структура;
            СтруктураСтроки.Вставить("ТипОбъекта",   Строка.ТипОбъекта);
            СтруктураСтроки.Вставить("Наименование", Строка.Наименование);
            СтруктураСтроки.Вставить("Действие",     Строка.Действие);
            СтруктураСтроки.Вставить("Ошибка",       Строка.Ошибка);
            МассивПротокола.Добавить(СтруктураСтроки);
        КонецЦикла;
        РезультатКлиент.Протокол = МассивПротокола;
    Иначе
        РезультатКлиент.Итоги = "Не удалось загрузить данные. Возможно, файл повреждён.";
    КонецЕсли;
    
    // Удаляем временный файл, если он был создан
    Если Не ЗначениеЗаполнено(ПутьКФайлуЗагрузки) Тогда
        Попытка
            УдалитьФайлы(АдресНаСервере);
        Исключение
            // Удаление временного файла не влияет на результат загрузки, фиксируем в журнале регистрации
            ЗаписьЖурналаРегистрации(НСтр("ru = 'ППГД_ВыгрузкаЗагрузкаПрав.УдалениеВременногоФайла'"),
                УровеньЖурналаРегистрации.Предупреждение, , ,
                ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЕсли;
    
    Возврат РезультатКлиент;
    
КонецФункции
