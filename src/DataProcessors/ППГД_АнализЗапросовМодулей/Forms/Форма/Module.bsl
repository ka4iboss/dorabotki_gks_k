#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проанализировать(Команда)
	
	КаталогМодулей = СокрЛП(Объект.КаталогМодулей);
	Если НЕ ЗначениеЗаполнено(КаталогМодулей) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог с текстами модулей.'"));
		Возврат;
	КонецЕсли;
	
	// Итоги предыдущего запуска больше не актуальны.
	ИтогиАнализа = "";
	
	ДлительнаяОперация = НачатьАнализНаСервере(КаталогМодулей);
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(ДлительнаяОперация.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Анализ запросов модулей'");
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Анализируются тексты модулей...'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("АнализЗавершен", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

// Показывает, что именно видит программа в указанном каталоге с текстами модулей:
// доступен ли каталог, сколько в нем элементов и файлов модулей.
// Проверка обходит все дерево каталогов, поэтому выполняется в фоновом задании.
//
&НаКлиенте
Процедура ПроверитьКаталог(Команда)
	
	КаталогМодулей = СокрЛП(Объект.КаталогМодулей);
	Если НЕ ЗначениеЗаполнено(КаталогМодулей) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите каталог с текстами модулей.'"));
		Возврат;
	КонецЕсли;
	
	ДлительнаяОперация = НачатьПроверкуКаталогаНаСервере(КаталогМодулей);
	
	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(ДлительнаяОперация.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.Заголовок = НСтр("ru = 'Проверка каталога с текстами модулей'");
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Просматриваются каталоги и файлы...'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Ложь;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПроверкаКаталогаЗавершена", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НачатьАнализНаСервере(Знач КаталогМодулей)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Анализ запросов модулей'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ППГД_АнализЗапросовСервер.ПроанализироватьМодули",
		КаталогМодулей,
		Истина);
	
КонецФункции

&НаКлиенте
Процедура АнализЗавершен(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	РезультатАнализа = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если ЗначениеЗаполнено(РезультатАнализа.Причина) Тогда
		ИтогиАнализа = РезультатАнализа.Причина;
		ПоказатьПредупреждение(, РезультатАнализа.Причина);
		Возврат;
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru = 'Анализ завершен. Файлов найдено: %1, модулей: %2, запросов: %3, пропущено запросов: %4, полей: %5.'");
	ИтогиАнализа = СтрШаблон(ШаблонСообщения, РезультатАнализа.ФайловНайдено,
		РезультатАнализа.Модулей, РезультатАнализа.Запросов,
		РезультатАнализа.ПропущенноЗапросов, РезультатАнализа.Полей);
	ПоказатьОповещениеПользователя(ИтогиАнализа);
	
КонецПроцедуры

&НаСервере
Функция НачатьПроверкуКаталогаНаСервере(Знач КаталогМодулей)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Проверка каталога с текстами модулей'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ППГД_АнализЗапросовСервер.ПроверитьДоступностьКаталога",
		КаталогМодулей);
	
КонецФункции

&НаКлиенте
Процедура ПроверкаКаталогаЗавершена(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	Проверка = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	ШаблонТекста = НСтр("ru = 'Каталог: %1
		|Доступен для программы: %2
		|Элементов в корне: %3 (каталогов: %4, файлов: %5)
		|Файлов модулей (bsl, txt) во всем каталоге: %6
		|Не прочитано каталогов при обходе: %7
		|Примеры файлов: %8
		|Первые элементы корня: %9
		|%10'");
	
	ПоказатьПредупреждение(, СтрШаблон(ШаблонТекста, Проверка.Каталог,
		?(Проверка.Доступен, НСтр("ru = 'да'"), НСтр("ru = 'нет'")),
		Проверка.ЭлементовВКорне, Проверка.КаталоговВКорне, Проверка.ФайловВКорне,
		Проверка.ФайловМодулей, Проверка.НеПрочитаноКаталогов, Проверка.ПримерыФайлов,
		Проверка.Примеры, Проверка.ТекстОшибки));
	
КонецПроцедуры

#КонецОбласти
