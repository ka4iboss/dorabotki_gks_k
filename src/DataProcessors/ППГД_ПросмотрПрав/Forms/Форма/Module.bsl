&НаСервере
&НаСервере
Процедура ОбновитьДеревоМетаданных(ТекстОтбора = "")
    ЭлементыДМ = ДеревоМетаданных.ПолучитьЭлементы();
    ЭлементыДМ.Очистить();
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    ЛОЖЬ КАК Выбран,
    |    ВЫРАЗИТЬ(ТабОбъектов.СтрМетаданные КАК СТРОКА(50)) КАК Метаданные,
    |    ВЫРАЗИТЬ(ТабОбъектов.СтрНаименование КАК СТРОКА(100)) КАК Объект
    |ПОМЕСТИТЬ СтрокиМета
    |ИЗ
    |    &ТабРез КАК ТабОбъектов
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    СтрокиМета.Выбран,
    |    СтрокиМета.Метаданные КАК Метаданные,
    |    СтрокиМета.Объект
    |ИЗ
    |    СтрокиМета КАК СтрокиМета
    |ГДЕ
    |    &ПустойОтбор ИЛИ СтрокиМета.Метаданные ПОДОБНО &ТекстОтбора
    |       ИЛИ СтрокиМета.Объект ПОДОБНО &ТекстОтбора
    |ИТОГИ ПО
    |    Метаданные";
    
    ТекТаб = Объект.ТЧМетаданные.Выгрузить();
    Запрос.УстановитьПараметр("ТабРез", ТекТаб);
    
    ПустойОтбор = ОтборПустой(ТекстОтбора);
    Запрос.УстановитьПараметр("ПустойОтбор", ПустойОтбор);
    Если НЕ ПустойОтбор Тогда
        Запрос.УстановитьПараметр("ТекстОтбора", "%" + СокрЛП(ТекстОтбора) + "%");
    Иначе
        Запрос.УстановитьПараметр("ТекстОтбора", "%");
    КонецЕсли;
    
    ДеревоРезультат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
    ЗначениеВРеквизитФормы(ДеревоРезультат, "ДеревоМетаданных");
КонецПроцедуры



