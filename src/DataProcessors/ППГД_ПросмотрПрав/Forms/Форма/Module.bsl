// НОВАЯ СЕРВЕРНАЯ ПРОЦЕДУРА - ЗАМЕНЯЕТ ВСЕ СТАРЫЕ
&НаСервере
Процедура ПересчитатьОбъединенныеРолиПользователей(ТекстОтбора, ТолькоУстановленные)
    // Получаем всех отмеченных пользователей
    МИдентификаторы = Новый Массив;
    Для Каждого Стр Из ТчПользователи Цикл
        Если Стр.Флаг Тогда
            МИдентификаторы.Добавить(Стр.Идентификатор);
        КонецЕсли;
    КонецЦикла;
    
    // Строим объединение ролей
    ОбъединенныеРоли = Новый Соответствие;
    Для Каждого Ид Из МИдентификаторы Цикл
        ТекПользователь = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Ид);
        Если ТекПользователь <> Неопределено Тогда
            Для Каждого РольПользователя Из ТекПользователь.Роли Цикл
                ОбъединенныеРоли.Вставить(РольПользователя.Имя, Истина);
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    
    // Заполняем таблицу ТчРолиПользователя с учётом объединения и фильтров
    ТчРолиПользователя.Очистить();
    СтрокаПоиска = ВРег(СокрЛП(ТекстОтбора));
    
    Для каждого Роль Из Метаданные.Роли Цикл
        // Текстовый фильтр
        Если НЕ ОтборПустой(ТекстОтбора) И СтрНайти(ВРег(Роль.Имя), СтрокаПоиска) = 0 Тогда
            Продолжить;
        КонецЕсли;
        
        Установлена = (ОбъединенныеРоли.Получить(Роль.Имя) <> Неопределено);
        
        // Фильтр "Только установленные"
        Если ТолькоУстановленные И НЕ Установлена Тогда
            Продолжить;
        КонецЕсли;
        
        НовСтр = ТчРолиПользователя.Добавить();
        НовСтр.Роль = Роль.Имя;
        НовСтр.Флаг = Ложь;
        НовСтр.Установлены = Установлена;
    КонецЦикла;
КонецПроцедуры

// НОВАЯ КЛИЕНТСКАЯ ПРОЦЕДУРА ДЛЯ ВЫЗОВА ПЕРЕСЧЁТА
