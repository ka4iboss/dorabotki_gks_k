&НаСервере
Процедура ТЧПрофилиПолучитьПраваНаСервере()
    
    ММета = ММетаМассив();
    СМета = СМетаМассив();
    //Для вывода прав администрирования
    МДополнение = Новый Массив;
    МДополнение.Добавить(Метаданные);
    ММета.Вставить(1, МДополнение);
    ОтчетПрофили.Очистить();
    
    ПараметрыОтбора = Новый Структура("Флаг", Истина);
    НайденныеСтроки = Объект.ТЧПрофили.НайтиСтроки(ПараметрыОтбора);
    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
    
    ОблШапки1 = Макет.ПолучитьОбласть("Шапка1");
    ОблШапки1.Параметры.ЗаголовокОсновной = "Отчет по профилям групп доступа";
    ОтчетПрофили.Вывести(ОблШапки1);
    
    ОблШапки2 = Макет.ПолучитьОбласть("Шапка2");
    
    ОблШапки3 = Макет.ПолучитьОбласть("Шапка3|Столбец");
    
    ОблСтрока = Макет.ПолучитьОбласть("Строка|Столбец");
    
    ОблПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
    
    ОблСтрокаОтбора = Макет.ПолучитьОбласть("СтрокаОтбора");
    
    //Выбранные значения
    ОблШапки2.Параметры.ЗаголовокТаблицы = "Выбранные профили:";
    ОтчетПрофили.Вывести(ОблШапки2);
    ОтчетПрофили.НачатьГруппуСтрок("Выбранные профили", Истина);
    
    ЗапросВсехРолей = Новый Запрос;
    ЗапросВсехРолей.Текст = 
        "ВЫБРАТЬ
        |	Роли.Ссылка КАК Профиль,
        |	Роли.Роль КАК Роль,
        |	Роли.Роль.Имя КАК ИмяРоли
        |ИЗ
        |	Справочник.ПрофилиГруппДоступа.Роли КАК Роли";
    ВсеРолиПрофилей = ЗапросВсехРолей.Выполнить().Выгрузить();
    
    Для Каждого Стр Из НайденныеСтроки Цикл
        ОблСтрокаОтбора.Параметры.ЗначениеОтбора = СокрЛП(Стр.Профиль);
        ОтчетПрофили.Вывести(ОблСтрокаОтбора);
    КонецЦикла;
    ОтчетПрофили.ЗакончитьГруппуСтрок();
    
    //Вывод результата отчета
    МРезультат = Новый Массив;
    ВывестиШапку = Истина;
    
    Для Каждого Стр Из НайденныеСтроки Цикл
        Если НЕ Стр.Флаг Тогда
            Продолжить;
        КонецЕсли;
        
        //Заголовок - Профиль группы доступа
        ОтчетПрофили.Вывести(ОблПустаяСтрока);
        НаименованиеПрофиля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Профиль, "Наименование");
        ОблШапки2.Параметры.ЗаголовокТаблицы = НаименованиеПрофиля;
        ОтчетПрофили.Вывести(ОблШапки2);
        ОтчетПрофили.НачатьГруппуСтрок(НаименованиеПрофиля, Истина);//Начало группировки
        
        РолиПрофиля = ВсеРолиПрофилей.НайтиСтроки(Новый Структура("Профиль", Стр.Профиль));
        
        Для н=1 по ММета.Количество()-1 Цикл
            Если Не ВывестиШапку Тогда//Значит уже выводили шапку, надо закрыть группировку
                ОтчетПрофили.ЗакончитьГруппуСтрок();
            КонецЕсли;
            ВывестиШапку = Истина;
            
            ПраваДляОпроса = ПолучитьПраваДляОпроса(СМета[н-1], Права8_3);
            
            Для Каждого ЭлМ Из ММета[н] Цикл
                
                МРезультат.Очистить();
                ФлагВыводить=Ложь;
                
                Для Каждого ПраваОбъекта Из ПраваДляОпроса Цикл
                    
                    Для Каждого РольТЧ из РолиПрофиля Цикл
                        
                        Попытка
                            РезультатОпроса = ПравоДоступа(ПраваОбъекта, ЭлМ, Метаданные.Роли[РольТЧ.ИмяРоли]);
                        Исключение
                            СообщитьПользователю(ОписаниеОшибки());
                            РезультатОпроса = Ложь;
                        КонецПопытки;
                        Если РезультатОпроса Тогда
                            Прервать;
                        КонецЕсли;
                        
                    КонецЦикла;
                    
                    МРезультат.Добавить(РезультатОпроса);
                    Если РезультатОпроса Тогда
                        ФлагВыводить = Истина;
                    КонецЕсли;
                    
                КонецЦикла;
                
                Если Не ФлагВыводить Тогда//Нет прав ни чего не выводим
                    Продолжить;
                КонецЕсли;
                
                Если ВывестиШапку Тогда//Один раз выводим шапку для каждого типа метаданных
                    //Заголовок - Документы
                    ОтчетПрофили.Вывести(ОблПустаяСтрока);
                    ОблШапки2.Параметры.ЗаголовокТаблицы = СМета[н-1];
                    ОтчетПрофили.Вывести(ОблШапки2);
                    ОтчетПрофили.НачатьГруппуСтрок(СМета[н-1], Истина);//Каждую табличку тоже свернем
                    
                    ОблШапки3.Параметры.ШапкаТаблицы = "Объект";
                    ОтчетПрофили.Вывести(ОблШапки3);
                    ОблШапки3.Параметры.ШапкаТаблицы = "Синоним объекта";
                    ОтчетПрофили.Присоединить(ОблШапки3);
                    Для Каждого ПраваОбъекта Из ПраваДляОпроса Цикл//Вывод шапки таблицы
                        ОблШапки3.Параметры.ШапкаТаблицы = ПраваОбъекта;
                        ОтчетПрофили.Присоединить(ОблШапки3);
                    КонецЦикла;
                    
                    ВывестиШапку = Ложь;
                КонецЕсли;
                
                //Теперь выводим строки
                ОблСтрока.Параметры.ЗначениеСтроки = ЭлМ.Имя;
                ОтчетПрофили.Вывести(ОблСтрока);
                ОблСтрока.Параметры.ЗначениеСтроки = ЭлМ.Синоним;
                ОтчетПрофили.Присоединить(ОблСтрока);
                Для м=0 По МРезультат.Количество()-1 Цикл
                    Если ЗначениеЗаполнено(МРезультат[м]) Тогда
                        ОблСтрока.Параметры.ЗначениеСтроки = Строка(МРезультат[м]);
                    Иначе
                        ОблСтрока.Параметры.ЗначениеСтроки = "";
                    КонецЕсли;
                    ОтчетПрофили.Присоединить(ОблСтрока);
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
        Если Не ВывестиШапку Тогда//Значит уже выводили шапку, надо закрыть группировку
            ОтчетПрофили.ЗакончитьГруппуСтрок();
        КонецЕсли;
        ОтчетПрофили.ЗакончитьГруппуСтрок();
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Процедура ТЧПрофилиПолучитьПользователейИРолиНаСервере()
    
    ОтчетПрофили.Очистить();
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
    
    ОблШапки1 = Макет.ПолучитьОбласть("Шапка1");
    ОблШапки1.Параметры.ЗаголовокОсновной = "Отчет по профилям групп доступа";
    ОтчетПрофили.Вывести(ОблШапки1);
    
    МПрофилей = Новый Массив;//Профили, по которым будем выводить отчет
    Для Каждого Стр Из Объект.ТЧПрофили Цикл
        Если Стр.Флаг Тогда
            МПрофилей.Добавить(Стр.Профиль);
        КонецЕсли;
    КонецЦикла;
    
    МПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей();
    
    КартаВхождения = ПостроитьКартуВхожденияПользователейВПрофили(МПользователей, МПрофилей);
    
    ОблШапкиП = Макет.ПолучитьОбласть("ШапкаП|СтолбецШ");
    ОблШапкиП.Параметры.КолонкиОтчета = "Пользователи";
    ОтчетПрофили.Вывести(ОблШапкиП);
    ОблШапкиП = Макет.ПолучитьОбласть("ШапкаП|СтолбецП");
    Для Каждого ТекПользователь Из МПользователей Цикл
        ОблШапкиП.Параметры.Пользователь = ТекПользователь.Имя;
        ОтчетПрофили.Присоединить(ОблШапкиП);
    КонецЦикла;
    
    ОблСтрокаП = Макет.ПолучитьОбласть("СтрокаП|СтолбецШ");
    ОблРезультат = Макет.ПолучитьОбласть("СтрокаП|СтолбецП");
    Для Каждого ТекПрофиль Из МПрофилей Цикл
        ОблСтрокаП.Параметры.Роль = ТекПрофиль.Наименование;
        ОтчетПрофили.Вывести(ОблСтрокаП);
        Для Каждого ТекПользователь Из МПользователей Цикл
            стрРезультат = "";
            ПоПрофилям = КартаВхождения.Получить(ТекПользователь.УникальныйИдентификатор);
            Если ПоПрофилям <> Неопределено И ПоПрофилям.Получить(ТекПрофиль) = Истина Тогда
                стрРезультат = "Да";
            КонецЕсли;
            ОблРезультат.Параметры.ЗначениеСтроки = стрРезультат;
            ОтчетПрофили.Присоединить(ОблРезультат);
            
        КонецЦикла;
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Функция ПостроитьКартуВхожденияПользователейВПрофили(МПользователей, МПрофилей)
    
    Результат = Новый Соответствие;
    
    СписокУИД = Новый Массив;
    Для Каждого ТекПользователь Из МПользователей Цикл
        СписокУИД.Добавить(ТекПользователь.УникальныйИдентификатор);
    КонецЦикла;
    
    Если СписокУИД.Количество() = 0 ИЛИ МПрофилей.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |    ГруппыДоступаПользователи.Пользователь.ИдентификаторПользователяИБ КАК УИД,
        |    ГруппыДоступаПользователи.Ссылка.Профиль КАК Профиль
        |ИЗ
        |    Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
        |ГДЕ
        |    ГруппыДоступаПользователи.Пользователь.ИдентификаторПользователяИБ В(&СписокУИД)
        |    И ГруппыДоступаПользователи.Ссылка.Профиль В(&СписокПрофилей)
        |    И НЕ ГруппыДоступаПользователи.Ссылка.ПометкаУдаления
        |    И НЕ ГруппыДоступаПользователи.Ссылка.Профиль.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("СписокУИД", СписокУИД);
    Запрос.УстановитьПараметр("СписокПрофилей", МПрофилей);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ПоПрофилям = Результат.Получить(Выборка.УИД);
        Если ПоПрофилям = Неопределено Тогда
            ПоПрофилям = Новый Соответствие;
            Результат.Вставить(Выборка.УИД, ПоПрофилям);
        КонецЕсли;
        ПоПрофилям.Вставить(Выборка.Профиль, Истина);
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Функция ПолучитьКартуАдресовЭППользователей(МПользователей)
    
    Результат = Новый Соответствие;
    
    СписокУИД = Новый Массив;
    Для Каждого ТекПользователь Из МПользователей Цикл
        СписокУИД.Добавить(ТекПользователь.УникальныйИдентификатор);
    КонецЦикла;
    
    Если СписокУИД.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ПользователиКонтактнаяИнформация.Ссылка.ИдентификаторПользователяИБ КАК УИД,
        |    ПользователиКонтактнаяИнформация.АдресЭП КАК АдресЭП
        |ИЗ
        |    Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
        |ГДЕ
        |    ПользователиКонтактнаяИнформация.Ссылка.ИдентификаторПользователяИБ В(&СписокУИД)
        |    И ПользователиКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
        |    И ПользователиКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПользователя)
        |    И НЕ ПользователиКонтактнаяИнформация.Ссылка.ПометкаУдаления";
    
    Запрос.УстановитьПараметр("СписокУИД", СписокУИД);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Результат.Получить(Выборка.УИД) = Неопределено Тогда
            Результат.Вставить(Выборка.УИД, Выборка.АдресЭП);
        КонецЕсли;
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

&НаСервере
Процедура ТЧМетаданныеПолучитьПрофилиНаСервере()
    
    ДеревоОбъект = РеквизитФормыВЗначение("ДеревоМетаданных");
    ПараметрыОтбора = Новый Структура("Выбран", 1);
    НайденныеСтроки = ДеревоОбъект.Строки.НайтиСтроки(ПараметрыОтбора, Истина);
    
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
    
    Выборка = ПолучитьВсеПрофилиГруппДоступа();
    
    ОтчетПрава.Очистить();
    
    ОблШапки1 = Макет.ПолучитьОбласть("Шапка1");
    ОблШапки1.Параметры.ЗаголовокОсновной = "Отчет по метаданным";
    ОтчетПрава.Вывести(ОблШапки1);
    
    ОблШапки2 = Макет.ПолучитьОбласть("Шапка2");
    
    ОблШапки3 = Макет.ПолучитьОбласть("Шапка3|Столбец");
    
    ОблСтрока = Макет.ПолучитьОбласть("Строка|Столбец");
    
    ОблПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
    
    ОблСтрокаОтбора = Макет.ПолучитьОбласть("СтрокаОтбора");
    
    //Вывод выбранных значений
    ОблШапки2.Параметры.ЗаголовокТаблицы = "Выбранные метаданные:";
    ОтчетПрава.Вывести(ОблШапки2);
    ОтчетПрава.НачатьГруппуСтрок("Выбранные метаданные", Истина);
    Для Каждого Стр Из НайденныеСтроки Цикл
        Если СокрЛП(Стр.Объект) = "" Тогда
            Продолжить;
        КонецЕсли;
        ОблСтрокаОтбора.Параметры.ЗначениеОтбора = СокрЛП(Стр.Метаданные)+": "+СокрЛП(Стр.Объект);
        ОтчетПрава.Вывести(ОблСтрокаОтбора);
    КонецЦикла;
    ОтчетПрава.ЗакончитьГруппуСтрок();
    
    //Вывод результата по правам
    ПраваДляОпроса = "";
    ПредЗнач = "";
    МРезультат = Новый Массив;
    ЗакрытьГруппу = Ложь;
    
    Для Каждого Стр Из НайденныеСтроки Цикл
        Если СокрЛП(Стр.Объект) = "" Тогда
            Продолжить;
        КонецЕсли;
        
        Если Стр.Метаданные <> ПредЗнач Тогда//Выводим шапку для метаданных
            Если ЗакрытьГруппу Тогда
                ОтчетПрава.ЗакончитьГруппуСтрок();
                ЗакрытьГруппу = Ложь;
            КонецЕсли;
            ОтчетПрава.Вывести(ОблПустаяСтрока);
            ОблШапки2.Параметры.ЗаголовокТаблицы = СокрЛП(Стр.Метаданные);
            ОтчетПрава.Вывести(ОблШапки2);
            ОтчетПрава.НачатьГруппуСтрок(СокрЛП(Стр.Метаданные), Истина);//Начало группировки
            ЗакрытьГруппу = Истина;
            ПраваДляОпроса = ПолучитьПраваДляОпроса(СокрЛП(Стр.Метаданные), Права8_3);//Это можно один раз получать
            ОблШапки3.Параметры.ШапкаТаблицы = "Объект";
            ОтчетПрава.Вывести(ОблШапки3);
            ОблШапки3.Параметры.ШапкаТаблицы = "Наименование профиля групп доступа";
            ОтчетПрава.Присоединить(ОблШапки3);
            Для Каждого ПраваОбъекта Из ПраваДляОпроса Цикл//Вывод шапки таблицы
                ОблШапки3.Параметры.ШапкаТаблицы = ПраваОбъекта;
                ОтчетПрава.Присоединить(ОблШапки3);
            КонецЦикла;
        КонецЕсли;
        ПредЗнач = Стр.Метаданные;
        
        //Проверяем по всем профилям групп доступа
        Пока Выборка.Следующий() Цикл
            
            ИдентификаторыРолей = Выборка.Профиль.Роли.ВыгрузитьКолонку("Роль");
            ПрочитанныеРоли = Справочники.ИдентификаторыОбъектовМетаданных.ОбъектыМетаданныхПоИдентификаторам(
                ИдентификаторыРолей, Истина);
            
            МРезультат.Очистить();
            ФлагВыводить=Ложь;
            //Проверим есть ли права у данной роли 
            Для Каждого ПраваОбъекта Из ПраваДляОпроса Цикл
                
                Для каждого Элемент из ПрочитанныеРоли Цикл
                    
                    Если СокрЛП(Стр.Метаданные) = "Метаданные" Тогда
                        РезультатОпроса = ПравоДоступа(ПраваОбъекта, Метаданные, Элемент.Значение);
                    Иначе
                        Попытка
                            РезультатОпроса = ПравоДоступа(ПраваОбъекта, Метаданные[СокрЛП(Стр.Метаданные)][СокрЛП(Стр.Объект)], Элемент.Значение);
                        Исключение
                            СообщитьПользователю(ОписаниеОшибки());
                            РезультатОпроса = Ложь;
                        КонецПопытки;
                    КонецЕсли;
                    
                    Если РезультатОпроса Тогда
                        ФлагВыводить = Истина;
                        Прервать;
                    КонецЕсли;
                    
                КонецЦикла;
                
                МРезультат.Добавить(РезультатОпроса);
                
            КонецЦикла;
            
            Если НЕ ФлагВыводить Тогда
                Продолжить;
            КонецЕсли;
            
            //Выводим результат по профилям
            //Имя профиля
            ОблСтрока.Параметры.ЗначениеСтроки = СокрЛП(Стр.Объект);
            ОтчетПрава.Вывести(ОблСтрока);
            ОблСтрока.Параметры.ЗначениеСтроки = Выборка.Профиль.Наименование;
            ОтчетПрава.Присоединить(ОблСтрока);
            //Результат по объекту
            Для н=0 По МРезультат.Количество()-1 Цикл
                Если ЗначениеЗаполнено(МРезультат[н]) Тогда
                    ОблСтрока.Параметры.ЗначениеСтроки = Строка(МРезультат[н]);
                Иначе
                    ОблСтрока.Параметры.ЗначениеСтроки = "";
                КонецЕсли;
                ОтчетПрава.Присоединить(ОблСтрока);
            КонецЦикла;
        КонецЦикла;
        Выборка.Сбросить();
        
        ПредЗнач = Стр.Метаданные;
    КонецЦикла;
    Если ЗакрытьГруппу Тогда//Закроем последнюю группировку
        ОтчетПрава.ЗакончитьГруппуСтрок();
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура ТЧРолиПолучитьПрофилиНаСервере()
    
    ОтчетРоли.Очистить();
    ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
    Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
    
    ОблШапки1 = Макет.ПолучитьОбласть("Шапка1");
    ОблШапки1.Параметры.ЗаголовокОсновной = "Отчет по профилям групп доступа с указанными ролями";
    ОтчетРоли.Вывести(ОблШапки1);
    
    МРолей = Новый Массив;//Состав ролей по которым будем выводить отчет
    Для Каждого Стр Из Объект.ТЧРоли Цикл
        Если Стр.Флаг Тогда
            МРолей.Добавить(Стр.Роль);
        КонецЕсли;
    КонецЦикла;
    
    Выборка = ПолучитьВсеПрофилиГруппДоступа();
    
    ОблШапкиП = Макет.ПолучитьОбласть("ШапкаП|СтолбецШ");
    ОблШапкиП.Параметры.КолонкиОтчета = "Профили";
    ОтчетРоли.Вывести(ОблШапкиП);
    ОблШапкиП = Макет.ПолучитьОбласть("ШапкаП|СтолбецП");
    Пока Выборка.Следующий() Цикл
        ОблШапкиП.Параметры.Пользователь = Выборка.Профиль.Наименование;
        ОтчетРоли.Присоединить(ОблШапкиП);
    КонецЦикла;
    Выборка.Сбросить();
    
    ОблСтрокаП = Макет.ПолучитьОбласть("СтрокаП|СтолбецШ");
    ОблРезультат = Макет.ПолучитьОбласть("СтрокаП|СтолбецП");
    
    Для Каждого ТекРоль Из МРолей Цикл
        ОблСтрокаП.Параметры.Роль = ТекРоль;
        ОтчетРоли.Вывести(ОблСтрокаП);
        Пока Выборка.Следующий() Цикл
            
            стрРезультат = "";
            Для каждого РольПрофиля из Выборка.Профиль.Роли Цикл
                Если РольПрофиля.Роль.Имя = ТекРоль Тогда
                    стрРезультат = "Да";
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            ОблРезультат.Параметры.ЗначениеСтроки = стрРезультат;
            ОтчетРоли.Присоединить(ОблРезультат);
        КонецЦикла;
        Выборка.Сбросить();
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьВсеПрофилиГруппДоступа()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ПрофилиГруппДоступа.Ссылка КАК Профиль
        |ИЗ
        |    Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
        |ГДЕ
        |    НЕ ПрофилиГруппДоступа.ПометкаУдаления";
    
    РезультатЗапроса = Запрос.Выполнить();
    Возврат РезультатЗапроса.Выбрать();
    
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователю(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

