#Область ОписаниеПеременных

&НаКлиенте
Перем ОбъединяемыеСсылки;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОтмеченныеДубли = Новый СписокЗначений;
	СпособУдаления = Перечисления.ГКСК_СпособУдаленияДублей.Пометка;
	ОригиналПредставление = НСтр("ru = 'Оригинал не выбран'");
	ЕстьПравоПерехода = ГКСК_ВерсииОбъектовСервер.ЕстьПравоПереходаНаВерсию();

	Элементы.ПолеЦелеваяВерсия.СписокВыбора.Очистить();
	Элементы.ПолеЦелеваяВерсия.СписокВыбора.Добавить("Текущая", НСтр("ru = 'Текущая версия'"));
	Элементы.ПолеЦелеваяВерсия.СписокВыбора.Добавить("Прошлая", НСтр("ru = 'Прошлая версия'"));
	Элементы.ПолеЦелеваяВерсия.СписокВыбора.Добавить("Первая", НСтр("ru = 'Первая версия'"));
	ЦелеваяВерсия = "Текущая";

	Если ПустаяСтрока(ИмяОбъекта) Тогда
		ИмяОбъекта = "Справочник.Номенклатура";
	КонецЕсли;

	ЗаполнитьСписокОбъектовМетаданных();
	ОбновитьСписок();
	ОбновитьСостояние();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеОбъектаМетаданныхПриИзменении(Элемент)

	ПрименитьВыборОбъекта();

КонецПроцедуры

&НаКлиенте
Процедура ПолеПоискаПриИзменении(Элемент)

	ПрименитьОтборПоНаименованию();

КонецПроцедуры

&НаКлиенте
Процедура ПолеТолькоРазличияПриИзменении(Элемент)

	ЗаполнитьВерсии();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаСписка

&НаКлиенте
Процедура СписокЭлементовПриАктивизацииСтроки(Элемент)

	ОбновитьВерсииДляТекущейСтроки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьОригинал(Команда)

	Ссылка = ТекущаяСсылка();
	Если Ссылка = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите элемент в списке.'"));
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = Элементы.ТаблицаСписка.ТекущаяСтрока;
	УстановитьОригинал(Ссылка);
	ВосстановитьПозициюСписка(ИдентификаторСтроки);
	ОбновитьСостояние();
	ЗаполнитьВерсии();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьДубли(Команда)

	Ссылки = ВыделенныеСсылки();
	Если Ссылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите элементы в списке.'"));
		Возврат;
	КонецЕсли;

	ИдентификаторСтроки = Элементы.ТаблицаСписка.ТекущаяСтрока;
	ДобавитьДубли(Ссылки);
	ВосстановитьПозициюСписка(ИдентификаторСтроки);
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	ОчиститьОтметки();
	ОбновитьСостояние();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМестаИспользования(Команда)

	НаборСсылок = НаборСсылокСервер();
	Если НаборСсылок.Количество() < 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте оригинал и хотя бы один дубль.'"));
		Возврат;
	КонецЕсли;

	ПоискИУдалениеДублейКлиент.ПоказатьМестаИспользования(НаборСсылок);

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьМестаИспользования(Команда)

	НаборСсылок = НаборСсылокСервер();
	Если НаборСсылок.Количество() < 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте оригинал и хотя бы один дубль.'"));
		Возврат;
	КонецЕсли;

	Состояние = НСтр("ru = 'Расчет мест использования...'");
	Задание = ЗапуститьОпределениеМестИспользования(НаборСсылок);

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Ложь;

	Оповещение = Новый ОписаниеОповещения("ПослеОпределенияМестИспользования", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, Оповещение, НастройкиОжидания);

КонецПроцедуры

&НаКлиенте
Процедура Объединить(Команда)

	НаборСсылок = НаборСсылокСервер();
	Если НаборСсылок.Количество() < 2 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте оригинал и хотя бы один дубль.'"));
		Возврат;
	КонецЕсли;

	ТекстОшибки = ПроверитьПередОбъединением(НаборСсылок);
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;

	ОбъединяемыеСсылки = НаборСсылок;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияОбъединения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопросаОбъединения(), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаТекущую(Команда)

	ЗапроситьПереходНаВерсию("Текущая");

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаПрошлую(Команда)

	ЗапроситьПереходНаВерсию("Прошлая");

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаПервую(Команда)

	ЗапроситьПереходНаВерсию("Первая");

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетПоВерсии(Команда)

	ТипВерсии = ?(ПустаяСтрока(ЦелеваяВерсия), "Текущая", ЦелеваяВерсия);
	ТабличныйДокумент = ОтчетПоВерсииНаСервере(ТипВерсии);

	Если ТабличныйДокумент = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку в списке элементов.'"));
		Возврат;
	КонецЕсли;

	ТабличныйДокумент.ОтображатьЗаголовки = Истина;
	ТабличныйДокумент.Показать(НСтр("ru = 'Отчёт по версии'"));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВерсии(Команда)

	ОбновитьВерсииДляТекущейСтроки();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокОбъектовМетаданных()

	СписокОбъектов = ГКСК_ОбъединениеЭлементовСервер.ОбъектыДляВыбора();

	Элементы.ПолеОбъектаМетаданных.СписокВыбора.Очистить();
	Элементы.ПолеОбъектаМетаданных.РежимВыбораИзСписка = Истина;

	Для Каждого ЭлементСписка Из СписокОбъектов Цикл
		Элементы.ПолеОбъектаМетаданных.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеОпределенияМестИспользования(Задание, ДополнительныеПараметры) Экспорт

	Если Задание = Неопределено Или Задание.Статус <> "Выполнено" Тогда
		Состояние = НСтр("ru = 'Не удалось рассчитать места использования:'")
			+ " " + ?(Задание = Неопределено, "", Задание.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	ЗаполнитьСводкуМестИспользования(Задание.АдресРезультата);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОбъединения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Состояние = НСтр("ru = 'Объединение элементов...'");
	Задание = ЗапуститьЗаменуСсылок();

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Ложь;

	Оповещение = Новый ОписаниеОповещения("ПослеЗаменыСсылок", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, Оповещение, НастройкиОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаменыСсылок(Задание, ДополнительныеПараметры) Экспорт

	Если Задание = Неопределено Или Задание.Статус <> "Выполнено" Тогда
		Состояние = НСтр("ru = 'Не удалось выполнить объединение:'")
			+ " " + ?(Задание = Неопределено, "", Задание.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;

	ТекстРезультата = ОбработатьРезультатЗамены(Задание.АдресРезультата);
	Состояние = ТекстРезультата;

	Если ОбъединяемыеСсылки.Количество() > 0 Тогда
		ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъектов(ОбъединяемыеСсылки);
	КонецЕсли;

	ОбъединяемыеСсылки = Новый Массив;
	ОбновитьВерсииДляТекущейСтроки();

КонецПроцедуры

&НаСервере
Процедура ПрименитьВыборОбъекта()

	СтрокаПоиска = "";
	ОтмеченныеДубли.Очистить();
	ОригиналСтрокой = "";
	ОригиналПредставление = НСтр("ru = 'Оригинал не выбран'");
	СводкаМестИспользования.Очистить();
	ВыбранныйОбъектСтрокой = "";
	ОчиститьСведенияОВерсиях();

	ОбновитьСписок();
	ПрименитьОтборПоНаименованию();
	ОбновитьСостояние();

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборПоНаименованию()

	СписокЭлементов.Отбор.Элементы.Очистить();

	Если Не ПустаяСтрока(СтрокаПоиска) Тогда
		ЭлементОтбора = СписокЭлементов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Наименование");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
		ЭлементОтбора.ПравоеЗначение = СтрокаПоиска;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СпособУдаленияДляЗамены()

	Если СпособУдаления = Перечисления.ГКСК_СпособУдаленияДублей.ТолькоЗамена Тогда
		Возврат "";
	ИначеЕсли СпособУдаления = Перечисления.ГКСК_СпособУдаленияДублей.НепосредственноеУдаление Тогда
		Возврат "Непосредственно";
	КонецЕсли;

	Возврат "Пометка";

КонецФункции

&НаСервере
Процедура ОбновитьСписок()

	ТекстЗапроса = "";
	Если Не ПустаяСтрока(ИмяОбъекта) Тогда
		ТекстЗапроса = ГКСК_ОбъединениеЭлементовСервер.ТекстЗапросаСписка(ИмяОбъекта);
	КонецЕсли;

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Состояние = НСтр("ru = 'Не удалось построить список для выбранного объекта метаданных.'");
		Возврат;
	КонецЕсли;

	СписокЭлементов.ТекстЗапроса = ТекстЗапроса;
	СписокЭлементов.Параметры.УстановитьЗначениеПараметра("Оригинал", ОригиналЗначение());
	СписокЭлементов.Параметры.УстановитьЗначениеПараметра("ОтмеченныеДубли", ОтмеченныеДубли.ВыгрузитьЗначения());

	Элементы.ТаблицаСписка.Обновить();

КонецПроцедуры

&НаСервере
Функция ОригиналЗначение()

	Если ПустаяСтрока(ОригиналСтрокой) Тогда
		Возврат ПустаяСсылкаОбъекта();
	КонецЕсли;

	Попытка
		Возврат ЗначениеИзСтрокиВнутр(ОригиналСтрокой);
	Исключение
		Возврат ПустаяСсылкаОбъекта();
	КонецПопытки;

КонецФункции

&НаСервере
Функция ПустаяСсылкаОбъекта()

	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяОбъекта);
	Если МенеджерОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат МенеджерОбъекта.ПустаяСсылка();

КонецФункции

&НаСервере
Функция ПредставлениеОригинала()

	Если ПустаяСтрока(ОригиналСтрокой) Тогда
		Возврат НСтр("ru = 'Оригинал не выбран'");
	КонецЕсли;

	Возврат Строка(ОригиналЗначение());

КонецФункции

&НаКлиенте
Процедура ВосстановитьПозициюСписка(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы.ТаблицаСписка.ТекущаяСтрока = ИдентификаторСтроки;

КонецПроцедуры

&НаКлиенте
Функция ТекущаяСсылка()

	Если Элементы.ТаблицаСписка.ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Элементы.ТаблицаСписка.ТекущиеДанные.ЭлементСсылка;

КонецФункции

&НаКлиенте
Функция ВыделенныеСсылки()

	Результат = Новый Массив;

	Для Каждого ИдентификаторСтроки Из Элементы.ТаблицаСписка.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.ТаблицаСписка.ДанныеСтроки(ИдентификаторСтроки);
		Если ДанныеСтроки <> Неопределено Тогда
			Результат.Добавить(ДанныеСтроки.ЭлементСсылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьОригинал(Знач Ссылка)

	ОригиналСтрокой = ЗначениеВСтрокуВнутр(Ссылка);
	ОригиналПредставление = Строка(Ссылка);

	НайденныйЭлемент = ОтмеченныеДубли.НайтиПоЗначению(Ссылка);
	Если НайденныйЭлемент <> Неопределено Тогда
		ОтмеченныеДубли.Удалить(НайденныйЭлемент);
	КонецЕсли;

	ОбновитьСписок();

КонецПроцедуры

&НаСервере
Процедура ДобавитьДубли(Знач МассивСсылок)

	Оригинал = ОригиналЗначение();

	Для Каждого Ссылка Из МассивСсылок Цикл
		Если Ссылка = Оригинал Тогда
			Продолжить;
		КонецЕсли;
		Если ОтмеченныеДубли.НайтиПоЗначению(Ссылка) = Неопределено Тогда
			ОтмеченныеДубли.Добавить(Ссылка, Строка(Ссылка));
		КонецЕсли;
	КонецЦикла;

	ОбновитьСписок();

КонецПроцедуры

&НаСервере
Процедура ОчиститьОтметки()

	ОтмеченныеДубли = Новый СписокЗначений;
	ОригиналСтрокой = "";
	ОригиналПредставление = НСтр("ru = 'Оригинал не выбран'");
	СводкаМестИспользования.Очистить();

	ОбновитьСписок();

КонецПроцедуры

&НаСервере
Функция НаборСсылокСервер()

	Результат = Новый Массив;

	Оригинал = ОригиналЗначение();
	Если ЗначениеЗаполнено(Оригинал) Тогда
		Результат.Добавить(Оригинал);
	КонецЕсли;

	Для Каждого ЭлементСписка Из ОтмеченныеДубли Цикл
		Результат.Добавить(ЭлементСписка.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПарыЗамен()

	Результат = Новый Соответствие;
	Оригинал = ОригиналЗначение();

	Для Каждого ЭлементСписка Из ОтмеченныеДубли Цикл
		Результат.Вставить(ЭлементСписка.Значение, Оригинал);
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверитьПередОбъединением(Знач НаборСсылок)

	Проверка = ГКСК_ОбъединениеЭлементовСервер.ПроверитьНабор(НаборСсылок);
	Если Не Проверка.Успех Тогда
		Возврат Проверка.ТекстОшибки;
	КонецЕсли;

	Возврат ГКСК_ОбъединениеЭлементовСервер.ПроверитьВозможностьЗамены(ПарыЗамен(), СпособУдаленияДляЗамены());

КонецФункции

&НаСервере
Функция ТекстВопросаОбъединения()

	КоличествоДублей = ОтмеченныеДубли.Количество();

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Объединить элементов: %1, в ""%2""?
			|Ссылки на дубли будут заменены во всех местах использования.'"),
		КоличествоДублей, ПредставлениеОригинала());

КонецФункции

&НаСервере
Функция ЗапуститьОпределениеМестИспользования(Знач НаборСсылок)

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("НаборСсылок", НаборСсылок);
	ПараметрыЗапуска.Вставить("ПараметрыПоиска", ОбщегоНазначения.ПараметрыПоискаМестИспользования());

	НастройкиЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	НастройкиЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Объединение элементов: места использования'");

	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ГКСК_ОбъединениеЭлементовСервер.ОпределитьМестаИспользованияФон", ПараметрыЗапуска, НастройкиЗапуска);

КонецФункции

&НаСервере
Процедура ЗаполнитьСводкуМестИспользования(Знач АдресРезультата)

	ТаблицаРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТаблицаРезультата = Неопределено Тогда
		Состояние = НСтр("ru = 'Результат расчета мест использования не получен.'");
		Возврат;
	КонецЕсли;

	СводкаМестИспользования.Очистить();

	ВсегоМест = 0;
	Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
		НоваяСтрока = СводкаМестИспользования.Добавить();
		НоваяСтрока.Представление = Строка(СтрокаРезультата.Ссылка);
		НоваяСтрока.МестИспользования = СтрокаРезультата.Вхождения;
		ВсегоМест = ВсегоМест + СтрокаРезультата.Вхождения;
	КонецЦикла;

	Состояние = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Мест использования найдено: %1. Проверьте перечень перед объединением.'"), ВсегоМест);

КонецПроцедуры

&НаСервере
Функция ЗапуститьЗаменуСсылок()

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ПарыЗамен", ПарыЗамен());
	ПараметрыЗапуска.Вставить("СпособУдаления", СпособУдаленияДляЗамены());

	НастройкиЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	НастройкиЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Объединение элементов: замена ссылок'");

	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"ГКСК_ОбъединениеЭлементовСервер.ЗаменитьСсылкиФон", ПараметрыЗапуска, НастройкиЗапуска);

КонецФункции

&НаСервере
Функция ОбработатьРезультатЗамены(Знач АдресРезультата)

	РезультатЗамены = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(РезультатЗамены) <> Тип("Структура") Тогда
		ОчиститьОтметки();
		Возврат НСтр("ru = 'Объединение выполнено.'");
	КонецЕсли;

	ОшибкиЗамены = РезультатЗамены.ОшибкиЗамены;
	ЧастиСообщения = Новый Массив;

	Если ОшибкиЗамены.Количество() = 0 Тогда
		ЧастиСообщения.Добавить(НСтр("ru = 'Объединение выполнено.'"));
	Иначе
		ЧастиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Объединение выполнено с ошибками замены: %1.'"), ОшибкиЗамены.Количество()));

		МаксимумСтрок = 10;
		Для Каждого СтрокаОшибки Из ОшибкиЗамены Цикл
			Если ЧастиСообщения.Количество() > МаксимумСтрок Тогда
				Прервать;
			КонецЕсли;
			ЧастиСообщения.Добавить(Строка(СтрокаОшибки.Ссылка) + ": " + СтрокаОшибки.ТипОшибки
				+ ?(ПустаяСтрока(СтрокаОшибки.ТекстОшибки), "", " — " + СтрокаОшибки.ТекстОшибки));
		КонецЦикла;
	КонецЕсли;

	Если РезультатЗамены.Свойство("СпособУдаления") И РезультатЗамены.СпособУдаления = "Пометка" Тогда
		ЧастиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Помечено на удаление дублей: %1.'"), РезультатЗамены.Помечено));
	КонецЕсли;

	НеОбработано = Новый Массив;
	Если РезультатЗамены.Свойство("НеОбработано") Тогда
		НеОбработано = РезультатЗамены.НеОбработано;
	КонецЕсли;

	Если НеОбработано.Количество() > 0 Тогда
		ЧастиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не помещено на удаление дублей: %1.'"), НеОбработано.Количество()));

		МаксимумСтрок = ЧастиСообщения.Количество() + 10;
		Для Каждого СтрокаНеОбработки Из НеОбработано Цикл
			Если ЧастиСообщения.Количество() >= МаксимумСтрок Тогда
				Прервать;
			КонецЕсли;
			ЧастиСообщения.Добавить(СтрокаНеОбработки);
		КонецЦикла;
	КонецЕсли;

	Предупреждения = Новый Массив;
	Если РезультатЗамены.Свойство("Предупреждения") Тогда
		Предупреждения = РезультатЗамены.Предупреждения;
	КонецЕсли;

	Если Предупреждения.Количество() > 0 Тогда
		ЧастиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Помечено с предупреждениями: %1.'"), Предупреждения.Количество()));
		Для Каждого СтрокаПредупреждения Из Предупреждения Цикл
			ЧастиСообщения.Добавить(СтрокаПредупреждения);
		КонецЦикла;
	КонецЕсли;

	Если ОшибкиЗамены.Количество() = 0 И НеОбработано.Количество() = 0 Тогда
		ОчиститьОтметки();
	КонецЕсли;

	ОбновитьСписок();

	Возврат СтрСоединить(ЧастиСообщения, Символы.ПС);

КонецФункции

&НаСервере
Процедура ОбновитьСостояние()

	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Состояние = НСтр("ru = 'Выберите объект метаданных и отметьте оригинал и дубли.'");
		Возврат;
	КонецЕсли;

	Состояние = НСтр("ru = 'Оригинал:'") + " " + ОригиналПредставление
		+ НСтр("ru = '. Отмечено дублей:'") + " " + Строка(ОтмеченныеДубли.Количество());

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВерсииДляТекущейСтроки()

	ОбновитьВыбраннуюСсылку();
	ЗаполнитьВерсии();

КонецПроцедуры

&НаСервере
Процедура ОбновитьВыбраннуюСсылку()

	Ссылка = Неопределено;
	Если Элементы.ТаблицаСписка.ТекущиеДанные <> Неопределено Тогда
		Ссылка = Элементы.ТаблицаСписка.ТекущиеДанные.ЭлементСсылка;
	КонецЕсли;

	ВыбранныйОбъектСтрокой = ?(ЗначениеЗаполнено(Ссылка), ЗначениеВСтрокуВнутр(Ссылка), "");

КонецПроцедуры

&НаСервере
Функция ВыбраннаяСсылка()

	Если ПустаяСтрока(ВыбранныйОбъектСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ЗначениеИзСтрокиВнутр(ВыбранныйОбъектСтрокой);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервере
Процедура ОчиститьСведенияОВерсиях()

	ТаблицаРазличий.Очистить();
	ПодписьТекущая = "";
	ПодписьПрошлая = "";
	ПодписьПервая = "";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВерсии()

	ОчиститьСведенияОВерсиях();

	Данные = ВыбраннаяСсылка();
	Если Не ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(Данные) Тогда
		Возврат;
	КонецЕсли;

	Сведения = ГКСК_ВерсииОбъектовСервер.СведенияОВерсиях(Данные);

	Если Сведения.Текущая <> Неопределено Тогда
		ПодписьТекущая = Сведения.Текущая.Представление;
	КонецЕсли;
	Если Сведения.Прошлая <> Неопределено Тогда
		ПодписьПрошлая = Сведения.Прошлая.Представление;
	КонецЕсли;
	Если Сведения.Первая <> Неопределено Тогда
		ПодписьПервая = Сведения.Первая.Представление;
	КонецЕсли;

	Для Каждого СтрокаРазличия Из ГКСК_ВерсииОбъектовСервер.ТаблицаРазличийВерсий(Данные) Цикл
		Если ТолькоРазличия И Не СтрокаРазличия.ЕстьРазличие Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТаблицаРазличий.Добавить(), СтрокаРазличия);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПереходНаВерсию(Знач ТипВерсии)

	Если Не ЕстьПравоПерехода Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Недостаточно прав для перехода на версию объекта.'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ВыбранныйОбъектСтрокой) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку в списке элементов.'"));
		Возврат;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТипВерсии", ТипВерсии);

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПереходаНаВерсию", ЭтотОбъект, ДополнительныеПараметры);
	ПоказатьВопрос(Оповещение,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Восстановить версию ""%1""? Текущие данные объекта будут заменены.'"), ТипВерсии),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияПереходаНаВерсию(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = ПерейтиНаВерсиюНаСервере(ДополнительныеПараметры.ТипВерсии);

	Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, Результат.ТекстОшибки);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Версия восстановлена'"));
	КонецЕсли;

	ОбновитьВерсииДляТекущейСтроки();

КонецПроцедуры

&НаСервере
Функция ПерейтиНаВерсиюНаСервере(Знач ТипВерсии)

	Результат = Новый Структура;
	Результат.Вставить("Статус", "");
	Результат.Вставить("ТекстОшибки", "");

	Данные = ВыбраннаяСсылка();
	Если Не ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(Данные) Тогда
		Результат.ТекстОшибки = НСтр("ru = 'Выберите объект для перехода на версию.'");
		Возврат Результат;
	КонецЕсли;

	НомерВерсии = ГКСК_ВерсииОбъектовСервер.НомерВерсииПоТипу(Данные, ТипВерсии);
	Если НомерВерсии = Неопределено Тогда
		Результат.ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Версия ""%1"" не найдена.'"), ТипВерсии);
		Возврат Результат;
	КонецЕсли;

	Сведения = ГКСК_ВерсииОбъектовСервер.СведенияОВерсиях(Данные);
	ТекстОшибки = "";

	Результат.Статус = ГКСК_ВерсииОбъектовСервер.ПерейтиНаВерсию(Данные, НомерВерсии, ТекстОшибки, Сведения.Источник);

	Если Результат.Статус <> "ВосстановлениеВыполнено" Тогда
		Результат.ТекстОшибки = ?(ПустаяСтрока(ТекстОшибки),
			НСтр("ru = 'Не удалось восстановить версию объекта.'"), ТекстОшибки);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ОтчетПоВерсииНаСервере(Знач ТипВерсии)

	Данные = ВыбраннаяСсылка();
	Если Не ГКСК_ВерсииОбъектовСервер.ЕстьДанныеДляПросмотраВерсий(Данные) Тогда
		Возврат Неопределено;
	КонецЕсли;

	НомерВерсии = ГКСК_ВерсииОбъектовСервер.НомерВерсииПоТипу(Данные, ТипВерсии);

	Возврат ГКСК_ВерсииОбъектовСервер.ОтчетПоВерсии(Данные, НомерВерсии);

КонецФункции

#КонецОбласти
