
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Параметры.Свойство("ПрофильГруппыДоступа", Объект.ПрофильГруппыДоступа);
	ОбъектыПрофиля = Неопределено;
	Если Параметры.Свойство("ОбъектыПрофиля", ОбъектыПрофиля) Тогда
		РеквизитыОбъектовМетаданных = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ОбъектыПрофиля, "ПолноеИмя,Синоним");
		Для Каждого Элемент Из ОбъектыПрофиля Цикл
			СтрокаТабличнойЧасти = Объект.ОбъектыПрофиля.Добавить();
			СтрокаТабличнойЧасти.ОбъектМетаданных = Элемент;
			РеквизитыОбъектаМетаданных = РеквизитыОбъектовМетаданных[Элемент];
			Если РеквизитыОбъектаМетаданных = Неопределено Тогда
				СписокОбъектовПрофиля.Добавить(Элемент);
			Иначе
				ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, РеквизитыОбъектаМетаданных);
				СписокОбъектовПрофиля.Добавить(Элемент, РеквизитыОбъектаМетаданных.Синоним);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЗаполнитьСписокОбъектовПрофиля();
	КонецЕсли;
	
	ЗаполнитьСписокРолейИсключения();
	ЗаполнитьДанныеОбъектовПрофиля();
	
	РолиПрофиляПараметр = Неопределено;
	Если Параметры.Свойство("РолиПрофиля", РолиПрофиляПараметр) Тогда
		РеквизитыРолей = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(РолиПрофиляПараметр, "Имя");
		РолиПрофиля = Новый Соответствие;
		Для Каждого Элемент Из РолиПрофиляПараметр Цикл
			РеквизитыРоли = РеквизитыРолей[Элемент];
			Если РеквизитыРоли = Неопределено Тогда
				// Роль из состава профиля не найдена в конфигурации (удалена или переименована).
				Продолжить;
			КонецЕсли;
			РолиПрофиля.Вставить(РеквизитыРоли.Имя, Истина);
		КонецЦикла;
		Для Каждого СтрокаТабличнойЧасти Из Объект.РолиМетаданных Цикл
			РеквизитыРоли = РолиПрофиля[СтрокаТабличнойЧасти.ИмяРоли];
			Если РеквизитыРоли = Истина Тогда
				СтрокаТабличнойЧасти.Использовать = Истина;
				РолиПрофиля.Вставить(СтрокаТабличнойЧасти.ИмяРоли, Ложь);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// >> Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023
	акс_ГруппироватьРолиПо = "Метаданным";
	// << Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023
	
	ЗаполнитьДеревоРеквизитов();
	ЗаполнитьДеревоРолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РежимРазвернутогоДерева = "Свернуто";
	РаскрытьДеревоРеквизитов();
	РаскрытьДеревоРолей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СписокОбъектовПрофиляПриИзменении(Элемент)
	
	ОбъектыМетаданных      = Новый Соответствие;
	НовыеОбъектыМетаданных = Новый Массив;
	Для Каждого ОбъектПрофиля Из СписокОбъектовПрофиля Цикл
		ОбъектыМетаданных.Вставить(ОбъектПрофиля.Значение, Истина);
		Если ПустаяСтрока(ОбъектПрофиля.Представление) Тогда
			НовыеОбъектыМетаданных.Добавить(ОбъектПрофиля.Значение);
		КонецЕсли;
	КонецЦикла;
	
	//удалим удаленные объекты профиля
	Индекс = Объект.ОбъектыПрофиля.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаОбъектаПрофиля = Объект.ОбъектыПрофиля[Индекс];
		Если ОбъектыМетаданных[СтрокаОбъектаПрофиля.ОбъектМетаданных] = Неопределено Тогда
			Объект.ОбъектыПрофиля.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Если НовыеОбъектыМетаданных.Количество() > 0 Тогда
		РеквизитыОбъектовМетаданных = ОбщегоНазначенияУТВызовСервера.ЗначенияРеквизитовОбъектов(НовыеОбъектыМетаданных, "ПолноеИмя,Синоним");
		Для Каждого ОбъектПрофиля Из СписокОбъектовПрофиля Цикл
			Если ПустаяСтрока(ОбъектПрофиля.Представление) Тогда
				РеквизитыОбъектаМетаданных = РеквизитыОбъектовМетаданных[ОбъектПрофиля.Значение];
				Если РеквизитыОбъектаМетаданных <> Неопределено Тогда
					ОбъектПрофиля.Представление = РеквизитыОбъектаМетаданных.Синоним;
					СтрокаОбъектаПрофиля = Объект.ОбъектыПрофиля.Добавить();
					СтрокаОбъектаПрофиля.ОбъектМетаданных = ОбъектПрофиля.Значение;
					ЗаполнитьЗначенияСвойств(СтрокаОбъектаПрофиля, РеквизитыОбъектаМетаданных);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Состав объектов профиля изменился: строки по объектам вне профиля собираются заново.
	ОбъектыВнеПрофиляЗаполнены = Ложь;
	ОбновитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура СписокРолиИсключенияПриИзменении(Элемент)
	
	ОбновитьДанные();
	
КонецПроцедуры

&НаКлиенте
Процедура акс_ГруппироватьРолиПоПриИзменении(Элемент)
	
	ОбновитьДанные();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоРеквизитов

&НаКлиенте
Процедура ДеревоРеквизитовПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРеквизитов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		СписокМетаданныхПоРеквизиту.Очистить();
	ИначеЕсли ПустаяСтрока(ТекущиеДанные.Реквизит) Тогда
		СписокМетаданныхПоРеквизиту.Очистить();
	Иначе
		Если ТипЗнч(МетаданныеПоРеквизитам) = Тип("ФиксированноеСоответствие") Тогда
			// ФиксированноеСоответствие: оператор [] на отсутствующем ключе вызывает исключение,
			// поэтому используется метод Получить.
			Массив = МетаданныеПоРеквизитам.Получить(ТекущиеДанные.Реквизит);
			Если Массив = Неопределено Тогда
				СписокМетаданныхПоРеквизиту.Очистить();
			Иначе
				СписокМетаданныхПоРеквизиту.ЗагрузитьЗначения(Массив);
			КонецЕсли;
		Иначе
			СписокМетаданныхПоРеквизиту.Очистить();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовИспользоватьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Дерево реквизитов перестраивается, поэтому запоминается строка, которую нужно выделить заново.
	ТекущийРеквизит = ТекущиеДанные.Реквизит;
	
	СтрокиТабличнойЧасти = Объект.РеквизитыОбъектов.НайтиСтроки(Новый Структура("Реквизит", ТекущиеДанные.Реквизит));
	Для Каждого СтрокаТабличнойЧасти Из СтрокиТабличнойЧасти Цикл
		СтрокаТабличнойЧасти.Использовать = ТекущиеДанные.Использовать;
	КонецЦикла;
	
	ТекущиеДанные = Элементы.ДеревоРолей.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ТекущаяРольМетаданных = Неопределено;
	Иначе
		ТекущаяРольМетаданных = Новый Структура("Метаданные,Роль", ТекущиеДанные.Метаданные, ТекущиеДанные.Роль);
	КонецЕсли;
	
	// Пересчёт данных нужен, чтобы по отмеченным реквизитам объектов вне профиля подобрались роли.
	ОбновитьДанныеНаСервере();
	РаскрытьДеревоРеквизитов();
	РаскрытьДеревоРолей();
	
	СтрокиДереваРеквизитов = НайтиСтрокиДерева(ДеревоРеквизитов.ПолучитьЭлементы(), Новый Структура("Реквизит", ТекущийРеквизит));
	Если СтрокиДереваРеквизитов.Количество() > 0 Тогда
		Элементы.ДеревоРеквизитов.ТекущаяСтрока = СтрокиДереваРеквизитов[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ТекущаяРольМетаданных <> Неопределено Тогда
		СтрокиТабличнойЧасти = НайтиСтрокиДерева(ДеревоРолей.ПолучитьЭлементы(), ТекущаяРольМетаданных, Ложь);
		Если СтрокиТабличнойЧасти.Количество() > 0 Тогда
			Элементы.ДеревоРолей.ТекущаяСтрока = СтрокиТабличнойЧасти[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоРолей

&НаКлиенте
Процедура ДеревоРолейПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРолей.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		КлючиРеквизитов = "";
	ИначеЕсли ПустаяСтрока(ТекущиеДанные.Метаданные) Тогда
		КлючиРеквизитов = "";
	Иначе
		Если ТипЗнч(КлючиРеквизитовПоМетаданным) = Тип("ФиксированноеСоответствие") Тогда
			// ФиксированноеСоответствие: оператор [] на отсутствующем ключе вызывает исключение,
			// поэтому используется метод Получить.
			Ключи = КлючиРеквизитовПоМетаданным.Получить(ТекущиеДанные.Метаданные);
			Если Ключи = Неопределено Тогда
				КлючиРеквизитов = "";
			Иначе
				КлючиРеквизитов = Ключи;
			КонецЕсли;
		Иначе
			КлючиРеквизитов = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРолейИспользоватьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоРолей.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокиТабличнойЧасти = Объект.РолиМетаданных.НайтиСтроки(Новый Структура("Метаданные,Роль", ТекущиеДанные.Метаданные, ТекущиеДанные.Роль));
	
	Для Каждого СтрокаТабличнойЧасти Из СтрокиТабличнойЧасти Цикл
		СтрокаТабличнойЧасти.Использовать = ТекущиеДанные.Использовать;
	КонецЦикла;
	
	СтрокиТабличнойЧасти = НайтиСтрокиДерева(ДеревоРолей.ПолучитьЭлементы(), Новый Структура("Роль", ТекущиеДанные.Роль));
	Для Каждого СтрокаТабличнойЧасти Из СтрокиТабличнойЧасти Цикл
		Если СтрокаТабличнойЧасти = ТекущиеДанные Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТабличнойЧасти.Использовать   = ТекущиеДанные.Использовать;
		СтрокаТабличнойЧасти.ТолькоПросмотр = ТекущиеДанные.Использовать;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиДанныеВПрофиль(Команда)
	
	РезультатЗакрытия = ПолучитьРезультатПодбораРолей();
	Закрыть(РезультатЗакрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	// Команда перечитывает данные заново, в том числе строки по объектам вне профиля.
	ОбъектыВнеПрофиляЗаполнены = Ложь;
	ЗаполнитьНаСервере();
	РаскрытьДеревоРеквизитов();
	РаскрытьДеревоРолей();
	
КонецПроцедуры

// >> Чалый Д.А. (Аксиома) | Установка флагов по выделенным строкам | 08.12.2023
&НаКлиенте
Процедура акс_ПроставитьФлаги(Команда)
	
	ВыдСтроки = Элементы.ДеревоРолей.ВыделенныеСтроки;
	
	Для Каждого ВыдСтрока ИЗ ВыдСтроки Цикл
		
		ДанныеСтроки = Элементы.ДеревоРолей.ДанныеСтроки(ВыдСтрока);
		
		ИмяРолиДляПоиска = ДанныеСтроки.ИмяРоли;
		
		ЧастиИмениРоли = СтрРазделить(ИмяРолиДляПоиска, " ");
		
		Если ЧастиИмениРоли.Количество() Тогда
			
			ИмяРолиДляПоиска = ЧастиИмениРоли[0];
			
		КонецЕсли;
		
		НайдСтроки = Объект.РолиМетаданных.НайтиСтроки(Новый Структура("ИмяРоли", ИмяРолиДляПоиска));
		
		Для Каждого НайдСтрока Из НайдСтроки Цикл
			
			НайдСтрока.Использовать = Истина;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаполнитьНаСервере();
	РаскрытьДеревоРеквизитов();
	РаскрытьДеревоРолей();
	
КонецПроцедуры

&НаКлиенте
Процедура акс_СнятьФлаги(Команда)
	
	ВыдСтроки = Элементы.ДеревоРолей.ВыделенныеСтроки;
	
	Для Каждого ВыдСтрока ИЗ ВыдСтроки Цикл
		
		ДанныеСтроки = Элементы.ДеревоРолей.ДанныеСтроки(ВыдСтрока);
		
		ИмяРолиДляПоиска = ДанныеСтроки.ИмяРоли;
		
		ЧастиИмениРоли = СтрРазделить(ИмяРолиДляПоиска, " ");
		
		Если ЧастиИмениРоли.Количество() Тогда
			
			ИмяРолиДляПоиска = ЧастиИмениРоли[0];
			
		КонецЕсли;
		
		НайдСтроки = Объект.РолиМетаданных.НайтиСтроки(Новый Структура("ИмяРоли", ИмяРолиДляПоиска));
		
		Для Каждого НайдСтрока Из НайдСтроки Цикл
			
			НайдСтрока.Использовать = Ложь;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаполнитьНаСервере();
	РаскрытьДеревоРеквизитов();
	РаскрытьДеревоРолей();

КонецПроцедуры
// << Чалый Д.А. (Аксиома) | Установка флагов по выделенным строкам | 08.12.2023

// >> Чалый Д.А. (Аксиома) | Группировка ролей по полям запросов | 28.09.2026
// Перестраивает дерево ролей в группировке по полям, используемым в запросах модулей.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура акс_ПоказатьРолиПоПолямЗапросов(Команда)
	
	акс_ГруппироватьРолиПо = "ПолюЗапроса";
	
	акс_ЗаполнитьДеревоРолейПоПолямЗапросов();
	РаскрытьДеревоРолей();
	
КонецПроцедуры
// << Чалый Д.А. (Аксиома) | Группировка ролей по полям запросов | 28.09.2026

&НаКлиенте
Процедура акс_ПереключитьРазвернутьВсе(Команда)
    Если РежимРазвернутогоДерева = "РазвернутоВсе" Тогда
        // Сворачиваем всё
        Для Каждого Строка Из ДеревоРолей.ПолучитьЭлементы() Цикл
            СвернутьСтрокуРекурсивно(Строка, Истина);
        КонецЦикла;
        РежимРазвернутогоДерева = "Свернуто";
    Иначе
        // Разворачиваем всё
        Для Каждого Строка Из ДеревоРолей.ПолучитьЭлементы() Цикл
            РазвернутьСтрокуРекурсивно(Строка, Истина);
        КонецЦикла;
        РежимРазвернутогоДерева = "РазвернутоВсе";
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура акс_ПереключитьРазвернутьДоГрупп(Команда)
    Если РежимРазвернутогоДерева = "РазвернутыГруппы" Тогда
        // Сворачиваем всё
        Для Каждого Строка Из ДеревоРолей.ПолучитьЭлементы() Цикл
            СвернутьСтрокуРекурсивно(Строка, Истина);
        КонецЦикла;
        РежимРазвернутогоДерева = "Свернуто";
    Иначе
        // Сворачиваем всё и разворачиваем только корневые узлы
        Для Каждого Строка Из ДеревоРолей.ПолучитьЭлементы() Цикл
            СвернутьСтрокуРекурсивно(Строка, Истина);
        КонецЦикла;
        Для Каждого Строка Из ДеревоРолей.ПолучитьЭлементы() Цикл
            Элементы.ДеревоРолей.Развернуть(Строка.ПолучитьИдентификатор());
        КонецЦикла;
        РежимРазвернутогоДерева = "РазвернутыГруппы";
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРеквизитовИспользовать.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРеквизитов.ТолькоПросмотр");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРолейИспользовать.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРолей.ТолькоПросмотр");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.ИдентификаторПользовательскойНастройки = "ОтборРеквизитыПоМетаданному";
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРеквизитов.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРеквизитов.Реквизит");
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтрокаИндексовРеквизитовПоМетаданным");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
	ОтборЭлемента.ПравоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРеквизитов.Ключ");
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоРолей.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоРолей.Метаданные");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	//ОтборЭлемента.ПравоеЗначение = Новый ПолеКомпоновкиДанных("СписокМетаданныхПоРеквизиту");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокРолейИсключения()
	
	ИменаРолей = Новый Массив;

	Для Каждого Роль Из Метаданные.ОсновныеРоли Цикл
		ИменаРолей.Добавить("Роль." + Роль.Имя);
	КонецЦикла;

	ИменаРолей.Добавить("Роль.УдаленныйДоступOData");

	Попытка
		НазначениеРолей = Пользователи.НазначениеРолей();
		Для Каждого Роль Из НазначениеРолей.ТолькоДляАдминистраторовСистемы Цикл
			ИменаРолей.Добавить("Роль." + Роль);
		КонецЦикла;
		// >> Чалый Д.А. (Аксиома) | Роли внешних пользователей | 08.12.2023
		Для Каждого РольВП Из НазначениеРолей.ТолькоДляВнешнихПользователей Цикл
			ИменаРолей.Добавить("Роль." + РольВП);
		КонецЦикла;
		// << Чалый Д.А. (Аксиома) | Роли внешних пользователей | 08.12.2023
	Исключение
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Подбор ролей для профиля.Получение назначения ролей'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ИнформацияОбОшибке().Описание);
	КонецПопытки;
	
	ИменаРолей = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ИменаРолей);
	
	// Часть имён может отсутствовать в конфигурации (например, роль "УдаленныйДоступOData"
	// есть не в каждой поставке): идентификаторы метаданных для них не получить.
	СуществующиеИменаРолей = Новый Массив;
	Для Каждого ИмяРоли Из ИменаРолей Цикл
		Если Метаданные.НайтиПоПолномуИмени(ИмяРоли) <> Неопределено Тогда
			СуществующиеИменаРолей.Добавить(ИмяРоли);
		КонецЕсли;
	КонецЦикла;
	
	Идентификаторы = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(СуществующиеИменаРолей);
	
	Для Каждого Элемент Из Идентификаторы Цикл
		СписокРолиИсключения.Добавить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОбъектовПрофиля()
	
	Объект.ОбъектыПрофиля.Очистить();
	СписокОбъектовПрофиля.Очистить();
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПрофилиГруппДоступаОбъекты.ОбъектМетаданных КАК ОбъектМетаданных,
		|	ПрофилиГруппДоступаОбъекты.ОбъектМетаданных.ПолноеИмя КАК ПолноеИмя,
		|	ПрофилиГруппДоступаОбъекты.ОбъектМетаданных.Синоним КАК Синоним
		|ИЗ
		|	Справочник.ПрофилиГруппДоступа.ППГД_Объекты КАК ПрофилиГруппДоступаОбъекты
		|ГДЕ
		|	ПрофилиГруппДоступаОбъекты.Ссылка = &ПрофильГруппыДоступа
		|	И ПрофилиГруппДоступаОбъекты.ОбъектМетаданных <> НЕОПРЕДЕЛЕНО
		|	И ПрофилиГруппДоступаОбъекты.ОбъектМетаданных <> ЗНАЧЕНИЕ(Справочник.ИдентификаторыОбъектовМетаданных.ПустаяСсылка)
		|	И ПрофилиГруппДоступаОбъекты.ОбъектМетаданных <> ЗНАЧЕНИЕ(Справочник.ИдентификаторыОбъектовРасширений.ПустаяСсылка)");
	Запрос.УстановитьПараметр("ПрофильГруппыДоступа", Объект.ПрофильГруппыДоступа);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.ОбъектыПрофиля.Добавить(), Выборка);
		СписокОбъектовПрофиля.Добавить(Выборка.ОбъектМетаданных, Выборка.Синоним);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОбъектовПрофиля()
	
	Если ТипЗнч(СинонимыМетаданных) = Тип("ФиксированноеСоответствие") Тогда
		Синонимы = Новый Соответствие(СинонимыМетаданных);
	Иначе
		Синонимы = Новый Соответствие;
	КонецЕсли;
	
	Если ТипЗнч(МетаданныеПоРеквизитам) = Тип("ФиксированноеСоответствие") Тогда
		СоответствиеМетаданныеПоРеквизитам = Новый Соответствие(МетаданныеПоРеквизитам);
	Иначе
		СоответствиеМетаданныеПоРеквизитам = Новый Соответствие;
	КонецЕсли;
	
	//Если ТипЗнч(РеквизитыПоМетаданным) = Тип("ФиксированноеСоответствие") Тогда
	//	СоответствиеРеквизитыПоМетаданным = Новый Соответствие(РеквизитыПоМетаданным);
	//Иначе
	//	СоответствиеРеквизитыПоМетаданным = Новый Соответствие;
	//КонецЕсли;
	
	Если ТипЗнч(ИндексыМетаданныхПоРеквизитам) = Тип("ФиксированноеСоответствие") Тогда
		СоответствиеИндексыМетаданныхПоРеквизитам = Новый Соответствие(ИндексыМетаданныхПоРеквизитам);
	Иначе
		СоответствиеИндексыМетаданныхПоРеквизитам = Новый Соответствие;
	КонецЕсли;
	Если ТипЗнч(КлючиРеквизитовПоМетаданным) = Тип("ФиксированноеСоответствие") Тогда
		СоответствиеКлючиРеквизитовПоМетаданным = Новый Соответствие(КлючиРеквизитовПоМетаданным);
	Иначе
		СоответствиеКлючиРеквизитовПоМетаданным = Новый Соответствие;
	КонецЕсли;
	
	НеЗаполненныеМетаданные = Новый Соответствие;
	ЗаполненныеМетаданные   = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Объект.РолиМетаданных Цикл
		ЗаполненныеМетаданные.Вставить(СтрокаТаблицы.Метаданные, Истина);
	КонецЦикла;
	
	ОбъектыПрофиляСсылки = Новый Соответствие;
	Для Каждого СтрокаОбъектаПрофиля Из Объект.ОбъектыПрофиля Цикл
		ОбъектыПрофиляСсылки.Вставить(СтрокаОбъектаПрофиля.ОбъектМетаданных, Истина);
	КонецЦикла;
	
	СсылочныеТипы = Справочники.ТипВсеСсылки().Типы();
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СсылочныеТипы, Документы.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СсылочныеТипы, ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СсылочныеТипы, ПланыСчетов.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СсылочныеТипы, ПланыВидовРасчета.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СсылочныеТипы, БизнесПроцессы.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СсылочныеТипы, Задачи.ТипВсеСсылки().Типы());
	ОписаниеСсылочныхТипов = Новый ОписаниеТипов(СсылочныеТипы);
	
	Для Каждого СтрокаОбъектаПрофиля Из Объект.ОбъектыПрофиля Цикл
		
		СтрокиРеквизитов = Объект.РеквизитыОбъектов.НайтиСтроки(Новый Структура("ОбъектМетаданных", СтрокаОбъектаПрофиля.ОбъектМетаданных));
		Если СтрокиРеквизитов.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(СтрокаОбъектаПрофиля.ПолноеИмя);
		Если МетаданныеОбъекта = Неопределено Тогда
			// Объект из состава профиля не найден в конфигурации (переименован или удалён).
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(МетаданныеОбъекта.Синоним) Тогда
			Синонимы.Вставить(СтрокаОбъектаПрофиля.ПолноеИмя, МетаданныеОбъекта.Синоним);
		КонецЕсли;
		
		ВладельцыРеквизитов = Новый Массив;
		ВладельцыРеквизитов.Добавить(МетаданныеОбъекта);
		
		// Табличные части есть не у всех объектов метаданных (например, у регистра сведений,
		// перечисления или константы их нет), поэтому наличие коллекции проверяется.
		Попытка
			ТабличныеЧастиОбъекта = МетаданныеОбъекта.ТабличныеЧасти;
		Исключение
			ТабличныеЧастиОбъекта = Неопределено;
		КонецПопытки;
		
		Если ТабличныеЧастиОбъекта <> Неопределено Тогда
			Для Каждого ТабличнаяЧасть Из ТабличныеЧастиОбъекта Цикл
				ВладельцыРеквизитов.Добавить(ТабличнаяЧасть);
				Если Не ПустаяСтрока(ТабличнаяЧасть.Синоним) Тогда
					Синонимы.Вставить(ТабличнаяЧасть.ПолноеИмя(), ТабличнаяЧасть.Синоним);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого ВладелецРеквизитов Из ВладельцыРеквизитов Цикл
			
			// Коллекции реквизитов нет, например, у перечисления или константы.
			Попытка
				РеквизитыВладельца = ВладелецРеквизитов.Реквизиты;
			Исключение
				Продолжить;
			КонецПопытки;
			
			Для Каждого РеквизитОбъект Из РеквизитыВладельца Цикл
				
				Реквизит      = РеквизитОбъект.ПолноеИмя();
				ТипыРеквизита = РеквизитОбъект.Тип.Типы();
				СсылочныеТипыРеквизита = Новый Массив;
				Если Не ПустаяСтрока(РеквизитОбъект.Синоним) Тогда
					Синонимы.Вставить(Реквизит, РеквизитОбъект.Синоним);
				КонецЕсли;
				
				Для Каждого ТипРеквизита Из ТипыРеквизита Цикл
					
					Если ОписаниеСсылочныхТипов.СодержитТип(ТипРеквизита) Тогда
						
						ОбъектМетаданныхТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
						Если ОбъектМетаданныхТипа = Неопределено Тогда
							// Тип из модели расширения, которому не соответствует объект конфигурации.
							Продолжить;
						КонецЕсли;
						МетаданныеТипа = ОбъектМетаданныхТипа.ПолноеИмя();
						МетаданныеТипаЗаполнены = ЗаполненныеМетаданные[МетаданныеТипа];
						
						СсылочныеТипыРеквизита.Добавить(МетаданныеТипа);
						Если Не ПустаяСтрока(ОбъектМетаданныхТипа.Синоним) Тогда
							Синонимы.Вставить(МетаданныеТипа, ОбъектМетаданныхТипа.Синоним);
						КонецЕсли;
						
						СтрокаТипаРеквизита = Объект.ТипыРеквизитов.Добавить();
						СтрокаТипаРеквизита.Реквизит   = Реквизит;
						СтрокаТипаРеквизита.Метаданные = МетаданныеТипа;
						
						Массив = СоответствиеМетаданныеПоРеквизитам[Реквизит];
						Если Массив = Неопределено Тогда
							Массив = Новый Массив;
							СоответствиеМетаданныеПоРеквизитам.Вставить(Реквизит, Массив);
						КонецЕсли;
						Массив.Добавить(МетаданныеТипа);
						Индексы = СоответствиеИндексыМетаданныхПоРеквизитам[Реквизит];
						Если Индексы = Неопределено Тогда
							Индексы = ПолучитьСтроковыйКлюч(Объект.РолиМетаданных.Количество()+1);
						Иначе
							Индексы = Индексы + ПолучитьСтроковыйКлюч(Объект.РеквизитыОбъектов.Количество()+1);
						КонецЕсли;
						СоответствиеИндексыМетаданныхПоРеквизитам.Вставить(Реквизит, Индексы);
						//Массив = СоответствиеРеквизитыПоМетаданным[МетаданныеТипа];
						//Если Массив = Неопределено Тогда
						//	Массив = Новый Массив;
						//	СоответствиеРеквизитыПоМетаданным.Вставить(МетаданныеТипа, Массив);
						//КонецЕсли;
						//Массив.Добавить(Реквизит);
						Ключи = СоответствиеКлючиРеквизитовПоМетаданным[МетаданныеТипа];
						Если Ключи = Неопределено Тогда
							Ключи = ПолучитьСтроковыйКлюч(Объект.РеквизитыОбъектов.Количество()+1);
						Иначе
							Ключи = Ключи + ПолучитьСтроковыйКлюч(Объект.РеквизитыОбъектов.Количество()+1);
						КонецЕсли;
						СоответствиеКлючиРеквизитовПоМетаданным.Вставить(МетаданныеТипа, Ключи);
						
						Если МетаданныеТипаЗаполнены = Неопределено Тогда
							НеЗаполненныеМетаданные.Вставить(МетаданныеТипа, Ложь);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если СсылочныеТипыРеквизита.Количество() > 0 Тогда
					СтрокаРеквизита = Объект.РеквизитыОбъектов.Добавить();
					СтрокаРеквизита.ОбъектМетаданных         = СтрокаОбъектаПрофиля.ОбъектМетаданных;
					СтрокаРеквизита.Реквизит                 = Реквизит;
					СтрокаРеквизита.Ключ                     = ПолучитьСтроковыйКлюч(Объект.РеквизитыОбъектов.Количество());
					СтрокаРеквизита.ТипСтрокой               = СтрСоединить(СсылочныеТипыРеквизита, "; ");
					// Реквизиты табличной части "ДополнительныеРеквизиты" есть почти у каждого
					// объекта и в профиле нужны редко, поэтому по умолчанию сняты с отметки.
					СтрокаРеквизита.Использовать             = СтрНайти(Реквизит, ".ТабличнаяЧасть.ДополнительныеРеквизиты.") = 0;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	// Отмеченные реквизиты объектов вне профиля: по этим объектам нужно подобрать роли, как и
	// по типам реквизитов объектов профиля.
	Для Каждого СтрокаРеквизита Из Объект.РеквизитыОбъектов Цикл
		
		Если Не СтрокаРеквизита.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектыПрофиляСсылки[СтрокаРеквизита.ОбъектМетаданных] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолноеИмяОбъекта = ПолноеИмяОбъектаРеквизита(СтрокаРеквизита.Реквизит);
		Если ПустаяСтрока(ПолноеИмяОбъекта) Или ЗаполненныеМетаданные[ПолноеИмяОбъекта] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НеЗаполненныеМетаданные.Вставить(ПолноеИмяОбъекта, Ложь);
		
	КонецЦикла;
	
	// Регистры, по которым документы профиля выполняют движения. Права на них нужны для
	// проведения и записи документов, поэтому роли на эти регистры добавляются в таблицу
	// "РолиМетаданных" наравне с ролями на типы реквизитов.
	Для Каждого КлючИЗначение Из РегистрыДвиженийОбъектовПрофиля(Объект.ОбъектыПрофиля) Цикл
		
		Если ЗаполненныеМетаданные[КлючИЗначение.Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НеЗаполненныеМетаданные.Вставить(КлючИЗначение.Ключ, Ложь);
		Если Не ПустаяСтрока(КлючИЗначение.Значение) Тогда
			Синонимы.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	// Сами объекты профиля: роли на объект целиком нужны, чтобы профиль давал доступ
	// к объекту, а не только к его реквизитам и типам реквизитов.
	Для Каждого СтрокаОбъектаПрофиля Из Объект.ОбъектыПрофиля Цикл
		
		Если ПустаяСтрока(СтрокаОбъектаПрофиля.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаполненныеМетаданные[СтрокаОбъектаПрофиля.ПолноеИмя] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НеЗаполненныеМетаданные.Вставить(СтрокаОбъектаПрофиля.ПолноеИмя, Ложь);
		Если Не ПустаяСтрока(СтрокаОбъектаПрофиля.Синоним) Тогда
			Синонимы.Вставить(СтрокаОбъектаПрофиля.ПолноеИмя, СтрокаОбъектаПрофиля.Синоним);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НеЗаполненныеМетаданные.Количество() > 0 Тогда
		СписокМетаданных = Новый Массив;
		Для Каждого Элемент Из НеЗаполненныеМетаданные Цикл
			СписокМетаданных.Добавить(Элемент.Ключ);
		КонецЦикла;
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	ПраваРолей.ОбъектМетаданных.ПолноеИмя КАК Метаданные,
			|	ПраваРолей.Роль.Имя КАК ИмяРоли,
			|	ПраваРолей.Роль КАК Роль,
			|	ПраваРолей.Роль.Синоним КАК РольСиноним,
			|	ВЫБОР
			|		КОГДА ПраваРолей.ПравоЧтениеБезОграничения
			|			ТОГДА 1
			|		ИНАЧЕ 2
			|	КОНЕЦ КАК ПравоЧтение,
			|	ВЫБОР
			|		КОГДА НЕ ПраваРолей.ПравоИзменение
			|			ТОГДА 0
			|		КОГДА ПраваРолей.ПравоИзменениеБезОграничения
			|			ТОГДА 1
			|		ИНАЧЕ 2
			|	КОНЕЦ КАК ПравоИзменение,
			|	ВЫБОР
			|		КОГДА НЕ ПраваРолей.ПравоДобавление
			|			ТОГДА 0
			|		КОГДА ПраваРолей.ПравоДобавлениеБезОграничения
			|			ТОГДА 1
			|		ИНАЧЕ 2
			|	КОНЕЦ КАК ПравоДобавление,
			|	ПраваРолей.ПравоЧтениеБезОграничения КАК ПравоЧтениеБезОграничения,
			|	ПраваРолей.ПравоИзменениеБезОграничения КАК ПравоИзменениеБезОграничения,
			|	ПраваРолей.ПравоДобавлениеБезОграничения КАК ПравоДобавлениеБезОграничения,
			|	ВЫБОР
			|		КОГДА ПраваРолей.ПравоПросмотр
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПравоПросмотр,
			|	ВЫБОР
			|		КОГДА ПраваРолей.ПравоРедактирование
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПравоРедактирование,
			|	ВЫБОР
			|		КОГДА ПраваРолей.ПравоИнтерактивноеДобавление
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ПравоИнтерактивноеДобавление
			|ИЗ
			|	РегистрСведений.ПраваРолей КАК ПраваРолей
			|ГДЕ
			|	ПраваРолей.ОбъектМетаданных.ПолноеИмя В(&СписокМетаданных)
			|	И НЕ ПраваРолей.Роль В (&СписокРолиИсключения)");
		Запрос.УстановитьПараметр("СписокМетаданных",     СписокМетаданных);
		Запрос.УстановитьПараметр("СписокРолиИсключения", СписокРолиИсключения);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.РолиМетаданных.Добавить(), Выборка);
			Если ЗначениеЗаполнено(Выборка.РольСиноним) Тогда
				Синонимы.Вставить(Выборка.ИмяРоли, Выборка.РольСиноним);
			КонецЕсли;
			НеЗаполненныеМетаданные.Вставить(Выборка.Метаданные, Истина);
		КонецЦикла;
		Для Каждого Элемент Из НеЗаполненныеМетаданные Цикл
			Если Не Элемент.Значение Тогда
				СтрокаТаблицы = Объект.РолиМетаданных.Добавить();
				СтрокаТаблицы.Метаданные = Элемент.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьРолиПодсистем(Синонимы);
	
	МетаданныеПоРеквизитам = Новый ФиксированноеСоответствие(СоответствиеМетаданныеПоРеквизитам);
	
	// Реквизиты объектов вне профиля: их поля используются в запросах модулей объектов профиля.
	// Строки добавляются снятыми с отметки, поэтому в активные метаданные профиля (а значит,
	// и в дерево ролей) объект попадает только после того, как пользователь отметит его реквизиты.
	// Вызов идёт после заполнения карты "МетаданныеПоРеквизитам": процедура определяет активные
	// метаданные профиля, а по ним - объекты вне профиля.
	ДополнитьРеквизитыОбъектовВнеПрофиля(Синонимы);
	
	СинонимыМетаданных            = Новый ФиксированноеСоответствие(Синонимы);
	//РеквизитыПоМетаданным         = Новый ФиксированноеСоответствие(СоответствиеРеквизитыПоМетаданным);
	КлючиРеквизитовПоМетаданным = Новый ФиксированноеСоответствие(СоответствиеКлючиРеквизитовПоМетаданным);
	
КонецПроцедуры

// Дополняет таблицу "РолиМетаданных" ролями, дающими просмотр подсистем (разделов),
// в состав которых включены объекты профиля.
// Права ролей на подсистемы в регистре сведений "ПраваРолей" не хранятся, поэтому они
// проверяются функцией ПравоДоступа. Найденные роли только показываются в дереве
// и не отмечаются автоматически.
//
// Параметры:
//  Синонимы - Соответствие из КлючИЗначение - дополняется синонимами подсистем:
//             * Ключ     - Строка - ключ подсистемы, например "Подсистема.Продажи";
//             * Значение - Строка - синоним подсистемы.
//
&НаСервере
Процедура ЗаполнитьРолиПодсистем(Синонимы)
	
	ПодсистемыОбъектовПрофиля = ПолучитьПодсистемыОбъектовПрофиля();
	
	Если ПодсистемыОбъектовПрофиля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполненныеПодсистемы = ПолучитьКлючиЗаполненныхПодсистем();
	ИсключенныеРоли       = ПолучитьИсключенныеРоли();
	ИдентификаторыРолей   = ПолучитьИдентификаторыРолей();
	
	Для Каждого КлючИЗначение Из ПодсистемыОбъектовПрофиля Цикл
		
		КлючТекущейПодсистемы = КлючИЗначение.Ключ;
		Подсистема            = КлючИЗначение.Значение;
		
		Если ЗаполненныеПодсистемы[КлючТекущейПодсистемы] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Подсистема.Синоним) Тогда
			Синонимы.Вставить(КлючТекущейПодсистемы, Подсистема.Синоним);
		КонецЕсли;
		
		ДобавитьРолиПодсистемы(Подсистема, КлючТекущейПодсистемы, ИдентификаторыРолей, ИсключенныеРоли, Синонимы);
		
	КонецЦикла;
	
КонецПроцедуры

// Дополняет таблицу "РолиМетаданных" ролями, дающими просмотр подсистемы.
//
// Параметры:
//  Подсистема            - ОбъектМетаданныхПодсистема - подсистема, для которой подбираются роли;
//  КлючТекущейПодсистемы - Строка - ключ подсистемы, например "Подсистема.Продажи";
//  ИдентификаторыРолей   - Соответствие из КлючИЗначение - соответствие полных имен ролей
//                          и ссылок на идентификаторы ролей;
//  ИсключенныеРоли       - Соответствие из КлючИЗначение - идентификаторы ролей,
//                          которые не нужно подбирать;
//  Синонимы              - Соответствие из КлючИЗначение - дополняется синонимами ролей:
//                          * Ключ     - Строка - имя роли;
//                          * Значение - Строка - синоним роли.
//
&НаСервере
Процедура ДобавитьРолиПодсистемы(Подсистема, КлючТекущейПодсистемы, ИдентификаторыРолей, ИсключенныеРоли, Синонимы)
	
	Для Каждого Роль Из Метаданные.Роли Цикл
		
		СсылкаРоли = ИдентификаторыРолей["Роль." + Роль.Имя];
		Если СсылкаРоли = Неопределено
			Или ИсключенныеРоли[СсылкаРоли] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПравоДоступа("Просмотр", Подсистема, Роль) Тогда
			Продолжить;
		КонецЕсли;
		
		// Роли на подсистемы не попадают в запрос к регистру "ПраваРолей", поэтому их синонимы
		// добавляются в общий список синонимов здесь.
		Если Не ПустаяСтрока(Роль.Синоним) Тогда
			Синонимы.Вставить(Роль.Имя, Роль.Синоним);
		КонецЕсли;
		
		СтрокаРоли = Объект.РолиМетаданных.Добавить();
		СтрокаРоли.Метаданные    = КлючТекущейПодсистемы;
		СтрокаРоли.ИмяРоли       = Роль.Имя;
		СтрокаРоли.Роль          = СсылкаРоли;
		СтрокаРоли.ПравоПросмотр = 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает ключи подсистем, роли по которым уже добавлены в таблицу "РолиМетаданных".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - Строка - ключ подсистемы, например "Подсистема.Продажи";
//   * Значение - Булево - Истина.
//
&НаСервере
Функция ПолучитьКлючиЗаполненныхПодсистем()
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаТабличнойЧасти Из Объект.РолиМетаданных Цикл
		Если СтрНачинаетсяС(СтрокаТабличнойЧасти.Метаданные, "Подсистема.") Тогда
			Результат.Вставить(СтрокаТабличнойЧасти.Метаданные, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификаторы ролей, которые не нужно подбирать.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - СправочникСсылка.ИдентификаторыОбъектовМетаданных - идентификатор роли;
//   * Значение - Булево - Истина.
//
&НаСервере
Функция ПолучитьИсключенныеРоли()
	
	Результат = Новый Соответствие;
	Для Каждого ЭлементСписка Из СписокРолиИсключения Цикл
		Результат.Вставить(ЭлементСписка.Значение, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает подсистемы, в состав которых включены объекты профиля, вместе с их
// родительскими подсистемами.
//
// Родительские подсистемы нужны, чтобы раздел был виден в командном интерфейсе.
// Обход идет сверху вниз, от Метаданные.Подсистемы: подниматься вверх по Родитель()
// нельзя, так как у подсистемы верхнего уровня Родитель() возвращает саму конфигурацию,
// а право "Просмотр" к конфигурации неприменимо.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - подсистемы, относящиеся к объектам профиля:
//   * Ключ     - Строка - ключ подсистемы, например "Подсистема.Продажи.Подсистема.ОптовыеПродажи";
//   * Значение - ОбъектМетаданныхПодсистема - подсистема.
//
&НаСервере
Функция ПолучитьПодсистемыОбъектовПрофиля()
	
	ОбъектыПрофиля = Новый Массив;
	Для Каждого СтрокаТабличнойЧасти Из Объект.ОбъектыПрофиля Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СтрокаТабличнойЧасти.ПолноеИмя);
		Если ОбъектМетаданных <> Неопределено Тогда
			ОбъектыПрофиля.Добавить(ОбъектМетаданных);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Соответствие;
	
	Если ОбъектыПрофиля.Количество() > 0 Тогда
		Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
			НайденныеПодсистемы = ПодсистемыСОбъектамиПрофиля(Подсистема, "", ОбъектыПрофиля);
			Для Каждого КлючИЗначение Из НайденныеПодсистемы Цикл
				Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает подсистему и вложенные в нее подсистемы, которые нужны для видимости
// объектов профиля: те, в состав которых включены объекты профиля, и их родительские
// подсистемы.
//
// Параметры:
//  Подсистема     - ОбъектМетаданныхПодсистема - обрабатываемая подсистема;
//  ПрефиксИмени   - Строка - префикс ключа подсистемы, например "Подсистема.Продажи.";
//  ОбъектыПрофиля - Массив из ОбъектМетаданных - объекты метаданных, включенные в профиль.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - найденные подсистемы:
//   * Ключ     - Строка - ключ подсистемы, например "Подсистема.Продажи";
//   * Значение - ОбъектМетаданныхПодсистема - подсистема.
//
&НаСервере
Функция ПодсистемыСОбъектамиПрофиля(Подсистема, ПрефиксИмени, ОбъектыПрофиля)
	
	КлючТекущейПодсистемы = ПрефиксИмени + "Подсистема." + Подсистема.Имя;
	Результат = Новый Соответствие;
	
	Для Каждого ДочерняяПодсистема Из Подсистема.Подсистемы Цикл
		ДочерниеПодсистемы = ПодсистемыСОбъектамиПрофиля(ДочерняяПодсистема, КлючТекущейПодсистемы + ".", ОбъектыПрофиля);
		Для Каждого КлючИЗначение Из ДочерниеПодсистемы Цикл
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
	
	ПодсистемаСодержитОбъектыПрофиля = Ложь;
	Для Каждого ОбъектПрофиля Из ОбъектыПрофиля Цикл
		Если Подсистема.Состав.Содержит(ОбъектПрофиля) Тогда
			ПодсистемаСодержитОбъектыПрофиля = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Родительские подсистемы нужны, чтобы раздел был виден в командном интерфейсе,
	// поэтому подсистема попадает в результат и тогда, когда объекты профиля есть
	// только в ее вложенных подсистемах.
	Если ПодсистемаСодержитОбъектыПрофиля Или Результат.Количество() > 0 Тогда
		Результат.Вставить(КлючТекущейПодсистемы, Подсистема);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие полных имен ролей конфигурации и ссылок на идентификаторы ролей.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - Строка - полное имя роли, например "Роль.РазделПродажи";
//   * Значение - СправочникСсылка.ИдентификаторыОбъектовМетаданных - идентификатор роли.
//
&НаСервереБезКонтекста
Функция ПолучитьИдентификаторыРолей()
	
	ПолныеИменаРолей = Новый Массив;
	Для Каждого Роль Из Метаданные.Роли Цикл
		ПолныеИменаРолей.Добавить("Роль." + Роль.Имя);
	КонецЦикла;
	
	Возврат ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ПолныеИменаРолей);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьАктивныеМетаданныеТиповРеквизитов(Форма)
	
	Результат = Новый Соответствие;
	
	МетаданныеВнеПрофиля = МетаданныеВнеПрофиляПоТаблице(Форма);
	
	ОбъектыМетаданных = Новый Соответствие;
	Для Каждого СтрокаТабличнойЧасти Из Форма.Объект.ОбъектыПрофиля Цикл
		ОбъектыМетаданных.Вставить(СтрокаТабличнойЧасти.ОбъектМетаданных, Истина);
	КонецЦикла;
	Для Каждого СтрокаТабличнойЧасти Из Форма.Объект.РеквизитыОбъектов Цикл
		
		Если Не СтрокаТабличнойЧасти.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		// ФиксированноеСоответствие: оператор [] на отсутствующем ключе вызывает исключение,
		// поэтому используется метод Получить.
		Массив = Неопределено;
		Если ТипЗнч(Форма.МетаданныеПоРеквизитам) = Тип("ФиксированноеСоответствие") Тогда
			Массив = Форма.МетаданныеПоРеквизитам.Получить(СтрокаТабличнойЧасти.Реквизит);
		КонецЕсли;
		Если Массив <> Неопределено Тогда
			
			Если ОбъектыМетаданных[СтрокаТабличнойЧасти.ОбъектМетаданных] = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Элемент Из Массив Цикл
				Результат.Вставить(Элемент, Истина);
			КонецЦикла;
			
		Иначе
			
			// Отмеченный реквизит объекта вне профиля делает активным сам объект: так роли по
			// объектам вне профиля попадают в дерево ролей только после отметки пользователем.
			ПолноеИмяОбъекта = ПолноеИмяОбъектаРеквизита(СтрокаТабличнойЧасти.Реквизит);
			Если МетаданныеВнеПрофиля.Получить(ПолноеИмяОбъекта) <> Неопределено Тогда
				Результат.Вставить(ПолноеИмяОбъекта, Истина);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Подсистемы (разделы), в которые включены объекты профиля. Строки по ним
	// добавлены в таблицу "РолиМетаданных" процедурой ЗаполнитьРолиПодсистем.
	Для Каждого СтрокаТабличнойЧасти Из Форма.Объект.РолиМетаданных Цикл
		Если СтрНачинаетсяС(СтрокаТабличнойЧасти.Метаданные, "Подсистема.") Тогда
			Результат.Вставить(СтрокаТабличнойЧасти.Метаданные, Истина);
		КонецЕсли;
	КонецЦикла;
	
	// Регистры, по которым документы профиля выполняют движения: права на них нужны
	// для проведения и записи документов. Строки по ним добавлены в таблицу
	// "РолиМетаданных" при заполнении данных объектов профиля.
	Для Каждого КлючИЗначение Из РегистрыДвиженийОбъектовПрофиля(Форма.Объект.ОбъектыПрофиля) Цикл
		Результат.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Дополняет таблицу "РеквизитыОбъектов" реквизитами объектов вне профиля: поля этих объектов
// используются в запросах модулей объектов профиля, но сами объекты в профиль не входят.
// Строки добавляются снятыми с отметки - решение принимает пользователь, и только после отметки
// реквизита объект становится активным метаданным профиля (см. ПолучитьАктивныеМетаданныеТиповРеквизитов).
//
// Параметры:
//  Синонимы - Соответствие из КлючИЗначение - синонимы объектов метаданных и их реквизитов.
//
&НаСервере
Процедура ДополнитьРеквизитыОбъектовВнеПрофиля(Синонимы)
	
	// Регистр читается только при первом заполнении и после смены состава объектов профиля,
	// поэтому отметка реквизитов в дереве не приводит к повторному чтению регистра.
	Если ОбъектыВнеПрофиляЗаполнены Тогда
		Возврат;
	КонецЕсли;
	
	ИменаОбъектовПрофиля = Новый Соответствие;
	Для Каждого СтрокаОбъектаПрофиля Из Объект.ОбъектыПрофиля Цикл
		ИмяОбъекта = ИмяОбъектаПолногоИмени(СтрокаОбъектаПрофиля.ПолноеИмя);
		Если Не ПустаяСтрока(ИмяОбъекта) Тогда
			ИменаОбъектовПрофиля.Вставить(ИмяОбъекта, СтрокаОбъектаПрофиля.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	
	СписокМетаданных = Новый Массив;
	Для Каждого КлючИЗначение Из ПолучитьАктивныеМетаданныеТиповРеквизитов(ЭтотОбъект) Цикл
		СписокМетаданных.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Если СписокМетаданных.Количество() = 0 Или ИменаОбъектовПрофиля.Количество() = 0 Тогда
		ОбъектыВнеПрофиляЗаполнены = Истина;
		Возврат;
	КонецЕсли;
	
	ЗаполненныеРеквизиты = Новый Соответствие;
	Для Каждого СтрокаРеквизита Из Объект.РеквизитыОбъектов Цикл
		ЗаполненныеРеквизиты.Вставить(СтрокаРеквизита.Реквизит, Истина);
	КонецЦикла;
	
	// Диагностика заполнения: показывает, на каком шаге отсеиваются поля объектов вне профиля.
	Диагностика = Новый Структура;
	Диагностика.Вставить("ПросмотреноЗаписей", 0);
	Диагностика.Вставить("ОтсеяноПоМодулям", 0);
	Диагностика.Вставить("УжеВТаблице", 0);
	Диагностика.Вставить("ПримерПутейМодулей", "");
	
	// Ссылки на объекты метаданных получаются одним вызовом, уже после отбора строк.
	СтрокиДляДобавления = Новый Массив;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Поля.Метаданные КАК Метаданные,
		|	Поля.Поле КАК Поле,
		|	Поля.СписокМодулей КАК СписокМодулей
		|ИЗ
		|	РегистрСведений.ППГД_ПоляВЗапросахМодулей КАК Поля
		|ГДЕ
		|	НЕ Поля.Метаданные В (&СписокМетаданных)
		|УПОРЯДОЧИТЬ ПО
		|	Поля.Метаданные,
		|	Поля.Поле");
	Запрос.УстановитьПараметр("СписокМетаданных", СписокМетаданных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Диагностика.ПросмотреноЗаписей = Диагностика.ПросмотреноЗаписей + 1;
		Если ПустаяСтрока(Диагностика.ПримерПутейМодулей) И Не ПустаяСтрока(Выборка.СписокМодулей) Тогда
			Диагностика.ПримерПутейМодулей = Лев(Выборка.СписокМодулей, 300);
		КонецЕсли;
		
		// Звездочка означает "все поля" и реквизитом не является.
		Если ПустаяСтрока(Выборка.Поле) Или Выборка.Поле = "*" Тогда
			Продолжить;
		КонецЕсли;
		
		// Объект нужен профилю, только если к его полям обращаются модули объектов профиля.
		ОбъектыПрофиляДляПоля = ОбъектыПрофиляВМодулях(Выборка.СписокМодулей, ИменаОбъектовПрофиля);
		Если ОбъектыПрофиляДляПоля.Количество() = 0 Тогда
			Диагностика.ОтсеяноПоМодулям = Диагностика.ОтсеяноПоМодулям + 1;
			Продолжить;
		КонецЕсли;
		
		Реквизит = РеквизитПоМетаданнымИПолю(Выборка.Метаданные, Выборка.Поле);
		Если ПустаяСтрока(Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаполненныеРеквизиты.Получить(Реквизит) <> Неопределено Тогда
			Диагностика.УжеВТаблице = Диагностика.УжеВТаблице + 1;
			Продолжить;
		КонецЕсли;
		
		СтрокаДляДобавления = Новый Структура;
		СтрокаДляДобавления.Вставить("Реквизит", Реквизит);
		СтрокаДляДобавления.Вставить("НуженДля", ОбъектыПрофиляДляПоля);
		СтрокиДляДобавления.Добавить(СтрокаДляДобавления);
		ЗаполненныеРеквизиты.Вставить(Реквизит, Истина);
		
	КонецЦикла;
	
	Если СтрокиДляДобавления.Количество() = 0 Тогда
		ОбъектыВнеПрофиляЗаполнены = Истина;
		ВывестиДиагностикуОбъектовВнеПрофиля(Диагностика, 0);
		Возврат;
	КонецЕсли;
	
	ПолныеИменаОбъектов = Новый Массив;
	Для Каждого СтрокаДляДобавления Из СтрокиДляДобавления Цикл
		ПолноеИмяОбъекта = ПолноеИмяОбъектаРеквизита(СтрокаДляДобавления.Реквизит);
		// В регистре могли остаться имена объектов, которых уже нет в конфигурации:
		// идентификаторы метаданных для них не получить.
		Если Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПолныеИменаОбъектов.Найти(ПолноеИмяОбъекта) = Неопределено Тогда
			ПолныеИменаОбъектов.Добавить(ПолноеИмяОбъекта);
		КонецЕсли;
	КонецЦикла;
	СсылкиОбъектов = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ПолныеИменаОбъектов);
	
	Для Каждого СтрокаДляДобавления Из СтрокиДляДобавления Цикл
		
		ПолноеИмяОбъекта = ПолноеИмяОбъектаРеквизита(СтрокаДляДобавления.Реквизит);
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
		Если МетаданныеОбъекта = Неопределено Тогда
			// Объект из регистра больше не существует в конфигурации.
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(МетаданныеОбъекта.Синоним) Тогда
			Синонимы.Вставить(ПолноеИмяОбъекта, МетаданныеОбъекта.Синоним);
		КонецЕсли;
		
		// В имени реквизита видно, каким объектам профиля он нужен.
		ЧастиНуженДля = Новый Массив;
		Для Сч = 0 По Мин(2, СтрокаДляДобавления.НуженДля.Количество() - 1) Цикл
			ЧастиНуженДля.Добавить(СтрокаДляДобавления.НуженДля[Сч]);
		КонецЦикла;
		Если СтрокаДляДобавления.НуженДля.Количество() > 3 Тогда
			ЧастиНуженДля.Добавить("и еще " + (СтрокаДляДобавления.НуженДля.Количество() - 3));
		КонецЕсли;
		Синонимы.Вставить(СтрокаДляДобавления.Реквизит,
			"нужен для: " + СтрСоединить(ЧастиНуженДля, ", "));
		
		СтрокаРеквизита = Объект.РеквизитыОбъектов.Добавить();
		СтрокаРеквизита.ОбъектМетаданных = СсылкиОбъектов.Получить(ПолноеИмяОбъекта);
		СтрокаРеквизита.Реквизит       = СтрокаДляДобавления.Реквизит;
		СтрокаРеквизита.Ключ           = ПолучитьСтроковыйКлюч(Объект.РеквизитыОбъектов.Количество());
		СтрокаРеквизита.ТипСтрокой     = "";
		// Строка снята с отметки: доступ к объекту вне профиля выдаётся только по решению пользователя.
		СтрокаРеквизита.Использовать   = Ложь;
		
	КонецЦикла;
	
	ОбъектыВнеПрофиляЗаполнены = Истина;
	ВывестиДиагностикуОбъектовВнеПрофиля(Диагностика, СтрокиДляДобавления.Количество());
	
КонецПроцедуры

// Выводит пользователю диагностику заполнения реквизитов объектов вне профиля: сколько полей
// нашлось в регистре "ППГД_ПоляВЗапросахМодулей" и на каком шаге отсеялись остальные.
//
// Параметры:
//  Диагностика - Структура - счетчики заполнения:
//                * ПросмотреноЗаписей - Число - записей регистра, прошедших отбор по активным метаданным;
//                * ОтсеяноПоМодулям   - Число - поля, не найденные в модулях объектов профиля;
//                * УжеВТаблице        - Число - поля, уже присутствующие в таблице "РеквизитыОбъектов";
//                * ПримерПутейМодулей - Строка - пример путей модулей из регистра;
//  Добавлено   - Число - количество добавленных строк таблицы "РеквизитыОбъектов".
//
&НаСервереБезКонтекста
Процедура ВывестиДиагностикуОбъектовВнеПрофиля(Диагностика, Добавлено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ
		|	РегистрСведений.ППГД_ПоляВЗапросахМодулей КАК Поля");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Текст = СтрШаблон(
		НСтр("ru = 'Объекты вне профиля: в регистре %1 полей, по активным метаданным профиля исключено %2, в модулях объектов профиля не найдено %3, уже было в таблице %4, добавлено %5.'"),
		Выборка.Всего,
		Выборка.Всего - Диагностика.ПросмотреноЗаписей,
		Диагностика.ОтсеяноПоМодулям,
		Диагностика.УжеВТаблице,
		Добавлено);
	Если Не ПустаяСтрока(Диагностика.ПримерПутейМодулей) Тогда
		Текст = Текст + Символы.ПС + НСтр("ru = 'Пример путей модулей:'") + " " + Диагностика.ПримерПутейМодулей;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

// Возвращает объекты метаданных вне профиля по таблице "РеквизитыОбъектов": объекты, строки
// которых не принадлежат объектам профиля. Признаком служит ссылка на объект метаданных.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма обработки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - объекты метаданных вне профиля:
//   * Ключ     - Строка - полное имя объекта метаданных;
//   * Значение - Булево - Истина.
//
&НаСервереБезКонтекста
Функция МетаданныеВнеПрофиляПоТаблице(Форма)
	
	Результат = Новый Соответствие;
	
	ОбъектыПрофиляСсылки = Новый Соответствие;
	Для Каждого СтрокаОбъектаПрофиля Из Форма.Объект.ОбъектыПрофиля Цикл
		ОбъектыПрофиляСсылки.Вставить(СтрокаОбъектаПрофиля.ОбъектМетаданных, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаРеквизита Из Форма.Объект.РеквизитыОбъектов Цикл
		
		Если ОбъектыПрофиляСсылки[СтрокаРеквизита.ОбъектМетаданных] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолноеИмяОбъекта = ПолноеИмяОбъектаРеквизита(СтрокаРеквизита.Реквизит);
		Если Не ПустаяСтрока(ПолноеИмяОбъекта) Тогда
			Результат.Вставить(ПолноеИмяОбъекта, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает полное имя объекта метаданных по полному имени реквизита:
// "РегистрСведений.ЦеныНоменклатуры" - для "РегистрСведений.ЦеныНоменклатуры.Реквизит.Цена"
// и для "Документ.ЗаказПокупателя.ТабличнаяЧасть.Товары.Реквизит.Номенклатура".
//
// Параметры:
//  Реквизит - Строка - полное имя реквизита.
//
// Возвращаемое значение:
//  Строка - полное имя объекта метаданных, пустая строка - если имя разобрать не удалось.
//
&НаСервереБезКонтекста
Функция ПолноеИмяОбъектаРеквизита(Реквизит)
	
	Части = СтрРазделить(Реквизит, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Части[0] + "." + Части[1];
	
КонецФункции

// Возвращает полное имя реквизита по метаданным и полю из регистра "ППГД_ПоляВЗапросахМодулей":
// поле табличной части записывается как "Документ.X.ТабличнаяЧасть.ТЧ.Реквизит.Поле".
//
// Параметры:
//  Метаданные - Строка - полное имя объекта метаданных или его табличной части;
//  Поле       - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка - полное имя реквизита, пустая строка - если имя разобрать не удалось.
//
&НаСервереБезКонтекста
Функция РеквизитПоМетаданнымИПолю(Метаданные, Поле)
	
	Части = СтрРазделить(Метаданные, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Если Части.Количество() >= 4 И Части[2] = "ТабличнаяЧасть" Тогда
		Возврат Части[0] + "." + Части[1] + ".ТабличнаяЧасть." + Части[3] + ".Реквизит." + Поле;
	КонецЕсли;
	
	Возврат Части[0] + "." + Части[1] + ".Реквизит." + Поле;
	
КонецФункции

// Возвращает регистры, по которым объекты профиля могут выполнять движения.
//
// Права на эти регистры нужны для проведения и записи документов, поэтому роли на них
// добавляются в таблицу "РолиМетаданных" наравне с ролями на типы реквизитов.
//
// Параметры:
//  ТаблицаОбъектовПрофиля - ТаблицаЗначений - табличная часть "ОбъектыПрофиля"
//                           с колонкой "ПолноеИмя".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - Строка - полное имя регистра, например "РегистрНакопления.ТоварыНаСкладах";
//   * Значение - Строка - синоним регистра.
//
&НаСервереБезКонтекста
Функция РегистрыДвиженийОбъектовПрофиля(ТаблицаОбъектовПрофиля)
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрокаОбъектаПрофиля Из ТаблицаОбъектовПрофиля Цикл
		
		Если Не СтрНачинаетсяС(СтрокаОбъектаПрофиля.ПолноеИмя, "Документ.") Тогда
			Продолжить;
		КонецЕсли;
		
		Документ = Метаданные.НайтиПоПолномуИмени(СтрокаОбъектаПрофиля.ПолноеИмя);
		Если Документ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого РегистрДвижений Из Документ.Движения Цикл
			Результат.Вставить(РегистрДвижений.ПолноеИмя(), РегистрДвижений.Синоним);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоРеквизитов()
	
	Если Объект.РеквизитыОбъектов.Количество() = 0 Тогда
		ДеревоРеквизитов.ПолучитьЭлементы().Очистить();
		Возврат;
	КонецЕсли;
	
	ОбъектыМетаданных = Новый Соответствие;
	Для Каждого СтрокаТабличнойЧасти Из Объект.ОбъектыПрофиля Цикл
		ОбъектыМетаданных.Вставить(СтрокаТабличнойЧасти.ОбъектМетаданных, Истина);
	КонецЦикла;
	МетаданныеВнеПрофиля = МетаданныеВнеПрофиляПоТаблице(ЭтотОбъект);
	ТаблицаРеквизитовОбъектов = Объект.РеквизитыОбъектов.Выгрузить(Новый Массив, "ОбъектМетаданных,Реквизит,СинонимОбъектаМетаданных,СинонимТабличнойЧасти,Синоним,Ключ,ТипСтрокой,Использовать");
	ТаблицаРеквизитовОбъектов.Колонки.Добавить("ТипМетаданных",  Новый ОписаниеТипов("Строка"));
	ТаблицаРеквизитовОбъектов.Колонки.Добавить("ИмяМетаданных",  Новый ОписаниеТипов("Строка"));
	ТаблицаРеквизитовОбъектов.Колонки.Добавить("ТабличнаяЧасть", Новый ОписаниеТипов("Строка"));
	ТаблицаРеквизитовОбъектов.Колонки.Добавить("ИмяРеквизита",   Новый ОписаниеТипов("Строка"));
	//ТаблицаРеквизитовОбъектов.Колонки.Добавить("Ключ",           Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(7)));
	Для Каждого СтрокаТабличнойЧасти Из Объект.РеквизитыОбъектов Цикл
		Если ОбъектыМетаданных[СтрокаТабличнойЧасти.ОбъектМетаданных] = Неопределено
			И МетаданныеВнеПрофиля.Получить(ПолноеИмяОбъектаРеквизита(СтрокаТабличнойЧасти.Реквизит)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаРеквизитовОбъектов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТабличнойЧасти);
		ЧастиРеквизита = СтрРазделить(СтрокаТаблицы.Реквизит, ".");
		
		// Полное имя реквизита: "Тип.Объект.Реквизит.Поле" или
		// "Тип.Объект.ТабличнаяЧасть.ТЧ.Реквизит.Поле".
		Если ЧастиРеквизита.Количество() < 4 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.ТипМетаданных = ЧастиРеквизита[0];
		СтрокаТаблицы.ИмяМетаданных = ПолучитьИмяССинонимом(ЧастиРеквизита[1], ЧастиРеквизита[0] + "." + ЧастиРеквизита[1]);
		
		Если ЧастиРеквизита.Количество() >= 6 И ЧастиРеквизита[2] = "ТабличнаяЧасть" Тогда
			СтрокаТаблицы.ТабличнаяЧасть = ПолучитьИмяССинонимом(ЧастиРеквизита[3],
				ЧастиРеквизита[0] + "." + ЧастиРеквизита[1] + "." + ЧастиРеквизита[2] + "." + ЧастиРеквизита[3]);
			СтрокаТаблицы.ИмяРеквизита = ПолучитьИмяССинонимом(ЧастиРеквизита[5], СтрокаТаблицы.Реквизит);
		Иначе
			СтрокаТаблицы.ИмяРеквизита = ПолучитьИмяССинонимом(ЧастиРеквизита[3], СтрокаТаблицы.Реквизит);
		КонецЕсли;
		//СтрокаТаблицы.Ключ = ПолучитьСтроковыйКлюч(СтрокаТабличнойЧасти.НомерСтроки);
	КонецЦикла;
	ТаблицаРеквизитовОбъектов.Колонки.Удалить("СинонимОбъектаМетаданных");
	ТаблицаРеквизитовОбъектов.Колонки.Удалить("СинонимТабличнойЧасти");
	ТаблицаРеквизитовОбъектов.Колонки.Удалить("Синоним");
	ВнешниеНаборыДанных = Новый Структура("РеквизитыОбъектов", ТаблицаРеквизитовОбъектов);
	Дерево = ПолучитьДерево("МакетФормированияДереваРеквизитов", "РеквизитыМетаданных", ВнешниеНаборыДанных);
	ЗначениеВРеквизитФормы(Дерево, "ДеревоРеквизитов");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоРолей()
	
	Если Объект.РеквизитыОбъектов.Количество() = 0
		Или Объект.РолиМетаданных.Количество() = 0 Тогда
		ДеревоРолей.ПолучитьЭлементы().Очистить();
		Возврат;
	КонецЕсли;
	
	АктивныеМетаданныеТиповРеквизитов = ПолучитьАктивныеМетаданныеТиповРеквизитов(ЭтотОбъект);
	
	ТаблицаРолейМетаданных = Объект.РолиМетаданных.Выгрузить(Новый Массив);
	ТаблицаРолейМетаданных.Колонки.Добавить("ТипМетаданных",  Новый ОписаниеТипов("Строка"));
	ТаблицаРолейМетаданных.Колонки.Добавить("ИмяМетаданных",  Новый ОписаниеТипов("Строка"));
	ТаблицаРолейМетаданных.Колонки.Добавить("ТолькоПросмотр", Новый ОписаниеТипов("Булево"));
	Для Каждого СтрокаТабличнойЧасти Из Объект.РолиМетаданных Цикл
		Если АктивныеМетаданныеТиповРеквизитов[СтрокаТабличнойЧасти.Метаданные] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЧастиРеквизита = СтрРазделить(СтрокаТабличнойЧасти.Метаданные, ".");
		Если ЧастиРеквизита.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = ТаблицаРолейМетаданных.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТабличнойЧасти);
		СтрокаТаблицы.ТипМетаданных = ЧастиРеквизита[0];
		СтрокаТаблицы.ИмяМетаданных = ПолучитьИмяССинонимом(СтрокаТабличнойЧасти.Метаданные, СтрокаТабличнойЧасти.Метаданные);
		СтрокаТаблицы.ИмяРоли = ПолучитьИмяССинонимом(СтрокаТабличнойЧасти.ИмяРоли, СтрокаТабличнойЧасти.ИмяРоли);
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из ТаблицаРолейМетаданных Цикл
		Если СтрокаТаблицы.Использовать Тогда
			Если СтрокаТаблицы.ТолькоПросмотр Тогда
				Продолжить;
			КонецЕсли;
			СтрокиРоли = ТаблицаРолейМетаданных.НайтиСтроки(Новый Структура("Роль", СтрокаТаблицы.Роль));
			Для Каждого СтрокаРоли Из СтрокиРоли Цикл
				Если СтрокаРоли.Использовать Тогда
					Продолжить;
				КонецЕсли;
				СтрокаРоли.Использовать   = Истина;
				СтрокаРоли.ТолькоПросмотр = Истина;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	ТаблицаРолейМетаданных.Колонки.Удалить("ПравоЧтениеБезОграничения");
	ТаблицаРолейМетаданных.Колонки.Удалить("ПравоИзменениеБезОграничения");
	ТаблицаРолейМетаданных.Колонки.Удалить("ПравоДобавлениеБезОграничения");
	ВнешниеНаборыДанных = Новый Структура("РолиРеквизитов", ТаблицаРолейМетаданных);
	Дерево = ПолучитьДерево("МакетФормированияДереваРолей", "РолиПоМетаданным", ВнешниеНаборыДанных);
	ЗначениеВРеквизитФормы(Дерево, "ДеревоРолей");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяССинонимом(Имя, ИмяМетаданного)
	
	Если ИмяМетаданного = "" Тогда
		Результат = Имя;
	Иначе
		// ФиксированноеСоответствие: оператор [] на отсутствующем ключе вызывает исключение,
		// поэтому используется метод Получить.
		Синоним = СинонимыМетаданных.Получить(ИмяМетаданного);
		Если Синоним = Неопределено Тогда
			Результат = Имя;
		Иначе
			Результат = Имя + " (" + Синоним + ")";
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДерево(ИмяМакета, ИмяНастроек, ВнешниеНаборыДанных)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	СхемаКомпоновкиДанных = Обработка.ПолучитьМакет(ИмяМакета);
	
	НастройкиОтчета = СхемаКомпоновкиДанных.ВариантыНастроек[ИмяНастроек].Настройки;
	
	//ПриКомпоновкеРезультата(НастройкиОтчета, ВнешниеНаборыДанных);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	ДанныеРасшифровки = Неопределено;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ПроцессорВыводаВТабличныйДокумент = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВТабличныйДокумент.УстановитьОбъект(Новый ДеревоЗначений);
	ДеревоЗначений = ПроцессорВыводаВТабличныйДокумент.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ДеревоЗначений;
	
КонецФункции

&НаКлиенте
Процедура РаскрытьДеревоРеквизитов()
	
	РаскрытьКоллекциюЭлементовДерева(Элементы.ДеревоРеквизитов, ДеревоРеквизитов.ПолучитьЭлементы());
	
КонецПроцедуры

&НаКлиенте
Процедура РаскрытьДеревоРолей()
	
	РаскрытьКоллекциюЭлементовДерева(Элементы.ДеревоРолей, ДеревоРолей.ПолучитьЭлементы());
	
КонецПроцедуры

&НаКлиенте
Процедура РаскрытьКоллекциюЭлементовДерева(ЭлементФормы, КоллекцияЭлементов, СПодчиненными=Истина)
	
	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		ЭлементФормы.Развернуть(Элемент.ПолучитьИдентификатор(), СПодчиненными);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСтрокиДерева(КоллекцияЭлементов, Отбор, ВсеСтроки=Истина)
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		ЭлементПодходитОтбору = Истина;
		Для Каждого ЭлементОтбора Из Отбор Цикл
			Если Элемент[ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
				ЭлементПодходитОтбору = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭлементПодходитОтбору Тогда
			Результат.Добавить(Элемент);
			Если Не ВсеСтроки Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсеСтроки Или Результат.Количество() = 0 Тогда
		Для Каждого Элемент Из КоллекцияЭлементов Цикл
			ПодчиненныеСтроки = НайтиСтрокиДерева(Элемент.ПолучитьЭлементы(), Отбор, ВсеСтроки);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, ПодчиненныеСтроки);
			Если Не ВсеСтроки И Результат.Количество() > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДанные()
	
	ОбновитьДанныеНаСервере();
	РаскрытьДеревоРеквизитов();
	РаскрытьДеревоРолей();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеНаСервере()
	
	ЗаполнитьДанныеОбъектовПрофиля();
	ЗаполнитьДеревоРеквизитов();
	
	// >> Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023
	Если акс_ГруппироватьРолиПо = "ВидуДоступа" Тогда
		акс_ЗаполнитьДеревоРолейПоВидуДоступа();
		Возврат;
	ИначеЕсли акс_ГруппироватьРолиПо = "УровнюДоступа" Тогда // новый вариант
		акс_ЗаполнитьДеревоРолейПоУровнюДоступа();
		Возврат;
	ИначеЕсли акс_ГруппироватьРолиПо = "ПолюЗапроса" Тогда
		акс_ЗаполнитьДеревоРолейПоПолямЗапросов();
		Возврат;
    КонецЕсли;
	// << Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023
	
	ЗаполнитьДеревоРолей();
	
КонецПроцедуры

// >> Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023
&НаСервере
Процедура акс_ЗаполнитьДеревоРолейПоВидуДоступа()
	
	ДеревоРолей.ПолучитьЭлементы().Очистить();
	
	ДеревоРек = РеквизитФормыВЗначение("ДеревоРолей");
	
	// Группы идут от самого слабого права к самому сильному: строка попадает ровно в одну
	// группу - по самому сильному праву, которое роль дает на объект.
	ГруппыВидовДоступа = Новый Соответствие;
	ГруппыВидовДоступа.Вставить("Чтение",         ДобавитьГруппуВидаДоступа(ДеревоРек, "Чтение"));
	ГруппыВидовДоступа.Вставить("Просмотр",       ДобавитьГруппуВидаДоступа(ДеревоРек, "Просмотр"));
	ГруппыВидовДоступа.Вставить("Добавление",     ДобавитьГруппуВидаДоступа(ДеревоРек, "Добавление"));
	ГруппыВидовДоступа.Вставить("Изменение",      ДобавитьГруппуВидаДоступа(ДеревоРек, "Изменение"));
	ГруппыВидовДоступа.Вставить("Редактирование", ДобавитьГруппуВидаДоступа(ДеревоРек, "Редактирование"));
	ГруппыВидовДоступа.Вставить("Прочие права",   ДобавитьГруппуВидаДоступа(ДеревоРек, "Прочие права"));
	ГруппыВидовДоступа.Вставить("Без прав",       ДобавитьГруппуВидаДоступа(ДеревоРек, "Без прав"));
	
	РолиПоИмени = Новый Соответствие;
	Для Каждого Роль Из Метаданные.Роли Цикл
		РолиПоИмени.Вставить(Роль.Имя, Роль);
	КонецЦикла;
	
	Для Каждого СтрокаРолиМет Из Объект.РолиМетаданных Цикл
		
		ВидДоступа = ВидДоступаСтрокиРоли(СтрокаРолиМет, РолиПоИмени);
		Группа     = ГруппыВидовДоступа[ВидДоступа];
		
		ИмяСтроки = СтрокаРолиМет.ИмяРоли;
		Если ПустаяСтрока(ИмяСтроки) Тогда
			// Строки объектов, по которым роли вообще не подобраны: в табличной части
			// у них заполнены только метаданные, поэтому в дереве показывается имя объекта.
			ИмяСтроки = ПолучитьИмяССинонимом(СтрокаРолиМет.Метаданные, СтрокаРолиМет.Метаданные);
		КонецЕсли;
		
		// Роль показывается в группе один раз: команды установки флагов ищут строки
		// табличной части по имени роли, а не по объекту метаданных.
		Если Группа.Строки.Найти(ИмяСтроки, "ИмяРоли") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРоли = Группа.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРоли, СтрокаРолиМет);
		СтрокаРоли.ИмяРоли = ИмяСтроки;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРек, "ДеревоРолей");
	
КонецПроцедуры

// << Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023

// Добавляет в дерево ролей группу-корень вида доступа.
//
// Параметры:
//  ДеревоРолей - ДеревоЗначений - дерево ролей;
//  ИмяГруппы   - Строка - название вида доступа, например "Просмотр".
//
// Возвращаемое значение:
//  СтрокаДереваЗначений - добавленная строка-группа.
//
&НаСервереБезКонтекста
Функция ДобавитьГруппуВидаДоступа(ДеревоРолей, ИмяГруппы)
	
	Группа = ДеревоРолей.Строки.Добавить();
	Группа.ИмяРоли        = ИмяГруппы;
	Группа.ТолькоПросмотр = Истина;
	
	Возврат Группа;
	
КонецФункции

// Возвращает вид доступа строки ролей - группу дерева, в которую попадает строка.
//
// Вид доступа определяется по самому сильному праву, которое роль дает на объект,
// от слабого к сильному: "Чтение", "Просмотр", "Добавление", "Изменение",
// "Редактирование". Роль, дающая и чтение, и просмотр, попадает в группу "Просмотр",
// а роль, дающая еще и изменение (или редактирование), - в группу "Изменение"
// ("Редактирование"): ее нельзя принять за роль только на просмотр.
//
// Права "Удаление", "Проведение" и "ОтменаПроведения" в регистре "ПраваРолей" не хранятся,
// поэтому для строк с самыми слабыми правами они проверяются отдельно через ПравоДоступа
// и такие роли попадают в группу "Прочие права". Строки, по которым прав не найдено вовсе
// (объекты, для которых роли не подобраны), попадают в группу "Без прав".
//
// Параметры:
//  СтрокаРолиМетаданных - СтрокаТаблицыЗначений - строка табличной части "РолиМетаданных";
//  РолиПоИмени           - Соответствие из КлючИЗначение - роли конфигурации:
//                          * Ключ     - Строка - имя роли;
//                          * Значение - ОбъектМетаданныхРоль - роль.
//
// Возвращаемое значение:
//  Строка - название вида доступа, например "Просмотр".
//
&НаСервереБезКонтекста
Функция ВидДоступаСтрокиРоли(СтрокаРолиМетаданных, РолиПоИмени)
	
	Если СтрокаРолиМетаданных.ПравоРедактирование > 0 Тогда
		Возврат "Редактирование";
	КонецЕсли;
	
	Если СтрокаРолиМетаданных.ПравоИзменение > 0 Тогда
		Возврат "Изменение";
	КонецЕсли;
	
	Если СтрокаРолиМетаданных.ПравоДобавление > 0
		Или СтрокаРолиМетаданных.ПравоИнтерактивноеДобавление > 0 Тогда
		Возврат "Добавление";
	КонецЕсли;
	
	Если СтрокаРолиМетаданных.ПравоПросмотр > 0
		Или СтрокаРолиМетаданных.ПравоЧтение > 0 Тогда
		
		Если ЕстьПраваСверхПросмотра(СтрокаРолиМетаданных, РолиПоИмени) Тогда
			Возврат "Прочие права";
		КонецЕсли;
		
		Если СтрокаРолиМетаданных.ПравоПросмотр > 0 Тогда
			Возврат "Просмотр";
		КонецЕсли;
		
		Возврат "Чтение";
		
	КонецЕсли;
	
	Возврат "Без прав";
	
КонецФункции

// Проверяет, дает ли роль права, которых нет в регистре "ПраваРолей" (удаление,
// проведение, отмена проведения), то есть права сильнее просмотра.
//
// Параметры:
//  СтрокаРолиМетаданных - СтрокаТаблицыЗначений - строка табличной части "РолиМетаданных";
//  РолиПоИмени           - Соответствие из КлючИЗначение - роли конфигурации:
//                          * Ключ     - Строка - имя роли;
//                          * Значение - ОбъектМетаданныхРоль - роль.
//
// Возвращаемое значение:
//  Булево - Истина, если роль дает хотя бы одно из таких прав.
//
&НаСервереБезКонтекста
Функция ЕстьПраваСверхПросмотра(СтрокаРолиМетаданных, РолиПоИмени)
	
	ПраваСверхПросмотра = ПраваСверхПросмотраОбъекта(СтрокаРолиМетаданных.Метаданные);
	Если ПраваСверхПросмотра.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СтрокаРолиМетаданных.Метаданные);
	Роль            = РолиПоИмени[СтрокаРолиМетаданных.ИмяРоли];
	Если ОбъектМетаданных = Неопределено Или Роль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ИмяПрава Из ПраваСверхПросмотра Цикл
		Если ПравоДоступа(ИмяПрава, ОбъектМетаданных, Роль) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает права, которых нет в регистре "ПраваРолей" и которые делают роль
// сильнее просмотра, применимые к объекту метаданных.
//
// Параметры:
//  ПолноеИмяМетаданных - Строка - полное имя объекта метаданных, например
//                        "Документ.ЗаказПокупателя".
//
// Возвращаемое значение:
//  Массив из Строка - имена прав, например "Проведение", "Удаление".
//
&НаСервереБезКонтекста
Функция ПраваСверхПросмотраОбъекта(ПолноеИмяМетаданных)
	
	Права = Новый Массив;
	
	Если СтрНачинаетсяС(ПолноеИмяМетаданных, "Документ.") Тогда
		Права.Добавить("Проведение");
		Права.Добавить("ОтменаПроведения");
	КонецЕсли;
	
	// Право "Удаление" применимо только к объектам, у которых есть таблица самого объекта.
	ТипыСПравомУдаление = Новый Массив;
	ТипыСПравомУдаление.Добавить("Документ");
	ТипыСПравомУдаление.Добавить("Справочник");
	ТипыСПравомУдаление.Добавить("ПланОбмена");
	ТипыСПравомУдаление.Добавить("ПланВидовХарактеристик");
	ТипыСПравомУдаление.Добавить("ПланСчетов");
	ТипыСПравомУдаление.Добавить("ПланВидовРасчета");
	ТипыСПравомУдаление.Добавить("БизнесПроцесс");
	ТипыСПравомУдаление.Добавить("Задача");
	
	Для Каждого ИмяТипа Из ТипыСПравомУдаление Цикл
		Если СтрНачинаетсяС(ПолноеИмяМетаданных, ИмяТипа + ".") Тогда
			Права.Добавить("Удаление");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Права;
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатПодбораРолей()
	
	РолиПрофиля = Новый Массив;
	АктивныеМетаданныеТиповРеквизитов = ПолучитьАктивныеМетаданныеТиповРеквизитов(ЭтотОбъект);
	Для Каждого СтрокаТабличнойЧасти Из Объект.РолиМетаданных Цикл
		Если Не СтрокаТабличнойЧасти.Использовать Тогда
			Продолжить;
		КонецЕсли;
		// Объекты вне профиля становятся активными метаданными после отметки их реквизитов
		// в дереве реквизитов, поэтому отмеченные по ним роли переносятся в профиль.
		Если АктивныеМетаданныеТиповРеквизитов[СтрокаТабличнойЧасти.Метаданные] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РолиПрофиля.Добавить(СтрокаТабличнойЧасти.Роль);
	КонецЦикла;
	РолиПрофиля    = ОбщегоНазначенияКлиентСервер.СвернутьМассив(РолиПрофиля);
	ОбъектыПрофиля = Объект.ОбъектыПрофиля.Выгрузить(, "ОбъектМетаданных").ВыгрузитьКолонку("ОбъектМетаданных");
	
	Возврат Новый Структура("Роли,Объекты", РолиПрофиля, ОбъектыПрофиля);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтроковыйКлюч(Ключ)
	
	Возврат Формат(Ключ, "ЧН=; ЧГ=; ЧФ=%Ч%");
	
КонецФункции

&НаСервере
Процедура акс_ЗаполнитьДеревоРолейПоУровнюДоступа()
    
    // Проверка наличия данных
    Если Объект.РеквизитыОбъектов.Количество() = 0
       Или Объект.РолиМетаданных.Количество() = 0 Тогда
        ДеревоРолей.ПолучитьЭлементы().Очистить();
        Возврат;
    КонецЕсли;
    
    АктивныеМетаданныеТиповРеквизитов = ПолучитьАктивныеМетаданныеТиповРеквизитов(ЭтотОбъект);
    
    // Формируем временную таблицу с данными ролей (аналогично стандартной процедуре)
    ТаблицаРолейМетаданных = Объект.РолиМетаданных.Выгрузить(Новый Массив);
    ТаблицаРолейМетаданных.Колонки.Добавить("ТипМетаданных",  Новый ОписаниеТипов("Строка"));
    ТаблицаРолейМетаданных.Колонки.Добавить("ИмяМетаданных",  Новый ОписаниеТипов("Строка"));
    ТаблицаРолейМетаданных.Колонки.Добавить("ТолькоПросмотр", Новый ОписаниеТипов("Булево"));
    
    Для Каждого СтрокаТабличнойЧасти Из Объект.РолиМетаданных Цикл
        Если АктивныеМетаданныеТиповРеквизитов[СтрокаТабличнойЧасти.Метаданные] = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ЧастиРеквизита = СтрРазделить(СтрокаТабличнойЧасти.Метаданные, ".");
        Если ЧастиРеквизита.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        СтрокаТаблицы = ТаблицаРолейМетаданных.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаТабличнойЧасти);
        СтрокаТаблицы.ТипМетаданных = ЧастиРеквизита[0];
        СтрокаТаблицы.ИмяМетаданных = ПолучитьИмяССинонимом(СтрокаТабличнойЧасти.Метаданные, СтрокаТабличнойЧасти.Метаданные);
        СтрокаТаблицы.ИмяРоли       = ПолучитьИмяССинонимом(СтрокаТабличнойЧасти.ИмяРоли, СтрокаТабличнойЧасти.ИмяРоли);
    КонецЦикла;
    
    // Обработка зависимых ролей (как в ЗаполнитьДеревоРолей)
    Для Каждого СтрокаТаблицы Из ТаблицаРолейМетаданных Цикл
        Если СтрокаТаблицы.Использовать И НЕ СтрокаТаблицы.ТолькоПросмотр Тогда
            СтрокиРоли = ТаблицаРолейМетаданных.НайтиСтроки(Новый Структура("Роль", СтрокаТаблицы.Роль));
            Для Каждого СтрокаРоли Из СтрокиРоли Цикл
                Если НЕ СтрокаРоли.Использовать Тогда
                    СтрокаРоли.Использовать   = Истина;
                    СтрокаРоли.ТолькоПросмотр = Истина;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    
    // Построение дерева, сгруппированного по правам
    ДеревоРек = РеквизитФормыВЗначение("ДеревоРолей");
    ДеревоРек.Строки.Очистить();
    
    УзлыПрав        = Новый Соответствие;
    УзлыТипов       = Новый Соответствие;
    УзлыМетаданных  = Новый Соответствие;
    
    Для Каждого СтрокаРоли Из ТаблицаРолейМетаданных Цикл
        
        МассивПравСтроки = Новый Массив;
        Если СтрокаРоли.ПравоЧтение > 0 Тогда
            МассивПравСтроки.Добавить("Чтение");
        КонецЕсли;
        Если СтрокаРоли.ПравоИзменение > 0 Тогда
            МассивПравСтроки.Добавить("Изменение");
        КонецЕсли;
        Если СтрокаРоли.ПравоДобавление > 0 Тогда
            МассивПравСтроки.Добавить("Добавление");
        КонецЕсли;
        Если СтрокаРоли.ПравоПросмотр > 0 Тогда
            МассивПравСтроки.Добавить("Просмотр");
        КонецЕсли;
        Если СтрокаРоли.ПравоРедактирование > 0 Тогда
            МассивПравСтроки.Добавить("Редактирование");
        КонецЕсли;
        Если СтрокаРоли.ПравоИнтерактивноеДобавление > 0 Тогда
            МассивПравСтроки.Добавить("ИнтерактивноеДобавление");
        КонецЕсли;
        
        Для Каждого НазваниеПрава Из МассивПравСтроки Цикл
            
            // Узел права
            УзелПрава = УзлыПрав.Получить(НазваниеПрава);
            Если УзелПрава = Неопределено Тогда
                УзелПрава = ДеревоРек.Строки.Добавить();
                УзелПрава.ИмяРоли = НазваниеПрава;
                УзелПрава.Метаданные = "";
                УзелПрава.Роль = Неопределено;
                УзелПрава.ТолькоПросмотр = Истина;
                УзлыПрав.Вставить(НазваниеПрава, УзелПрава);
            КонецЕсли;
            
            // Узел типа метаданных
            КлючТипа = НазваниеПрава + "|" + СтрокаРоли.ТипМетаданных;
            УзелТипа = УзлыТипов.Получить(КлючТипа);
            Если УзелТипа = Неопределено Тогда
                УзелТипа = УзелПрава.Строки.Добавить();
                УзелТипа.ИмяРоли = СтрокаРоли.ТипМетаданных;
                УзелТипа.Метаданные = "";
                УзелТипа.Роль = Неопределено;
                УзелТипа.ТолькоПросмотр = Истина;
                УзлыТипов.Вставить(КлючТипа, УзелТипа);
            КонецЕсли;
            
            // Узел объекта метаданных
            КлючМетаданных = КлючТипа + "|" + СтрокаРоли.Метаданные;
            УзелМетаданных = УзлыМетаданных.Получить(КлючМетаданных);
            Если УзелМетаданных = Неопределено Тогда
                УзелМетаданных = УзелТипа.Строки.Добавить();
                УзелМетаданных.ИмяРоли = СтрокаРоли.ИмяМетаданных;
                УзелМетаданных.Метаданные = СтрокаРоли.Метаданные;
                УзелМетаданных.Роль = Неопределено;
                УзелМетаданных.ТолькоПросмотр = Истина;
                УзлыМетаданных.Вставить(КлючМетаданных, УзелМетаданных);
            КонецЕсли;
            
            // Конечный узел – роль
            СтрокаДерева = УзелМетаданных.Строки.Добавить();
            ЗаполнитьЗначенияСвойств(СтрокаДерева, СтрокаРоли);
            СтрокаДерева.ИмяРоли = СтрокаРоли.ИмяРоли;
            
        КонецЦикла;
        
    КонецЦикла;
    
	ЗначениеВРеквизитФормы(ДеревоРек, "ДеревоРолей");
	
КонецПроцедуры

// >> Чалый Д.А. (Аксиома) | Группировка ролей по полям запросов | 28.09.2026
// Заполняет дерево ролей группировкой по объектам метаданных, поля которых используются
// в запросах модулей: в узел объекта попадают только те роли, которые дают доступ
// к этим полям. Доступность полей проверяется функцией ПараметрыДоступа, поэтому
// учитываются в том числе ограничения доступа на уровне записей и полей.
//
&НаСервере
Процедура акс_ЗаполнитьДеревоРолейПоПолямЗапросов()
	
	ДеревоРолей.ПолучитьЭлементы().Очистить();
	
	ДеревоРек = РеквизитФормыВЗначение("ДеревоРолей");
	
	ПоляПоМетаданным = ПоляЗапросовПоМетаданнымПрофиля();
	
	Если ПоляПоМетаданным.Количество() > 0 Тогда
		
		СтрокиРолейПоМетаданным = СтрокиРолейПоМетаданным();
		
		Для Каждого КлючИЗначение Из ПоляПоМетаданным Цикл
			
			ПолноеИмяМетаданного = КлючИЗначение.Ключ;
			ПоляЗапроса          = КлючИЗначение.Значение;
			
			СтрокиРолей = СтрокиРолейПоМетаданным.Получить(ПолноеИмяМетаданного);
			Если СтрокиРолей = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектМетаданныхПолей = ОбъектМетаданныхДляПроверкиПолей(ПолноеИмяМетаданного);
			Если ОбъектМетаданныхПолей = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СписокПолей = СписокПолейДляПроверкиПрав(ПолноеИмяМетаданного, ПоляЗапроса);
			Если ПустаяСтрока(СписокПолей) Тогда
				Продолжить;
			КонецЕсли;
			
			УзелМетаданного = Неопределено;
			
			Для Каждого СтрокаРолиМет Из СтрокиРолей Цикл
				
				Роль = Метаданные.НайтиПоПолномуИмени("Роль." + СтрокаРолиМет.ИмяРоли);
				Если Роль = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если Не ПараметрыДоступа("Просмотр", ОбъектМетаданныхПолей, СписокПолей, Роль).Доступность Тогда
					Продолжить;
				КонецЕсли;
				
				Если УзелМетаданного = Неопределено Тогда
					УзелМетаданного = ДеревоРек.Строки.Добавить();
					УзелМетаданного.ИмяРоли        = ИмяУзлаПолейЗапроса(ПолноеИмяМетаданного, ПоляЗапроса);
					УзелМетаданного.Метаданные     = ПолноеИмяМетаданного;
					УзелМетаданного.ТолькоПросмотр = Истина;
				КонецЕсли;
				
				ИмяРоли = ПолучитьИмяССинонимом(СтрокаРолиМет.ИмяРоли, СтрокаРолиМет.ИмяРоли);
				Если УзелМетаданного.Строки.Найти(ИмяРоли, "ИмяРоли") <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаРоли = УзелМетаданного.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРоли, СтрокаРолиМет);
				СтрокаРоли.ИмяРоли = ИмяРоли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоРек, "ДеревоРолей");
	
КонецПроцедуры

// Возвращает поля объектов метаданных, используемые в запросах модулей, по активным метаданным профиля.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - поля по объектам метаданных:
//   * Ключ     - Строка - полное имя объекта метаданных;
//   * Значение - Массив из Строка - имена полей, используемых в запросах.
//
&НаСервере
Функция ПоляЗапросовПоМетаданнымПрофиля()
	
	Результат = Новый Соответствие;
	
	СписокМетаданных = Новый Массив;
	Для Каждого КлючИЗначение Из ПолучитьАктивныеМетаданныеТиповРеквизитов(ЭтотОбъект) Цикл
		СписокМетаданных.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Если СписокМетаданных.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Поля.Метаданные КАК Метаданные,
		|	Поля.Поле КАК Поле
		|ИЗ
		|	РегистрСведений.ППГД_ПоляВЗапросахМодулей КАК Поля
		|ГДЕ
		|	Поля.Метаданные В (&СписокМетаданных)
		|УПОРЯДОЧИТЬ ПО
		|	Поля.Метаданные,
		|	Поля.Поле");
	Запрос.УстановитьПараметр("СписокМетаданных", СписокМетаданных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Поля = Результат.Получить(Выборка.Метаданные);
		Если Поля = Неопределено Тогда
			Поля = Новый Массив;
			Результат.Вставить(Выборка.Метаданные, Поля);
		КонецЕсли;
		
		Поля.Добавить(Выборка.Поле);
		
	КонецЦикла;
	
	// По объектам вне профиля роли проверяются только по отмеченным в дереве реквизитов полям:
	// остальные поля этих объектов профилю не нужны.
	ОтмеченныеРеквизиты = Новый Соответствие;
	МетаданныеВнеПрофиля  = МетаданныеВнеПрофиляПоТаблице(ЭтотОбъект);
	Для Каждого СтрокаРеквизита Из Объект.РеквизитыОбъектов Цикл
		Если СтрокаРеквизита.Использовать Тогда
			ОтмеченныеРеквизиты.Вставить(СтрокаРеквизита.Реквизит, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из Результат Цикл
		
		Если МетаданныеВнеПрофиля.Получить(ПолноеИмяОбъектаРеквизита(КлючИЗначение.Ключ)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОтмеченныеПоля = Новый Массив;
		Для Каждого Поле Из КлючИЗначение.Значение Цикл
			Реквизит = РеквизитПоМетаданнымИПолю(КлючИЗначение.Ключ, Поле);
			Если ОтмеченныеРеквизиты.Получить(Реквизит) <> Неопределено Тогда
				ОтмеченныеПоля.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
		
		КлючИЗначение.Значение = ОтмеченныеПоля;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя объекта метаданных из полного имени: "ЗаказПокупателя" для
// "Документ.ЗаказПокупателя" и для "Документ.ЗаказПокупателя.ТабличнаяЧасть.Товары".
//
// Параметры:
//  ПолноеИмяМетаданного - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Строка - имя объекта метаданных, пустая строка - если имя разобрать не удалось.
//
&НаСервереБезКонтекста
Функция ИмяОбъектаПолногоИмени(Знач ПолноеИмяМетаданного)
	
	Части = СтрРазделить(ПолноеИмяМетаданного, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Части[1];
	
КонецФункции

// Возвращает объекты профиля, модули которых обращаются к объекту вне профиля.
// Путь модуля имеет вид "<Тип>/<ИмяОбъекта>/..." (например "Documents/ЗаказПокупателя/..."),
// но перед ним может стоять каталог выгрузки, поэтому имя объекта ищется в любом элементе пути.
//
// Параметры:
//  СписокМодулей        - Строка - пути модулей, соединенные "; ";
//  ИменаОбъектовПрофиля - Соответствие из КлючИЗначение - объекты профиля:
//                         * Ключ     - Строка - имя объекта метаданных;
//                         * Значение - Строка - полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Массив из Строка - полные имена объектов профиля, модули которых обращаются к объекту.
//
&НаСервереБезКонтекста
Функция ОбъектыПрофиляВМодулях(Знач СписокМодулей, ИменаОбъектовПрофиля)
	
	Результат = Новый Массив;
	
	Для Каждого ПутьМодуля Из СтрРазделить(СписокМодулей, "; ", Ложь) Цикл
		
		ПолноеИмяОбъекта = Неопределено;
		Для Каждого ЭлементПути Из СтрРазделить(ПутьМодуля, "/", Ложь) Цикл
			ПолноеИмяОбъекта = ИменаОбъектовПрофиля.Получить(ЭлементПути);
			Если ПолноеИмяОбъекта <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПолноеИмяОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Результат.Найти(ПолноеИмяОбъекта) = Неопределено Тогда
			Результат.Добавить(ПолноеИмяОбъекта);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строки табличной части "РолиМетаданных" в разрезе объектов метаданных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - строки ролей по объектам метаданных:
//   * Ключ     - Строка - полное имя объекта метаданных;
//   * Значение - Массив из СтрокаТаблицыЗначений - строки табличной части "РолиМетаданных".
//
&НаСервере
Функция СтрокиРолейПоМетаданным()
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрокаТабличнойЧасти Из Объект.РолиМетаданных Цикл
		
		Если ПустаяСтрока(СтрокаТабличнойЧасти.ИмяРоли) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиРолей = Результат.Получить(СтрокаТабличнойЧасти.Метаданные);
		Если СтрокиРолей = Неопределено Тогда
			СтрокиРолей = Новый Массив;
			Результат.Вставить(СтрокаТабличнойЧасти.Метаданные, СтрокиРолей);
		КонецЕсли;
		
		СтрокиРолей.Добавить(СтрокаТабличнойЧасти);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает объект метаданных, для которого проверяются права на поля.
//
// Параметры:
//  ПолноеИмяМетаданного - Строка - полное имя объекта метаданных, в том числе табличной части.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - объект метаданных, допустимый в функции ПараметрыДоступа.
//
&НаСервереБезКонтекста
Функция ОбъектМетаданныхДляПроверкиПолей(Знач ПолноеИмяМетаданного)
	
	Части = СтрРазделить(ПолноеИмяМетаданного, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Функция ПараметрыДоступа принимает только перечисленные виды объектов метаданных.
	ДопустимыеТипы = "ПланОбмена,Справочник,Документ,ЖурналДокументов,Последовательность,ПланВидовХарактеристик,"
		+ "ПланСчетов,ПланВидовРасчета,РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета,"
		+ "Перерасчет,БизнесПроцесс,Задача,ВнешнийИсточникДанных";
	
	Если СтрРазделить(ДопустимыеТипы, ",", Ложь).Найти(Части[0]) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	
КонецФункции

// Возвращает список полей для проверки прав функцией ПараметрыДоступа.
//
// Параметры:
//  ПолноеИмяМетаданного - Строка - полное имя объекта метаданных, в том числе табличной части;
//  ПоляЗапроса          - Массив из Строка - имена полей, используемых в запросах.
//
// Возвращаемое значение:
//  Строка - список полей через запятую; пустая строка, если проверять нечего.
//
&НаСервереБезКонтекста
Функция СписокПолейДляПроверкиПрав(Знач ПолноеИмяМетаданного, ПоляЗапроса)
	
	Части = СтрРазделить(ПолноеИмяМетаданного, ".", Ложь);
	ИмяТабличнойЧасти = "";
	Если Части.Количество() >= 4 И Части[2] = "ТабличнаяЧасть" Тогда
		ИмяТабличнойЧасти = Части[3];
	КонецЕсли;
	
	ПоляДляПроверки = Новый Массив;
	Для Каждого Поле Из ПоляЗапроса Цикл
		
		// Поле "*" в функции ПараметрыДоступа указать нельзя.
		Если Поле = "*" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяТабличнойЧасти) Тогда
			ПоляДляПроверки.Добавить(Поле);
		Иначе
			ПоляДляПроверки.Добавить(ИмяТабличнойЧасти + "." + Поле);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(ПоляДляПроверки, ", ");
	
КонецФункции

// Возвращает имя узла дерева ролей для объекта метаданных с перечнем полей из запросов.
//
// Параметры:
//  ПолноеИмяМетаданного - Строка - полное имя объекта метаданных;
//  ПоляЗапроса          - Массив из Строка - имена полей, используемых в запросах.
//
// Возвращаемое значение:
//  Строка - имя узла дерева ролей.
//
&НаСервереБезКонтекста
Функция ИмяУзлаПолейЗапроса(Знач ПолноеИмяМетаданного, ПоляЗапроса)
	
	МаксимумПолейВИмени = 5;
	
	ПоказанныеПоля = Новый Массив;
	Для Каждого Поле Из ПоляЗапроса Цикл
		Если ПоказанныеПоля.Количество() >= МаксимумПолейВИмени Тогда
			Прервать;
		КонецЕсли;
		ПоказанныеПоля.Добавить(Поле);
	КонецЦикла;
	
	ПереченьПолей = СтрСоединить(ПоказанныеПоля, ", ");
	Если ПоляЗапроса.Количество() > МаксимумПолейВИмени Тогда
		ПереченьПолей = ПереченьПолей + СтрШаблон(
			НСтр("ru = ' и еще %1'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ПоляЗапроса.Количество() - МаксимумПолейВИмени);
	КонецЕсли;
	
	Возврат ПолноеИмяМетаданного + ": " + ПереченьПолей;
	
КонецФункции
// << Чалый Д.А. (Аксиома) | Группировка ролей по полям запросов | 28.09.2026

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	//ЗаполнитьСписокОбъектовПрофиля();
	ЗаполнитьДанныеОбъектовПрофиля();
	ЗаполнитьДеревоРеквизитов();
	
	// >> Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023
	Если акс_ГруппироватьРолиПо = "ВидуДоступа" Тогда
		
		акс_ЗаполнитьДеревоРолейПоВидуДоступа();
		Возврат;
		
	ИначеЕсли акс_ГруппироватьРолиПо = "УровнюДоступа" Тогда
		
		акс_ЗаполнитьДеревоРолейПоУровнюДоступа();
		Возврат;
		
	ИначеЕсли акс_ГруппироватьРолиПо = "ПолюЗапроса" Тогда
		
		акс_ЗаполнитьДеревоРолейПоПолямЗапросов();
		Возврат;
		
	КонецЕсли;
	// << Чалый Д.А. (Аксиома) | Группировка ролей по виду доступа | 08.12.2023

	ЗаполнитьДеревоРолей();
	
КонецПроцедуры



&НаКлиенте
Процедура РазвернутьСтрокуРекурсивно(СтрокаДерева, ВключаяПодчиненные)
    Элементы.ДеревоРолей.Развернуть(СтрокаДерева.ПолучитьИдентификатор());
    Если ВключаяПодчиненные Тогда
        Для Каждого Подч Из СтрокаДерева.ПолучитьЭлементы() Цикл
            РазвернутьСтрокуРекурсивно(Подч, Истина);
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СвернутьСтрокуРекурсивно(СтрокаДерева, ВключаяПодчиненные)
    Если ВключаяПодчиненные Тогда
        Для Каждого Подч Из СтрокаДерева.ПолучитьЭлементы() Цикл
            СвернутьСтрокуРекурсивно(Подч, Истина);
        КонецЦикла;
    КонецЕсли;
    Элементы.ДеревоРолей.Свернуть(СтрокаДерева.ПолучитьИдентификатор());
КонецПроцедуры

#КонецОбласти