#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВыполняетсяОбработка = Ложь;
	СостояниеОбработки = "Укажите свойства и нажмите «Найти значения».";
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменаЗавершена(Результат, ДополнительныеПараметры) Экспорт
	
	ВыполняетсяОбработка = Ложь;
	
	Если Результат = Неопределено Тогда
		СостояниеОбработки = "Замена отменена.";
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СостояниеОбработки = "Ошибка выполнения замены.";
		ПоказатьПредупреждение(, "Замена не выполнена. Подробности в журнале регистрации.");
		Возврат;
	КонецЕсли;
	
	ТаблицаРезультата = ПолучитьРезультатЗамены(Результат.АдресРезультата);
	Данные.Загрузить(ТаблицаРезультата);
	
	Перенесено = 0;
	Заменено = 0;
	Создано = 0;
	Пропущено = 0;
	Ошибок = 0;
	Для Каждого Строка Из Данные Цикл
		Если Строка.Статус = "Перенесено" Тогда
			Перенесено = Перенесено + 1;
		ИначеЕсли Строка.Статус = "Заменено" Тогда
			Заменено = Заменено + 1;
		ИначеЕсли Строка.Статус = "Значение создано" Тогда
			Создано = Создано + 1;
		ИначеЕсли СтрНачинаетсяС(Строка.Статус, "Ошибка") Тогда
			Ошибок = Ошибок + 1;
		Иначе
			Пропущено = Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	
	СостояниеОбработки = СтрШаблон("Готово. Видов изменено: %1, перенесено значений: %2, создано значений: %3, пропущено: %4, ошибок: %5.",
		Заменено, Перенесено, Создано, Пропущено, Ошибок);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияЗамены(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполняетсяОбработка = Истина;
	СостояниеОбработки = "Запуск замены...";
	
	ДлительнаяОперация = ЗапуститьЗаменуНаСервере();
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОповещениеНаЭкран = Истина;
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаменаЗавершена", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СвойствоИсточникПриИзменении(Элемент)
	
	ОчиститьТаблицы();
	СостояниеОбработки = "Укажите свойства и нажмите «Найти значения».";
	
КонецПроцедуры

&НаКлиенте
Процедура СвойствоПриемникПриИзменении(Элемент)
	
	ОчиститьТаблицы();
	СостояниеОбработки = "Укажите свойства и нажмите «Найти значения».";
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеГруппаСозданияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(СвойствоПриемник) Тогда
		ПоказатьПредупреждение(, "Сначала укажите свойство-приёмник.");
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Владелец", СвойствоПриемник));
	ОткрытьФорму("Справочник.ЗначенияСвойствОбъектовИерархия.ФормаВыбора", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиЗначения(Команда)
	
	Проверка = ПроверитьПараметрыНаСервере();
	Если Не ОбработатьПроверкуПараметров(Проверка) Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеОбработки = "Поиск соответствий значений...";
	ТаблицаСоответствий = СопоставитьЗначенияНаСервере();
	СоответствияЗначений.Загрузить(ТаблицаСоответствий);
	
	Найдено = 0;
	НеНайдено = 0;
	Неоднозначно = 0;
	Для Каждого Строка Из СоответствияЗначений Цикл
		Если Строка.Статус = "Найдено" Тогда
			Найдено = Найдено + 1;
		ИначеЕсли Строка.Статус = "Не найдено" Тогда
			НеНайдено = НеНайдено + 1;
		ИначеЕсли Строка.Статус = "Неоднозначно" Тогда
			Неоднозначно = Неоднозначно + 1;
		КонецЕсли;
	КонецЦикла;
	
	СостояниеОбработки = СтрШаблон("Значений: %1. Найдено: %2, не найдено: %3, неоднозначно: %4.",
		СоответствияЗначений.Количество(), Найдено, НеНайдено, Неоднозначно);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГруппу(Команда)
	
	Если Не ЗначениеЗаполнено(ГруппаСоздания) Тогда
		ПоказатьПредупреждение(, "Укажите группу для создания значений.");
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.ТаблицаСоответствий.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки таблицы соответствий.");
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ВыделенныеСтроки Цикл
		Строка.ГруппаСоздания = ГруппаСоздания;
	КонецЦикла;
	
	СостояниеОбработки = СтрШаблон("Группа заполнена у %1 строк.", ВыделенныеСтроки.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДанные(Команда)
	
	Проверка = ПроверитьПараметрыНаСервере();
	Если Не ОбработатьПроверкуПараметров(Проверка) Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеОбработки = "Получение данных...";
	ТаблицаДанных = ПолучитьДанныеНаСервере();
	Данные.Загрузить(ТаблицаДанных);
	
	Если Данные.Количество() = 0 Тогда
		СостояниеОбработки = "Данных для замены не найдено.";
	Иначе
		СостояниеОбработки = СтрШаблон("Показаны данные: %1 строк.", Данные.Количество());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗамену(Команда)
	
	Проверка = ПроверитьПараметрыНаСервере();
	Если Не ОбработатьПроверкуПараметров(Проверка) Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияЗамены", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Выполнить замену свойства? Действие изменяет данные.",
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Подтверждение замены");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОчиститьТаблицы()
	
	СоответствияЗначений.Очистить();
	Данные.Очистить();
	
КонецПроцедуры

&НаКлиенте
Функция ОбработатьПроверкуПараметров(Проверка)
	
	Если Проверка.Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Проверка.Ошибки, Символы.ПС));
		СостояниеОбработки = "Параметры заполнены неверно.";
		Возврат Ложь;
	КонецЕсли;
	
	Если Проверка.Предупреждения.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Проверка.Предупреждения, Символы.ПС));
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьПараметрыНаСервере()
	
	Возврат Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.ПроверитьПараметры(СвойствоИсточник, СвойствоПриемник);
	
КонецФункции

&НаСервере
Функция СопоставитьЗначенияНаСервере()
	
	Проверка = Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.ПроверитьПараметры(СвойствоИсточник, СвойствоПриемник);
	Возврат Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.СопоставитьЗначения(
		СвойствоИсточник, СвойствоПриемник, Проверка.СвойстваИсточника);
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеНаСервере()
	
	Проверка = Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.ПроверитьПараметры(СвойствоИсточник, СвойствоПриемник);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("СвойствоИсточник", СвойствоИсточник);
	ПараметрыЗапроса.Вставить("СвойствоПриемник", СвойствоПриемник);
	ПараметрыЗапроса.Вставить("СвойстваИсточника", Проверка.СвойстваИсточника);
	ПараметрыЗапроса.Вставить("Предел", 1000);
	
	Возврат Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.ДанныеДляЗамены(ПараметрыЗапроса);
	
КонецФункции

&НаСервере
Функция ЗапуститьЗаменуНаСервере()
	
	Проверка = Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.ПроверитьПараметры(СвойствоИсточник, СвойствоПриемник);
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("СвойствоИсточник", СвойствоИсточник);
	ПараметрыЗадания.Вставить("СвойствоПриемник", СвойствоПриемник);
	ПараметрыЗадания.Вставить("СвойстваИсточника", Проверка.СвойстваИсточника);
	ПараметрыЗадания.Вставить("Соответствия", СоответствияЗначений.Выгрузить());
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Замена дополнительного реквизита номенклатуры";
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработка.ГКСК_ЗаменаДополнительныхРеквизитов.МодульОбъекта.ВыполнитьЗамену",
		ПараметрыЗадания);
	
КонецФункции

&НаСервере
Функция ПолучитьРезультатЗамены(АдресРезультата)
	
	Возврат Обработки.ГКСК_ЗаменаДополнительныхРеквизитов.РезультатИзВременногоХранилища(АдресРезультата);
	
КонецФункции

#КонецОбласти
