#Область ПрограммныйИнтерфейс

// Возвращает массив ссылок свойств-элементов для выбранного свойства или группы свойств.
// Если указана группа - рекурсивно собираются все вложенные свойства-элементы.
//
// Параметры:
//  СвойствоИлиГруппа - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство или группа свойств.
//
// Возвращаемое значение:
//  Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - ссылки на свойства-элементы,
//  являющиеся дополнительными реквизитами.
//
Функция СвойстваИсточника(СвойствоИлиГруппа) Экспорт
	
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СвойствоИлиГруппа) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(СвойствоИлиГруппа);
	Описания = ОписанияСвойств(Ссылки);
	
	Если Описания.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Описание = Описания[0];
	Если Не Описание.ЭтоГруппа Тогда
		Если Не Описание.ЭтоДополнительноеСведение Тогда
			Результат.Добавить(СвойствоИлиГруппа);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Выборка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ВыбратьИерархически(СвойствоИлиГруппа);
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Или Выборка.ЭтоДополнительноеСведение Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет корректность пары свойств для замены.
//
// Параметры:
//  СвойствоИсточник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство или группа, из которых переносятся значения.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство, в которое переносятся значения.
//
// Возвращаемое значение:
//  Структура:
//   * Ошибки - Массив из Строка - ошибки, запрещающие запуск.
//   * Предупреждения - Массив из Строка - замечания, не запрещающие запуск.
//   * СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//
Функция ПроверитьПараметры(СвойствоИсточник, СвойствоПриемник) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);
	Результат.Вставить("СвойстваИсточника", Новый Массив);
	
	Если Не ЗначениеЗаполнено(СвойствоИсточник) Или Не ЗначениеЗаполнено(СвойствоПриемник) Тогда
		Результат.Ошибки.Добавить("Необходимо указать свойство-источник и свойство-приёмник.");
		Возврат Результат;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(СвойствоИсточник);
	Ссылки.Добавить(СвойствоПриемник);
	Описания = ОписанияСвойств(Ссылки);
	
	ОписаниеПриемника = НайтиОписание(Описания, СвойствоПриемник);
	Если ОписаниеПриемника = Неопределено Тогда
		Результат.Ошибки.Добавить("Не удалось прочитать свойство-приёмник.");
		Возврат Результат;
	КонецЕсли;
	
	Если ОписаниеПриемника.ЭтоГруппа Тогда
		Результат.Ошибки.Добавить("Свойство-приёмник не может быть группой свойств.");
	КонецЕсли;
	
	Если ОписаниеПриемника.ЭтоДополнительноеСведение Тогда
		Результат.Ошибки.Добавить("Свойство-приёмник является дополнительным сведением. Обрабатываются только дополнительные реквизиты.");
	КонецЕсли;
	
	Результат.СвойстваИсточника = СвойстваИсточника(СвойствоИсточник);
	Если Результат.СвойстваИсточника.Количество() = 0 Тогда
		Результат.Ошибки.Добавить("Среди выбранных свойств нет дополнительных реквизитов.");
	КонецЕсли;
	
	Для Каждого СвойствоИзСписка Из Результат.СвойстваИсточника Цикл
		Если СвойствоИзСписка = СвойствоПриемник Тогда
			Результат.Ошибки.Добавить("Свойство-приёмник входит в список свойств-источников.");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеИсточника = НайтиОписание(Описания, СвойствоИсточник);
	Если ОписаниеИсточника <> Неопределено И Не ОписаниеИсточника.ЭтоГруппа Тогда
		ПроверитьСовместимостьТипов(ОписаниеИсточника, ОписаниеПриемника, Результат.Ошибки);
	Иначе
		ОписанияИсточников = ОписанияСвойств(Результат.СвойстваИсточника);
		Для Каждого ОписаниеИзСписка Из ОписанияИсточников Цикл
			ПроверитьСовместимостьТипов(ОписаниеИзСписка, ОписаниеПриемника, Результат.Ошибки);
			Если Результат.Ошибки.Количество() > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сопоставляет значения свойства-источника значениям свойства-приёмника.
// Используются два этапа: точное совпадение наименования и совпадение нормализованного наименования.
//
// Параметры:
//  СвойствоИсточник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство или группа, из которых переносятся значения.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство, в которое переносятся значения.
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица соответствий значений.
//
Функция СопоставитьЗначения(СвойствоИсточник, СвойствоПриемник, СвойстваИсточника) Экспорт
	
	Результат = ТаблицаСоответствий();
	
	Если СвойстваИсточника.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСвойств", СвойстваИсточника);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеРеквизиты.Значение КАК Значение,
	|	ПРЕДСТАВЛЕНИЕ(ДополнительныеРеквизиты.Значение) КАК НаименованиеИсточника,
	|	КОЛИЧЕСТВО(*) КАК КоличествоИспользований
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
	|ГДЕ
	|	ДополнительныеРеквизиты.Свойство В (&МассивСвойств)
	|	И ДополнительныеРеквизиты.Значение ЕСТЬ НЕ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ДополнительныеРеквизиты.Значение,
	|	ПРЕДСТАВЛЕНИЕ(ДополнительныеРеквизиты.Значение)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.ЗначениеИсточника = Выборка.Значение;
		Строка.НаименованиеИсточника = Выборка.НаименованиеИсточника;
		Строка.КоличествоИспользований = Выборка.КоличествоИспользований;
		Строка.НовоеНаименование = Выборка.НаименованиеИсточника;
		Строка.НовоеПолноеНаименование = Выборка.НаименованиеИсточника;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПоНаименованию = Новый Соответствие;
	ПоНормализованному = Новый Соответствие;
	
	Если ЭтоИерархическоеЗначениеСвойства(СвойствоПриемник) Тогда
		ИмяСправочникаПриемника = "Справочник.ЗначенияСвойствОбъектовИерархия";
	Иначе
		ИмяСправочникаПриемника = "Справочник.ЗначенияСвойствОбъектов";
	КонецЕсли;
	
	ЗапросПриемника = Новый Запрос;
	ЗапросПриемника.УстановитьПараметр("СвойствоПриемник", СвойствоПриемник);
	ЗапросПриемника.Текст =
	"ВЫБРАТЬ
	|	Значения.Ссылка КАК Ссылка,
	|	Значения.Наименование КАК Наименование,
	|	Значения.ПолноеНаименование КАК ПолноеНаименование
	|ИЗ
	|	" + ИмяСправочникаПриемника + " КАК Значения
	|ГДЕ
	|	Значения.Владелец = &СвойствоПриемник
	|	И НЕ Значения.ПометкаУдаления";
	
	ВыборкаПриемника = ЗапросПриемника.Выполнить().Выбрать();
	Пока ВыборкаПриемника.Следующий() Цикл
		Кандидат = Новый Структура("Ссылка, Наименование, ПолноеНаименование");
		Кандидат.Ссылка = ВыборкаПриемника.Ссылка;
		Кандидат.Наименование = ВыборкаПриемника.Наименование;
		Кандидат.ПолноеНаименование = ВыборкаПриемника.ПолноеНаименование;
		ДобавитьКандидата(ПоНаименованию, ВыборкаПриемника.Наименование, Кандидат);
		ДобавитьКандидата(ПоНормализованному, НормализоватьНаименование(ВыборкаПриемника.Наименование), Кандидат);
	КонецЦикла;
	
	Для Каждого Строка Из Результат Цикл
		Кандидаты = ПоНаименованию.Получить(Строка.НаименованиеИсточника);
		Если Кандидаты <> Неопределено И Кандидаты.Количество() = 1 Тогда
			ЗаполнитьНайденноеЗначение(Строка, Кандидаты[0], "Точное");
			Продолжить;
		КонецЕсли;
		
		Если Кандидаты <> Неопределено И Кандидаты.Количество() > 1 Тогда
			Строка.Статус = "Неоднозначно";
			Строка.Комментарий = "Несколько значений с наименованием " + Строка.НаименованиеИсточника;
			Продолжить;
		КонецЕсли;
		
		Кандидаты = ПоНормализованному.Получить(НормализоватьНаименование(Строка.НаименованиеИсточника));
		Если Кандидаты <> Неопределено И Кандидаты.Количество() = 1 Тогда
			ЗаполнитьНайденноеЗначение(Строка, Кандидаты[0], "Нормализация");
			Продолжить;
		КонецЕсли;
		
		Если Кандидаты <> Неопределено И Кандидаты.Количество() > 1 Тогда
			Строка.Статус = "Неоднозначно";
			Строка.Комментарий = "Несколько значений после нормализации наименования";
			Продолжить;
		КонецЕсли;
		
		Строка.Статус = "Не найдено";
		Строка.Комментарий = "Значение-приёмник не найдено. Задайте группу для создания.";
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает недостающие значения в иерархии свойства-приёмника.
//
// Параметры:
//  Соответствия - ТаблицаЗначений - таблица соответствий значений, заполненная функцией СопоставитьЗначения.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство, в которое переносятся значения.
//
// Возвращаемое значение:
//  Массив из Строка - наименования созданных значений.
//
Функция СоздатьНедостающиеЗначения(Соответствия, СвойствоПриемник) Экспорт
	
	Созданные = Новый Массив;
	Иерархическое = ЭтоИерархическоеЗначениеСвойства(СвойствоПриемник);
	
	Для Каждого Строка Из Соответствия Цикл
		Если Строка.Статус <> "Не найдено" Тогда
			Продолжить;
		КонецЕсли;
		Если Иерархическое И Не ЗначениеЗаполнено(Строка.ГруппаСоздания) Тогда
			Строка.Комментарий = "Не задана группа для создания значения.";
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(Строка.НовоеНаименование) Тогда
			Строка.Комментарий = "Не задано наименование для создания значения.";
			Продолжить;
		КонецЕсли;
		
		Попытка
			Если Иерархическое Тогда
				НовоеЗначение = Справочники.ЗначенияСвойствОбъектовИерархия.СоздатьЭлемент();
			Иначе
				НовоеЗначение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			КонецЕсли;
			НовоеЗначение.Владелец = СвойствоПриемник;
			НовоеЗначение.Наименование = Строка.НовоеНаименование;
			НовоеЗначение.ПолноеНаименование = ?(ПустаяСтрока(Строка.НовоеПолноеНаименование),
				Строка.НовоеНаименование, Строка.НовоеПолноеНаименование);
			Если ЗначениеЗаполнено(Строка.ГруппаСоздания)
				И ТипЗнч(Строка.ГруппаСоздания) = ТипЗнч(НовоеЗначение.Ссылка) Тогда
				НовоеЗначение.Родитель = Строка.ГруппаСоздания;
			КонецЕсли;
			НовоеЗначение.Записать();
			СсылкаНовогоЗначения = НовоеЗначение.Ссылка;
		Исключение
			Строка.Комментарий = "Ошибка создания значения: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		
		Строка.НайденноеЗначение = СсылкаНовогоЗначения;
		Строка.СпособПодбора = "Создано";
		Строка.Статус = "Найдено";
		Строка.Комментарий = ?(ЗначениеЗаполнено(Строка.ГруппаСоздания),
			"Значение создано в группе " + Строка(Строка.ГруппаСоздания),
			"Значение создано в корне справочника значений свойства-приёмника");
		Созданные.Добавить(Строка.НовоеНаименование);
	КонецЦикла;
	
	Возврат Созданные;
	
КонецФункции

// Возвращает данные для предпросмотра замены.
//
// Параметры:
//  Параметры - Структура:
//   * СвойствоИсточник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-источник.
//   * СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//   * СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//   * Предел - Число - максимальное количество строк предпросмотра по номенклатуре, 0 - без ограничения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - данные для замены.
//
Функция ДанныеДляЗамены(Параметры) Экспорт
	
	Результат = ТаблицаРезультата();
	
	СвойстваИсточника = Параметры.СвойстваИсточника;
	Если СвойстваИсточника.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Виды = ВидыСИзменениями(СвойстваИсточника);
	Для Каждого ЭлементВида Из Виды Цикл
		Строка = Результат.Добавить();
		Строка.Этап = "Вид номенклатуры";
		Строка.Объект = ЭлементВида.Вид;
		Строка.Наименование = ЭлементВида.Наименование;
		Строка.Статус = "К замене";
		Строка.Комментарий = ЭлементВида.Комментарий;
	КонецЦикла;
	
	ДанныеПоНоменклатуре = ДанныеПоНоменклатуре(СвойстваИсточника, Параметры.СвойствоПриемник, Параметры.Предел);
	Для Каждого СтрокаДанных Из ДанныеПоНоменклатуре Цикл
		Строка = Результат.Добавить();
		Строка.Этап = "Номенклатура";
		Строка.Объект = СтрокаДанных.Номенклатура;
		Строка.Наименование = СтрокаДанных.Наименование;
		Строка.СвойствоИсточник = СтрокаДанных.СвойствоИсточник;
		Строка.Значение = СтрокаДанных.Значение;
		Если ЗначениеЗаполнено(СтрокаДанных.ЗначениеПриемника) Тогда
			Строка.Статус = "Пропуск: приёмник заполнен";
		Иначе
			Строка.Статус = "К переносу";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выполняет замену свойства у видов номенклатуры и перенос значений у номенклатуры.
// Предназначена для выполнения в фоновом задании.
//
// Параметры:
//  Параметры - Структура:
//   * СвойствоИсточник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-источник.
//   * СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//   * СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//   * Соответствия - ТаблицаЗначений - таблица соответствий значений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - протокол выполнения.
//
Функция ВыполнитьЗамену(Параметры) Экспорт
	
	Результат = ТаблицаРезультата();
	
	СвойствоПриемник = Параметры.СвойствоПриемник;
	СвойстваИсточника = Параметры.СвойстваИсточника;
	Соответствия = Параметры.Соответствия;
	
	Описания = ОписанияСвойств(СвойстваИсточника);
	ИдентификаторыИсточника = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		ИдентификаторыИсточника.Добавить(Описание.ИдентификаторДляФормул);
	КонецЦикла;
	ИдентификаторПриемника = ИдентификаторДляФормул(СвойствоПриемник);
	
	Виды = ВидыСИзменениями(СвойстваИсточника);
	Для Каждого ЭлементВида Из Виды Цикл
		Строка = Результат.Добавить();
		Строка.Этап = "Вид номенклатуры";
		Строка.Объект = ЭлементВида.Вид;
		Строка.Наименование = ЭлементВида.Наименование;
		
		Попытка
			Итог = ЗаменитьВВиде(ЭлементВида.Вид, СвойстваИсточника, СвойствоПриемник, ИдентификаторыИсточника, ИдентификаторПриемника);
			Строка.Статус = "Заменено";
			Строка.Комментарий = Итог;
		Исключение
			Строка.Статус = "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	
	Созданные = СоздатьНедостающиеЗначения(Соответствия, СвойствоПриемник);
	Для Каждого Наименование Из Созданные Цикл
		Строка = Результат.Добавить();
		Строка.Этап = "Значение приёмника";
		Строка.Наименование = Наименование;
		Строка.Статус = "Значение создано";
	КонецЦикла;
	
	ЗначенияПриемника = Новый Соответствие;
	Для Каждого СтрокаСоответствия Из Соответствия Цикл
		Если СтрокаСоответствия.ЗначениеИсточника <> Неопределено Тогда
			ЗначенияПриемника.Вставить(СтрокаСоответствия.ЗначениеИсточника, СтрокаСоответствия.НайденноеЗначение);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеПоНоменклатуре = ДанныеПоНоменклатуре(СвойстваИсточника, СвойствоПриемник, 0);
	Для Каждого СтрокаДанных Из ДанныеПоНоменклатуре Цикл
		Строка = Результат.Добавить();
		Строка.Этап = "Номенклатура";
		Строка.Объект = СтрокаДанных.Номенклатура;
		Строка.Наименование = СтрокаДанных.Наименование;
		Строка.СвойствоИсточник = СтрокаДанных.СвойствоИсточник;
		Строка.Значение = СтрокаДанных.Значение;
		
		НовоеЗначение = ЗначенияПриемника.Получить(СтрокаДанных.Значение);
		
		Попытка
			Итог = ПеренестиЗначение(СтрокаДанных.Номенклатура, СвойстваИсточника, СвойствоПриемник, НовоеЗначение);
			Строка.Статус = Итог.Статус;
			Строка.Комментарий = Итог.Комментарий;
		Исключение
			Строка.Статус = "Ошибка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает результат фонового задания из временного хранилища.
//
// Параметры:
//  АдресРезультата - Строка - адрес временного хранилища.
//
// Возвращаемое значение:
//  ТаблицаЗначений - протокол выполнения.
//
Функция РезультатИзВременногоХранилища(АдресРезультата) Экспорт
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		Возврат Данные;
	КонецЕсли;
	
	Возврат ТаблицаРезультата();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает описания свойств по ссылкам.
//
// Параметры:
//  Ссылки - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - ссылки на свойства.
//
// Возвращаемое значение:
//  ТаблицаЗначений - описания свойств.
//
Функция ОписанияСвойств(Ссылки)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЭтоДополнительноеСведение", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдентификаторДляФормул", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выборка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ВыбратьПоСсылкам(Ссылки);
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.Ссылка = Выборка.Ссылка;
		Строка.Наименование = Выборка.Наименование;
		Строка.ЭтоГруппа = Выборка.ЭтоГруппа;
		Строка.ЭтоДополнительноеСведение = Выборка.ЭтоДополнительноеСведение;
		Строка.Имя = Выборка.Имя;
		Строка.Заголовок = Выборка.Заголовок;
		Строка.ИдентификаторДляФормул = Выборка.ИдентификаторДляФормул;
		Строка.ТипЗначения = Выборка.ТипЗначения;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание свойства из таблицы описаний.
//
// Параметры:
//  Описания - ТаблицаЗначений - описания свойств.
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - ссылка на свойство.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - описание свойства.
//
Функция НайтиОписание(Описания, Свойство)
	
	Возврат Описания.Найти(Свойство, "Ссылка");
	
КонецФункции

// Возвращает идентификатор свойства для формул.
//
// Параметры:
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - ссылка на свойство.
//
// Возвращаемое значение:
//  Строка - идентификатор для формул.
//
Функция ИдентификаторДляФормул(Свойство)
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(Свойство);
	Описания = ОписанияСвойств(Ссылки);
	Если Описания.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Описания[0].ИдентификаторДляФормул;
	
КонецФункции

// Проверяет входимость типов значения источника в тип значения приёмника.
// Пара «дополнительное значение» — «дополнительное значение в иерархии» (и наоборот) считается совместимой:
// значения сопоставляются по наименованию и при необходимости создаются в справочнике приёмника.
//
// Параметры:
//  ОписаниеИсточника - СтрокаТаблицыЗначений - описание свойства-источника.
//  ОписаниеПриемника - СтрокаТаблицыЗначений - описание свойства-приёмника.
//  Ошибки - Массив из Строка - коллекция ошибок, дополняется при несовместимости.
//
Процедура ПроверитьСовместимостьТипов(ОписаниеИсточника, ОписаниеПриемника, Ошибки)
	
	Если ОписаниеИсточника.ТипЗначения = Неопределено Или ОписаниеПриемника.ТипЗначения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПриемникЭтоДополнительноеЗначение = ЭтоОписаниеДополнительногоЗначения(ОписаниеПриемника.ТипЗначения);
	
	Для Каждого ТипИсточника Из ОписаниеИсточника.ТипЗначения.Типы() Цикл
		
		Если ОписаниеПриемника.ТипЗначения.СодержитТип(ТипИсточника) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПриемникЭтоДополнительноеЗначение И ЭтоТипДополнительногоЗначения(ТипИсточника) Тогда
			Продолжить;
		КонецЕсли;
		
		Ошибки.Добавить("Тип значения свойства " + Строка(ОписаниеИсточника.Ссылка) + " ("
			+ Строка(ТипИсточника) + ") не входит в тип значения свойства-приёмника.");
		Возврат;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает Истина, если описание типа содержит справочник значений дополнительных свойств.
//
// Параметры:
//  ТипЗначения - ОписаниеТипов - описание типа значения свойства.
//
// Возвращаемое значение:
//  Булево - Истина, если тип относится к значениям дополнительных свойств.
//
Функция ЭтоОписаниеДополнительногоЗначения(ТипЗначения)
	
	Возврат ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов"))
		Или ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	
КонецФункции

// Возвращает Истина, если тип является справочником значений дополнительных свойств.
//
// Параметры:
//  ТипЗначения - Тип - проверяемый тип.
//
// Возвращаемое значение:
//  Булево - Истина, если тип относится к значениям дополнительных свойств.
//
Функция ЭтоТипДополнительногоЗначения(ТипЗначения)
	
	Возврат ТипЗначения = Тип("СправочникСсылка.ЗначенияСвойствОбъектов")
		Или ТипЗначения = Тип("СправочникСсылка.ЗначенияСвойствОбъектовИерархия");
	
КонецФункции

// Возвращает таблицу соответствий значений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица соответствий значений.
//
Функция ТаблицаСоответствий()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЗначениеИсточника",
		Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов,СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	Результат.Колонки.Добавить("НаименованиеИсточника", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("КоличествоИспользований", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Результат.Колонки.Добавить("НайденноеЗначение",
		Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов,СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	Результат.Колонки.Добавить("СпособПодбора", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));
	Результат.Колонки.Добавить("НовоеНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("НовоеПолноеНаименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)));
	Результат.Колонки.Добавить("ГруппаСоздания",
		Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов,СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	Результат.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	Результат.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу протокола выполнения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - протокол выполнения.
//
Функция ТаблицаРезультата()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Этап", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	Результат.Колонки.Добавить("Объект",
		Новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры,СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("СвойствоИсточник", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	Результат.Колонки.Добавить("Значение",
		Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов,СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	Результат.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(60)));
	Результат.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	
	Возврат Результат;
	
КонецФункции

// Нормализует наименование для сопоставления значений.
//
// Параметры:
//  Наименование - Строка - исходное наименование.
//
// Возвращаемое значение:
//  Строка - нормализованное наименование.
//
Функция НормализоватьНаименование(Наименование)
	
	Результат = ВРег(СокрЛП(Наименование));
	Результат = СтрЗаменить(Результат, "Ё", "Е");
	Результат = СтрЗаменить(Результат, "«", " ");
	Результат = СтрЗаменить(Результат, "»", " ");
	Результат = СтрЗаменить(Результат, """", " ");
	Результат = СтрЗаменить(Результат, "“", " ");
	Результат = СтрЗаменить(Результат, "”", " ");
	Результат = СтрЗаменить(Результат, "–", " ");
	Результат = СтрЗаменить(Результат, "—", " ");
	Результат = СтрЗаменить(Результат, "-", " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	
	Возврат СокрЛП(Результат);
	
КонецФункции

// Добавляет кандидата в соответствие списков.
//
// Параметры:
//  Списки - Соответствие - списки кандидатов.
//  Ключ - Строка - ключ списка.
//  Кандидат - Структура - кандидат.
//
Процедура ДобавитьКандидата(Списки, Ключ, Кандидат)
	
	Список = Списки.Получить(Ключ);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Списки.Вставить(Ключ, Список);
	КонецЕсли;
	Список.Добавить(Кандидат);
	
КонецПроцедуры

// Заполняет найденное значение в строке соответствия.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - строка таблицы соответствий.
//  Кандидат - Структура - найденный кандидат.
//  СпособПодбора - Строка - способ подбора.
//
Процедура ЗаполнитьНайденноеЗначение(Строка, Кандидат, СпособПодбора)
	
	Строка.НайденноеЗначение = Кандидат.Ссылка;
	Строка.СпособПодбора = СпособПодбора;
	Строка.Статус = "Найдено";
	Если Не ПустаяСтрока(Кандидат.ПолноеНаименование) Тогда
		Строка.НовоеПолноеНаименование = Кандидат.ПолноеНаименование;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает виды номенклатуры, у которых есть что заменять.
//
// Параметры:
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//
// Возвращаемое значение:
//  Массив из Структура - сведения о видах номенклатуры.
//
Функция ВидыСИзменениями(СвойстваИсточника)
	
	Результат = Новый Массив;
	
	Идентификаторы = Новый Массив;
	Описания = ОписанияСвойств(СвойстваИсточника);
	Для Каждого Описание Из Описания Цикл
		Если Не ПустаяСтрока(Описание.ИдентификаторДляФормул) Тогда
			Идентификаторы.Добавить(Описание.ИдентификаторДляФормул);
		КонецЕсли;
	КонецЦикла;
	
	ВидыСНабором = Новый Соответствие;
	ЗапросНаборов = Новый Запрос;
	ЗапросНаборов.УстановитьПараметр("МассивСвойств", СвойстваИсточника);
	ЗапросНаборов.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка КАК Вид
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК СоставНабора
	|		ПО Виды.НаборСвойств = СоставНабора.Ссылка
	|ГДЕ
	|	СоставНабора.Свойство В (&МассивСвойств)";
	
	ВыборкаНаборов = ЗапросНаборов.Выполнить().Выбрать();
	Пока ВыборкаНаборов.Следующий() Цикл
		ВидыСНабором.Вставить(ВыборкаНаборов.Вид, Истина);
	КонецЦикла;
	
	ВидыСНастройками = Новый Соответствие;
	ЗапросНастроек = Новый Запрос;
	ЗапросНастроек.УстановитьПараметр("МассивСвойств", СвойстваИсточника);
	ЗапросНастроек.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка КАК Вид
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыДляКонтроляНоменклатуры КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыДляКонтроляХарактеристик КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыДляКонтроляСерий КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыБыстрогоОтбораНоменклатуры КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыБыстрогоОтбораХарактеристик КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыХарактеристикДляКлючаЦен КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.РеквизитыСерийДляКлючаЦен КАК Настройки
	|		ПО Виды.Ссылка = Настройки.Ссылка
	|ГДЕ
	|	Настройки.Свойство В (&МассивСвойств)";
	
	ВыборкаНастроек = ЗапросНастроек.Выполнить().Выбрать();
	Пока ВыборкаНастроек.Следующий() Цикл
		ВидыСНастройками.Вставить(ВыборкаНастроек.Вид, Истина);
	КонецЦикла;
	
	ЗапросВидов = Новый Запрос;
	ЗапросВидов.Текст =
	"ВЫБРАТЬ
	|	Виды.Ссылка КАК Ссылка,
	|	Виды.Наименование КАК Наименование,
	|	Виды.НаборСвойств КАК НаборСвойств,
	|	Виды.ШаблонРабочегоНаименованияНоменклатуры КАК Шаблон
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК Виды
	|ГДЕ
	|	НЕ Виды.ПометкаУдаления";
	
	ВыборкаВидов = ЗапросВидов.Выполнить().Выбрать();
	Пока ВыборкаВидов.Следующий() Цикл
		Причины = Новый Массив;
		
		Если ВидыСНабором.Получить(ВыборкаВидов.Ссылка) <> Неопределено Тогда
			Причины.Добавить("набор свойств");
		КонецЕсли;
		Если ВидыСНастройками.Получить(ВыборкаВидов.Ссылка) <> Неопределено Тогда
			Причины.Добавить("настройки");
		КонецЕсли;
		
		Шаблон = ВыборкаВидов.Шаблон;
		Если Не ПустаяСтрока(Шаблон) Тогда
			Для Каждого Идентификатор Из Идентификаторы Цикл
				Если СтрНайти(Шаблон, "{ДР." + Идентификатор + "}") > 0 Тогда
					Причины.Добавить("шаблон рабочего наименования");
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если Причины.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Элемент = Новый Структура("Вид, Наименование, Комментарий");
		Элемент.Вид = ВыборкаВидов.Ссылка;
		Элемент.Наименование = ВыборкаВидов.Наименование;
		Элемент.Комментарий = СтрСоединить(Причины, ", ");
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает данные по номенклатуре для предпросмотра и выполнения.
//
// Параметры:
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//  Предел - Число - максимальное количество строк, 0 - без ограничения.
//
// Возвращаемое значение:
//  ТаблицаЗначений - данные по номенклатуре.
//
Функция ДанныеПоНоменклатуре(СвойстваИсточника, СвойствоПриемник, Предел)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("СвойствоИсточник", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	Результат.Колонки.Добавить("Значение",
		Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов,СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	Результат.Колонки.Добавить("ЗначениеПриемника",
		Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов,СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	
	Если СвойстваИсточника.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Ограничение = "";
	Если Предел > 0 Тогда
		Ограничение = "ПЕРВЫЕ " + Формат(Предел, "ЧГ=0");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСвойств", СвойстваИсточника);
	Запрос.УстановитьПараметр("СвойствоПриемник", СвойствоПриемник);
	Запрос.Текст =
	"ВЫБРАТЬ " + Ограничение + "
	|	Источник.Ссылка КАК Номенклатура,
	|	Номенклатура.Наименование КАК Наименование,
	|	Источник.Свойство КАК СвойствоИсточник,
	|	Источник.Значение КАК Значение,
	|	Приемник.Значение КАК ЗначениеПриемника
	|ИЗ
	|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК Источник
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО Источник.Ссылка = Номенклатура.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК Приемник
	|		ПО Приемник.Ссылка = Источник.Ссылка
	|			И Приемник.Свойство = &СвойствоПриемник
	|ГДЕ
	|	Источник.Свойство В (&МассивСвойств)
	|	И Источник.Значение ЕСТЬ НЕ NULL
	|	И НЕ Номенклатура.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Результат.Добавить();
		Строка.Номенклатура = Выборка.Номенклатура;
		Строка.Наименование = Выборка.Наименование;
		Строка.СвойствоИсточник = Выборка.СвойствоИсточник;
		Строка.Значение = Выборка.Значение;
		Строка.ЗначениеПриемника = Выборка.ЗначениеПриемника;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заменяет свойство в наборе свойств вида, настройках вида и шаблоне рабочего наименования.
//
// Параметры:
//  ВидСсылка - СправочникСсылка.ВидыНоменклатуры - вид номенклатуры.
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//  ИдентификаторыИсточника - Массив из Строка - идентификаторы для формул свойств-источников.
//  ИдентификаторПриемника - Строка - идентификатор для формул свойства-приёмника.
//
// Возвращаемое значение:
//  Строка - описание выполненных изменений.
//
Функция ЗаменитьВВиде(ВидСсылка, СвойстваИсточника, СвойствоПриемник, ИдентификаторыИсточника, ИдентификаторПриемника)
	
	Изменения = Новый Массив;
	
	НачатьТранзакцию();
	Попытка
		ВидСсылка.Заблокировать();
		ОбъектВида = ВидСсылка.ПолучитьОбъект();
		Если ОбъектВида = Неопределено Тогда
			ЗафиксироватьТранзакцию();
			Возврат "Вид не найден";
		КонецЕсли;
		
		ИзмененНабор = ЗаменитьВНаборе(ОбъектВида, СвойстваИсточника, СвойствоПриемник);
		Если ИзмененНабор Тогда
			Изменения.Добавить("набор свойств");
		КонецЕсли;
		
		ИзмененыНастройки = ЗаменитьВНастройках(ОбъектВида, СвойстваИсточника, СвойствоПриемник);
		Если ИзмененыНастройки Тогда
			Изменения.Добавить("настройки");
		КонецЕсли;
		
		ИзмененШаблон = ЗаменитьВШаблоне(ОбъектВида, ИдентификаторыИсточника, ИдентификаторПриемника);
		Если ИзмененШаблон Тогда
			Изменения.Добавить("шаблон рабочего наименования");
		КонецЕсли;
		
		Если Изменения.Количество() > 0 Тогда
			ОбъектВида.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Изменения.Количество() = 0 Тогда
		Возврат "Изменений нет";
	КонецЕсли;
	
	Возврат "Изменено: " + СтрСоединить(Изменения, ", ");
	
КонецФункции

// Заменяет свойство в наборе свойств вида.
//
// Параметры:
//  ОбъектВида - СправочникОбъект.ВидыНоменклатуры - вид номенклатуры.
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//
// Возвращаемое значение:
//  Булево - Истина, если набор изменен.
//
Функция ЗаменитьВНаборе(ОбъектВида, СвойстваИсточника, СвойствоПриемник)
	
	Если Не ЗначениеЗаполнено(ОбъектВида.НаборСвойств) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаборСсылка = ОбъектВида.НаборСвойств;
	НаборСсылка.Заблокировать();
	ОбъектНабора = НаборСсылка.ПолучитьОбъект();
	Если ОбъектНабора = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьПриемник = Ложь;
	СтрокиИсточника = Новый Массив;
	Для Каждого СтрокаНабора Из ОбъектНабора.ДополнительныеРеквизиты Цикл
		Если СтрокаНабора.Свойство = СвойствоПриемник Тогда
			ЕстьПриемник = Истина;
		КонецЕсли;
		Если СвойстваИсточника.Найти(СтрокаНабора.Свойство) <> Неопределено Тогда
			СтрокиИсточника.Добавить(СтрокаНабора);
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокиИсточника.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаНабора Из СтрокиИсточника Цикл
		ОбъектНабора.ДополнительныеРеквизиты.Удалить(СтрокаНабора);
	КонецЦикла;
	
	Если Не ЕстьПриемник Тогда
		НоваяСтрока = ОбъектНабора.ДополнительныеРеквизиты.Добавить();
		НоваяСтрока.Свойство = СвойствоПриемник;
	КонецЕсли;
	
	ОбъектНабора.Записать();
	
	Возврат Истина;
	
КонецФункции

// Заменяет ссылку на свойство в табличных частях настроек вида номенклатуры.
//
// Параметры:
//  ОбъектВида - СправочникОбъект.ВидыНоменклатуры - вид номенклатуры.
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//
// Возвращаемое значение:
//  Булево - Истина, если настройки изменены.
//
Функция ЗаменитьВНастройках(ОбъектВида, СвойстваИсточника, СвойствоПриемник)
	
	ИменаТабличныхЧастей = Новый Массив;
	ИменаТабличныхЧастей.Добавить("РеквизитыДляКонтроляНоменклатуры");
	ИменаТабличныхЧастей.Добавить("РеквизитыДляКонтроляХарактеристик");
	ИменаТабличныхЧастей.Добавить("РеквизитыДляКонтроляСерий");
	ИменаТабличныхЧастей.Добавить("РеквизитыБыстрогоОтбораНоменклатуры");
	ИменаТабличныхЧастей.Добавить("РеквизитыБыстрогоОтбораХарактеристик");
	ИменаТабличныхЧастей.Добавить("РеквизитыХарактеристикДляКлючаЦен");
	ИменаТабличныхЧастей.Добавить("РеквизитыСерийДляКлючаЦен");
	
	ПредставлениеПриемника = Строка(СвойствоПриемник);
	Изменено = Ложь;
	
	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		ТабличнаяЧасть = ОбъектВида[ИмяТабличнойЧасти];
		Для Каждого СтрокаНастройки Из ТабличнаяЧасть Цикл
			Если СвойстваИсточника.Найти(СтрокаНастройки.Свойство) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрокаНастройки.Свойство = СвойствоПриемник;
			СтрокаНастройки.ИмяРеквизита = ПредставлениеПриемника;
			СтрокаНастройки.ПредставлениеРеквизита = ПредставлениеПриемника;
			Изменено = Истина;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Изменено;
	
КонецФункции

// Заменяет идентификаторы свойств в шаблоне рабочего наименования номенклатуры.
//
// Параметры:
//  ОбъектВида - СправочникОбъект.ВидыНоменклатуры - вид номенклатуры.
//  ИдентификаторыИсточника - Массив из Строка - идентификаторы для формул свойств-источников.
//  ИдентификаторПриемника - Строка - идентификатор для формул свойства-приёмника.
//
// Возвращаемое значение:
//  Булево - Истина, если шаблон изменен.
//
Функция ЗаменитьВШаблоне(ОбъектВида, ИдентификаторыИсточника, ИдентификаторПриемника)
	
	Шаблон = ОбъектВида.ШаблонРабочегоНаименованияНоменклатуры;
	Если ПустаяСтрока(Шаблон) Или ПустаяСтрока(ИдентификаторПриемника) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НовыйШаблон = Шаблон;
	Для Каждого Идентификатор Из ИдентификаторыИсточника Цикл
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		НовыйШаблон = СтрЗаменить(НовыйШаблон, "{ДР." + Идентификатор + "}", "{ДР." + ИдентификаторПриемника + "}");
	КонецЦикла;
	
	Если НовыйШаблон = Шаблон Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектВида.ШаблонРабочегоНаименованияНоменклатуры = НовыйШаблон;
	
	Возврат Истина;
	
КонецФункции

// Переносит значение свойства у номенклатуры.
//
// Параметры:
//  СсылкаНоменклатуры - СправочникСсылка.Номенклатура - номенклатура.
//  СвойстваИсточника - Массив из ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойства-элементы источника.
//  СвойствоПриемник - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - свойство-приёмник.
//  НовоеЗначение - СправочникСсылка.ЗначенияСвойствОбъектов, СправочникСсылка.ЗначенияСвойствОбъектовИерархия, Неопределено - значение-приёмник.
//
// Возвращаемое значение:
//  Структура - результат обработки строки.
//
Функция ПеренестиЗначение(СсылкаНоменклатуры, СвойстваИсточника, СвойствоПриемник, НовоеЗначение)
	
	НачатьТранзакцию();
	Попытка
		СсылкаНоменклатуры.Заблокировать();
		Объект = СсылкаНоменклатуры.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ЗафиксироватьТранзакцию();
			Возврат РезультатСтроки("Пропущено: объект не найден", "");
		КонецЕсли;
		
		СтрокаПриемника = Неопределено;
		Для Каждого СтрокаТЧ Из Объект.ДополнительныеРеквизиты Цикл
			Если СтрокаТЧ.Свойство = СвойствоПриемник Тогда
				СтрокаПриемника = СтрокаТЧ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаПриемника <> Неопределено И ЗначениеЗаполнено(СтрокаПриемника.Значение) Тогда
			ОтменитьТранзакцию();
			Возврат РезультатСтроки("Пропущено: приёмник заполнен", "");
		КонецЕсли;
		
		СтрокиИсточника = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект.ДополнительныеРеквизиты Цикл
			Если СвойстваИсточника.Найти(СтрокаТЧ.Свойство) <> Неопределено И ЗначениеЗаполнено(СтрокаТЧ.Значение) Тогда
				СтрокиИсточника.Добавить(СтрокаТЧ);
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокиИсточника.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Возврат РезультатСтроки("Пропущено: значение источника не найдено", "");
		КонецЕсли;
		
		Если НовоеЗначение = Неопределено Тогда
			ОтменитьТранзакцию();
			Возврат РезультатСтроки("Пропущено: значение не сопоставлено", "");
		КонецЕсли;
		
		Если СтрокаПриемника = Неопределено Тогда
			СтрокаПриемника = Объект.ДополнительныеРеквизиты.Добавить();
			СтрокаПриемника.Свойство = СвойствоПриемник;
		КонецЕсли;
		
		СтрокаПриемника.Значение = НовоеЗначение;
		СтрокаПриемника.ТекстоваяСтрока = "";
		
		Для Каждого СтрокаТЧ Из СтрокиИсточника Цикл
			Объект.ДополнительныеРеквизиты.Удалить(СтрокаТЧ);
		КонецЦикла;
		
		Объект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат РезультатСтроки("Перенесено", "");
	
КонецФункции

// Возвращает Истина, если свойство использует иерархический справочник значений.
//
// Параметры:
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - ссылка на свойство.
//
// Возвращаемое значение:
//  Булево - Истина, если значения свойства хранятся в иерархическом справочнике.
//
Функция ЭтоИерархическоеЗначениеСвойства(Свойство)
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(Свойство);
	Описания = ОписанияСвойств(Ссылки);
	Если Описания.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТипЗначения = Описания[0].ТипЗначения;
	Если ТипЗначения = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектовИерархия"));
	
КонецФункции

// Возвращает имя справочника значений свойства.
//
// Параметры:
//  Свойство - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения - ссылка на свойство.
//
// Возвращаемое значение:
//  Строка - имя справочника значений свойства, если свойство дополнительное значение; иначе пустая строка.
//
Функция ИмяСправочникаЗначенийСвойства(Свойство) Экспорт
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(Свойство);
	Описания = ОписанияСвойств(Ссылки);
	Если Описания.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТипЗначения = Описания[0].ТипЗначения;
	Если ТипЗначения = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектовИерархия")) Тогда
		Возврат "ЗначенияСвойствОбъектовИерархия";
	ИначеЕсли ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов")) Тогда
		Возврат "ЗначенияСвойствОбъектов";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает структуру результата обработки строки.
//
// Параметры:
//  Статус - Строка - статус обработки.
//  Комментарий - Строка - пояснение.
//
// Возвращаемое значение:
//  Структура - результат обработки строки.
//
Функция РезультатСтроки(Статус, Комментарий)
	
	Результат = Новый Структура;
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("Комментарий", Комментарий);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
