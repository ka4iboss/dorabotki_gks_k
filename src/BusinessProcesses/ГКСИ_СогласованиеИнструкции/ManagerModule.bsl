#Область ПрограммныйИнтерфейс

// Возвращает имя формы и параметры её открытия для выполнения задачи бизнес-процесса.
// Для точки назначения участников открывается форма выбора участников, для точек согласования —
// форма согласования.
//
// Параметры:
//  ЗадачаСсылка - ЗадачаСсылка.ЗадачаИсполнителя - ссылка на выполняемую задачу.
//  ТочкаМаршрутаСсылка - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - точка маршрута.
//
// Возвращаемое значение:
//  Структура - поля ПараметрыФормы, ИмяФормы.
//
Функция ФормаВыполненияЗадачи(Знач ЗадачаСсылка, Знач ТочкаМаршрутаСсылка) Экспорт
	
	Если ТочкаМаршрутаСсылка = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ТочкиМаршрута.НазначитьУчастников Тогда
		ИмяФормы = "Задача.ЗадачаИсполнителя.Форма.ГКСИ_ФормаЗадачиНазначенияУчастников";
	Иначе
		ИмяФормы = "Задача.ЗадачаИсполнителя.Форма.ГКСИ_ФормаЗадачиСогласования";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ПараметрыФормы", Новый Структура("Ключ", ЗадачаСсылка));
	Результат.Вставить("ИмяФормы", ИмяФормы);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
