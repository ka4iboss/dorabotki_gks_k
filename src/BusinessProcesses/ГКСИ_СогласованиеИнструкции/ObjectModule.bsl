#Область ПрограммныйИнтерфейс

// Возвращает Истина, если по указанному предмету есть незавершённый бизнес-процесс согласования.
//
// Параметры:
//  Предмет - СправочникСсылка.ДемонстрационныеСценарии - согласуемый узел инструкции.
//  СсылкаПроцесса - СправочникСсылка.ДемонстрационныеСценарии, БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции -
//                  ссылка проверяемого процесса, который требуется исключить из поиска (для перезапуска).
//
// Возвращаемое значение:
//  Булево - Истина, если найден активный процесс по предмету.
//
Функция ЕстьАктивныйПроцессПоПредмету(Знач Предмет, Знач СсылкаПроцесса = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГКСИ_СогласованиеИнструкции.Ссылка КАК Ссылка
		|ИЗ
		|	БизнесПроцесс.ГКСИ_СогласованиеИнструкции КАК ГКСИ_СогласованиеИнструкции
		|ГДЕ
		|	ГКСИ_СогласованиеИнструкции.Предмет = &Предмет
		|	И НЕ ГКСИ_СогласованиеИнструкции.Завершен";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
	
	Если ЗначениеЗаполнено(СсылкаПроцесса) Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И ГКСИ_СогласованиеИнструкции.Ссылка <> &СсылкаПроцесса";
		Запрос.УстановитьПараметр("СсылкаПроцесса", СсылкаПроцесса);
	КонецЕсли;
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Заполняет реквизиты бизнес-процесса при создании.
//
// Параметры:
//  ДанныеЗаполнения - Произвольный - структура с реквизитами Предмет, ВидСогласования, КорневаяИнструкция
//                     либо ссылка на согласуемый объект.
//  СтандартнаяОбработка - Булево - признак стандартной обработки заполнения.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.ДемонстрационныеСценарии") Тогда
		Предмет = ДанныеЗаполнения;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидСогласования) Тогда
		ВидСогласования = Перечисления.ГКСИ_ВидыСогласованияИнструкций.ВсяИнструкция;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КорневаяИнструкция) И ЗначениеЗаполнено(Предмет) Тогда
		КорневаяИнструкция = ГКСИ_СогласованиеИнструкцийСервер.ОпределитьКорневуюИнструкцию(Предмет);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Наименование) И ЗначениеЗаполнено(Предмет) Тогда
		Наименование = СтрШаблон(НСтр("ru = 'Согласование: %1'"), Предмет);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение обязательных реквизитов бизнес-процесса.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи.
//  ПроверяемыеРеквизиты - Массив - список проверяемых реквизитов.
//
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ ЗначениеЗаполнено(Предмет) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не заполнен согласуемый объект инструкции'"),
			ЭтотОбъект,
			"Предмет",
			,
			Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик старта бизнес-процесса: фиксирует дату начала, статус и проверяет отсутствие
// незавершённого согласования по тому же предмету.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - стартовая точка.
//  Отказ - Булево - признак отказа от старта.
//
Процедура СтартПередСтартом(ТочкаМаршрутаБизнесПроцесса, Отказ)
	
	Если ЕстьАктивныйПроцессПоПредмету(Предмет, Ссылка) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'По этому объекту уже запущено согласование. Дождитесь его завершения.'"));
		Возврат;
	КонецЕсли;
	
	ДатаНачала = ТекущаяДатаСеанса();
	
	// Фиксируем текст инструкции на момент старта: задача покажет именно его,
	// даже если инструкцию изменят во время согласования.
	Если ВидСогласования = Перечисления.ГКСИ_ВидыСогласованияИнструкций.ВсяИнструкция Тогда
		ГКСИ_HTMLИнструкции = ГКСИ_СогласованиеИнструкцийСервер.HTMLИнструкции(КорневаяИнструкция);
	Иначе
		ГКСИ_HTMLИнструкции = "";
	КонецЕсли;
	
	ГКСИ_СогласованиеИнструкцийСервер.УстановитьСтатусСогласования(
		Предмет,
		КорневаяИнструкция,
		Перечисления.СтатусыДемонстрационныхСценариев.НаПроверке);
	
	Записать();
	
КонецПроцедуры

// Обработчик завершения бизнес-процесса: фиксирует дату завершения.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - точка завершения.
//  Отказ - Булево - признак отказа.
//
Процедура ЗавершениеПриЗавершении(ТочкаМаршрутаБизнесПроцесса, Отказ)
	
	ДатаЗавершения = ТекущаяДатаСеанса();
	
КонецПроцедуры

// Точка маршрута "Назначить участников": создаёт единственную задачу автору процесса.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  ФормируемыеЗадачи - Массив - коллекция формируемых задач.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
Процедура НазначитьУчастниковПередСозданиемЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Задача = СоздатьЗадачу(ТочкаМаршрутаБизнесПроцесса);
	Задача.Исполнитель = Автор;
	ФормируемыеЗадачи.Добавить(Задача);
	
КонецПроцедуры

// Проверка выполнения точки маршрута "Назначить участников".
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - выполняемая задача.
//  Результат - Булево - признак выполнения задачи.
//
Процедура НазначитьУчастниковОбработкаПроверкиВыполнения(ТочкаМаршрутаБизнесПроцесса, Задача, Результат)
	
	Результат = Истина;
	
КонецПроцедуры

// Точка маршрута "Согласование начальниками": создаёт отдельную задачу каждому начальнику.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  ФормируемыеЗадачи - Массив - коллекция формируемых задач.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
Процедура СогласованиеНачальникамиПередСозданиемЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СоздатьЗадачиПоУчастникам(ТочкаМаршрутаБизнесПроцесса, Начальники, ФормируемыеЗадачи);
	
КонецПроцедуры

// Проверка выполнения точки маршрута "Согласование начальниками".
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - выполняемая задача.
//  Результат - Булево - признак выполнения задачи.
//
Процедура СогласованиеНачальникамиОбработкаПроверкиВыполнения(ТочкаМаршрутаБизнесПроцесса, Задача, Результат)
	
	Результат = Истина;
	
КонецПроцедуры

// Точка маршрута "Согласование подчинёнными": создаёт отдельную задачу каждому подчинённому.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  ФормируемыеЗадачи - Массив - коллекция формируемых задач.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
Процедура СогласованиеПодчинённымиПередСозданиемЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СоздатьЗадачиПоУчастникам(ТочкаМаршрутаБизнесПроцесса, Подчинённые, ФормируемыеЗадачи);
	
КонецПроцедуры

// Проверка выполнения точки маршрута "Согласование подчинёнными".
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - выполняемая задача.
//  Результат - Булево - признак выполнения задачи.
//
Процедура СогласованиеПодчинённымиОбработкаПроверкиВыполнения(ТочкаМаршрутаБизнесПроцесса, Задача, Результат)
	
	Результат = Истина;
	
КонецПроцедуры

// Точка маршрута "Обработка результата": подводит итог согласования и проставляет статусы.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//
Процедура ОбработкаРезультатаОбработка(ТочкаМаршрутаБизнесПроцесса)
	
	ЕстьОтклонение = Ложь;
	
	Для Каждого СтрокаУчастника Из Начальники Цикл
		Если СтрокаУчастника.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано Тогда
			ЕстьОтклонение = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьОтклонение Тогда
		Для Каждого СтрокаУчастника Из Подчинённые Цикл
			Если СтрокаУчастника.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано Тогда
				ЕстьОтклонение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьОтклонение Тогда
		РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано;
		СтатусИнструкции = Перечисления.СтатусыДемонстрационныхСценариев.ЕстьЗамечания;
	Иначе
		РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.Согласовано;
		СтатусИнструкции = Перечисления.СтатусыДемонстрационныхСценариев.Проверено;
	КонецЕсли;
	
	ГКСИ_СогласованиеИнструкцийСервер.УстановитьСтатусСогласования(Предмет, КорневаяИнструкция, СтатусИнструкции);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт задачи по всем заполненным участникам указанной табличной части.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//  Участники - ТабличнаяЧастьБизнесПроцессаОбъекта.ГКСИ_СогласованиеИнструкции.Начальники, ТабличнаяЧастьБизнесПроцессаОбъекта.ГКСИ_СогласованиеИнструкции.Подчинённые -
//              табличная часть с участниками согласования.
//  ФормируемыеЗадачи - Массив - коллекция формируемых задач.
//
Процедура СоздатьЗадачиПоУчастникам(ТочкаМаршрутаБизнесПроцесса, Участники, ФормируемыеЗадачи)
	
	Для Каждого СтрокаУчастника Из Участники Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		Задача = СоздатьЗадачу(ТочкаМаршрутаБизнесПроцесса);
		Задача.Исполнитель = СтрокаУчастника.Сотрудник;
		ФормируемыеЗадачи.Добавить(Задача);
		
	КонецЦикла;
	
КонецПроцедуры

// Создаёт задачу бизнес-процесса по указанной точке маршрута.
//
// Параметры:
//  ТочкаМаршрутаБизнесПроцесса - ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции - текущая точка.
//
// Возвращаемое значение:
//  ЗадачаОбъект.ЗадачаИсполнителя - созданная задача.
//
Функция СоздатьЗадачу(ТочкаМаршрутаБизнесПроцесса)
	
	Задача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	
	Задача.Дата = ТекущаяДатаСеанса();
	Задача.Автор = Автор;
	Задача.Наименование = Наименование;
	Задача.Описание = Наименование;
	Задача.Предмет = Предмет;
	Задача.БизнесПроцесс = Ссылка;
	Задача.ТочкаМаршрута = ТочкаМаршрутаБизнесПроцесса;
	
	Возврат Задача;
	
КонецФункции

#КонецОбласти
