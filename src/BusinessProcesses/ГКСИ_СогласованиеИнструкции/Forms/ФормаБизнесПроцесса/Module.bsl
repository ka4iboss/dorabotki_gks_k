#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьПараметрыДинамическихСписков();
	РассчитатьСостояние();
	ЗаполнитьХодСогласования();
	НастроитьДоступностьПоПравам();
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	РазвернутьХодСогласования();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыХодСогласования

&НаКлиенте
Процедура ХодСогласованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ДанныеСтроки = Элементы.ХодСогласования.ТекущиеДанные;

	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Узлы процесса и этапов оставляем платформе: по ним работает раскрытие дерева.
	Если ДанныеСтроки.ВидСтроки <> "Участник" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Если ЗначениеЗаполнено(ДанныеСтроки.Задача) Тогда
		ОткрытьЗадачуПоСсылке(ДанныеСтроки.Задача);
	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Участник) Тогда
		ОткрытьСотрудника(ДанныеСтроки.Участник);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗадачиПроцесса

&НаКлиенте
Процедура ЗадачиПроцессаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ДанныеСтроки = Элементы.ЗадачиПроцесса.ТекущиеДанные;

	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьЗадачуПоСтроке(ДанныеСтроки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Перечитывает дерево хода согласования: задачи могли выполнить, пока форма была открыта.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда формы.
//
&НаКлиенте
Процедура ГКСИ_ОбновитьХодСогласования(Команда)

	ОбновитьХодСогласованияНаСервере();
	РазвернутьХодСогласования();

КонецПроцедуры

// Повторно отправляет письма участникам, чьи задачи ещё не выполнены.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда формы.
//
&НаКлиенте
Процедура ГКСИ_ОтправитьПисьмаПовторно(Команда)

	КоличествоПолучателей = ОтправитьПисьмаПовторноНаСервере(Объект.Ссылка);

	Если КоличествоПолучателей < 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отправка электронной почты не настроена.'"));
	ИначеЕсли КоличествоПолучателей = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет участников с незавершёнными задачами.'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Запущена повторная отправка писем участникам: %1.'"), КоличествоПолучателей));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает параметры отбора динамического списка задач процесса.
&НаСервере
Процедура УстановитьПараметрыДинамическихСписков()

	ЗадачиПроцесса.Параметры.УстановитьЗначениеПараметра("БизнесПроцесс", Объект.Ссылка);

КонецПроцедуры

// Рассчитывает текущее состояние бизнес-процесса для вывода в шапке формы.
&НаСервере
Процедура РассчитатьСостояние()

	Если Объект.Стартован Тогда
		Если Объект.Завершен Тогда
			Если Объект.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.Согласовано Тогда
				Состояние = "Согласовано";
			ИначеЕсли Объект.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано Тогда
				Состояние = "Не согласовано";
			Иначе
				Состояние = "Завершено";
			КонецЕсли;
		Иначе
			Состояние = "В процессе согласования";
		КонецЕсли;
	Иначе
		Состояние = "Не начато";
	КонецЕсли;

	СостояниеПросрочено = Ложь;

	Если Объект.Стартован И НЕ Объект.Завершен
		И ЗначениеЗаполнено(Объект.ДатаЗавершения)
		И Объект.ДатаЗавершения < НачалоДня(ТекущаяДатаСеанса()) Тогда
		СостояниеПросрочено = Истина;
	КонецЕсли;

КонецПроцедуры

// Настраивает видимость и доступность элементов формы по правам пользователя.
//
// Пользователю с правом только просмотра инструкций процесс доступен только
// для чтения: табличные части не редактируются, команды изменения недоступны.
&НаСервере
Процедура НастроитьДоступностьПоПравам()

	// Дерево хода согласования — витрина данных, редактировать его не нужно.
	Элементы.ХодСогласования.ТолькоПросмотр = Истина;
	ГКСИ_ПраваДоступаСервер.СкрытьЭлемент(ЭтотОбъект, "ХодСогласованияВидСтроки");
	ГКСИ_ПраваДоступаСервер.СкрытьЭлемент(ЭтотОбъект, "ХодСогласованияУчастник");

	// Повторная отправка писем доступна только по незавершённому процессу.
	Элементы.ГКСИ_ОтправитьПисьмаПовторно.Видимость = Объект.Стартован И НЕ Объект.Завершен;

	Если ГКСИ_ПраваДоступаСервер.ЕстьПравоРедактированияИнструкций() Тогда
		Возврат;
	КонецЕсли;

	Элементы.ГКСИ_ОтправитьПисьмаПовторно.Видимость = Ложь;
	ТолькоПросмотр = Истина;

КонецПроцедуры

// Заполняет дерево хода согласования: процесс → этапы → участники с задачами.
&НаСервере
Процедура ЗаполнитьХодСогласования()

	ХодСогласования.ПолучитьЭлементы().Очистить();

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ТочкиМаршрута = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ТочкиМаршрута;
	ЗадачиПоТочкам = ЗадачиПроцессаПоТочкам();

	СтрокаПроцесса = ХодСогласования.ПолучитьЭлементы().Добавить();
	СтрокаПроцесса.ВидСтроки = "Процесс";
	СтрокаПроцесса.Этап = СтрШаблон(НСтр("ru = 'Согласование №%1 от %2 — %3'"),
		Объект.Номер, Формат(Объект.Дата, "ДЛФ=DT"), Состояние);

	ДобавитьЭтапСогласования(СтрокаПроцесса, НСтр("ru = 'Назначение участников'"),
		ЗадачиПоТочкам.Получить(ТочкиМаршрута.НазначитьУчастников), Неопределено);

	ДобавитьЭтапСогласования(СтрокаПроцесса, НСтр("ru = 'Согласование начальниками отделов'"),
		ЗадачиПоТочкам.Получить(ТочкиМаршрута.СогласованиеНачальниками), Объект.Начальники);

	ДобавитьЭтапСогласования(СтрокаПроцесса, НСтр("ru = 'Согласование подчинёнными'"),
		ЗадачиПоТочкам.Получить(ТочкиМаршрута.СогласованиеПодчинёнными), Объект.Подчинённые);

КонецПроцедуры

// Перечитывает состояние процесса и заново заполняет дерево хода согласования.
&НаСервере
Процедура ОбновитьХодСогласованияНаСервере()

	РассчитатьСостояние();
	ЗаполнитьХодСогласования();

КонецПроцедуры

// Запускает повторную отправку писем участникам с незавершёнными задачами.
//
// Параметры:
//  ПроцессСсылка - БизнесПроцессСсылка.ГКСИ_СогласованиеИнструкции - процесс согласования.
//
// Возвращаемое значение:
//  Число - количество получателей; -1, если отправка почты не настроена.
//
&НаСервереБезКонтекста
Функция ОтправитьПисьмаПовторноНаСервере(ПроцессСсылка)

	Возврат ГКСИ_ПочтовыеУведомленияСервер.ОтправитьПисьмаПоНезавершеннымЗадачам(ПроцессСсылка);

КонецФункции

// Добавляет узел этапа согласования и строки его участников.
//
// Параметры:
//  РодительскаяСтрока - СтрокаДереваЗначений - узел процесса.
//  НаименованиеЭтапа  - Строка - заголовок этапа.
//  ЗадачиЭтапа        - Массив из Структура, Неопределено - задачи точки маршрута этапа.
//  Участники          - БизнесПроцессТабличнаяЧасть.ГКСИ_СогласованиеИнструкции.Начальники,
//                       БизнесПроцессТабличнаяЧасть.ГКСИ_СогласованиеИнструкции.Подчинённые,
//                       Неопределено - табличная часть с участниками; Неопределено для этапа
//                       назначения участников.
//
&НаСервере
Процедура ДобавитьЭтапСогласования(РодительскаяСтрока, НаименованиеЭтапа, ЗадачиЭтапа, Участники)

	Если ЗадачиЭтапа = Неопределено Тогда
		ЗадачиЭтапа = Новый Массив;
	КонецЕсли;

	СтрокаЭтапа = РодительскаяСтрока.ПолучитьЭлементы().Добавить();
	СтрокаЭтапа.ВидСтроки = "Этап";
	СтрокаЭтапа.Этап = НаименованиеЭтапа;

	// У этапа назначения участников нет своей табличной части — показываем задачу автора.
	Если Участники = Неопределено Тогда
		Для Каждого ЗадачаЭтапа Из ЗадачиЭтапа Цикл
			ДобавитьСтрокуУчастникаПоЗадаче(СтрокаЭтапа, ЗадачаЭтапа);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	ВсегоУчастников = 0;
	Согласовали = 0;

	Для Каждого СтрокаУчастника Из Участники Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;

		ВсегоУчастников = ВсегоУчастников + 1;
		Если ЗначениеЗаполнено(СтрокаУчастника.РезультатСогласования) Тогда
			Согласовали = Согласовали + 1;
		КонецЕсли;

		ДобавитьСтрокуУчастника(СтрокаЭтапа, СтрокаУчастника,
			НайтиЗадачуУчастника(ЗадачиЭтапа, СтрокаУчастника.Сотрудник));

	КонецЦикла;

	СтрокаЭтапа.Этап = СтрШаблон(НСтр("ru = '%1 — согласовали %2 из %3'"),
		НаименованиеЭтапа, Согласовали, ВсегоУчастников);

КонецПроцедуры

// Добавляет строку участника этапа согласования.
//
// Параметры:
//  СтрокаЭтапа     - СтрокаДереваЗначений - узел этапа.
//  СтрокаУчастника - СтрокаТабличнойЧасти - строка табличной части участников.
//  ЗадачаЭтапа     - Структура, Неопределено - задача участника на этом этапе.
//
&НаСервере
Процедура ДобавитьСтрокуУчастника(СтрокаЭтапа, СтрокаУчастника, ЗадачаЭтапа)

	СтрокаДерева = СтрокаЭтапа.ПолучитьЭлементы().Добавить();
	СтрокаДерева.ВидСтроки = "Участник";
	СтрокаДерева.Участник = СтрокаУчастника.Сотрудник;
	СтрокаДерева.Этап = Строка(СтрокаУчастника.Сотрудник);
	СтрокаДерева.РезультатСогласования = СтрокаУчастника.РезультатСогласования;
	СтрокаДерева.Комментарий = СтрокаУчастника.Комментарий;
	СтрокаДерева.Дата = СтрокаУчастника.ДатаСогласования;
	СтрокаДерева.НомерВерсии = СтрокаУчастника.НомерВерсии;

	Если ЗадачаЭтапа = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаДерева.Задача = ЗадачаЭтапа.Ссылка;
	СтрокаДерева.Выполнена = ЗадачаЭтапа.Выполнена;

	Если НЕ ЗначениеЗаполнено(СтрокаДерева.Дата) Тогда
		СтрокаДерева.Дата = ЗадачаЭтапа.Дата;
	КонецЕсли;

КонецПроцедуры

// Добавляет строку участника по задаче этапа (для этапа без табличной части участников).
//
// Параметры:
//  СтрокаЭтапа - СтрокаДереваЗначений - узел этапа.
//  ЗадачаЭтапа - Структура - задача участника на этом этапе.
//
&НаСервере
Процедура ДобавитьСтрокуУчастникаПоЗадаче(СтрокаЭтапа, ЗадачаЭтапа)

	СтрокаДерева = СтрокаЭтапа.ПолучитьЭлементы().Добавить();
	СтрокаДерева.ВидСтроки = "Участник";
	СтрокаДерева.Участник = ЗадачаЭтапа.Исполнитель;
	СтрокаДерева.Этап = Строка(ЗадачаЭтапа.Исполнитель);
	СтрокаДерева.Задача = ЗадачаЭтапа.Ссылка;
	СтрокаДерева.Дата = ЗадачаЭтапа.Дата;
	СтрокаДерева.Выполнена = ЗадачаЭтапа.Выполнена;

КонецПроцедуры

// Возвращает задачу этапа для указанного исполнителя.
//
// Параметры:
//  ЗадачиЭтапа - Массив из Структура - задачи точки маршрута этапа.
//  Сотрудник   - СправочникСсылка.Пользователи - участник согласования.
//
// Возвращаемое значение:
//  Структура, Неопределено - найденная задача участника.
//
&НаСервере
Функция НайтиЗадачуУчастника(ЗадачиЭтапа, Сотрудник)

	Для Каждого ЗадачаЭтапа Из ЗадачиЭтапа Цикл
		Если ЗадачаЭтапа.Исполнитель = Сотрудник Тогда
			Возврат ЗадачаЭтапа;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает задачи процесса, сгруппированные по точкам маршрута.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: ТочкаМаршрутаБизнесПроцессаСсылка.ГКСИ_СогласованиеИнструкции,
//                                 значение: Массив из Структура с полями Ссылка, Исполнитель, Выполнена, Дата.
//
&НаСервере
Функция ЗадачиПроцессаПоТочкам()

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.Ссылка КАК Задача,
		|	Задачи.ТочкаМаршрута КАК ТочкаМаршрута,
		|	Задачи.Исполнитель КАК Исполнитель,
		|	Задачи.Выполнена КАК Выполнена,
		|	Задачи.Дата КАК Дата
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.БизнесПроцесс = &БизнесПроцесс
		|	И НЕ Задачи.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Задачи.Дата";

	Запрос.УстановитьПараметр("БизнесПроцесс", Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ЗадачиЭтапа = Результат.Получить(Выборка.ТочкаМаршрута);
		Если ЗадачиЭтапа = Неопределено Тогда
			ЗадачиЭтапа = Новый Массив;
			Результат.Вставить(Выборка.ТочкаМаршрута, ЗадачиЭтапа);
		КонецЕсли;

		ЗадачаЭтапа = Новый Структура;
		ЗадачаЭтапа.Вставить("Ссылка", Выборка.Задача);
		ЗадачаЭтапа.Вставить("Исполнитель", Выборка.Исполнитель);
		ЗадачаЭтапа.Вставить("Выполнена", Выборка.Выполнена);
		ЗадачаЭтапа.Вставить("Дата", Выборка.Дата);
		ЗадачиЭтапа.Добавить(ЗадачаЭтапа);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выделяет цветом состояние просроченного и завершённого согласования.
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Состояние.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СостояниеПросрочено");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.FireBrick);

	Элемент = УсловноеОформление.Элементы.Добавить();

	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Состояние.Имя);

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Состояние");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;

	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Согласовано");
	СписокЗначений.Добавить("Не согласовано");
	ОтборЭлемента.ПравоеЗначение = СписокЗначений;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.RosyBrown);

КонецПроцедуры

// Разворачивает узлы дерева хода согласования после открытия формы.
&НаКлиенте
Процедура РазвернутьХодСогласования()

	ЭлементыДерева = ХодСогласования.ПолучитьЭлементы();

	Если ЭлементыДерева.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Элементы.ХодСогласования.Развернуть(ЭлементыДерева.Получить(0).ПолучитьИдентификатор(), Истина);

КонецПроцедуры

// Открывает форму задачи, выбранной в списке задач процесса.
//
// Параметры:
//  СтрокаСписка - Произвольный - строка динамического списка задач, содержащая колонку Задача.
//
&НаКлиенте
Процедура ОткрытьЗадачуПоСтроке(СтрокаСписка)

	ОткрытьЗадачуПоСсылке(СтрокаСписка.Задача);

КонецПроцедуры

// Открывает карточку сотрудника, выбранного в дереве хода согласования.
//
// Параметры:
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования.
//
&НаКлиенте
Процедура ОткрытьСотрудника(Сотрудник)

	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = Новый Структура("Ключ", Сотрудник);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаЭлемента", ПараметрыОткрытия);

КонецПроцедуры

// Открывает форму задачи бизнес-процесса по ссылке.
//
// Параметры:
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - задача бизнес-процесса.
//
&НаКлиенте
Процедура ОткрытьЗадачуПоСсылке(Задача)

	Если НЕ ЗначениеЗаполнено(Задача) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Задача не найдена'"));
		Возврат;
	КонецЕсли;

	ПараметрыОткрытия = ПараметрыОткрытияЗадачи(Задача);
	ОткрытьФорму(ПараметрыОткрытия.ИмяФормы, ПараметрыОткрытия.ПараметрыФормы);

КонецПроцедуры

// Возвращает имя формы и параметры её открытия для задачи бизнес-процесса.
//
// Параметры:
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - выполняемая задача.
//
// Возвращаемое значение:
//  Структура - поля ИмяФормы, ПараметрыФормы.
//
&НаСервереБезКонтекста
Функция ПараметрыОткрытияЗадачи(Задача)

	ТочкаМаршрута = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задача, "ТочкаМаршрута");
	Возврат БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ФормаВыполненияЗадачи(Задача, ТочкаМаршрута);

КонецФункции

#КонецОбласти
