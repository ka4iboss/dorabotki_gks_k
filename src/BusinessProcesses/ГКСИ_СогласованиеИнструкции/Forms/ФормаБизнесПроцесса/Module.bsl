#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПараметрыДинамическихСписков();
	РассчитатьСостояние();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыХодСогласования

&НаКлиенте
Процедура ХодСогласованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеСтроки = Элементы.ХодСогласования.ТекущиеДанные;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеСтроки.ТипЗаписи = "Задача" Тогда
		ОткрытьЗадачуПоСсылке(ДанныеСтроки.Задача);
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ХодСогласованияУчастник" Тогда
		ОткрытьСотрудника(ДанныеСтроки.Участник);
		Возврат;
	КонецЕсли;
	
	ОткрытьПроцесс();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗадачиПроцесса

&НаКлиенте
Процедура ЗадачиПроцессаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеСтроки = Элементы.ЗадачиПроцесса.ТекущиеДанные;
	
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьЗадачуПоСтроке(ДанныеСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устанавливает параметры отбора динамических списков хода согласования и задач процесса.
&НаСервере
Процедура УстановитьПараметрыДинамическихСписков()
	
	ТочкиМаршрута = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ТочкиМаршрута;
	
	ХодСогласования.Параметры.УстановитьЗначениеПараметра("БизнесПроцесс", Объект.Ссылка);
	ХодСогласования.Параметры.УстановитьЗначениеПараметра("ТочкаМаршрутаНачальники", ТочкиМаршрута.СогласованиеНачальниками);
	ХодСогласования.Параметры.УстановитьЗначениеПараметра("ТочкаМаршрутаПодчинённые", ТочкиМаршрута.СогласованиеПодчинёнными);
	
	ЗадачиПроцесса.Параметры.УстановитьЗначениеПараметра("БизнесПроцесс", Объект.Ссылка);
	
КонецПроцедуры

// Рассчитывает текущее состояние бизнес-процесса для вывода в шапке формы.
&НаСервере
Процедура РассчитатьСостояние()
	
	Если Объект.Стартован Тогда
		Если Объект.Завершен Тогда
			Если Объект.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.Согласовано Тогда
				Состояние = "Согласовано";
			ИначеЕсли Объект.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано Тогда
				Состояние = "Не согласовано";
			Иначе
				Состояние = "Завершено";
			КонецЕсли;
		Иначе
			Состояние = "В процессе согласования";
		КонецЕсли;
	Иначе
		Состояние = "Не начато";
	КонецЕсли;
	
	СостояниеПросрочено = Ложь;
	
	Если Объект.Стартован И НЕ Объект.Завершен
		И ЗначениеЗаполнено(Объект.ДатаЗавершения)
		И Объект.ДатаЗавершения < НачалоДня(ТекущаяДатаСеанса()) Тогда
		СостояниеПросрочено = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Выделяет цветом состояние просроченного и завершённого согласования.
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Состояние.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СостояниеПросрочено");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.FireBrick);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Состояние.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Состояние");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Согласовано");
	СписокЗначений.Добавить("Не согласовано");
	ОтборЭлемента.ПравоеЗначение = СписокЗначений;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.RosyBrown);
	
КонецПроцедуры

// Открывает форму задачи, выбранной в списке задач процесса.
//
// Параметры:
//  СтрокаСписка - Произвольный - строка динамического списка задач, содержащая колонку Задача.
//
&НаКлиенте
Процедура ОткрытьЗадачуПоСтроке(СтрокаСписка)
	
	ОткрытьЗадачуПоСсылке(СтрокаСписка.Задача);
	
КонецПроцедуры

// Открывает карточку бизнес-процесса согласования в новом окне.
//
&НаКлиенте
Процедура ОткрытьПроцесс()
	
	ПараметрыОткрытия = Новый Структура("Ключ", Объект.Ссылка);
	ОткрытьФорму("БизнесПроцесс.ГКСИ_СогласованиеИнструкции.Форма.ФормаБизнесПроцесса", ПараметрыОткрытия);
	
КонецПроцедуры

// Открывает форму задачи бизнес-процесса по ссылке.
//
// Параметры:
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - задача бизнес-процесса.
//
&НаКлиенте
Процедура ОткрытьЗадачуПоСсылке(Задача)
	
	Если НЕ ЗначениеЗаполнено(Задача) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Задача не найдена'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = ПараметрыОткрытияЗадачи(Задача);
	ОткрытьФорму(ПараметрыОткрытия.ИмяФормы, ПараметрыОткрытия.ПараметрыФормы);
	
КонецПроцедуры

// Открывает карточку сотрудника, выбранного в списке хода согласования.
//
// Параметры:
//  Сотрудник - СправочникСсылка.Пользователи - участник согласования.
//
&НаКлиенте
Процедура ОткрытьСотрудника(Сотрудник)
	
	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("Ключ", Сотрудник);
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаЭлемента", ПараметрыОткрытия);
	
КонецПроцедуры

// Возвращает имя формы и параметры её открытия для задачи бизнес-процесса.
//
// Параметры:
//  Задача - ЗадачаСсылка.ЗадачаИсполнителя - выполняемая задача.
//
// Возвращаемое значение:
//  Структура - поля ИмяФормы, ПараметрыФормы.
//
&НаСервереБезКонтекста
Функция ПараметрыОткрытияЗадачи(Задача)
	
	ТочкаМаршрута = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задача, "ТочкаМаршрута");
	Возврат БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ФормаВыполненияЗадачи(Задача, ТочкаМаршрута);
	
КонецФункции

#КонецОбласти
