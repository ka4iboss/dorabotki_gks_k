#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьДанныеСогласования();
	РассчитатьСостояние();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицы хода согласования и задач бизнес-процесса.
&НаСервере
Процедура ЗаполнитьДанныеСогласования()
	
	ЗаполнитьХодСогласования();
	ЗаполнитьЗадачиПроцесса();
	
КонецПроцедуры

// Заполняет ход согласования по табличным частям участников бизнес-процесса.
&НаСервере
Процедура ЗаполнитьХодСогласования()
	
	ХодСогласования.Очистить();
	
	ДобавитьСтрокиХодаСогласования(Объект.Начальники, "Согласование начальниками отделов");
	ДобавитьСтрокиХодаСогласования(Объект.Подчинённые, "Согласование подчинёнными");
	
КонецПроцедуры

// Добавляет строки хода согласования по одной табличной части участников.
&НаСервере
Процедура ДобавитьСтрокиХодаСогласования(СтрокиУчастников, НаименованиеЭтапа)
	
	Для Каждого СтрокаУчастника Из СтрокиУчастников Цикл
		
		СтрокаХода = ХодСогласования.Добавить();
		СтрокаХода.КолонкаЭтап = НаименованиеЭтапа;
		СтрокаХода.КолонкаУчастник = СтрокаУчастника.Сотрудник;
		СтрокаХода.КолонкаРезультат = СтрокаУчастника.РезультатСогласования;
		СтрокаХода.КолонкаКомментарий = СтрокаУчастника.Комментарий;
		СтрокаХода.КолонкаДатаСогласования = СтрокаУчастника.ДатаСогласования;
		СтрокаХода.КолонкаНомерВерсии = СтрокаУчастника.НомерВерсии;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет список задач бизнес-процесса с указанием этапа и результата выполнения.
&НаСервере
Процедура ЗаполнитьЗадачиПроцесса()
	
	ЗадачиПроцесса.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Задачи.ТочкаМаршрута КАК ТочкаМаршрута,
		|	Задачи.Исполнитель КАК Исполнитель,
		|	Задачи.СрокИсполнения КАК СрокИсполнения,
		|	Задачи.Выполнена КАК Выполнена,
		|	Задачи.ДатаИсполнения КАК ДатаИсполнения
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.БизнесПроцесс = &БизнесПроцесс
		|	И НЕ Задачи.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Задачи.Дата";
	
	Запрос.УстановитьПараметр("БизнесПроцесс", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаЗадачи = ЗадачиПроцесса.Добавить();
		СтрокаЗадачи.КолонкаЭтап = НаименованиеЭтапаТочкиМаршрута(Выборка.ТочкаМаршрута);
		СтрокаЗадачи.КолонкаИсполнитель = Выборка.Исполнитель;
		СтрокаЗадачи.КолонкаСрокИсполнения = Выборка.СрокИсполнения;
		СтрокаЗадачи.КолонкаВыполнена = Выборка.Выполнена;
		СтрокаЗадачи.КолонкаДатаИсполнения = Выборка.ДатаИсполнения;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает представление этапа согласования по точке маршрута бизнес-процесса.
&НаСервереБезКонтекста
Функция НаименованиеЭтапаТочкиМаршрута(ТочкаМаршрута)
	
	ТочкиМаршрута = БизнесПроцессы.ГКСИ_СогласованиеИнструкции.ТочкиМаршрута;
	
	Если ТочкаМаршрута = ТочкиМаршрута.НазначитьУчастников Тогда
		Возврат "Назначение участников";
	ИначеЕсли ТочкаМаршрута = ТочкиМаршрута.СогласованиеНачальниками Тогда
		Возврат "Согласование начальниками отделов";
	ИначеЕсли ТочкаМаршрута = ТочкиМаршрута.СогласованиеПодчинёнными Тогда
		Возврат "Согласование подчинёнными";
	ИначеЕсли ТочкаМаршрута = ТочкиМаршрута.ОбработкаРезультата Тогда
		Возврат "Обработка результата";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Рассчитывает текущее состояние бизнес-процесса для вывода в шапке формы.
&НаСервере
Процедура РассчитатьСостояние()
	
	Если Объект.Стартован Тогда
		Если Объект.Завершен Тогда
			Если Объект.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.Согласовано Тогда
				Состояние = "Согласовано";
			ИначеЕсли Объект.РезультатСогласования = Перечисления.ГКСИ_РезультатыСогласованияИнструкций.НеСогласовано Тогда
				Состояние = "Не согласовано";
			Иначе
				Состояние = "Завершено";
			КонецЕсли;
		Иначе
			Состояние = "В процессе согласования";
		КонецЕсли;
	Иначе
		Состояние = "Не начато";
	КонецЕсли;
	
	СостояниеПросрочено = Ложь;
	
	Если Объект.Стартован И НЕ Объект.Завершен
		И ЗначениеЗаполнено(Объект.ДатаЗавершения)
		И Объект.ДатаЗавершения < НачалоДня(ТекущаяДатаСеанса()) Тогда
		СостояниеПросрочено = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Выделяет цветом состояние просроченного и завершённого согласования.
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Состояние.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СостояниеПросрочено");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.FireBrick);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Состояние.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Состояние");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить("Согласовано");
	СписокЗначений.Добавить("Не согласовано");
	ОтборЭлемента.ПравоеЗначение = СписокЗначений;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.RosyBrown);
	
КонецПроцедуры

#КонецОбласти
